' Is this a source-write permission refusal while the IDE is in break mode?
Private Function IsIdeBusyPermissionError(ByVal msg As String) As Boolean
    On Error Resume Next
    If Len(msg) = 0 Then Exit Function
    Dim st As String
    st = GetIdeState()
    If st <> "break" And st <> "run" Then Exit Function
    If InStr(1, msg, "denied", vbTextCompare) > 0 Then IsIdeBusyPermissionError = True
    If InStr(1, msg, "permission", vbTextCompare) > 0 Then IsIdeBusyPermissionError = True
    If InStr(msg, ChrW$(&H62D2) & ChrW$(&H7EDD)) > 0 Then IsIdeBusyPermissionError = True
    If InStr(msg, ChrW$(&H6743) & ChrW$(&H9650)) > 0 Then IsIdeBusyPermissionError = True
End Function

' ---------------------------------------------------------------------------
' (contract v1.3.2): optional structured error fields on FAILURE receipts.
'   vbErrorCode  <- the VB6 numeric code captured at the Fail handler (add-in side)
'   errorLine    <- the engine position protocol, IDE coords
' Invariants: a field that cannot be obtained is OMITTED (never 0 / never an empty
' string), and a failed read must never disturb the original error path. Every read
' below is wrapped in its own guard for exactly that reason.
' RETRACTED (same card, measured): the raw-global read for `errorLine` lived here and
' read Vba6Base()+&HFC0D188 / +&HFC0D190 through RtlMoveMemory. On the real machine the
' FIRST call that reached it (verify, in break mode) was immediately followed by the IDE
' DYING - the listener disappeared and the VB6 process exited. A raw memory copy is not
' worth an IDE crash, and P2/R64 has not machine-verified those globals yet, so the read
' is REMOVED. `errorLine` is therefore simply ABSENT (contract: a field that cannot be
' obtained is omitted, never faked). `vbErrorCode` below is pure VB data - the number
' captured at the Fail handler - and carries no such risk.
' ---------------------------------------------------------------------------
Private Sub AddErrorFields(ByVal d As Object, ByVal vbErr As Long)
    On Error Resume Next
    If vbErr <> 0 Then d("vbErrorCode") = vbErr
End Sub

' an UNEXPECTED VB runtime error must still come back as a STRUCTURED receipt
' ({ok:false, reason, vbErrorCode}) - the old bare "Error: <text>" gave the caller nothing
' to branch on (no ok, no reason). vbErrorCode keeps the contract v1.3.2 semantics: it is
' present only when a real VB error was captured at the Fail handler.
Private Function UnexpectedErrorJson(ByVal tool As String, ByVal rawErr As String, ByVal vbErr As Long) As String
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = "unexpected_error"
    d("tool") = tool
    d("message") = rawErr
    d("advice") = "this is an unexpected VB runtime error in the add-in, not a structured refusal; no claim is made about the component state"
    AddErrorFields d, vbErr
    On Error Resume Next
    d("ideState") = GetIdeState()
    On Error GoTo 0
    UnexpectedErrorJson = JsonStringify(d)
End Function

' ===========================================================================
' (the refusal-classification finding): CLASSIFIED REFUSALS.
'
' the refusal-classification finding (49 arms / ~34 tools) showed that conditions the add-in has
' ALREADY identified - "File not found: <path>", "Directory not found: <path>",
' "Unknown component type: <t>", "baseline spec is required", "Invalid action: ...",
' "marker begin not found: ...", the VB-native 76/71/32813 codes, and so on - were
' still answered with the BARE envelope ok:false + reason:"unexpected_error" +
' vbErrorCode, which is not branchable without parsing prose.
'
' WHY THEY LEAKED (measured, not guessed): every one of those raises uses
'   Err.Raise vbObjectError + N, "CodeTools", "<classified message>"
' with NO "MCPREASON:" prefix. CallTool's Fail handler only turns a raise into a
' structured refusal when the description starts with "MCPREASON:" (CodeTools.cls
' ~1920); everything else falls through to UnexpectedErrorJson (~1947). So the
' information was never missing - only the channel tag was.
'
' TWO ways to fix: tag ~150 raise sites individually, or classify CENTRALLY here
' from the message family + the captured VB error number. This is the central one:
' one function, one place, and a static completeness scan can verify it against
' every raise site in the product.
'
' SAFETY (contract): these branches run ONLY after the MCPREASON branch and the
' IDE-busy branch, i.e. only on calls that used to answer unexpected_error. A
' successful call never reaches the Fail handler at all, so the success path and
' every existing structured refusal are untouched.
' vbErrorCode is emitted ONLY for a NATIVE error (a real VB/COM code, i.e. one
' outside our own vbObjectError+N band) - 's rule that our own guards
' must not look like captured VB errors is preserved.
' ===========================================================================
Private Function ClassifiedRefusalJson(ByVal tool As String, ByVal failMsg As String, ByVal vbErr As Long) As String
    On Error Resume Next
    Dim m As String, reason As String, argName As String
    m = failMsg
    reason = ""
    argName = ""
    ' ---- caller-input families (most specific first) -----------------------
    If InStr(1, m, "baseline spec is required", vbTextCompare) > 0 Then
        reason = "required_argument_missing": argName = "baseline"
    ElseIf InStr(1, m, " is required", vbTextCompare) > 0 Then
        reason = "required_argument_missing": argName = ArgNameOf(m)
    ElseIf InStr(1, m, " are required", vbTextCompare) > 0 Then
        reason = "required_argument_missing": argName = ArgNameOf(m)
    ElseIf InStr(1, m, "no fields supplied to set", vbTextCompare) > 0 Then
        reason = "required_argument_missing": argName = "updates"
    ElseIf InStr(1, m, "Project file not found", vbTextCompare) > 0 Then
        reason = "project_file_not_found"
    ElseIf InStr(1, m, "project file is empty or unreadable", vbTextCompare) > 0 Then
        reason = "file_unreadable"
    ElseIf InStr(1, m, "Project not found", vbTextCompare) > 0 Then
        reason = "project_not_found"
    ElseIf InStr(1, m, "No project open", vbTextCompare) > 0 Then
        reason = "project_not_found"
    ElseIf InStr(1, m, "project group not found or empty", vbTextCompare) > 0 Then
        reason = "project_group_not_found"
    ElseIf InStr(1, m, "snapshot.json not found under", vbTextCompare) > 0 Then
        reason = "snapshot_not_found"
    ElseIf InStr(1, m, "Directory not found", vbTextCompare) > 0 Then
        reason = "directory_not_found"
    ElseIf InStr(1, m, "cannot READ the source file", vbTextCompare) > 0 Then
        reason = "file_unreadable"
    ElseIf InStr(1, m, "empty or unreadable", vbTextCompare) > 0 Then
        reason = "file_unreadable"
    ElseIf InStr(1, m, "File not found", vbTextCompare) > 0 Then
        reason = "file_not_found"
    ElseIf InStr(1, m, "procedure not found", vbTextCompare) > 0 Then
        reason = "procedure_not_found"
    ElseIf InStr(1, m, "Invalid operation", vbTextCompare) > 0 Then
        reason = "invalid_action"
    ElseIf InStr(1, m, "selection must be", vbTextCompare) > 0 Then
        reason = "invalid_selection"
    ElseIf InStr(1, m, "looks like an id but its number is missing", vbTextCompare) > 0 Then
        reason = "invalid_control_id"
    ElseIf InStr(1, m, "IDE not connected", vbTextCompare) > 0 Then
        reason = "ide_not_connected"
    ElseIf InStr(1, m, "Unknown component type", vbTextCompare) > 0 Then
        reason = "unknown_component_type"
    ElseIf InStr(1, m, "Unknown project type", vbTextCompare) > 0 Then
        reason = "unknown_project_type"
    ElseIf InStr(1, m, "Unknown attrName", vbTextCompare) > 0 Then
        reason = "unknown_attribute"
    ElseIf InStr(1, m, "Invalid action", vbTextCompare) > 0 Then
        reason = "invalid_action"
    ElseIf InStr(1, m, "Unknown action", vbTextCompare) > 0 Then
        reason = "invalid_action"
    ElseIf InStr(1, m, "Invalid mode", vbTextCompare) > 0 Then
        reason = "invalid_mode"
    ElseIf InStr(1, m, "Invalid level", vbTextCompare) > 0 Then
        reason = "invalid_level"
    ElseIf InStr(1, m, "Reference not found", vbTextCompare) > 0 Then
        reason = "reference_not_found"
    ElseIf InStr(1, m, "Control property not found", vbTextCompare) > 0 Then
        reason = "control_property_not_found"
    ElseIf InStr(1, m, "Property not found", vbTextCompare) > 0 Then
        reason = "property_not_found"
    ElseIf InStr(1, m, "Member not found", vbTextCompare) > 0 Then
        reason = "member_not_found"
    ElseIf InStr(1, m, "Control not found by name", vbTextCompare) > 0 Then
        reason = "control_not_found"
    ElseIf InStr(1, m, "Control index out of range", vbTextCompare) > 0 Then
        reason = "control_index_out_of_range"
    ElseIf InStr(1, m, "index must be >= 1", vbTextCompare) > 0 Then
        reason = "control_index_out_of_range"
    ElseIf InStr(1, m, "Component has no code module", vbTextCompare) > 0 Then
        reason = "component_has_no_code_module"
    ElseIf InStr(1, m, "Component has no designer", vbTextCompare) > 0 Then
        reason = "component_has_no_designer"
    ElseIf InStr(1, m, "Component has no Properties collection", vbTextCompare) > 0 Then
        reason = "component_has_no_properties"
    ElseIf InStr(1, m, "Component has no file name", vbTextCompare) > 0 Then
        reason = "component_has_no_file"
    ElseIf InStr(1, m, "marker begin not found", vbTextCompare) > 0 Then
        reason = "marker_not_found"
    ElseIf InStr(1, m, "anchor not found", vbTextCompare) > 0 Then
        reason = "anchor_not_found"
    ElseIf InStr(1, m, "anchor not unique", vbTextCompare) > 0 Then
        reason = "anchor_not_unique"
    ElseIf InStr(1, m, "import refused", vbTextCompare) > 0 Then
        reason = "import_rebind_failed"
    ElseIf InStr(1, m, "Could not compile", vbTextCompare) > 0 Then
        reason = "compile_failed"
    ElseIf InStr(1, m, "Could not save the project before", vbTextCompare) > 0 Then
        reason = "save_before_build_failed"
    ElseIf InStr(1, m, "Could not create a form component", vbTextCompare) > 0 Then
        reason = "component_add_failed"
    ElseIf InStr(1, m, "VBComponents.Add failed", vbTextCompare) > 0 Then
        reason = "component_add_failed"
    ElseIf InStr(1, m, "References.Remove failed", vbTextCompare) > 0 Then
        reason = "reference_remove_failed"
    ElseIf InStr(1, m, "open_project failed", vbTextCompare) > 0 Then
        reason = "open_project_failed"
    ElseIf InStr(1, m, "build process failed to run", vbTextCompare) > 0 Then
        reason = "build_process_failed"
    ElseIf InStr(1, m, "Add-in not found", vbTextCompare) > 0 Then
        reason = "addin_not_found"
    ElseIf InStr(1, m, "Menu command not found", vbTextCompare) > 0 Then
        reason = "menu_control_not_found"
    ElseIf InStr(1, m, "Menu control not found", vbTextCompare) > 0 Then
        reason = "menu_control_not_found"
    ElseIf InStr(1, m, "Debug menu item not found", vbTextCompare) > 0 Then
        reason = "menu_control_not_found"
    ElseIf InStr(1, m, "no ENABLED menu control", vbTextCompare) > 0 Then
        reason = "menu_control_not_found"
    ElseIf InStr(1, m, "Menu control is disabled", vbTextCompare) > 0 Then
        reason = "menu_control_disabled"
    ElseIf InStr(1, m, "is AMBIGUOUS", vbTextCompare) > 0 Then
        reason = "menu_control_ambiguous"
    ElseIf InStr(1, m, "No active code pane", vbTextCompare) > 0 Then
        reason = "no_active_code_pane"
    ElseIf InStr(1, m, "Project is unsaved", vbTextCompare) > 0 Then
        reason = "project_unsaved"
    ElseIf InStr(1, m, "has no file name", vbTextCompare) > 0 Then
        reason = "project_unsaved"
    ElseIf InStr(1, m, "refusing to save", vbTextCompare) > 0 Then
        reason = "save_refused"
    ElseIf InStr(1, m, "content changed on line", vbTextCompare) > 0 Then
        reason = "file_changed_on_disk"
    ElseIf InStr(1, m, "not a valid identifier", vbTextCompare) > 0 Then
        reason = "invalid_identifier"
    ElseIf InStr(1, m, "old_name and new_name are the same", vbTextCompare) > 0 Then
        reason = "rename_is_noop"
    ElseIf InStr(1, m, "invalid path", vbTextCompare) > 0 Then
        reason = "invalid_path"
    ElseIf InStr(1, m, "Clipboard has nothing pasteable", vbTextCompare) > 0 Then
        reason = "clipboard_empty"
    ElseIf InStr(1, m, "the form has no file on disk yet", vbTextCompare) > 0 Then
        reason = "form_not_saved"
    ElseIf InStr(1, m, "menu item not found in the .frm text", vbTextCompare) > 0 Then
        reason = "menu_item_not_found"
    ElseIf InStr(1, m, "parent menu item not found", vbTextCompare) > 0 Then
        reason = "menu_item_not_found"
    ElseIf InStr(1, m, "already a child of", vbTextCompare) > 0 Then
        reason = "menu_nest_invalid"
    ElseIf InStr(1, m, "cannot nest a menu item inside itself", vbTextCompare) > 0 Then
        reason = "menu_nest_invalid"
    ElseIf InStr(1, m, "could not re-read", vbTextCompare) > 0 Then
        reason = "form_read_failed"
    ElseIf InStr(1, m, "could not find the form's closing End line", vbTextCompare) > 0 Then
        reason = "form_read_failed"
    ElseIf InStr(1, m, "could not read", vbTextCompare) > 0 Then
        reason = "form_read_failed"
    ElseIf InStr(1, m, "Unknown tool", vbTextCompare) > 0 Then
        reason = "unknown_tool"
    ElseIf InStr(1, m, "Could not set", vbTextCompare) > 0 Then
        reason = "property_set_failed"
    ElseIf InStr(1, m, "set_project_options failed", vbTextCompare) > 0 Then
        reason = "set_project_options_failed"
    ElseIf vbErr = 76 Then
        reason = "path_not_found"
    ElseIf vbErr = 71 Then
        reason = "device_not_ready"
    ElseIf vbErr = 53 Then
        reason = "file_not_found"
    ElseIf vbErr = 70 Then
        reason = "permission_denied"
    ElseIf vbErr = 32813 Then
        reason = "com_name_conflict"
    ElseIf vbErr = -2147319779 Then
        reason = "type_not_registered"
    ElseIf vbErr = -2147221164 Then
        reason = "com_class_not_registered"
    End If
    If Len(reason) = 0 Then
        ClassifiedRefusalJson = ""
        Exit Function
    End If
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = reason
    d("tool") = tool
    d("message") = failMsg
    If Len(argName) > 0 Then d("argument") = argName
    Dim pth As String
    pth = PathOfMessage(m)
    If Len(pth) > 0 Then d("path") = pth
    Dim allowed As Object
    Set allowed = ExpectedListOf(m)
    If Not allowed Is Nothing Then
        If allowed.Count > 0 Then Set d("allowedValues") = allowed
    End If
    If InStr(1, m, "Unknown component type", vbTextCompare) > 0 Then
        Dim ctypes As Object
        Set ctypes = New Collection
        ctypes.Add "module"
        ctypes.Add "class"
        ctypes.Add "form"
        ctypes.Add "mdiform"
        ctypes.Add "designer"
        ctypes.Add "usercontrol"
        ctypes.Add "propPage"
        ctypes.Add "userdoc"
        ctypes.Add "resource"
        Set d("allowedComponentTypes") = ctypes
    End If
    d("suggestedAction") = SuggestedActionFor(reason)
    d("classifiedBy") = "ClassifiedRefusalJson (message family + native VB/COM code allowlist)"
    d("sideEffects") = "none: the call was refused before completing its effect; this is a CLASSIFIED refusal, not an unexpected VB runtime error"
    ' rule preserved: vbErrorCode only for a NATIVE error, never for our own
    ' vbObjectError+N guard raises.
    If Not IsOwnGuardCode(vbErr) Then
        If vbErr <> 0 Then d("vbErrorCode") = vbErr
    End If
    ClassifiedRefusalJson = JsonStringify(d)
End Function

Private Function IsOwnGuardCode(ByVal vbErr As Long) As Boolean
    IsOwnGuardCode = (vbErr >= vbObjectError And vbErr <= vbObjectError + 200)
End Function

' "<arg> is required ..." -> the argument NAME (the text before " is required").
Private Function ArgNameOf(ByVal m As String) As String
    Dim p As Long, s As String, sp As Long
    p = InStr(1, m, " is required", vbTextCompare)
    If p = 0 Then p = InStr(1, m, " are required", vbTextCompare)
    If p = 0 Then
        ArgNameOf = ""
        Exit Function
    End If
    s = Trim$(Left$(m, p - 1))
    If InStr(1, s, " or ", vbTextCompare) > 0 Then
        ArgNameOf = ""
        Exit Function
    End If
    sp = InStr(s, " ")
    If sp > 0 Then s = Left$(s, sp - 1)
    ArgNameOf = s
End Function

' "... (expected a/b/c)" -> a Collection of the advertised alternatives.
Private Function ExpectedListOf(ByVal m As String) As Object
    On Error Resume Next
    Dim i As Long, j As Long, inner As String, parts() As String, k As Long
    Dim c As Object
    Set c = New Collection
    i = InStr(1, m, "(expected ", vbTextCompare)
    If i = 0 Then
        Set ExpectedListOf = Nothing
        Exit Function
    End If
    j = InStr(i, m, ")")
    If j = 0 Then
        Set ExpectedListOf = Nothing
        Exit Function
    End If
    inner = Mid$(m, i + 10, j - i - 10)
    parts = Split(inner, "/")
    For k = 0 To UBound(parts)
        If Len(Trim$(parts(k))) > 0 Then c.Add Trim$(parts(k))
    Next
    Set ExpectedListOf = c
End Function

' the trailing "<label>: <path>" of a not-found message, when it looks like a path.
Private Function PathOfMessage(ByVal m As String) As String
    On Error Resume Next
    Dim p As Long, tail As String
    p = InStrRev(m, ": ")
    If p = 0 Then
        PathOfMessage = ""
        Exit Function
    End If
    tail = Trim$(m)
    tail = Trim$(Mid$(tail, p + 2))
    If Len(tail) = 0 Or Len(tail) > 400 Then
        PathOfMessage = ""
        Exit Function
    End If
    If InStr(tail, ":") = 0 And InStr(tail, Chr$(92)) = 0 And InStr(tail, "/") = 0 Then
        PathOfMessage = ""
        Exit Function
    End If
    PathOfMessage = tail
End Function

Private Function SuggestedActionFor(ByVal reason As String) As String
    Select Case LCase$(reason)
        Case "required_argument_missing"
            SuggestedActionFor = "supply the reported argument (see 'argument' / 'message') and retry"
        Case "file_not_found", "path_not_found"
            SuggestedActionFor = "pass the path of an EXISTING file; a relative path resolves against the project directory, not the process working directory"
        Case "file_unreadable"
            SuggestedActionFor = "check that the file exists, is not locked by another process, and is text in a supported encoding"
        Case "directory_not_found"
            SuggestedActionFor = "pass the path of an EXISTING directory; a relative path resolves against the project directory"
        Case "project_file_not_found", "project_not_found"
            SuggestedActionFor = "pass the .vbp of an existing project, or open the project in the IDE first"
        Case "unknown_component_type", "unknown_project_type", "unknown_attribute"
            SuggestedActionFor = "use one of allowedValues (or allowedComponentTypes) and retry"
        Case "invalid_action", "invalid_mode", "invalid_level"
            SuggestedActionFor = "use one of allowedValues and retry"
        Case "reference_not_found"
            SuggestedActionFor = "call check_references and use one of the listed reference names"
        Case "control_not_found", "property_not_found", "control_property_not_found", "member_not_found"
            SuggestedActionFor = "call the matching inspector (form_designer action=info / list_members / get_component_properties) and use a name it lists"
        Case "component_has_no_code_module"
            SuggestedActionFor = "this component kind has no code pane (a designer-only component); pick a module/class/form"
        Case "component_has_no_designer"
            SuggestedActionFor = "this component kind has no designer; use form_designer only on a form/mdiform"
        Case "procedure_not_found"
            SuggestedActionFor = "call list_members (or get_component_list) and use a procedure name it lists"
        Case "invalid_selection"
            SuggestedActionFor = "pass selection as startLine,startCol,endLine,endCol (four comma-separated numbers)"
        Case "invalid_control_id"
            SuggestedActionFor = "address the control by index, or write the id as #746 / id:746 so the number is present"
        Case "ide_not_connected"
            SuggestedActionFor = "the add-in has no live VBIDE connection; start/attach the IDE and retry"
        Case "anchor_not_found", "anchor_not_unique"
            SuggestedActionFor = "make the anchor match exactly one pane line (see get_component_code coords='ide')"
        Case "marker_not_found"
            SuggestedActionFor = "the injected marker with that id is not present; list_breakpoints / the matching list tool shows what exists"
        Case "project_unsaved"
            SuggestedActionFor = "call save_project (with a path when the project has no file name) and retry"
        Case "device_not_ready", "path_not_found_native"
            SuggestedActionFor = "the drive or path is not available to this process; check the drive letter and retry"
        Case "com_name_conflict"
            SuggestedActionFor = "a component with that name already exists in the project; rename it before adding the reference"
        Case "type_not_registered", "com_class_not_registered"
            SuggestedActionFor = "the type library / COM class is not registered for the 32-bit IDE; register it with %SystemRoot% SysWOW64 regsvr32"
        Case "compile_failed", "save_before_build_failed", "build_process_failed"
            SuggestedActionFor = "read the compile log reported by build/make_project; fix the reported compile error and retry"
        Case "menu_control_not_found", "menu_control_disabled", "menu_control_ambiguous"
            SuggestedActionFor = "call command_bars action=list and address the control by bar= / caption / id= as it is listed"
        Case "no_active_code_pane"
            SuggestedActionFor = "activate a component's code pane first (activate_component window='code')"
        Case Else
            SuggestedActionFor = "fix the reported condition (see 'reason' and 'message') and retry"
    End Select
End Function

Private Function IdeBusyBreakJson(ByVal tool As String, ByVal rawErr As String, Optional ByVal vbErr As Long = 0) As String
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    Dim st As String
    st = GetIdeState()
    d("ok") = False
    If st = "break" Then
        d("reason") = "ide_busy_in_break_mode"
        d("advice") = "the debugger is stopped (break mode) and the IDE refuses source writes; call control_execution with mode=end to leave break mode, then retry"
    Else
        d("reason") = "ide_busy_in_run_mode"
        d("advice") = "the program is running and the IDE refuses source writes; call control_execution with mode=end (or break first) and retry in design mode"
    End If
    d("ideState") = st
    d("tool") = tool
    d("error") = rawErr
    AddErrorFields d, vbErr
    IdeBusyBreakJson = JsonStringify(d)
End Function

' ===========================================================================
' /: the IDE's extensibility object model answers a member call with
' native VB 438 ("Object doesn't support this property or method") while the IDE is not
' yet in an editable design state - measured 2026-10-15 on freshly started IDE instances:
' the FIRST one or two calls after the add-in began listening raised 438 on
' add_project / add_component / replace_code, and the SAME call succeeded immediately after
' (audit %TEMP%\vb6mcp_audit.log 01:00:04 and 01:03:18). The raising member is inside the
' VBIDE object model (VBProjects.Add / VBComponent.CodeModule); that add-in code path is
' unchanged since 2026-08-28, and touched only ServerForm.frm + WinsockTransport.cls.
' MEASURED MORE OF THE SAME WINDOW ON THE SHIPPED 77C8277B: on a clean instance whose
' get_project_info was ALREADY healthy (componentCount=3, ideState=design) about 4 s after
' start, READ-class tools answered the bare envelope too - ide_state, read_active_dialogs,
' get_component_code and audit_tail all returned the bare {reason:unexpected_error,
' vbErrorCode:438, message:<the localized 438 text>} - while replace_code already answered
' ide_model_not_ready. A get_project_info based settle loop can NEVER detect this window:
' that tool does not touch the object model, so it stays healthy while the model is still
' unreachable.
'
' WHAT IS FIXED HERE IS THE ENVELOPE, NOT THE STATE: the Fail handler had NO branch for a
' 438, so it fell through to UnexpectedErrorJson and the caller received a bare
' {ok:false, reason:"unexpected_error"} that is not branchable. It now answers a STRUCTURED
' refusal carrying the RAW IDE message plus a retry hint.
'
' BOUNDS (all three are load-bearing):
'   * 438 ONLY - no other VB error number is classified here;
'   * EVERY TOOL CLASS: read-class calls 438 in the SAME window, so the tool
'     class is deliberately NOT a gate any more. The tool parameter is retained for the
'     receipt and the caller, never as a filter;
'   * it runs AFTER the MCPREASON / IDE-busy / ClassifiedRefusalJson branches, so every
'     existing structured refusal stays byte-identical and only calls that used to answer
'     unexpected_error can reach it.
' It is NOT a state-based prevention guard: add_project / add_component were measured to WORK
' in run and break mode on this build, so refusing write-class calls by IDE state would turn
' working calls into refusals. Nothing is prevented here - only the receipt is made honest.
' ===========================================================================
Private Function IsIdeModelNotReadyError(ByVal tool As String, ByVal vbErr As Long, ByVal msg As String) As Boolean
    On Error Resume Next
    ' Native VB 438 is the primary, number-based signal - for EVERY tool class.
    If vbErr = 438 Then
        IsIdeModelNotReadyError = True
        Exit Function
    End If
    ' Fallback ONLY: if the captured Err.Number was 0 (an inner handler cleared Err before the
    ' Fail handler ran) the number test alone would miss the error this card is about. The two
    ' known 438 texts are matched verbatim, in EVERY tool class.
    If InStr(1, msg, "Object doesn't support this property or method", vbTextCompare) > 0 Then
            IsIdeModelNotReadyError = True
            Exit Function
        End If
        If InStr(msg, ChrW$(&H5BF9) & ChrW$(&H8C61) & ChrW$(&H4E0D) & ChrW$(&H652F) & ChrW$(&H6301) & ChrW$(&H8BE5) & ChrW$(&H5C5E) & ChrW$(&H6027) & ChrW$(&H6216) & ChrW$(&H65B9) & ChrW$(&H6CD5)) > 0 Then
            IsIdeModelNotReadyError = True
        End If
End Function

' Empty string unless this is the 438-on-a-write path, so the caller keeps the byte-identical
' unexpected_error envelope for every other error.
Private Function IdeModelNotReadyJson(ByVal tool As String, ByVal rawErr As String, ByVal vbErr As Long) As String
    On Error Resume Next
    If Not IsIdeModelNotReadyError(tool, vbErr, rawErr) Then
        IdeModelNotReadyJson = ""
        Exit Function
    End If
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = "ide_not_ready"
    d("reasonLegacy") = "ide_model_not_ready"
    d("tool") = tool
    ' the RAW message from the IDE is preserved verbatim - never replaced by prose
    d("message") = rawErr
    d("vbErrorCode") = 438
    d("ideState") = GetIdeState()
    d("retryHint") = "wait for the IDE to finish loading the project (or leave run/break mode), then repeat the SAME call - a freshly started IDE was measured to succeed on the very next attempt"
    d("advice") = "the VBIDE extensibility model refused a member call while the design-time model was not yet editable; nothing here is a claim about the component or the project state, and no state change was accepted (a read changed nothing; a write was refused)"
    d("classifiedBy") = "IdeModelNotReadyJson (native VB 438 from the VBIDE object model, every tool class)"
    d("sideEffects") = "none: the IDE refused the member call, so this is a refusal and not a completed mutation"
    IdeModelNotReadyJson = JsonStringify(d)
End Function

' ===========================================================================
' re-entrancy gate around tool dispatch.
'
' DoEvents hands the IDE message queue back, which means a NEW HTTP request can
' be dispatched THROUGH THIS SAME THREAD while a tool call is mid-flight. That
' is exactly what makes the IDE responsive, and exactly what makes an
' unguarded write path dangerous: two state-changing calls would interleave
' across the pump point (call A reads the pane, call B rewrites it, call A
' writes back its stale prediction).
'
' Policy (chosen over queueing: VB6 is single threaded and this add-in has no
' request queue, so a refusal is predictable and testable):
'   * while a STATE-CHANGING tool is in flight, a re-entrant STATE-CHANGING
'     call that reaches a pump point is answered at once with {ok:false,
'     reason:busy, busyTool,...} - never executed, so two mutations can never
'     interleave. A READ-ONLY call is NOT refused by this gate (A2); delivery
'     still needs a pump point - when none is reached the delivery layer
'     answers peer_unresponsive, never a fake busy from here;
'   * nesting is capped (CALL_DEPTH_MAX) so a pathological chain of pumped
'     requests cannot grow the stack without bound.
'
' The mutating classification is a conservative ALLOWLIST of read-only tools:
' anything not listed - including every extension tool - counts as
' state-changing. A read-only tool that is missing from the list merely gets
' refused during a mutation; the failure mode is never "two writes interleaved".
' ===========================================================================

Private Function IsMutatingTool(ByVal name As String) As Boolean
    IsMutatingTool = Not ToolReadOnly(name)
End Function

' R-1021-03 A1: ONE read-only classification for the whole add-in face.
' Default FALSE = state-changing (a tool nobody classified is treated as a WRITE,
' the safe direction). control_execution is a WRITE (run/break/step/end change
' execution state; it used to sit in the allowlist - that was a gate defect).
' generate_stub stays a WRITE on purpose: not in the approved reclassification set.
Private Function ToolReadOnly(ByVal name As String) As Boolean
    Select Case LCase$(name)
        Case "audit_tail", "check_component", "check_public_api", "check_references", _
             "compare_fixture", "current_position", "debug_commands", "dependency_graph", _
             "desktop_probe", "execution_state", "export_public_api", "ext_list", _
             "find_gui", "find_in_component", "get_callstack", "get_codepane", _
             "get_component_code", "get_component_list", "get_component_properties", "get_locals", _
             "get_project_info", "get_selection", "git", "ide_quiet_mode", _
             "ide_state", "last_error", "list_addins", "list_breakpoints", _
             "list_component_parts", "list_files", "list_members", "list_windows", _
             "mcp_info", "preview_edit", "project_changes", "purity_check", _
             "read_active_dialogs", "read_file", "read_source", "search_in_files", _
             "todo_status", "ui_text", "validate_code", "vba6_probe_plan", _
             "verify", "verify_scope", "workspace_status"
            ToolReadOnly = True
        Case Else
            ToolReadOnly = False
    End Select
End Function

' The machine-readable form, built from the SAME tool list tools/list serves.
Private Function ToolClassification() As Object
    Dim out As Object
    Set out = CreateObject("Scripting.Dictionary")
    Dim ro As Object, wt As Object, cov As Object
    Set ro = New Collection
    Set wt = New Collection
    Set cov = CreateObject("Scripting.Dictionary")
    On Error Resume Next
    Dim root As Object, tools As Object, t As Object, nm As String, i As Long
    Set root = BuildToolsListResult()
    If Not root Is Nothing Then Set tools = root("tools")
    If Not tools Is Nothing Then
        For i = 1 To tools.Count
            Set t = tools(i)
            nm = CStr(t("name"))
            If ToolReadOnly(nm) Then
                ro.Add nm
            Else
                wt.Add nm
            End If
        Next
    End If
    cov("declared") = ro.Count + wt.Count
    cov("readOnly") = ro.Count
    cov("write") = wt.Count
    Set cov("unclassified") = New Collection
    cov("basis") = "ToolReadOnly (single table; default=False=write)"
    cov("legacyChanged") = "control_execution: read only -> write (state-changing; no busy-time exemption)"
    Set out("readOnlyTools") = ro
    Set out("writeTools") = wt
    Set out("coverage") = cov
    Set ToolClassification = out
    Err.Clear
End Function

' patch R: an order-preserving fingerprint of the classification, so a cached graph and a
' rebuilt graph can be compared by ONE short string instead of shipping 150 tool names twice.
' Only scalar coverage values are rendered; the unclassified Collection is reported by Count.
Private Function ToolClassificationFingerprint(ByVal tcl As Object) As String
    On Error Resume Next
    Dim s As String, ro As Object, wt As Object, cov As Object, i As Long, k As Variant
    If Not IsObject(tcl) Then Exit Function
    Set ro = tcl("readOnlyTools")
    Set wt = tcl("writeTools")
    Set cov = tcl("coverage")
    If IsObject(ro) Then
        For i = 1 To ro.Count
            s = s & "R" & CStr(i) & "=" & CStr(ro(i)) & Chr$(10)
        Next
    End If
    If IsObject(wt) Then
        For i = 1 To wt.Count
            s = s & "W" & CStr(i) & "=" & CStr(wt(i)) & Chr$(10)
        Next
    End If
    If IsObject(cov) Then
        For Each k In cov.Keys
            If IsObject(cov(k)) Then
                s = s & "C" & CStr(k) & "=<count " & CStr(cov(k).Count) & ">" & Chr$(10)
            Else
                s = s & "C" & CStr(k) & "=" & CStr(cov(k)) & Chr$(10)
            End If
        Next
    End If
    ToolClassificationFingerprint = s
    Err.Clear
End Function


' FIX-7 P0: the UNIFIED dialog ledger on EVERY tool receipt. Non-JSON (plain text) bodies
' are left untouched; JSON-object bodies get dialogs[] ([] when nothing appeared) plus
' awaiting_user/howToRecover when the guard HELD a box instead of clicking it.
Private Function ModalDialogsBodySuffix(ByVal body As String) As String
    ModalDialogsBodySuffix = body
    On Error Resume Next
    If Len(body) < 2 Then Err.Clear : Exit Function
    If Right$(body, 1) <> "}" Then Err.Clear : Exit Function
    Dim q As String
    q = Chr$(34)
    Dim ins As String
    ins = ""
    If InStr(1, body, q & "dialogs" & q, vbTextCompare) = 0 Then
        Dim dl As Object
        Set dl = Nothing
        Set dl = WinOps.WoModalDialogs()
        Dim arrJ As String
        arrJ = "[]"
        If Not dl Is Nothing Then
            If dl.Count > 0 Then arrJ = JsonStringify(dl)
        End If
        ins = ins & "," & q & "dialogs" & q & ":" & arrJ
    End If
    ' FIX-18 (contract): recovery / awaiting_user / guaranteedUnsafe(+Reason) are ALWAYS
    ' emitted on a JSON receipt - honest values, explicit null for "no recovery action".
    Dim awaitingNow As Boolean
    awaitingNow = WinOps.WoModalGuardAwaiting()
    If InStr(1, body, q & "awaiting_user" & q, vbTextCompare) = 0 Then
        ins = ins & "," & q & "awaiting_user" & q & ":" & IIf(awaitingNow, "true", "false")
    End If
    If awaitingNow Then
        If InStr(1, body, q & "howToRecover" & q, vbTextCompare) = 0 Then
            Dim hr As String
            hr = WinOps.WoModalGuardHowToRecover()
            If Len(hr) > 0 Then ins = ins & "," & q & "howToRecover" & q & ":" & JsonStringify(hr)
        End If
    End If
    Dim recov As Object
    Set recov = WinOps.WoModalRecovery()
    Dim gu As Boolean
    Dim guWhy As String
    gu = False
    guWhy = ""
    If Not recov Is Nothing Then
        If recov.Exists("guaranteedUnsafe") Then gu = CBool(recov("guaranteedUnsafe"))
        If gu Then
            If recov.Exists("reason") Then guWhy = CStr(recov("reason"))
            If Len(guWhy) = 0 Then guWhy = "the recovery step is documented as not guaranteed safe"
        End If
    End If
    If InStr(1, body, q & "guaranteedUnsafe" & q, vbTextCompare) = 0 Then
        ins = ins & "," & q & "guaranteedUnsafe" & q & ":" & IIf(gu, "true", "false")
        ins = ins & "," & q & "guaranteedUnsafeReason" & q & ":" & JsonStringify(guWhy)
    End If
    If InStr(1, body, q & "recovery" & q, vbTextCompare) = 0 Then
        If recov Is Nothing Then
            ins = ins & "," & q & "recovery" & q & ":null"
        Else
            ins = ins & "," & q & "recovery" & q & ":" & JsonStringify(recov)
        End If
    End If
    If Not m_preDlgHandled Is Nothing Then
        If InStr(1, body, q & "preExistingHandled" & q, vbTextCompare) = 0 Then
            ins = ins & "," & q & "preExistingHandled" & q & ":" & JsonStringify(m_preDlgHandled)
        End If
    End If
    If Len(ins) = 0 Then Err.Clear : Exit Function
    ModalDialogsBodySuffix = Left$(body, Len(body) - 1) & ins & "}"
    Err.Clear
End Function

Private Function TextResult(ByVal body As String, ByVal isErr As Boolean) As Object
    Dim res As Object, content As Object, item As Object
    Set res = CreateObject("Scripting.Dictionary")
    Set content = New Collection
    Set item = CreateObject("Scripting.Dictionary")
    item("type") = "text"
    item("text") = StampMcp(ModalDialogsBodySuffix(body))
    content.Add item
    Set res("content") = content
    res("isError") = isErr
    Set TextResult = res
End Function

Private Function BusyRejectResult(ByVal name As String, ByVal busyTool As String, ByVal busyAt As Long, _
                                  Optional ByVal inflightTool As String = "", Optional ByVal busyKind As String = "write", Optional ByVal readonlyOk As Boolean = False) As Object
    ' (the pump-gate review / the read-answer review / the write-refusal review): busyTool + busyMs alone do not let a
    ' caller decide "wait" versus "restart the IDE". The fields below make the
    ' in-flight call machine readable, state that only the WRITE class is blocked
    ' (the write-refusal review recorded that read-only tools keep answering - that strength is
    ' preserved and is now documented in the receipt itself), and give an
    ' executable way out instead of leaving the caller to kill the IDE.
    Dim d As Object
    Dim ms As Long
    ms = GetTickCount() - busyAt
    If Len(inflightTool) = 0 Then inflightTool = busyTool
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = "busy"
    d("tool") = name
    d("busyTool") = busyTool
    d("busyMs") = ms
    d("inflight_tool") = inflightTool
    d("inflight_since_ms") = ms
    d("inflight_serviceable") = True
    d("inflight_kind") = busyKind
    Dim inFlight As Object
    Set inFlight = CreateObject("Scripting.Dictionary")
    inFlight("active") = True
    inFlight("tool") = inflightTool
    inFlight("sinceMs") = ms
    inFlight("serviceable") = True
    inFlight("kind") = busyKind
    Set d("inflight") = inFlight
    ' R-1021-03 A2: a PEER-BUSY envelope (the peer exists and is working), not
    ' no-IDE: a caller may wait, and retryAfterMs says for how long.
    d("failureKind") = "peer_busy"
    d("peerState") = "peer_busy"
    d("suggestedAction") = "retry_once"
    d("retryAfterMs") = 1000
    Dim heldBy As Object
    Set heldBy = CreateObject("Scripting.Dictionary")
    heldBy("tool") = inflightTool
    heldBy("pid") = GetCurrentProcessId()
    heldBy("sinceMs") = ms
    Set d("heldBy") = heldBy
    ' R-1021-03 A2: the single-flight gate refuses ONLY state-changing calls.
    ' A read-only call is never refused HERE; when it cannot be DELIVERED (the
    ' in-flight call does not reach a pump point) the delivery layer answers
    ' peer_unresponsive - never a fake busy from this gate.
    d("readonly_serviceable") = True
    d("readonly_gate") = "never_refused"
    d("readonly_serviceable_basis") = "the single-flight gate refuses state-changing calls only; a read-only call is served when it reaches the message-pump point of the in-flight call. Delivery still needs that pump point, which the caller must treat as unknown until a receipt arrives."
    d("readonly_serviceable_note") = "read-only tools are NOT refused by this receipt: it is produced only for a state-changing call that would interleave with the in-flight call. See readonly_gate / readonly_serviceable_basis."
    d("readonly_tools_note") = "read-only calls are not gated as mutations at any depth; the earlier claim that delivery is guaranteed during a write is WITHDRAWN (delivery needs a pump point in the in-flight call). Out-of-band recovery is the control channel (release_gate / cancel); a call wedged in a host modal loop still needs kill_and_restart."
    d("write_refused_because") = "a call is already in flight through this add-in's message pump: serving a second call there would interleave two mutations (or two readers), so it is refused instead of run"
    d("inflight_cancel") = "not available: this add-in cannot abort a call that is already running inside the host. See recovery_hint."
    d("recovery_hint") = "1) WAIT - a normal call returns within its own maxMs, after which this refusal clears itself (in flight " & CStr(ms \ 1000) & "s so far). 2) OUT-OF-BAND - send release_gate (or cancel for a pumping call) over the control channel; that does NOT preempt the running statement, but it frees the gate so the next call can run. 3) IF the in-flight call never pumps (host modal box), NO in-process channel can act: kill_and_restart is the only exit. See suggestedAction / peerState / retryAfterMs."
    d("advice") = "another state-changing tool call is in flight (" & busyTool & "). This add-in is single threaded; serving a second call from a message-pump point would interleave two mutations, so it is refused instead of run. Retry after it returns."
    d("pump") = PumpStatsJson()
    Set BusyRejectResult = TextResult(SealedReceipt(name, JsonStringify(d)), True)
End Function

' ===================== (the read-answer review / the write-refusal review) =====================
' inflight{} - the machine-readable in-flight block. It is spliced into EVERY
' read-only receipt (SealedReceipt) and every busy refusal (BusyRejectResult).
' Semantics, fixed by measurement rather than by slogan:
'   active     : a call OTHER than the one producing this receipt is in flight
'   tool       : that call's tool name
'   sinceMs    : how long it has been in flight
'   serviceable: a READ-ONLY call can still be served right now
'   kind       : write | read | nested | none
'   self*      : who produced THIS receipt
' =======================================================================
Private Function InflightJson() As String
    On Error Resume Next
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    Dim act As Boolean, who As String, since As Long, kind As String, svc As Boolean
    act = False
    who = ""
    since = 0
    kind = "none"
    svc = True
    If m_mutBusy And m_callDepth > 1 Then
        act = True
        who = m_mutBusyTool
        since = GetTickCount() - m_mutBusyAt
        kind = "write"
    ElseIf m_callDepth > 1 Then
        act = True
        who = m_callToolName
        since = GetTickCount() - m_callStartAt
        kind = "read"
    End If
    d("active") = act
    d("tool") = who
    d("sinceMs") = since
    d("serviceable") = svc
    d("kind") = kind
    d("depth") = m_callDepth
    d("self_tool") = m_callToolName
    d("self_kind") = IIf(m_callIsMut, "write", "read")
    d("cancelRequested") = m_cancelRequested
    d("readonlyWhileWrite") = (m_mutBusy And Not m_callIsMut)
    d("stampedCount") = m_inflightStamped
    ' (C): once the gate has EVER been force-released, every read-only
    ' receipt says so - the caller must be able to see that the single-flight guarantee
    ' was traded away, and for which call. While the feature is unused these keys are
    ' absent, so receipts stay byte-for-byte the pre-v1.9.0 ones.
    If m_gateReleaseCount > 0 Then
        d("gateReleased") = True
        d("gateReleaseCount") = m_gateReleaseCount
        d("gateReleasedBy") = m_gateReleasedBy
        d("gateReleasedTool") = m_gateReleasedTool
        d("gateReleasedHeldMs") = m_gateReleasedHeldMs
        d("gateReleasedAt") = m_gateReleasedAt
        d("gateReleaseReason") = m_gateReleasedReason
        d("gateReleaseNote") = "the gate was force-released for a call that never came back; that call is STILL RUNNING inside the IDE, so a write issued now can interleave with it. Dismiss the host modal (close_active_dialogs) to let it finish."
    End If
    d("note") = " (A2) the gate refuses STATE-CHANGING calls only: a read-only call that reaches this pump point IS executed and its receipt carries inflight{active:true,kind:write}. Delivery is the only open question - an in-flight call that never pumps cannot deliver ANY request; the client reports peer_unresponsive (never busy) and the out-of-band lane cannot fix it either (a statement blocked in a host modal loop is un-preemptable)."
    InflightJson = JsonStringify(d)
    Err.Clear
End Function

' build the cancel{} block of an ide_state receipt. The KEY SET
' is fixed and identical on every path (discipline 98); every un-applied path also
' carries a reason.
Private Function CancelRequestBody(ByVal byTool As String, ByVal targetTool As String, ByVal requested As Boolean) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("requested") = requested
    d("applied") = False
    d("targetTool") = ""
    d("targetKind") = ""
    d("sinceMs") = 0
    d("depth") = m_callDepth
    d("reason") = ""
    d("honorMinMs") = CANCEL_HONOR_MIN_MS
    d("note") = ""
    If Not requested Then
        d("reason") = "not_requested"
        d("note") = "pass cancel_inflight=true to ASK the in-flight call to stop (best effort: the request itself may not be delivered while the pump is held, and a call inside a host modal loop never aborts; the reliable exits are WAIT or terminate VB6 from outside)"
        Set CancelRequestBody = d
        Exit Function
    End If
    If m_callDepth <= 1 Then
        d("reason") = "nothing_in_flight"
        d("note") = "no OTHER call is in flight (this read-only call is the only one), so there is nothing to cancel"
        Set CancelRequestBody = d
        Exit Function
    End If
    Dim tt As String, tk As String
    tt = targetTool
    tk = ""
    If Len(tt) = 0 Then
        If m_mutBusy Then
            tt = m_mutBusyTool
            tk = "write"
        Else
            tt = m_callToolName
            tk = "read"
        End If
    End If
    If m_mutBusy Then
        d("sinceMs") = GetTickCount() - m_mutBusyAt
    Else
        d("sinceMs") = GetTickCount() - m_callStartAt
    End If
    m_cancelRequested = True
    m_cancelAt = GetTickCount()
    m_cancelByTool = byTool
    m_cancelTargetTool = tt
    m_cancelTargetKind = tk
    d("applied") = True
    d("targetTool") = tt
    d("targetKind") = tk
    d("reason") = "flag_set"
    d("note") = "the flag is honoured at the in-flight call's next pump point (at least " & CStr(CANCEL_HONOR_MIN_MS) & " ms into the call). A call already blocked inside a HOST modal loop never reaches one of our pump points and cannot see it - use the hub tool ide_restart for that case."
    Set CancelRequestBody = d
End Function

' called from the pump loops of the LONG calls. Only the
' OUTERMOST call (depth 1) honours a cancel, so a nested reader can never abort
' itself. Deliberately NOT wrapped in On Error Resume Next: the raise below IS the
' abort.
Public Sub MaybeHonorCancel()
    MaybeHonorDeadlines
End Sub

' R-1021-03 A3: the ONE deadline decision. cancel is evaluated BEFORE the ceiling;
' when both are due the tag keeps cancelled_by_request and appends timeoutAlsoDue.
Public Function PumpQuery() As String
    PumpQuery = ""
    If m_callDepth <> 1 Then Exit Function
    Dim cancelDue As Boolean, timeoutDue As Boolean
    cancelDue = False
    timeoutDue = False
    If m_cancelRequested Then
        If Len(m_cancelTargetTool) > 0 Then
            If (GetTickCount() - m_cancelAt) >= CANCEL_HONOR_MIN_MS Then cancelDue = True
        End If
    End If
    If m_maxCallMs > 0 And m_outerAt <> 0 Then
        If (GetTickCount() - m_outerAt) >= m_maxCallMs Then timeoutDue = True
    End If
    If cancelDue Then
        If timeoutDue Then
            PumpQuery = "cancelled_by_request|" & m_cancelTargetTool & "|" & m_cancelTargetKind & "|timeoutAlsoDue"
        Else
            PumpQuery = "cancelled_by_request|" & m_cancelTargetTool & "|" & m_cancelTargetKind
        End If
    ElseIf timeoutDue Then
        PumpQuery = "timeout|" & m_outerTool & "|" & CStr(GetTickCount() - m_outerAt) & "|" & CStr(m_maxCallMs) & "|" & m_maxMsSource
    End If
End Function

Private Sub MaybeHonorDeadlines()
    Dim tag As String
    tag = PumpQuery()
    If Len(tag) = 0 Then Exit Sub
    Util.RequestAbort tag
    Err.Raise vbObjectError + 91, "CodeTools", "MCPREASON:" & tag
End Sub

' Called by Util.PumpNow at EVERY generic pump point. The tag is recorded BEFORE the
' raise, so a caller whose On Error Resume Next swallows the raise still leaves it visible.
Public Sub PumpHook()
    Dim tag As String
    tag = PumpQuery()
    If Len(tag) = 0 Then Exit Sub
    Util.RequestAbort tag
    Err.Raise vbObjectError + 91, "CodeTools", "MCPREASON:" & tag
End Sub

' (C / defect #10): FORCE-RELEASE the single-flight gate.
'   targetDepth = the depth to KEEP. A caller that is itself executing INSIDE the gate
'   (ide_state) passes 1 so its own frame stays counted; a caller that runs BEFORE its own
'   depth is incremented (CallTool entry, i.e. the armed release) passes 0.
'   The returned Dictionary has a FIXED key set on every path, so a caller can branch on
'   reason/released without probing for keys.
Private Function ForceReleaseGate(ByVal byTool As String, ByVal why As String, ByVal minHeldMs As Long, ByVal targetDepth As Long) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("attempted") = True
    d("released") = False
    d("releasedTool") = ""
    d("releasedKind") = ""
    d("heldMs") = 0
    d("minHeldMs") = minHeldMs
    d("retryAfterMs") = 0
    d("depthBefore") = m_callDepth
    d("depthAfter") = m_callDepth
    d("targetDepth") = targetDepth
    d("mutBusyBefore") = m_mutBusy
    d("abandonedSeq") = 0
    d("reason") = ""
    d("gateReleaseCount") = m_gateReleaseCount
    d("statementInterrupted") = False
    d("timeoutMsEnforcedBy") = "gate_age_threshold"
    d("note") = ""
    d("recoveryAction") = ""
    d("recoveryHint") = ""
    If m_callDepth <= targetDepth Then
        d("reason") = "nothing_in_flight"
        d("note") = "no OTHER call is in flight (this read-only call is the only one), so there is nothing to release"
        Set ForceReleaseGate = d
        Exit Function
    End If
    Dim tk As String, at As Long
    tk = ""
    at = 0
    If m_mutBusy Then
        tk = m_mutBusyTool
        at = m_mutBusyAt
    Else
        tk = m_outerTool
        at = m_outerAt
    End If
    Dim held As Long
    held = GetTickCount() - at
    d("releasedTool") = tk
    d("releasedKind") = IIf(m_mutBusy, "write", "read")
    d("heldMs") = held
    If minHeldMs < 0 Then minHeldMs = 0
    d("minHeldMs") = minHeldMs
    If held < minHeldMs Then
        d("reason") = "age_below_threshold"
        d("retryAfterMs") = minHeldMs - held
        d("note") = "the in-flight call is younger than minHeldMs, so NOTHING was touched. This threshold is what keeps a HEALTHY long call (a normal build, a slow write) from losing the single-flight guarantee."
        d("recoveryAction") = "call ide_state{release_inflight:true, release_min_held_ms:<ms>} again after retryAfterMs"
        d("recoveryHint") = "wait retryAfterMs and repeat the call"
        Set ForceReleaseGate = d
        Exit Function
    End If
    ' ---- the release ----
    m_gateReleaseCount = m_gateReleaseCount + 1
    m_gateReleasedBy = byTool
    m_gateReleasedTool = tk
    m_gateReleasedHeldMs = held
    m_gateReleasedAt = Format$(Now, "yyyy-mm-dd hh:nn:ss")
    m_gateReleasedReason = why
    m_abandonSeq = m_outerSeq
    m_callDepth = targetDepth
    m_mutBusy = False
    m_mutBusyTool = ""
    m_mutBusyAt = 0
    m_armMs = 0
    m_armTool = ""
    m_armAt = 0
    d("released") = True
    d("abandonedSeq") = m_abandonSeq
    d("depthAfter") = m_callDepth
    d("gateReleaseCount") = m_gateReleaseCount
    d("reason") = why
    d("note") = "the blocked call is STILL RUNNING inside the IDE; the gate was force-released and the work it was doing was NOT undone. This add-in cannot preempt EbExecuteLine, so no statement was interrupted."
    d("recoveryAction") = "close_active_dialogs"
    d("recoveryHint") = "the blocked call usually waits on the IDE's OWN modal run-time-error box (read_active_dialogs shows it with ownerDisabled=true). Dismiss that box (close_active_dialogs) so the blocked call can return - its unwind is swallowed exactly once, so the depth can never be decremented twice. If no modal is present the statement is simply still running: use the hub tool ide_restart, or wait."
    Set ForceReleaseGate = d
End Function

' FIX-7 P0: tools whose OWN capture path must win over the guard's runtime-error policy:
' they READ the box and click DEBUG themselves, so the unified guard must HOLD instead of
' clicking. Everything else may press DEBUG on a runtime-error box.
' FIX-21: tools that only touch Win32 / plain files are safe while a modal box owns the IDE.
' Everything else is refused structurally (see the entry gate) instead of blocking to timeout.
Private Function ModalBoxSafeTool(ByVal name As String) As Boolean
    Select Case LCase$(name)
        Case "ide_state", "mcp_info", "read_active_dialogs", "find_gui", "list_windows", _
             "desktop_probe", "execution_state", "ui_text", "last_error", "audit_tail", _
             "close_active_dialogs", "send_window_message", "list_files", "read_file", _
             "read_source", "git", "todo_status", "ide_list"
            ModalBoxSafeTool = True
        Case Else
            ModalBoxSafeTool = False
    End Select
End Function

' FIX-21: structured refusal for "a pre-existing modal box is still blocking the IDE".
Private Function ModalBlockedJson(ByVal toolName As String, ByVal hb As Object) As String
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = "modal_blocked_by_preexisting_box"
    d("tool") = toolName
    d("hwnd") = CLng(hb("hwnd"))
    d("title") = CStr(hb("title"))
    d("classification") = CStr(hb("classification"))
    d("policyAction") = CStr(hb("policyAction"))
    d("held") = CBool(hb("held"))
    d("dialogCount") = CLng(hb("dialogCount"))
    d("sideEffects") = "none: no IDE call was attempted"
    d("howToProceed") = "answer or dismiss the dialog manually (program MsgBoxes are never answered for you), or call close_active_dialogs explicitly, then retry"
    d("detail") = "a pre-existing owner-disabled modal dialog is still on screen; entering the IDE now would block until the host modal loop ends"
    ModalBlockedJson = JsonStringify(d)
End Function

Private Function ModalRuntimeAwareTool(ByVal name As String) As Boolean
    Dim n As String
    n = LCase$(Trim$(name))
    ModalRuntimeAwareTool = (n = "ide_state" Or n = "last_error" Or n = "debug_session" _
        Or n = "run_until_break" Or n = "control_execution" Or n = "run_project")
End Function

Public Function CallTool(ByVal name As String, ByVal args As Object) As Object
    ' the gate. m_callDepth > 0 means this call arrived from a
    ' message-pump point inside another tool call (a normal call always starts
    ' at depth 0).
    ' (C): every call carries a token. The token is what makes the forced
    ' release safe: only the frame whose token was abandoned skips its unwind.
    m_callSeq = m_callSeq + 1
    Dim mySeq As Long
    mySeq = m_callSeq
    If m_callDepth > 0 Then
        ' (B/C): an ARMED immediate_* call that outlived its own timeout_ms is
        ' released HERE, before the gate is consulted, so THIS call is the one that finds the
        ' session usable again instead of being refused with reason=busy.
        MaybeAutoRelease
    End If
    If m_callDepth > 0 Then
        ' (1) a state-changing call is ALREADY in flight.
        ' (the write-refusal review kept / the read-answer review answered): a WRITE is STILL refused -
        ' two mutations must never interleave - but a READ-ONLY call is now SERVED.
        ' That is the strength the user recorded (ide_state answered in 16 ms while a
        ' write was busy). measured the opposite for the make_project case (the
        ' read was refused too); nothing is hidden by this change: the served read
        ' carries inflight{active:true,kind:"write"}, so the caller can see it may be
        ' reading a mid-mutation snapshot.
        If m_mutBusy Then
            If IsMutatingTool(name) Then
                Set CallTool = BusyRejectResult(name, m_mutBusyTool, m_mutBusyAt, m_mutBusyTool, "write", False)
                Exit Function
            End If
        End If
        ' (2) THIS call changes state and would start inside another call's pump.
        '     It is refused even when the outer call is read-only: a write must
        '     never run re-entrantly, and the outer read-only loop would otherwise
        '     keep reporting a snapshot the write has already invalidated.
        If IsMutatingTool(name) Then
            Set CallTool = BusyRejectResult(name, m_callToolName & " (outer call, in flight since " & CStr(GetTickCount() - m_callStartAt) & " ms ago)", m_callStartAt, m_callToolName, "read", True)
            Exit Function
        End If
        ' (3) bound the nesting depth of pumped read-only requests.
        If m_callDepth >= CALL_DEPTH_MAX Then
            Set CallTool = BusyRejectResult(name, "nested depth " & CStr(m_callDepth), GetTickCount(), m_callToolName, "nested", False)
            Exit Function
        End If
    End If
    Dim wasMut As Boolean
    wasMut = IsMutatingTool(name)
    Dim prevSelfMut As Boolean
    prevSelfMut = m_callIsMut
    m_callDepth = m_callDepth + 1
    m_callToolName = name
    m_callStartAt = GetTickCount()
    m_callIsMut = wasMut
    ' one reset point for the whole call, at the only funnel every tool goes
    ' through, so no receipt can inherit the previous call's project-directory writes.
    ' (plan B): a 'nested read-only call' is exactly what the retraction retires - a
    ' second call at depth>0 is refused, so nothing downstream may rely on being served there.
    ' only the OUTERMOST call may reset them. A nested read-only call
    ' (served at the pump point while a write is in flight, see the gate above) used to
    ' wipe the OUTER call's sideEffects/undo manifest half-way through the write.
    If m_callDepth = 1 Then
        ' (C): the OUTERMOST frame's identity, captured BEFORE a nested read can
        ' overwrite m_callToolName / m_callStartAt (it sets both for ITSELF), so a forced
        ' release can never name the wrong tool.
        m_outerSeq = mySeq
        m_outerTool = name
        m_outerAt = GetTickCount()
        Set m_dirWrites = New Collection
        Set m_paneDiskMaps = CreateObject("Scripting.Dictionary")
        SeReset
        ' R-1021-03 A3: ARM ONLY AFTER the busy judgement above, so a refused call
        ' never leaves an armed release behind. Budget comes from ToolBudgetMs.
        Dim callBudget As Long
        Dim callBudgetSrc As String
        callBudget = ToolBudgetMs(name, args, callBudgetSrc)
        ArmGateRelease name, callBudget, callBudgetSrc
        ' FIX-7 P0: the UNIFIED MODAL GUARD. Every tool call is covered here, not just the
        ' three sites that used to arm it. Runtime-aware tools HOLD on a runtime-error box
        ' (their own READ->DEBUG capture must win); everything else may press DEBUG there.
        WinOps.WoModalGuardArmGlobal name, MODAL_GUARD_WAIT_MS, (Not ModalRuntimeAwareTool(name))
        ' FIX-14: a box left on screen with NO in-flight call is handled inside THIS call,
        ' so boxes do not accumulate across calls.
        ' FIX-21b: only enter the title-reading handler when a MESSAGE-FREE scan already saw a
        ' visible #32770; on a clean IDE this path performs no window message at all.
        Dim preCnt As Long
        preCnt = 0
        If WinOps.WoModalFastPresent(preCnt) Then
            Set m_preDlgHandled = WinOps.WoModalClearPreexisting()
        Else
            Set m_preDlgHandled = Nothing
        End If
        ' FIX-21: if a pre-existing owner-disabled box is STILL on screen (HOLD-policy program
        ' MsgBox, or a box our safe caps could not dismiss), do NOT enter the IDE: refuse
        ' immediately with evidence. Reads that only touch Win32/Files stay served.
        If Not ModalBoxSafeTool(name) Then
            Dim hb As Object
            Set hb = WinOps.WoModalBlockingBox()
            If Not hb Is Nothing Then
                Call CallUnwind(name, mySeq, wasMut, prevSelfMut)
                Set CallTool = TextResult(SealedReceipt(name, ModalBlockedJson(name, hb)), False)
                Exit Function
            End If
        End If
    End If
    If wasMut Then
        m_mutBusy = True
        m_mutBusyTool = name
        m_mutBusyAt = GetTickCount()
    End If
    PumpReset
    On Error GoTo WrapperFail
    Set CallTool = CallToolInner(name, args)
    On Error GoTo 0
    CallUnwind name, mySeq, wasMut, prevSelfMut
    Exit Function
WrapperFail:
    Dim wErr As Long, wMsg As String
    wErr = Err.Number
    wMsg = Err.Description
    Err.Clear
    CallUnwind name, mySeq, wasMut, prevSelfMut
    Set CallTool = TextResult(SealedReceipt(name, UnexpectedErrorJson(name, wMsg, wErr)), True)
End Function

' (C): the ONE unwind point. A frame whose token was abandoned by a forced
' release must NOT unwind again - the release already dropped it from m_callDepth, and
' decrementing a second time would leave a phantom outer frame that makes later calls be
' refused with reason=busy intermittently (the exact class of bug the lead asked to rule out).
Private Sub CallUnwind(ByVal name As String, ByVal mySeq As Long, ByVal wasMut As Boolean, ByVal prevSelfMut As Boolean)
    If mySeq <> 0 And mySeq = m_abandonSeq Then
        ' Swallow this unwind exactly once. The CURRENT in-flight accounting (a newer call)
        ' is left untouched.
        m_abandonSeq = 0
        Exit Sub
    End If
    m_callDepth = m_callDepth - 1
    ' Only the call that OWNS the flag may clear it: an abandoned frame can return while a
    ' NEW write is in flight, and clearing it there would let a third call interleave.
    If wasMut Then
        If m_mutBusyTool = name Then m_mutBusy = False
    End If
    m_callIsMut = prevSelfMut
    If m_callDepth = 0 Then
        m_cancelRequested = False
        m_maxCallMs = 0
        m_maxMsSource = ""
        Util.ClearAbort
        DisarmGateRelease
        ' FIX-7 P0: the unified guard lives exactly as long as the outermost call.
        WinOps.WoModalGuardDisarmGlobal
    End If
End Sub

' (B): the armed, SELF-HEALING release. immediate_eval / immediate_run arm it
' immediately before handing their line to EbExecuteLine and disarm it on a normal return.
' If the engine never comes back, the arm survives and the next tool call releases the gate
' on its own, so one bad statement cannot leave the session permanently busy.
Private Sub MaybeAutoRelease()
    If m_armMs <= 0 Then Exit Sub
    If Not m_mutBusy Then Exit Sub
    If Len(m_armTool) = 0 Then Exit Sub
    If m_mutBusyTool <> m_armTool Then Exit Sub
    If (GetTickCount() - m_mutBusyAt) < m_armMs Then Exit Sub
    ' byTool says WHO/WHAT released it: "armed_release" is the automatic arm, NOT an
    ' ide_state call that carried release_inflight=true. Labelling it "ide_state" made the
    ' receipt claim a request nobody made (caught on the live run of this very card).
    Call ForceReleaseGate("armed_release", "auto_released_armed_timeout", m_armMs, 0)
End Sub

' =====================================================================
' an earlier fix (defects #10 / #11 / #4): the three call paths that were
' measured to hang on a host modal now share ONE bounded protocol:
'   arm   -> WinOps.WoModalGuardArm(tool, MODAL_GUARD_WAIT_MS)  (Cancel-first
'            dismissal of the box, driven by the watchdog tick and by our own pump)
'         -> ArmGateRelease(tool, wait + slack)                 (the BACKSTOP: if the
'            call still never comes back, the next tool call releases the single-flight
'            gate by itself, so the chain does not stay busy for ever)
'   settle-> ModalGuardSettle()   (bounded pump so the tick can run even when the
'            failing call did NOT block inside the modal)
'   disarm-> WinOps.WoModalGuardDisarm + DisarmGateRelease
'   report-> MergeModalGuard(root) or ModalGuardFragment(), on EVERY path.
' Nothing here is silent: a guard that saw nothing, a guard that dismissed a box and a
' guard that could NOT dismiss one all produce DIFFERENT, machine-readable receipts.
' =====================================================================

' The backstop. Reuses the EXACT machinery immediate_eval / immediate_run already use
' (MaybeAutoRelease -> ForceReleaseGate ... "armed_release" ...), so no new state is
' introduced and the existing receipt already says WHO released WHAT and WHY.
Public Sub ArmGateRelease(ByVal toolName As String, ByVal budgetMs As Long, Optional ByVal source As String = "")
    If budgetMs < 1000 Then budgetMs = 1000
    ' R-1021-03 A3: a SITE arm must never SHORTEN the call-wide ceiling set by
    ' CallTool; otherwise the armed self-release would fire while the tool is
    ' still legitimately running. Clamp UP to m_maxCallMs.
    If m_maxCallMs > 0 Then
        If budgetMs < m_maxCallMs Then budgetMs = m_maxCallMs
    End If
    m_armTool = toolName
    m_armMs = budgetMs
    m_armAt = GetTickCount()
    ' a SITE arm (no source) only refreshes the release window; the call-wide ceiling
    ' was fixed by the generic arm at CallTool entry and survives inner arms/disarms.
    If Len(source) > 0 Then
        m_maxCallMs = budgetMs
        m_maxMsSource = source
    End If
End Sub

Public Sub DisarmGateRelease()
    ' FIX-7 P0: a SITE disarm must not cancel the CALL-WIDE backstop armed by CallTool;
    ' only the outer unwind (m_callDepth = 0) may clear it.
    If m_maxCallMs > 0 Then
        If m_callDepth > 0 Then Exit Sub
    End If
    m_armMs = 0
    m_armTool = ""
    m_armAt = 0
End Sub

' R-1021-03 A3: ONE budget table (mirror of the bridge tool_budget()).
' generic ceiling = VB6MCP_MAX_CALL_MS (120000); absolute cap = VB6MCP_MAX_CALL_HARD_MS (600000).
Private Function ToolBudgetMs(ByVal name As String, ByVal args As Object, ByRef source As String) As Long
    Dim genericCeiling As Long, hardCap As Long, self As Long, lname As String
    genericCeiling = Util.EnvLongOr("VB6MCP_MAX_CALL_MS", 120000)
    If genericCeiling < 1000 Then genericCeiling = 1000
    If genericCeiling > 900000 Then genericCeiling = 900000
    hardCap = Util.EnvLongOr("VB6MCP_MAX_CALL_HARD_MS", 600000)
    If hardCap < genericCeiling Then hardCap = genericCeiling
    If hardCap > 900000 Then hardCap = 900000
    self = 0
    source = "env_ceiling"
    lname = LCase$(name)
    Select Case lname
        Case "immediate_eval", "immediate_run"
            self = JsonGetLong(args, "timeout_ms", 5000)
            If self < 1000 Then self = 1000
            If JsonHasKey(args, "timeout_ms") Then
                source = "param"
            Else
                source = "tool_default"
            End If
        Case "make_project"
            self = 140000
            source = "tool_default"
        Case "build"
            self = JsonGetLong(args, "timeout_ms", 180000) + 15000
            source = "param_slack"
        Case "run_project"
            Dim rpObs As Long
            Dim rpWait As Long
            rpObs = JsonGetLong(args, "observe_max_wait_ms", 0)
            rpWait = JsonGetLong(args, "timeout_ms", 15000)
            If rpObs > rpWait Then rpWait = rpObs
            If rpWait < 1000 Then rpWait = 1000
            If rpWait > 120000 Then rpWait = 120000
            self = rpWait + 20000
            source = "param_slack"
        Case "debug_session", "run_until_break"
            self = JsonGetLong(args, "timeout_ms", 30000) + 8000
            source = "param_slack"
        Case "dependency_graph"
            Dim depBudget As Long
            depBudget = JsonGetLong(args, "budget_ms", 0)
            If depBudget < 25000 Then depBudget = 25000
            self = depBudget + 8000
            If self < 33000 Then self = 33000
            source = "param_slack"
        Case "eval_at_frame"
            self = JsonGetLong(args, "timeoutMs", 5000) + 2000
            source = "param_slack"
        Case "get_locals"
            If JsonGetBool(args, "allowUnsafeInBreak", False) Then
                self = 25000
                source = "param_slack"
            Else
                self = 8000
                source = "tool_default"
            End If
        Case Else
            self = genericCeiling
            source = "env_ceiling"
    End Select
    If self < 1 Then self = genericCeiling
    If self > hardCap Then
        self = hardCap
        source = source & "+hard_cap"
    End If
    ToolBudgetMs = self
End Function

Private Function JsonHasKey(ByVal d As Object, ByVal k As String) As Boolean
    JsonHasKey = False
    If d Is Nothing Then Exit Function
    On Error Resume Next
    JsonHasKey = d.Exists(k)
    Err.Clear
End Function

' Bounded pump. The host modal loop drives WheelTick by itself, but a box can also be
' merely POSTED rather than reached synchronously; pumping here covers that case and
' lets the guard finish before the tool returns. Always bounded, and the cooperative
' cancel is honoured at this pump point exactly like every other pump in this class.
Public Sub ModalGuardSettle(ByVal waitMs As Long)
    ' WHY THIS IS NOT JUST "pump for waitMs": the host's modal loop drives the guard by
    ' itself (that is what proved), so when the risky call really DID block on
    ' a box the box is already gone by the time we get here. The pump exists only for the
    ' case where a box is merely POSTED rather than reached synchronously. Waiting the
    ' whole budget on every HEALTHY call would therefore add a needless 15 s stall to
    ' native_breakpoint - measured on this card's first build (15085 ms for a toggle that
    ' should take milliseconds). So: a SHORT grace period while no box is in sight, and
    ' the FULL budget only once the guard has actually seen a blocking box.
    Const MG_GRACE_MS As Long = 1200
    Dim t0 As Long
    Dim deadline As Long
    t0 = GetTickCount()
    deadline = t0 + MG_GRACE_MS
    On Error Resume Next
    Do While WinOps.WoModalGuardPending()
        WinOps.WoModalGuardTick
        MaybeHonorCancel
        If Util.PumpAbortDue() Then Exit Do
        ' with a host modal box UP this loop must NOT pump - DoEvents would enter
        ' the host's modal loop and never return. The guard's click has already
        ' been sent synchronously by the tick above; the host observes it when this call
        ' returns. Exiting here keeps the settle BOUNDED instead of busy-waiting a pump that
        ' can never be delivered.
        If Not CanPump() Then Exit Do
        DoEvents
        If WinOps.WoModalGuardSawBox() Then deadline = t0 + waitMs
        If GetTickCount() >= deadline Then Exit Do
    Loop
    Err.Clear
End Sub

' Copy the guard receipt onto a Dictionary-shaped reply. Called on EVERY return path of
' the tools that arm the guard.
Public Sub MergeModalGuard(ByRef root As Object)
    On Error Resume Next
    Dim mg As Object
