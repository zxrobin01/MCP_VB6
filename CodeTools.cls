    Set m("diagnosis") = diagEmpty
    Set m("output") = ArtifactFullSnap("")
    Set MakeReceiptEmpty = m
End Function

Private Function ToolMakeProject(ByVal outputPath As String, ByVal route As String, _
                                 ByVal outPath As String, ByVal timeoutMs As Long, _
                                 ByVal allowHostModal As Boolean, _
                                 ByVal laaGiven As Boolean, ByVal laaParam As Boolean, _
                                 ByVal diagnoseWant As Boolean, ByVal waitForBuildMs As Long, _
                                 ByVal projectParam As String, Optional ByVal allowIde As Boolean = False) As String
    Dim cbR As Object
    If CmdBarsRunRefusal("make_project", cbR) Then
        ToolMakeProject = JsonStringify(cbR)
        Exit Function
    End If
    Dim t0 As Long
    t0 = GetTickCount()
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    ' how long this call waits for the artifact to land. The historical
    ' 15 s default is unchanged; wait_for_build=<ms> (floor 15000, cap 120000) extends it.
    ' The same budget feeds the gate backstop below, so a longer wait can never be cut
    ' short by the single-flight gate release.
    Dim waitBudget As Long
    waitBudget = MAKE_LAND_WAIT_MS
    If waitForBuildMs > 0 Then waitBudget = waitForBuildMs
    If waitBudget < MAKE_LAND_WAIT_MS Then waitBudget = MAKE_LAND_WAIT_MS
    If waitBudget > MAKE_LAND_WAIT_MAX_MS Then waitBudget = MAKE_LAND_WAIT_MAX_MS
    ' MakeCompiledFile / the Make menu command open a modal Save dialog for
    ' unsaved projects. Save silently first, or fail with guidance.
    If Len(p.FileName) = 0 Then
        Err.Raise vbObjectError + 40, "CodeTools", "Project is unsaved: compiling would open VB6's Save dialog. Call save_project with a path first, then retry."
    End If
    ' ---- (3.3): route=cli is a FIRST-CLASS route, not a footnote ---
    ' The user reported that VB6.EXE /make <vbp> /out <log> is the reliable path, and
    ' it is the only route that produces a compiler log. route=cli delegates to it
    ' (the build tool) and returns that receipt verbatim, so route/path say which
    ' route actually ran instead of pretending.
    Dim effRoute As String
    effRoute = LCase$(Trim$(route))
    If Len(m_makeRouteOverride) > 0 Then effRoute = m_makeRouteOverride
    If Len(effRoute) = 0 Then effRoute = "auto"

    If effRoute = "cli" Then
        If timeoutMs <= 0 Then timeoutMs = 180000
        ' W-C: an EXPLICIT project is honoured on the CLI route (compiles that .vbp, not the open one).
        Dim cliTarget As String
        cliTarget = ""
        If Len(projectParam) > 0 Then cliTarget = ResolvePath(projectParam)
        If Len(projectParam) > 0 And Len(cliTarget) = 0 Then
            Dim badProj As Object
            Set badProj = MakeReceiptEmpty()
            badProj("ok") = False
            badProj("verdict") = "project_not_found"
            badProj("requestedProject") = projectParam
            badProj("route") = "cli"
            badProj("note") = "route=cli was asked for an explicit project, but the path did not resolve; nothing was compiled"
            ToolMakeProject = JsonStringify(badProj)
            Exit Function
        End If
        If Len(cliTarget) = 0 Then cliTarget = p.FileName
        Dim prevOverride As String
        prevOverride = m_makeRouteOverride
        ' break the cycle: if build decides the IDE holds this project it must fall
        ' back to the IN-IDE path, never back into route=cli.
        m_makeRouteOverride = "ide"
        Dim cliJson As String
        Dim cliErr As Long, cliDesc As String
        cliErr = 0
        cliDesc = ""
        On Error Resume Next
        cliJson = ToolBuild(cliTarget, "", outPath, timeoutMs, laaGiven, laaParam, False)
        cliErr = Err.Number
        cliDesc = Err.Description
        Err.Clear
        On Error GoTo 0
        m_makeRouteOverride = prevOverride
        If cliErr <> 0 Then
            Dim er As Object
            Set er = MakeReceiptEmpty()
            er("ok") = False
            er("verdict") = "cli_route_failed"
            er("requestedRoute") = "cli"
            er("route") = "cli"
            er("logUnavailableReason") = "the isolated VB6.EXE /make subprocess could not be started: " & cliDesc
            er("recovery_hint") = "retry with the in-IDE route (the default) to compile inside the IDE, or call the build tool directly with an explicit out_path."
            er("note") = "route=cli failed before a compiler log existed (" & CStr(cliErr) & ")"
            ToolMakeProject = JsonStringify(er)
            Exit Function
        End If
        ToolMakeProject = cliJson
        Exit Function
    End If
    If Len(projectParam) > 0 Then
        Dim ideNoProj As Object
        Set ideNoProj = MakeReceiptEmpty()
        ideNoProj("ok") = False
        ideNoProj("verdict") = "project_requires_cli_route"
        ideNoProj("requestedProject") = projectParam
        ideNoProj("route") = "ide"
        ideNoProj("note") = "route=ide compiles whatever the IDE holds, so an explicit project is meaningless there; use route=cli (or the build tool) with project=<absolute .vbp>"
        ideNoProj("howToProceed") = "call make_project{route:""cli"", project:""<absolute .vbp>""} or build{project:""<absolute .vbp>""}"
        ToolMakeProject = JsonStringify(ideNoProj)
        Exit Function
    End If
    ' R-1021-04 (item 2, BEHAVIOUR PRESERVED): the in-IDE route SAVES the project
    ' itself before compiling, exactly as it always did. MakeCompiledFile on a
    ' project the IDE still considers dirty makes VB6 raise its own "save changes?"
    ' box, which this single-threaded add-in cannot answer - so the save must happen
    ' BEFORE the Make, never be skipped. What this card changed is only the
    ' REPORTING: the save is now visible as autoSaved + autoSavedComponents, and a
    ' dirty project is REFUSED only when the save itself fails. Dirty state is
    ' decided from the VBIDE flags ONLY (never from file timestamps).
    Dim dirtyNames As String
    Dim dirtyCount As Long
    Dim dirtyUnknown As Boolean
    Dim pbSaved As Boolean
    Dim autoSaved As Boolean
    Dim autoSavedComps As String
    Dim autoSaveJson As String
    Dim saveErr As Long
    Dim saveDesc As String
    Dim dscan As Object
    dirtyNames = ""
    dirtyCount = 0
    dirtyUnknown = False
    pbSaved = True
    autoSaved = False
    autoSavedComps = ""
    autoSaveJson = ""
    saveErr = 0
    saveDesc = ""
    ' R-1021-04 (item B): ONE dirty scan for the whole add-in (ProjectDirtyScan).
    ' build's cache guard consults the SAME function, so the two entries cannot
    ' disagree about whether this project is dirty.
    Set dscan = McpProjTools.ProjectDirtyScan(Me, p)
    dirtyNames = CStr(dscan("dirtyNames"))
    dirtyCount = CLng(dscan("dirtyCount"))
    dirtyUnknown = CBool(dscan("dirtyUnknown"))
    pbSaved = CBool(dscan("projectSaved"))
    If dirtyCount > 0 Then
        ' (4) a project with NO file name cannot be saved at all. That is the
        ' ORIGINAL failure path, kept separate from the dirty check on purpose: it
        ' fails whether or not the project was dirty.
        If Len(p.FileName) = 0 Then
            Err.Raise vbObjectError + 40, "CodeTools", "Could not save the project before compiling: the project has no file name"
        End If
        ' (2) dirty => SAVE FIRST (the historical behaviour), then report it.
        ' MEASURED (remote build, 2026-10-21): VBProject.SaveAs <the project's own
        ' file> rewrote the .vbp and left the dirty COMPONENT files untouched, so a
        ' receipt that only reported 'attempted a save' claimed a write the disk did
        ' not show. The save therefore runs through the SAME path save_project uses
        ' (per-component SaveAs + project flush, verified by reading every file back),
        ' and its receipt is carried out verbatim as the evidence.
        On Error Resume Next
        Err.Clear
        autoSaveJson = ToolSaveProject("")
        saveErr = Err.Number
        saveDesc = Err.Description
        If saveErr = 0 Then
            If InStr(1, autoSaveJson, Chr$(34) & "ok" & Chr$(34) & ":true", vbTextCompare) = 0 Then
                saveErr = vbObjectError + 41
                saveDesc = "the pre-compile save reported ok:false"
                Dim srWhy As String
                srWhy = IdeJsonStrMember(autoSaveJson, "error")
                If Len(srWhy) = 0 Then srWhy = IdeJsonStrMember(autoSaveJson, "reason")
                If Len(srWhy) > 0 Then saveDesc = saveDesc & ": " & srWhy
            End If
        End If
        Err.Clear
        On Error GoTo 0
        If saveErr <> 0 Then
            ' (3) the save FAILED => structured refusal; the Make is NOT started.
            Dim dirtyR As Object
            Dim saveErrObj As Object
            Set saveErrObj = CreateObject("Scripting.Dictionary")
            saveErrObj("number") = saveErr
            saveErrObj("description") = saveDesc
            Set dirtyR = MakeReceiptEmpty()
            dirtyR("ok") = False
            dirtyR("compiled") = False
            dirtyR("route") = "ide"
            dirtyR("buildState") = "refused_dirty_project"
            dirtyR("verdict") = "refused_dirty_project"
            dirtyR("refused") = True
            dirtyR("refuseReason") = "project_dirty_save_failed"
            dirtyR("dirtyProject") = Not pbSaved
            dirtyR("dirtyComponentCount") = dirtyCount
            dirtyR("dirtyComponents") = dirtyNames
            dirtyR("dirtyFlagsUnreadable") = dirtyUnknown
            dirtyR("autoSaved") = False
            dirtyR("autoSavedComponents") = ""
            If Len(autoSaveJson) > 0 Then dirtyR("saveProjectReceipt") = autoSaveJson
            Set dirtyR("saveError") = saveErrObj
            dirtyR("errorCount") = 0
            dirtyR("firstErrorUnavailable") = True
            dirtyR("firstErrorUnavailableReason") = "project_dirty_save_failed"
            dirtyR("firstErrorUnavailableSource") = "make_project_preflight"
            dirtyR("howToProceed") = "save_project first, then rebuild"
            dirtyR("buildStarted") = False
            dirtyR("artifactChanged") = False
            dirtyR("note") = "the project was dirty and the pre-compile save FAILED, so the in-IDE Make was NOT started and nothing was compiled, moved aside or written. The refusal is about the SAVE, not about being dirty: with a successful save this route proceeds exactly as before."
            dirtyR("elapsedMs") = GetTickCount() - t0
            Call ApplyHostModalFields(dirtyR, "preflight")
            If Len(CStr(dirtyR("stopReason"))) = 0 Then dirtyR("stopReason") = "refused"
            WinOps.WoModalGuardSiteDisarm
            DisarmGateRelease
            Call MergeModalGuard(dirtyR)
            ToolMakeProject = JsonStringify(dirtyR)
            Exit Function
        End If
        autoSaved = True
        autoSavedComps = dirtyNames
    End If
    ' P1/P12: the in-IDE route saves the project itself (it does not go through
    ' save_project), so the canonical Reference= repair runs here too. At most one
    ' extra .vbp write pass, and only when a relative path actually changes.
    Dim mpPaths As Object
    Set mpPaths = McpProjTools.ProjectPathInfo(Me, p)
    Dim mpRefs As Object
    Set mpRefs = NewRefsInfo()
    Dim mpRefsPasses As Long
    mpRefsPasses = 0
    On Error Resume Next
    mpRefsPasses = McpProjTools.VbpRefsRepairOnDisk(Me, p.FileName, mpPaths, mpRefs)
    If Err.Number <> 0 Then Err.Clear
    On Error GoTo 0
    ' ---- (A10 sidecar): resolve WHERE the LAA decision comes from ----
    Dim laaWant As Boolean, laaSrc As String, laaProjFile As String, laaSrcNote As String, laaCfgErr As String
    Dim laaUsable As Boolean
    laaUsable = LaaResolve(p.FileName, laaGiven, laaParam, laaWant, laaSrc, laaProjFile, laaSrcNote, laaCfgErr)
    ' ---- the artifact BEFORE anything is touched ------------------
    Dim targetExe As String
    targetExe = MakeTargetPath(p, outputPath)
    Dim before As Object
    Set before = ArtifactFullSnap(targetExe)
    Dim root As Object
    Set root = MakeReceiptEmpty()
    root("requestedRoute") = effRoute
    ' R-1021-04 (item 2): the dirty branch's OUTCOME is published on EVERY path, so a
    ' caller can tell 'nothing to save' from 'saved on your behalf' without guessing.
    ' autoSaved=true means this call wrote the dirty project to disk before compiling.
    root("autoSaved") = autoSaved
    root("autoSavedComponents") = autoSavedComps
    root("autoSaveVia") = ""
    If autoSaved Then root("autoSaveVia") = "save_project"
    If Len(autoSaveJson) > 0 Then root("autoSaveReceipt") = autoSaveJson
    root("dirtyProject") = Not pbSaved
    root("dirtyComponentCount") = dirtyCount
    root("dirtyComponents") = dirtyNames
    root("dirtyFlagsUnreadable") = dirtyUnknown
    root("artifactPath") = targetExe
    root("route") = "ide"
    ' FIX-24 (F6): the in-IDE Make compiles the PANE. Say so explicitly, and MEASURE whether the
    ' pane and the disk file differed at compile time: a cached verdict from this build can only
    ' describe the disk source when they agree. The scan runs AFTER the pre-compile auto-save, so
    ' a normal dirty project reports paneDiskMismatch=false.
    Dim pdmNames As Object
    Dim pdmCount As Long
    Dim pdmText As String
    Dim pdmV As Variant
    Set pdmNames = New Collection
    pdmCount = PaneDiskMismatchScan(pdmNames)
    pdmText = ""
    For Each pdmV In pdmNames
        If Len(pdmText) > 0 Then pdmText = pdmText & "|"
        pdmText = pdmText & CStr(pdmV)
    Next
    root("compiledFrom") = "pane"
    root("compiledFromBasis") = "VBProject.MakeCompiledFile compiles what the code pane holds; it starts no compiler subprocess and reads no file"
    root("paneDiskMismatch") = (pdmCount > 0)
    root("paneDiskMismatchCount") = pdmCount
    root("paneDiskMismatchNames") = pdmText
    Set root("paneDiskMismatchComponents") = pdmNames
    If pdmCount < 0 Then
        root("paneDiskMismatchReadError") = True
        root("paneDiskMismatchNote") = "the pane-vs-disk scan could not read the project, so it is UNKNOWN (not false) whether this build compiled source that matches the disk"
    ElseIf pdmCount > 0 Then
        root("paneDiskMismatchNote") = "at compile time the PANE differed from the DISK for " & CStr(pdmCount) & " component(s) (see paneDiskMismatchNames). The artifact was built from the PANE, so a cached verdict from this build must NOT be read as evidence about the disk source - save the project and rebuild to make the two agree"
        root("paneDiskMismatchAdvice") = "call save_project (or let make_project auto-save the dirty components) and rebuild; until then verify/verify_scope will report buildSource=cache-pane-disk-mismatch instead of cache-fresh"
    End If
    ' P1/P12: same path fields as save_project, plus the one write pass the
    ' canonical Reference= repair may have performed above.
    root("projectPath") = mpPaths("projectPath")
    root("realProjectPath") = mpPaths("realProjectPath")
    root("projectPathIsAlias") = mpPaths("projectPathIsAlias")
    root("realPathTier") = mpPaths("realPathTier")
    root("realPathError") = mpPaths("realPathError")
    root("warning") = mpPaths("warning")
    If Len(CStr(mpPaths("warningDetail"))) > 0 Then root("warningDetail") = mpPaths("warningDetail")
    root("refsBase") = mpPaths("refsBase")
    root("refsFromAlias") = mpPaths("refsFromAlias")
    root("refsRewritePasses") = mpRefsPasses
    Set root("refsCanonicalized") = mpRefs("canonicalized")
    Set root("refsSkipped") = mpRefs("skipped")
    root("refsUnresolvedCount") = mpRefs("unresolvedCount")
    Set root("output") = before
    ' ---- (the pump-gate review interlock): a box that ALREADY existed -------------
    ' A host-modal box that predates this call was not opened by us, so confirming it
    ' would put the add-in inside somebody else's modal loop - the exact stuck state
    ' the user hit (every later write tool answered reason=busy until the IDE was
    ' killed). Refuse, and hand back the hwnd/title/controls needed to decide.
    ' ---- an earlier fix (defect #4) ------------------------------------------
    ' Arm the bounded modal guard for the WHOLE risky region of this tool. Its
    ' Cancel-first policy is what stops VB6's own Make Project box from being CONFIRMED:
    ' that box enumerates its buttons Open-as-read-only(disabled), OK(id1), Cancel(id2),
    ' Help, Options, so "the default button" is OK - and pressing it starts a compile
    ' INSIDE the host's modal loop, from which this single-threaded add-in never returns
    ' (#4's original symptom; see the prefix-A findings in the evidence archive).
    ' The guard presses Cancel instead, the host aborts the Make, and the call RETURNS.
    ' While it is armed it also makes WoConfirmTick stand down, because that one-shot
    ' confirm only ever presses a CONFIRM caption.
    ' GATE BACKSTOP BUDGET: MAKE_LAND_WAIT_MS + MODAL_GUARD_WAIT_MAKE_MS + 5000 is this
    ' tool's own worst-case bounded runtime AFTER the modal handling, so a healthy compile
    ' the tool's documented budget is never force-released; a genuinely wedged call still
    ' is. See the report for why this budget is deliberately long here.
    Dim mgWait As Long
    mgWait = MODAL_GUARD_WAIT_MAKE_MS
    WinOps.WoModalGuardSiteArm "make_project", mgWait, allowHostModal
    ArmGateRelease "make_project", waitBudget + mgWait + 5000
    Dim preRisk As String, preReason As String, preClass As String, preDetails As String
    Dim preNDlg As Long
    preNDlg = WinOps.HostModalRiskProbe("#32770", preRisk, preReason, preClass, preDetails)
    root("dialogs_before") = preNDlg
    If preNDlg > 0 And preRisk = "known" And Not allowHostModal Then
        root("modal_blocked") = True
        root("modal_stage") = "preexisting"
        root("host_modal_risk") = preRisk
        root("host_modal_risk_reason") = preReason
        root("host_modal_risk_class") = preClass
        root("modalDialogs") = preDetails
        ' v1.11.12: the host-modal block is INDEPENDENT of timedOut; a box that predates the
        ' call ends it as host_modal_blocking (no compiler was started).
        Call ApplyHostModalFields(root, "preflight")
        root("stopReason") = "host_modal_blocking"
        root("verdict") = "modal_blocked"
        root("logUnavailableReason") = "no compile was attempted, so no compiler log exists"
        root("suggested_action") = "read the box with read_active_dialogs and close it with close_active_dialogs (dry_run=true previews it, including host_modal_risk); pass allow_host_modal=true only if you deliberately want THIS call to confirm it."
        root("recovery_hint") = "Nothing was started and the artifact was not touched (see output{}). If a previous call is still in flight, its busy receipt carries inflight_tool / inflight_since_ms; read_active_dialogs still answers because read-only tools are not gated."
        root("note") = "a host-modal box was already up before this call, so make_project neither compiled nor touched the artifact"
        ' (discipline 98): this early exit must still report the same
        ' shape, including the dialog counts and the elapsed time.
        ' an earlier fix : the box that was already up is now DISMISSED with a
        ' CANCEL-like caption instead of being left over the IDE. Cancel cannot START the
        ' host-modal operation, so pressing it in a box this call did not open is safe -
        ' it only aborts something nobody asked THIS call to do. The confirm caption is
        ' still never pressed. Nothing is compiled and the artifact is NOT touched, which
        ' is what the pre-existing path already promised.
        If Not allowHostModal Then
            Call ModalGuardSettle(mgWait)
            If Util.PumpAbortDue() Then
            ToolMakeProject = AbortReceiptFor("make_project", Nothing)
            Exit Function
            End If
            root("modalDismissPolicy") = "cancel_only: the box predated this call, so only a Cancel/Close/Ignore/No caption could be pressed; the confirm caption was never pressed and no compile was started"
        End If
        WinOps.WoModalGuardSiteDisarm
        DisarmGateRelease
        Call MergeModalGuard(root)
        root("dialogs_after") = WinOps.HostModalRiskProbe("#32770", preRisk, preReason, preClass, preDetails)
        root("dialogs_leaked") = root("dialogs_after")
        root("elapsedMs") = GetTickCount() - t0
        ToolMakeProject = JsonStringify(root)
        Exit Function
    End If
    ' ==== (D1) PRE-FLIGHT: is the target artifact held by another process? ===
    ' Measured on this host 2026-10-17 (defect D1, trigger B): with the artifact opened
    ' EXCLUSIVELY by another process, VBProject.MakeCompiledFile raises at once (no box
    ' and no block), and the call then walked the File>Make fallback plus the isolated-copy
    ' diagnosis, whose message pump (Build.BuildFingerprint -> Util.MaybePump -> DoEvents)
    ' entered VB6's modal Make Project box: make_project NEVER returned (no receipt within
    ' 320 s, and the single named-pipe instance stayed held for ever => ERROR_PIPE_BUSY(231)
    ' for every later client). A held artifact is cheap to detect BEFORE anything starts,
    ' so it is refused here, with its OWN reason, distinct from a compile failure.
    Dim preLocked As Boolean, preLockerPid As Long
    preLocked = False
    preLockerPid = 0
    If Len(targetExe) > 0 Then
        If CBool(before("exists")) Then
            preLocked = ArtifactWriteLocked(targetExe)
            If preLocked Then preLockerPid = ArtifactHolderPid(targetExe)
        End If
    End If
    root("preflight_artifact_write_locked") = preLocked
    If preLocked Then
        root("ok") = False
        root("verdict") = "artifact_locked"
        root("buildState") = "no_artifact"
        root("pending") = False
        root("compiled") = False
        root("compiled_means") = "no compile was attempted: the call was refused BEFORE MakeCompiledFile"
        root("buildStarted") = False
        root("artifact_locked") = True
        root("artifact_locker_pid") = preLockerPid
        root("artifact_holder_pid") = preLockerPid
        root("artifact_locked_advice") = "do NOT just retry: close the process holding the artifact (artifact_holder_pid when the OS names it), or rename/remove the existing artifact, then rebuild. Alternatively compile to a DIFFERENT output file (the build tool, or make_project route=cli with an explicit out_path) so the held file is never written."
        If preLockerPid = 0 Then root("artifact_locker_pid_note") = "the OS did not name a lock owner (Windows exposes no lock-owner API, and no process image/command line matched this path); artifact_locked was decided by the exclusive-open test, and 0 means the owner is UNKNOWN rather than unlocked"
        root("judgedBy") = "artifact_exclusive_open_probe: ArtifactWriteLocked(target) = True, tested BEFORE any compile call and before the artifact was touched"
        root("suggestedAction") = CStr(root("artifact_locked_advice"))
        root("logUnavailableReason") = "no compile was attempted, so no compiler log exists"
        root("note") = "the target artifact is held by another process, so this call was refused BEFORE any compile: nothing was compiled, the artifact was NOT moved aside and NOT rewritten. See artifact_holder_pid / artifact_locked_advice."
        root("elapsedMs") = GetTickCount() - t0
        Call ApplyHostModalFields(root, "preflight")
        If Len(CStr(root("stopReason"))) = 0 Then root("stopReason") = "refused"
        WinOps.WoModalGuardSiteDisarm
        DisarmGateRelease
        Call MergeModalGuard(root)
        ToolMakeProject = JsonStringify(root)
        Exit Function
    End If
    ' ==== end (D1) pre-flight ====

    ' ---- (2.1): MOVE the old artifact aside, never delete it --------
    Dim fsoMP As Object
    Set fsoMP = CreateObject("Scripting.FileSystemObject")
    Dim sidecar As String
    sidecar = ""
    Dim stashed As Boolean
    stashed = False
    If Len(targetExe) > 0 Then
        If CBool(before("exists")) Then
            sidecar = targetExe & ".before-build"
            On Error Resume Next
            Err.Clear
            If fsoMP.FileExists(sidecar) Then fsoMP.DeleteFile sidecar, True
            Err.Clear
            fsoMP.MoveFile targetExe, sidecar
            If Err.Number = 0 Then stashed = True
            Err.Clear
            On Error GoTo 0
            If stashed Then root("artifact_backup_path") = sidecar
        End If
        ' A stale type library also makes VB6 re-prompt for a target. .exp/.lib are
        ' compiler INTERMEDIATES regenerated by every build, not deliverables, so they
        ' are still cleared; only the artifact itself is preserved.
        If LCase$(Right$(targetExe, 4)) = ".dll" Or LCase$(Right$(targetExe, 4)) = ".ocx" Then
            On Error Resume Next
            Dim stemMP As String
            stemMP = Left$(targetExe, Len(targetExe) - 4)
            If fsoMP.FileExists(stemMP & ".exp") Then fsoMP.DeleteFile stemMP & ".exp", True
            If fsoMP.FileExists(stemMP & ".lib") Then fsoMP.DeleteFile stemMP & ".lib", True
            On Error GoTo 0
        End If
    End If
    Dim compiled As Boolean
    compiled = False
    Dim errMsg As String
    errMsg = ""
    Dim attempt As Long
    Dim wdArmed As Boolean, wdArmedThis As Boolean, wdClicked As Boolean, wdStatus As String
    wdArmed = False
    wdArmedThis = False
    wdClicked = False
    wdStatus = ""
    For attempt = 1 To 3
        On Error Resume Next
        ' ALWAYS pin the target: an empty BuildFileName is exactly what makes
        ' VB6 open its Make Project file dialog instead of compiling.
        If Len(targetExe) > 0 Then p.BuildFileName = targetExe
        ' (the pump-gate review / 2.3): arm the one-shot confirm BEFORE the Make.
        ' MakeCompiledFile can put up a modal (the Make Project box, or a VB error
        ' box) and then BLOCK inside that modal's own message loop, so code that
        ' runs AFTER it returns can never click the button: the call hangs for ever
        ' and every later write tool answers reason=busy. Measured live while
        ' building this card: make_project stuck at 123 s with the IDE's own error
        ' box up (an English OK button), and read_active_dialogs got the busy
        ' receipt from inside that loop. The armed confirm's WM_TIMER IS dispatched
        ' by that modal loop, which is the only place the click can
        ' come from. WoConfirmArm refuses to arm while a dialog is already up, so it
        ' can only ever press a button of a box THIS call opened.
        wdArmedThis = WinOps.WoConfirmArm(60000)
        If wdArmedThis Then wdArmed = True
        p.MakeCompiledFile
        If Err.Number = 0 Then
            compiled = True
        Else
            errMsg = Err.Description
        End If
        On Error GoTo 0
        wdClicked = wdClicked Or WinOps.WoConfirmClicked()
        wdStatus = WinOps.WoConfirmStatus()
        Call WinOps.WoConfirmDisarm
        If compiled Then Exit For
        If attempt < 3 Then Sleep 500
    Next
    root("compiled") = compiled
    ' R-1021-04 (item 3): on this route the compiler's own text is the ONLY error
    ' text that can exist (no subprocess, no /out log). It is published verbatim so
    ' ToolBuild can MERGE it with the code-pane probe. It never yields a line.
    If Len(errMsg) > 0 Then
        root("makeErrorText") = errMsg
        If Not compiled Then
            Dim feMake As Object
            Set feMake = CreateObject("Scripting.Dictionary")
            feMake("dialogText") = errMsg
            feMake("dialogTextSource") = "make_error"
            feMake("lineUnavailable") = True
            feMake("source") = "make_error"
            Set root("firstError") = feMake
            root("errorCount") = 1
            root("firstErrorSource") = "make_error"
            root("firstErrorNote") = "the in-IDE Make raised; Err.Description is carried verbatim in firstError.dialogText. This route writes no compiler log, so no file or line can be derived from it."
        End If
    End If
    ' ---- is VB6's own Make box up? --------------------------------
    Dim risk As String, riskReason As String, riskClass As String, riskDetails As String
    Dim nDlg As Long
    nDlg = WinOps.HostModalRiskProbe("#32770", risk, riskReason, riskClass, riskDetails)
    root("host_modal_risk") = risk
    root("host_modal_risk_reason") = riskReason
    root("host_modal_risk_class") = riskClass
    root("modalDialogs") = riskDetails
    Dim buildStarted As Boolean
    Dim usedMenuFallback As Boolean
    buildStarted = False
    usedMenuFallback = False
    Dim menuFallbackRefused As Boolean
    menuFallbackRefused = False
    If Not compiled Then
        ' ==== (D1) FIX: the File>Make menu command is NEVER executed ====
        ' It used to be run here as a fallback when MakeCompiledFile raised. Measured on
        ' this host 2026-10-17 (triggers A and B): that command does NOT block by itself -
        ' ctrl.Execute returns in 0 ms - but it only POSTS VB6's Make command. The next
        ' message pump dispatches it, VB6 opens its own modal Make Project box ('生成工程',
        ' buttons Open-as-read-only / OK / Cancel / Help / Options), and the in-IDE
        ' diagnosis then pumps (Build.BuildFingerprint -> Util.MaybePump -> DoEvents) inside
        ' that box: the modal loop takes the thread and NEVER gives it back. Instrumented
        ' readings: mp_make_exit attempt=1/2/3 in 15 ms each (compiled=False),
        ' mp_menu_exec_enter/exit in the same millisecond, then diag_enter -> tb_enter ->
        ' fp_enter and NO further line; no receipt within 320 s, and the single named-pipe
        ' instance held for ever (every later client gets ERROR_PIPE_BUSY 231, still 231
        ' after the caller closes its handle). VB6 kept Responding=true and its CPU barely
        ' moved, and NOT ONE watchdog tick ran inside that modal loop - so neither
        ' WoConfirmArm nor the generic modal guard can rescue it. A UI-thread COM call that
        ' can enter a host modal loop must therefore not be issued at all: refuse, bounded,
        ' and name the route that really compiles with a log.
        Dim ctrl As Object
        Set ctrl = McpFindTools.FindCmd(Me, "make", "File|Menu Bar|" & ChrW$(&H6587) & ChrW$(&H4EF6) & "|" & ChrW$(&H83DC) & ChrW$(&H5355) & ChrW$(&H6761), "Make|" & ChrW$(&H751F) & ChrW$(&H6210))
        If ctrl Is Nothing Then
            Err.Raise vbObjectError + 40, "CodeTools", "Could not compile: " & errMsg
        End If
        menuFallbackRefused = True
        root("menuCommandFound") = True
        root("menuFallback") = "refused"
        root("menuFallbackRefusedReason") = "the File>Make CommandBar command is only POSTED: the next message pump dispatches it, VB6 opens its modal Make Project box, and this add-in's own diagnosis pump (DoEvents) then enters that modal loop and never returns - measured : no receipt within 320 s and the single pipe instance held for ever. The command is never executed."
        root("menuFallbackAlternative") = "use route='cli' (or the build tool): it runs an isolated VB6.EXE /make <vbp> /out <log> subprocess on the project's DISK state and returns a real compiler log with errorCount/firstError{file,line,text}. If you deliberately want the isolated compile to run, that route is bounded by timeout_ms and starts no host modal box."
        root("inIdeMakeError") = errMsg
        root("inIdeMakeAttempts") = 3
    End If
    ' ---- (2.3): confirm the box THIS call opened, then say so ------
    ' Confirming VB6's Make box inside make_project is legitimate: the caller asked
    ' for a compile and expects the call to block for it, and the box is reported as
    ' host_modal_risk=known so the blocking is explicit instead of silent. The defect
    ' was a tool the caller expected to return quickly (close_active_dialogs) doing it.
    ' ---- an earlier fix (defect #4): CANCEL-FIRST on a host-modal box ---------
    ' When the box that is up is VB6's OWN Make Project box (risk=known), the bounded
    ' modal guard presses its CANCEL caption. ConfirmMakeDialog would press the DEFAULT
    ' button, which on this box is OK(id1) - the click that starts a compile inside the
    ' host's modal loop and never returns. allow_host_modal=true keeps the old behaviour
    ' for a caller who explicitly asks for the compile to run inside the host.
    If nDlg > 0 Then
        Sleep 400
        root("modalConfirmAttempted") = True
        If risk = "known" And Not allowHostModal Then
            Call ModalGuardSettle(mgWait)
            If Util.PumpAbortDue() Then
            ToolMakeProject = AbortReceiptFor("make_project", Nothing)
            Exit Function
            End If
            root("modalDismissPolicy") = "cancel_only: VB6's own Make Project box is host-modal risk=known, so its CONFIRM caption was deliberately NOT pressed. ConfirmMakeDialog was NOT called, because its default button on this box is OK(id1) and that click starts a compile inside the host's modal loop."
            buildStarted = False
        Else
            ConfirmMakeDialog
            buildStarted = True
        End If
        If risk = "known" Then
            If allowHostModal Then
                root("modal_note") = "VB6's own Make Project box was up and allow_host_modal=true, so it WAS confirmed: this call is now inside the host's modal loop for the whole compile. That is exactly why close_active_dialogs must never click this box."
            Else
                root("modal_note") = "VB6's own Make Project box was up. The bounded modal guard pressed its CANCEL caption rather than its default OK, so NO compile was started inside the host's modal loop and this call returns. Pass allow_host_modal=true to confirm it deliberately."
            End If
        End If
    ElseIf compiled Then
        buildStarted = True
    ElseIf usedMenuFallback Then
        Sleep 400
        root("modalConfirmAttempted") = True
        If risk = "known" And Not allowHostModal Then
            Call ModalGuardSettle(mgWait)
            If Util.PumpAbortDue() Then
            ToolMakeProject = AbortReceiptFor("make_project", Nothing)
            Exit Function
            End If
            root("modalDismissPolicy") = "cancel_only: the File>Make fallback raised VB6's Make Project box; the bounded modal guard owned it and pressed CANCEL, so no compile was started inside the host's modal loop."
            buildStarted = False
        Else
            ConfirmMakeDialog
            buildStarted = True
        End If
    End If
    root("buildStarted") = buildStarted
    root("usedMenuFallback") = usedMenuFallback
    ' ---- (2.4): wait (bounded) for the artifact to land ------------
    Dim after As Object
    Set after = ArtifactFullSnap(targetExe)
    Dim waited As Long
    waited = 0
    Dim ceText As String
    Dim hasCompileErr As Boolean
    hasCompileErr = False
    root("waitRequestedMs") = waitForBuildMs
    root("waitUsedMs") = waitBudget
    Do While buildStarted And waited < waitBudget
        hasCompileErr = WinOps.CompileErrorTextFromDialogs(ceText)
        If hasCompileErr Then Exit Do
        If CBool(after("exists")) Then
            If Not CBool(before("exists")) Then Exit Do
            If CStr(after("sha256")) <> CStr(before("sha256")) Then Exit Do
            If CDbl(after("mtime")) <> CDbl(before("mtime")) Then Exit Do
        End If
        Sleep 250
        waited = waited + 250
        Set after = ArtifactFullSnap(targetExe)
    Loop
    ' ---- (2.1): if the host removed the artifact, put it back ------
    ' ---- (F4): PUT THE ARTIFACT BACK, and PROVE it -------------------
    ' The remedy only ran when THIS call had stashed a copy, and the verifier
    ' reproduced two independent constructions where the artifact ended up missing and
    ' was NOT restored. The restore below runs on every path, tries every candidate,
    ' verifies the restored bytes against the PRE-CALL digest, and fails LOUDLY with a
    ' reason when it cannot.
    Dim restored As Boolean
    restored = False
    Dim restoreAttempted As Boolean
    restoreAttempted = False
    Dim restoreSource As String
    restoreSource = ""
    Dim restoreFailed As String
    restoreFailed = ""
    Dim beforeShaA As String
    ' (R1): retention + restore-basis evidence. Option Explicit is in force
    ' in this class, so every one of these needs its own declaration.
    Dim restoreBasis As String
    Dim restoreSourceSha As String
    Dim restoreMatchesPrecall As Boolean
    Dim retainedCandidatePath As String
    Dim retainedCandidateSha As String
    Dim retainedCandidateErr As String
    beforeShaA = CStr(before("sha256"))
    If Not CBool(after("exists")) Then
        Dim cands As Object
        Set cands = New Collection
        If Len(sidecar) > 0 Then cands.Add sidecar
        cands.Add targetExe & ".before-build"
        cands.Add targetExe & ".locked-build"
        Dim ci As Long
        For ci = 1 To cands.Count
            Dim cnd As String
            cnd = CStr(cands(ci))
            On Error Resume Next
            Err.Clear
            If fsoMP.FileExists(cnd) Then
                restoreAttempted = True
                ' (R1): take the candidate's digest BEFORE it is moved, so
                ' the receipt can prove WHICH image was put back.
                restoreSourceSha = SnapSha(ArtifactFullSnap(cnd))
                If fsoMP.FileExists(targetExe) Then fsoMP.DeleteFile targetExe, True
                fsoMP.MoveFile cnd, targetExe
                If Err.Number = 0 Then
                    restored = True
                    restoreSource = cnd
                    Err.Clear
                    Exit For
                Else
                    restoreFailed = "restore failed: moving " & cnd & " back to " & targetExe & " raised error " & CStr(Err.Number) & " (" & Err.Description & ")"
                End If
            End If
            On Error GoTo 0
        Next ci
        If (Not restored) And Len(restoreFailed) = 0 Then
            restoreFailed = "restore failed: no candidate copy was found on disk (" & CStr(cands.Count) & " candidate path(s) checked: " & CStr(cands(1)) & " ...). Neither the pre-call image (moved aside by this call) nor the candidate retained by the PREVIOUS call (<exe>.before-build) exists on disk, so there was nothing to put back. The artifact was already missing when this call started."
        End If
        Set after = ArtifactFullSnap(targetExe)
        If restored Then
            Dim afterShaNow As String
            afterShaNow = SnapSha(after)
            ' With a pre-call image the restored bytes MUST equal it byte for byte.
            ' Without one the basis is the retained candidate, and it is reported as such.
            If Len(beforeShaA) > 0 Then
                restoreBasis = "pre_call_artifact"
                If Len(afterShaNow) = 0 Then
                    restored = False
                    restoreBasis = ""
                    restoreFailed = "restore NOT verified: the restored file's sha256 could not be read, so it cannot be proven equal to the pre-call digest (before=" & beforeShaA & ")"
                ElseIf afterShaNow <> beforeShaA Then
                    restored = False
                    restoreBasis = ""
                    restoreFailed = "restore NOT verified: the restored file does not match the pre-call digest (before=" & beforeShaA & " after=" & afterShaNow & ")"
                End If
            Else
                restoreBasis = "retained_candidate"
            End If
            If restored And Len(beforeShaA) > 0 Then restoreMatchesPrecall = (afterShaNow = beforeShaA)
        End If
    End If
    ' ---- (R1): the candidate is RETAINED across calls -------------
    ' only had a copy when THIS call happened to move the artifact aside
    ' first, so a deletion that landed before this call's own snapshot left nothing
    ' to put back (the verifier's Z5: the probe removed <exe> in a tight loop from the
    ' instant the call left the client, so the pre-call snapshot was already gone).
    ' The sidecar is now a RETAINED candidate: whenever a call ends with an artifact
    ' on disk, its bytes are COPIED (never moved) to <exe>.before-build, so the NEXT
    ' call can put the artifact back even when it is removed before that call can look
    ' at it. Nothing here ever overwrites a live artifact: the copy is read back only
    ' by the restore block above, and only when the artifact is missing.
    If CBool(after("exists")) And Not restored Then
        Dim retPath As String
        retPath = targetExe & ".before-build"
        On Error Resume Next
        Err.Clear
        If fsoMP.FileExists(retPath) Then fsoMP.DeleteFile retPath, True
        Err.Clear
        fsoMP.CopyFile targetExe, retPath
        If Err.Number = 0 Then
            retainedCandidatePath = retPath
            retainedCandidateSha = SnapSha(ArtifactFullSnap(retPath))
        Else
            retainedCandidateErr = CStr(Err.Number) & " (" & Err.Description & ")"
        End If
        Err.Clear
        On Error GoTo 0
    ElseIf restored Then
        ' the candidate was consumed by putting it back: nothing is retained now
        retainedCandidatePath = ""
        retainedCandidateSha = ""
    End If
    Set root("output") = after
    root("artifact_restored") = restored
    ' (F4): machine-judgeable restore evidence, on every path.
    root("restore_attempted") = restoreAttempted
    root("restore_source") = restoreSource
    root("restore_failed_reason") = restoreFailed
    ' (R1): VB6's IIf evaluates BOTH branches, so the form
    ' IIf(restored, CStr(after("sha256")), "") still touched the digest on the
    ' not-restored path (where the key is absent and reads back as Empty). Assign
    ' explicitly so every path publishes the key without evaluating a missing one.
    root("restore_verified_sha256") = ""
    If restored Then root("restore_verified_sha256") = SnapSha(after)
    ' (R1): WHERE the restored bytes came from, and whether they are
    ' PROVEN equal to the pre-call image. restore_basis=pre_call_artifact means this
    ' call held the pre-call digest and verified against it; =retained_candidate means
    ' the artifact was already gone when the call started, so the bytes are the copy
    ' retained at the end of the previous call and no pre-call digest existed here.
    root("restore_basis") = restoreBasis
    root("restore_source_sha256") = restoreSourceSha
    root("restore_matches_precall_sha256") = restoreMatchesPrecall
    root("retained_candidate_path") = retainedCandidatePath
    root("retained_candidate_sha256") = retainedCandidateSha
    If Len(retainedCandidateErr) > 0 Then root("retained_candidate_error") = retainedCandidateErr
    root("restore_note") = "artifact_restored=true means the artifact was put back FROM a candidate copy and its sha256 matches the digest this call could verify (restore_basis names which: pre_call_artifact = the pre-call digest, retained_candidate = the copy kept at the end of the previous call). A false value always carries restore_failed_reason; it is never merely reported. <exe>.before-build is retained between calls so a later deletion can still be undone."
    ' ---- artifactChanged: the only honest "did anything get built" ------------
    Dim artChanged As Boolean
    artChanged = False
    If CBool(after("exists")) Then
        If Not CBool(before("exists")) Then
            artChanged = True
        ElseIf CDbl(after("size")) <> CDbl(before("size")) Then
            artChanged = True
        ElseIf CDbl(after("mtime")) <> CDbl(before("mtime")) Then
            artChanged = True
        ElseIf CStr(after("sha256")) <> CStr(before("sha256")) Then
            artChanged = True
        End If
    End If
    root("artifactChanged") = artChanged
    ' W-C (P5): per-component disk-vs-pane freshness (route=ide compiles the IDE MEMORY).
    Set root("sourceFreshness") = SourceFreshnessJson(True)
    ' ---- (3.2): is the artifact held by a running process? ---------
    Dim holderPid As Long
    holderPid = 0
    Dim lockerPid As Long
    lockerPid = 0
    If Len(targetExe) > 0 And (Not artChanged) Then lockerPid = ArtifactHolderPid(targetExe)
    Dim writeLocked As Boolean
    writeLocked = False
    If Len(targetExe) > 0 And (Not artChanged) Then writeLocked = ArtifactWriteLocked(targetExe)
    If lockerPid > 0 Then
        root("artifact_locked") = True
        root("artifact_locker_pid") = lockerPid
        root("artifact_holder_pid") = lockerPid
    ElseIf writeLocked Then
        root("artifact_locked") = True
    ElseIf CBool(before("exists")) And Not stashed Then
        ' the caller's previous artifact could not even be moved aside
        root("artifact_locked") = True
    End If
    If CBool(root("artifact_locked")) Then
        root("artifact_locked_advice") = "do NOT just retry: rename the existing artifact first (e.g. <name>.locked-build) or close the process holding it, then rebuild. artifact_locker_pid = 0 means the OS did not name the locker (Windows exposes no lock-owner API); it does NOT mean the file is unlocked."
        If lockerPid = 0 Then root("artifact_locker_pid_note") = "the OS did not name a lock owner; artifact_locked was decided by the exclusive-open test and/or by the artifact not being movable"
    End If
    ' ---- pending: pending=true must say HOW to confirm -------------------------
    Dim pending As Boolean
    pending = False
    If buildStarted And (Not CBool(after("exists"))) And (Not hasCompileErr) Then pending = True
    root("pending") = pending
    If pending Then
        root("pending_how_to_confirm") = "the artifact has not appeared yet: re-read output.exists / output.size / output.sha256 / output.mtime (this call already waited " & CStr(waited) & " ms) and check that the file starts with a PE header (MZ at offset 0). Do not read compiled/ok as evidence."
    End If
    ' ---- the in-IDE route has no compiler log: say so, do not fake one --------
    root("logAvailable") = False
    root("logUnavailableReason") = "the in-IDE Make route writes NO compiler log, so log/errorCount/firstError cannot come from a file here. Use route=cli (or the build tool) - an isolated VB6.EXE /make <vbp> /out <log> subprocess - to get log, errorCount and firstError{file,line,text} with a real file location."
    If Len(outPath) > 0 Then root("logPath") = outPath
    If hasCompileErr Then
        root("errorCount") = 1
        ' (rule K, site #4): this route has REAL dialog text (ceText) but NO file and NO
        ' line - so publish exactly the member that exists.  The old object also asserted
        ' file="", line=0 and lineSpace="disk", i.e. a LOCATION for an error whose location was
        ' never read off the dialog.
        If Len(Trim$(ceText)) > 0 Then
            Dim fe2 As Object
            Set fe2 = CreateObject("Scripting.Dictionary")
            fe2("text") = ceText
            Set root("firstError") = fe2
            root("firstErrorSource") = "ide_compile_error_dialog"
        End If
        root("note") = "VB6's own compile-error box was read while it was up (errorCount=1 because one box was seen, NOT because exactly one error exists); the in-IDE route has no log to count. route=cli gives a real count with file+line."
    ElseIf Not compiled Then
        root("note") = "MakeCompiledFile raised (last error: " & errMsg & ") and no compile-error box was readable; retry with route=cli to get a compiler log with firstError{file,line,text}"
    End If
    ' ---- verdict + ok: compiled alone is never a verdict ----------------------
    If CBool(root("modal_blocked")) Then
        root("verdict") = "modal_blocked"
    ElseIf menuFallbackRefused Then
        ' (D1): the in-IDE Make raised and the only remaining in-IDE route (the
        ' File>Make menu command) is refused by design, so this is a BOUNDED compile
        ' failure - a distinct reason from artifact_locked, and never a silent wait.
        root("verdict") = "compile_failed_bounded"
    ElseIf pending Then
        root("verdict") = "pending"
    ElseIf artChanged Then
        root("verdict") = "built"
    ElseIf CBool(after("exists")) And (compiled Or buildStarted) Then
        root("verdict") = "compiled-no-artifact-change"
        root("artifactLockedHint") = "the Make returned without error but the artifact was not rewritten: it is most likely held open by another process (close it), or the build wrote identical bytes"
        root("artifactNote") = "treat this as NOT built: artifactChanged is false"
        ' W-D (P11): a false artifactChanged with no log must still tell the caller HOW to get one.
        WcAttachCompileLogHint root
    ElseIf restored Then
        root("verdict") = "restored-previous-artifact"
    ElseIf Not compiled Then
        root("verdict") = "compile_failed"
    Else
        root("verdict") = "no-artifact-change"
    End If
    ' ---- ONE queryable build state --------------------------
    If CBool(root("modal_blocked")) Then
        root("buildState") = "blocked_by_host_modal"
    ElseIf menuFallbackRefused Then
        root("buildState") = "failed"
    ElseIf pending Then
        root("buildState") = "pending"
    ElseIf artChanged Then
        root("buildState") = "completed"
    ElseIf CBool(after("exists")) And (compiled Or buildStarted) Then
        root("buildState") = "completed_without_artifact_change"
    ElseIf Not compiled Then
        root("buildState") = "failed"
    Else
        root("buildState") = "no_artifact"
    End If
    root("buildStateNote") = " buildState is DERIVED from the same facts as verdict (modal_blocked / pending / artifactChanged / compiled) - it is not a second guess. buildState=pending means the compile was started but the artifact had not landed inside this call's wait window (waitUsedMs; default 15000, wait_for_build=<ms> up to 120000): re-read output.exists / output.size / output.mtime / output.sha256 - and confirm the file starts with MZ - before treating the build as done. compiled/ok are never completion evidence. If a host modal box was cleared first, re-read output{} again: clearing the box does not itself prove the artifact landed."
    root("ok") = (artChanged And Not CBool(root("modal_blocked")))
    root("elapsedMs") = GetTickCount() - t0
    If Len(root("note")) = 0 Then
        root("note") = "one build reports only the first error; compiled:true is not evidence - judge artifactChanged / verdict / output{}"
    End If
    If restored Then root("artifact_backup_path") = ""
    If CBool(after("exists")) And stashed And Not restored Then root("artifact_backup_path") = ""
    ' ---- (3): shape-aligned top-level location fields ----------------
    ' (rule K): the firstError object may now be ABSENT (nothing real was recognised) and
    ' may carry ONLY the members that are real, so this consumer reads it by existence instead of
    ' indexing keys that need not be there (a missing Dictionary key RAISES).
    Dim feR As Object
    If root.Exists("firstError") Then
        If IsObject(root("firstError")) Then Set feR = root("firstError")
    End If
    If Not feR Is Nothing Then
        If feR.Exists("file") Then
            If Len(CStr(feR("file"))) > 0 Then root("file") = CStr(feR("file"))
        End If
        If feR.Exists("lineIde") Then
            If CLng(Val(CStr(feR("lineIde")))) > 0 Then root("reportedLine") = CLng(Val(CStr(feR("lineIde"))))
        End If
        If feR.Exists("line") Then
            If CLng(Val(CStr(feR("line")))) > 0 Then root("diskLine") = CLng(Val(CStr(feR("line"))))
        End If
    End If
    ' ---- (3): do not LEAK dialogs -----------------------------------
    ' The A-side run measured a failed in-IDE Make leaving one MORE pair of boxes up
    ' per attempt (count grew to 7 over 5 failures), so the IDE stayed blocked. A
    ' call must not leave the IDE with more boxes than it found: the boxes THIS
    ' call created are dismissed before it returns, and the counts are machine
    ' readable. A Make box is cancelled, never confirmed - cancelling cannot start
    ' the compile this path decided not to run.
    Dim dRisk2 As String, dReason2 As String, dClass2 As String, dDetails2 As String
    Dim dlAfter As Long
    dlAfter = WinOps.HostModalRiskProbe("#32770", dRisk2, dReason2, dClass2, dDetails2)
    Dim dlLeaked As Long
    dlLeaked = dlAfter - preNDlg
    If dlLeaked < 0 Then dlLeaked = 0
    Dim dlAttempts As Long
    dlAttempts = 0
    ' (F6): dismiss on EVERY path, pending included. The guard
    ' skipped the dismissal while pending=true, and the verifier measured exactly one
    ' leftover box on the first attempt. A call must not leave the IDE with MORE boxes
    ' than it found: dialogs_after <= dialogs_before is the contract, and the compile
    ' error text (if any) is captured BEFORE any box is closed.
    If dlLeaked > 0 Then
        Dim dlIgnored As String
        dlIgnored = WinOps.CloseActiveDialogsJson(0, "Cancel", False, False)
        dlAttempts = 1
        dlIgnored = WinOps.CloseActiveDialogsJson(0, "", False, False)
        dlAfter = WinOps.HostModalRiskProbe("#32770", dRisk2, dReason2, dClass2, dDetails2)
        dlLeaked = dlAfter - preNDlg
        If dlLeaked < 0 Then dlLeaked = 0
    End If
    root("make_watchdog_armed") = wdArmed
    root("make_watchdog_clicked") = wdClicked
    root("make_watchdog_status") = wdStatus
    If wdArmed Then
        root("make_watchdog_note") = "the one-shot confirm was armed across MakeCompiledFile so a modal VB6 opened INSIDE that call could still be dismissed (its WM_TIMER is dispatched by the modal loop). armed=" & CStr(wdArmed) & " clicked=" & CStr(wdClicked) & " status=" & wdStatus
    End If
    Call WinOps.WoConfirmDisarm
    root("dialogs_after") = dlAfter
    root("dialogs_leaked") = dlLeaked
    root("dialogs_close_attempts") = dlAttempts
    ' (F6): the net-zero contract, as a boolean the judge can read.
    root("dialogs_before") = preNDlg
    root("dialogs_net_zero") = (dlAfter <= preNDlg)
    If Not CBool(root("dialogs_net_zero")) Then
        root("dialogs_note_net_zero") = "this call still left " & CStr(dlLeaked) & " more box(es) up than it found after " & CStr(dlAttempts) & " dismissal pass(es); the captions may be outside the safe whitelist - read them with read_active_dialogs and click explicitly"
    End If
    If dlAttempts > 0 Then
        root("dialogs_note") = "this call left " & CStr(dlLeaked) & " more box(es) up than it found and dismissed them itself (Cancel first, then safe captions); any compile-error text was captured into firstError.text before the box was closed, so nothing is lost by dismissing it"
        If Len(root("dialogs_note")) > 0 Then
            ' (rule K): feR may be Nothing now, and a text member may be absent.
            If Not feR Is Nothing Then
                If feR.Exists("text") Then
                    If Len(CStr(feR("text"))) > 0 Then root("firstErrorSource") = "ide_compile_error_dialog"
                End If
            End If
        End If
    End If
    ' ---- (F5): the in-IDE route STRUCTURALLY cannot give the root cause
    ' The verifier measured ide-route receipts with errorCount=0, firstError empty and
    ' logAvailable=false, and re-tested with an explicit route=cli (exit 0, no log).
    ' VBProject.MakeCompiledFile reports only a boolean, so there is NO compiler
    ' subprocess and therefore no log to read on this route - that is structural, not a
    ' transient gap. Say so, and name the executable alternative.
    If Not CBool(root("logAvailable")) Then
        root("diagnosisAvailable") = False
        root("diagnosisUnavailableReason") = "the in-IDE Make route has NO compiler subprocess, so no /out log and no compiler error text can exist for it - structurally, not as a failure of this call"
        root("diagnosisAlternative") = "call build (or make_project with route=cli): it runs an isolated VB6.EXE /make <vbp> /out <log> and returns log plus firstError{file,line,text}. Measured caveat: while ANOTHER VB6 instance holds the same .vbp, /make exits 0 without writing the log - close that instance, or build a copy of the project, and retry."
        root("suggestedAction") = CStr(root("diagnosisAlternative"))
    Else
        root("diagnosisAvailable") = True
        root("diagnosisUnavailableReason") = ""
        root("diagnosisAlternative") = ""
    End If
    ' ---- (A10): LAA on the artifact (sidecar aware) ----------------
    If laaUsable Then
        ApplyLaaInto root, targetExe, laaWant
    Else
        LaaConfigRefusal root, laaProjFile, laaCfgErr
    End If
    root("laaSource") = laaSrc
    root("laaProjectFile") = laaProjFile
    root("laaSourceNote") = laaSrcNote
    root("laaConfigError") = laaCfgErr
    ' W-C (P6): FINAL artifact identity - sampled HERE, i.e. AFTER the LAA patch, then read back.
    Dim wcDetail As String
    wcDetail = "after_compile"
    If CBool(root("laaSet")) Or CBool(root("laaAlready")) Then wcDetail = "after_laa_patch"
    Set root("final") = WcFinalArtifactJson(targetExe, wcDetail, WcVbpRevisionText(p.FileName))
    root("artifactChangedBasedOn") = "final"
    If CBool(root("laaSet")) Then
        root("artifactChanged") = True
        root("artifactChangedNote") = "the LAA PE patch changed the artifact bytes AFTER the compile, so artifactChanged is true on the FINAL bytes"
    End If
    ' WP-22-04 (MCP-1022-50): output{} must describe the FINAL artifact. It used to be the
    ' snapshot taken right after the compile (i.e. BEFORE the LAA PE rewrite), so
    ' output.sha256 could never be reproduced by an external Get-FileHash (measured:
    ' receipt EF46BB4B... vs Get-FileHash EAC18630..., identical size).
    ' FIX-23: this step SHAPES a receipt, it is never the verdict. Measured defect: a Set-less
    ' object read inside Build.FinalizeArtifactOutput raised VB 450 and the exception escaped as
    ' reason=unexpected_error, replacing a COMPLETE build receipt with one error string. The call
    ' is isolated so any exception becomes structured DATA on this receipt instead.
    Dim finxErrN As Long, finxErrD As String
    On Error Resume Next
    Err.Clear
    Call Build.FinalizeArtifactOutput(root, targetExe)
    finxErrN = Err.Number
    finxErrD = Err.Description
    Err.Clear
    On Error GoTo 0
    If finxErrN <> 0 Then
        root("outputFinalizeOk") = False
        root("outputFinalizeErrorCode") = finxErrN
        root("outputFinalizeError") = finxErrD
        root("outputFinalizeNote") = "the artifact-identity reshaping step (Build.FinalizeArtifactOutput) raised VB error " & CStr(finxErrN) & " (" & finxErrD & "); output{} is the snapshot taken BEFORE that step and every other field of this receipt is unaffected. This is an ADD-IN defect reported as data instead of reason=unexpected_error."
        root("outputFinalizeAdvice") = "read output{} and artifact{} for the artifact identity and report outputFinalizeErrorCode with this receipt; the compile result itself is not implicated"
    Else
        root("outputFinalizeOk") = True
        root("outputFinalizeErrorCode") = 0
    End If
    ' ---- (item 1): compiled-but-nothing-produced must
    ' never read like a success ------------------------------------------------
    If (Not artChanged) And compiled Then
        root("unbuiltReasonUnknown") = True
        root("artifactNote") = "NOT built: the artifact was neither produced nor rewritten, and the in-IDE Make route cannot say WHY - a compile failure is possible (compiled=true only means MakeCompiledFile returned without raising). Read diagnosis{} below."
    End If
    ' ---- (item 2): isolated-copy diagnosis -------------
    Dim diagReason As String
    diagReason = ""
    If diagnoseWant Then
        diagReason = "requested"
    ElseIf (Not artChanged) And (compiled Or buildStarted) Then
        diagReason = "compiled-but-no-artifact-change"
    End If
    If Len(diagReason) > 0 Then
        ' ==== (D1): never pump while a host modal box is up ====
        ' The isolated-copy diagnosis PUMPS messages (Build.BuildFingerprint ->
        ' Util.MaybePump -> DoEvents). Measured 2026-10-17: when a host modal box is up,
        ' that pump ENTERS the host's modal loop and never returns - the thread is gone,
        ' no watchdog tick runs and the single pipe instance stays held for ever. So the
        ' diagnosis is skipped (with its reason) instead of risking that.
        Dim dgRisk As String, dgReason2 As String, dgClass As String, dgDetails As String
        Dim dgDlgs As Long
        dgDlgs = WinOps.HostModalRiskProbe("#32770", dgRisk, dgReason2, dgClass, dgDetails)
        If dgDlgs > 0 Then
            root("diagnosisSkipped") = True
            root("diagnosisSkippedReason") = "a host-modal box is up (" & CStr(dgDlgs) & " #32770 window(s), host_modal_risk=" & dgRisk & "), and the isolated-copy diagnosis pumps messages (DoEvents) - with a box up that pump enters the host's modal loop and never returns (measured). No diagnosis was attempted, so this call returns bounded."
            ' v1.11.12: the diagnosis was skipped BECAUSE a host modal box is up - that is a
            ' host_modal_blocking fact, not a timeout.
            Call ApplyHostModalFields(root, "diagnosis")
            root("stopReason") = "host_modal_blocking"
            Dim dgSkip As Object
            Set dgSkip = CreateObject("Scripting.Dictionary")
            dgSkip("attempted") = False
            dgSkip("reason") = diagReason
            dgSkip("skipped") = "host_modal_box_present"
            Set root("diagnosis") = dgSkip
        Else
        DiagnoseInto root, p.FileName, timeoutMs, diagReason
        Dim dg As Object
        Set dg = root("diagnosis")
        If CBool(dg("attempted")) Then
            root("diagnosisRoute") = CStr(dg("route"))
            root("diagnosisTmpDir") = CStr(dg("tmpDir"))
            root("diagnosisCopiedFiles") = CLng(dg("copiedFiles"))
            root("diagnosisMissingFiles") = CStr(dg("missingFiles"))
            root("diagnosisError") = CStr(dg("error"))
            ' v1.11.12: the isolated compile's hard-budget facts, INDEPENDENT of host_modal_blocking.
            If dg.Exists("timedOut") Then root("timedOut") = CBool(dg("timedOut"))
            If dg.Exists("budgetEnforced") Then root("budgetEnforced") = CBool(dg("budgetEnforced"))
            If dg.Exists("budgetMs") Then root("budgetMs") = CLng(dg("budgetMs"))
            If dg.Exists("budgetSource") Then root("budgetSource") = CStr(dg("budgetSource"))
            If dg.Exists("isolatedMake") Then
                If IsObject(dg("isolatedMake")) Then Set root("isolatedMake") = dg("isolatedMake")
            End If
            If CBool(root("timedOut")) Then
                root("ok") = False
                root("verdict") = "timeout"
                root("buildState") = "failed"
                root("pending") = False
                root("stopReason") = "timeout"
                root("timeoutNote") = "the isolated COPY compile of this project was KILLED at its hard budget (see isolatedMake{pid,killMethod,leftover}). The in-IDE Make result (if any) is NOT a compile verdict."
                root("okReason") = "the isolated copy compile timed out; the artifact state is reported separately"
            End If
            root("diagnosisAvailable") = True
            root("diagnosisUnavailableReason") = ""
            root("diagnosisAlternative") = ""
            If CBool(dg("ok")) Then
                root("unbuiltReasonUnknown") = False
                root("artifactNote") = "the artifact was not rewritten, but an ISOLATED compile of a COPY of this project SUCCEEDED with 0 errors - the source is valid, so the in-IDE Make simply did not rewrite the artifact. See diagnosis{}."
            End If
            If Len(CStr(dg("log"))) > 0 Then
                root("logAvailable") = True
                root("logWrittenByThisCall") = True
                root("log") = CStr(dg("log"))
                root("logPath") = CStr(dg("logPath"))
                root("logBytes") = CLng(dg("logBytes"))
                root("errorCount") = CLng(dg("errorCount"))
                ' (rule K, site #5): the diagnosis now has NO firstError unless the
                ' isolated compile really recognised one (site #1 no longer fakes a shell), so
                ' this consumer must test for absence - dg("firstError") would RAISE if the key
                ' were missing - and must copy only the members that exist.
                Dim dfef As Object
                If dg.Exists("firstError") Then
                    If IsObject(dg("firstError")) Then Set dfef = FirstErrorCopy(dg("firstError"))
                End If
                If Not dfef Is Nothing Then
                    Set root("firstError") = dfef
                    root("firstErrorSource") = "isolated_copy_make"
                    If dfef.Exists("file") Then
                        If Len(CStr(dfef("file"))) > 0 Then root("file") = CStr(dfef("file"))
                    End If
                    If dfef.Exists("lineIde") Then
                        If CLng(Val(CStr(dfef("lineIde")))) > 0 Then root("reportedLine") = CLng(Val(CStr(dfef("lineIde"))))
                    End If
                    If dfef.Exists("line") Then
                        If CLng(Val(CStr(dfef("line")))) > 0 Then root("diskLine") = CLng(Val(CStr(dfef("line"))))
                    End If
                End If
                root("diagnosisNote") = "log/firstError come from the ISOLATED copy compile, not from the in-IDE Make (which has no compiler subprocess). The copy is the state ON DISK: unsaved pane edits are not in it."
            Else
                root("diagnosisNote") = "the isolated /make wrote no readable log; see diagnosis{} and diagnosisError"
            End If
        End If
        End If
    End If
    ' ---- a diagnosis that RAN and FAILED is proof of a compile
    ' failure, so the state must not stay "pending" --------------------------------
    ' Measured (fixture with no startup object): the in-IDE Make produced no artifact
    ' and raised no dialog, the isolated copy's log said "必须有启动窗体或 Sub Main()" /
    ' "编译失败", and the receipt still answered verdict=pending - i.e. it told the
    ' caller to WAIT AND RE-READ as if the compile were still in flight, hiding a
    ' failure we could already prove. A pending state is only honest while nothing has
    ' disproved success.
    If Len(diagReason) > 0 Then
        Dim dg2 As Object
        Set dg2 = root("diagnosis")
        If Not dg2 Is Nothing Then
            If CBool(dg2("attempted")) And (Not CBool(dg2("ok"))) And (Not artChanged) And (Not CBool(root("timedOut"))) Then
                root("pending") = False
                root("pendingOverriddenByDiagnosis") = True
                root("verdict") = "compile_failed"
                root("buildState") = "failed"
                root("unbuiltReasonUnknown") = False
                root("buildStateNote") = " The ISOLATED copy compile of this project FAILED (diagnosis.ok=false) and the artifact did not change, so this build is FAILED - never pending (which tells the caller to wait and re-read as if the compile were still in flight) and never a completed_* state. The copy is the state ON DISK; unsaved pane edits are not in it. Read diagnosis{}/log/firstError for the cause."
                root("suggestedAction") = "the compile failed: read log / firstError / diagnosis{}, fix the reported cause, then retry. Do NOT re-read output{} waiting for an artifact that a failed compile cannot produce."
            End If
        End If
    End If
    ' an earlier fix : the two layers that can dismiss a box during a compile now
    ' coexist, and the receipt must not look like the watchdog failed when it was the
    ' GUARD that acted. WoConfirmTick stands down whenever the guard is armed (it only
    ' ever presses a CONFIRM caption, which is exactly what must not happen on VB6's Make
    ' box), so make_watchdog_clicked can legitimately be false while the box WAS
    ' dismissed - the modal* fields say by whom.
    root("modalWatchdogRelationship") = "while the generic modal guard is armed, the one-shot make watchdog (WinOps.WoConfirmArm/WoConfirmTick) STANDS DOWN, because it only ever presses a CONFIRM caption and on VB6's Make Project box that caption starts the compile inside the host's modal loop. So make_watchdog_clicked=false next to modalClickedButton='Cancel' is the EXPECTED, correct combination - not a failure of the watchdog."
    ' v1.11.12: host-modal evidence on the FINAL path (independent of timedOut), then the
    ' terminal stopReason when nothing above set one.
    Call ApplyHostModalFields(root, "final")
    If Len(CStr(root("stopReason"))) = 0 Then
        If CBool(root("ok")) Then
            root("stopReason") = "completed"
        Else
            root("stopReason") = "refused"
        End If
    End If
    WinOps.WoModalGuardSiteDisarm
    DisarmGateRelease
    Call MergeModalGuard(root)
    ' FIX-27 (R4.6): the in-IDE Make must PUBLISH its verdict to the build cache. It used to write
    ' NOTHING, so the very next verify read an OLDER record, saw a hash difference and answered
    ' reason cache-stale - while THIS receipt had already promised (paneDiskMismatchNote) that
    ' verify would answer cache-pane-disk-mismatch. A receipt must not promise a field another
    ' tool cannot produce. The record is written here from a POST-build fingerprint, with the
    ' compiled-source axis, exactly the way build does it.
    On Error Resume Next
    Err.Clear
    Dim mpComps As Object
    Dim mpFp As Object
    Dim mpCache As Object
    Dim mpSz As Double, mpEx As Boolean, mpTm As Double
    Set mpComps = Nothing
    Set mpFp = Nothing
    Set mpFp = Build.BuildFingerprint(CStr(root("projectPath")), "", mpComps)
    If Err.Number <> 0 Then Err.Clear
    If Not mpFp Is Nothing Then
        Set mpCache = CreateObject("Scripting.Dictionary")
        mpCache("key") = mpFp("key")
        mpCache("hash") = mpFp("hash")
        If Not mpComps Is Nothing Then Set mpCache("comps") = mpComps
        mpCache("ok") = CBool(root("ok"))
        mpCache("exitCode") = 0
        mpCache("artifact") = targetExe
        mpSz = 0
        mpEx = False
        On Error Resume Next
        ArtifactSnap targetExe, mpEx, mpSz, mpTm
        If Err.Number <> 0 Then Err.Clear: mpSz = 0
        On Error GoTo 0
        If mpEx Then mpCache("size") = mpSz Else mpCache("size") = 0
        mpCache("logPath") = ""
        mpCache("at") = Now
        mpCache("verdict") = CStr(root("verdict"))
        mpCache("okByKeyword") = False
        mpCache("compiledFrom") = "pane"
        mpCache("paneDiskMismatch") = CBool(root("paneDiskMismatch"))
        mpCache("paneDiskMismatchCount") = CLng(root("paneDiskMismatchCount"))
        Build.CacheSave mpCache
        root("buildCacheWritten") = True
        root("buildCacheSource") = "make_project"
        root("buildCacheFingerprintBasis") = "post_build_disk"
        root("buildCacheCompiledFrom") = "pane"
    Else
        root("buildCacheWritten") = False
        root("buildCacheError") = "fingerprint_unavailable"
        root("buildCacheErrorNote") = "the build cache was NOT updated (the project fingerprint could not be sampled after the compile), so a following verify will keep using the PREVIOUS record - read buildCacheWritten before trusting its buildSource"
    End If
    If Err.Number <> 0 Then Err.Clear
    On Error GoTo 0
    ToolMakeProject = JsonStringify(root)
End Function

Private Sub ConfirmMakeDialog()
    ' Click the default button of any #32770 dialog owned by THIS process.
    ' Matching by window class + process id covers every caption and UI
    ' language (Make Project / overwrite prompt / VB6 error box); the old
    ' exact-title match on the Chinese caption did not.
    Const BM_CLICK As Long = &HF5
    Const GW_CHILD As Long = 5
    Const GW_HWNDNEXT As Long = 2
    Const GWL_STYLE As Long = -16
    Const BS_DEFPUSHBUTTON As Long = &H1
    On Error Resume Next
    Dim myPid As Long
    myPid = GetCurrentProcessId()
    Dim hDlg As Long, hChild As Long, pid As Long, btn As Long, style As Long
    hDlg = FindWindowExW(0, 0, StrPtr("#32770"), 0)
    Do While hDlg <> 0
        pid = 0
        GetWindowThreadProcessId hDlg, pid
        If pid = myPid Then
            btn = 0
            hChild = GetWindow(hDlg, GW_CHILD)
            Do While hChild <> 0
                style = GetWindowLongW(hChild, GWL_STYLE)
                If (style And BS_DEFPUSHBUTTON) <> 0 Then
                    btn = hChild
                    Exit Do
                End If
                hChild = GetWindow(hChild, GW_HWNDNEXT)
            Loop
            If btn <> 0 Then PostMessageW btn, BM_CLICK, 0, 0
        End If
        hDlg = FindWindowExW(0, hDlg, StrPtr("#32770"), 0)
    Loop
End Sub

' =====================================================================
' R-1021-02: run/step disk observability + informed consent.
' A Start in the VB6 IDE is governed by the IDE-WIDE option
'   Tools > Options > Environment > "When a program starts"
' stored in HKCU\Software\Microsoft\Visual Basic\6.0\SaveBeforeRun
' (measured on the live box 2026-10-21: "0" = dont_save, "1" = prompt, "2" = save).
' A tool CANNOT stop the IDE from saving, so this block only:
'   (1) proves what the disk did around the call (before/after snapshot),
'   (2) publishes saveOnRun + ideAutoSaveHint so nobody reads "the tool did not
'       save" as "the disk did not change",
'   (3) refuses a Start from DIRTY memory unless the caller opts in
'       (allowDiskMutation:true) - informed consent, not a block on the IDE.
Private Function RunDiskIdeFiles(ByVal p As VBIDE.VBProject) As Object
    Dim res As Object
    Dim i As Long
    Dim c As VBIDE.VBComponent
    Dim f As String
    Dim d As Object
    Set res = New Collection
    On Error Resume Next
    If p Is Nothing Then Set RunDiskIdeFiles = res: Exit Function
    For i = 1 To p.VBComponents.Count
        Set c = Nothing
        Set c = p.VBComponents.Item(i)
        If Not c Is Nothing Then
            f = ComponentFileNameOf(c)
            If Len(f) > 0 Then
                Set d = CreateObject("Scripting.Dictionary")
                d("name") = c.Name
                d("path") = f
                res.Add d
            End If
        End If
        Err.Clear
    Next
    Err.Clear
    Set RunDiskIdeFiles = res
End Function

Public Function RunDiskAutoSaveBlock() As Object
    Dim d As Object
    Dim raw As String
    Dim readable As Boolean
    Dim note As String
    Dim mode As String
    Set d = CreateObject("Scripting.Dictionary")
    mode = Util.IdeSaveBeforeRunMode(raw, readable, note)
    d("ideAutoSaveHint") = "may_save_on_start"
    d("ideAutoSaveHintDetail") = "a program START in the VB6 IDE is governed by the IDE-WIDE option Tools > Options > Environment > 'When a program starts' (Save Changes / Prompt / Don't Save Changes). This tool never changes that option, so saveOnRun:false does NOT mean the disk is unchanged - read diskWrites[] and touchedFiles[] for what actually happened."
    d("ideAutoSaveMode") = mode
    d("ideAutoSaveReadFrom") = "HKCU\Software\Microsoft\Visual Basic\6.0\SaveBeforeRun"
    d("saveBeforeRunRaw") = raw
    d("ideAutoSaveReadable") = readable
    d("ideAutoSaveModeNote") = "measured mapping (live box, 2026-10-21): 0=dont_save, 1=prompt, 2=save. READ ONLY - this add-in never writes the option."
    If Len(note) > 0 Then d("ideAutoSaveNote") = note
    Set RunDiskAutoSaveBlock = d
End Function

Public Sub RunDiskMergePrim(ByRef root As Object, ByVal d As Object)
    On Error Resume Next
    Dim k As Variant
    Dim v As Variant
    If d Is Nothing Then Exit Sub
    For Each k In d.Keys
        v = d(k)
        If IsObject(v) Then
            Set root(CStr(k)) = v
        Else
            root(CStr(k)) = v
        End If
    Next
    Err.Clear
End Sub

Private Function RunDiskLineDelta(ByVal comp As VBIDE.VBComponent) As Object
    Set RunDiskLineDelta = Nothing
    On Error Resume Next
    Dim cm As VBIDE.CodeModule
    Set cm = comp.CodeModule
    If cm Is Nothing Then Exit Function
    Dim paneLines As Long
    paneLines = cm.CountOfLines
    Dim f As String
    f = ComponentFileNameOf(comp)
    If Len(f) = 0 Then Exit Function
    If Dir$(f) = "" Then Exit Function
    Dim hdr As Long
    hdr = McpCls.SharedHeaderOffset(Me, comp.Name)
    Dim txt As String
    txt = ProjShip.ReadTextFile(f)
    If Len(txt) = 0 Then Exit Function
    Dim diskTotal As Long
    diskTotal = LineCount(txt)
    If Right$(txt, 1) = vbLf Or Right$(txt, 1) = vbCr Then diskTotal = diskTotal - 1
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("paneLines") = paneLines
    d("diskLines") = diskTotal - hdr
    d("lineDelta") = paneLines - (diskTotal - hdr)
    d("basis") = "line COUNT delta from the pane/disk header offset; a CONTENT diff is verify's job"
    Err.Clear
    Set RunDiskLineDelta = d
End Function

Private Function RunDiskDirtySummary(ByVal p As VBIDE.VBProject, ByRef outDirty As Boolean, ByRef outUnknown As Boolean) As Object
    Dim d As Object
    Dim comps As Object
    Set d = CreateObject("Scripting.Dictionary")
    Set comps = New Collection
    outDirty = False
    outUnknown = False
    d("projectSaved") = False
    d("projectSavedReadable") = False
    d("componentDirtyReadable") = False
    d("componentCount") = 0
    d("dirtyCount") = 0
    d("truncated") = False
    d("lineDeltaComputed") = 0
    d("lineDeltaLimit") = 16
    d("componentLimit") = 64
    Set d("dirtyComponents") = EmptyJsonArray()
    If p Is Nothing Then
        outUnknown = True
        Set RunDiskDirtySummary = d
        Exit Function
    End If
    On Error Resume Next
    Dim ps As Boolean
    Err.Clear
    ps = p.Saved
    If Err.Number = 0 Then
        d("projectSavedReadable") = True
        d("projectSaved") = ps
        If ps = False Then outDirty = True
    Else
        Err.Clear
        outUnknown = True
    End If
    d("componentCount") = p.VBComponents.Count
    Dim i As Long
    Dim c As VBIDE.VBComponent
    Dim readable As Boolean
    Dim isD As Boolean
    Dim isDok As Boolean
    Dim e As Object
    Dim dl As Object
    readable = True
    For i = 1 To p.VBComponents.Count
        Set c = Nothing
        Set c = p.VBComponents.Item(i)
        If Not c Is Nothing Then
            isD = False
            isDok = False
            Err.Clear
            isD = c.IsDirty
            If Err.Number = 0 Then
                isDok = True
            Else
                Err.Clear
                readable = False
            End If
            If isDok Then
                If isD Then
                    outDirty = True
                    d("dirtyCount") = CLng(d("dirtyCount")) + 1
                    If comps.Count < 64 Then
                        Set e = CreateObject("Scripting.Dictionary")
                        e("name") = c.Name
                        e("file") = ComponentFileNameOf(c)
                        e("isDirty") = True
                        If comps.Count < 16 Then
                            Set dl = RunDiskLineDelta(c)
                            If Not dl Is Nothing Then
                                e("paneLines") = dl("paneLines")
                                e("diskLines") = dl("diskLines")
                                e("lineDelta") = dl("lineDelta")
                                e("lineDeltaBasis") = dl("basis")
                                d("lineDeltaComputed") = CLng(d("lineDeltaComputed")) + 1
                            End If
                        End If
                        comps.Add e
                    Else
                        d("truncated") = True
                    End If
                End If
            End If
        End If
        Err.Clear
    Next
    d("componentDirtyReadable") = readable
    If Not readable Then outUnknown = True
    If outDirty Then
        d("dirtyBasis") = "positive evidence: VBProject.Saved=False and/or at least one VBComponent.IsDirty=True"
    End If
    If outUnknown And Not outDirty Then
        d("dirtyUnknownReason") = "the IDE refused to read VBProject.Saved and/or VBComponent.IsDirty, so memory-vs-disk equality can not be PROVED; this call does not refuse on unknown evidence"
    End If
    Set d("dirtyComponents") = comps
    Err.Clear
    Set RunDiskDirtySummary = d
End Function

Private Function RunDiskHowToProceed() As Object
    Dim h As Object
    Dim steps As Object
    Dim s As Object
    Set h = CreateObject("Scripting.Dictionary")
    Set steps = New Collection
    Set s = CreateObject("Scripting.Dictionary")
    s("action") = "save_project"
    s("why") = "persist the in-memory changes EXPLICITLY, then retry; the save_project receipt proves every file it wrote"
    steps.Add s
    Set s = CreateObject("Scripting.Dictionary")
    s("action") = "set_the_ide_option_to_dont_save"
    s("why") = "Tools > Options > Environment > When a program starts = Don't Save Changes (an IDE restart is required); this add-in never changes that option"
    s("registry") = "HKEY_CURRENT_USER\Software\Microsoft\Visual Basic\6.0\SaveBeforeRun = 0 (REG_SZ)"
    steps.Add s
    Set s = CreateObject("Scripting.Dictionary")
    s("action") = "allowDiskMutation_true"
    s("why") = "retry with allowDiskMutation:true when the caller KNOWS the IDE option may write the dirty memory to disk"
    steps.Add s
    Set h("steps") = steps
    h("summary") = "choose one: save the project first, turn the IDE option off, or acknowledge with allowDiskMutation:true"
    Set RunDiskHowToProceed = h
End Function

Private Function RunDiskPromptHowTo() As Object
    Dim h As Object
    Dim steps As Object
    Dim s As Object
    Set h = CreateObject("Scripting.Dictionary")
    Set steps = New Collection
    Set s = CreateObject("Scripting.Dictionary")
    s("action") = "read_active_dialogs"
    s("why") = "the IDE option is 'Prompt', so the save box may be up: read it (read-only) before doing anything"
    steps.Add s
    Set s = CreateObject("Scripting.Dictionary")
    s("action") = "cancel_the_prompt"
    s("why") = "dismiss the save box with its Cancel button (send_window_message on THAT box only); do NOT answer Yes/No when the disk state must stay untouched"
    steps.Add s
    Set s = CreateObject("Scripting.Dictionary")
    s("action") = "set_the_ide_option_to_dont_save"
    s("why") = "Tools > Options > Environment > When a program starts = Don't Save Changes removes the prompt for later starts (IDE restart required)"
    steps.Add s
    Set h("steps") = steps
    h("summary") = "the Start may be waiting behind a MODAL save prompt; read the dialogs and dismiss them explicitly"
    Set RunDiskPromptHowTo = h
End Function

Private Function RunDiskRefusal(ByVal toolName As String, ByVal modeName As String, ByVal dsum As Object, ByVal auto As Object) As Object
    Dim r As Object
    Dim ds As Object
    Set r = CreateObject("Scripting.Dictionary")
    r("tool") = toolName
    r("mode") = modeName
    r("ok") = False
    r("executed") = False
    r("refused") = True
    r("reason") = "dirty_memory_would_be_saved"
    r("dirtyBeforeRun") = True
    r("allowDiskMutation") = False
    r("saveOnRun") = False
    r("saveOnRunReason") = ""
    If Not dsum Is Nothing Then Set r("dirty") = dsum
    Set r("diskWrites") = EmptyJsonArray()
    Set r("touchedFiles") = EmptyJsonArray()
    Set ds = CreateObject("Scripting.Dictionary")
    ds("taken") = False
    ds("basis") = "refused_before_action: nothing was executed, so this call could not have written the disk"
    Set r("diskSnapshot") = ds
    RunDiskMergePrim r, auto
    Set r("howToProceed") = RunDiskHowToProceed()
    r("note") = "the IDE's own option may save the in-memory changes to disk when a program starts; this tool refuses to START from DIRTY memory unless the caller accepts that disk mutation. Nothing was saved, clicked or changed by this call."
    Set RunDiskRefusal = r
End Function

