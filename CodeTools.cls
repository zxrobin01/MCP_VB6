        ' them verbatim. ADDITIVE only: a member the nested receipt does not carry
        ' stays ABSENT here - nothing is invented and nothing is re-worded.
        lmTok = IdeJsonStrMember(ideMakeJson, "autoSaveReceipt")
        If Len(lmTok) > 0 Then root("autoSaveReceipt") = lmTok
        lmTok = IdeJsonStrMember(ideMakeJson, "saveProjectReceipt")
        If Len(lmTok) > 0 Then root("saveProjectReceipt") = lmTok
        lmTok = IdeJsonStrMember(ideMakeJson, "refuseReason")
        If Len(lmTok) > 0 Then root("refuseReason") = lmTok
        lmTok = IdeJsonStrMember(ideMakeJson, "buildState")
        If Len(lmTok) > 0 Then root("buildState") = lmTok
        lmTok = IdeJsonStrMember(ideMakeJson, "verdict")
        If Len(lmTok) > 0 Then root("verdict") = lmTok
        ' R-1021-04 (item A): the dirty facts travel with the save facts - a caller
        ' reading THIS entry must be able to see why a save happened at all.
        lmTok = IdeJsonToken(ideMakeJson, "dirtyProject")
