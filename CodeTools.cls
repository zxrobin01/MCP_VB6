Private Function ToolGetComponentProperties(ByVal name As String) As String
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    Dim arr As Object
    Set arr = New Collection
    On Error Resume Next
    Dim props As Object
    Set props = comp.Properties
    If props Is Nothing Then
        On Error GoTo 0
        Err.Raise vbObjectError + 57, "CodeTools", "Component has no Properties collection (not a designer component): " & name
    End If
    Dim prop As Object
    For Each prop In props
        Dim d As Object
        Set d = CreateObject("Scripting.Dictionary")
        d("name") = prop.Name
        d("numIndices") = prop.NumIndices
        Err.Clear
        Dim v As Variant
        Dim vObj As Object
        If IsObject(prop.Value) Then
            Set vObj = prop.Value
            d("value") = TypeName(vObj)
        Else
            v = prop.Value
            If Err.Number = 0 Then
                If IsNull(v) Then
                    d("value") = "(Null)"
                Else
                    d("value") = CStr(v)
                End If
            Else
                d("value") = "(unreadable)"
            End If
        End If
        arr.Add d
    Next
    On Error GoTo 0
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = comp.Name
    root("count") = arr.Count
    Set root("properties") = arr
    ToolGetComponentProperties = JsonStringify(root)
End Function

Private Function ToolSetComponentProperty(ByVal name As String, ByVal propName As String, ByVal value As String, ByVal indices As String) As String
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    Dim props As Object
    Set props = comp.Properties
    If props Is Nothing Then Err.Raise vbObjectError + 57, "CodeTools", "Component has no Properties collection: " & name
    Dim prop As Object
    Dim found As Boolean
    found = False
    For Each prop In props
        If LCase$(prop.Name) = LCase$(propName) Then
            found = True
            Exit For
        End If
    Next
    If Not found Then Err.Raise vbObjectError + 58, "CodeTools", "Property not found: " & propName
    Dim parsed As Variant
    parsed = ParseVariantValue(value)
    If Len(indices) > 0 Then
        Dim idxParts() As String
        idxParts = Split(indices, ",")
        Select Case UBound(idxParts)
            Case 0
                prop.IndexedValue(CLng(Val(idxParts(0)))) = parsed
            Case 1
                prop.IndexedValue(CLng(Val(idxParts(0))), CLng(Val(idxParts(1)))) = parsed
            Case 2
                prop.IndexedValue(CLng(Val(idxParts(0))), CLng(Val(idxParts(1))), CLng(Val(idxParts(2)))) = parsed
            Case Else
                prop.IndexedValue(CLng(Val(idxParts(0))), CLng(Val(idxParts(1))), CLng(Val(idxParts(2))), CLng(Val(idxParts(3)))) = parsed
        End Select
    Else
        prop.Value = parsed
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = comp.Name
    root("property") = prop.Name
    root("value") = value
    ToolSetComponentProperty = JsonStringify(root)
End Function

' Accepts "0x1F2E", "1F2Eh", "&#x1F2E" or plain decimal - used by vba6_probe rva_call.
Private Function ParseHexOrLong(ByVal s As String) As Long
    Dim t As String
    Dim i As Long
    Dim ch As String
    Dim v As Long
    t = Trim$(s)
    If Len(t) = 0 Then
        ParseHexOrLong = 0
        Exit Function
    End If
    If LCase$(Left$(t, 2)) = "0x" Then t = Mid$(t, 3)
    If LCase$(Right$(t, 1)) = "h" Then t = Left$(t, Len(t) - 1)
    If LCase$(Left$(t, 3)) = "&#x" Then t = Mid$(t, 4)
    v = 0
    For i = 1 To Len(t)
        ch = LCase$(Mid$(t, i, 1))
        If ch >= "0" And ch <= "9" Then
            v = v * 16 + (Asc(ch) - Asc("0"))
        ElseIf ch >= "a" And ch <= "f" Then
            v = v * 16 + (Asc(ch) - Asc("a") + 10)
        End If
    Next
    ParseHexOrLong = v
End Function

' R13: the overflow-safe twin of ParseHexOrLong. The historic parser multiplied into a Long
' and raised VB error 6 (overflow) for any value above 0x7FFFFFFF, which surfaced as an
' unstructured unexpected_error instead of a refusal. This one parses into a Double and
' REPORTS the overflow (False + overflow=True) instead of wrapping the value.
Private Function TryParseHexOrLong(ByVal s As String, ByRef outVal As Long, ByRef overflow As Boolean) As Boolean
    Dim t As String
    Dim i As Long
    Dim ch As String
    Dim d As Double
    TryParseHexOrLong = False
    outVal = 0
    overflow = False
    t = Trim$(s)
    If Len(t) = 0 Then
        TryParseHexOrLong = True
        Exit Function
    End If
    If LCase$(Left$(t, 2)) = "0x" Then t = Mid$(t, 3)
    If LCase$(Right$(t, 1)) = "h" Then t = Left$(t, Len(t) - 1)
    If LCase$(Left$(t, 3)) = "&#x" Then t = Mid$(t, 4)
    If Len(t) = 0 Then
        TryParseHexOrLong = True
        Exit Function
    End If
    d = 0
    For i = 1 To Len(t)
        ch = LCase$(Mid$(t, i, 1))
        If ch >= "0" And ch <= "9" Then
            d = d * 16 + (Asc(ch) - Asc("0"))
        ElseIf ch >= "a" And ch <= "f" Then
            d = d * 16 + (Asc(ch) - Asc("a") + 10)
        End If
        If d > 2147483647# Then
            overflow = True
            Exit Function
        End If
    Next
    outVal = CLng(d)
    TryParseHexOrLong = True
End Function

' R13: the structured out-of-range refusal (replaces a raw VB overflow).
Private Function ArgRangeJson(ByVal toolName As String, ByVal fieldName As String, ByVal raw As String, ByVal overflowed As Boolean) As String
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("tool") = toolName
    d("failureKind") = "arg_out_of_range"
    d("reason") = "the " & fieldName & " value is out of range for a 32-bit signed probe address"
    d("field") = fieldName
    d("value") = raw
    d("overflow") = overflowed
    d("note") = "nothing was read or executed; the value is parsed without wrapping, so anything above 0x7FFFFFFF is refused instead of being silently reinterpreted"
    ArgRangeJson = JsonStringify(d)
End Function

Private Function ParseVariantValue(ByVal s As String) As Variant
    Dim t As String
    t = Trim$(s)
    If LCase$(t) = "true" Then
        ParseVariantValue = True
    ElseIf LCase$(t) = "false" Then
        ParseVariantValue = False
    ElseIf LCase$(t) = "null" Or LCase$(t) = "(nothing)" Then
        ParseVariantValue = Null
    ElseIf IsNumeric(t) Then
        If InStr(t, ".") > 0 Or InStr(1, t, "e", vbTextCompare) > 0 Then
            ParseVariantValue = Val(t)
        Else
            ParseVariantValue = CLng(Val(t))
        End If
    Else
        ParseVariantValue = s
    End If
End Function

