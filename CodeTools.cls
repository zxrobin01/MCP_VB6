Public Function GetProject() As VBIDE.VBProject
    If m_vbe Is Nothing Then Err.Raise vbObjectError + 1, "CodeTools", "IDE not connected"
    ' "no project is open" is a LEGAL IDE state, not a fault. Tag it with
    ' MCPREASON: so CallTool's Fail handler answers with the structured refusal
    ' (ok:false + reason:"no_project") for EVERY caller at once, instead of wrapping the
    ' raw VB error into ok:false/unexpected_error. Nothing else changes: with a project
    ' open this raise is unreachable, so those receipts stay byte-identical.
    If m_vbe.VBProjects.Count = 0 Then Err.Raise vbObjectError + 2, "CodeTools", "MCPREASON:no_project|open or create a project first (File > Open Project)|the VB6 IDE has no open project, so this tool has nothing to operate on"
    Set GetProject = m_vbe.ActiveVBProject
End Function


' capture what the caller needs to fix the name. Lives in module state because a
' component name may contain anything; every read is defensive (a diagnostic must never turn a
' refusal into an unexpected error -).
Public Sub CnfCapture(ByVal name As String, ByVal p As VBIDE.VBProject)
    Set m_cnfNames = New Collection
    Set m_cnfNear = New Collection
    m_cnfTried = name
    m_cnfCount = 0
    m_cnfTrimmed = ""
    m_cnfCollapsed = ""
    On Error Resume Next
    Dim lc As String, ltrim As String, lcol As String
    lc = LCase$(name)
    ltrim = LCase$(Trim$(name))
    lcol = LCase$(CollapseWs(name))
    Dim comp As VBIDE.VBComponent
    Dim n As String, nl As String, nd As Object
    For Each comp In p.VBComponents
        n = comp.Name
        nl = LCase$(n)
        m_cnfCount = m_cnfCount + 1
        If m_cnfCount <= 100 Then m_cnfNames.Add n
        If nl = ltrim Then
            If Len(m_cnfTrimmed) = 0 Then m_cnfTrimmed = n
        End If
        If nl = lcol Then
            If Len(m_cnfCollapsed) = 0 Then m_cnfCollapsed = n
        End If
        If Len(lc) >= 2 Then
            If InStr(1, nl, lc, vbBinaryCompare) > 0 Then CnfNearAdd n, "an existing component's name CONTAINS the name you passed - you may have passed a prefix or a fragment"
        End If
        If Len(nl) >= 2 Then
            If InStr(1, lc, nl, vbBinaryCompare) > 0 Then CnfNearAdd n, "the name you passed CONTAINS an existing component's name - you may have passed a longer decorated name"
        End If
    Next
    If Len(m_cnfTrimmed) > 0 Then CnfNearAdd m_cnfTrimmed, "matches after Trim$: the name differs only by SURROUNDING whitespace"
    If Len(m_cnfCollapsed) > 0 Then CnfNearAdd m_cnfCollapsed, "matches after collapsing INNER whitespace (and trimming)"
End Sub

Private Sub CnfNearAdd(ByVal n As String, ByVal why As String)
    If Len(Trim$(n)) = 0 Then Exit Sub
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("name") = n
    d("why") = why
    m_cnfNear.Add d
End Sub

Private Function CollapseWs(ByVal s As String) As String
    Dim t As String, i As Long, ch As String, out As String, sp As Boolean
    t = Trim$(s)
    sp = False
    For i = 1 To Len(t)
        ch = Mid$(t, i, 1)
        If ch = " " Or ch = vbTab Then
            If Not sp Then out = out & " "
            sp = True
        Else
            out = out & ch
            sp = False
        End If
    Next
    CollapseWs = out
End Function

Public Function GetCodePane(ByVal component As String) As VBIDE.CodePane
    If Len(component) = 0 Then
        Set GetCodePane = m_vbe.ActiveCodePane
        If GetCodePane Is Nothing Then Err.Raise vbObjectError + 72, "CodeTools", "No active code pane"
    Else
        Dim comp As VBIDE.VBComponent
        Set comp = McpFindTools.FindComponent(Me, component)
        Dim cm As VBIDE.CodeModule
        Set cm = comp.CodeModule
        If cm Is Nothing Then Err.Raise vbObjectError + 51, "CodeTools", "Component has no code module: " & component
        Set GetCodePane = cm.CodePane
    End If
End Function

' (i18n): capability -> language-independent Id + shortcut.
' Ids/shortcuts measured on the Chinese VB6 IDE (内部命令栏清单).
' Returning 0 means "no Id may be used": 'make' shares the ambiguous id=746 with
' start_full_compile and has NO shortcut, so it must stay caption-based.
Public Function CmdId(ByVal key As String, ByRef shortcutOut As String) As Long
    shortcutOut = ""
    Select Case LCase$(key)
        Case "run", "start", "continue", "resume"
            CmdId = 186: shortcutOut = "F5"
        Case "break"
            CmdId = 189: shortcutOut = "Ctrl+Break"
        Case "end", "stop"
            CmdId = 228
        Case "step_into", "stepinto"
            CmdId = 188: shortcutOut = "F8"
        Case "step_over", "stepover"
            CmdId = 194: shortcutOut = "Shift+F8"
        Case "step_out", "stepout"
            CmdId = 2559: shortcutOut = "Ctrl+Shift+F8"
        Case "run_to_cursor", "runtocursor"
            CmdId = 1811: shortcutOut = "Ctrl+F8"
        Case "start_full_compile", "full_compile", "fullcompile"
            ' id=746 is ambiguous across 986 nodes, so the shortcut is mandatory
            CmdId = 746: shortcutOut = "Ctrl+F5"
        Case "toggle", "toggle_breakpoint"
            CmdId = 51: shortcutOut = "F9"
        Case "clear_all", "clear_all_breakpoints"
            CmdId = 579: shortcutOut = "Ctrl+Shift+F9"
        Case "addins_menu"
            CmdId = 30038
        Case Else
            ' make / command_bars execute / unknown: no safe Id
            CmdId = 0
    End Select
End Function

' WP-22-02 / FIX-16: CommandBars (mscomctl.ocx) must NEVER be touched while a program RUNS.
' Measured APPCRASH on t16: VB6.EXE c0000005 @000a250f, VBA6.dll c0000005 @000b90a9 (the same
' offset as FIX-16), mscomctl.ocx c000041d / c0000094. It is not recoverable (the process is
' gone), so the rule is REFUSE, never try-it-and-see. EbMode is the only probe used here.
Public Function CmdBarsRunRefusal(ByVal toolName As String, ByRef outObj As Object) As Boolean
    Set outObj = CreateObject("Scripting.Dictionary")
    CmdBarsRunRefusal = False
    If IdeEbMode() <> 1 Then Exit Function
    outObj("ok") = False
    outObj("tool") = toolName
    outObj("state") = "run"
    outObj("reason") = "commandbars_unavailable_while_running"
    outObj("failureKind") = "toolError"
    outObj("commandBarsTouched") = False
    outObj("howToProceed") = "the VB6 CommandBars model is suspended while a program runs, and touching it there is a measured APPCRASH (mscomctl.ocx/VBA6). Nothing was sent. Two ways out: (1) stop the program from the IDE itself (Stop/F5), or (2) let the program terminate on its own (its own End statement / exit condition) and retry in DESIGN. Read-only state questions are answered by ide_state (EbMode only)."
    outObj("evidence") = "WER 1001 APPCRASH: VB6.EXE c0000005 @000a250f, VBA6.dll c0000005 @000b90a9, mscomctl.ocx c000041d/c0000094 (t16, 2026-10-22)"
    outObj("note") = "REFUSED BEFORE EXECUTION: this tool would have had to resolve or execute a CommandBar; no CommandBars object was read."
    CmdBarsRunRefusal = True
End Function

' In BREAK (EbMode=2) the CommandBars model is usable, but a menu-command tool that is NOT the
' debug-control action has no business poking it while the debugger owns the frame: refuse.
Public Function CmdBarsBreakRefusal(ByVal toolName As String, ByRef outObj As Object) As Boolean
    Set outObj = CreateObject("Scripting.Dictionary")
    CmdBarsBreakRefusal = False
    If IdeEbMode() <> 2 Then Exit Function
    outObj("ok") = False
    outObj("tool") = toolName
    outObj("state") = "break"
    outObj("reason") = "commandbars_unavailable_while_in_break"
    outObj("failureKind") = "toolError"
    outObj("commandBarsTouched") = False
    outObj("howToProceed") = "the debugger owns the frame: resume/step/end with control_execution (that path is the ONLY allowed CommandBars user in break), then retry this tool in DESIGN."
    outObj("note") = "REFUSED BEFORE EXECUTION: no CommandBars object was read."
    CmdBarsBreakRefusal = True
End Function

' =====================================================================
' contract v1.16.0: RUN-state End/Stop, the MEASURED path.
' WHY. control_execution{end} used to refuse while a program RUNS with
' reason=commandbars_unavailable_while_running, but DbClickEnd() was measured (probe confirm legs
' V1/V2/V4) to return TRUE in run state and to really stop the program - the refusal was a FALSE
' rejection. This path runs the measured command and then PROVES the outcome by read-back. The STA
' IDE can make the teardown visible only after this call returns; in that case the receipt says
' endPending=true + howToContinue and programEnded stays FALSE (never claim an end not observed).
' =====================================================================
Private Function RunStateEndJson(ByVal modeStr As String) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("tool") = "control_execution"
    root("mode") = modeStr
    root("stateBefore") = "run"
    root("ebModeBefore") = IdeEbMode()
    root("runStateEndPath") = "dbclick_end_while_running"
    root("pathAuthority") = "measured: DbClickEnd() returns true in RUN state and really stops the program (probe confirm legs V1/V2/V4); the old pre-check refusal (commandbars_unavailable_while_running) was a FALSE rejection for end/stop"
    Dim rePre As Object
    Set rePre = McpRe.ReFindRuntimeErrorDialog(Me)
    If Not rePre Is Nothing Then
        root("ok") = False
        root("executed") = False
        root("state") = "runtime_error"
        root("reason") = "commandbars_command_not_delivered"
        root("blockedBy") = "runtime_error_dialog"
        root("endCommandDelivered") = False
        root("endPending") = False
        root("programEnded") = False
        root("stateAfterVerifiedBy") = "ide_state"
        root("stateAfterReadBack") = "runtime_error"
        Set root("runtimeErrorDialog") = McpRe.ReDialogInfoBlock(Me, rePre)
        root("howToProceed") = "a modal VB6 runtime-error box owns the IDE thread: dismiss it first with last_error{dismiss:true}, then retry control_execution{end}."
        RunStateEndJson = JsonStringify(root)
        Exit Function
    End If
    ArmGateRelease "control_execution_run_end", 15000
    Dim t0 As Long
    t0 = Util.TickMs()
    Dim executed As Boolean
    executed = McpDb.DbClickEnd(Me)
    root("executed") = executed
    root("endRequested") = True
    root("executedEnd") = executed
    Dim stNow As String
    Dim stSrc As String
    Dim barsSusp As Boolean
    Dim streak As Long
    Dim deadline As Long
    Dim dlgN As Long
    Dim dlgSeen As Boolean
    Dim samples As Object
    Set samples = New Collection
    stNow = "run"
    stSrc = ""
    barsSusp = False
    streak = 0
    dlgSeen = False
    deadline = t0 + 6000
    Do
        dlgN = 0
        If WinOps.WoModalFastPresent(dlgN) Then
            stNow = "modal_blocked"
            dlgSeen = True
            streak = 0
        Else
            stNow = GetIdeStateEx(stSrc, barsSusp)
            If LCase$(stNow) = "design" Then streak = streak + 1 Else streak = 0
        End If
        If samples.Count < 60 Then samples.Add stNow
        If streak >= 3 Then Exit Do
        If Util.TickMs() >= deadline Then Exit Do
        If CanPump() Then DoEvents
        McpDb.DbBriefWait Me, 50
    Loop
    root("stateAfterReadBack") = stNow
    root("stateAfterReadBackSource") = stSrc
    root("stateAfterVerifiedBy") = "ide_state"
    root("commandBarsSuspendedAfter") = barsSusp
    root("designStreak") = streak
    Set root("endSettleSamples") = samples
    root("endSettleMs") = Util.TickMs() - t0
    If dlgSeen Then
        root("dialogPresent") = True
        root("dialogCount") = dlgN
    End If
    If streak >= 3 Then
        root("ok") = True
        root("state") = "design"
        root("endCommandDelivered") = True
        root("endPending") = False
        root("programEnded") = True
        root("deliveryVsStateNote") = "endCommandDelivered=true is about the COMMAND (the design transition was observed inside this call); programEnded=true is the MEASURED state statement behind it."
    ElseIf CBool(executed) Then
        root("ok") = False
        root("state") = stNow
        root("reason") = "commandbars_command_not_delivered"
        root("endCommandDelivered") = False
        root("endPending") = True
        root("programEnded") = False
        root("deliveryVsStateNote") = "End was ISSUED (executed=true) but its teardown is not observable inside this call (measured: the design transition can need the call to return). endCommandDelivered=false is about the COMMAND in the bounded wait; programEnded=false is about the STATE - nothing is claimed before the read-back."
        root("howToContinue") = "call control_execution{end} again (in design it answers already_not_running with stateAfterVerifiedBy=ide_state) or ide_state to confirm; only a design read-back sets programEnded=true"
        root("howToProceed") = root("howToContinue")
    Else
        root("ok") = False
        root("state") = stNow
        root("reason") = "not_executed"
        root("endCommandDelivered") = False
        root("endPending") = (LCase$(stNow) = "run")
        root("programEnded") = False
        root("deliveryVsStateNote") = "the End commandbar could not be resolved/executed in RUN state; no claim is made about the program"
        root("howToProceed") = "if the program is still running, stop it with the hub ide_kill_and_relaunch (this build has no other measured in-process route)"
    End If
    root("diskNote") = "this RUN-state end path issues ONE IDE command and performs no project-disk bookkeeping; it never saves the project"
    DisarmGateRelease
    RunStateEndJson = JsonStringify(root)
End Function


' (D3, 2026-10-20) EB_MODE-FIRST state decision.
' Measured on the live bed: after a program ENDS, VB6 can leave its CommandBars model
' suspended for a while. The old fallback read that as "run" (the fallback existed ONLY
' for "the object model is suspended, which happens only while the program runs"), so
' ide_state reported run while EbMode=0, the process burned 0% CPU and the End menu item
' was DISABLED - i.e. nothing was running. A later debug_session{attach:true} then waited
' for a break that could never come. The order is now:
'   1. EbMode=2                    -> break   (engine signal, locale-free)
'   2. the Debug menu items resolve -> their enabled pattern decides design/run/break
'   3. the bars do NOT resolve      -> EbMode=1 means a program really runs ("run");
'                                      EbMode=0 is the post-run suspended window and is
'                                      reported as "design" (nothing is running).
' stateSource / commandBarsSuspended are exposed by ide_state so the caller sees WHY.
Public Function GetIdeState() As String
    Dim ss As String
    Dim bs As Boolean
    ss = ""
    bs = False
    GetIdeState = GetIdeStateEx(ss, bs)
End Function

Public Function GetIdeStateEx(ByRef stateSourceOut As String, ByRef barsSuspendedOut As Boolean) As String
    On Error Resume Next
    Dim startCtrl As Object
    Dim breakCtrl As Object
    Dim endCtrl As Object
    Dim startEnabled As Boolean
    Dim breakEnabled As Boolean
    Dim endEnabled As Boolean
    Dim live As Long
    Dim eb As Long
    stateSourceOut = ""
    barsSuspendedOut = False
    startEnabled = False
    breakEnabled = False
    endEnabled = False
    live = 0
    eb = IdeEbMode()
    ' 1) the engine's own signal: 2 = break context
    If eb = 2 Then
        GetIdeStateEx = "break"
        stateSourceOut = "ebMode"
        Exit Function
    End If
    ' FIX-16 / WP-22-02: while a program RUNS the CommandBars model is suspended, and TOUCHING it
    ' there is a measured APPCRASH (VB6.EXE c0000005 @000a250f, VBA6.dll c0000005 @000b90a9 -
    ' the same offset as FIX-16 - mscomctl.ocx c000041d/c0000094). So for eb=1 this function
    ' answers from the ENGINE ONLY (EbMode) and calls NO CommandBars at all: read-only tools
    ' (ide_state, get_locals prechecks, observe, ...) stay safe while a program runs.
    If eb = 1 Then
        GetIdeStateEx = "run"
        stateSourceOut = "ebMode"
        barsSuspendedOut = True
        Exit Function
    End If
    ' 2) the Debug menu items (design/run; the CommandBars model is suspended while running)
    ' ONLY a LIVE FindCmd hit counts as "the bars resolve": the cached controls survive the
    ' suspension with Enabled=False, so counting them made the post-run window look usable and
    ' the zombie state was never detected (measured: a restarted IDE kept Start disabled while
    ' the cached-object path reported design).
    Set startCtrl = McpFindTools.FindCmd(Me, "start", "Debug|" & ChrW$(&H8C03) & ChrW$(&H8BD5), "Start|" & ChrW$(&H542F) & ChrW$(&H52A8) & "|Continue|" & ChrW$(&H7EE7) & ChrW$(&H7EED))
    If Not startCtrl Is Nothing Then
        live = live + 1
        Set m_cachedStart = startCtrl
    Else
        Set startCtrl = m_cachedStart
    End If
    Set breakCtrl = McpFindTools.FindCmd(Me, "break", "Debug|" & ChrW$(&H8C03) & ChrW$(&H8BD5), "Break|" & ChrW$(&H4E2D) & ChrW$(&H65AD))
    If Not breakCtrl Is Nothing Then
        live = live + 1
        Set m_cachedBreak = breakCtrl
    Else
        Set breakCtrl = m_cachedBreak
    End If
    Set endCtrl = McpFindTools.FindCmd(Me, "end", "Debug|" & ChrW$(&H8C03) & ChrW$(&H8BD5), "End|" & ChrW$(&H7ED3) & ChrW$(&H675F))
    If Not endCtrl Is Nothing Then
        live = live + 1
        Set m_cachedEnd = endCtrl
    Else
        Set endCtrl = m_cachedEnd
    End If
    Err.Clear
    If live > 0 Then
        If Not startCtrl Is Nothing Then startEnabled = startCtrl.Enabled
        If Not breakCtrl Is Nothing Then breakEnabled = breakCtrl.Enabled
        If Not endCtrl Is Nothing Then endEnabled = endCtrl.Enabled
        stateSourceOut = "commandBars"
        If breakEnabled Then
            GetIdeStateEx = "run"
        ElseIf endEnabled Then
            GetIdeStateEx = "break"
        ElseIf startEnabled Then
            GetIdeStateEx = "design"
        Else
            ' the bars resolve but every item is disabled: no menu state to trust
            stateSourceOut = "ebMode+commandBars"
            If eb = 1 Then GetIdeStateEx = "run" Else GetIdeStateEx = "design"
        End If
        Exit Function
    End If
    ' 3) suspended bars: EbMode tells a RUNNING program apart from the post-run window
    barsSuspendedOut = True
    stateSourceOut = "ebMode+commandBars"
    If eb = 1 Then
        GetIdeStateEx = "run"
    Else
        GetIdeStateEx = "design"
    End If
End Function

' P1#1: the ONE place that derives mode / modeBasis / modeConflict for ide_state.
' state (design/run/break/runtime_error) stays the raw four-state value; mode normalises it to
' the closed enum design|run|break|unknown - runtime_error maps to unknown because the modal box
' is its own state and must never masquerade as a design/run/break verdict. modeBasis names what
' decided it (same vocabulary as stateSource, plus unrecognized_state) and is present even when
' nothing is degraded. modeConflict appears ONLY when the raw EbMode flag contradicts the
' reported state; mode itself always mirrors state (state is authoritative - no double semantics).
Private Function IdeModeBlock(ByVal st As String, ByVal src As String, ByVal eb As Long) As Object
    On Error Resume Next
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    Dim m As String
    m = "unknown"
    If st = "design" Or st = "run" Or st = "break" Then m = st
    d("mode") = m
    If Len(src) = 0 Then
        d("modeBasis") = "unrecognized_state"
    Else
        d("modeBasis") = src
    End If
    Dim exp As String
    exp = "unknown"
    If eb = 2 Then
        exp = "break"
    ElseIf eb = 1 Then
        exp = "run"
    ElseIf eb = 0 Then
        exp = "design"
    End If
    If m <> "unknown" Then
        If exp <> m Then
            Dim c As Object
            Set c = CreateObject("Scripting.Dictionary")
            c("state") = st
            c("ebMode") = eb
            c("expectedFromEbMode") = exp
            Set d("modeConflict") = c
        End If
    End If
    Err.Clear
    Set IdeModeBlock = d
End Function

