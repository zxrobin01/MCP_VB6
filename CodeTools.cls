    If fp Is Nothing Then GoTo skipCache
    Dim ncache As Object
    Set ncache = CreateObject("Scripting.Dictionary")
    ncache("key") = fp("key")
    ncache("hash") = fp("hash")
    ncache("ok") = br.ok
    ncache("exitCode") = ec
    ncache("artifact") = artifact
    ncache("size") = br.artifactSize
    ncache("logPath") = logPath
    ncache("at") = Now
    ncache("verdict") = br.verdict
    ncache("okByKeyword") = br.okByKeyword
    ' FIX-24 (F6): carry the compiled-source axis into the cache so a later verify can decide
    ' whether this verdict may speak for the DISK file.
    ncache("compiledFrom") = CStr(root("compiledFrom"))
    ncache("paneDiskMismatch") = CBool(root("paneDiskMismatch"))
    ncache("paneDiskMismatchCount") = CLng(root("paneDiskMismatchCount"))
