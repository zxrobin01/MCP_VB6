        o("inputEncoding") = fEnc
    End If
    ToolImmediateRun = JsonStringify(o)
End Function

 ' CONSERVATIVE static refusal for expressions that CREATE objects/arrays. MEASURED: the
 ' immediate channel HANGS on a plain (no-Set) object assignment - a line like
 ' v513 = CreateObject("Scripting.Dictionary") never returned and the single-flight gate stayed held.
 ' Set v511 = New Collection and Set v511 = CreateObject(...) alone are fine, but the tool cannot
 ' know the shape before it runs, so these expressions are REFUSED instead of being sent to the
 ' engine: the product contract simply does not include object/array EXPRESSIONS in this channel.

' EVAL SAFETY: PRIMARY prevention for "the evaluation raised -> the IDE showed a modal box ->
' the in-flight call never returned". It answers ONE question WITHOUT ever raising: is the
' expression a dotted MEMBER ACCESS whose root is provably Empty or Nothing? TypeName(<root>)
' cannot raise, so this probe is safe; Empty + member access is a guaranteed 424 and Nothing +
' member access a guaranteed 91, so the caller refuses instead of executing.


' WP-22-02: VB6 file/handle errors mean the SINK could not be used - they must NOT be
' reported as 'the expression was rejected' (live: a leading Close #511 raised exactly here).



' WP-22-02: the immediate window belongs to the OPEN project, which has NO add-in modules, so
' the exec line may use ONLY a LITERAL file number (#511) and the Debug.Print channel that
' immediate_run already proves works. eval therefore executes Debug.Print <expr>, and the value
' is read back from the add-in's Debug.Print sink (valueTransport=debug_print).

' =====================================================================
' (A): ide_quiet_mode - a session-level switch that stops the add-in from
' STEALING the user's foreground while an agent drives the IDE.
' =====================================================================
Private Function ToolIdeQuietMode(ByVal enable As Boolean, ByVal ttlMs As Long) As String
    Dim fgB As Long
    Dim fgA As Long
    fgB = WoFrontHwnd()
    Dim wasOn As Boolean
    wasOn = QuietActive()
    If enable Then
        If ttlMs <= 0 Then ttlMs = QUIET_TTL_DEFAULT_MS
        m_quietOn = True
        m_quietSince = GetTickCount()
        m_quietTtlMs = ttlMs
    Else
        m_quietOn = False
        m_quietSince = 0
        m_quietTtlMs = 0
    End If
    Dim nowOn As Boolean
    nowOn = QuietActive()
    fgA = WoFrontHwnd()
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = True
    d("tool") = "ide_quiet_mode"
    d("quietMode") = nowOn
    d("previousQuietMode") = wasOn
    d("changed") = (nowOn <> wasOn)
    d("since") = m_quietSince
    d("ttlMs") = m_quietTtlMs
    d("quietExpiresAt") = IIf(nowOn, m_quietSince + m_quietTtlMs, 0)
    d("expiresInMs") = IIf(nowOn, m_quietTtlMs - (GetTickCount() - m_quietSince), 0)
    d("suppressedFocusCount") = m_quietSuppressed
    d("foregroundBefore") = fgB
    d("foregroundAfter") = fgA
    d("foregroundTookFocus") = (fgA <> fgB)
    d("foregroundReadable") = (fgB <> 0 Or fgA <> 0)
    d("advisory") = IIf(nowOn, QUIET_ADVISORY, "")
    d("suppressedPoints") = "control_window{action:""activate""} skips Window.SetFocus while quiet mode is ON (that receipt carries quietModeSuppressedFocus:true). native_breakpoint CANNOT be issued without activating the IDE - it is a Debug-menu command - so quiet mode can only give the foreground BACK there (quietModeForegroundRestored)."
    d("note") = "quiet OFF restores the pre-v1.9.0 behaviour byte for byte: no SetFocus is suppressed and no quiet{} block is added to any receipt. foregroundReadable=false means GetForegroundWindow() returned 0; that happens on a non-interactive or locked desktop and is reported as-is - it must NOT be read as the focus was left alone."
    ToolIdeQuietMode = JsonStringify(d)
End Function

' (R17): insert extra top-level members into a JSON OBJECT text without
' re-parsing it. Returns jsonText unchanged when the shape is not a plain non-empty
' object, so the caller can detect the refusal with a plain equality test.
Private Function JsonPrependMembers(ByVal jsonText As String, ByVal frag As String) As String
    JsonPrependMembers = jsonText
    If Len(jsonText) = 0 Then Exit Function
    If Len(frag) = 0 Then Exit Function
    Dim s As String
    Dim i As Long
    s = Trim$(jsonText)
    If Len(s) < 2 Then Exit Function
    If Left$(s, 1) <> "{" Then Exit Function
    If Mid$(s, 2, 1) = "}" Then Exit Function
    i = InStr(jsonText, "{")
    If i = 0 Then Exit Function
    JsonPrependMembers = Left$(jsonText, i) & frag & "," & Mid$(jsonText, i + 1)
End Function

Private Function OpenProjectName(ByVal p As VBIDE.VBProject) As String
    OpenProjectName = "<none>"
    On Error Resume Next
    If Not p Is Nothing Then OpenProjectName = p.Name
    If Err.Number <> 0 Then
        Err.Clear
        OpenProjectName = "<none>"
    End If
    On Error GoTo 0
End Function

' VBProjects.Remove is the documented member; VBProject.Close is the fallback.
Private Function CloseProject(ByVal pj As VBIDE.VBProject) As Boolean
    Dim ok As Boolean
    ok = False
    On Error Resume Next
    m_vbe.VBProjects.Remove pj
    If Err.Number = 0 Then ok = True Else Err.Clear
    On Error GoTo 0
    If Not ok Then
        On Error Resume Next
        pj.Close
        If Err.Number = 0 Then ok = True Else Err.Clear
        On Error GoTo 0
    End If
    CloseProject = ok
End Function

' Lists components whose recorded file name does not exist on disk. VB6
' crashes (AV in USER32) when such a project is saved, so the save path refuses
' to run while this list is non-empty.
Private Function MissingComponentFiles(ByVal p As VBIDE.VBProject) As String
    Dim comp As VBIDE.VBComponent
    Dim f As String
    Dim bad As String
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    bad = ""
    On Error Resume Next
    For Each comp In p.VBComponents
        f = ""
        Err.Clear
        f = comp.FileNames(1)
        If Err.Number <> 0 Then
            Err.Clear
            f = ""
        End If
        If Len(f) > 0 Then
            If Not fso.FileExists(f) Then bad = bad & comp.Name & " -> " & f & "; "
        End If
    Next
    On Error GoTo 0
    MissingComponentFiles = bad
End Function

Private Function ToolAddProject(ByVal projType As String, ByVal templatePath As String) As String
    Dim hostGuard As String
    hostGuard = McpProjTools.ProjectHostGuard(Me, "add_project")
    If Len(hostGuard) > 0 Then
        ToolAddProject = hostGuard
        Exit Function
    End If
    Dim p As VBIDE.VBProject
    If Len(templatePath) > 0 Then
        Set p = m_vbe.VBProjects.AddFromTemplate(ResolvePath(templatePath), True)
        CloseStartupDialog
    Else
        Dim pt As vbext_ProjectType
        Select Case LCase$(projType)
            Case "standardexe", ""
                pt = vbext_pt_StandardExe
            Case "activexexe"
                pt = vbext_pt_ActiveXExe
            Case "activexdll"
                pt = vbext_pt_ActiveXDll
            Case "activexcontrol"
                pt = vbext_pt_ActiveXControl
            Case Else
                Err.Raise vbObjectError + 45, "CodeTools", "Unknown project type: " & projType
        End Select
        ' Exclusive=True: the new project becomes THE project and the
        ' IDE leaves its startup group mode (running a group prompts
        ' 'Save Project Group As' before every run)
        Set p = m_vbe.VBProjects.Add(pt, True)
        CloseStartupDialog
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("created") = p.Name
    root("type") = McpProjTools.ProjectTypeName(Me, p)
    ToolAddProject = JsonStringify(root)
End Function

Private Sub CloseStartupDialog()
    ' dismiss the IDE's startup New-Project dialog (新建工程); this
    ' build keeps it open as a modal window that blocks run/make even
    ' after VBProjects.Add
    ' (i18n): this dialog used to be found by its LOCALIZED
    ' caption, so on a VB6 in any language other than Chinese it was never
    ' dismissed and run/make stayed blocked behind a modal window. Match by window
    ' CLASS instead: it is always #32770 and always owned by THIS process. To avoid
    ' touching unrelated dialogs we only act on the one that is currently the
    ' foreground window (a modal dialog is the active window). The historical
    ' caption lookup is kept ONLY as a last resort - nothing depends on it.
    Const WM_CLOSE As Long = &H10
    Const BM_CLICK As Long = &HF5
    Const GW_CHILD As Long = 5
    Const GW_HWNDNEXT As Long = 2
    Const GWL_STYLE As Long = -16
    Const BS_DEFPUSHBUTTON As Long = &H1
    On Error Resume Next
    Dim myPid As Long
    myPid = GetCurrentProcessId()
    Dim fg As Long
    fg = GetForegroundWindow()
    Dim hDlg As Long
    hDlg = FindWindowExW(0, 0, StrPtr("#32770"), 0)
    Do While hDlg <> 0
        Dim pid As Long
        pid = 0
        GetWindowThreadProcessId hDlg, pid
        If pid = myPid And fg <> 0 And hDlg = fg Then
            ' prefer the default button so the dialog runs its own OK path
            Dim hChild As Long
            Dim btn As Long
            btn = 0
            hChild = GetWindow(hDlg, GW_CHILD)
            Do While hChild <> 0
                If (GetWindowLongW(hChild, GWL_STYLE) And BS_DEFPUSHBUTTON) <> 0 Then
                    btn = hChild
                    Exit Do
                End If
                hChild = GetWindow(hChild, GW_HWNDNEXT)
            Loop
            If btn <> 0 Then
                PostMessageW btn, BM_CLICK, 0, 0
            Else
                PostMessageW hDlg, WM_CLOSE, 0, 0
            End If
        End If
        hDlg = FindWindowExW(0, hDlg, StrPtr("#32770"), 0)
    Loop
    ' last resort only (localized caption); not the primary path any more
    Dim dlgName As String
    dlgName = ChrW$(&H65B0) & ChrW$(&H5EFA) & ChrW$(&H5DE5) & ChrW$(&H7A0B)
    Dim hDlg2 As Long
    hDlg2 = FindWindowW(0, StrPtr(dlgName))
    If hDlg2 <> 0 Then PostMessageW hDlg2, WM_CLOSE, 0, 0
End Sub

Private Function ToolRemoveProject(ByVal name As String, Optional ByVal allowDirty As Boolean = False, _
                                    Optional ByVal allowHostWrite As Boolean = False) As String
    Dim hostGuard As String
    hostGuard = McpProjTools.ProjectHostGuard(Me, "remove_project")
    If Len(hostGuard) > 0 Then
        ToolRemoveProject = hostGuard
        Exit Function
    End If
    ' ---------------------------------------------------------------------------
    ' (receipt honesty): this function used to report ok:false /
    ' unexpected_error on a SUCCESSFUL removal. Two independent defects:
    '   (1) it read p.Name AFTER m_vbe.VBProjects.Remove p. Remove disconnects the
    '       VBProject object, so that read raises on EVERY successful removal, and the
    '       Fail handler wrapped the raise into ok:false/unexpected_error even though
    '       the project really was gone (measured: state axis showed no project);
    '   (2) a legal "nothing to remove" state (no project open, or a name that does
    '       not exist) also came out as unexpected_error instead of a structured refusal.
    ' The identity is now read BEFORE the removal, success is only claimed when the
    ' open-project count really dropped, and the legal states are structured refusals.
    ' ---------------------------------------------------------------------------
    If m_vbe Is Nothing Then
        ToolRemoveProject = RemoveProjectRefusal("ide_not_connected", _
            "the add-in has no live VBIDE connection", name)
        Exit Function
    End If
    If m_vbe.VBProjects.Count = 0 Then
        ToolRemoveProject = RemoveProjectRefusal("no_project", _
            "there is no project to remove: the IDE is already in the no-project state", name)
        Exit Function
    End If
    Dim p As VBIDE.VBProject
    Dim q As VBIDE.VBProject
    If Len(name) = 0 Then
        Set p = m_vbe.ActiveVBProject
    Else
        ' deliberately NOT FindProject(): its Err.Raise("Project not found") would once
        ' again surface as unexpected_error instead of a structured refusal
        For Each q In m_vbe.VBProjects
            If LCase$(q.Name) = LCase$(name) Then
                Set p = q
                Exit For
            End If
        Next
    End If
    If p Is Nothing Then
        If Len(name) = 0 Then
            ToolRemoveProject = RemoveProjectRefusal("no_active_project", _
                "the IDE has open projects but none of them is the active project", name)
        Else
            ToolRemoveProject = RemoveProjectRefusal("project_not_found", _
                "no open project is named '" & name & "'", name)
        End If
        Exit Function
    End If
    ' FIX-21 (B2): refuse ONLY on POSITIVE evidence taken from THIS batch of reads:
    '   project.Saved read as False  -> evidenceSource="project_saved_false"
    '   a component's Saved read as False -> evidenceSource="component_saved_false:<name>"
    ' Unreadable flags never refuse (dirtyUnknown + componentSavedReadErrors[] instead).
    Dim dirtyNames As Object
    Dim compErrors As Object
    Dim componentProbe As String
    Dim componentUnknown As Boolean
    Dim dirtyUnknown As Boolean
    Dim projectSaved As Boolean
    Dim projectSavedKnown As Boolean
    Dim evidenceSource As String
    Dim componentCount As Long
    componentCount = 0
    dirtyUnknown = False
    projectSaved = True
    projectSavedKnown = False
    evidenceSource = "none"
    On Error Resume Next
    Err.Clear
    projectSaved = CBool(p.Saved)
    If Err.Number <> 0 Then
        dirtyUnknown = True
        projectSavedKnown = False
        Err.Clear
    Else
        projectSavedKnown = True
        If Not projectSaved Then evidenceSource = "project_saved_false"
    End If
    On Error GoTo 0
    ' 33b.1 S1: read VBComponent.IsDirty through the SAME helper open_project uses (VBComponent.Saved
    ' is not a member of that interface on this build: it raises 438, which is what made the 33b
    ' dirtyComponents list permanently empty while the receipt still claimed dirtyUnknown:false).
    Set dirtyNames = ComponentDirtyProbe(p, componentProbe, compErrors, componentUnknown, componentCount)
    If componentUnknown Then dirtyUnknown = True
    If Not componentUnknown Then
        If dirtyNames Is Nothing And componentProbe = "none" Then componentProbe = "none"
    End If
    If evidenceSource = "none" And Not dirtyNames Is Nothing Then
        If dirtyNames.Count > 0 Then
            Dim firstDirty As Object
            Set firstDirty = dirtyNames.Item(1)
            evidenceSource = "component_dirty:" & CStr(firstDirty("name"))
        End If
    End If
    Dim dirtySource As String
    dirtySource = "none"
    If evidenceSource = "project_saved_false" Then
        If dirtyNames Is Nothing Then
            dirtySource = "project"
        ElseIf dirtyNames.Count = 0 Then
            dirtySource = "project"
        Else
            dirtySource = "project_and_components"
        End If
    ElseIf Not dirtyNames Is Nothing Then
        If dirtyNames.Count > 0 Then dirtySource = "component"
    End If
    Dim dirtyFound As Boolean
    dirtyFound = (evidenceSource <> "none")
    If dirtyFound And Not allowDirty Then
        Dim refD As Object
        Set refD = CreateObject("Scripting.Dictionary")
        refD("ok") = False
        refD("reason") = "unsaved_changes_would_be_discarded"
        refD("tool") = "remove_project"
        refD("projectName") = p.Name
        refD("projectSaved") = projectSaved
        refD("projectSavedKnown") = projectSavedKnown
        refD("evidenceSource") = evidenceSource
        refD("dirtySource") = dirtySource
        refD("componentProbe") = componentProbe
        refD("componentCount") = componentCount
    If dirtyUnknown Or dirtyNames Is Nothing Then
        refD("dirtyComponents") = Null
    Else
        Set refD("dirtyComponents") = dirtyNames
    End If
    refD("dirtyUnknown") = dirtyUnknown
    If compErrors Is Nothing Then
        Set refD("componentSavedReadErrors") = New Collection
    Else
        Set refD("componentSavedReadErrors") = compErrors
    End If
        refD("detail") = "removing the project would DISCARD its unsaved project/component changes"
        refD("howToProceed") = "save_project first, or pass allowDirty=true to discard deliberately"
        refD("note") = "nothing was removed: the IDE project group is unchanged"
        ToolRemoveProject = JsonStringify(refD)
        Exit Function
    End If
    ' 33b S1: a DIRTY + UNTITLED project cannot be closed without VB6 writing it into CurDir.
    ' Default = structured refusal, zero writes; allowHostWrite:true restores the 3a behaviour.
    Dim untitledKnown As Boolean
    If dirtyFound And allowDirty Then
        If ProjectIsUntitled(p, untitledKnown) Then
            If Not allowHostWrite Then
                ToolRemoveProject = DirtyUntitledRefusal("remove_project", p, dirtyNames, componentProbe, compErrors, componentUnknown, dirtySource, evidenceSource, "")
                Exit Function
            End If
        End If
    End If
    ' capture the identity BEFORE the removal (defect 1 above)
    Dim removedName As String
    Dim removedFile As String
    removedName = p.Name
    On Error Resume Next
    removedFile = p.FileName
    On Error GoTo 0
    Dim beforeCount As Long
    beforeCount = m_vbe.VBProjects.Count
    ' 3a: snapshot the IDE current directory around the host Remove. MEASURED 2026-10-23:
    ' VBProjects.Remove silently writes an unsaved project (untitled AND named) into
    ' CurDir$, overwriting same-named component files; it cannot be suppressed (the
    ' VBProject.Saved flag is read-only), so the receipt reports it. Best effort, fail-open.
    Dim hostProjDir As String
    hostProjDir = ""
    Dim hostFso As Object
    On Error Resume Next
    If Len(removedFile) > 0 Then
        Set hostFso = CreateObject("Scripting.FileSystemObject")
        hostProjDir = hostFso.GetParentFolderName(removedFile)
    End If
    Err.Clear
    On Error GoTo 0
    Dim hostBefore As Object
    Dim hostScanBefore As Long
    Dim hostTruncBefore As Boolean
    Dim hostFailBefore As Boolean
    Dim hostWhyBefore As String
    Set hostBefore = HostDirSnapshot(CurDir$, hostScanBefore, hostTruncBefore, hostFailBefore, hostWhyBefore)
    Call HostScanLog("before-cwd", CurDir$, hostScanBefore, hostTruncBefore, hostFailBefore, hostWhyBefore, hostBefore)
    Dim hostBeforeProj As Object
    Dim hostScanProjBefore As Long
    Dim hostTruncProjBefore As Boolean
    Dim hostFailProjBefore As Boolean
    Dim hostWhyProjBefore As String
    If Len(hostProjDir) > 0 Then
        Set hostBeforeProj = HostDirSnapshot(hostProjDir, hostScanProjBefore, hostTruncProjBefore, hostFailProjBefore, hostWhyProjBefore)
        Call HostScanLog("before-projdir", hostProjDir, hostScanProjBefore, hostTruncProjBefore, hostFailProjBefore, hostWhyProjBefore, hostBeforeProj)
    Else
        Set hostBeforeProj = Nothing
    End If
    m_vbe.VBProjects.Remove p
    Dim hostTruncAfter As Boolean
    Dim hostScanAfter As Long
    Dim hostBundle As Object
    Set hostBundle = HostWriteBundleEx(hostBefore, hostBeforeProj, hostProjDir, hostTruncAfter, hostScanAfter)
    Dim hostWrites As Object
    Set hostWrites = hostBundle("writes")
    Dim hostWritesScanned As Long
    hostWritesScanned = CLng(hostBundle("scanned"))
    Dim afterCount As Long
    afterCount = m_vbe.VBProjects.Count
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    ' (3) never fake a success: the project list must really have shrunk.
    If afterCount >= beforeCount Then
        d("ok") = False
        d("reason") = "remove_project_not_effective"
        d("tool") = "remove_project"
        d("detail") = "VBProjects.Remove returned no error but the open-project count did not drop (" & CStr(beforeCount) & " -> " & CStr(afterCount) & ")"
        d("note") = "no success is claimed: the project may still be open"
        ToolRemoveProject = JsonStringify(d)
        Exit Function
    End If
    Set d("remainingProjects") = RemainingProjectNames()
    d("ok") = True
    d("removed") = removedName
    If Len(removedFile) > 0 Then d("removedFile") = removedFile
    d("closed") = True
    d("dirtyUnknown") = dirtyUnknown
    d("projectSaved") = projectSaved
    d("projectSavedKnown") = projectSavedKnown
    d("evidenceSource") = evidenceSource
    d("dirtySource") = dirtySource
    d("componentProbe") = componentProbe
    d("componentCount") = componentCount
    Set d("componentSavedReadErrors") = compErrors
    ' 3a: SEMANTIC CORRECTION. The old value only meant that a discard was REQUESTED; it now
    ' reports whether the unsaved changes were really discarded. The host persists them on
    ' Remove (measured), so the honest value is False and the reason is in ...Basis.
    Dim discardedBasis As String
    If dirtyFound = False Then
        d("discardedUnsavedChanges") = False
        discardedBasis = "nothing_to_discard"
    ElseIf allowDirty = True Then
        If hostWrites.Count > 0 Then
            d("discardedUnsavedChanges") = False
            discardedBasis = "host_persists_changes_on_remove"
        Else
            d("discardedUnsavedChanges") = True
            discardedBasis = "no_host_write_observed"
        End If
    Else
        d("discardedUnsavedChanges") = False
        discardedBasis = "nothing_to_discard"
    End If
    d("discardedUnsavedChangesBasis") = discardedBasis
    d("hostWritePrevented") = False
    d("hostWritePreventedWhy") = HostWritePreventedWhy()
    d("hostWritesBasis") = CStr(hostBundle("basis"))
    d("hostWritesTruncated") = CBool(hostBundle("truncated"))
    d("hostWritesScanned") = hostWritesScanned
    Set d("hostWrites") = hostWrites
    If dirtyFound Then
        If dirtyUnknown Or dirtyNames Is Nothing Then
            d("dirtyComponents") = Null
        Else
            Set d("dirtyComponents") = dirtyNames
        End If
        d("removedWithUnsavedChanges") = allowDirty
    End If
    d("projectCountBefore") = beforeCount
    d("projectCountAfter") = afterCount
    d("note") = "the project was removed from the IDE's project group"
    ToolRemoveProject = JsonStringify(d)
End Function

' a legal "cannot remove" condition (no project open / no such name) is a
' STRUCTURED refusal, never ok:false/unexpected_error. Nothing was removed when this
' returns, so the note says exactly that.
Private Function RemoveProjectRefusal(ByVal reason As String, ByVal detail As String, ByVal name As String) As String
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = reason
    d("tool") = "remove_project"
    If Len(name) > 0 Then d("requestedName") = name
    d("detail") = detail
    d("note") = "nothing was removed: the IDE project group is unchanged"
    RemoveProjectRefusal = JsonStringify(d)
End Function

' the projects still open AFTER a removal. Read from the live collection (and
' never from the removed object, which is disconnected).
Private Function RemainingProjectNames() As Object
    Dim c As Object
    Set c = New Collection
    Dim p As VBIDE.VBProject
    For Each p In m_vbe.VBProjects
        c.Add p.Name
    Next
    Set RemainingProjectNames = c
End Function



' =====================================================================
' component tools
' =====================================================================

Private Function ToolGetComponentList() As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    Dim proj As VBIDE.VBProject
    Set proj = GetProject()
    root("project") = proj.Name
    Dim arr As Object
    Set arr = New Collection
    Dim p As VBIDE.VBProject
    Set p = proj
    Dim comp As VBIDE.VBComponent
    For Each comp In p.VBComponents
        Dim d As Object
        Set d = CreateObject("Scripting.Dictionary")
        d("name") = comp.Name
        d("type") = ComponentTypeName(comp.Type)
        On Error Resume Next
        Err.Clear
        d("file") = comp.FileNames(1)
        d("isDirty") = comp.IsDirty
        d("fileCount") = comp.FileCount
        d("designerID") = comp.DesignerID
        d("hasOpenDesigner") = comp.HasOpenDesigner
        d("description") = comp.Description
        d("helpContextID") = comp.HelpContextID
        d("iconState") = comp.IconState
        On Error GoTo 0
        Dim cm As VBIDE.CodeModule
        Set cm = comp.CodeModule
        If Not cm Is Nothing Then
            d("lines") = cm.CountOfLines
            d("declarationLines") = cm.CountOfDeclarationLines
            Set d("procedures") = ProcsOf(comp)
        End If
        arr.Add d
    Next
    Set root("components") = arr
    ToolGetComponentList = JsonStringify(root)
End Function

' the leading header the code module does not expose
' (Attribute VB_Name = "...", VERSION ...). Returns "" when the pane cannot be
' located inside the file, since guessing a header is worse than omitting it.
Private Function ComponentHeaderOf(ByVal name As String, ByVal paneText As String) As String
    On Error Resume Next
    ComponentHeaderOf = ""
    Dim path As String
    path = DiskPathOf(name, "")
    If Len(path) = 0 Then Exit Function
    If Dir$(path) = "" Then Exit Function
    Dim disk As String
    disk = Replace(Build.ReadLogAnsi(path), vbCrLf, vbLf)
    Dim plines() As String
    plines = Split(Replace(paneText, vbCrLf, vbLf), vbLf)
    If UBound(plines) < 0 Then Exit Function
    Dim first As String
    first = plines(0)
    Dim dlines() As String
    dlines = Split(disk, vbLf)
    Dim i As Long
    Dim hdr As String
    hdr = ""
    For i = 0 To UBound(dlines)
        MaybePump
        If dlines(i) = first Then Exit For
        hdr = hdr & dlines(i) & vbCrLf
    Next
    If i > UBound(dlines) Then Exit Function
    ComponentHeaderOf = hdr
End Function

Private Function ToolGetComponentCode(ByVal name As String, ByVal includeLineNumbers As Boolean, _
                                      ByVal coordSpace As String, ByVal procName As String, ByVal symbolName As String) As String
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    Dim cm As VBIDE.CodeModule
    Set cm = comp.CodeModule
    If cm Is Nothing Then Err.Raise vbObjectError + 21, "CodeTools", "Component has no code module: " & name
    ' gamma-1/gamma-2: coords picks the line space of the returned text
    ' (B+C batch default is "ide": pure pane text, IDE line numbers). "disk" keeps the
    ' A-batch behaviour byte-for-byte (header prepended, disk numbering) so an old
    ' caller only has to pass coords:"disk". proc:/symbol: narrows the range.
    Dim cs As String
    cs = LCase$(Trim$(coordSpace))
    If cs <> "disk" Then cs = "ide"
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = comp.Name
    root("ideLineCount") = cm.CountOfLines
    root("coordSpace") = cs
    Dim wholePane As String
    ' an empty component has CountOfLines = 0, and Lines(1, 0) raises VB
    ' error 5 ("invalid procedure call"). Reading nothing must return "" instead.
    If cm.CountOfLines > 0 Then wholePane = cm.Lines(1, cm.CountOfLines)
    Dim sIde As Long, eIde As Long, sliced As Boolean
    sIde = 1
    eIde = cm.CountOfLines
    sliced = False
    If Len(Trim$(procName)) > 0 Then
        If Not McpCls.ProcRangeOf(Me, cm, Trim$(procName), sIde, eIde) Then
            Set root("coords") = CoordsDictOfName(comp.Name, 1, cs)
            root("ok") = False
            root("reason") = "proc_not_found"
            root("proc") = procName
            root("lineSpace") = cs
            root("note") = "no procedure named '" & procName & "' in " & comp.Name & "; nothing was read"
            ToolGetComponentCode = JsonStringify(root)
            Exit Function
        End If
        sliced = True
    ElseIf Len(Trim$(symbolName)) > 0 Then
        If Not SymbolRangeOf(cm, Trim$(symbolName), sIde, eIde) Then
            Set root("coords") = CoordsDictOfName(comp.Name, 1, cs)
            root("ok") = False
            root("reason") = "symbol_not_found"
            root("symbol") = symbolName
            root("lineSpace") = cs
            root("note") = "no identifier named '" & symbolName & "' in " & comp.Name & "; nothing was read"
            ToolGetComponentCode = JsonStringify(root)
            Exit Function
        End If
        sliced = True
    End If
    ' alpha (coords honesty): CodeModule.Lines omits the file's
    ' Attribute/VERSION header, so this tool PREPENDS it; the emitted
    ' line numbers are therefore DISK lines. coords says exactly that (default =
    ' "disk"), and headerOffset = diskLine - ideLine holds for the first line.
    Dim cd As Object
    Set cd = CoordsDictOfName(comp.Name, sIde, cs)
    Set root("coords") = cd
    ' (R4): VB6 requires a LOCAL variable to be declared BEFORE its first
    ' use, so the accumulated map is resolved here - above every use of it.
    Dim em As Object
    Set em = PaneDiskMapCached(name)
    ' rework: say which space the numbered output is in AND which space the
    ' edit tools take, so a caller cannot lose track (an independent verifier read the
    ' numbered lines as edit lines and reported a false defect).
    root("lineNumbersAre") = cs
    root("editToolsTake") = "ide"
    root("convertToEditLine") = "ideLine = diskLine - coords.headerOffset"
    ' (R4): the mapping basis belongs at the TOP level of the one tool whose
    ' output is NUMBERED in disk space, and the hidden lines are named so the gaps in the
    ' numbering can be reproduced instead of being taken on trust.
    If cs = "disk" Then
        root("mappingBasis") = em("basis")
        root("mappingResolved") = em("resolved")
        root("hiddenInlineAttributeLines") = em("hiddenCount")
        Set root("hiddenInlineAttributeDiskLines") = em("hiddenDiskLines")
        If Not CBool(em("resolved")) Then Set root("mappingDeviationPaneLines") = em("deviationPaneLines")
        root("diskLineNote") = "in the DISK spaces the emitted line numbers skip the hidden inline Attribute lines, so they are not always consecutive; hiddenInlineAttributeDiskLines lists the disk lines the code pane does not show."
    End If
    If sliced Then
        ' The RANGE fields describe the SLICE and live in IDE code-pane lines, exactly like the
        ' edit tools. They are NOT disk lines: the emitted numbered TEXT follows coords, so a
        ' caller comparing a proc/symbol range with the numbering must convert. Both spaces are
        ' reported so this cannot be misread again.
        root("startLine") = sIde
        root("endLine") = eIde
        root("startLineSpace") = "ide"
        root("endLineSpace") = "ide"
        On Error Resume Next
        root("startLineDisk") = sIde + CLng(cd("headerOffset"))
        root("endLineDisk") = eIde + CLng(cd("headerOffset"))
        Err.Clear
        On Error GoTo 0
        root("rangeLineSpaceNote") = "startLine/endLine are IDE code-pane lines (the same space the edit tools take); startLineDisk/endLineDisk are the component FILE lines, derived with coords.headerOffset, and the emitted number=1 line follows coords (disk numbering when coords=disk)"
        If Len(Trim$(procName)) > 0 Then
            root("proc") = procName
        Else
            root("symbol") = symbolName
        End If
    End If
    Dim off As Long
    off = 0
    On Error Resume Next
    off = CLng(cd("headerOffset"))
    On Error GoTo 0
    ' (R4): the DISK line of every EMITTED line comes from the accumulated
    ' pane->disk map, because a hidden inline Attribute line inside the module shifts
    ' everything below it. hl is the number of header lines this tool prepends.
    Dim headerText As String
    Dim hl As Long
    headerText = ""
    hl = 0
    Dim code As String
    Dim baseNo As Long
    If cs = "disk" And Not sliced Then
        headerText = ComponentHeaderOf(name, wholePane)
        hl = HeaderLineCountOf(headerText)
        code = headerText & wholePane
        baseNo = 1
    Else
        code = SliceLines(wholePane, sIde, eIde)
        If cs = "disk" Then
            baseNo = sIde + off
        Else
            baseNo = sIde
        End If
    End If
    root("includeLineNumbers") = includeLineNumbers
    root("lineCount") = LineCount(code)
    ' READ FACE: state the AUTHORITY of this receipt's hash. A write-then-read check needs
    ' no cache: the WRITE receipt's sha256After and this receipt's sha256 are the SAME
    ' pane space (coords=ide is the default), so they must be equal right after a write.
    ' The component FILE only changes on save_project, which is why verify/ideEqualsDisk
    ' legitimately answers false until then - a disk-space observation, not a stale read.
    root("shaSpace") = "pane"
    root("writeReadAuthority") = "on a write-then-read, the WRITE receipt's sha256After is authoritative for the PANE; get_component_code (coords=ide, the default) returns that same pane text, so its sha256 must equal it. The component FILE is only updated by save_project, so verify/ideEqualsDisk stays false until then - a disk-space observation, not a stale read."
    If cm.CountOfLines = 0 Then
        root("lineCount") = 0
        root("text") = ""
        root("textSha256") = Sha256.Sha256HexTextUtf8("")
        root("sha256") = root("textSha256")
        ToolGetComponentCode = JsonStringify(root)
        Exit Function
    End If
    If Not includeLineNumbers Then
        root("text") = code
        root("textSha256") = Sha256.Sha256HexTextUtf8(code)
        root("sha256") = root("textSha256")
        ToolGetComponentCode = JsonStringify(root)
        Exit Function
    End If
    Dim lines() As String
    lines = Split(code, vbCrLf)
    Dim out As String
    Dim i As Long
    ' same quadratic accumulation as SliceLines (one append per source
    ' line). Build the numbered lines into an array and Join ONCE (reference
    ' technique: array + Join). Produced text is byte-identical.
    Dim ub As Long
    ub = -1
    On Error Resume Next
    ub = UBound(lines)
    On Error GoTo 0
    out = ""
    If ub >= 0 Then
        Dim parts() As String
        Dim k As Long
        ReDim parts(0 To ub)
        k = 0
        Dim thisNo As Long
        For i = 0 To ub
            MaybePump
            If i = ub Then
                If Len(lines(i)) = 0 Then Exit For
            End If
            ' (R4): number each emitted line from the ACCUMULATED map. In the
            ' whole-module disk space the prepended header occupies disk lines 1..hl and
            ' the pane lines follow; in a slice the pane line is sIde + i.
            thisNo = baseNo + i
            If cs = "disk" Then
                If sliced Then
                    If ExactDiskLineOf(em, sIde + i, 0) > 0 Then thisNo = ExactDiskLineOf(em, sIde + i, 0)
                Else
                    If i < hl Then
                        thisNo = i + 1
                    Else
                        If ExactDiskLineOf(em, i - hl + 1, 0) > 0 Then thisNo = ExactDiskLineOf(em, i - hl + 1, 0)
                    End If
                End If
            End If
            parts(k) = Right$("    " & CStr(thisNo), 5) & "| " & lines(i) & vbCrLf
            k = k + 1
        Next
        If k > 0 Then
            If k <= ub Then ReDim Preserve parts(0 To k - 1)
            out = Join(parts, "")
        End If
    End If
    root("text") = out
    root("textSha256") = Sha256.Sha256HexTextUtf8(out)
    root("sha256") = root("textSha256")
    ToolGetComponentCode = JsonStringify(root)
End Function

' The number of lines in a header text (it ends with a CRLF, so the trailing empty
' element is not a line).
Private Function HeaderLineCountOf(ByVal headerText As String) As Long
    HeaderLineCountOf = 0
    If Len(headerText) = 0 Then Exit Function
    Dim a() As String
    a = Split(Replace(Replace(headerText, vbCrLf, vbLf), vbCr, vbLf), vbLf)
    If Len(a(UBound(a))) = 0 Then
        HeaderLineCountOf = UBound(a)
    Else
        HeaderLineCountOf = UBound(a) + 1
    End If
End Function


' gamma-2 helpers
Private Function SliceLines(ByVal pane As String, ByVal sLine As Long, ByVal eLine As Long) As String
    ' this used to accumulate with "out = out & lines(i) & vbCrLf" once
    ' per line. That is quadratic and is the real ~12 s of the 1 MB whole-module
    ' get_component_code (28,814 appends, each copying the whole prefix); one earlier report
    ' attributed that cost to the JSON step, but the JSON escaping itself measures
    ' ~130 ms/MB. Collect the wanted lines into an array and Join ONCE - the
    ' user-verified reference technique (a JSON module in the reference VB6 application: build a
    ' piece array, Join once, never "s = s & ..." in a loop). Output is identical:
    ' the old loop appended a CRLF after every line and then dropped the last one,
    ' which is exactly Join(parts, vbCrLf).
    Dim lines() As String, i As Long, k As Long
    lines = Split(pane, vbCrLf)
    If sLine < 1 Then sLine = 1
    If eLine > UBound(lines) + 1 Then eLine = UBound(lines) + 1
    If eLine < sLine Then
        SliceLines = ""
        Exit Function
    End If
    Dim parts() As String
    ReDim parts(0 To eLine - sLine)
    k = 0
    For i = sLine To eLine
        MaybePump
        parts(k) = lines(i - 1)
        k = k + 1
    Next
    SliceLines = Join(parts, vbCrLf)
End Function


Private Function SymbolRangeOf(ByVal cm As VBIDE.CodeModule, ByVal sym As String, ByRef sLine As Long, ByRef eLine As Long) As Boolean
    On Error Resume Next
    SymbolRangeOf = False
    Dim pane As String, lines() As String, i As Long, hit As Long
    ' guard the empty-component case (CountOfLines = 0 => Lines(1,0) = error 5)
    If cm.CountOfLines > 0 Then pane = cm.Lines(1, cm.CountOfLines)
    lines = Split(pane, vbCrLf)
    hit = 0
    For i = 0 To UBound(lines)
        MaybePump
        If HasWholeWord(lines(i), sym) Then
            hit = i + 1
            Exit For
        End If
    Next
    If hit = 0 Then Exit Function
    Dim p As String
    p = cm.ProcOfLine(hit, vbext_pk_Proc)
    If Len(p) > 0 Then
        If McpCls.ProcRangeOf(Me, cm, p, sLine, eLine) Then
            SymbolRangeOf = True
            Exit Function
        End If
    End If
    sLine = hit
    eLine = hit
    SymbolRangeOf = True
End Function

Private Function HasWholeWord(ByVal line As String, ByVal word As String) As Boolean
    Dim lc As String, wc As String, posn As Long, before As String, after As String
    HasWholeWord = False
    wc = LCase$(word)
    If Len(wc) = 0 Then Exit Function
    lc = LCase$(line)
    posn = InStr(1, lc, wc, vbBinaryCompare)
    Do While posn > 0
        before = ""
        after = ""
        If posn > 1 Then before = Mid$(lc, posn - 1, 1)
        If posn + Len(wc) <= Len(lc) Then after = Mid$(lc, posn + Len(wc), 1)
        If Not IsWordChar(before) And Not IsWordChar(after) Then
            HasWholeWord = True
            Exit Function
        End If
        posn = InStr(posn + 1, lc, wc, vbBinaryCompare)
    Loop
End Function

Private Function IsWordChar(ByVal c As String) As Boolean
    IsWordChar = (Len(c) > 0 And InStr("abcdefghijklmnopqrstuvwxyz0123456789_", c) > 0)
End Function

Private Function ToolReplaceCode(ByVal name As String, ByVal operation As String, ByVal startLine As Long, ByVal endLine As Long, _
                                 ByVal code As String, ByVal expectedSha As String, ByVal validateMode As String, _
                                 ByVal snapshotOn As Boolean) As String
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    Dim cm As VBIDE.CodeModule
    Set cm = comp.CodeModule
    If cm Is Nothing Then Err.Raise vbObjectError + 21, "CodeTools", "Component has no code module: " & name
    ' totalMs must cover the WHOLE call. It used to start just before
    ' the write dispatch, so a slow read/predict/lint still reported totalMs=0
    ' (an earlier measurement). tEntry is the first statement of the tool; the marks below split
    ' the call into read / predict / lint.
    Dim tEntry As Long, tRead As Long, tPredict As Long, tLint As Long
    tEntry = GetTickCount()
    Dim op As String
    op = LCase$(operation)
    ' a LINE-NUMBER edit must pin the text it was measured
    ' against. The user lost code once by replacing a remembered range after the file
    ' had shifted ("stale line numbers hit another procedure"). The guard used to be
    ' OPTIONAL for every operation; for replace/delete it is now REQUIRED, and the
    ' refusal carries the sha the caller needs, so the fix is a single retry.
    ' insert/append/set keep the old optional behaviour: an insert only shifts text, it
    ' cannot destroy the code the caller measured (and set= replaces everything, where
    ' a whole-text sha carries no information).
    If (op = "replace" Or op = "delete") And Len(Trim$(expectedSha)) = 0 Then
        ToolReplaceCode = MissingShaRefusal(comp.Name, op, startLine, endLine, cm)
        Exit Function
    End If
    Dim norm As String
    norm = NormalizeNewlines(code)
    ' the code pane is ANSI-backed (measured: an astral character in the
    ' submitted text comes back as '?'), so the write is gated on the SAME byte-level
    ' round trip the file paths use - refuse instead of silently corrupting.
    If Len(norm) > 0 Then
        Dim rcBack As String, rcAt As Long
        If Not Encoding.TextEncodableEx(norm, "ansi", rcBack, rcAt) Then
            ToolReplaceCode = UnencodableRefusal("replace_code", comp.Name, "ansi", norm)
            Exit Function
        End If
    End If
    ' (the structural-gate review/the wording review): the PRE-WRITE structural gate. A block carrying its
    ' own header plus a redundant "End Function" used to be WRITTEN (only the linter
    ' complained, VB6-E105) and cost two failed builds.
    Dim pairRef As String
    ' (the structural-gate review reverse): set/append must be self-contained (the block IS the whole
    ' tail of the module), so a header without its End is refused up front. replace/insert
    ' may legitimately be a fragment - the result-level guard below judges those.
    pairRef = PreWritePairingRefusal("replace_code", comp.Name, norm, "code (operation=" & op & ")", (op = "set" Or op = "append"))
    If Len(pairRef) > 0 Then
        ToolReplaceCode = pairRef
        Exit Function
    End If
    Dim linesArr() As String
    linesArr = Split(norm, vbLf)
    Dim nLines As Long
    nLines = UBound(linesArr) + 1
    If nLines > 0 Then
        If linesArr(nLines - 1) = "" Then nLines = nLines - 1
    End If
    Dim reqStart As Long, reqEnd As Long
    reqStart = startLine
    reqEnd = endLine
    Dim countOfLines As Long
    countOfLines = cm.CountOfLines
    ' ---- beta-1: an out-of-range replace/delete is REFUSED, never
    ' clamped. The old path silently degraded to an insert and still answered
    ' deletedLines:0, which is how a wrong line number lost code (in a real project).
    If op = "replace" Or op = "delete" Then
        If reqStart > countOfLines Or reqEnd > countOfLines Then
            ToolReplaceCode = GuardReject(comp.Name, op, "range_beyond_end", _
                "start_line/end_line are past CountOfLines (" & CStr(countOfLines) & "); the IDE was not touched. Re-read the component with get_component_code and edit inside 1.." & CStr(countOfLines) & ", or use insert/append to add lines.", _
                reqStart, reqEnd, countOfLines)
            Exit Function
        End If
    End If
    ' ---- beta-2: never cut a VB line continuation in two
    Dim curPane As String
    ' guard the empty-component case (CountOfLines = 0 => Lines(1,0) = error 5)
    If cm.CountOfLines > 0 Then curPane = cm.Lines(1, cm.CountOfLines)
    ' gamma-3: the same optimistic-concurrency guard the anchor tools use
    GuardSha curPane, expectedSha
    Dim curLines() As String
    curLines = McpCls.TextLines(Me, curPane)
    If op = "replace" Or op = "delete" Then
        If IsContinuationTail(curLines, reqStart) Then
            ToolReplaceCode = GuardReject(comp.Name, op, "inside_continuation", _
                "line " & CStr(reqStart) & " is the tail of a logical line: line " & CStr(reqStart - 1) & " ends with a VB continuation _. Replacing or deleting it in place would split that logical line. Widen the range to the whole logical statement, or edit by anchor on its first line.", _
                reqStart, reqEnd, countOfLines)
            Exit Function
        End If
    ElseIf op = "insert" Then
        If IsContinuationTail(curLines, reqStart) Then
            ToolReplaceCode = GuardReject(comp.Name, op, "inside_continuation", _
                "the insertion point is inside a logical line: line " & CStr(reqStart - 1) & " ends with a VB continuation _. Insert before the first line of that logical statement, or after its last line.", _
                reqStart, reqStart, countOfLines)
            Exit Function
        End If
    ElseIf op = "append" Then
        If IsContinuationTail(curLines, countOfLines + 1) Then
            ToolReplaceCode = GuardReject(comp.Name, op, "inside_continuation", _
                "the last line ends with a VB continuation _, so appending would extend that logical statement. Close the statement first.", _
                countOfLines, countOfLines, countOfLines)
            Exit Function
        End If
    End If
    ' ---- beta-3: lint the RESULT before it is written (warn-only)
    tRead = GetTickCount()
    Dim adjStart As Long, adjEnd As Long
    adjStart = reqStart
    adjEnd = reqEnd
    If (op = "replace" Or op = "delete") Then
        If adjStart < 1 Then adjStart = 1
        If adjEnd < adjStart Then adjEnd = adjStart
    End If
    Dim predicted As String
    predicted = PredictedReplaceText(curPane, op, adjStart, adjEnd, linesArr, nLines)
    ' (the structural-gate review reverse direction): judge the RESULT, not just the block - refuse
    ' only when the pane is balanced now and the edit would leave it unbalanced.
    Dim ppRef As String
    ppRef = PredictedPairingRefusal("replace_code", comp.Name, curPane, predicted, "operation=" & op)
    If Len(ppRef) > 0 Then
        ToolReplaceCode = ppRef
        Exit Function
    End If
    tPredict = GetTickCount()
    Dim pack As Object
    ' above the region threshold, lint targets the edited procedure
    ' instead of the whole module (the receipt states the scope explicitly).
    Dim lintTarget As Long
    If countOfLines > LintRegionThreshold() Then lintTarget = LintRegionTarget(op, adjStart, countOfLines)
    Set pack = LintPackScoped(predicted, KindOfComponent(comp), lintTarget)
    tLint = GetTickCount()
    ' gamma-4: validate:'strict' refuses BEFORE the IDE is touched
    Dim rcref As String
    rcref = StrictRefusal(comp.Name, "replace_code", pack, validateMode)
    If Len(rcref) > 0 Then
        ToolReplaceCode = rcref
        Exit Function
    End If
    Dim clamped As Boolean
    clamped = False
    Dim apStart As Long, apEnd As Long
    apStart = 1
    apEnd = 0
    Dim summary As Object
    Set summary = CreateObject("Scripting.Dictionary")
    summary("readMs") = tRead - tEntry
    summary("predictMs") = tPredict - tRead
    summary("lintMs") = tLint - tPredict
    summary("component") = comp.Name
    summary("operation") = op
    ' m_lastWriteHunks is module state; reset it per call so a branch that
    ' never writes through SetCompTextMinimal can not report the PREVIOUS call's hunk count.
    ' reset the whole write-phase block here, not just the hunk count. The raw
    ' insert/append/delete branches below never go through SetCompTextMinimal and never
    ' publish the phases, so without these lines they would leave the PREVIOUS call's
    ' diffMs/joinMs/delMs/insMs/maxBlockLines in module state for any later reader
    ' (exactly the defect class, one field further out).
    ' tRaw/wcRaw time and count the raw single-block operations (insert/append/delete).
    m_lastWriteHunks = 0
    m_lastDiffMs = 0
    m_lastJoinMs = 0
    m_lastDelMs = 0
    m_lastInsMs = 0
    m_lastMaxBlock = 0
    Dim tRaw As Long, wcRaw As Long
    Dim i As Long
    ' opt-in pre-edit snapshot, taken exactly ONCE before any write. The four
    ' RAW branches below (replace / insert / append / delete) - and set's degenerate branch -
    ' write through CodeModule directly and never reached the snapshot funnel, which is why
    ' undo_edit could not undo a plain replace_code replace. Default off => no new file and a
    ' byte-identical receipt.
    If snapshotOn Then UndoSnapshot comp.Name, curPane
    Select Case op
        Case "set"
            Dim oldCount As Long
            oldCount = cm.CountOfLines
            ' (c): measured on a 27,000-line / 1.2 MB PURE-ASCII module, the
            ' WriteMs of DeleteLines+InsertLines is a SUPER-LINEAR function of the BLOCK
            ' SIZE and is INDEPENDENT of the block POSITION: 1 line = 0 ms at k=8/7000/
            ' 13500/20000/26990; 50 lines = 15 ms; 500 lines = 31 ms; 5,000 lines = 844 ms;
            ' the whole 27,000-line module = 21,593 ms. The old set branch always paid the
            ' last number (measured 19-27 s of set write time) no matter where the caller's
            ' edit was. Writing only the changed range (common prefix/suffix, <= 1 delete +
            ' <= 1 insert) produces the IDENTICAL pane text for at most one line of cost.
            Dim tWriteS As Long
            Dim setWrites As Long
            ' open the phase window for THIS write. The degenerate
            ' branch below does not go through SetCompTextMinimal, so it resets
            ' the phases itself instead of inheriting the previous call's.
            m_lastDiffMs = 0
            m_lastJoinMs = 0
            m_lastDelMs = 0
            m_lastInsMs = 0
            m_lastMaxBlock = 0
            tWriteS = GetTickCount()
            If oldCount > 0 And nLines > 0 Then
                Dim curSet As String
                curSet = CompText(comp.Name)
                setWrites = SetCompTextMinimal(comp.Name, curSet, JoinLines(linesArr, nLines), snapshotOn)
            Else
                ' (c) guard: the two degenerate shapes are NOT representable as a
                ' minimal range write - the common-prefix helper would issue DeleteLines on
                ' a 0-line module (VB error) or insert a phantom blank line when the
                ' requested text is empty. Those keep the historical two calls verbatim.
                ' one logical block (<=1 delete + <=1 insert) => hunks = 1.
                m_lastWriteHunks = 1
                setWrites = 0
                Dim tPhs As Long
                tPhs = GetTickCount()
                If oldCount > 0 Then
                    tPhs = GetTickCount()
                    cm.DeleteLines 1, oldCount
                    m_lastDelMs = m_lastDelMs + (GetTickCount() - tPhs)
                    If oldCount > m_lastMaxBlock Then m_lastMaxBlock = oldCount
                    setWrites = setWrites + 1
                End If
                If nLines > 0 Then
                    tPhs = GetTickCount()
                    Dim wholeText As String
                    wholeText = JoinLines(linesArr, nLines)
                    m_lastJoinMs = m_lastJoinMs + (GetTickCount() - tPhs)
                    tPhs = GetTickCount()
                    cm.InsertLines 1, wholeText
                    m_lastInsMs = m_lastInsMs + (GetTickCount() - tPhs)
                    If nLines > m_lastMaxBlock Then m_lastMaxBlock = nLines
                    setWrites = setWrites + 1
                End If
            End If
            summary("writeMs") = GetTickCount() - tWriteS
            AddWritePhases summary
            summary("writeCalls") = setWrites
            summary("hunks") = m_lastWriteHunks
            summary("insertedLines") = nLines
            summary("deletedLines") = oldCount
            apStart = 1
            apEnd = nLines
        Case "replace"
            startLine = adjStart
            endLine = adjEnd
            Dim rangeCount As Long
            rangeCount = endLine - startLine + 1
            ' ONE range replace instead of a per-line loop.
            ' VB6 fully REPARSES/REFORMATS the whole module after EVERY ReplaceLine /
            ' InsertLines, so the old loop paid one whole-module reformat per line: a
            ' 5-line edit on a 28,814-line (1 MB) module issued 5 ReplaceLine + 1
            ' InsertLines = 6 reformats, measured by the user as about 60 s. Now: at most
            ' one DeleteLines plus at most one InsertLines, i.e. writeCalls <= 2.
            ' Semantics of replacedLines/deletedLines/insertedLines and the clamp are
            ' UNCHANGED (see the summary block below).
            ' NOTE the name wipeCount, not delCount: VB6 has no block scope, and the
            ' "delete" case below already Dims delCount in this same procedure - reusing
            ' that name is a compile error (duplicate declaration in the current scope).
            Dim wipeCount As Long, writeCalls As Long
            wipeCount = rangeCount
            If startLine + wipeCount - 1 > cm.CountOfLines Then wipeCount = cm.CountOfLines - startLine + 1
            If wipeCount < 0 Then wipeCount = 0
            Dim tWrite0 As Long
            ' this branch writes through the CodeModule directly, so
            ' measure its phases here (same field names as the minimal writer).
            m_lastDiffMs = 0
            m_lastJoinMs = 0
            m_lastDelMs = 0
            m_lastInsMs = 0
            m_lastMaxBlock = 0
            m_lastWriteHunks = 1
            Dim tPh0 As Long
            tWrite0 = GetTickCount()
            If wipeCount > 0 Then
                tPh0 = GetTickCount()
                cm.DeleteLines startLine, wipeCount
                m_lastDelMs = m_lastDelMs + (GetTickCount() - tPh0)
                If wipeCount > m_lastMaxBlock Then m_lastMaxBlock = wipeCount
                writeCalls = writeCalls + 1
            End If
            If nLines > 0 Then
                tPh0 = GetTickCount()
                Dim repText As String
                repText = JoinLines(linesArr, nLines)
                m_lastJoinMs = m_lastJoinMs + (GetTickCount() - tPh0)
                tPh0 = GetTickCount()
                cm.InsertLines startLine, repText
                m_lastInsMs = m_lastInsMs + (GetTickCount() - tPh0)
                If nLines > m_lastMaxBlock Then m_lastMaxBlock = nLines
                writeCalls = writeCalls + 1
            End If
            summary("writeMs") = GetTickCount() - tWrite0
            AddWritePhases summary
            summary("writeCalls") = writeCalls
            summary("hunks") = m_lastWriteHunks
            If nLines < rangeCount Then
                summary("replacedLines") = nLines
                summary("deletedLines") = rangeCount - nLines
                summary("insertedLines") = 0
            Else
                summary("replacedLines") = rangeCount
                summary("deletedLines") = 0
                summary("insertedLines") = nLines - rangeCount
            End If
            apStart = startLine
            apEnd = startLine + nLines - 1
        Case "insert"
            If startLine < 1 Then startLine = 1
            If startLine > cm.CountOfLines + 1 Then
                clamped = True
                startLine = cm.CountOfLines + 1
            End If
            ' insert/append/delete are raw single-block writes too - they now
            ' report the SAME write-phase fields (writeMs/writeCalls/hunks) as set/replace,
            ' so every minimal-write receipt carries hunks (CONTRACTS §3). hunks = 1.
            tRaw = GetTickCount()
            wcRaw = 0
            If nLines > 0 Then
                cm.InsertLines startLine, JoinLines(linesArr, nLines)
                wcRaw = 1
            End If
            m_lastWriteHunks = 1
            summary("writeMs") = GetTickCount() - tRaw
            summary("writeCalls") = wcRaw
            summary("hunks") = m_lastWriteHunks
            summary("insertedLines") = nLines
            apStart = startLine
            apEnd = startLine + nLines - 1
        Case "append"
            tRaw = GetTickCount()
            wcRaw = 0
            If nLines > 0 Then
                cm.InsertLines cm.CountOfLines + 1, JoinLines(linesArr, nLines)
                wcRaw = 1
            End If
            m_lastWriteHunks = 1
            summary("writeMs") = GetTickCount() - tRaw
            summary("writeCalls") = wcRaw
            summary("hunks") = m_lastWriteHunks
            summary("insertedLines") = nLines
            apStart = cm.CountOfLines - nLines + 1
            apEnd = cm.CountOfLines
        Case "delete"
            ' beta-1: the range is already known to be inside the module
            ' (an out-of-range delete was refused above), so nothing is clamped here.
            startLine = adjStart
            endLine = adjEnd
            Dim delCount As Long
            delCount = endLine - startLine + 1
            tRaw = GetTickCount()
            cm.DeleteLines startLine, delCount
            m_lastWriteHunks = 1
            summary("writeMs") = GetTickCount() - tRaw
            summary("writeCalls") = 1
            summary("hunks") = m_lastWriteHunks
            summary("deletedLines") = delCount
            apStart = startLine
            apEnd = startLine - 1
        Case Else
            Err.Raise vbObjectError + 22, "CodeTools", "Invalid operation: " & operation & " (expected replace/insert/append/delete/set)"
    End Select
    If (op = "replace" Or op = "delete") Then
        If reqStart <> adjStart Or reqEnd <> adjEnd Then clamped = True
    End If
    ' ---- alpha-3: the IDE-read count next to the text-derived one
    Dim paneAfter As String
    paneAfter = CompText(comp.Name)
    Dim textTotal As Long, ideTotal As Long, paneTotal As Long
    textTotal = LineCount(paneAfter)
    ideTotal = cm.CountOfLines
    ' ONE basis for the caller = the pane truth (splitlines semantics).
    paneTotal = PaneLineCount(paneAfter)
    summary("newTotalLines") = paneTotal
    summary("ideTotalLines") = ideTotal
    summary("textTotalLines") = textTotal
    summary("trailingBlankLine") = TrailBlank(paneAfter)
    ' compare the TWO SOURCES against the pane truth (they always agreed with each other,
    ' so the old comparison could never fire). A trailing blank line is not a disagreement - the IDE
    ' counts it, the caller does not.
    If (ideTotal - TrailCount(paneAfter)) <> paneTotal Then summary("syncWarning") = SyncWarningText(ideTotal, paneTotal)
    ' ---- (B-family): the success signal + the pre/post pane shas -----------
    ' The caller must be able to decide success from the receipt alone, and to compare
    ' the two shas against the pane it read before the call.  sha256Before is the pane
    ' THIS call found (the same text expected_sha256 pins), sha256After is the pane the
    ' read-back above produced; ok means the text really changed and the IDE line count
    ' agrees with it.
    summary("sha256Before") = Sha256.Sha256HexTextUtf8(curPane)
    summary("sha256After") = Sha256.Sha256HexTextUtf8(paneAfter)
    summary("lineDelta") = paneTotal - PaneLineCount(curPane)
    Dim okRC As Boolean
    okRC = (curPane <> paneAfter)
    ' normalize the trailing blank line out of the IDE count before comparing, otherwise a
    ' healthy write whose pane text ends with a break would be reported as line_count_mismatch.
    If okRC Then okRC = ((ideTotal - TrailCount(paneAfter)) = paneTotal)
    summary("ok") = okRC
    If Not okRC Then
        If curPane = paneAfter Then
            summary("okReason") = "no_write: the pane text is unchanged after the write, so nothing was written"
        Else
            summary("okReason") = "line_count_mismatch: the IDE reports " & CStr(ideTotal) & " line(s) after the write but the pane text has " & CStr(paneTotal) & " (trailingBlankLine=" & CStr(TrailBlank(paneAfter)) & ")"
        End If
    End If
    ' ---- alpha-2: requested vs applied range, clamp visible
    Set summary("requestedRange") = RangeDict(op, reqStart, reqEnd)
    Set summary("appliedRange") = AppliedRangeDict(apStart, apEnd)
    summary("clamped") = clamped
    Set summary("coords") = CoordsDictOfName(comp.Name, apStart, "ide")
    ' echo the affected procedure's first/last pane line BEFORE and
    ' AFTER, so a line-number drift shows up in the receipt instead of silently editing
    ' another procedure. paneAfter is the post-write pane text already read above.
    Set summary("procBefore") = ProcEchoDict(curPane, apStart)
    Set summary("procAfter") = ProcEchoDict(paneAfter, apStart)
    AddPaneDiskFields summary, comp.Name, paneAfter
    CopyLintPack summary, pack
    ' totalMs covers the WHOLE call (entry -> receipt), so a slow call
    ' is self-explaining and can never report 0 ms again.
    ' replace_code has its OWN receipt builder (it does not go through
    ' ChangeResult2), so the project-directory write manifest is added here explicitly -
    ' without this the _undo snapshot written by the text-write funnel would be invisible.
    Dim pdwRC As Object
    Set pdwRC = New Collection
    ManifestMergeUndo pdwRC
    Set summary("projectDirWrites") = pdwRC
    summary("totalMs") = GetTickCount() - tEntry
    ' (F3): ReceiptJson serialises and adds serializeMs/receiptBytes; totalMs
    ' keeps its exact historical stamp point (just above) so old ledgers stay comparable.
    ToolReplaceCode = ReceiptJson(summary)
End Function

Private Function DeclAreaLines(ByVal paneText As String) As Object
    Dim coll As Object
    Set coll = New Collection
    Dim lines() As String
    Dim i As Long
    Dim s As String
    If Len(paneText) > 0 Then
        lines = McpCls.TextLines(Me, paneText)
        For i = 0 To UBound(lines)
            MaybePump
            s = Trim$(lines(i))
            If Len(Vb6Lint.LintProcHeaderName(lines(i))) > 0 Then Exit For
            If Len(s) > 0 Then coll.Add s
        Next i
    End If
    Set DeclAreaLines = coll
End Function

Private Function ComponentFileOf(ByVal comp As VBIDE.VBComponent) As String
    Dim s As String
    ComponentFileOf = ""
    If comp Is Nothing Then Exit Function
    On Error Resume Next
    s = comp.FileNames(1)
    If Err.Number <> 0 Then s = ""
    Err.Clear
    On Error GoTo 0
    ComponentFileOf = s
End Function

Private Function WcAddComponentFileFacts(ByVal fpath As String) As String
    Dim s As String
    Dim exists As Boolean
    exists = False
    If Len(fpath) > 0 Then
        On Error Resume Next
        exists = (Len(Dir$(fpath)) > 0)
        Err.Clear
        On Error GoTo 0
    End If
    s = WcJS("filePath") & ":" & WcJS(fpath) & ","
    s = s & WcJS("componentFile") & ":" & WcJS(fpath) & ","
    s = s & WcJS("fileMaterialized") & ":" & WcJB(exists) & ","
    s = s & WcJS("fileSizeAfterWrite") & ":" & CStr(WcFileSize(fpath)) & ","
    s = s & WcJS("fileSizeAfterWriteBasis") & ":" & WcJS("FileLen of the component member file on disk AFTER the write path ran; 0 with fileMaterialized=false means the file was not on disk at receipt time, NOT that the size was not measured") & ","
    WcAddComponentFileFacts = s
End Function

Private Function WcComponentMemberPath(ByVal comp As VBIDE.VBComponent, ByVal nm As String, ByVal kind As String) As String
    Dim bound As String
    Dim pdir As String
    WcComponentMemberPath = ""
    If Not comp Is Nothing Then
        bound = ComponentFileOf(comp)
        If Len(bound) > 0 Then
            WcComponentMemberPath = bound
            Exit Function
        End If
    End If
    On Error Resume Next
    pdir = Left$(GetProject().FileName, InStrRev(GetProject().FileName, Chr$(92)))
    If Err.Number <> 0 Then pdir = ""
    Err.Clear
    On Error GoTo 0
    If Len(pdir) > 0 And Len(nm) > 0 Then WcComponentMemberPath = pdir & nm & WcCompExt(kind)
End Function
' STRICT existence check used by the adopt-after-error path: the component must carry
' the requested NAME (case-insensitive, exact) AND the requested component TYPE. A
' component that merely appeared is never accepted - a caller asking for a class must
' not be handed a module.

Private Function ToolAddComponent(ByVal compType As String, ByVal name As String, ByVal code As String) As String
    ' FIX-12: an interactive Add-Form box that is ALREADY open must be CANCELLED, never turned
    ' into a synthesized form behind the caller's back.
    If LCase$(compType) = "form" Then
        Dim prior As Object
        Set prior = WinOps.WoModalCancelPriorDialog()
        If Not prior Is Nothing Then
            Dim rjc As Object
            Set rjc = CreateObject("Scripting.Dictionary")
            rjc("ok") = False
            rjc("reason") = "cancelled_by_policy"
            rjc("cancelledBy") = "modal_guard"
            Set rjc("priorDialog") = prior
            rjc("advice") = "creating a VB6 form through the IDE's Add Form command is inherently interactive (template selection); the modal dialog that was already open was cancelled. Use add_component{type:""module""} or import_component of a prepared .frm."
            Set rjc("dialogs") = WinOps.WoModalSnapshot()
            ToolAddComponent = JsonStringify(rjc)
            Exit Function
        End If
    End If
    Dim ct As vbext_ComponentType
    Select Case LCase$(compType)
        Case "module"
            ct = vbext_ct_StdModule
        Case "class"
            ct = vbext_ct_ClassModule
        Case "form"
            ct = vbext_ct_MSForm
        Case "mdiform"
            ct = vbext_ct_VBMDIForm
        Case "resource"
            ct = vbext_ct_ResFile
        Case "usercontrol"
            ct = vbext_ct_UserControl
        Case "proppage"
            ct = vbext_ct_PropPage
        Case "userdoc"
            ct = vbext_ct_DocObject
        Case "designer"
            ct = vbext_ct_ActiveXDesigner
        Case Else
            Err.Raise vbObjectError + 47, "CodeTools", "Unknown component type: " & compType
    End Select
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    Dim comp As VBIDE.VBComponent
    Dim createdFile As String
    createdFile = ""
    Dim createdVia As String
    createdVia = ""
    ' VBComponents.Add(vbext_ct_MSForm) raises E_FAIL (0x80004005) on installs
    ' where the Microsoft Form designer cannot be instantiated, while module,
    ' class, usercontrol and MDI form all add fine.
    ' the recovery is now the IDE'S OWN Add Form command (the IDE
    ' builds its own default form); the synthesized .frm + AddFile remains only as
    ' the last-resort fallback inside AddControlFormFile.
    If LCase$(compType) = "form" Then
        ' FIX-13: NEVER use the IDE's Add Form menu for type=form. That menu opens the
        ' template dialog which runs its own modal loop and wedges the calling tool; the
        ' synthesized .frm + AddFile route needs no dialog at all.
        m_skipIdeFormMenu = True
        On Error Resume Next
        Set comp = AddControlFormFile(p, name, createdFile, createdVia)
        Dim formErr As Long
        formErr = Err.Number
        Err.Clear
        On Error GoTo 0
        m_skipIdeFormMenu = False
        If comp Is Nothing Then
            Err.Raise vbObjectError + 46, "CodeTools", "Could not create a synthesized form component (0x" & Hex$(formErr) & ")"
        End If
    Else
        On Error Resume Next
        Set comp = p.VBComponents.Add(ct)
        ' MEASURED FALSE NEGATIVE: on a project that has no file, VBComponents.Add can
        ' leave the NEW component ASSIGNED and still return Err=5 (invalid procedure
        ' call). The old guard read any non-zero Err as "nothing was created", raised,
        ' and left a DEFAULT-NAMED component behind (Module1 / Class1). The caller then
        ' believed nothing had been made - a false negative that invites duplicates on
        ' the next retry. Rule below: never trust Err alone; accept ONLY on a strict
        ' existence+type check; keep the original error in the receipt either way.
        Dim addErr As Long
        Dim addErrDesc As String
        addErrDesc = Err.Description
        addErr = Err.Number
        Err.Clear
        On Error GoTo 0
        Dim adoptErr As String
        adoptErr = ""
        If addErr <> 0 Then adoptErr = CStr(addErr) & ":" & addErrDesc
        Dim adopted As Boolean
        adopted = False
        If comp Is Nothing Then
            ' the object was NOT assigned: only an EXACT name+type match may be adopted
            Set comp = McpFindTools.FindComponentExactType(Me, name, ct)
        End If
        If addErr <> 0 Then
            If Not comp Is Nothing Then
                ' strict re-check: the requested TYPE must match, otherwise nothing is adopted
                If comp.Type <> ct Then
                    Set comp = Nothing
                Else
                    adopted = True
                End If
            End If
            If comp Is Nothing Then
                Err.Raise vbObjectError + 46, "CodeTools", "VBComponents.Add failed for type " & compType & " (0x" & Hex$(addErr) & ")"
            End If
        ElseIf comp Is Nothing Then
            Err.Raise vbObjectError + 46, "CodeTools", "VBComponents.Add returned nothing for type " & compType
        End If
    End If
    If Len(name) > 0 Then comp.Name = name
    If Len(code) > 0 Then
        If Not comp.CodeModule Is Nothing Then
            comp.CodeModule.AddFromString code
            ' VBComponents.Add seeds new modules with an Option
            ' Explicit header; de-duplicate when the supplied code
            ' brings its own (duplicate Option statements are
            ' compile errors that break make/run)
            Dim nLines As Long
            nLines = comp.CodeModule.CountOfLines
            If nLines > 1 Then
                Dim seenOE As Boolean
                seenOE = False
                Dim li As Long
                For li = 1 To nLines
                    MaybePump
                    If li > 12 Then Exit For
                    Dim t As String
                    t = LCase$(Trim$(comp.CodeModule.Lines(li, 1)))
                    If t = "option explicit" Then
                        If seenOE Then
                            comp.CodeModule.DeleteLines li, 1
                            Exit For
                        End If
                        seenOE = True
                    End If
                Next
            End If
        End If
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("created") = comp.Name
    SeNoteCreated comp.Name
    ' the component was adopted AFTER VBComponents.Add reported an error: it is real
    ' (strict name+type check passed) but the evidence of that error is published here,
    ' never swallowed.
    If adopted Then
        root("adoptedAfterError") = True
        root("adoptedVbError") = adoptErr
        root("adoptedNote") = "VBComponents.Add reported an error but the requested component exists with the requested type, so it IS reported as created. The original error is kept in adoptedVbError; nothing was retried."
    End If
    root("type") = ComponentTypeName(comp.Type)
    ' ---- FIXED initial-declaration contract (receipt fields only; no schema change) ----
    ' MEASURED VB6 behaviour: VBComponents.Add seeds a new module with "Option Explicit".
    ' The component FILE additionally starts with Attribute VB_Name once it is saved, but
    ' that line is NOT part of the code pane, so initialDeclarations can only report pane
    ' lines - the rule is spelled out in the receipt instead of being implied.
    Dim initPane As String
    initPane = ""
    If Not comp.CodeModule Is Nothing Then
        If comp.CodeModule.CountOfLines > 0 Then initPane = comp.CodeModule.Lines(1, comp.CodeModule.CountOfLines)
    End If
    Dim initDecls As Object
    Set initDecls = DeclAreaLines(initPane)
    root("component") = comp.Name
    Set root("initialDeclarations") = initDecls
    root("initialDeclarationsCount") = initDecls.Count
    root("initialDeclarationsRule") = "initialDeclarations = the DECLARATION-AREA lines of the NEW component's code pane (before the first procedure header), trimmed and in pane order. VB6 seeds a module with Option Explicit, so a default module answers [Option Explicit]. The disk header Attribute VB_Name is NOT part of the code pane (it is written into the component FILE when the project is saved) and is therefore never listed here."
    root("lines") = IIf(comp.CodeModule Is Nothing, 0, comp.CodeModule.CountOfLines)
    If Len(createdFile) > 0 Then root("file") = createdFile
    ' how the form came into existence - "ide_dialog" (the IDE's own
    ' Add Form command built it: nothing written by us) or "synthesized" (last-resort
    ' fallback). Pure output: the inputSchema is unchanged.
    If Len(createdVia) > 0 Then
        root("createdVia") = createdVia
        If createdVia = "synthesized" Then root("ideRouteNote") = WinOps.WoConfirmStatus()
    End If
    ' the write manifest is ALWAYS present (empty array when the call wrote no
    ' file). add_component can only write a file on the form fallback, and that fallback is
    ' refused unless explicitly opted in, so this is [] on every normal call.
    Dim writes As Object
    Set writes = New Collection
    ManifestAdd writes, createdFile
    ManifestMergeUndo writes
    Set root("projectDirWrites") = writes
    ToolAddComponent = JsonStringify(root)
End Function

' (内部禁用路由说明 ruling 2 replacement): create the form
' through the IDE ITSELF. Two routes, IDE-first, no header synthesized by us:
'   1. the IDE's own Project > Add Form command (the IDE builds its own default
'      form; measured LIVE: 497 B / geometry 3015/120/465/4560 - our old
'      synthesized approximation was 3090/60/450/4680, i.e. a form the IDE would
'      never have produced);
'   2. last-resort fallback: the legacy synthesized .frm + AddFile below. It is
'      KEPT on purpose - removing it needs regression evidence and an S ruling -
'      and it stays gated by ProjectDirWritesKilled (ruling route 1 writes no file
'      at all, so that gate must not apply to it).
' outRoute reports which route ran: "ide_dialog" | "synthesized".
Private Function AddControlFormFile(ByVal proj As VBIDE.VBProject, ByVal name As String, ByRef outFile As String, ByRef outRoute As String) As VBIDE.VBComponent
    Dim compName As String
    compName = name
    If Len(compName) = 0 Then compName = NextFreeComponentName(proj, "Form")
    ' ---- route 1: the IDE creates the form (nothing written by us) ----------
    ' FIX-13: skipped for add_component(type=form) - that menu opens the template dialog.
    Dim ideComp As VBIDE.VBComponent
    If Not m_skipIdeFormMenu Then
        Set ideComp = CreateFormViaIdeMenu(proj, compName, outRoute)
        If Not ideComp Is Nothing Then
            outFile = ""                    ' the IDE owns the file; we wrote nothing
            Set AddControlFormFile = ideComp
            Exit Function
        End If
    End If
    ' ---- fallback: legacy synthesized .frm (unchanged gate) -----------------
    outRoute = "synthesized"
    ' this is the ONLY path that writes a file the caller did not name. Two facts
    ' pin down its gate: (1) it is reachable ONLY when the caller explicitly asked for a form
    ' (type="form") and VBComponents.Add(vbext_ct_MSForm) failed - measured LIVE on this machine
    ' (add_component {type:"form"} returns a "file"); a VB6 form IS a project member file, so
    ' there is no way to create one without writing <ProjectDir>\<name>.frm, and refusing it
    ' unconditionally would remove form creation altogether; (2) the .frm header / Begin..End
    ' layout block is synthesized by us - the route 内部禁用路由说明 ruling 2 vetoes.
    ' Gate therefore = the caller's explicit request is the opt-in, the receipt always names the
    ' file, the write is IMPOSSIBLE with no project directory (the old %TEMP% / "C:" fallback is
    ' gone: a project member file must live in the project) and the operator can kill it with
    ' VB6MCP_ALLOW_PROJECTDIR_WRITES=0 (ProjectDirWritesKilled).
    Dim dir As String
    dir = McpProjTools.ProjectDir(Me)
    If Len(dir) = 0 Then
        Err.Raise vbObjectError + 99, "CodeTools", "MCPREASON:project_dir_unavailable|" & _
            "save the project first (save_project with a path) and retry, or create the form in the IDE|" & _
            "the form fallback needs a project directory for the generated .frm and this project has no file on disk; nothing was written"
    End If
    If McpProjTools.ProjectDirWritesKilled(Me) Then
        Err.Raise vbObjectError + 101, "CodeTools", "MCPREASON:project_dir_write_not_allowed|" & _
            "unset the environment switch VB6MCP_ALLOW_PROJECTDIR_WRITES (it is 0/false/off in this VB6 process), or create the form in the IDE|" & _
            "the operator disabled project-directory writes, and creating a form through the AddFile fallback would write a generated .frm into the project directory; nothing was written"
    End If
    Dim full As String
    full = CtlJoinPath(dir, compName & ".frm")
    Dim n As Long
    n = 1
    Do While CtlFileExists(full)
        n = n + 1
        full = CtlJoinPath(dir, compName & CStr(n) & ".frm")
    Loop
    CtlWriteFile full, FormFileText(compName)
    Dim comp As VBIDE.VBComponent
    Set comp = proj.VBComponents.AddFile(full, False)
    outFile = full
    Set AddControlFormFile = comp
End Function

' the IDE's own "Add Form" command (Project menu, localized
' "添加窗体" / English "Add Form"). It opens the IDE's template chooser, whose
' confirm button is "&Open" - a caption close_active_dialogs deliberately does NOT
' whitelist, so that tool cannot dismiss this box.
' ★The box is MODAL and runs its own message loop. A tool call that opens it is
' suspended INSIDE that loop: its DoEvents never returns, so the code after it can
' never click the button. The click therefore comes from the add-in's watchdog tick
' (WinOps.WoConfirmTick, driven by ServerForm.tmrWatch -> WinOps.WheelTick), which
' the modal loop DOES dispatch. Sequence: arm -> execute the menu command -> pump
' (the tick clicks; the modal closes; the pump returns) -> read the component the
' IDE created back out of the project.
' Failure is honest: nothing is clicked unless it is a visible #32770 of OUR process
' with an enabled confirm button, and no dialog we did not open is ever touched.
Private Function CreateFormViaIdeMenu(ByVal proj As VBIDE.VBProject, ByVal compName As String, ByRef route As String) As VBIDE.VBComponent
    On Error GoTo Fail
    Dim t0 As Long
    t0 = GetTickCount()
    Dim namesBefore As String
    namesBefore = ComponentNameSet(proj)
    ' Refuses when a dialog of ours is already up (never press a button in a box this
    ' call did not open) - the caller then falls back and reports why.
    If Not WinOps.WoConfirmArm(15000) Then Exit Function
    Dim ctrl As Object
    Set ctrl = McpFindTools.FindBarControlDeep(Me, FormAddMenuCands())
    If ctrl Is Nothing Then
        WinOps.WoConfirmDisarm
        Exit Function
    End If
    Dim why As String
    If ExecIfEnabledWhy(ctrl, "add_form", why) = 0 Then
        WinOps.WoConfirmDisarm
        Exit Function
    End If
    ' Pump until the watchdog's click lands (bounded by the arm deadline; the tick
    ' also dismisses the box at the deadline, so this cannot spin forever).
    Do While GetTickCount() - t0 < 20000
        ' guarded - see Util.PumpGateBlocked.
        If CanPump() Then DoEvents
        MaybeHonorCancel
        If WinOps.WoConfirmClicked() Then Exit Do
        If Not WinOps.WoConfirmArmed() Then Exit Do
        Sleep 40
    Loop
    WinOps.WoConfirmDisarm
    ' The IDE creates and names the component itself: find it by name difference.
    Dim i As Long, nm As String
    For i = 1 To 30
        nm = NewComponentName(proj, namesBefore)
        If Len(nm) > 0 Then Exit For
        If CanPump() Then DoEvents
        Sleep 60
    Next i
    If Len(nm) = 0 Then Exit Function
    Dim c As VBIDE.VBComponent
    Set c = proj.VBComponents(nm)
    If c Is Nothing Then Exit Function
    If Len(compName) > 0 Then
        On Error Resume Next
        c.Name = compName
        Err.Clear
        On Error GoTo Fail
        ' The IDE builds the form as "Form1"; renaming the COMPONENT does not rewrite
        ' the two designer properties that default to the original name (measured LIVE:
        ' after c.Name = compName the .frm still said Caption="Form1" and
        ' LinkTopic="Form1" - the very defect this card fixes in the fallback). Set
        ' both through the IDE's OWN property model - exactly what a user does in the
        ' Properties window (measured: both accept the new value and the IDE writes it
        ' to the .frm) - so nothing about the header is synthesized by us.
        AlignNewFormName c, compName
    End If
    route = "ide_dialog"
    Set CreateFormViaIdeMenu = c
    Exit Function
Fail:
    WinOps.WoConfirmDisarm
    Err.Clear
End Function

' Caption and LinkTopic both default to the name the form had when the IDE created
' it, and VB6 does NOT update them when the component is renamed. Best effort: a
' property the designer does not expose is left alone (never fatal).
Private Sub AlignNewFormName(ByVal c As VBIDE.VBComponent, ByVal compName As String)
    On Error Resume Next
    Dim props As Object
    Set props = c.Properties
    If props Is Nothing Then Exit Sub
    SetFormDesignerProp props, "Caption", compName
    SetFormDesignerProp props, "LinkTopic", compName
    Err.Clear
End Sub

Private Sub SetFormDesignerProp(ByVal props As Object, ByVal propName As String, ByVal v As String)
    On Error Resume Next
    props(propName).Value = v
    Err.Clear
End Sub

' "添加窗体" / "Add Form" - caption candidates, because the menu bar and the item
' are localized and VB6 Ids are not unique enough to name a control on their own.
Private Function FormAddMenuCands() As String
    FormAddMenuCands = ChrW$(&H6DFB) & ChrW$(&H52A0) & ChrW$(&H7A97) & ChrW$(&H4F53) & "|Add Form"
End Function

' "|a|b|" membership set of the project's component names.
Private Function ComponentNameSet(ByVal proj As VBIDE.VBProject) As String
    On Error Resume Next
    Dim s As String, c As VBIDE.VBComponent
    s = "|"
    For Each c In proj.VBComponents
        s = s & c.Name & "|"
    Next
    ComponentNameSet = s
End Function

' The first component whose name is NOT in beforeSet (the IDE named it).
Private Function NewComponentName(ByVal proj As VBIDE.VBProject, ByVal beforeSet As String) As String
    On Error Resume Next
    Dim c As VBIDE.VBComponent
    For Each c In proj.VBComponents
        If InStr(1, beforeSet, "|" & c.Name & "|", vbTextCompare) = 0 Then
            NewComponentName = c.Name
            Exit Function
        End If
    Next
End Function

Private Function NextFreeComponentName(ByVal proj As VBIDE.VBProject, ByVal stem As String) As String
    Dim n As Long
    Dim c As VBIDE.VBComponent
    Dim candidate As String
    Dim taken As Boolean
    n = 1
    Do
        candidate = stem & CStr(n)
        taken = False
        For Each c In proj.VBComponents
            If StrComp(c.Name, candidate, vbTextCompare) = 0 Then
                taken = True
                Exit For
            End If
        Next
        If Not taken Then
            NextFreeComponentName = candidate
            Exit Function
        End If
        n = n + 1
    Loop
End Function

' LAST-RESORT synthesized .frm text (kept it as a fallback: the IDE
' route above is the normal path now). Two defects fixed here:
'   (1) LinkTopic was hard-coded "Form1" regardless of compName - VB6 writes the
'       form's OWN name (measured: the IDE's new Form1.frm has LinkTopic="Form1";
'       our own SettingsForm.frm still carries the bogus "Form1" from this line);
'   (2) the geometry was a hard-coded approximation the IDE never produces
'       (3090/60/450/4680) - it is now the IDE's REAL default for a new form,
'       measured byte-for-byte from an IDE-generated Form1.frm:
'       ClientHeight=3015 ClientLeft=120 ClientTop=465 ClientWidth=4560.
Private Function FormFileText(ByVal compName As String) As String
    Dim s As String
    s = "VERSION 5.00" & vbCrLf
    s = s & "Begin VB.Form " & compName & " " & vbCrLf
    s = s & "   Caption         =   """ & compName & """" & vbCrLf
    s = s & "   ClientHeight    =   3015" & vbCrLf
    s = s & "   ClientLeft      =   120" & vbCrLf
    s = s & "   ClientTop       =   465" & vbCrLf
    s = s & "   ClientWidth     =   4560" & vbCrLf
    s = s & "   LinkTopic       =   """ & compName & """" & vbCrLf
    s = s & "   ScaleHeight     =   3015" & vbCrLf
    s = s & "   ScaleWidth      =   4560" & vbCrLf
    s = s & "   StartUpPosition =   3  'Windows Default" & vbCrLf
    s = s & "End" & vbCrLf
    s = s & "Attribute VB_Name = """ & compName & """" & vbCrLf
    s = s & "Attribute VB_GlobalNameSpace = False" & vbCrLf
    s = s & "Attribute VB_Creatable = False" & vbCrLf
    s = s & "Attribute VB_PredeclaredId = True" & vbCrLf
    s = s & "Attribute VB_Exposed = False" & vbCrLf
    FormFileText = s
End Function

Public Function CtlJoinPath(ByVal dir As String, ByVal leaf As String) As String
    If Len(dir) = 0 Then
        CtlJoinPath = leaf
    ElseIf Right$(dir, 1) = "\" Then
        CtlJoinPath = dir & leaf
    Else
        CtlJoinPath = dir & "\" & leaf
    End If
End Function

Public Function CtlFileExists(ByVal path As String) As Boolean
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    CtlFileExists = fso.FileExists(path)
End Function

Private Sub CtlWriteFile(ByVal path As String, ByVal text As String)
    Dim fnum As Integer
    fnum = FreeFile
    Open path For Output As #fnum
    Print #fnum, text;
    Close #fnum
    ' remaining: the caller reports the synthesized file as written, so PROVE it.
    Dim cb() As Byte
    Encoding.ReadAllBytesTo path, cb
    If Encoding.ByteCount(cb) <= 0 And Len(text) > 0 Then
        Err.Raise vbObjectError + 85, "CodeTools", "the synthesized file " & path & " is missing or empty after writing - refusing to report it as written"
    End If
End Sub

Private Function ToolRemoveComponent(ByVal name As String) As String
    ' item 5, VARIANT (a) = REPORT, DO NOT DELETE.
    ' An earlier measurement found that VBComponents.Remove writes <ProjectDir>\<name><ext> on its way
    ' out while the receipt said only "removed", so a caller could not tell that a file had
    ' appeared. Variant (b) (delete that file) would make the frozen description's
    ' "the IDE will ask about the file" false and would need a second description change,
    ' so this card takes variant (a): the receipt NAMES what was left behind and the
    ' additive sideEffects block repeats it. Nothing is deleted.
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    Dim boundFile As String
    boundFile = ""
    On Error Resume Next
    boundFile = comp.FileNames(1)
    If Err.Number <> 0 Then
        Err.Clear
        boundFile = ""
    End If
    On Error GoTo 0
    Dim proj As VBIDE.VBProject
    Set proj = GetProject()
    proj.VBComponents.Remove comp
    Dim afterFile As String
    afterFile = ""
    On Error Resume Next
    If Len(boundFile) > 0 Then
        If Dir$(boundFile) <> "" Then afterFile = boundFile
    End If
    If Err.Number <> 0 Then Err.Clear
    On Error GoTo 0
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("removed") = name
    root("removedFile") = afterFile
    If Len(afterFile) > 0 Then
        root("removedFileNote") = "VBComponents.Remove left this file in the project directory; it was NOT deleted (the component's source is preserved)."
    End If
    Dim writes As Object
    Set writes = New Collection
    ManifestAdd writes, afterFile
    ManifestMergeUndo writes
    Set root("projectDirWrites") = writes
    SeNoteRemoved name
    ToolRemoveComponent = JsonStringify(root)
End Function

Private Function ToolImportComponent(ByVal path As String, ByVal mode As String) As String
    ' importing must NEVER write back to the file the caller gave us.
    ' VBComponents.AddFile binds the new component's file to that path, so a later save
    ' of the component overwrites the caller's source - this is how a real source file
    ' was silently replaced by a 31-byte "Attribute VB_Name = Module1" stub. We now
    ' re-point the component at a PROJECT-LOCAL copy immediately, verify the component
    ' carries the file's real code, snapshot the source only when it is WRITABLE, and
    ' verify the caller's file is byte-identical afterwards (restoring it if not).
    ' A READ-ONLY source stays importable (ruling A) and leaves no .bak behind.
    ' tightens this to a testable INVARIANT: on return NO component may still be
    ' bound to the caller's path (see (b) below), because a merely-later save would otherwise
    ' destroy the source after this method has already verified it.
    Dim full As String
    full = ResolvePath(path)
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FileExists(full) Then Err.Raise vbObjectError + 48, "CodeTools", "File not found: " & full
    ' ============ (DATA-LOSS level): refuse BEFORE ANY side effect ==========
    ' Measured on AFAC95AF (an earlier verification, reproduced TWICE): importing a .bas whose
    ' "Attribute VB_Name" equals an EXISTING component does not raise - VB6 creates an extra
    ' default-named component (Module1) still bound to the caller's path, SaveAs then writes
    ' <ProjectDir>\<name><ext> and REBINDS the pre-existing component to that file, the
    ' component set collapses (213 -> 8..9) and the IDE exits by itself ~63 s later.
    ' There was NO same-name check anywhere in this source. The 60059 that saw is VB6's
    ' OWN AddFile error for a path that is ALREADY a project member: it fires only for a repeat
    ' import of the SAME path and never covered the same-NAME / different-path case.
    ' Both refusals sit HERE - after ResolvePath/FileExists and BEFORE the writable-source
    ' snapshot (FreeBackupPath below), before AddFile and before SaveAs - so a refusal leaves
    ' NOTHING behind: no <file>.mcpimport.bak next to the caller's file, no new file in the
    ' project directory, no component added and no component rebound.
    Dim pj0 As VBIDE.VBProject
    Set pj0 = GetProject()
    ' a project-LOCAL copy needs a project DIRECTORY. When the IDE holds a project
    ' that has never been saved, ProjectDir() is empty; FreeImportPath used to fall back to
    ' App.Path and the copy landed in the add-in's own directory (product directory). Refuse
    ' HERE - after ResolvePath/FileExists and BEFORE the writable-source snapshot, AddFile and
    ' SaveAs - so the refusal has no side effect at all.
    Dim pd0 As String
    pd0 = McpProjTools.ProjectDir(Me)
    If Len(pd0) = 0 Then
        Err.Raise vbObjectError + 98, "CodeTools", "MCPREASON:project_dir_unavailable|" & _
            "save the project first (save_project with a path) so the import has a project directory for its project-local copy|" & _
            "the open project has no file on disk, so there is no project directory to put the project-local copy in. Refused BEFORE the source snapshot, before AddFile and before SaveAs: nothing is written next to the source file, into the project directory or into the add-in's own directory."
    End If
    Dim declaredName As String
    declaredName = DeclaredComponentName(full)
    If Len(declaredName) = 0 Then
        ' No Attribute VB_Name in the head (e.g. a code-only .bas): VB6 then names the new
        ' component after the FILE, so the file's base name is the name that can collide.
        Dim bp0 As Long
        bp0 = InStrRev(full, "\")
        declaredName = Mid$(full, bp0 + 1)
        bp0 = InStrRev(declaredName, ".")
        If bp0 > 1 Then declaredName = Left$(declaredName, bp0 - 1)
    End If
    Dim ec As VBIDE.VBComponent
    Dim ecName As String, pathOwner As String, ef As String
    ecName = ""
    pathOwner = ""
    For Each ec In pj0.VBComponents
        MaybePump
        If Len(ecName) = 0 And Len(declaredName) > 0 Then
            If LCase$(ec.Name) = LCase$(declaredName) Then ecName = ec.Name
        End If
        If Len(pathOwner) = 0 Then
            ef = ComponentFilePath(ec)
            If Len(ef) > 0 Then
                If LCase$(ef) = LCase$(full) Then pathOwner = ec.Name
            End If
        End If
        If Len(ecName) > 0 And Len(pathOwner) > 0 Then Exit For
    Next
    If Len(pathOwner) > 0 Then
        Err.Raise vbObjectError + 97, "CodeTools", "MCPREASON:import_path_is_member|" & pathOwner & "|" & "this file is already the source of component '" & pathOwner & "'; edit that component with replace_code / edit_by_anchor / apply_edits instead of importing the file again"
    End If
    If Len(ecName) > 0 Then
        Err.Raise vbObjectError + 96, "CodeTools", "MCPREASON:name_collision|" & ecName & "|" & "a component named '" & ecName & "' already exists and the incoming file declares Attribute VB_Name = """ & declaredName & """. Rename one of them, delete the existing component first, or edit the existing component with replace_code / edit_by_anchor / apply_edits"
    End If
    ' ============ end pre-check ============================================
    ' ruling A: a READ-ONLY source is LEGAL and must stay importable (CD,
    ' archive, read-only share). We never write it anyway. A snapshot is made ONLY when the
    ' source is WRITABLE - only then could a restore ever be needed - so a read-only medium
    ' is never asked to hold a .bak and no extra file is left behind there.
    Dim shaBefore As String
    shaBefore = Build.FileSha256(full)
    Dim canWrite As Boolean, backup As String, haveBackup As Boolean
    canWrite = ((fso.GetFile(full).Attributes And 1) = 0)
    haveBackup = False
    backup = ""
    If canWrite Then
        backup = FreeBackupPath(fso, full)
        On Error Resume Next
        fso.CopyFile full, backup, True
        If Err.Number = 0 Then haveBackup = True Else Err.Clear
        On Error GoTo 0
    End If
    Dim comp As VBIDE.VBComponent
    Dim proj As VBIDE.VBProject
    Set proj = GetProject()
    ' AddFile itself can refuse (VB6 error 60059: the path is ALREADY a project
    ' member - the observation). That refusal happens AFTER the writable-source snapshot,
    ' so the snapshot file used to be left behind next to the caller's file. Drop it here and
    ' re-raise the ORIGINAL VB error, so the envelope stays exactly the unexpected_error shape
    ' it always was while the refusal stops leaving a residue.
    Dim addErrNum As Long, addErrDesc As String
    addErrNum = 0
    addErrDesc = ""
    On Error Resume Next
    If LCase$(mode) = "template" Then
        Set comp = proj.VBComponents.AddFromTemplate(full)
    Else
        Set comp = proj.VBComponents.AddFile(full, False)
    End If
    addErrNum = Err.Number
    addErrDesc = Err.Description
    Err.Clear
    On Error GoTo 0
    If addErrNum <> 0 Then
        If Len(backup) > 0 Then
            On Error Resume Next
            If fso.FileExists(backup) Then fso.DeleteFile backup, True
            On Error GoTo 0
        End If
        Err.Raise addErrNum, "CodeTools", addErrDesc
    End If
    ' (b) INVARIANT: on return NO component may still be bound to the caller's
    ' source path. rebound only the component AddFile returned; when the project
    ' already has a component with the SAME NAME (from a different file) VB6 creates an
    ' ADDITIONAL default-named component (Module1) that keeps the binding and later overwrites
    ' the source - AFTER this method verified the sha. Rebind EVERY bound component, then VERIFY.
    ' The whole block runs under On Error Resume Next: a runtime error from a VBIDE call must
    ' never be able to skip the verification (that is exactly how error 5 escaped before).
    Dim newPath As String, rebindErr As String, loopErr As String
    rebindErr = ""
    loopErr = ""
    newPath = ""
    Dim rebound As Long, stillBound As Long, bNames As String
    rebound = 0
    stillBound = 0
    bNames = ""
    Dim createdCnt As Long, reboundList As String, saveAsErr As String
    createdCnt = 0
    reboundList = ""
    Dim pass As Long, c2 As VBIDE.VBComponent, fn As String, rp As String, j As Long
    ' every file THIS call creates via SaveAs is remembered here so the refusal
    ' path can remove it again (the reject path used to restore only the CALLER's file and left
    ' <ProjectDir>\<name><ext> on disk - exactly the stray file that verification found).
    Dim madePaths As Collection
    Set madePaths = New Collection
    On Error Resume Next
    For pass = 1 To 2
        For j = 1 To proj.VBComponents.Count
            MaybePump
            Err.Clear
            Set c2 = proj.VBComponents(j)
            fn = ""
            If Not c2 Is Nothing Then fn = c2.FileNames(1)
            If Err.Number <> 0 Then
                If Len(loopErr) = 0 Then loopErr = "scan " & CStr(Err.Number) & ": " & Err.Description
                Err.Clear
            End If
            If Len(fn) > 0 Then
                If LCase$(fn) = LCase$(full) Then
                    If pass = 1 Then createdCnt = createdCnt + 1
                    rp = FreeImportPath(fso, c2.Name, full)
                    If Err.Number <> 0 Then
                        If Len(loopErr) = 0 Then loopErr = "path " & CStr(Err.Number) & ": " & Err.Description
                        Err.Clear
                        rp = ""
                    End If
                    If Len(rp) > 0 Then
                        c2.SaveAs rp
                        saveAsErr = ""
                        If Err.Number <> 0 Then
                            saveAsErr = CStr(Err.Number) & ": " & Err.Description
                            Err.Clear
                        End If
                        ' SaveAs can still raise VB error 5 AFTER it has in fact
                        ' re-pathed the component (measured on every fixture: code and 1.2 MB
                        ' alike), so the SUCCESS signal is the BINDING itself, not Err. A
                        ' component that truly could not be re-pathed is still bound to the
                        ' caller path, and the invariant scan below refuses on stillBound > 0.
                        fn = ""
                        Err.Clear
                        fn = c2.FileNames(1)
                        If Err.Number <> 0 Then Err.Clear
                        If Len(fn) > 0 And LCase$(fn) <> LCase$(full) Then
                            rebound = rebound + 1
                            madePaths.Add fn
                            If Len(reboundList) < 400 Then reboundList = reboundList & c2.Name & "=" & fn & "; "
                            If Not comp Is Nothing Then
                                If LCase$(c2.Name) = LCase$(comp.Name) Then newPath = rp
                            End If
                        ElseIf Len(rebindErr) = 0 Then
                            rebindErr = c2.Name & ": the binding still points at the source path"
                            If Len(saveAsErr) > 0 Then rebindErr = rebindErr & " (SaveAs " & saveAsErr & ")"
                        End If
                    End If
                End If
            End If
        Next
    Next
    ' the invariant scan must ALWAYS run
    For j = 1 To proj.VBComponents.Count
        MaybePump
        Err.Clear
        Set c2 = proj.VBComponents(j)
        fn = ""
        If Not c2 Is Nothing Then fn = c2.FileNames(1)
        If Err.Number <> 0 Then Err.Clear
        If Len(fn) > 0 Then
            If LCase$(fn) = LCase$(full) Then
                stillBound = stillBound + 1
                If Len(bNames) < 120 Then bNames = bNames & c2.Name & " "
            End If
        End If
    Next
    On Error GoTo 0
    If stillBound > 0 Then
        If haveBackup Then
            On Error Resume Next
            fso.CopyFile backup, full, True
            On Error GoTo 0
        End If
        If Len(backup) > 0 Then
            On Error Resume Next
            If fso.FileExists(backup) Then fso.DeleteFile backup, True
            On Error GoTo 0
        End If
        ' this refusal is reached AFTER SaveAs, so the file(s) this call created in
        ' the PROJECT DIRECTORY must go too, otherwise a refusal still leaves a stray
        ' <ProjectDir>\<name><ext> behind (a static finding; the on-disk reproduction saw it).
        Dim mk As Long
        On Error Resume Next
        For mk = 1 To madePaths.Count
            If fso.FileExists(madePaths(mk)) Then fso.DeleteFile madePaths(mk), True
        Next
        On Error GoTo 0
        Err.Raise vbObjectError + 54, "CodeTools", "import refused: " & CStr(stillBound) & " component(s) are still bound to the source path (" & bNames & "); rebind failed (" & rebindErr & ") " & loopErr & ". The source was restored from the snapshot and nothing was left bound."
    End If
    If Len(newPath) = 0 Then
        On Error Resume Next
        If Not comp Is Nothing Then newPath = comp.FileNames(1)
        On Error GoTo 0
    End If
    ' (a) the component must carry the file's REAL code (AddFile can mis-parse a
    ' non-ASCII file and leave an empty module).: (a) must NEVER be able to
    ' abort this function. CompText does "cm.Lines(1, cm.CountOfLines)", and the
    ' default-named module VB6 creates on a NAME collision is EMPTY (CountOfLines = 0),
    ' so "Lines(1, 0)" raises VB error 5. That raise used to escape from here BEFORE (c)
    ' ran, so the sha verify + restore never executed and the clobbered source stayed
    ' clobbered. A read failure is now DEFERRED to the end (after (c) has restored).
    Dim payload As String, wantCode As String, gotCode As String
    Dim codeFromFile As Boolean, readFailed As Boolean
    codeFromFile = True
    readFailed = False
    On Error Resume Next
    payload = Build.ReadLogAnsi(full)
    If Err.Number <> 0 Then
        readFailed = True
        Err.Clear
    End If
    On Error GoTo 0
    If Not readFailed Then
        On Error Resume Next
        ' item 1 (S1): the text handed to SetCompTextMinimal is now the
        ' STRUCTURAL head-stripped body, not NormalizeCode(payload). NormalizeCode only
        ' removes "Attribute " lines, so the .cls VERSION/BEGIN..END designer block and
        ' the .frm Begin..End block used to be written INTO the code pane (an earlier batch
        ' measured it on both .cls and code-bearing .frm). The COMPARISON still uses
        ' NormalizeCode, so the caliber of the comparison itself is unchanged.
        Dim wantCaliber As String
        wantCaliber = "unknown"
        wantCode = StrippedDiskText(payload, SafeCompText(comp.Name), True, wantCaliber)
        gotCode = NormalizeCode(CompText(comp.Name))
        If Err.Number <> 0 Then
            ' could not compare (empty module, ...): report "not proven to come from the
            ' file" instead of aborting the function before (c) ran.
            Err.Clear
            codeFromFile = False
        ElseIf wantCaliber <> "ok" Then
            ' item 3 failure safety, declared by the earlier spec (section 1.3
            ' and section 5): the split could not be reconciled with the pane (empty pane,
            ' head-only file). We do not guess - nothing is written, the receipt says the
            ' component is NOT proven to carry the file's code, and (c) still verifies the
            ' caller's file. Declared behaviour change: an empty pane is no longer
            ' "repaired" with the file's designer head.
            codeFromFile = False
        Else
            If NormalizeCode(wantCode) <> gotCode Then
                ' incremental write instead of delete-all + insert-all.
                SetCompTextMinimal comp.Name, CompText(comp.Name), wantCode
                If Err.Number <> 0 Then Err.Clear
                codeFromFile = False
            End If
        End If
        On Error GoTo 0
    End If
    ' (c) the caller's file must be byte-identical; restore from the snapshot if not
    Dim shaAfter As String, restored As Boolean
    restored = False
    shaAfter = Build.FileSha256(full)
    If shaAfter <> shaBefore Then
        If haveBackup Then
            On Error Resume Next
            fso.CopyFile backup, full, True
            On Error GoTo 0
            shaAfter = Build.FileSha256(full)
            ' remaining: the restore is PROVEN, not assumed - only the pre-call
            ' digest counts as restored (a copy that did not land is reported as such).
            restored = (Len(shaAfter) > 0 And shaAfter = shaBefore)
        End If
    End If
    If haveBackup Then
        On Error Resume Next
        If fso.FileExists(backup) Then fso.DeleteFile backup, True
        On Error GoTo 0
    End If
    ' this is the ONLY hard error, and it is raised HERE - after (c) has
    ' verified/restored the caller's file and dropped the snapshot - so even a source
    ' that cannot be read leaves no clobbered file and no .bak behind.
    If readFailed Then
        Err.Raise vbObjectError + 52, "CodeTools", "cannot READ the source file (it may be missing, locked, or not text): " & full
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("imported") = comp.Name
    SeNoteCreated comp.Name
    root("type") = ComponentTypeName(comp.Type)
    root("sourceFile") = full
    root("sourceFileSha256Before") = shaBefore
    root("sourceFileSha256After") = shaAfter
    root("sourceFileUnchanged") = (shaAfter = shaBefore)
    root("sourceFileRestored") = restored
    root("sourceWritable") = canWrite
    If Len(backup) > 0 Then root("snapshotFile") = backup
    root("componentFile") = newPath
    root("componentsRebound") = rebound
    root("componentsStillBound") = stillBound
    root("componentsCreated") = createdCnt
    ' the write manifest is ALWAYS present (empty array when the call wrote no
    ' file) so that a caller can decide from the receipt alone instead of guessing what the
    ' tool left behind. Every path here is a SaveAs target that rebinds the new component off
    ' the caller's file, so by construction it lives INSIDE the project directory.
    Dim pdw As Object
    Set pdw = New Collection
    Dim mk2 As Long
    On Error Resume Next
    For mk2 = 1 To madePaths.Count
        ManifestAdd pdw, madePaths(mk2)
    Next
    On Error GoTo 0
    ManifestMergeUndo pdw
    Set root("projectDirWrites") = pdw
    If Len(reboundList) > 0 Then root("componentsReboundFiles") = reboundList
    If Len(rebindErr) > 0 Then root("componentRebindError") = rebindErr
    root("codeFromFile") = codeFromFile
    root("note") = "import is READ-ONLY with respect to the file you passed: the component is bound to a project-local copy and the source file's sha256 is verified (and restored from a snapshot) afterwards"
    ToolImportComponent = JsonStringify(root)
End Function

' a free project-local path for a freshly imported component, keeping the
' caller's extension. Never returns the caller's own path.
' ruling B: never overwrite a user's existing <file>.mcpimport.bak; take the
' next numbered name instead and say so in the receipt.
Private Function FreeBackupPath(ByVal fso As Object, ByVal originalFull As String) As String
    Dim base As String, cand As String, n As Long
    base = originalFull & ".mcpimport.bak"
    cand = base
    n = 0
    Do While fso.FileExists(cand)
        n = n + 1
        cand = base & "." & CStr(n)
    Loop
    FreeBackupPath = cand
End Function

' write ONLY the changed range instead of SetCompText's delete-the-whole-
' module + insert-the-whole-module. SetCompText was measured at ~15.7 s on a 27,000-line /
' 1.2 MB module (two whole-module reformats), while replace_code's one-range write is 0 ms.
' The common prefix/suffix are found with the same algorithm ChangedRegion uses, so the
' resulting pane text is identical to writing the whole text - just two CM calls at most.
Public Function SetCompTextMinimal(ByVal name As String, ByVal before As String, ByVal after As String, Optional ByVal snapshotAlreadyTaken As Boolean = False) As Long
    ' a small edit far from the other end of the module used to collapse
    ' into ONE block spanning 'first difference .. last difference', and a single CM
    ' block costs t ~ k*s^2 (measured 8,438 ms for 26,999 lines). The change is now
    ' decomposed into line-level hunks and each hunk is written on its own (<=1
    ' DeleteLines + <=1 InsertLines). The resulting pane is byte-identical.
    ' Invariants: hunk count <= MAX_HUNKS; no hunk larger than the single-block span;
    ' anything else falls back to the original single minimal block and the receipt
    ' says so (hunks=1).
    ' the per-call receipt state is reset FIRST, so the two early exits
    ' below (missing component / missing code module) can no longer leave the PREVIOUS
    ' call's hunks and write phases readable by the caller.
    m_lastWriteHunks = 0
    m_lastDiffMs = 0
    m_lastJoinMs = 0
    m_lastDelMs = 0
    m_lastInsMs = 0
    m_lastMaxBlock = 0
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    If comp Is Nothing Then Exit Function
    Dim cm As VBIDE.CodeModule
    Set cm = comp.CodeModule
    If cm Is Nothing Then Exit Function
    Dim writes As Long
    writes = 0
    Dim tPh As Long
    tPh = GetTickCount()
    Dim a() As String, b() As String, na As Long, nb As Long, pre As Long, suf As Long, i As Long
    a = McpCls.TextLines(Me, before)
    b = McpCls.TextLines(Me, after)
    na = UBound(a) + 1
    nb = UBound(b) + 1
    pre = 0
    Do While pre < na And pre < nb
        MaybePump
        If a(pre) <> b(pre) Then Exit Do
        pre = pre + 1
    Loop
    suf = 0
    Do While suf < (na - pre) And suf < (nb - pre)
        MaybePump
        If a(na - 1 - suf) <> b(nb - 1 - suf) Then Exit Do
        suf = suf + 1
    Loop
    Dim delCount As Long, insCount As Long
    delCount = na - pre - suf
    If delCount < 0 Then delCount = 0
    insCount = nb - pre - suf
    If insCount < 0 Then insCount = 0
    m_lastJoinMs = m_lastJoinMs + (GetTickCount() - tPh)
    If delCount = 0 And insCount = 0 Then Exit Function
    ' (P8): snapshot the PRE-WRITE pane text just before the change lands, so
    ' undo_edit has something to restore. Never fatal, and disabled together with every
    ' other project-directory write (ProjectDirWritesKilled).
    ' an opt-in caller may have taken the snapshot itself (it is the only way
    ' the raw replace_code branches get one); in that case this funnel must NOT write a
    ' second, identical file. Default False keeps every existing caller byte-for-byte.
    If Not snapshotAlreadyTaken Then UndoSnapshot name, before
    Dim hs() As Long, nh As Long, h As Long
    Dim ok As Boolean
    nh = 0
    ReDim hs(0 To MAX_HUNKS * 4 - 1)
    tPh = GetTickCount()
    ok = HunkDiff(a, b, pre, na - suf, pre, nb - suf, hs, nh)
    If ok And nh >= 2 Then
        ' validate EVERY hunk BEFORE the first write: once a hunk is applied a
        ' fallback could no longer reproduce the original pane.
        Dim ax As Long, ac As Long, bx As Long, bc As Long
        For h = 0 To nh - 1
            ax = hs(h * 4 + 0)
            ac = hs(h * 4 + 1)
            bx = hs(h * 4 + 2)
            bc = hs(h * 4 + 3)
            If ac > delCount Then ok = False
            If bc > insCount Then ok = False
            If ax < 0 Or ax + ac > na Then ok = False
            If bx < 0 Or bx + bc > nb Then ok = False
        Next
    Else
        ok = False
    End If
    m_lastDiffMs = m_lastDiffMs + (GetTickCount() - tPh)
    If ok Then
        For h = nh - 1 To 0 Step -1
            ax = hs(h * 4 + 0)
            ac = hs(h * 4 + 1)
            bx = hs(h * 4 + 2)
            bc = hs(h * 4 + 3)
            If ac > 0 Then
                tPh = GetTickCount()
                cm.DeleteLines ax + 1, ac
                m_lastDelMs = m_lastDelMs + (GetTickCount() - tPh)
                writes = writes + 1
                If ac > m_lastMaxBlock Then m_lastMaxBlock = ac
            End If
            If bc > 0 Then
                Dim blk() As String
                ReDim blk(0 To bc - 1)
                Dim q As Long
                tPh = GetTickCount()
                For q = 0 To bc - 1
                    MaybePump
                    blk(q) = b(bx + q)
                Next
                Dim blkText As String
                blkText = Join(blk, vbCrLf)
                m_lastJoinMs = m_lastJoinMs + (GetTickCount() - tPh)
                tPh = GetTickCount()
                cm.InsertLines ax + 1, blkText
                m_lastInsMs = m_lastInsMs + (GetTickCount() - tPh)
                writes = writes + 1
                If bc > m_lastMaxBlock Then m_lastMaxBlock = bc
            End If
            MaybePump
        Next
        m_lastWriteHunks = nh
        SetCompTextMinimal = writes
        Exit Function
    End If
    ' ---- fallback: the pre- single minimal block (writeCalls <= 2)
    writes = 0
    m_lastWriteHunks = 1
    If delCount > 0 Then
        tPh = GetTickCount()
        cm.DeleteLines pre + 1, delCount
        m_lastDelMs = m_lastDelMs + (GetTickCount() - tPh)
        writes = writes + 1
        If delCount > m_lastMaxBlock Then m_lastMaxBlock = delCount
    End If
    If insCount > 0 Then
        Dim blkF() As String
        ReDim blkF(0 To insCount - 1)
        tPh = GetTickCount()
        For i = 0 To insCount - 1
            MaybePump
            blkF(i) = b(pre + i)
        Next
        Dim blkFText As String
        blkFText = Join(blkF, vbCrLf)
        m_lastJoinMs = m_lastJoinMs + (GetTickCount() - tPh)
        tPh = GetTickCount()
        cm.InsertLines pre + 1, blkFText
        m_lastInsMs = m_lastInsMs + (GetTickCount() - tPh)
        writes = writes + 1
        If insCount > m_lastMaxBlock Then m_lastMaxBlock = insCount
    End If
    SetCompTextMinimal = writes
End Function

' publish the per-phase timings of the last write into a receipt.
' Pure addition: writeMs/writeCalls/hunks keep their exact meaning. phaseNote
' spells out what each interval covers so no cause is read into a measurement.
Private Sub AddWritePhases(ByRef d As Object)
    d("diffMs") = m_lastDiffMs
    d("joinMs") = m_lastJoinMs
    d("delMs") = m_lastDelMs
    d("insMs") = m_lastInsMs
    d("maxBlockLines") = m_lastMaxBlock
    d("phaseNote") = "measured intervals of the LAST write of THIS call: diffMs=hunk generation+validation; joinMs=the rest of our own preparation (line split, common prefix/suffix scan, block build, Join); delMs/insMs=time inside the CodeModule calls; maxBlockLines=largest number of lines in one CodeModule call. writeMs/writeCalls/hunks keep their existing meaning"
End Sub

' recursive line diff. Regions are trimmed by their common prefix and
' suffix first; a region that still differs is split at a line that is UNIQUE on
' both sides (the longest such line wins), then the two halves are diffed again.
' A region with no anchor becomes one hunk. Returns False at the hunk cap so the
' caller falls back to the single-block writer.
Private Function HunkDiff(ByRef a() As String, ByRef b() As String, ByVal alo As Long, ByVal ahi As Long, _
                          ByVal blo As Long, ByVal bhi As Long, ByRef hs() As Long, ByRef nh As Long) As Boolean
    Do While alo < ahi And blo < bhi
        MaybePump
        If a(alo) <> b(blo) Then Exit Do
        alo = alo + 1
        blo = blo + 1
    Loop
    Do While ahi > alo And bhi > blo
        MaybePump
        If a(ahi - 1) <> b(bhi - 1) Then Exit Do
        ahi = ahi - 1
        bhi = bhi - 1
    Loop
    If alo = ahi And blo = bhi Then
        HunkDiff = True
        Exit Function
    End If
    Dim ai As Long, bi As Long
    If McpFindTools.FindAnchor(Me, a, b, alo, ahi, blo, bhi, ai, bi) Then
        If Not HunkDiff(a, b, alo, ai, blo, bi, hs, nh) Then Exit Function
        If Not HunkDiff(a, b, ai + 1, ahi, bi + 1, bhi, hs, nh) Then Exit Function
        HunkDiff = True
        Exit Function
    End If
    If nh >= MAX_HUNKS Then Exit Function
    hs(nh * 4 + 0) = alo
    hs(nh * 4 + 1) = ahi - alo
    hs(nh * 4 + 2) = blo
    hs(nh * 4 + 3) = bhi - blo
    nh = nh + 1
    HunkDiff = True
End Function

' the longest line that occurs exactly once on BOTH sides of the region.

' the component name a file DECLARES, read from the file head, "" when absent.
' .bas/.cls keep "Attribute VB_Name" in the HEADER; a designer file (.frm/.ctl/.dsr) carries
' its name on the "Begin VB.Form <Name>" line instead - its Attribute block lives at the TAIL
' of the file, so a header-only scan would silently miss every form.
Private Function DeclaredComponentName(ByVal full As String) As String
    Dim f As Integer, i As Long, ln As String, s As String
    Dim q1 As Long, q2 As Long
    DeclaredComponentName = ""
    On Error Resume Next
    f = FreeFile
    Open full For Input As #f
    If Err.Number <> 0 Then
        Err.Clear
        On Error GoTo 0
        Exit Function
    End If
    For i = 1 To 60
        If EOF(f) Then Exit For
        Line Input #f, ln
        If InStr(1, ln, "Attribute VB_Name", vbTextCompare) > 0 Then
            q1 = InStr(ln, Chr$(34))
            If q1 > 0 Then
                q2 = InStr(q1 + 1, ln, Chr$(34))
                If q2 > q1 Then DeclaredComponentName = Mid$(ln, q1 + 1, q2 - q1 - 1)
            End If
            Exit For
        End If
        If InStr(1, ln, "Begin VB.", vbTextCompare) > 0 Then
            s = Trim$(ln)
            q1 = InStrRev(s, " ")
            If q1 > 0 Then s = Trim$(Mid$(s, q1 + 1)) Else s = ""
            If Len(s) > 0 And InStr(s, "=") = 0 And InStr(s, Chr$(34)) = 0 Then DeclaredComponentName = s
            Exit For
        End If
    Next
    Close #f
    On Error GoTo 0
End Function

' the file a component is bound to, or "" when it cannot be read. FileNames(1)
' raises for some component kinds and in a busy IDE; a failed read must never abort the scan.
Private Function ComponentFilePath(ByVal comp As VBIDE.VBComponent) As String
    Dim s As String
    ComponentFilePath = ""
    If comp Is Nothing Then Exit Function
    On Error Resume Next
    s = comp.FileNames(1)
    If Err.Number <> 0 Then
        Err.Clear
        s = ""
    End If
    On Error GoTo 0
    ComponentFilePath = s
End Function

Private Function FreeImportPath(ByVal fso As Object, ByVal compName As String, ByVal originalFull As String) As String
    ' there is NO App.Path fallback here any more. ProjectDir() is empty when the
    ' IDE holds no project OR a project that has never been saved, and the old
    ' "If Len(d) = 0 Then d = App.Path" then wrote the import's project-local copy into the
    ' ADD-IN'S OWN directory - measured by as "<product dir>\Module1.bas" (183 B,
    ' archived at 内部工作区). The caller refuses before any
    ' side effect (see the project-dir guard in ToolImportComponent); returning "" here keeps
    ' the SaveAs step unreachable even if that guard were ever bypassed, because every caller
    ' tests Len(rp) > 0.
    Dim d As String, ext As String, p As Long, base As String, cand As String, n As Long
    d = McpProjTools.ProjectDir(Me)
    If Len(d) = 0 Then Exit Function
    p = InStrRev(originalFull, ".")
    If p > 0 Then ext = Mid$(originalFull, p) Else ext = ".bas"
    base = d & "\" & compName
    cand = base & ext
    n = 1
    Do While fso.FileExists(cand)
        n = n + 1
        cand = base & "_" & CStr(n) & ext
    Loop
    FreeImportPath = cand
End Function

' operator switch for writes that put a file into the project directory on behalf
' of the caller. It is an environment switch and NOT a tool parameter, so the tool face and
' every inputSchema stay untouched (no re-freeze); it is read in the VB6 process because the
' add-in runs in-process in VB6.EXE.
' Semantics: unset / 1 / true / yes / on = allowed (the caller's explicit request is the
' opt-in: only "add_component {type:\"form\"}" can ever reach the writing path); 0 / false /
' no / off = REFUSED, which is what a read-only or audit setup wants.

' build the "projectDirWrites" write manifest. Absolute paths, write order,
' de-duplicated (SaveAs is retried in a second pass and a retry must not appear twice).
Private Sub ManifestAdd(ByVal coll As Object, ByVal path As String)
    Dim i As Long
    If Len(path) = 0 Then Exit Sub
    If coll Is Nothing Then Exit Sub
    For i = 1 To coll.Count
        If LCase$(coll(i)) = LCase$(path) Then Exit Sub
    Next
    coll.Add path
End Sub

' merge the _undo snapshot files written during THIS call into a receipt's
' projectDirWrites manifest. Order preserved; ManifestAdd de-duplicates.
Private Sub ManifestMergeUndo(ByVal coll As Object)
    Dim i As Long
    On Error Resume Next
    If coll Is Nothing Then Exit Sub
    If m_dirWrites Is Nothing Then Exit Sub
    For i = 1 To m_dirWrites.Count
        ManifestAdd coll, CStr(m_dirWrites(i))
    Next
    Err.Clear
End Sub

' ===================== item 6: sideEffects =====================
' The per-call accumulators behind the additive `sideEffects` audit block.
' Design note (honest): an earlier analysis concluded there is no single RECEIPT BUILDER shared by
' every tool. There IS, however, a single place every tool's answer passes through:
' CallToolInner's text writer. SealedReceipt() therefore splices the block in there,
' which covers success AND failure receipts of every mutating tool in one edit instead
' of N per-tool edits - and cannot be forgotten by a future tool.
' ===========================================================================
Private Sub SeReset()
    Set m_seCreated = New Collection
    Set m_seRenamed = New Collection
    Set m_seRemoved = New Collection
    Set m_seFiles = New Collection
    Set Util.g_seBackups = New Collection
    Set m_seUndo = New Collection
End Sub

Private Sub SeAdd(ByVal coll As Object, ByVal value As String)
    On Error Resume Next
    If coll Is Nothing Then Exit Sub
    If Len(value) = 0 Then Exit Sub
    coll.Add value
    Err.Clear
End Sub

' Recorded by the writers. Public so the sibling modules (VbFmt) can take part.
Public Sub SeNoteCreated(ByVal name As String)
    SeAdd m_seCreated, name
End Sub

Public Sub SeNoteRemoved(ByVal name As String)
    SeAdd m_seRemoved, name
End Sub

Public Sub SeNoteRenamed(ByVal fromName As String, ByVal toName As String)
    On Error Resume Next
    Dim r As Object
    Set r = CreateObject("Scripting.Dictionary")
    r("from") = fromName
    r("to") = toName
    If Not m_seRenamed Is Nothing Then m_seRenamed.Add r
    Err.Clear
End Sub

Public Sub SeNoteFile(ByVal path As String)
    SeAdd m_seFiles, path
End Sub

' (the .bak sink is Util.SeNoteBackup / Util.g_seBackups - shared with VbFmt.bas)

Private Function SideEffectsDict() As Object
    On Error Resume Next
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    Dim fw As Object
    Set fw = New Collection
    Dim i As Long
    If m_seCreated Is Nothing Then SeReset
    If Not m_dirWrites Is Nothing Then
        For i = 1 To m_dirWrites.Count
            ManifestAdd fw, CStr(m_dirWrites(i))
        Next
    End If
    If Not m_seFiles Is Nothing Then
        For i = 1 To m_seFiles.Count
            ManifestAdd fw, CStr(m_seFiles(i))
        Next
    End If
    If m_seCreated Is Nothing Then Set m_seCreated = New Collection
    If m_seRenamed Is Nothing Then Set m_seRenamed = New Collection
    If m_seRemoved Is Nothing Then Set m_seRemoved = New Collection
    If Util.g_seBackups Is Nothing Then Set Util.g_seBackups = New Collection
    If m_seUndo Is Nothing Then Set m_seUndo = New Collection
    Set d("componentsCreated") = m_seCreated
    Set d("componentsRenamed") = m_seRenamed
    Set d("componentsRemoved") = m_seRemoved
    Set d("filesWritten") = fw
    Set d("backupsCreated") = Util.g_seBackups
    Set d("undoSnapshots") = m_seUndo
    Set SideEffectsDict = d
    Err.Clear
End Function

' Exact field names (recorded for the contract): componentsCreated[] -
' componentsRenamed[{from,to}] - componentsRemoved[] - filesWritten[] -
' backupsCreated[] - undoSnapshots[]. Additive only.
Private Sub SideEffectsInto(ByVal root As Object)
    On Error Resume Next
    If root Is Nothing Then Exit Sub
    Set root("sideEffects") = SideEffectsDict()
    Err.Clear
End Sub

Private Function SideEffectsJson() As String
    On Error Resume Next
    SideEffectsJson = JsonStringify(SideEffectsDict())
    Err.Clear
End Function

' Splice the block into a mutating tool's answer text. Gated three ways so it can never
' corrupt a non-object answer: (1) the tool must be state-changing, (2) the text must be
' a single JSON object, (3) the text must not already carry the key.
Private Function SealedReceipt(ByVal toolName As String, ByVal body As String) As String
    SealedReceipt = body
    On Error Resume Next
    If BodyIsNothing(body) Then Exit Function
    If Len(body) < 2 Then Exit Function
    If Right$(body, 1) <> "}" Then Exit Function
    If Left$(LTrim$(body), 1) <> "{" Then Exit Function
    If IsMutatingTool(toolName) Then
        If InStr(1, body, Chr$(34) & "sideEffects" & Chr$(34), vbTextCompare) > 0 Then Exit Function
        SealedReceipt = Left$(body, Len(body) - 1) & "," & Chr$(34) & "sideEffects" & Chr$(34) & ":" & SideEffectsJson() & "}"
    Else
        ' (the read-answer review/09): EVERY read-only receipt carries the in-flight block,
        ' so a caller can ask who is in flight, since when, and whether it is a read or
        ' a write from a tool that the busy gate never refuses. Reading a non-object
        ' answer is impossible here: the three guards above already returned.
        If InStr(1, body, Chr$(34) & "inflight" & Chr$(34), vbTextCompare) > 0 Then Exit Function
        m_inflightStamped = m_inflightStamped + 1
        SealedReceipt = Left$(body, Len(body) - 1) & "," & Chr$(34) & "inflight" & Chr$(34) & ":" & InflightJson() & "}"
    End If
    Err.Clear
End Function

Private Function BodyIsNothing(ByVal body As String) As Boolean
    BodyIsNothing = (Len(body) = 0)
End Function

Private Function ToolExportComponent(ByVal name As String, ByVal path As String) As String
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    Dim target As String
    If Len(path) = 0 Then
        target = comp.FileNames(1)
        If Len(target) = 0 Then Err.Raise vbObjectError + 49, "CodeTools", "Component has no file name; pass an explicit path"
    Else
        target = ResolvePath(path)
    End If
    ' Export writes a COPY; it must NOT reassign the component's file
    ' name (SaveAs would point the project at the export path and
    ' break later compiles).
    Dim hasDes As Boolean
    hasDes = False
    On Error Resume Next
    hasDes = Not (comp.Designer Is Nothing)
    If Err.Number <> 0 Then
        Err.Clear
        hasDes = False
    End If
    On Error GoTo 0
    Dim desNote As String
    desNote = ""
    If hasDes Then
        ' A designer component carries a binary layout section that the code
        ' text cannot represent. VBComponent.Export is the cleanest path but is
        ' absent from some VB6 VBE builds (error 438, measured here), so try it,
        ' then copy the component's saved project files, then fall back to text.
        Dim desOk As Boolean
        desOk = False
        On Error Resume Next
        comp.Export target
        If Err.Number = 0 Then
            ' remaining: VBComponent.Export is a black box - prove the file landed.
            Dim expB() As Byte
            Encoding.ReadAllBytesTo target, expB
            If Encoding.ByteCount(expB) > 0 Then desOk = True
        Else
            Err.Clear
        End If
        On Error GoTo 0
        Dim frx As String
        If Len(target) > 4 Then
            frx = Left$(target, Len(target) - 4) & ".frx"
        Else
            frx = target & ".frx"
        End If
        If desOk Then
            Dim rootD As Object
            Set rootD = CreateObject("Scripting.Dictionary")
            rootD("ok") = True
            rootD("component") = comp.Name
            rootD("file") = target
            If CtlFileExists(frx) Then rootD("frx") = frx
            rootD("saved") = True
            rootD("note") = "Designer component exported whole via VBComponent.Export (.frm/.frx); the project's own file assignment is unchanged."
            ToolExportComponent = JsonStringify(rootD)
            Exit Function
        End If
        Dim src As String
        src = ""
        On Error Resume Next
        ' FileNames is a parameterised property (FileNames(index) As String), so
        ' asking for .Count is a compile error; read index 1 and swallow any
        ' failure (unsaved component).
        src = comp.FileNames(1)
        If Err.Number <> 0 Then
            Err.Clear
            src = ""
        End If
        On Error GoTo 0
        If Len(src) > 0 Then
            If CtlFileExists(src) Then
                Dim fso As Object
                Set fso = CreateObject("Scripting.FileSystemObject")
                fso.CopyFile src, target, True
                ' remaining: prove the copy landed before reporting a saved component.
                Dim cpB() As Byte
                Encoding.ReadAllBytesTo target, cpB
                If Encoding.ByteCount(cpB) <= 0 Then
                    Dim refC As Object
                    Set refC = CreateObject("Scripting.Dictionary")
                    refC("ok") = False
                    refC("component") = comp.Name
                    refC("file") = target
                    refC("saved") = False
                    refC("reason") = "export_not_readable_back"
                    refC("detail") = "the component file copied to the export target is missing or empty, so nothing is reported as exported"
                    ToolExportComponent = JsonStringify(refC)
                    Exit Function
                End If
                Dim srcFrx As String
                srcFrx = ""
                If Len(src) > 4 Then srcFrx = Left$(src, Len(src) - 4) & ".frx"
                If Len(srcFrx) > 0 Then
                    If CtlFileExists(srcFrx) Then fso.CopyFile srcFrx, frx, True
                End If
                Dim rootC As Object
                Set rootC = CreateObject("Scripting.Dictionary")
                rootC("ok") = True
                rootC("readbackBytes") = Encoding.ByteCount(cpB)
                rootC("component") = comp.Name
                rootC("file") = target
                If CtlFileExists(frx) Then rootC("frx") = frx
                rootC("saved") = True
                rootC("copiedFrom") = src
                rootC("note") = "VBComponent.Export is unavailable in this VBE build, so the component's saved project file was copied (it reflects the last saved state, not unsaved edits); the project's own file assignment is unchanged."
                ToolExportComponent = JsonStringify(rootC)
                Exit Function
            End If
        End If
        desNote = "Designer component: only the code section was written (VBComponent.Export unavailable and the component has no saved file yet, so the layout section is missing)."
    End If
    Dim cm As VBIDE.CodeModule
    Set cm = comp.CodeModule
    Dim text As String
    If Not cm Is Nothing Then
        If cm.CountOfLines > 0 Then text = cm.Lines(1, cm.CountOfLines)
    End If
    Dim fnum As Integer
    fnum = FreeFile
    Open target For Output As #fnum
    Print #fnum, text;
    Close #fnum
    ' remaining: read the bytes back - a failed Open/Print used to be invisible.
    Dim txtB() As Byte
    Encoding.ReadAllBytesTo target, txtB
    If Encoding.ByteCount(txtB) <= 0 And Len(text) > 0 Then
        Dim refT As Object
        Set refT = CreateObject("Scripting.Dictionary")
        refT("ok") = False
        refT("component") = comp.Name
        refT("file") = target
        refT("saved") = False
        refT("reason") = "export_not_readable_back"
        refT("detail") = "the exported code text is missing or empty at the target path, so nothing is reported as exported"
        ToolExportComponent = JsonStringify(refT)
        Exit Function
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("ok") = True
    root("readbackBytes") = Encoding.ByteCount(txtB)
    root("component") = comp.Name
    root("file") = target
    root("saved") = True
    If Len(desNote) > 0 Then
        root("note") = desNote
    Else
        root("note") = "Code-only component exported as text (same bytes as the code module)."
    End If
    ToolExportComponent = JsonStringify(root)
End Function

Private Function ToolRenameComponent(ByVal name As String, ByVal newName As String) As String
    If Len(newName) = 0 Then Err.Raise vbObjectError + 50, "CodeTools", "new_name is required"
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    comp.Name = newName
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("oldName") = name
    root("newName") = comp.Name
    SeNoteRenamed name, comp.Name
    ToolRenameComponent = JsonStringify(root)
End Function

Private Function ToolReloadComponent(ByVal name As String) As String
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    ' / the reload-receipt finding: read the component's identity BEFORE Reload.
    ' Measured (J arm, re-measured): comp.Name read AFTER Reload reports
    ' VB6's DEFAULT component name (a standard module => "Module1") whenever that component's code
    ' pane has never been opened in this IDE session, and the true name once it has. FindComponent
    ' has just matched LCase$(comp.Name) against the requested name, so the value read HERE is
    ' provably the real name; reading it after the reload is what made the receipt lie.
    Dim compName As String
    compName = comp.Name
    ' / the reload-target finding: Reload re-reads the file the component is BOUND to (FileNames(1)),
    ' which is not necessarily the file the caller edited (import_component mode=file binds a
    ' project-local COPY). Report that bound path so the caller can decide whether the reload
    ' could have covered the edit at all.
    Dim boundFile As String
    boundFile = ""
    On Error Resume Next
    boundFile = comp.FileNames(1)
    If Err.Number <> 0 Then
        Err.Clear
        boundFile = ""
    End If
    On Error GoTo 0
    ' v1.11.12: a Reload MOVES the component to the end of the IDE's in-memory component
    ' list, and the NEXT save_project writes the .vbp in that order. Snapshot the .vbp line
    ' order AND the in-memory component order HERE, so the receipt can prove what moved and
    ' save_project can put the original order back.
    Dim vbpPathR As String
    Dim vbpTextRBefore As String, vbpTextRAfter As String
    Dim vbpSeqRBefore() As String, vbpIdxRBefore() As Long
    Dim vbpSeqRAfter() As String, vbpIdxRAfter() As Long
    Dim vbpLinesR() As String
    Dim vbpReadyR As Boolean
    Dim orderBefore As String, orderAfter As String
    vbpPathR = ""
    vbpTextRBefore = ""
    vbpReadyR = False
    Dim ppR As VBIDE.VBProject
    On Error Resume Next
    Set ppR = GetProject()
    If Not ppR Is Nothing Then vbpPathR = ppR.FileName
    Err.Clear
    On Error GoTo 0
    If Len(vbpPathR) > 0 Then
        vbpTextRBefore = ProjShip.ReadTextFile(vbpPathR)
        If Len(vbpTextRBefore) > 0 Then
            vbpLinesR = McpCls.TextLines(Me, vbpTextRBefore)
            vbpSeqRBefore = McpProjTools.VbpOrderSeq(Me, vbpLinesR, vbpIdxRBefore)
            vbpReadyR = True
        End If
    End If
    orderBefore = CompOrderKey()
    comp.Reload
    orderAfter = CompOrderKey()
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("reloaded") = compName
    root("requested") = name
    root("file") = boundFile
    ' WP-22-04 (MCP-1022-49 d): PROVE the reload landed by reading the pane back NOW. A
    ' reload that succeeded while the pane still shows the old text is exactly the state
    ' that produced a fake FAIL on the next verify (measured on LSSScoreType: the first read
    ' after reload still showed m_Id, the second showed m_id).
    ' FIX-24 (F1) - TWO DEFECTS FIXED HERE, both measured:
    '  (a) ready used to be (Len(rbSha) > 0), and Sha256HexTextUtf8("") is the NON-EMPTY digest
    '      of the empty string (E3B0C442...), so ready was TRUE when the pane read came back EMPTY -
    '      a fake success whose whole proof was the digest of nothing. ready now requires
    '      NON-EMPTY text, and no digest is published when there is nothing to digest.
    '  (b) the reload can RENAME the component (measured: modFix -> Module1, then back), while the
    '      receipt kept publishing the PRE-reload name - so the immediately following verify
    '      answered component_not_found for a name that was RIGHT (a fake failure). The name is
    '      RE-RESOLVED after the reload and published as resolvedNameAfter.
    Dim resolvedAfter As String
    resolvedAfter = ResolveNameAfterReload(comp, compName, orderAfter)
    root("resolvedNameAfter") = resolvedAfter
    root("componentRenamedByReload") = (StrComp(resolvedAfter, compName, vbTextCompare) <> 0)
    If CBool(root("componentRenamedByReload")) Then
        m_reloadFrom = compName
        m_reloadTo = resolvedAfter
        m_reloadTick = GetTickCount()
        root("reloadRenameWindowMs") = RELOAD_SETTLE_WINDOW_MS
        root("reloadRenameNote") = "VB6 RENAMED the component during Reload (" & compName & " -> " & resolvedAfter & "). The window is TRANSIENT (measured: the old name comes back on a later call), but for reloadRenameWindowMs a lookup of the old name answers reason=pane_not_settled instead of component_not_found. resolvedNameAfter is the name the IDE reports NOW."
    Else
        m_reloadFrom = ""
        m_reloadTo = ""
        root("reloadRenameWindowMs") = 0
    End If
    Dim rbText As String
    Dim rbSha As String
    rbText = ""
    On Error Resume Next
    Err.Clear
    rbText = CompText(resolvedAfter)
    If Err.Number <> 0 Then Err.Clear
    On Error GoTo 0
    root("readBackName") = resolvedAfter
    root("readBackLines") = PaneLineCount(rbText)
    root("readBackAt") = Format$(Now, "yyyy-mm-dd hh:nn:ss")
    If Len(rbText) > 0 Then
        rbSha = Sha256.Sha256HexTextUtf8(rbText)
        root("readBackSha256") = rbSha
        root("readBackBasis") = "pane_text"
        root("ready") = True
        root("readBackNote") = "digest of the NON-EMPTY text the code module returns AFTER the reload; compare it with get_component_codes own sha256 to prove reload-to-pane settling (a pane never shows the hidden Attribute lines, so it is NOT expected to equal the file digest)"
    Else
        ' an EMPTY read-back is NOT evidence of anything: it is the shape of a failed read AND
        ' the shape of an empty component, so it can never justify ready=true or a digest.
        root("readBackSha256") = ""
        root("readBackBasis") = "pane_empty"
        root("ready") = False
        root("readBackNote") = "the code pane returned EMPTY text immediately after the reload. An empty read-back is NOT evidence that the reload settled (it is also the shape of a failed read), so no sha256 is published and ready=false."
        root("readyUnavailableReason") = "pane_empty_readback"
        root("howToProceed") = "read the component with get_component_code (proves whether the pane really is empty), or retry the reload once; do NOT treat this component as settled until ready=true"
    End If
    ' v1.11.12: did the Reload move the component inside the project (in memory)?
    Dim moved As Object
    Set moved = CompOrderMoves(orderBefore, orderAfter)
    root("inMemoryOrderMoved") = (moved.Count > 0)
    Set root("inMemoryOrderChanges") = moved
    root("inMemoryOrderBefore") = orderBefore
    root("inMemoryOrderAfter") = orderAfter
    ' v1.11.12: the .vbp ORDER contract (same key names as save_project).
    root("vbpPath") = vbpPathR
    root("vbpOrderChecked") = vbpReadyR
    root("vbpOrderPreserved") = True
    root("vbpOrderRestored") = False
    root("vbpRevisionBefore") = ""
    root("vbpRevisionAfter") = ""
    root("vbpRevisionBumped") = False
    root("vbpOrderLinesCapped") = VBP_ORDER_MAX_LINES
    Set root("vbpOrderChanges") = EmptyJsonArray()
    If vbpReadyR Then
        Dim revB As String, revA As String
        revB = McpProjTools.VbpSettingValue(Me, vbpTextRBefore, "RevisionVer")
        root("vbpRevisionBefore") = revB
        vbpTextRAfter = ProjShip.ReadTextFile(vbpPathR)
        If Len(vbpTextRAfter) > 0 Then
            revA = McpProjTools.VbpSettingValue(Me, vbpTextRAfter, "RevisionVer")
            root("vbpRevisionAfter") = revA
            Dim revBumpedR As Boolean
            revBumpedR = False
            If Len(revB) > 0 Then
                If Len(revA) > 0 Then
                    If revB <> revA Then revBumpedR = True
                End If
            End If
            root("vbpRevisionBumped") = revBumpedR
            Dim afterLinesR() As String
            afterLinesR = McpCls.TextLines(Me, vbpTextRAfter)
            vbpSeqRAfter = McpProjTools.VbpOrderSeq(Me, afterLinesR, vbpIdxRAfter)
            Dim deltaR As Object
            Set deltaR = McpProjTools.VbpOrderDelta(Me, vbpSeqRBefore, vbpIdxRBefore, vbpSeqRAfter, vbpIdxRAfter)
            root("vbpOrderPreserved") = CBool(deltaR("preserved"))
            Set root("vbpOrderChanges") = deltaR("changes")
            Set root("vbpOrderLinesBefore") = McpProjTools.VbpSeqJsonArray(Me, vbpSeqRBefore)
            Set root("vbpOrderLinesAfter") = McpProjTools.VbpSeqJsonArray(Me, vbpSeqRAfter)
            root("vbpOrderNote") = "Reload does NOT rewrite the .vbp itself: vbpOrderPreserved describes the on-disk file before/after this call. inMemoryOrderMoved=true means the IDE's component list moved; the next save_project would have written that order into the .vbp, and save_project restores the pre-save order (vbpOrderRestored=true). vbpRevisionBefore/After are READ from the two file snapshots, not inferred."
        Else
            Set root("vbpOrderLinesBefore") = EmptyJsonArray()
            Set root("vbpOrderLinesAfter") = EmptyJsonArray()
            root("vbpOrderNote") = "the .vbp could not be read back after the reload, so the on-disk order could not be compared"
        End If
    Else
        Set root("vbpOrderLinesBefore") = EmptyJsonArray()
        Set root("vbpOrderLinesAfter") = EmptyJsonArray()
        root("vbpOrderNote") = "the project has no .vbp on disk, so the .vbp order contract cannot be evaluated for this call"
    End If
    ToolReloadComponent = JsonStringify(root)
End Function

' FIX-24 (F1): resolve the component's name AFTER a Reload. The VBComponent reference may be stale
' once VB6 has renamed it, so the name is taken from the live project and, failing that, from the
' in-memory order key (whose tokens are LOWER-CASED, hence the LCase comparison).
Private Function ResolveNameAfterReload(ByRef comp As VBIDE.VBComponent, ByVal wanted As String, ByVal orderAfter As String) As String
    Dim nm As String
    nm = ""
    On Error Resume Next
    Err.Clear
    If Not comp Is Nothing Then nm = comp.Name
    If Err.Number <> 0 Then Err.Clear
    On Error GoTo 0
    If Len(nm) = 0 Then
        Dim p As VBIDE.VBProject, c As VBIDE.VBComponent
        On Error Resume Next
        Err.Clear
        Set p = GetProject()
        If (Not p Is Nothing) And (Err.Number = 0) Then
            For Each c In p.VBComponents
                If LCase$(c.Name) = LCase$(wanted) Then nm = c.Name: Exit For
            Next
            If Len(nm) = 0 Then
                Dim tok As String
                tok = orderAfter
                If InStr(tok, "|") > 0 Then tok = Left$(tok, InStr(tok, "|") - 1)
                If Len(tok) > 0 Then
                    For Each c In p.VBComponents
                        If LCase$(c.Name) = LCase$(tok) Then nm = c.Name: Exit For
                    Next
                End If
            End If
        End If
        Err.Clear
        On Error GoTo 0
    End If
    If Len(nm) = 0 Then nm = wanted
    ResolveNameAfterReload = nm
End Function

' FIX-24 (F1): TRUE when name failed to resolve BECAUSE a Reload renamed a component out of that
' name moments ago. Fills the name it resolved TO and the age of that rename.
Public Function ReloadRenameJustHappened(ByVal name As String, ByRef resolvedAfter As String, ByRef ageMs As Long) As Boolean
    resolvedAfter = ""
    ageMs = 0
    If Len(m_reloadFrom) = 0 Then Exit Function
    If StrComp(m_reloadFrom, name, vbTextCompare) <> 0 Then Exit Function
    ageMs = GetTickCount() - m_reloadTick
    If ageMs < 0 Then ageMs = 0
    If ageMs > RELOAD_SETTLE_WINDOW_MS Then Exit Function
    resolvedAfter = m_reloadTo
    ReloadRenameJustHappened = True
End Function

' FIX-24 (F2): the diff kinds that VB6 semantics FOLD AWAY. none means IDENTICAL - it is
' deliberately NOT in this list (counting it made 5 clean components report caseOnly:5).
Private Function FoldableDiffKind(ByVal diffKind As String) As Boolean
    Select Case LCase$(Trim$(diffKind))
        Case "caseonly", "whitespaceonly", "attributeonly", "headeronly", "foldablemixed"
            FoldableDiffKind = True
    End Select
End Function

' FIX-24 (F6): how many components have a code pane that differs from their DISK file RIGHT NOW.
' Returns the mismatch count, or -1 when the project itself cannot be read. Up to 20 names go into
' namesOut. This is a MEASUREMENT for the receipt, never a write.
Private Function PaneDiskMismatchScan(ByRef namesOut As Object) As Long
    On Error Resume Next
    Set namesOut = New Collection
    Dim bad As Long
    bad = 0
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    If p Is Nothing Then
        PaneDiskMismatchScan = -1
        Exit Function
    End If
    Dim c As VBIDE.VBComponent
    For Each c In p.VBComponents
        Dim nm As String, pane As String, dp As String, disk As String, body As String
        nm = c.Name
        pane = ""
        disk = ""
        Err.Clear
        pane = CompText(nm)
        If Err.Number <> 0 Then pane = "": Err.Clear
        dp = DiskPathOf(nm, "")
        If Len(dp) > 0 Then
            If Dir$(dp) <> "" Then disk = ProjShip.ReadTextFile(dp)
        End If
        If Err.Number <> 0 Then Err.Clear
        If (Len(dp) > 0) And (Len(pane) > 0) And (Len(disk) > 0) Then
            body = TextAfterLines(disk, McpCls.SharedHeaderOffset(Me, nm))
            ' VB writes a trailing blank line that a code pane never shows, so the tail is
            ' TRIMMED on both sides - the same basis verify uses (measured: without this the
            ' scan reported a mismatch for a component that verify calls identical).
            If StrComp(TrimBlankTail(CrNorm(pane)), TrimBlankTail(CrNorm(body)), vbBinaryCompare) <> 0 Then
                bad = bad + 1
                If namesOut.Count < 20 Then namesOut.Add nm
            End If
        End If
    Next
    Err.Clear
    PaneDiskMismatchScan = bad
End Function

' FIX-24 (F6): drop the first n LINES of a file snapshot (the hidden Attribute/header lines a code
' pane never shows), so pane text and disk body are compared on the same basis.
Private Function TrimBlankTail(ByVal s As String) As String
    Dim ls() As String
    Dim i As Long
    Dim last As Long
    ls = McpCls.TextLines(Me, s)
    last = -1
    For i = UBound(ls) To 0 Step -1
        If Len(Trim$(ls(i))) > 0 Then
            last = i
            Exit For
        End If
    Next
    If last < 0 Then
        TrimBlankTail = ""
        Exit Function
    End If
    Dim out As String
    out = ""
    For i = 0 To last
        If i > 0 Then out = out & vbLf
        out = out & ls(i)
    Next
    TrimBlankTail = out
End Function

Private Function TextAfterLines(ByVal s As String, ByVal n As Long) As String
    If n <= 0 Then
        TextAfterLines = s
        Exit Function
    End If
    Dim ls() As String
    Dim i As Long
    Dim out As String
    ls = McpCls.TextLines(Me, s)
    out = ""
    For i = n To UBound(ls)
        If i > n Then out = out & vbLf
        out = out & ls(i)
    Next
    TextAfterLines = out
End Function

' =====================================================================
' code module / code pane tools
' =====================================================================

' shared structured refusal for text that cannot survive the target encoding.
' Measured: an ACP encode turns an astral character into '?' (one per surrogate), and
' the VB6 code pane is ANSI-backed the same way.  Refuse, never silently corrupt.
' decode-and-compare, kept OUT of ToolWriteFile on purpose: that function's
' parameter is named 'encoding', which shadows the Encoding MODULE (VB6 is
' case-insensitive), so 'Encoding.X' there is an invalid qualifier.
Private Function BytesDecodeEqualTo(ByRef b() As Byte, ByVal encName As String, ByVal s As String) As Boolean
    Dim back As String
    Encoding.DecodeBytes b, encName, back
    BytesDecodeEqualTo = (back = s)
End Function

Private Function UnencodableRefusal(ByVal toolName As String, ByVal target As String, ByVal enc As String, ByVal s As String) As String
    Dim back As String, at As Long, cp As Long, hexCp As String
    Encoding.TextEncodableEx s, enc, back, at
    If at > 0 And at <= Len(s) Then
        cp = AscW(Mid$(s, at, 1))
        If cp < 0 Then cp = cp + 65536
        hexCp = "U+" & UCase$(Hex$(cp))
    End If
    Dim r As Object
    Set r = CreateObject("Scripting.Dictionary")
    r("ok") = False
    r("tool") = toolName
    r("target") = target
    r("reason") = "unencodable_text"
    r("encoding") = enc
    r("textLength") = Len(s)
    r("decodedLength") = Len(back)
    If at > 0 Then
        r("firstDiffAt") = at
        r("firstDiffChar") = hexCp
        r("detail") = "the text carries a character the " & enc & " code page cannot represent: first difference at char " & CStr(at) & " (" & hexCp & "). The write was refused rather than silently substituting the default character."
    Else
        r("detail") = "the text does not survive a " & enc & " encode/decode round trip (length " & CStr(Len(s)) & " -> " & CStr(Len(back)) & "). The write was refused rather than silently corrupting it."
    End If
    UnencodableRefusal = JsonStringify(r)
End Function


' The disk line for an IDE line, or 0 when the pane->disk alignment cannot be resolved
' (the alignment itself is computed by CoordsDictOfName; this only reads it back).
Private Function CoordsDiskLineOf(ByVal name As String, ByVal ideLine As Long) As Long
    CoordsDiskLineOf = 0
    Dim d As Object
    Set d = CoordsDictOfName(name, ideLine, "ide")
    If d Is Nothing Then Exit Function
    On Error Resume Next
    If d.Exists("resolved") Then
        If CBool(d("resolved")) Then
            If d.Exists("diskLine") Then CoordsDiskLineOf = CLng(d("diskLine"))
        End If
    End If
    Err.Clear
End Function

' TRUE when a statement placed at lineNo sits in the module's DECLARATION AREA.
' DEFINITION (contract v1.11.9): the declaration area is everything BEFORE the FIRST
' procedure header line - the only place where VB6 accepts Option Explicit / module-level
' Dim / Const / Type / Enum.  It is NOT "anywhere outside an unclosed procedure body":
' a statement appended at the END of a module that already has procedures is at module
' level but NOT in the declaration area, so it must report FALSE.
' The landing is measured on the RESULT text, so this is a property of the write that
' happened - never an assumption about where an end-append usually goes.
Private Function IsDeclarationAreaAt(ByVal text As String, ByVal lineNo As Long) As Boolean
    IsDeclarationAreaAt = False
    Dim lines() As String, i As Long, firstProc As Long
    lines = Split(Replace(Replace(text, vbCrLf, vbLf), vbCr, vbLf), vbLf)
    If lineNo < 1 Then lineNo = 1
    If lineNo > UBound(lines) + 1 Then lineNo = UBound(lines) + 1
    ' 1-based line number of the FIRST procedure header; 0 when the module has none.
    firstProc = 0
    For i = 0 To UBound(lines)
        If ProcLineKind(lines(i)) = "start" Then
            firstProc = i + 1
            Exit For
        End If
    Next
    ' No procedure at all: the whole module is declaration area.  Otherwise the landing
    ' must be strictly BEFORE the first procedure header.
    If firstProc = 0 Then
        IsDeclarationAreaAt = True
    Else
        IsDeclarationAreaAt = (lineNo < firstProc)
    End If
End Function

' "start" / "end" for a procedure header / closing line, "" otherwise. Leading VB6
' modifiers are stripped, so Public/Private/Friend/Static/Global forms all match.
Private Function ProcLineKind(ByVal raw As String) As String
    ProcLineKind = ""
    Dim t As String
    t = LCase$(Trim$(raw))
    If Len(t) = 0 Then Exit Function
    If Left$(t, 1) = "'" Then Exit Function
    Do
        If Left$(t, 7) = "public " Then
            t = Mid$(t, 8)
        ElseIf Left$(t, 8) = "private " Then
            t = Mid$(t, 9)
        ElseIf Left$(t, 7) = "friend " Then
            t = Mid$(t, 8)
        ElseIf Left$(t, 7) = "static " Then
            t = Mid$(t, 8)
        ElseIf Left$(t, 7) = "global " Then
            t = Mid$(t, 8)
        Else
            Exit Do
        End If
        t = LTrim$(t)
    Loop
    If Left$(t, 4) = "sub " Or Left$(t, 9) = "function " Or Left$(t, 9) = "property " Then ProcLineKind = "start"
    If t = "end sub" Or t = "end function" Or t = "end property" Then ProcLineKind = "end"
End Function

Private Function AddCodeDupDeclFindings(ByVal cur As String, ByVal body As String, ByVal bodyFirstLine As Long) As Object
    ' A TEXTUAL pre-write scan of (current pane text) + (submitted block). It answers two
    ' questions: does the block bring a second Option Explicit, and does a module-level
    ' Dim/Const/Type/Enum name of the block collide with one the module already declares.
    ' Limits travel with the answer (declaredCheckBasis): #If branches are not evaluated and
    ' this is not a compiler.
    Dim res As Object
    Set res = CreateObject("Scripting.Dictionary")
    Dim findings As Object
    Set findings = New Collection
    Dim curDecls As Object
    Dim bodyDecls As Object
    Dim curOe As Long
    Dim bodyOe As Long
    Set curDecls = CreateObject("Scripting.Dictionary")
    Set bodyDecls = CreateObject("Scripting.Dictionary")
    curOe = 0
    bodyOe = 0
    ScanDeclArea cur, curDecls, curOe, 0
    ScanDeclArea body, bodyDecls, bodyOe, bodyFirstLine - 1
    Dim i As Long
    Dim f As Object
    If (curOe + bodyOe) > 1 Then
        Set f = CreateObject("Scripting.Dictionary")
        f("kind") = "option_explicit"
        f("name") = "Option Explicit"
        f("severity") = "warning"
        f("editLine") = bodyFirstLine
        f("message") = "duplicate_option_explicit"
        f("detail") = "the module already carries " & CStr(curOe) & " Option Explicit statement(s) and the block carries " & CStr(bodyOe) & "; VB6 allows one per module"
        findings.Add f
    End If
    Dim k As Variant
    Dim bd As Object
    Dim cd As Object
    Dim f2 As Object
    For Each k In bodyDecls.Keys
        MaybePump
        If curDecls.Exists(k) Then
            Set bd = bodyDecls(k)
            Set cd = curDecls(k)
            Set f2 = CreateObject("Scripting.Dictionary")
            f2("kind") = LCase$(CStr(bd("kind")))
            f2("name") = CStr(bd("name"))
            f2("severity") = "warning"
            f2("editLine") = CLng(bd("editLine"))
            f2("moduleDeclarationLine") = CLng(cd("editLine"))
            f2("message") = "duplicate_declaration: " & CStr(bd("name"))
            f2("detail") = "the module already declares " & CStr(cd("name")) & " (" & CStr(cd("kind")) & ", module line " & CStr(cd("editLine")) & "); the block declares it again as " & CStr(bd("kind"))
            findings.Add f2
        End If
    Next k
    res("checkPerformed") = True
    res("optionExplicitInModule") = curOe
    res("optionExplicitInBlock") = bodyOe
    Set res("findings") = findings
    res("findingCount") = findings.Count
    Set AddCodeDupDeclFindings = res
End Function

Private Sub ScanDeclArea(ByVal text As String, ByVal decls As Object, ByRef oeCount As Long, ByVal baseLine As Long)
    Dim lines() As String
    Dim i As Long
    Dim raw As String
    Dim s As String
    Dim b As String
    Dim inBlock As String
    oeCount = 0
    inBlock = ""
    If Len(text) = 0 Then Exit Sub
    lines = McpCls.TextLines(Me, text)
    For i = 0 To UBound(lines)
        MaybePump
        raw = lines(i)
        If Len(Vb6Lint.LintProcHeaderName(raw)) > 0 Then Exit For
        s = LCase$(Trim$(Vb6Lint.StripCode(raw)))
        If Len(s) = 0 Then GoTo NextScanLine
        If inBlock <> "" Then
            If s = "end " & inBlock Then inBlock = ""
            GoTo NextScanLine
        End If
        If s = "option explicit" Then
            oeCount = oeCount + 1
        Else
            b = StripDeclModifiers(s)
            If Left$(b, 5) = "type " Then
                AddDeclName decls, DeclFirstIdent(Mid$(b, 6)), "Type", baseLine + i + 1
                inBlock = "type"
            ElseIf Left$(b, 5) = "enum " Then
                AddDeclName decls, DeclFirstIdent(Mid$(b, 6)), "Enum", baseLine + i + 1
                inBlock = "enum"
            ElseIf Left$(b, 11) = "withevents " Then
                ' FIX-30: WithEvents is a module-level declaration too (the name follows it).
                AddDeclName decls, DeclFirstIdent(Mid$(b, 12)), "WithEvents", baseLine + i + 1
            ElseIf IsModuleVarDecl(b) Then
                ' FIX-30: a module-level declaration does NOT need the Dim keyword. VB6 accepts
                ' Private/Public/Global/Friend <name> As <type> in the declarations section, and the
                ' scan used to recognise only dim/const/type/enum/declare - so
                ' Private mImp25 As Long followed by Dim mImp25 As Long was NOT reported
                ' (measured: duplicateDeclarationCount:0 while the write went through).
                AddDeclName decls, DeclFirstIdent(b), "ModuleVar", baseLine + i + 1
            ElseIf Left$(b, 4) = "dim " Then
                AddDeclNames decls, Mid$(b, 5), "Dim", baseLine + i + 1
            ElseIf Left$(b, 6) = "const " Then
                AddDeclNames decls, Mid$(b, 7), "Const", baseLine + i + 1
            ElseIf Left$(b, 8) = "declare " Then
                AddDeclNames decls, DeclApiName(Mid$(b, 9)), "Declare", baseLine + i + 1
            End If
        End If
NextScanLine:
    Next i
End Sub

Private Function IsModuleVarDecl(ByVal b As String) As Boolean
    ' FIX-30: is this declaration-section line a module-level VARIABLE declaration WITHOUT the Dim
    ' keyword (Private/Public/Global/Friend <name> As <type>)? Decl-only flags are already stripped
    ' by StripDeclModifiers, so the line starts with the NAME. The form must have " as " (a typed
    ' declaration) and a leading identifier; a no-type form (Private mX = 5) is left to the linter.
    IsModuleVarDecl = False
    Dim tl As String
    tl = LCase$(b)
    If Len(tl) = 0 Then Exit Function
    If Left$(tl, 4) = "sub " Then Exit Function
    If Left$(tl, 9) = "function " Then Exit Function
    If Left$(tl, 9) = "property " Then Exit Function
    If Left$(tl, 5) = "type " Then Exit Function
    If Left$(tl, 4) = "enum " Then Exit Function
    If Left$(tl, 4) = "dim " Then Exit Function
    If Left$(tl, 6) = "const " Then Exit Function
    If Left$(tl, 8) = "declare " Then Exit Function
    If Left$(tl, 11) = "withevents " Then Exit Function
    If Left$(tl, 6) = "option " Then Exit Function
    If InStr(tl, " as ") = 0 Then Exit Function
    Dim nm As String
    nm = DeclFirstIdent(b)
    If Len(nm) = 0 Then Exit Function
    Dim c1 As String
    c1 = LCase$(Left$(nm, 1))
    If (c1 >= "a") And (c1 <= "z") Then IsModuleVarDecl = True
End Function

Private Sub AddDeclNames(ByVal decls As Object, ByVal listText As String, ByVal kind As String, ByVal lineNo As Long)
    Dim parts() As String
    Dim i As Long
    parts = Split(listText, ",")
    For i = 0 To UBound(parts)
        AddDeclName decls, DeclFirstIdent(parts(i)), kind, lineNo
    Next i
End Sub

Private Sub AddDeclName(ByVal decls As Object, ByVal nm As String, ByVal kind As String, ByVal lineNo As Long)
    Dim key As String
    Dim rec As Object
    If Len(nm) = 0 Then Exit Sub
    key = LCase$(nm)
    If decls.Exists(key) Then Exit Sub
    Set rec = CreateObject("Scripting.Dictionary")
    rec("name") = nm
    rec("kind") = kind
    rec("editLine") = lineNo
    ' FIX-25 (D1): the record is an OBJECT. A Set-less assignment raised VB error 450 on the FIRST
    ' Dim/Const/Type/Enum/Declare the scan met, and the caller honestly fell back to
    ' declaredCheck:"not_performed" - i.e. every duplicate-declaration except Option Explicit was
    ' never checked. Measured on a component that declares the same Dim twice.
    Set decls(key) = rec
End Sub

Private Function StripDeclModifiers(ByVal s As String) As String
    Dim t2 As String
    t2 = s
    Do
        Dim u As String
        u = t2
        If Left$(t2, 7) = "public " Then t2 = Mid$(t2, 8)
        If Left$(t2, 8) = "private " Then t2 = Mid$(t2, 9)
        If Left$(t2, 7) = "friend " Then t2 = Mid$(t2, 8)
        If Left$(t2, 7) = "global " Then t2 = Mid$(t2, 8)
        If Left$(t2, 7) = "static " Then t2 = Mid$(t2, 8)
        If Left$(t2, 11) = "withevents " Then t2 = Mid$(t2, 12)
        If u = t2 Then Exit Do
    Loop
    StripDeclModifiers = t2
End Function

Private Function DeclFirstIdent(ByVal s As String) As String
    Dim i As Long
    Dim ch As String
    Dim out As String
    s = LTrim$(s)
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If (ch >= "a" And ch <= "z") Or (ch >= "A" And ch <= "Z") Or (ch >= "0" And ch <= "9") Or ch = "_" Then
            out = out & ch
        Else
            Exit For
        End If
    Next i
    DeclFirstIdent = out
End Function

Private Function DeclApiName(ByVal s As String) As String
    Dim t2 As String
    t2 = LTrim$(s)
    If Left$(t2, 9) = "function " Then t2 = Mid$(t2, 10)
    If Left$(t2, 4) = "sub " Then t2 = Mid$(t2, 5)
    DeclApiName = DeclFirstIdent(t2)
End Function

Private Function AddCodeDeclRefusal(ByVal compName As String, ByVal declPre As Object, ByVal cur As String, ByVal ideLines As Long) As String
    Dim d As Object
    Dim fs As Object
    Dim i As Long
    Dim hasOe As Boolean
    Set d = CreateObject("Scripting.Dictionary")
    Set fs = declPre("findings")
    hasOe = False
    For i = 1 To fs.Count
        If CStr(fs(i)("kind")) = "option_explicit" Then hasOe = True
    Next i
    d("ok") = False
    If hasOe Then
        d("reason") = "duplicate_option_explicit"
    Else
        d("reason") = "duplicate_declaration"
    End If
    d("tool") = "add_code"
    d("component") = compName
    d("validate") = "strict"
    d("written") = False
    d("writePerformed") = False
    d("writeOutcome") = "not_written"
    d("declaredCheck") = "performed"
    d("declaredCheckBasis") = "textual scan of (current pane text) + (submitted block) for Option Explicit and module-level Dim/Const/Type/Enum names; case-insensitive; #If branches are NOT evaluated; this is not a compiler"
    Set d("duplicateDeclarations") = fs
    d("duplicateDeclarationCount") = fs.Count
    d("sha256Before") = Sha256.Sha256HexTextUtf8(cur)
    d("sha256After") = Sha256.Sha256HexTextUtf8(cur)
    d("newTotalLines") = PaneLineCount(cur)
    d("ideTotalLines") = ideLines
    d("readbackUnchanged") = True
    d("detail") = "validate:'strict' refused the write BEFORE the pane was touched: the submitted block duplicates a module-level declaration, which VB6 rejects at compile time. Nothing was written (sha256Before == sha256After)."
    d("suggestedAction") = "remove the duplicated statement from the block (a NEW module already carries Option Explicit, so do not resend it), or resend with validate:'warn' to write it anyway and receive the finding as a warning diagnostic."
    d("note") = "refused BEFORE any write, snapshot or lint pass; the component was NOT modified."
    AddCodeDeclRefusal = JsonStringify(d)
End Function

Private Sub AddDeclPrecheckDiagnostics(ByVal pack As Object, ByVal declPre As Object)
    ' A warn-mode duplicate is reported as a WARNING diagnostic inside the same
    ' diagnostics[] array the linter fills, so a caller that filters by ruleId sees it
    ' without having to know about the extra root field.
    On Error Resume Next
    If pack Is Nothing Or declPre Is Nothing Then Exit Sub
    Dim fs As Object
    Set fs = declPre("findings")
    If fs Is Nothing Then Exit Sub
    If fs.Count = 0 Then Exit Sub
    Dim diags As Object
    Set diags = pack("diagnostics")
    If diags Is Nothing Then Exit Sub
    Dim i As Long
    For i = 1 To fs.Count
        Dim f As Object
        Dim d As Object
        Set f = fs(i)
        Set d = CreateObject("Scripting.Dictionary")
        If CStr(f("kind")) = "option_explicit" Then
            d("ruleId") = "duplicate_option_explicit"
        Else
            d("ruleId") = "duplicate_declaration"
        End If
        d("severity") = "warning"
        d("editLine") = CLng(f("editLine"))
        d("message") = CStr(f("message"))
        d("source") = "add_code_precheck"
        diags.Add d
    Next i
    pack("precheckDiagnosticCount") = fs.Count
    On Error GoTo 0
End Sub
Private Function ToolAddCode(ByVal component As String, ByVal code As String, ByVal file As String, ByVal validateMode As String) As String
    ' (d): segmented timing, the same shape replace_code/edit_by_anchor report.
    Dim tEntryA As Long
    tEntryA = GetTickCount()
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, component)
    Dim cm As VBIDE.CodeModule
    Set cm = comp.CodeModule
    If cm Is Nothing Then Err.Raise vbObjectError + 51, "CodeTools", "Component has no code module: " & component
    Dim addedFrom As String
    Dim body As String
    Dim srcPath As String
    srcPath = ""
    Dim srcEncoding As String
    srcEncoding = ""
    ' pane-encoding round-trip gate (see UnencodableRefusal)
    Dim pfBack As String
    Dim pfAt As Long
    If Len(file) > 0 Then
        srcPath = ResolvePath(file)
        ' item 2: append the FILE'S BODY, not its designer head.
        ' An earlier measurement found that AddFromFile injects the header verbatim into the pane
        ' AND renames the target component from the file's Attribute VB_Name. The
        ' structural strip removes the head; verifyPane=False because the object being
        ' split here is a source FILE, not a code pane (the file-vs-pane decision).
        ' the source is read through the VERIFIED path (detect -> decode ->
        ' re-encode -> byte compare).  A source file whose bytes cannot be decoded
        ' without loss is a STRUCTURED REFUSAL, never U+FFFD text that would then be
        ' written into the pane.  ReadLogAnsi keeps its old body for the compiler log.
        Dim srcWhy As String
        Dim srcText As String
        If Not Build.ReadSourceText(srcPath, srcText, srcEncoding, srcWhy) Then
            Dim rfb As Object
            Set rfb = CreateObject("Scripting.Dictionary")
            rfb("ok") = False
            rfb("tool") = "add_code"
            rfb("component") = comp.Name
            rfb("reason") = "unreadable_source_encoding"
            rfb("detail") = srcWhy
            rfb("file") = srcPath
            rfb("inputEncoding") = srcEncoding
            ToolAddCode = JsonStringify(rfb)
            Exit Function
        End If
        ' R-1021-01: a MISSING file= must not be treated as an EMPTY file. ReadSourceText
        ' keeps its historical "empty or unreadable == nothing to append" semantics, so a
        ' missing path silently produced an EMPTY block (add_code then reported a phantom
        ' landing mismatch, and before the Encoding guard it also CREATED the missing
        ' file). Refuse structurally BEFORE the pane is touched.
        If Len(Dir$(srcPath)) = 0 Then
            Dim rnf As Object
            Set rnf = CreateObject("Scripting.Dictionary")
            rnf("ok") = False
            rnf("tool") = "add_code"
            rnf("component") = comp.Name
            rnf("reason") = "file_not_found"
            rnf("attemptedPath") = srcPath
            rnf("file") = srcPath
            rnf("created") = False
            rnf("sideEffects") = "none: nothing was created, deleted or opened for write"
            rnf("detail") = "the file= path does not exist. add_code refuses to treat a missing source file as an empty block: nothing is appended and no file is created."
            ToolAddCode = JsonStringify(rnf)
            Exit Function
        End If
        body = StrippedDiskText(srcText, "", False)
        addedFrom = "file"
    ElseIf Len(code) > 0 Then
        body = code
        addedFrom = "string"
    Else
        Err.Raise vbObjectError + 52, "CodeTools", "code or file is required"
    End If
    ' (the structural-gate review/the wording review): the same PRE-WRITE structural gate as replace_code.
    Dim pairRefA As String
    pairRefA = PreWritePairingRefusal("add_code", comp.Name, body, "the appended block (addedFrom=" & addedFrom & ")")
    If Len(pairRefA) > 0 Then
        ToolAddCode = pairRefA
        Exit Function
    End If
    Dim cur As String
    ' guard the empty-component case (CountOfLines = 0 => Lines(1,0) = error 5);
    ' add_code into an EMPTY module is legal and must write the first line.
    If cm.CountOfLines > 0 Then cur = cm.Lines(1, cm.CountOfLines)
    Dim curLines() As String
    curLines = McpCls.TextLines(Me, cur)
    ' ---- PRE-WRITE duplicate-declaration gate: the conflict is found BEFORE the write,
    ' not by linting the result afterwards. validate:'strict' refuses; warn/off writes and
    ' reports the finding as a warning diagnostic (never as a blocking error).
    Dim declPre As Object
    Set declPre = Nothing
    On Error Resume Next
    Set declPre = AddCodeDupDeclFindings(cur, body, LineCount(cur) + 1)
    Dim declErr As Long
    declErr = Err.Number
    Err.Clear
    On Error GoTo 0
    If declPre Is Nothing Then
        Set declPre = CreateObject("Scripting.Dictionary")
        declPre("checkPerformed") = False
        declPre("checkReason") = "the textual duplicate-declaration scan raised VB error " & CStr(declErr) & "; the write proceeds and the result is linted exactly as before"
        Set declPre("findings") = New Collection
        declPre("findingCount") = 0
    End If
    If CBool(declPre("checkPerformed")) Then
        If CLng(declPre("findingCount")) > 0 Then
            If LCase$(Trim$(validateMode)) = "strict" Then
                ToolAddCode = AddCodeDeclRefusal(comp.Name, declPre, cur, cm.CountOfLines)
                Exit Function
            End If
        End If
    End If
    Dim tReadA As Long
    tReadA = GetTickCount()
    ' ---- beta-2: appending must not extend a continued statement
    If IsContinuationTail(curLines, cm.CountOfLines + 1) Then
        ToolAddCode = GuardReject(comp.Name, "add_code", "inside_continuation", _
            "the last line ends with a VB continuation _, so appending would extend that logical statement. Close the statement first, then add the code.", _
            0, 0, cm.CountOfLines)
        Exit Function
    End If
    ' ---- beta-3: lint the RESULT before it is written (warn-only)
    Dim predicted As String
    predicted = cur
    If Len(predicted) > 0 And Len(body) > 0 Then predicted = predicted & vbCrLf
    predicted = predicted & Replace(Replace(body, vbCrLf, vbLf), vbCr, vbLf)
    ' (the structural-gate review reverse direction): the appended text must not leave the module
    ' with an open procedure (the block-level gate above would have caught an extra end).
    Dim ppRefA As String
    ppRefA = PredictedPairingRefusal("add_code", comp.Name, cur, predicted, "the appended block (addedFrom=" & addedFrom & ")")
    If Len(ppRefA) > 0 Then
        ToolAddCode = ppRefA
        Exit Function
    End If
    Dim pack As Object
    ' region target = the first line the appended code lands on.
    Dim tPredictA As Long
    tPredictA = GetTickCount()
    Set pack = LintPackForEdit(predicted, KindOfName(component), cm.CountOfLines, LineCount(cur) + 1)
    Dim tLintA As Long
    tLintA = GetTickCount()
    ' gamma-4
    Dim acref As String
    acref = StrictRefusal(component, "add_code", pack, validateMode)
    If Len(acref) > 0 Then
        ToolAddCode = acref
        Exit Function
    End If
    Dim tWriteA As Long
    tWriteA = GetTickCount()
    ' item 2: insert the head-stripped BODY at the END of the module.
    ' AddFromFile (the old call) appended at the end - that is what the tool description
    ' promises ("Append code to a component's code module"). VB6's CodeModule.AddFromString
    ' inserts at the CARET, NOT at the end: measured in this session, a freshly loaded
    ' 3-line module grew at LINE 2 when AddFromString was used, i.e. the naive translation
    ' of this item would have been a regression (the code would land next to the caret
    ' instead of at the end, and the caret is wherever the IDE left it).
    ' InsertLines(CountOfLines + 1) is the explicit end-append and also covers an EMPTY
    ' module (Line = 1). The `code` STRING branch is deliberately left exactly as it was -
    ' it used AddFromString before this card and still does; its caret dependence is
    ' pre-existing and is reported as a new finding, not silently changed here.
    ' (B-family): BOTH branches append at the END of the module.  The string
    ' branch used AddFromString, which inserts at the CARET: measured on this build, a
    ' request whose receipt said requestedRange.start_line=15 landed the block at LINE 2
    ' (the caret position), so the tool description ("Append code to a component's code
    ' module") was false AND the receipt described the REQUEST instead of the write.
    ' InsertLines(CountOfLines + 1) is the explicit end-append (it also covers an EMPTY
    ' module, Line = 1); the read-back below still MEASURES where the block landed.
    ' the VB6 code pane is ANSI-backed; prove the block survives an ACP
    ' round trip before it is inserted (add_code{file=} can carry a UTF-8 source with an
    ' astral character, which InsertLines would turn into '?').
    If Len(body) > 0 Then
        If Not Encoding.TextEncodableEx(body, "ansi", pfBack, pfAt) Then
            ToolAddCode = UnencodableRefusal("add_code", comp.Name, "ansi", body)
            Exit Function
        End If
    End If
    Dim reqLanding As Long
    reqLanding = cm.CountOfLines + 1
    cm.InsertLines reqLanding, body
    Dim tWriteEndA As Long
    tWriteEndA = GetTickCount()
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = comp.Name
    root("addedFrom") = addedFrom
    root("sourceEncoding") = srcEncoding   ': which encoding the source was read as
    Dim paneAfter As String
    paneAfter = CompText(comp.Name)
    Dim textTotal As Long, ideTotal As Long
    textTotal = LineCount(paneAfter)
    ideTotal = cm.CountOfLines
    ' same one basis as replace_code - the caller sees splitlines semantics.
    Dim paneTotal As Long
    paneTotal = PaneLineCount(paneAfter)
    root("newTotalLines") = paneTotal
    root("ideTotalLines") = ideTotal
    root("textTotalLines") = textTotal
    root("trailingBlankLine") = TrailBlank(paneAfter)
    If (ideTotal - TrailCount(paneAfter)) <> paneTotal Then root("syncWarning") = SyncWarningText(ideTotal, paneTotal)
    ' (B-family): requestedRange is what the CALLER asked for, computed BEFORE
    ' the write (the old line used the post-write count, which is how a 12-line module
    ' produced requestedRange.start_line=15).  appliedRange is the MEASURED landing: the
    ' post-write pane is compared with "old text + appended block"; when that matches, the
    ' block starts on the first line after the old text, otherwise the first line that
    ' DIFFERS is reported - so the receipt can never describe a write that did not happen.
    Dim expText As String
    Dim landedLine As Long
    Dim landedVerified As Boolean
    expText = cur
    If Len(expText) > 0 And Len(body) > 0 Then expText = expText & vbCrLf
    expText = expText & Replace(Replace(body, vbCrLf, vbLf), vbCr, vbLf)
    landedVerified = (NormalizeNewlines(paneAfter) = NormalizeNewlines(expText))
    If landedVerified Then
        landedLine = LineCount(cur) + 1
    Else
        landedLine = FirstDifferingLine(cur, paneAfter)
    End If
    If landedLine < 1 Then landedLine = 1
    Set root("requestedRange") = RangeDict("add_code", reqLanding, reqLanding)
    Set root("appliedRange") = AppliedRangeDict(landedLine, landedLine + LineCount(NormalizeNewlines(body)) - 1)
    root("landedLine") = landedLine
    root("landedVerified") = landedVerified
    root("clamped") = False
    Set root("coords") = CoordsDictOfName(comp.Name, landedLine, "ide")
    ' The landing in BOTH coordinate spaces, named explicitly: a caller that edits again
    ' must not have to know whether appliedRange uses IDE or file lines. disk is derived
    ' from the same whole-module alignment the other receipts use (0 when unresolved).
    Dim insAt As Object
    Set insAt = CreateObject("Scripting.Dictionary")
    insAt("ide") = landedLine
    insAt("disk") = CoordsDiskLineOf(comp.Name, landedLine)
    insAt("lineSpace") = "ide"
    insAt("diskLineBasis") = "component FILE line derived from the whole-module pane->disk alignment; 0 means the alignment could not be resolved"
    Set root("insertedAt") = insAt
    ' Whether the block landed in the module's DECLARATION AREA - DEFINED as "before the
    ' first procedure header line" (where Option Explicit / module-level Dim/Const/Type
    ' live), NOT "outside an unclosed procedure body".  add_code appends at the END, so on
    ' a module that already has a procedure this is FALSE; an insert ABOVE the first
    ' procedure header is TRUE.  COMPUTED from the resulting text, never assumed.
    root("inDeclarationArea") = IsDeclarationAreaAt(paneAfter, landedLine)
    root("sha256Before") = Sha256.Sha256HexTextUtf8(cur)
    root("sha256After") = Sha256.Sha256HexTextUtf8(paneAfter)
    root("lineDelta") = LineCount(paneAfter) - LineCount(cur)
    ' ================= ok == "was it written" (ONE basis, no third meaning) ==============
    ' The OLD receipt ANDed the exact-content landing check into ok, so a write that the IDE
    ' normalised (measured: the trailing line break) reported ok:false although the pane HAD
    ' changed - the caller then appended the same block twice. The two questions are now
    ' separate: written = the pane text CHANGED; landedVerified = the result is EXACTLY
    ' (old text + appended block). ok answers "written"; when the exact check fails on a
    ' WRITTEN block the receipt explains it in landingNote / landingDifference instead of
    ' turning a successful write into a failure.
    Dim wroteIt As Boolean
    Dim dlExp As String
    Dim dlAct As String
    wroteIt = (cur <> paneAfter)
    root("written") = wroteIt
    root("writeOutcome") = "not_written"
    If wroteIt Then root("writeOutcome") = "appended"
    root("ok") = wroteIt
    root("okBasis") = "ok = the pane text changed (the write happened). Content verification is the SEPARATE landedVerified field (result == old text + appended block). Warnings never change ok; every refusal carries reason."
    If Not wroteIt Then
        root("reason") = "no_write"
        root("okReason") = "the pane text is unchanged after InsertLines, so nothing was written (empty or whitespace-only block)"
        root("detail") = "add_code appends with InsertLines(CountOfLines + 1) and then MEASURES the pane; the measurement says the module did not change. Re-read the component and retry with a non-empty block."
    ElseIf Not landedVerified Then
        dlExp = RTrim$(NormalizeNewlines(expText))
        dlAct = RTrim$(NormalizeNewlines(paneAfter))
        root("landingDifference") = "content_mismatch"
        If dlExp = dlAct Then root("landingDifference") = "trailing_line_break_only"
        root("landingNote") = "THE WRITE HAPPENED but the resulting text is not exactly (old text + appended block); landingDifference says whether only the trailing line break was normalised by the IDE or the content differs. ok is true because the write happened - verify with sha256After / newTotalLines / appliedRange and do NOT append the same block again."
    End If
    AddPaneDiskFields root, comp.Name, paneAfter
    ' ---- duplicate-declaration PRE-WRITE check echo (fixed shape on every receipt) ----
    If CBool(declPre("checkPerformed")) Then
        root("declaredCheck") = "performed"
    Else
        root("declaredCheck") = "not_performed"
        root("declaredCheckReason") = CStr(declPre("checkReason"))
    End If
    root("declaredCheckBasis") = "textual scan of (current pane text) + (submitted block) for Option Explicit and module-level Dim/Const/Type/Enum names; case-insensitive; #If conditional branches are NOT evaluated; declaration placement after a procedure is NOT judged here; this is not a compiler"
    Set root("duplicateDeclarations") = declPre("findings")
    root("duplicateDeclarationCount") = CLng(declPre("findingCount"))
    root("duplicatePolicy") = "strict: refuse BEFORE the write (ok:false + reason duplicate_option_explicit | duplicate_declaration, nothing written); warn/off: write anyway and report each finding as a WARNING diagnostics entry (source=add_code_precheck) - never as a blocking error"
    AddDeclPrecheckDiagnostics pack, declPre
    CopyLintPack root, pack
    root("readMs") = tReadA - tEntryA
    root("predictMs") = tPredictA - tReadA
    root("lintMs") = tLintA - tPredictA
    root("writeMs") = tWriteEndA - tWriteA
    ' PURE ADDITION. insMs is the AddFromString/AddFromFile interval (the
    ' same interval writeMs covers; writeMs itself is unchanged) and add_code never
    ' deletes, so delMs is 0. Key shapes/values of the pre-existing keys do not move.
    root("insMs") = tWriteEndA - tWriteA
    root("delMs") = 0
    root("writeCalls") = 1
    ' AddFromString/AddFromFile appends one block => hunks = 1 (same meaning
    ' as everywhere else in the write receipts; CONTRACTS §3).
    root("hunks") = 1
    root("totalMs") = GetTickCount() - tEntryA
    ToolAddCode = ReceiptJson(root)
End Function

Private Function ToolCreateEventProc(ByVal component As String, ByVal objName As String, ByVal eventName As String) As String
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, component)
    Dim cm As VBIDE.CodeModule
    Set cm = comp.CodeModule
    If cm Is Nothing Then Err.Raise vbObjectError + 51, "CodeTools", "Component has no code module: " & component
    Dim line As Long
    line = cm.CreateEventProc(eventName, objName)
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = comp.Name
    root("proc") = objName & "_" & eventName
    root("startLine") = line
    ToolCreateEventProc = JsonStringify(root)
End Function

' ===================== the find_in_component SEARCH WINDOW =====================
' This tool is a search-window tool, and the window is now VALIDATED instead of silently
' repaired. Everything below was MEASURED on the t16 sandbox (VB6 6.00.8176, add-in DLL
' sha256 79EA1688.., IDE pid 27868, component T126Find), not derived from the docs:
'
'  (1) DEGENERATE WINDOW - the reported accident. When start_line > CountOfLines the IDE's
'      CodeModule.Find does NOT answer "not found". It silently searches a DIFFERENT range
'      and answers a hit whose line is BEFORE the requested start_line:
'        count=10, a marker on every line, start_line=11 (default end_line=10):
'          ZZ09 -> found:true startLine:9 ; ZZ10 -> found:true startLine:10 ; ZZ08 -> false
'        start_line=12 and 20 answer the SAME lines 9/10 (the answer does not depend on how
'        far start_line overshoots), and with end_line=2 the same request also answered
'        lines 1 and 2. Deterministic (two identical rounds) and reproduced on 4 independent
'        components (TestModRenamed / T126Find / TestCls1 / Form1).
'      So an occurrence walk (start_line = hit + 1) can never be trusted: it silently rewinds
'      behind the position it asked for. The reachable line set could NOT be reduced to a rule
'      (ignored / 0-based / relative / swapped / last-N-lines each fail at least one
'      measurement), so this implementation does not model it - it REFUSES a degenerate
'      window and discards any hit the IDE reports outside the requested window.
'  (2) end_col=255 - a second silent false negative. The old default was the magic 255, so a
'      match starting beyond column 255 on the LAST line of the window was reported
'      not-found: a token at line 19 column 303 -> found:false, while the same call with
'      end_col=400 -> found:true 19:303. The default is now the whole end line.
'  (3) start_line IS honoured, and inclusively, for every VALID window: 25 argument shapes
'      (start_line / start_col / end_line / end_col / whole_word / match_case /
'      pattern_search) plus an 8-occurrence walk over 4 components produced 0 hits before the
'      requested start_line and 0 non-monotonic steps. The documented meaning ("the line at
'      which you want to start the search") is exact.
'
' Contract implemented here:
'   * absent start_line / start_col default to 1, absent end_line to CountOfLines, absent
'     end_col to the whole end line;
'   * an EXPLICIT out-of-range or inverted coordinate is a STRUCTURED REFUSAL, never a clamp
'     (the old code clamped <1 to the default and handed end_line < start_line straight to
'     the IDE, which then took the degenerate fallback above);
'   * a hit outside the requested window is NOT accepted as a hit;
'   * the effective window and the defaults actually applied are echoed, so the not-found
'     echo (Find leaves its ByRef arguments untouched when it fails) cannot be mistaken for a
'     match.
Private Function ToolFindInComponent(ByVal args As Object, ByVal component As String, ByVal target As String, _
                                     ByVal startLine As Long, ByVal startCol As Long, ByVal endLine As Long, ByVal endCol As Long, _
                                     ByVal wholeWord As Boolean, ByVal matchCase As Boolean, ByVal patternSearch As Boolean, _
                                     ByVal wantProc As Boolean, ByVal wantLead As Boolean) As String
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, component)
    Dim cm As VBIDE.CodeModule
    Set cm = comp.CodeModule
    If cm Is Nothing Then Err.Raise vbObjectError + 51, "CodeTools", "Component has no code module: " & component
    Dim countOfLines As Long
    countOfLines = cm.CountOfLines
    Dim hasStartLine As Boolean, hasStartCol As Boolean, hasEndLine As Boolean, hasEndCol As Boolean
    hasStartLine = HasArg(args, "start_line")
    hasStartCol = HasArg(args, "start_col")
    hasEndLine = HasArg(args, "end_line")
    hasEndCol = HasArg(args, "end_col")
    ' the RAW request is echoed in every path (also in a refusal), so a caller can
    ' always tell "what I asked" from "what was searched" from "what was matched".
    Dim requested As Object
    Set requested = CreateObject("Scripting.Dictionary")
    requested("startLine") = startLine
    requested("startLineGiven") = hasStartLine
    requested("startColumn") = startCol
    requested("startColumnGiven") = hasStartCol
    requested("endLine") = endLine
    requested("endLineGiven") = hasEndLine
    requested("endColumn") = endCol
    requested("endColumnGiven") = hasEndCol
    requested("wholeWord") = wholeWord
    requested("matchCase") = matchCase
    requested("patternSearch") = patternSearch
    Dim wStartLine As Long, wStartCol As Long, wEndLine As Long, wEndCol As Long
    wStartLine = startLine
    wStartCol = startCol
    wEndLine = endLine
    wEndCol = endCol
    If Not hasStartLine Then wStartLine = 1
    If Not hasStartCol Then wStartCol = 1
    If Not hasEndLine Then wEndLine = countOfLines
    Dim defaultsUsed As Object
    Set defaultsUsed = New Collection
    If Not hasStartLine Then defaultsUsed.Add "start_line=1"
    If Not hasStartCol Then defaultsUsed.Add "start_col=1"
    If Not hasEndLine Then defaultsUsed.Add "end_line=CountOfLines=" & CStr(countOfLines)
    ' ---- the window is validated; an explicit bad coordinate is refused, never clamped ----
    If Len(target) = 0 Then
        ToolFindInComponent = McpFindTools.FindWindowReject(Me, comp.Name, "target_empty", _
            "target is empty, so there is nothing to search for. The IDE's own engine refuses it too, but only as an unnamed runtime error in the add-in wrapper; an empty search string is a caller bug.", _
            requested, countOfLines, defaultsUsed)
        Exit Function
    End If
    If countOfLines = 0 Then
        ToolFindInComponent = McpFindTools.FindWindowReject(Me, comp.Name, "component_has_no_code", _
            "the component's code module has no lines (CountOfLines=0), so there is no line to search. Add code first, then search.", _
            requested, countOfLines, defaultsUsed)
        Exit Function
    End If
    If hasStartLine And wStartLine < 1 Then
        ToolFindInComponent = McpFindTools.FindWindowReject(Me, comp.Name, "start_line_below_one", _
            "start_line=" & CStr(startLine) & " is out of range: the coordinate space is 1-based. Omit start_line to search from line 1.", _
            requested, countOfLines, defaultsUsed)
        Exit Function
    End If
    If hasStartCol And wStartCol < 1 Then
        ToolFindInComponent = McpFindTools.FindWindowReject(Me, comp.Name, "start_col_below_one", _
            "start_col=" & CStr(startCol) & " is out of range: the coordinate space is 1-based. Omit start_col to search from column 1.", _
            requested, countOfLines, defaultsUsed)
        Exit Function
    End If
    If hasEndLine And wEndLine < 1 Then
        ToolFindInComponent = McpFindTools.FindWindowReject(Me, comp.Name, "end_line_below_one", _
            "end_line=" & CStr(endLine) & " is out of range: the coordinate space is 1-based. Omit end_line to search to the last line.", _
            requested, countOfLines, defaultsUsed)
        Exit Function
    End If
    If wStartLine > countOfLines Then
        ' A start_line past the last line is the NATURAL END of a pagination walk, not a
        ' caller error. Answer found:false + no_more_hits and do NOT search: a degenerate
        ' window is exactly what makes CodeModule.Find answer OUTSIDE it (measured:
        ' start_line=11 on a 10-line module reported a hit at line 9/10, BEFORE the
        ' requested start), and that is the accident this branch prevents.
        ToolFindInComponent = McpFindTools.FindNoHitsJson(Me, comp.Name, requested, countOfLines, defaultsUsed, wStartLine, True)
        Exit Function
    End If
    If wEndLine > countOfLines Then
        ToolFindInComponent = McpFindTools.FindWindowReject(Me, comp.Name, "end_line_beyond_end", _
            "end_line=" & CStr(wEndLine) & " is past CountOfLines (" & CStr(countOfLines) & "). Omit end_line to search to the last line, or pass a value in 1.." & CStr(countOfLines) & ".", _
            requested, countOfLines, defaultsUsed)
        Exit Function
    End If
    If wEndLine < wStartLine Then
        ToolFindInComponent = McpFindTools.FindWindowReject(Me, comp.Name, "range_inverted", _
            "end_line=" & CStr(wEndLine) & " is before start_line=" & CStr(wStartLine) & ", so the window is empty. The old code passed this straight to the IDE, which then ignored end_line (measured: start_line=5/end_line=3 answered found:true at line 5, outside the requested window). Widen the range or omit end_line.", _
            requested, countOfLines, defaultsUsed)
        Exit Function
    End If
    If hasEndCol And wEndCol < 1 Then
        ToolFindInComponent = McpFindTools.FindWindowReject(Me, comp.Name, "end_col_below_one", _
            "end_col=" & CStr(endCol) & " is out of range: the coordinate space is 1-based. Omit end_col to cover the whole end line.", _
            requested, countOfLines, defaultsUsed)
        Exit Function
    End If
    If Not hasEndCol Then
        ' (2): never the magic 255 - the default covers the WHOLE end line.
        wEndCol = Len(cm.Lines(wEndLine, 1)) + 1
        defaultsUsed.Add "end_col=Len(Lines(" & CStr(wEndLine) & ",1))+1=" & CStr(wEndCol)
    End If
    Dim qStartLine As Long, qStartCol As Long, qEndLine As Long, qEndCol As Long
    qStartLine = wStartLine
    qStartCol = wStartCol
    qEndLine = wEndLine
    qEndCol = wEndCol
    Dim found As Boolean
    found = cm.Find(target, qStartLine, qStartCol, qEndLine, qEndCol, wholeWord, matchCase, patternSearch)
    ' a hit the IDE reports outside the requested window is NOT a hit for this request.
    Dim outOfWindow As Boolean
    outOfWindow = False
    If found Then
        If qStartLine < wStartLine Or qStartLine > wEndLine Then
            outOfWindow = True
            found = False
            qStartLine = wStartLine
            qStartCol = wStartCol
            qEndLine = wEndLine
            qEndCol = wEndCol
        End If
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = comp.Name
    root("found") = found
    root("startLine") = qStartLine
    root("startColumn") = qStartCol
    root("endLine") = qEndLine
    root("endColumn") = qEndCol
    Set root("searchRange") = McpFindTools.FindWindowDict(Me, wStartLine, wStartCol, wEndLine, wEndCol)
    Set root("requested") = requested
    Set root("defaultsUsed") = defaultsUsed
    If wantProc Or wantLead Then
        root("procedureMapping") = "COMMENT SEARCH additive mapping (module ProcMap): proc/procBodyLine/procStartLine come from the IDE CodeModule (ProcOfLine/ProcBodyLine/ProcStartLine); leadingComment is the contiguous single-quote comment block directly above the header with no blank line between. Flags absent => this receipt is key-for-key unchanged."
    End If
    If found Then
        ' alpha: cm.Find is ByRef on the line/column arguments, so the locals
        ' hold the FOUND position (an IDE CodeModule line) once found; coords states that.
        Dim hitObj As Object, hitList As Object
        Set hitObj = McpFindTools.FindWindowDict(Me, qStartLine, qStartCol, qEndLine, qEndCol)
        If wantProc Or wantLead Then AddProcFieldsIde cm, hitObj, qStartLine, wantLead
        Set hitList = New Collection
        hitList.Add hitObj
        Set root("hits") = hitList
        root("count") = 1
        ' nextStartLine is the line a caller passes as start_line to read the NEXT hit.
        root("nextStartLine") = qStartLine + 1
        root("advanceRule") = "pass start_line = nextStartLine to read the next hit; a start_line past the last line answers found:false + reason=no_more_hits"
        Set root("match") = hitObj
        root("coordsOf") = "match"
        Set root("coords") = CoordsDictOfName(comp.Name, qStartLine, "ide")
    Else
        root("ok") = True
        root("coordsOf") = "requestedStart"
        root("positionFieldsAreRequest") = True
        Set root("coords") = CoordsDictOfName(comp.Name, wStartLine, "ide")
        Dim emptyHits As Object
        Set emptyHits = New Collection
        Set root("hits") = emptyHits
        root("count") = 0
        ' A continuation page (start_line > 1) that finds nothing is "there are no more
        ' hits after here"; a first page that finds nothing is "not found".
        If hasStartLine And wStartLine > 1 Then
            root("reason") = "no_more_hits"
            root("noMoreHits") = True
        Else
            root("reason") = "not_found"
            root("noMoreHits") = False
        End If
        Dim nt As String
        nt = "found:false. startLine/startColumn/endLine/endColumn are the REQUESTED window, NOT a match (CodeModule.Find leaves its ByRef arguments unchanged when it fails); searchRange is what was actually searched."
        If outOfWindow Then
            root("discardedOutOfWindow") = True
            nt = nt & " The IDE DID answer a position, but it was OUTSIDE the requested window, so it was discarded instead of being reported as a hit."
        End If
        root("note") = nt
    End If
    ToolFindInComponent = JsonStringify(root)
End Function

' The pagination terminus: nothing was searched because there is nothing past start_line.
' ok:true because the REQUEST was answerable - found:false + reason=no_more_hits is the
' answer, not a refusal. Same shape as the searched-but-empty path so a caller can treat
' every page identically.



Private Function ToolGetCodePane(ByVal component As String) As String
    Dim cp As VBIDE.CodePane
    Set cp = GetCodePane(component)
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = cp.CodeModule.Name
    root("topLine") = cp.TopLine
    root("countOfVisibleLines") = cp.CountOfVisibleLines
    root("view") = CodePaneViewName(cp.CodePaneView)
    Dim sl As Long, sc As Long, el As Long, ec As Long
    cp.GetSelection sl, sc, el, ec
    root("selectionStartLine") = sl
    root("selectionStartColumn") = sc
    root("selectionEndLine") = el
    root("selectionEndColumn") = ec
    On Error Resume Next
    root("windowCaption") = cp.Window.Caption
    On Error GoTo 0
    ToolGetCodePane = JsonStringify(root)
End Function

Private Function ToolSetCodePane(ByVal component As String, ByVal selection As String, ByVal topLine As Long, ByVal view As String, ByVal activate As Boolean) As String
    Dim cp As VBIDE.CodePane
    Set cp = GetCodePane(component)
    ' (R18-2): set_codepane moves the SELECTION and the SCROLL position, never
    ' the text. The pane text is captured here and asserted at the end.
    Dim pAssertComp As String, pAssertBefore As String
    Dim pAssertOn As Boolean
    pAssertComp = cp.CodeModule.Name
    pAssertBefore = PaneTextOfName(pAssertComp, pAssertOn)
    Dim applied As Object
    Set applied = New Collection
    If Len(selection) > 0 Then
        Dim parts() As String
        parts = Split(selection, ",")
        If UBound(parts) < 3 Then Err.Raise vbObjectError + 53, "CodeTools", "selection must be startLine,startCol,endLine,endCol"
        cp.SetSelection CLng(Val(parts(0))), CLng(Val(parts(1))), CLng(Val(parts(2))), CLng(Val(parts(3)))
        applied.Add "selection"
    End If
    If topLine > 0 Then
        cp.TopLine = topLine
        applied.Add "topLine"
    End If
    Dim ignoredView As Boolean
    ignoredView = False
    If Len(view) > 0 Then
        ' \`view\` is no longer DECLARED in this tool's inputSchema. VB6EXT v5.3
        ' exposes CodePane.CodePaneView as GET-ONLY (its put-map holds only TopLine) and has
        ' no \`View\` property at all; a real-IDE scan of all 34 command bars found no view
        ' toggle. The request is still refused by reality - but it is now REPORTED
        ' (ignoredArgs) instead of being answered with a silent no-op (discipline 38).
        applied.Add "view-ignored"
        ignoredView = True
    End If
    ' (A) close-out: activate=True SHOWS the pane, which can raise the IDE's
    ' own window. Same class as activate_component / native_breakpoint: cannot be
    ' suppressed (it IS the request), so quiet mode compensates.
    Dim fgBefore As Long
    Dim fgAfter As Long
    Dim quietOn As Boolean
    If activate Then
        fgBefore = WoFrontHwnd()
        cp.Show
        applied.Add "activated"
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = cp.CodeModule.Name
    If activate Then
        fgAfter = WoFrontHwnd()
        quietOn = QuietActive()
        If quietOn And fgAfter <> fgBefore Then
            WoFrontRestore fgBefore
            fgAfter = WoFrontHwnd()
        End If
        root("foregroundBefore") = fgBefore
        root("foregroundAfter") = fgAfter
        root("foregroundTookFocus") = (fgAfter <> fgBefore)
        root("foregroundReadable") = (fgBefore <> 0 Or fgAfter <> 0)
        If quietOn Then
            root("quietModeSuppressedFocus") = False
            root("quietModeForegroundRestored") = (fgAfter = fgBefore)
            root("quietModeNote") = "quiet mode is ON. activate=True SHOWS the pane - that is the request - so it was not suppressed; the foreground was taken and then GIVEN BACK (foregroundTookFocus / quietModeForegroundRestored say which). A call WITHOUT activate does not report these fields at all."
        End If
    End If
    Set root("applied") = applied
    If ignoredView Then
        root("ignoredArgs") = Array("view")
        root("ignoredArgsNote") = "set_codepane has no view-mode parameter: VB6's extensibility model exposes " & _
            "CodePane.CodePaneView as READ-ONLY (VB6EXT v5.3, the _CodePane put-map holds only TopLine) and the IDE's " & _
            "34 command bars carry no view toggle, so the code pane view cannot be switched from an add-in. The rest of " & _
            "this call WAS applied (see applied) - the argument is reported here rather than silently ignored. Inspect the " & _
            "current mode with get_codepane.view; switch it with the IDE's own Full Module / Procedure View buttons."
    End If
    ' R18-2: a selection/scroll change must not rewrite the pane text.
    PaneAssertFinish root, pAssertComp, pAssertBefore, pAssertOn, "set_codepane"
    ToolSetCodePane = JsonStringify(root)
End Function

Private Function ToolGetSelection() As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    On Error Resume Next
    Dim ap As VBIDE.VBProject
    Set ap = m_vbe.ActiveVBProject
    If Not ap Is Nothing Then root("activeProject") = ap.Name
    Dim svc As VBIDE.VBComponent
    Set svc = m_vbe.SelectedVBComponent
    If Not svc Is Nothing Then
        root("selectedComponent") = svc.Name
        root("selectedComponentType") = ComponentTypeName(svc.Type)
    End If
    Dim aw As VBIDE.Window
    Set aw = m_vbe.ActiveWindow
    If Not aw Is Nothing Then root("activeWindow") = aw.Caption
    Dim cp As VBIDE.CodePane
    Set cp = m_vbe.ActiveCodePane
    If cp Is Nothing Then
        Dim fp As VBIDE.VBProject
        Set fp = GetProject()
        Dim fc As VBIDE.VBComponent
        For Each fc In fp.VBComponents
            Set cp = fc.CodeModule.CodePane
            If Not cp Is Nothing Then Exit For
        Next
    End If
    If Not cp Is Nothing Then
        root("activeCodeModule") = cp.CodeModule.Name
        Dim sl As Long, sc As Long, el As Long, ec As Long
        cp.GetSelection sl, sc, el, ec
        root("cursorLine") = sl
        root("cursorColumn") = sc
        root("selectionEndLine") = el
        root("selectionEndColumn") = ec
    End If
    On Error GoTo 0
    ToolGetSelection = JsonStringify(root)
End Function

Public Function ToolActivateComponent(ByVal name As String, ByVal window As String) As String
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    ' (A) close-out / issue #7: this tool's PURPOSE is to put a VBIDE window on
    ' screen, and doing that can raise the IDE's own top-level window - measured on the live
    ' IDE as a foreground CHANGE. It is the same class as native_breakpoint: it cannot be
    ' suppressed (showing the window IS the request), so quiet mode COMPENSATES by putting
    ' the user's window back afterwards, and says so instead of claiming a suppression.
    Dim fgBefore As Long
    fgBefore = WoFrontHwnd()
    Select Case LCase$(window)
        Case "code"
            Dim cm As VBIDE.CodeModule
            Set cm = comp.CodeModule
            If cm Is Nothing Then Err.Raise vbObjectError + 51, "CodeTools", "Component has no code module: " & name
            cm.CodePane.Show
        Case "designer"
            comp.DesignerWindow
        Case Else
            comp.Activate
    End Select
    Dim fgAfter As Long
    fgAfter = WoFrontHwnd()
    Dim quietOn As Boolean
    quietOn = QuietActive()
    Dim quietRestored As Boolean
    quietRestored = False
    If quietOn And fgAfter <> fgBefore Then
        WoFrontRestore fgBefore
        fgAfter = WoFrontHwnd()
        quietRestored = (fgAfter = fgBefore)
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = comp.Name
    root("window") = window
    root("foregroundBefore") = fgBefore
    root("foregroundAfter") = fgAfter
    root("foregroundTookFocus") = (fgAfter <> fgBefore)
    ' (A): foregroundReadable is a LIVE measurement; 0 means no foreground
    ' handle could be read (e.g. a locked or non-interactive desktop) and it is NEVER
    ' evidence that the focus was left alone.
    root("foregroundReadable") = (fgBefore <> 0 Or fgAfter <> 0)
    If quietOn Then
        root("quietModeSuppressedFocus") = False
        root("quietModeForegroundRestored") = quietRestored
        root("quietModeNote") = "quiet mode is ON. Showing a VBIDE window is this tool's whole purpose, so the action was NOT suppressed: the foreground was taken and then GIVEN BACK (foregroundTookFocus / quietModeForegroundRestored say which). This is the same compensation rule as native_breakpoint."
    End If
    ToolActivateComponent = JsonStringify(root)
End Function

