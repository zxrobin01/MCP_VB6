            root("dirtyProject") = True
        ElseIf lmTok = "false" Then
            root("dirtyProject") = False
        End If
        lmTok = IdeJsonToken(ideMakeJson, "dirtyFlagsUnreadable")
        If lmTok = "true" Then
            root("dirtyFlagsUnreadable") = True
        ElseIf lmTok = "false" Then
            root("dirtyFlagsUnreadable") = False
        End If
    End If
    root("elapsedMs") = GetTickCount() - el0
    If fp Is Nothing Then
        Set root("changed") = New Collection
    Else
        Set root("changed") = Build.NamesOf(changed)
    End If
    root("buildAdvised") = True
    root("advisedReason") = advisedWhy
    If Len(prepErr) > 0 Then root("prepError") = prepErr
    root("note") = "one build reports only the first error; timeout_ms bounds only the compiler subprocess (VB6.EXE /make), never the fingerprint/cache preprocessing and never an in-IDE Make"
    If cacheSkipDirty Then root("note") = "cache answer SKIPPED (project_dirty_cache_invalid): the project is dirty, so a cached artifact cannot speak for the source now in the editor. " & CStr(root("note"))
