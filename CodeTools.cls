    ' Re-sample the fingerprint AFTER the build so the cache describes the bytes that were
    ' actually compiled.
    Dim fpAfter As Object
    Dim compsAfter As Object
    Dim fpAfterErr As String
    Set fpAfter = Nothing
    Set compsAfter = Nothing
    On Error Resume Next
    Err.Clear
    Set fpAfter = Build.BuildFingerprint(vbp, defines, compsAfter)
    If Err.Number <> 0 Then fpAfterErr = Err.Description: Err.Clear
    On Error GoTo 0
    If Not fpAfter Is Nothing Then
        If CStr(fpAfter("hash")) <> CStr(fp("hash")) Then
