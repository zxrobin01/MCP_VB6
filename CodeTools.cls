' --- minimal JSON field reader for the captured-process JSON (no parser needed) ---
Public Function JsonFieldRaw(ByVal json As String, ByVal field As String) As String
    JsonFieldRaw = ""
    Dim key As String, i As Long, j As Long, ch As String, raw As String
    key = Chr$(34) & field & Chr$(34) & ":"
    i = InStr(1, json, key, vbBinaryCompare)
    If i = 0 Then Exit Function
    i = i + Len(key)
    Do While i <= Len(json) And Mid$(json, i, 1) = " "
        i = i + 1
    Loop
    If i > Len(json) Then Exit Function
    ch = Mid$(json, i, 1)
    If ch = Chr$(34) Then
        j = i + 1
        Do While j <= Len(json)
            ch = Mid$(json, j, 1)
            If ch = "\" Then
                j = j + 2
            ElseIf ch = Chr$(34) Then
                Exit Do
            Else
                j = j + 1
            End If
        Loop
        JsonFieldRaw = Mid$(json, i + 1, j - i - 1)
    Else
        j = i
        Do While j <= Len(json)
            ch = Mid$(json, j, 1)
            If ch = "," Or ch = "}" Then Exit Do
            raw = raw & ch
            j = j + 1
        Loop
        JsonFieldRaw = Trim$(raw)
    End If
End Function

Private Function JsonUnescape(ByVal s As String) As String
    ' was "out = out & ..." per character (quadratic in the decoded text,
    ' which is a git stdout / captured-process JSON field). A pre-sized buffer plus
    ' Mid$ assignment makes it O(n); the decoded text is never longer than the input
    ' (\r \n \t \" \\ \/ and \uXXXX all shrink). Bit-identical: measured on a
    ' 9.5 KB escaped string (same hash) and 475 KB decoded in 32 ms.
    Dim n As Long, i As Long, o As Long, buf As String, ch As String, nx As String
    n = Len(s)
    If n = 0 Then Exit Function
    buf = String$(n, " ")
    i = 1
    Do While i <= n
        ch = Mid$(s, i, 1)
        If ch = "\" And i < n Then
            nx = Mid$(s, i + 1, 1)
            o = o + 1
            If nx = "r" Then
                Mid$(buf, o, 1) = vbCr
            ElseIf nx = "n" Then
                Mid$(buf, o, 1) = vbLf
            ElseIf nx = "t" Then
                Mid$(buf, o, 1) = vbTab
            ElseIf nx = Chr$(34) Then
                Mid$(buf, o, 1) = Chr$(34)
            ElseIf nx = "\" Then
                Mid$(buf, o, 1) = "\"
            ElseIf nx = "/" Then
                Mid$(buf, o, 1) = "/"
            ElseIf nx = "u" Then
                Mid$(buf, o, 1) = ChrW$(CLng("&H" & Mid$(s, i + 2, 4)))
                i = i + 4
            Else
                Mid$(buf, o, 1) = nx
            End If
            i = i + 2
        Else
            o = o + 1
            Mid$(buf, o, 1) = ch
            i = i + 1
        End If
    Loop
    JsonUnescape = Left$(buf, o)
End Function

Private Function ParsePorcelain(ByVal text As String) As Object
    Dim arr As Object
    Set arr = New Collection
    Dim lines() As String, i As Long, ln As String
    text = Replace(Replace(text, vbCrLf, vbLf), vbCr, vbLf)
    lines = Split(text, vbLf)
    For i = 0 To UBound(lines)
        ln = lines(i)
        If Len(ln) > 3 Then
            If Left$(ln, 3) <> "## " Then
                Dim d As Object
                Set d = CreateObject("Scripting.Dictionary")
                d("status") = Left$(ln, 2)
                d("path") = Trim$(Mid$(ln, 4))
                arr.Add d
            End If
        End If
    Next
    Set ParsePorcelain = arr
End Function

Private Function BranchOfPorcelain(ByVal text As String) As String
    BranchOfPorcelain = ""
    Dim lines() As String, i As Long, b As String
    Dim p As Long
    text = Replace(Replace(text, vbCrLf, vbLf), vbCr, vbLf)
    lines = Split(text, vbLf)
    For i = 0 To UBound(lines)
        If Left$(lines(i), 3) = "## " Then
            b = Mid$(lines(i), 4)
            p = InStr(b, "...")
            If p > 0 Then b = Left$(b, p - 1)
            BranchOfPorcelain = Trim$(b)
            Exit Function
        End If
    Next
End Function

Private Function CountTag(ByVal text As String, ByVal tag As String) As Long
    CountTag = 0
    Dim p As Long, i As Long, s As String, ch As String
    p = InStr(1, text, tag, vbBinaryCompare)
    If p = 0 Then Exit Function
    i = p + Len(tag)
    Do While i <= Len(text)
        ch = Mid$(text, i, 1)
        If InStr("0123456789", ch) > 0 Then
            s = s & ch
            i = i + 1
        Else
            Exit Do
        End If
    Loop
    If Len(s) > 0 Then CountTag = CLng(s)
End Function

' delta-3 helper: read every .md in a folder and pull the status: line + the H1.
Private Sub CollectMd(ByVal dir As String, ByRef arr As Object)
    On Error Resume Next
    Dim fso As Object, fld As Object, f As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(dir) Then Exit Sub
    Set fld = fso.GetFolder(dir)
    Dim txt As String, ts As Object
    For Each f In fld.Files
        If LCase$(fso.GetExtensionName(f.Name)) = "md" Then
            ' (an earlier finding): OpenAsTextStream(1, -2) decodes with the system
            ' ANSI code page, so UTF-8 task cards came back as mojibake. Read the BYTES and
            ' decode with the detected encoding instead.
            Dim raw() As Byte
            Encoding.ReadAllBytesTo f.Path, raw
            txt = ""
            Encoding.DecodeBytes raw, Encoding.DetectEncoding(raw), txt
            Dim d As Object
            Set d = CreateObject("Scripting.Dictionary")
            d("file") = f.Name
            d("status") = ExtractLine(txt, "status:")
            d("title") = ExtractH1(txt)
            arr.Add d
        End If
    Next
End Sub

Private Function ExtractLine(ByVal text As String, ByVal prefix As String) As String
    ExtractLine = ""
    Dim lines() As String, i As Long, ln As String
    text = Replace(Replace(text, vbCrLf, vbLf), vbCr, vbLf)
    lines = Split(text, vbLf)
    For i = 0 To UBound(lines)
        ln = Trim$(lines(i))
        If LCase$(Left$(ln, Len(prefix))) = LCase$(prefix) Then
            ExtractLine = Trim$(Mid$(ln, Len(prefix) + 1))
            Exit Function
        End If
    Next
End Function

Private Function ExtractH1(ByVal text As String) As String
    ExtractH1 = ""
    Dim lines() As String, i As Long, ln As String
    text = Replace(Replace(text, vbCrLf, vbLf), vbCr, vbLf)
    lines = Split(text, vbLf)
    For i = 0 To UBound(lines)
        ln = Trim$(lines(i))
        If Left$(ln, 1) = "#" Then
            ExtractH1 = Trim$(Replace(ln, "#", ""))
            Exit Function
        End If
    Next
End Function

' turn "MCPREASON:<reason>|<field>|<field>" into a structured refusal.
Private Function McpReasonJson(ByVal tagged As String, ByVal toolName As String, ByVal args As Object) As String
    Dim rest As String, parts() As String
    rest = Mid$(tagged, 11)
    parts = Split(rest, "|")
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = parts(0)
    d("tool") = toolName
    ' + (contract v1.3.2): vbErrorCode is ONLY for a VB error
    ' GENUINELY captured at the Fail handler. A "MCPREASON:" tag is OUR OWN guard
    ' refusal, so the raise that carries it (GuardSha's Err.Raise vbObjectError+81) is
    ' an implementation detail and must NOT surface as vbErrorCode - otherwise
    ' sha256_mismatch carried -2147221423 and looked like a captured VB error, which is
    ' exactly the tagged-refusal/pre-validation inconsistency an earlier verification found. The engine
    ' line is not read here either (this is not an IDE error). IdeBusyBreakJson, which
    ' IS a real IDE error, keeps AddErrorFields.
    ' the field mapping MUST be per-reason. It used to be unconditional - parts(1)
    ' and parts(2) hard-wired to expected/actualSha256 - which was correct only for the single
    ' reason that existed then (sha256_mismatch). A new reason would have handed the caller
    ' MISLEADING KEY NAMES (e.g. a colliding component name reported as "expectedSha256").
    Select Case LCase$(parts(0))
        Case "sha256_mismatch"
            If UBound(parts) >= 1 Then d("expectedSha256") = parts(1)
            If UBound(parts) >= 2 Then d("actualSha256") = parts(2)
        Case "name_collision", "import_path_is_member"
            ' parts(1) = the EXISTING component that caused the refusal,
            ' parts(2) = a suggested action. No sha pair is involved in these refusals.
            If UBound(parts) >= 1 Then d("existingComponent") = parts(1)
            If UBound(parts) >= 2 Then d("suggestedAction") = parts(2)
            Dim srcPath As String
            srcPath = ""
            On Error Resume Next
            srcPath = JsonGetStr(args, "path")
            On Error GoTo 0
            If Len(srcPath) > 0 Then d("sourceFile") = srcPath
            d("sideEffects") = "none: refused before the source snapshot, before AddFile and before SaveAs - the project directory, the component set and the caller's file are unchanged"
        Case "project_dir_unavailable", "project_dir_write_not_allowed"
            ' parts(1) = the suggested action, parts(2) = a one-line explanation.
            ' Neither reason involves a colliding component or a sha pair.
            If UBound(parts) >= 1 Then d("suggestedAction") = parts(1)
            If UBound(parts) >= 2 Then d("detail") = parts(2)
            Dim srcPath2 As String
            srcPath2 = ""
            On Error Resume Next
            srcPath2 = JsonGetStr(args, "path")
            On Error GoTo 0
            If Len(srcPath2) > 0 Then d("sourceFile") = srcPath2
            d("sideEffects") = "none: refused before the source snapshot, before AddFile and before SaveAs - the project directory, the component set, the caller's file and the add-in's own directory are unchanged"
        Case "no_project"
            ' raised by the shared GetProject() helper, so it can reach ANY
            ' project-scoped tool. parts(1) = suggested action, parts(2) = explanation.
            ' No component and no sha pair is involved, and the import wording below would
            ' be wrong here.
            d("reason") = "target_has_no_project"
            d("reasonLegacy") = "no_project"
            If UBound(parts) >= 1 Then d("suggestedAction") = parts(1)
            If UBound(parts) >= 2 Then d("detail") = parts(2)
            d("sideEffects") = "none: nothing was read, written or modified - there is no open project in the VB6 IDE"
        Case "cancelled_by_request"
            ' a cooperative abort, raised from a pump loop.
            If UBound(parts) >= 1 Then d("cancelledTool") = parts(1)
            If UBound(parts) >= 2 Then d("cancelledKind") = parts(2)
            d("cancelledByTool") = m_cancelByTool
            d("cancelAgeMs") = GetTickCount() - m_cancelAt
            If UBound(parts) >= 3 Then
                If LCase$(parts(3)) = "timeoutalsodue" Then d("timeoutAlsoDue") = True
            End If
            d("note") = "the in-flight call stopped at its own pump point because a re-entrant READ-ONLY call asked it to. Its own sideEffects/undoSnapshots report any partial work; nothing outside what it had already done was touched."
            d("suggestedAction") = "re-read the component/pane state before retrying, because the aborted call may have completed part of its work. To stop a call blocked inside a HOST modal loop (where none of our pump points run) use the hub tool ide_restart."
        Case "anchor_not_found", "anchor_not_unique", "unknown_op"
            ' an anchor that does not resolve - and an op outside R/I/D - is CALLER
            ' INPUT, so it answers with a branchable refusal instead of the bare +84 raise that
            ' surfaced as ok:false/unexpected_error/vbErrorCode:-2147221420. The tag parts are
            ' NUMBERS ONLY (EngineRefusalTag); the anchor/op/occurrence are read back out of the
            ' caller's OWN args, so arbitrary anchor text never has to survive the "|"-separated
            ' channel. Every read below is guarded: a diagnostic must never turn a refusal into an
            ' unexpected error ('s state-axis lesson).
            On Error Resume Next
            Dim nfIdx As Long, nfHits As Long, nfPane As Long
            nfIdx = -1
            nfHits = 0
            nfPane = 0
            If UBound(parts) >= 1 Then nfIdx = CLng("0" & parts(1))
            If UBound(parts) >= 2 Then nfHits = CLng("0" & parts(2))
            If UBound(parts) >= 5 Then nfPane = CLng("0" & parts(5))
            If nfIdx >= 0 Then d("failedOpIndex") = nfIdx
            d("hitCount") = nfHits
            If UBound(parts) >= 3 Then d("containsHits") = CLng("0" & parts(3))
            If UBound(parts) >= 4 Then
                If CLng("0" & parts(4)) > 0 Then d("firstContainsLine") = CLng("0" & parts(4))
            End If
            If nfPane > 0 Then d("paneLines") = nfPane
            If UBound(parts) >= 6 Then d("anchorHasCrLf") = (CLng("0" & parts(6)) <> 0)
            d("match") = "normalized"
            d("normalizationApplied") = "LCase + Trim$ (VB6 Trim$ strips SPACES only) + TAB -> space"
            d("noHitAfterNormalization") = (nfHits = 0)
            Dim edList As Object, opItem As Object
            Dim effMch As String
            effMch = ""
            Set edList = AnyObjOf(args, "edits")
            If nfIdx >= 0 Then
                If nfIdx < CollectionCount(edList) Then
                    Set opItem = edList(nfIdx + 1)
                    If Not opItem Is Nothing Then
                        d("anchor") = McpCls.DictStr(Me, opItem, "anchor")
                        d("op") = UCase$(McpCls.DictStr(Me, opItem, "op"))
                        If JsonGetLong(opItem, "occurrence", 0) > 0 Then d("occurrence") = JsonGetLong(opItem, "occurrence", 0)
                        effMch = Trim$(McpCls.DictStr(Me, opItem, "match"))
                    End If
                End If
            End If
            On Error GoTo 0
            If LCase$(parts(0)) = "unknown_op" Then
                Dim allowedOps As Object
                Set allowedOps = New Collection
                allowedOps.Add "R"
                allowedOps.Add "I"
                allowedOps.Add "D"
                Set d("allowedOps") = allowedOps
            End If
            On Error Resume Next
            Select Case LCase$(parts(0))
                Case "anchor_not_found"
                    d("note") = "nothing was written (preview_edit is read-only). The anchor matched 0 of the " & CStr(nfPane) & " pane line(s) under the engine's normalization, so a case / indentation / TAB difference is NOT the cause. See containsHits / firstContainsLine (the anchor is a FRAGMENT of a real line) and anchorHasCrLf (a single anchor is matched against exactly ONE pane line, so an anchor carrying CR/LF can never match)."
                    d("hint") = "call get_component_code{coords:'ide'} and copy the exact single line you want to change"
                Case "anchor_not_unique"
                    d("note") = "nothing was written (preview_edit is read-only). The anchor matched " & CStr(nfHits) & " pane line(s), and preview_edit requires a UNIQUE anchor."
                    d("hint") = "make the anchor unique (widen it), or use apply_edits / edit_by_anchor with an explicit occurrence"
                Case "unknown_op"
                    d("note") = "nothing was written. The op field must be one of R (replace), I (insert after) or D (delete); allowedOps lists them."
                    d("hint") = "set op to R, I or D"
            End Select
            ' with a per-op match="exact" the counts above ARE exact counts, so the
            ' normalized wording would name the wrong cause ("a case difference is NOT the cause"
            ' is false under exact matching - discipline 39). This branch runs ONLY when exact is
            ' in play, so a default-shaped refusal keeps its historical keys and text byte for byte.
            If LCase$(effMch) = "exact" And (LCase$(parts(0)) = "anchor_not_found" Or LCase$(parts(0)) = "anchor_not_unique") Then
                d("match") = "exact"
                d.Remove "normalizationApplied"
                d.Remove "noHitAfterNormalization"
                d("matchApplied") = "binary (vbBinaryCompare) compare of the RAW pane line against the RAW anchor: case and indentation are significant"
                d("noHitWithExactMatch") = (nfHits = 0)
                Select Case LCase$(parts(0))
                    Case "anchor_not_found"
                        d("note") = "nothing was written (preview_edit is read-only). Under EXACT matching the anchor matched 0 of the " & CStr(nfPane) & " pane line(s). Unlike the normalized default, a case / indentation difference IS a possible cause here: drop match=""exact"" to compare normalized. See containsHits / firstContainsLine (a FRAGMENT of a real line, compared RAW here) and anchorHasCrLf (one anchor is matched against exactly ONE pane line)."
                        d("hint") = "copy the exact pane line from get_component_code{coords:'ide'} verbatim (indentation included), or drop match=""exact"" to use the default normalized matching"
                    Case "anchor_not_unique"
                        d("note") = "nothing was written (preview_edit is read-only). Under EXACT matching the anchor matched " & CStr(nfHits) & " pane line(s) and no occurrence was given."
                        d("hint") = "make the anchor unique (widen it) or pass an explicit per-op occurrence"
                End Select
            End If
            On Error GoTo 0
            ' the same per-op audit as the success path, so a caller can see WHICH
            ' per-op key was NOT honoured (moved match/occurrence into the honoured
            ' set, so only a per-op scope can still show up here). Gated on the tool name:
            ' edit_by_anchor answers these reasons with its own receipt, so its shape must not move.
            Dim opkHon As String
            Dim opkMine As Boolean
            opkMine = False
            If LCase$(toolName) = "preview_edit" Then opkMine = True
            If LCase$(toolName) = "apply_edits" Then opkMine = True
            If opkMine Then
                ' preview_edit now resolves through the same pipeline as apply_edits
                ' and honours the same per-op keys, so both tools share ONE honoured set here.
                opkHon = "|op|anchor|text|match|occurrence|"
                On Error Resume Next
                If LCase$(toolName) = "apply_edits" Then
                    OpKeyAuditInto d, AnyObjOf(args, "edits"), opkHon, NoteApplyEditsOpKeys()
                Else
                    OpKeyAuditInto d, AnyObjOf(args, "edits"), opkHon, NotePreviewOpKeys()
                End If
                On Error GoTo 0
            End If
        Case "pane_not_settled"
            ' FIX-24 (F1): the name did not resolve because a Reload renamed the component moments
            ' ago (measured: modFix -> Module1 -> modFix). That is a TRANSIENT window, not a wrong
            ' name, so it must not read like component_not_found.
            On Error Resume Next
            d("requestedComponent") = m_settleFrom
            d("resolvedNameAfter") = m_settleTo
            d("componentRenamedByReload") = True
            d("settleAgeMs") = m_settleAgeMs
            d("settleWindowMs") = RELOAD_SETTLE_WINDOW_MS
            d("retrySuggested") = True
            d("retryAction") = "retry the same call; the rename window is short. If it still misses, resolve the name with get_component_list and use resolvedNameAfter"
            d("note") = "nothing was read, written or modified: the component name did not resolve because the reload that just ran RENAMED that component. This is a transient window, not a bad name."
            d("howToProceed") = "retry now (the old name comes back), or re-issue the call with resolvedNameAfter"
            On Error GoTo 0
        Case "component_not_found"
            ' FindComponent captured the diagnostics in module state (a component
            ' name can contain anything, so nothing rides the "|" tag). Every read is guarded.
            On Error Resume Next
            d("triedComponent") = m_cnfTried
            If Len(m_cnfTried) > 0 Then
                If Trim$(m_cnfTried) <> m_cnfTried Then d("triedComponentHasSurroundingWhitespace") = True
            End If
            d("componentCount") = m_cnfCount
            If Not m_cnfNames Is Nothing Then Set d("availableComponents") = m_cnfNames
            If m_cnfCount > 100 Then d("availableComponentsTruncated") = True
            If Not m_cnfNear Is Nothing Then
                If m_cnfNear.Count > 0 Then Set d("nearMatches") = m_cnfNear
            End If
            If Len(m_cnfTrimmed) > 0 Then d("trimmedMatch") = m_cnfTrimmed
            If Len(m_cnfCollapsed) > 0 Then d("whitespaceCollapsedMatch") = m_cnfCollapsed
            d("lookupIsCaseInsensitive") = True
            d("caseDifferenceIsNotTheCause") = "the lookup compares component names with LCase$, so a name that differs ONLY in letter case RESOLVES and can never reach this refusal - there is no case fix to make here"
            d("note") = "nothing was read, written or modified: the component you named is not part of the open project, so the tool stopped before touching anything"
            d("hint") = "call get_component_list (or list_component_parts) and pass one of availableComponents verbatim; if trimmedMatch / whitespaceCollapsedMatch is present you passed the right name with different whitespace"
            On Error GoTo 0
        Case "edits_required"            ': BuildOps has exactly two callers (apply_edits, preview_edit).
            d("note") = "nothing was written. The edits argument is missing or empty, so there is no operation to apply or to preview."
            d("hint") = "pass edits as a non-empty array of {op, anchor, text} objects"
        Case "timeout"
            ' R-1021-03 A3: the call reached its own ceiling at a PUMP POINT and stopped
            ' itself. The VB statement is NOT preempted (single-threaded STA).
            Dim tElapsed As Long, tMax As Long, tSrc As String
            tElapsed = 0
            tMax = 0
            tSrc = ""
            If UBound(parts) >= 1 Then tElapsed = CLng("0" & parts(1))
            If UBound(parts) >= 2 Then tMax = CLng("0" & parts(2))
            If UBound(parts) >= 3 Then tSrc = parts(3)
            d("elapsedMs") = tElapsed
            d("maxMs") = tMax
            d("maxMsSource") = tSrc
            Dim held As Object
            Set held = CreateObject("Scripting.Dictionary")
            held("tool") = m_outerTool
            held("pid") = GetCurrentProcessId()
            held("sinceMs") = tElapsed
            Set d("heldBy") = held
            d("failureKind") = "timeout"
            d("statementInterrupted") = False
            d("suggestedAction") = "retry_once"
            d("note") = "the add-in reached this call's own maxMs at one of ITS OWN pump points and returned. The running VB statement was NOT preempted (single-threaded STA)."
            d("recoveryHint") = "the call already returned, so the gate is free: retry. If the CLIENT gave up first, send release_gate over the out-of-band lane and retry."
        Case Else
            ' an unknown reason keeps only ok/reason/tool - never invent sha keys for it
    End Select
    Dim comp As String
    comp = ""
    On Error Resume Next
    comp = JsonGetStr(args, "name")
    If Len(comp) = 0 Then comp = JsonGetStr(args, "component")
    On Error GoTo 0
    If Len(comp) > 0 And LCase$(parts(0)) <> "no_project" And LCase$(parts(0)) <> "component_not_found" Then
        d("component") = comp
        ' ruling 4: carry coords for any line-numbered field
        On Error Resume Next
        Set d("coords") = CoordsDictOfName(comp, 1, "ide")
        On Error GoTo 0
        d("lineSpace") = "ide"
        d("lineSpaceHint") = "line numbers are IDE code-pane lines; get_component_code's numbered output is DISK lines (ideLine = diskLine - coords.headerOffset)"
    End If
    If d.Exists("sideEffects") Then
        Select Case LCase$(parts(0))
            Case "project_dir_unavailable", "project_dir_write_not_allowed"
                ' this refusal is shared by import_component and by add_component's
                ' form fallback, so the note must not claim it came from the import.
                d("note") = "the refusal happened BEFORE any side effect: no file written into the project directory or into the add-in's own directory, and no component added, rebound or renamed"
            Case "no_project"
                d("note") = "refused before any work: with no project open there is nothing to read or write; open a project and retry"
            Case Else
                ' unchanged wording for the pre-existing reasons (no behaviour drift)
                d("note") = "the import was refused BEFORE any side effect: no snapshot file, no AddFile, no SaveAs, no file in the project directory and no component added or rebound"
        End Select
    ElseIf d.Exists("note") Then
        ' the anchor refusals set their OWN note above. preview_edit writes nothing
        ' at all, so the optimistic-concurrency wording would be WRONG here. No pre-existing
        ' reason sets d("note") before this point, so this branch cannot move their receipts.
    Else
        d("note") = "the component was NOT modified (the optimistic-concurrency guard refused the write)"
    End If
    McpReasonJson = JsonStringify(d)
End Function

' where McpTrace will write (same precedence as the template's EnsureInit).
Private Function SinkPathOf() As String
    SinkPathOf = Environ$("MCP_TRACE_FILE")
    If Len(SinkPathOf) = 0 Then SinkPathOf = Environ$("TEMP") & "\mcp_trace.jsonl"
End Function

' is the sink directory present and WRITABLE? Report it instead of
' letting the trace fail silently at run time (the hardened template creates the
' directory and falls back to %TEMP%, but the caller must be able to see that).
Private Function SinkProbe() As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    Dim p As String, dir As String
    p = SinkPathOf()
    dir = ParentDirOf(p)
    d("sinkPath") = p
    d("sinkDir") = dir
    d("sinkDirExists") = False
    d("sinkDirWritable") = False
    If Len(dir) = 0 Then
        d("sinkAdvice") = "the configured MCP_TRACE_FILE has no directory part"
        Set SinkProbe = d
        Exit Function
    End If
    Dim fso As Object
    On Error Resume Next
    Set fso = CreateObject("Scripting.FileSystemObject")
    On Error GoTo 0
    If fso Is Nothing Then
        d("sinkAdvice") = "Scripting.FileSystemObject is unavailable, so the sink directory could not be pre-checked"
        Set SinkProbe = d
        Exit Function
    End If
    On Error Resume Next
    d("sinkDirExists") = fso.FolderExists(dir)
    Err.Clear
    Dim tf As Object
    Set tf = fso.CreateTextFile(dir & "\_mcp_probe.tmp", True)
    If Err.Number = 0 Then
        tf.Close
        fso.DeleteFile dir & "\_mcp_probe.tmp", True
        d("sinkDirWritable") = True
    Else
        d("sinkAdvice") = "cannot write into " & dir & " (" & Err.Description & "); the hardened trace module falls back to %TEMP%\mcp_trace.jsonl and logs the failure to MCP_TRACE_ERR_FILE"
    End If
    Err.Clear
    On Error GoTo 0
    Set SinkProbe = d
End Function

Private Function ParentDirOf(ByVal p As String) As String
    Dim i As Long
    i = InStrRev(p, "\")
    If i > 1 Then ParentDirOf = Left$(p, i - 1)
End Function

' ---- automatic modMcpTrace materialization ----

' inject_trace's guard ('If McpTraceOn() Then') has to resolve at COMPILE time, so the
' target project must contain modMcpTrace. Until this card the caller had to import a
' repository file by hand; now the add-in writes the component itself and PROVES it is
' there. The source text and the language detection live in TraceGen (embedded literals).
Private Sub EnsureTraceModule(ByRef info As Object)
    Dim before As Boolean
    before = ModulePresent("")
    info("modulePresentBefore") = before
    info("moduleAutoAttached") = False
    If before Then
        info("moduleAttachAction") = "skipped_already_present"
        Exit Sub
    End If
    Dim langSrc As String
    Dim lang As String
    Dim resLang As String, resWhy As String, uiLang As String, uiWhy As String
    lang = TraceGen.DetectIdeLanguage(langSrc, resLang, resWhy, uiLang, uiWhy)
    info("ideLanguage") = resLang
    info("ideLanguageSource") = resWhy
    info("ideMenuLanguage") = uiLang
    info("ideMenuLanguageSource") = uiWhy
    info("commentLanguage") = lang
    info("commentLanguageSource") = langSrc
    info("commentLanguageRule") = "UI-first (final ruling): the IDE's own UI language wins when it can be read; otherwise the running VB6.EXE version resource; otherwise English."
    Dim code As String
    code = TraceGen.TraceModuleSource(lang)
    info("moduleCodeLines") = (Len(code) - Len(Replace(code, vbCrLf, ""))) \ 2 + 1
    info("moduleCodeSha256") = Sha256.Sha256HexTextUtf8(code)
    info("moduleCodeSha256Note") = "sha256 of the module SOURCE this add-in generated; VB6 may normalize the pane text, so this is the intended source, not the saved .bas"
    Dim t0 As Long
    t0 = GetTickCount()
    Dim addErr As String
    Dim res As String
    addErr = ""
    On Error Resume Next
    res = ToolAddComponent("module", "modMcpTrace", code)
    If Err.Number <> 0 Then
        addErr = "0x" & Hex$(Err.Number) & " " & Err.Description
        Err.Clear
    End If
    On Error GoTo 0
    info("moduleAttachMs") = GetTickCount() - t0
    ' The card requires the attach to be PROVEN, not assumed: re-read the component list
    ' instead of trusting the add call's receipt.
    If ModulePresent("") Then
        info("moduleAutoAttached") = True
        info("moduleAttachAction") = "added"
    Else
        info("moduleAttachAction") = "failed"
        If Len(addErr) > 0 Then
            info("moduleAttachError") = addErr
        ElseIf Len(res) = 0 Then
            info("moduleAttachError") = "add_component returned an EMPTY receipt and modMcpTrace is not in the project"
        Else
            info("moduleAttachError") = "add_component reported no error but modMcpTrace is still not in the project"
        End If
        info("moduleAttachNote") = "the module was NOT attached; the injected guard cannot compile and VB6 will show a MODAL compile-error dialog. This failure is carried in the receipt - nothing is silently downgraded."
    End If
End Sub

' modMcpTrace is NEVER removed automatically. inject_trace attaches it;
' remove_trace removes ONLY that id's injected block. The module is kept because
'   (a) the user may have added his own code to an auto-generated module, and deleting it
'       would destroy that code, and
'   (b) other @mcp-trace blocks may still exist elsewhere and call McpTrace/McpTraceOn,
'       so the project would no longer compile once the module was gone.
' The automatic-removal branch that used to live here (reason "removed_autogen_module") was
' DELETED: there is no code path left that removes the component. Module state is reported
' back through info, and the receipt carries the manual removal instructions.
Private Sub ReportTraceModuleKept(ByRef info As Object)
    info("modulePresentBefore") = False
    info("moduleRemoved") = False
    info("moduleLeftInPlace") = False
    info("moduleAutogenMarker") = False
    info("moduleRemoveReason") = "module_absent"
    Dim comp As VBIDE.VBComponent
    On Error Resume Next
    Set comp = McpFindTools.FindComponent(Me, "modMcpTrace")
    If Err.Number <> 0 Then Err.Clear
    On Error GoTo 0
    If comp Is Nothing Then
        info("moduleKeptNote") = "no modMcpTrace component exists in this project, so there was nothing to keep or remove"
        Exit Sub
    End If
    info("modulePresentBefore") = True
    info("moduleLeftInPlace") = True
    info("moduleRemoveReason") = "kept_by_design"
    Dim manual As String
    manual = " To remove it yourself: confirm that NO '@mcp-trace' block remains anywhere in the project (search for the marker), then call remove_component with name='modMcpTrace'. remove_trace never does this for you."
    If TraceGen.IsAutogenTraceModule(McpCls.ComponentPaneText(Me, comp)) Then
        info("moduleAutogenMarker") = True
        info("moduleRemoveNote") = "modMcpTrace is left in place BY DESIGN; the previous automatic removal (reason removed_autogen_module) was withdrawn because (a) you may have added your own code to this auto-generated module and deleting it would have destroyed that code, and (b) other @mcp-trace blocks elsewhere may still call McpTrace/McpTraceOn, so the project would stop compiling once the module was gone." & manual
    Else
        info("moduleRemoveNote") = "modMcpTrace is left in place BY DESIGN. It does not carry the VB6MCP autogen marker, so it is treated as YOUR module - and even an auto-generated one is never removed now, because (a) you may have added your own code to it and (b) other @mcp-trace blocks elsewhere may still call McpTrace/McpTraceOn." & manual
    End If
    Dim boundFile As String
    boundFile = ""
    On Error Resume Next
    boundFile = comp.FileNames(1)
    If Err.Number <> 0 Then
        Err.Clear
        boundFile = ""
    End If
    On Error GoTo 0
    If Len(boundFile) > 0 Then info("moduleFileOnDisk") = boundFile
End Sub

' The code-pane text of one component (empty when it cannot be read).

' the injected guard calls McpTrace/McpTraceOn, which only exist when
' the target project contains modMcpTrace. Without it the project does not compile
' and VB6 raises a MODAL compile-error dialog that blocks end/remove_trace - far
' worse than a rejection, so it is pre-checked here.
Private Function ModulePresent(ByVal name As String) As Boolean
    On Error Resume Next
    ModulePresent = False
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    If p Is Nothing Then Exit Function
    Dim i As Long
    For i = 1 To p.VBComponents.Count
        Dim c As VBIDE.VBComponent
        Set c = p.VBComponents.Item(i)
        If Err.Number = 0 Then
            If LCase$(c.Name) = "modmcptrace" Then
                ModulePresent = True
                Exit Function
            End If
        End If
        Err.Clear
    Next
End Function

' The component file as raw text, for marker searches (empty when there is none).
Private Function DiskTextOfName(ByVal name As String) As String
    On Error Resume Next
    DiskTextOfName = ""
    Dim p As String
    p = DiskPathOf(name, "")
    If Len(p) = 0 Then Exit Function
    If Dir$(p) = "" Then Exit Function
    DiskTextOfName = Build.ReadLogAnsi(p)
End Function

' ---- expression visibility refusal ----

' A MODAL compile-error dialog blocks the whole IDE (end/remove_trace included),
' so inject_trace refuses - structurally - to emit a block that cannot compile.
' The decision is purely lexical (TraceGen symbol scan + Vb6Lint procedure map).
Private Function TraceExprRefusal(ByVal name As String, ByVal text As String, ByVal proc As String, ByVal exprs As String) As String
    Dim vis As String, em As String
    Dim insIdx As Long, afterIde As Long
    vis = TraceGen.VisibleSymbolsAt(text, proc, insIdx, afterIde, em)
    If Len(em) > 0 Then Exit Function
    Dim ok As Object
    Set ok = CsvKeySet(vis)
    AddCsvKeys ok, ComponentNamesCsv()
    AddCsvKeys ok, VbBuiltinNamesCsv()
    Dim items() As String, i As Long
    Dim bad As Object
    Set bad = New Collection
    items = Split(exprs, ",")
    For i = 0 To UBound(items)
        Dim ex As String, tok As String
        ex = Trim$(items(i))
        If Len(ex) > 0 Then
            tok = TraceGen.LeadingIdent(ex)
            If Len(tok) > 0 Then
                If Not ok.Exists(LCase$(tok)) Then
                    Dim o As Object
                    Set o = CreateObject("Scripting.Dictionary")
                    o("expression") = ex
                    o("token") = tok
                    o("why") = "not a parameter of " & proc & ", not declared above the injection point, and not a module-level or project-level symbol"
                    bad.Add o
                End If
            End If
        End If
    Next
    If bad.Count = 0 Then Exit Function
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = "expression_not_visible_at_injection_point"
    d("tool") = "inject_trace"
    d("component") = name
    d("procedure") = proc
    d("insertAfterIdeLine") = afterIde
    Set d("offenders") = bad
    Set d("visibleSymbols") = CsvToCollection(vis, 40)
    d("rule") = "each expression may reference only a parameter of the procedure, a local/Static declared at or above the injection point, or a module-level/project-level symbol; the check is lexical (VB6 is never asked to compile)"
    d("advice") = "move the declaration above the injection point, inject at a later point in the procedure, or drop that expression. Emitting the block unchanged would make the project fail to compile and VB6 would raise a MODAL compile-error dialog that also blocks end and remove_trace."
    d("note") = "the component was NOT modified (the IDE pane, the disk and the pane sha256 are unchanged)"
    TraceExprRefusal = JsonStringify(d)
End Function

Private Function CsvKeySet(ByVal csv As String) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    AddCsvKeys d, csv
    Set CsvKeySet = d
End Function

Private Sub AddCsvKeys(ByVal d As Object, ByVal csv As String)
    If Len(csv) = 0 Then Exit Sub
    Dim parts() As String, i As Long, k As String
    parts = Split(csv, ",")
    For i = 0 To UBound(parts)
        k = Trim$(parts(i))
        If Len(k) > 0 Then d(LCase$(k)) = True
    Next
End Sub

' a reference to another module/form/class of the project is legal in an expression
Private Function ComponentNamesCsv() As String
    On Error Resume Next
    Dim out As String, i As Long
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    If p Is Nothing Then Exit Function
    For i = 1 To p.VBComponents.Count
        Dim c As VBIDE.VBComponent
        Set c = p.VBComponents.Item(i)
        If Err.Number = 0 Then
            If Len(c.Name) > 0 Then out = out & "," & c.Name
        End If
        Err.Clear
    Next
    If Len(out) > 0 Then ComponentNamesCsv = Mid$(out, 2)
End Function

' VB6 runtime names that may legitimately appear in an expression; without this
' list a valid TypeName(x) / Me.Caption would be refused.
Private Function VbBuiltinNamesCsv() As String
    VbBuiltinNamesCsv = "Me,Len,Left,Left$,Right,Right$,Mid,Mid$,Trim,Trim$,LTrim,LTrim$,RTrim,RTrim$," & _
        "UCase,UCase$,LCase,LCase$,CStr,CInt,CLng,CDbl,CCur,CDate,CBool,CVar,CDec,Chr,Chr$,Asc,Val,Format,Format$," & _
        "Now,Date,Time,Timer,Rnd,Randomize,Int,Fix,Abs,Sgn,Sqr,Exp,Log,Sin,Cos,Tan,Atn,Round,Err," & _
        "UBound,LBound,Array,IsNull,IsEmpty,IsObject,IsNumeric,IsDate,IsArray,IsError,IsMissing," & _
        "TypeName,VarType,IIf,Choose,Switch,RGB,QBColor,Space,Space$,String,String$,Replace,InStr,InStrRev," & _
        "Split,Join,Filter,Hex,Oct,FreeFile,EOF,LOF,Seek,Null,Empty,Nothing,True,False," & _
        "CurDir,Dir,Dir$,FileLen,FileDateTime,GetAttr,SetAttr,MkDir,RmDir,Kill,FileCopy,Name,Shell," & _
        "App,Screen,Printer,Clipboard,Load,Unload,Print,Debug,DoEvents,Command,Environ,Environ$," & _
        "LSet,RSet,TypeOf,AddressOf,New,And,Or,Not,Xor,Mod,Like,Is,ByVal,ByRef,ParamArray,Optional,Object,Variant"
End Function

Private Function CsvToCollection(ByVal csv As String, ByVal maxN As Long) As Object
    Dim c As Object
    Set c = New Collection
    If Len(csv) = 0 Then
        Set CsvToCollection = c
        Exit Function
    End If
    Dim parts() As String, i As Long
    parts = Split(csv, ",")
    For i = 0 To UBound(parts)
        If c.Count >= maxN Then Exit For
        If Len(Trim$(parts(i))) > 0 Then c.Add Trim$(parts(i))
    Next
    Set CsvToCollection = c
End Function
' =====================================================================
' W-H1 (D1+D2+D7): run_until_break, breakpoint management, unified debug receipt
' =====================================================================


' {component, line (PANE line space), hitCount?} per the SAME schema debug_session takes.
Private Function ToolRunUntilBreak(ByVal args As Object) As String
    Dim root As Object, tr As Object
    Set root = CreateObject("Scripting.Dictionary")
    Set tr = New Collection
    root("tool") = "run_until_break"
    root("ok") = False
    root("wedged") = False
    root("endQueued") = False
    root("stopReason") = ""
    root("hitCountTotal") = 0
    Dim timeoutMs As Long
    timeoutMs = JsonGetLong(args, "timeout_ms", 30000)
    If timeoutMs <= 0 Then timeoutMs = 30000
    If timeoutMs > 600000 Then timeoutMs = 600000
    root("timeoutMs") = timeoutMs
    Set m_watchExprs = McpDb.DbObjOf(Me, args, "watch")
    m_watchFrame = 0
    Dim attach As Boolean
    attach = JsonGetBool(args, "attach", False)
    root("attach") = attach
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    Dim vbpPath As String
    vbpPath = p.FileName
    root("vbpPath") = vbpPath
    Dim diskBefore As String
    diskBefore = ""
    If Len(vbpPath) > 0 Then diskBefore = Sha256HexFile(vbpPath)
    root("diskVbpShaBefore") = diskBefore
    ' the gate BACKSTOP: if this call never returns (a tight non-pumping loop), a later
    ' read-only call can force-release the single-flight gate after this budget.
    ArmGateRelease "run_until_break", timeoutMs + 8000
    On Error GoTo RUB_ERR
    Dim st0 As String
    st0 = GetIdeState()
    root("ideStateBefore") = st0
    Dim res As String
    If attach Then
        ' echo (and gate on) the breakpoints armed by phase 1 - they live in this add-in's
        ' memory because the observe call is a separate call.
        If Not m_rubBreakpoints Is Nothing Then Set root("breakpoints") = m_rubBreakpoints
        res = McpDb.DbObserveUntilBreak(Me, root, tr, timeoutMs)
        root("stopReason") = res
        McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, True
        DisarmGateRelease
        ToolRunUntilBreak = JsonStringify(root)
        Exit Function
    End If
    ' ---- PHASE 1: arm + START, then return (Start is QUEUED in an STA IDE) ----
    If st0 = "break" Then
        root("reason") = "already_in_break"
        root("hint") = "call control_execution{mode:""end""} first, then retry run_until_break"
        McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, True
        DisarmGateRelease
        ToolRunUntilBreak = JsonStringify(root)
        Exit Function
    End If
    If st0 = "run" Then
        root("reason") = "already_running"
        Set root("howToContinue") = McpDb.DbRubHowToContinue(Me, timeoutMs)
        McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, True
        DisarmGateRelease
        ToolRunUntilBreak = JsonStringify(root)
        Exit Function
    End If
    Dim bps1 As Object
    Set bps1 = McpDb.DbArmBreakpoints(Me, args)
    If Len(m_bpArmRefusal) > 0 Then
        root("ok") = False
        root("reason") = "line_not_breakable_batch"
        root("batchRefused") = m_bpArmRefusal
        root("menuCommandSent") = False
        McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, True
        DisarmGateRelease
        ToolRunUntilBreak = JsonStringify(root)
        Exit Function
    End If
    Set m_rubBreakpoints = bps1
    Set root("breakpoints") = bps1
    Dim whyStart As String
    whyStart = ""
    Dim started As Boolean
    started = McpDb.DbClickStart(Me, whyStart)
    root("executedStart") = started
    root("startWhy") = whyStart
    If started Then
        root("startedPending") = True
        root("stopReason") = "started"
        root("ideStateAtReturn") = GetIdeState()
        Set root("howToContinue") = McpDb.DbRubHowToContinue(Me, timeoutMs)
    Else
        root("reason") = "start_command_not_found"
        root("detail") = whyStart
    End If
    McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, True
    DisarmGateRelease
    ToolRunUntilBreak = JsonStringify(root)
    Exit Function
RUB_ERR:
    On Error Resume Next
    root("ok") = False
    root("reason") = "unexpected_error"
    root("errorMessage") = Err.Description
    If Len(CStr(root("stopReason"))) = 0 Then root("stopReason") = "error"
    McpDb.DbFinalizeDiskAndHits Me, root, vbpPath, diskBefore, tr
    DisarmGateRelease
    ToolRunUntilBreak = JsonStringify(root)
End Function


' OBSERVE until one of: break / process_exit / unhandled_error / timeout.
' Every hit stops the engine (VB6 has no conditional breakpoints); when a breakpoint carries
' hitCount N, the first N-1 hits are auto-continued here and only the Nth stop is reported.

' One observed break: fill the UNIFIED receipt fields and apply the hitCount gate.




' ---------------------------------------------------------------------
' breakpoints: set / clear / enable / disable / list / clear_all
' ---------------------------------------------------------------------

' FIX-7: the line classifier used by EVERY breakpoint-set entry point. It works in the
' PANE line space (the space VB6's caret and the Debug menu use) and answers
' breakable/lineClass/reason + nearestBreakable candidates, so an illegal position is
' refused BEFORE any menu command can open a host-modal box.







' FIX-13: write a temp file in the SAME directory, validate it by parsing, then replace
' the real ledger (delete + rename). Returns {ok, reason, bytesExpect, bytesActual, tempPath}.

' FIX-22i: ok / write_invalid (the file content failed read-back validation) / failed (IO/replace).

' FIX-22i: one-line evidence for receipts: reason + path + expected/actual size.




Public Function BpArmValidateBatch(ByVal args As Object, ByRef refusalOut As String) As Boolean
    BpArmValidateBatch = True
    refusalOut = ""
    On Error Resume Next
    Dim bps As Object
    Set bps = McpDb.DbObjOf(Me, args, "breakpoints")
    If bps Is Nothing Then
        Err.Clear
        Exit Function
    End If
    Dim i As Long
    Dim bad As Object
    Set bad = New Collection
    For i = 1 To bps.Count
        Dim one As Object
        Set one = Nothing
        If IsObject(bps(i)) Then Set one = bps(i)
        Dim comp As String, lineN As Long
        comp = ""
        lineN = 0
        If Not one Is Nothing Then
            If one.Exists("component") Then comp = CStr(one("component"))
            If one.Exists("line") Then lineN = CLng(one("line"))
        End If
        If Len(comp) > 0 And lineN > 0 Then
            Dim cls As Object
            Set cls = McpBpPane.BpClassifyPaneLine(Me, comp, lineN)
            If Not CBool(cls("breakable")) Then bad.Add McpBpPane.BpRefusalBlock(Me, cls)
        End If
    Next
    If bad.Count > 0 Then
        BpArmValidateBatch = False
        Dim root As Object
        Set root = CreateObject("Scripting.Dictionary")
        root("ok") = False
        root("reason") = "line_not_breakable_batch"
        root("batchRejected") = True
        root("menuCommandSent") = False
        root("rejectedCount") = bad.Count
        Set root("rejected") = bad
        root("howToProceed") = "NO breakpoint was armed: one or more requested positions cannot hold a breakpoint, so the WHOLE batch was refused before any Debug-menu command (an arm loop that sets the first N breakpoints would leave a half-armed state). Fix the listed pane lines (see nearestBreakable) and retry"
        refusalOut = JsonStringify(root)
    End If
    Err.Clear
End Function

Private Function ToolBreakpoints(ByVal args As Object) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("tool") = "breakpoints"
    root("ok") = False
    ' DECLARED SOURCE OF TRUTH (the Lead requirement): never pretend the IDE can be queried.
    root("sourceDeclaration") = "list[] merges (a) SOURCE-MARKER breakpoints this add-in injected (readable again through list_breakpoints) and (b) NATIVE IDE breakpoints set BY THIS ADD-IN session (tracked in memory only). Native breakpoints set by a HUMAN inside the IDE CANNOT be enumerated or verified: the VBIDE object model exposes no breakpoint API. This limit is reported, never guessed."
    Dim action As String
    action = LCase$(Trim$(JsonGetStr(args, "action")))
    If Len(action) = 0 Then action = "list"
    root("action") = action
    root("nativeStateVerified") = False
    ' FIX-32 (WP-22-05 follow-up): this tool's SOURCE WRITES are a SIDE EFFECT of
    ' an IDE call, not an explicit file write, so the old receipt only listed the
    ' _undo snapshot while the project file (and the component file) really changed
    ' on disk. Take the before-print of the project files HERE and compare it after
    ' the action: diskWrites[] / touchedFiles[] / diskSnapshot{} carry the evidence,
    ' and nothing is claimed when nothing moved.
    Dim f32Track As Boolean
    Dim f32Ctx As Object
    Dim f32Book As Object
    Dim f32Out As String
    Dim f32RegSave As Boolean
    f32Track = (action = "set" Or action = "clear" Or action = "enable" Or action = "disable" Or action = "clear_all" Or action = "probe")
    If f32Track Then Set f32Ctx = F32SnapBegin("breakpoint-source-save")
    f32RegSave = False
    Select Case action
        Case "list"
            f32Out = BpListJson(root)
        Case "set"
            f32Out = BpEnrichRefusal(BpSetJson(args, root), args)
        Case "clear"
            ' FIX-22h: BpClearJson rewrites session+disk itself; a following BpRegSave would
            ' write the SESSION-ONLY map and would drop kept disk-only records.
            f32Out = BpClearJson(args, root)
        Case "enable"
            f32Out = BpEnableDisableJson(args, root, True)
            f32RegSave = True
        Case "disable"
            f32Out = BpEnableDisableJson(args, root, False)
            f32RegSave = True
        Case "clear_all"
            f32Out = BpClearAllJson(root)
            f32RegSave = True
        Case "prune"
            f32Out = McpBpReg.BpPruneJson(Me, root)
        Case "probe"
            f32Out = BpProbeJson(args, root)
        Case Else
            root("reason") = "unknown_action"
            root("acceptedActions") = "list,set,clear,enable,disable,clear_all,prune,probe"
            f32Out = JsonStringify(root)
    End Select
    If f32RegSave Then Call McpBpReg.BpRegSave(Me)
    ' FIX-32: attach the book to the ALREADY BUILT text (the write happens inside
    ' the per-action function above). A read-only or ledger-only action that moved
    ' nothing gets diskWrites:[] and touchedFiles:[] - an empty answer, never an
    ' invented entry.
    If f32Track Then
        If action = "probe" Then
            Set f32Book = F32SnapFinish(f32Ctx, "probe_start_disk_change", "ide_save_on_start: this tool never calls SaveProject; the IDE own when-a-program-starts option may save")
        Else
            Set f32Book = F32SnapFinish(f32Ctx, "breakpoint-source-save", "breakpoints_internal_save_project")
        End If
        ' FIX-32: a written .vbp / component file also joins the additive
        ' sideEffects.filesWritten[] audit block (the diskWrites[] entry carries
        ' the bytes+sha; filesWritten[] is the path-only list used by every writer).
        Dim f32W As Object
        Dim f32I As Long
        If f32Book.Exists("diskWrites") Then
            Set f32W = f32Book("diskWrites")
            If Not f32W Is Nothing Then
                For f32I = 1 To f32W.Count
                    ManifestAdd m_seFiles, CStr(f32W.Item(f32I)("file"))
                Next
            End If
        End If
        f32Out = F32SpliceBook(f32Out, f32Book)
    End If
    ToolBreakpoints = f32Out
End Function




' FIX-7 rev: prune edits ONLY our own disk ledger. A native breakpoint already set inside
' the IDE cannot be removed individually (no VBIDE API), so prune never pretends to.

' FIX-7 rev: BEHAVIOURAL verification of a breakpoint. The IDE has no breakpoint API, so
' the only honest answer to "is my breakpoint effective?" is to RUN the program and see
' whether it stops at that line. Costs: the program really runs (start -> stop -> end) and
' the project is NOT saved by this path.
' FIX-22d: an early return must NEVER look like a measured design. It states that no
' measurement was taken and reports message-free dialog presence if one is up.

Private Sub BpProbeCleanupClose(ByRef root As Object)
    ' contract v1.16.0: the probe cleanup obligation is REPORTED, never assumed. The probe
    ' performs NO source write, NO F9 post and NO ledger write, so the honest cleanup
    ' statement is "the breakpoint ledger is unchanged, and here is the count that proves it".
    On Error Resume Next
    Dim nDisk As Long
    Dim nSess As Long
    nDisk = 0
    nSess = 0
    Dim coll As Object
    Set coll = McpBpReg.BpRegLoad(Me)
    If Not coll Is Nothing Then nDisk = coll.Count
    If Not m_bpSession Is Nothing Then nSess = m_bpSession.Count
    Dim c As Object
    Set c = root("probeCleanup")
    If c Is Nothing Then
        Set c = CreateObject("Scripting.Dictionary")
        c("injectedByProbe") = False
        c("removed") = 0
        c("userBreakpointsTouched") = False
        c("ledgerRecordsBefore") = nDisk + nSess
        Set root("probeCleanup") = c
    End If
    c("ledgerRecordsAfter") = nDisk + nSess
    c("ledgerUnchanged") = (CLng(c("ledgerRecordsBefore")) = CLng(c("ledgerRecordsAfter")))
    c("restored") = c("ledgerUnchanged")
    c("basis") = "the probe performs NO source write, NO F9 post and NO ledger write: it verifies whatever breakpoint is already set, so there is nothing to inject or remove; restored=true means the breakpoint ledger has the same record count before and after"
    Err.Clear
End Sub

Private Sub BpProbeEarlyExit(ByRef root As Object, ByVal why As String)
    root("stateAfterSource") = "early_return_no_measure"
    root("elapsedMs") = Util.TickMs() - m_bpProbeT0
    BpProbeCleanupClose root
    root("stateAfterSourceReason") = why
    root("stateAfter") = "not_measured"
    Dim dc As Long
    dc = 0
    If WinOps.WoModalFastPresent(dc) Then
        root("dialogPresent") = True
        root("dialogCount") = dc
        root("stateAfter") = "modal_blocked"
    End If
End Sub

Private Function BpProbeJson(ByVal args As Object, ByRef root As Object) As String
    On Error GoTo BP_PR_ERR
    root("probe") = True
    root("probeResult") = "not_attempted"
    ' contract v1.16.0: the probe receipt carries the documented shape on EVERY path.
    m_bpProbeT0 = Util.TickMs()
    root("startedPending") = False
    root("elapsedMs") = 0
    root("stateBefore") = "not_measured"
    Dim pcInit As Object
    Set pcInit = CreateObject("Scripting.Dictionary")
    pcInit("injectedByProbe") = False
    pcInit("removed") = 0
    pcInit("restored") = False
    pcInit("ledgerUnchanged") = True
    pcInit("userBreakpointsTouched") = False
    pcInit("ledgerRecordsBefore") = McpBpReg.BpProbeLedgerCount(Me)
    pcInit("ledgerRecordsAfter") = 0
    pcInit("basis") = "the probe performs NO source write, NO F9 post and NO ledger write: it verifies whatever breakpoint is already set, so there is nothing to inject or remove"
    Set root("probeCleanup") = pcInit
    ' FIX-22d: EVERY probe receipt carries these keys, including every early return.
    root("endRequested") = False
    root("executedEnd") = False
    root("stateAfter") = ""
    root("stateAfterSource") = "not_measured_yet"
    root("stateAfterEndRequest") = ""
    root("stateAfterEndRequestSource") = ""
    root("commandBarsSuspendedAfter") = False
    root("endNotApplied") = False
    root("endNotAppliedReason") = ""
    root("howToProceed") = ""
    root("dialogPresent") = False
    root("dialogCount") = 0
    root("endSettleDesignStreak") = 0
    root("designConfirmed") = False
    root("endPending") = False
    root("startQueued") = False
    Dim endSamplesInit As Object
    Set endSamplesInit = New Collection
    Set root("endSettleSamples") = endSamplesInit
    Dim comp As String
    Dim lineN As Long
    Dim timeoutMs As Long
    Dim probePhase As String
    Dim tgtObj As Object
    Dim cls As Object
    Dim lcNow As String
    Dim st As String
    Dim stNow As String
    Dim mdc As Long
    Dim why As String
    Dim started As Boolean
    Dim stAtReturn As String
    Dim obsId As String
    Dim t0 As Long
    Dim sawRun As Boolean
    Dim sawBreak As Boolean
    Dim seq As Object
    Dim ebSeq As Object
    Dim lastPos As String
    Dim lastPosAt As Long
    Dim ebRunSaw As Boolean
    Dim runFirstAt As Long
    Dim settleWindow As Long
    Dim ebNow As Long
    Dim diag As Object
    Dim posJ As String
    Dim hitLine As Long
    Dim hitProc As String
    Dim hitModule As String
    Dim posObj As Object
    Dim hitText As String
    Dim pv As Variant
    Dim textHit As Boolean
    Dim mtAfter As String
    Dim ended As Boolean
    Dim endT0 As Long
    Dim dlgPresent As Boolean
    Dim dlgCount As Long
    Dim dlgN As Long
    Dim stSrc As String
    Dim barsSusp As Boolean
    Dim stAfter As String
    Dim endSamples As Object
    Dim designStreak As Long
    Dim settleDeadline As Long
    Dim hIde As Long
    Dim sbkDown As String
    Dim sbkUp As String
    Dim ebAfterKey As Long
    Dim stillRun As Boolean
    Dim stFinal As String
    Dim ebFinal As Long
    comp = JsonGetStr(args, "component")
    lineN = JsonGetLong(args, "line", 0)
    timeoutMs = JsonGetLong(args, "timeout_ms", 15000)
    If timeoutMs < 1000 Then timeoutMs = 1000
    If timeoutMs > 120000 Then timeoutMs = 120000
    root("timeoutMs") = timeoutMs
    ' =====================================================================
    ' contract v1.16.0 (Lead ruling): TWO-PHASE probe.
    ' MEASURED why: a Start command issued from inside a tool call is QUEUED by the STA IDE
    ' and takes effect only AFTER the call returns (15 s window: 200 x state=design,
    ' ebMode 200 x 0; ide_state right after the return: break). ONE call therefore can never
    ' observe the run it starts - so the probe is split, and a positive probeResult can only
    ' come from start + observe.
    '   phase=start   : preconditions -> click Start -> return probeId + started_pending
    '   phase=observe : same probeId -> wait for the stop -> read position -> END -> PROVE design
    '   phase=auto    : explicit alias of start (not "both in one call")
    ' =====================================================================
    probePhase = LCase$(Trim$(JsonGetStr(args, "phase", "start")))
    If Len(probePhase) = 0 Then probePhase = "start"
    If probePhase = "auto" Then probePhase = "start"
    root("probePhase") = probePhase
    root("phaseRule") = "phase=start only STARTS the program; the stop is observed by a SECOND call with phase=observe and the same probeId. phase=auto is an alias of start: a single call cannot observe the run it starts (Start is QUEUED in the STA IDE), so a positive probeResult can only come from start + observe."
    If probePhase = "observe" Then
        ' ---------- phase=observe ----------
        obsId = Trim$(JsonGetStr(args, "probeId", ""))
        root("probeId") = obsId
        If Len(obsId) = 0 Then
            root("ok") = False
            root("probeResult") = "not_attempted"
            root("reason") = "probe_not_found"
            root("howToProceed") = "phase=observe needs the probeId returned by THIS instance phase=start. Call ide_state first: if a program is still running, stop it (control_execution{end}, or the hub ide_kill_and_relaunch) before starting a new probe."
            BpProbeJson = JsonStringify(root)
            Exit Function
        End If
        If Len(m_bpProbeLiveId) = 0 Or StrComp(obsId, m_bpProbeLiveId, vbBinaryCompare) <> 0 Then
            root("ok") = False
            root("probeResult") = "not_attempted"
            root("reason") = "probe_not_found"
            root("probeIdKnown") = (Len(m_bpProbeLiveId) > 0)
            root("howToProceed") = "unknown probeId: it was never issued by this instance, or a newer phase=start replaced it. Check ide_state; if a program is running, stop it first, then start a new probe."
            BpProbeJson = JsonStringify(root)
            Exit Function
        End If
        If Util.TickMs() - m_bpProbeLiveAt > BP_PROBE_ID_TTL_MS Then
            root("ok") = False
            root("probeResult") = "not_attempted"
            root("reason") = "probe_not_found"
            root("expired") = True
            root("ageMs") = Util.TickMs() - m_bpProbeLiveAt
            root("howToProceed") = "the probeId expired after " & CStr(BP_PROBE_ID_TTL_MS) & " ms. Check ide_state and start a new probe."
            BpProbeJson = JsonStringify(root)
            Exit Function
        End If
        If m_bpProbeAwaitEnd Then
            ' ---- CONFIRM leg: the previous observe call already MEASURED the behavioural result
            ' and issued the End, but the End teardown is only observable after that call returns
            ' (measured: break for 6 s in-call, design immediately after the return). This call
            ' performs ONLY the read-back proof and re-publishes the result unchanged.
            ArmGateRelease "breakpoints_probe_confirm", timeoutMs + 8000
            designStreak = 0
            stSrc = ""
            barsSusp = False
            stAfter = ""
            dlgPresent = False
            dlgCount = 0
            Set endSamples = New Collection
            settleDeadline = Util.TickMs() + timeoutMs
            Do
                dlgN = 0
                If WinOps.WoModalFastPresent(dlgN) Then
                    stAfter = "modal_blocked"
                    dlgPresent = True
                    dlgCount = dlgN
                    designStreak = 0
                Else
                    stAfter = GetIdeStateEx(stSrc, barsSusp)
                    If LCase$(stAfter) = "design" Then
                        designStreak = designStreak + 1
                    Else
                        designStreak = 0
                    End If
                End If
                If endSamples.Count < 60 Then endSamples.Add stAfter
                If designStreak >= 3 Then Exit Do
                If Util.TickMs() >= settleDeadline Then Exit Do
                If CanPump() Then DoEvents
                McpDb.DbBriefWait Me, 50
            Loop
            root("probeResult") = m_bpProbePendingResult
            root("endConfirmPhase") = True
            root("confirmedResultFrom") = "the preceding phase=observe call (same probeId)"
            If Len(m_bpProbePendingPos) > 0 Then
                hitModule = McpDb.DbPosField(Me, m_bpProbePendingPos, "module")
                hitProc = McpDb.DbPosField(Me, m_bpProbePendingPos, "proc")
                hitLine = McpDb.DbPosLine(Me, m_bpProbePendingPos)
                Set posObj = CreateObject("Scripting.Dictionary")
                posObj("component") = hitModule
                posObj("proc") = hitProc
                posObj("paneLine") = hitLine
                Set root("position") = posObj
                root("positionRaw") = m_bpProbePendingPos
                root("proc") = hitProc
                root("module") = hitModule
                root("line") = hitLine
            End If
            root("stateAfterEndRequest") = stAfter
            root("stateAfterEndRequestSource") = stSrc
            root("commandBarsSuspendedAfter") = barsSusp
            root("dialogPresent") = dlgPresent
            root("dialogCount") = dlgCount
            Set root("endSettleSamples") = endSamples
            root("endSettleDesignStreak") = designStreak
            If designStreak >= 3 Then
                root("stateAfter") = "design"
                root("stateAfterVerifiedBy") = "ide_state"
                root("designConfirmed") = True
                root("programEnded") = True
                root("programStillRunning") = False
                root("programStillOpen") = False
                root("endPending") = False
                root("endNotApplied") = False
                root("endConfirmMs") = Util.TickMs() - m_bpProbeT0
                root("ok") = True
                root("cost") = "BEHAVIOURAL verification, CONFIRM leg: the behavioural result was measured by the preceding phase=observe call; this call only PROVED the end by read-back (3 consecutive design samples, no modal box). The tool never calls SaveProject."
                root("howToProceed") = ""
                root("elapsedMs") = Util.TickMs() - m_bpProbeT0
                BpProbeCleanupClose root
                m_bpProbeLiveId = ""
                m_bpProbeAwaitEnd = False
                DisarmGateRelease
                BpProbeJson = JsonStringify(root)
                Exit Function
            End If
            ' not design yet: keep the id alive, claim nothing
            root("stateAfter") = stAfter
            root("stateAfterVerifiedBy") = "ide_state"
            root("finalStateReadBack") = LCase$(stAfter)
            root("finalEbMode") = IdeEbMode()
            root("programStillRunning") = (LCase$(stAfter) = "run" Or IdeEbMode() = 1)
            root("programInBreak") = (LCase$(stAfter) = "break" Or IdeEbMode() = 2)
            root("programStillOpen") = (LCase$(stAfter) <> "design")
            root("programEnded") = False
            root("endPending") = True
            root("endNotApplied") = True
            root("endNotAppliedReason") = "the End teardown is still not observable by read-back; nothing is claimed"
            root("howToProceed") = "call this phase=observe again with the same probeId (it stays valid), or read ide_state; if it stays open, stop it with control_execution{end} or the hub ide_kill_and_relaunch"
            root("elapsedMs") = Util.TickMs() - m_bpProbeT0
            BpProbeCleanupClose root
            DisarmGateRelease
            BpProbeJson = JsonStringify(root)
            Exit Function
        End If
        comp = m_bpProbeLiveComp
        lineN = m_bpProbeLiveLine
        root("component") = comp
        root("targetLine") = lineN
        Set tgtObj = CreateObject("Scripting.Dictionary")
        tgtObj("component") = comp
        tgtObj("paneLine") = lineN
        Set root("target") = tgtObj
        Set cls = McpBpPane.BpClassifyPaneLine(Me, comp, lineN)
        root("lineClass") = cls("lineClass")
        st = GetIdeState()
        root("stateBefore") = st
        ArmGateRelease "breakpoints_probe_observe", timeoutMs + 8000
        t0 = Util.TickMs()
        stNow = st
        sawRun = False
        sawBreak = False
        Set seq = New Collection
        Set ebSeq = New Collection
        lastPos = ""
        lastPosAt = 0
        ebRunSaw = False
        runFirstAt = 0
        settleWindow = 150
        If timeoutMs \ 2 < settleWindow Then settleWindow = timeoutMs \ 2
        Do
            If CanPump() Then DoEvents
            MaybeHonorCancel
            stNow = GetIdeState()
            If seq.Count < 400 Then seq.Add stNow
            ebNow = IdeEbMode()
            If ebSeq.Count < 400 Then ebSeq.Add ebNow
            ' FIX-15: the ENGINE flag counts as having observed RUN.
            If ebNow = 1 Then
                sawRun = True
                ebRunSaw = True
                If runFirstAt = 0 Then runFirstAt = Util.TickMs()
            End If
            If stNow = "run" Then
                sawRun = True
                If runFirstAt = 0 Then runFirstAt = Util.TickMs()
            End If
            If stNow = "break" Then
                sawBreak = True
                Exit Do
            End If
            If sawRun Then
                If Util.TickMs() - lastPosAt >= 100 Then
                    lastPos = ToolCurrentPosition()
                    lastPosAt = Util.TickMs()
                End If
            End If
            ' FIX-16: design must HOLD for a stability window before we conclude the run returned.
            If sawRun And stNow = "design" Then
                If runFirstAt > 0 Then
                    If Util.TickMs() - runFirstAt >= settleWindow Then Exit Do
                End If
            End If
            McpDb.DbBriefWait Me, 25
            If Util.TickMs() - t0 >= timeoutMs Then Exit Do
        Loop
        Set diag = CreateObject("Scripting.Dictionary")
        Set diag("stateSequence") = seq
        Set diag("ebModeSamples") = ebSeq
        diag("lastPosition") = lastPos
        diag("timeoutMs") = timeoutMs
        diag("sawRun") = sawRun
        diag("ebModeSawRun") = ebRunSaw
        posJ = ""
        hitLine = 0
        hitProc = ""
        hitModule = ""
        If sawBreak Then
            posJ = ToolCurrentPosition()
            hitModule = McpDb.DbPosField(Me, posJ, "module")
            hitProc = McpDb.DbPosField(Me, posJ, "proc")
            hitLine = McpDb.DbPosLine(Me, posJ)
            Set posObj = CreateObject("Scripting.Dictionary")
            posObj("component") = hitModule
            posObj("proc") = hitProc
            posObj("paneLine") = hitLine
            Set root("position") = posObj
            root("positionRaw") = posJ
            root("positionSource") = "paneSelection"
            root("proc") = hitProc
            root("module") = hitModule
            root("line") = hitLine
            root("callstack") = Vba6Probe.CallstackJson(32)
            root("stopReason") = "initial_break"
            hitText = ""
            If JsonParse(posJ, pv) Then
                If IsObject(pv) Then hitText = JsonGetStr(pv, "text", "")
            End If
            root("hitLineText") = hitText
            root("targetLineText") = cls("lineText")
            textHit = False
            If Len(Trim$(hitText)) > 0 Then
                If LCase$(Trim$(hitText)) = LCase$(Trim$(CStr(cls("lineText")))) Then textHit = True
            End If
            If hitLine = lineN Or textHit Then
                root("probeResult") = "stopped_at_target"
            Else
                root("probeResult") = "stopped_elsewhere"
            End If
        ElseIf sawRun And stNow = "design" Then
            root("probeResult") = "did_not_stop"
            root("note") = "the program ran (engine/state evidence) and design held for " & CStr(settleWindow) & " ms with no breakpoint stop"
        ElseIf sawRun Then
            root("probeResult") = "timeout"
            root("note") = "run WAS observed but neither a break nor a settle back to design happened within " & CStr(timeoutMs) & " ms"
        Else
            mtAfter = ""
            If WinOps.HasVisibleHostDialog(mtAfter) Then
                root("probeResult") = "run_failed"
                root("reason") = "dialog_after_start"
                root("modalTitle") = mtAfter
            Else
                root("probeResult") = "did_not_stop_unobserved"
                root("note") = "no run/break sample was ever observed in this phase; this does NOT conclude the program finished"
            End If
        End If
        If runFirstAt > 0 Then root("runObservedMs") = Util.TickMs() - runFirstAt
        If root("probeResult") <> "stopped_at_target" And root("probeResult") <> "stopped_elsewhere" Then
            Set root("diagnostics") = diag
        End If
        ' ---- END + PROVE (or report a still-running program honestly) ----
        ended = False
        endT0 = Util.TickMs()
        dlgPresent = False
        dlgCount = 0
        If LCase$(stNow) = "run" Or LCase$(stNow) = "break" Or IdeEbMode() = 1 Or IdeEbMode() = 2 Then
            root("endRequested") = True
            ended = McpDb.DbClickEnd(Me)
            root("executedEnd") = ended
            ' MEASURED fallback attempt (published even when it fails): while the program RUNS the
            ' CommandBars model is suspended, so an End that reports False may be queued; a posted
            ' WM_KEYDOWN VK_CANCEL is NOT the Ctrl+Break accelerator, and the measurement below
            ' says whether it changed anything. Nothing is claimed without the read-back.
            If (Not ended) And LCase$(stNow) = "run" Then
                hIde = 0
                On Error Resume Next
                hIde = CLng(m_vbe.MainWindow.HWnd)
                Err.Clear
                On Error GoTo BP_PR_ERR
                If hIde <> 0 Then
                    sbkDown = WinOps.SendWindowMessageJson(hIde, "message", "wm_keydown", "", "3", "", 1, True, False)
                    sbkUp = WinOps.SendWindowMessageJson(hIde, "message", "wm_keyup", "", "3", "", 1, True, False)
                    root("ctrlBreakPost") = sbkDown
                    root("ctrlBreakPostUp") = sbkUp
                    ebAfterKey = IdeEbMode()
                    root("ebModeAfterCtrlBreak") = ebAfterKey
                Else
                    root("ctrlBreakPostSkipped") = "no_ide_main_window_hwnd"
                End If
            End If
        End If
        stSrc = ""
        barsSusp = False
        stAfter = ""
        designStreak = 0
        Set endSamples = New Collection
        settleDeadline = Util.TickMs() + 6000
        Do
            dlgN = 0
            If WinOps.WoModalFastPresent(dlgN) Then
                stAfter = "modal_blocked"
                dlgPresent = True
                dlgCount = dlgN
                designStreak = 0
            Else
                stAfter = GetIdeStateEx(stSrc, barsSusp)
                If LCase$(stAfter) = "design" Then
                    designStreak = designStreak + 1
                Else
                    designStreak = 0
                End If
            End If
            If endSamples.Count < 40 Then endSamples.Add stAfter
            If designStreak >= 3 Then Exit Do
            If Util.TickMs() >= settleDeadline Then Exit Do
            If CanPump() Then DoEvents
            McpDb.DbBriefWait Me, 50
        Loop
        root("stateAfterEndRequest") = stAfter
        root("stateAfterEndRequestSource") = stSrc
        root("commandBarsSuspendedAfter") = barsSusp
        root("designConfirmed") = (designStreak >= 3 And Not dlgPresent)
        If designStreak >= 3 Then
            root("stateAfter") = "design"
        ElseIf LCase$(stAfter) = "design" Then
            root("stateAfter") = "design_unconfirmed"
        Else
            root("stateAfter") = stAfter
        End If
        root("stateAfterVerifiedBy") = "ide_state"
        root("stateAfterSource") = "settle_with_dialog_check"
        Set root("endSettleSamples") = endSamples
        root("endSettleDesignStreak") = designStreak
        root("endSettleMs") = Util.TickMs() - endT0
        root("dialogPresent") = dlgPresent
        root("dialogCount") = dlgCount
        stillRun = False
        stFinal = LCase$(GetIdeState())
        ebFinal = IdeEbMode()
        If stFinal = "run" Or ebFinal = 1 Then stillRun = True
        root("programStillRunning") = stillRun
        root("programInBreak") = (stFinal = "break" Or ebFinal = 2)
        root("programStillOpen") = (LCase$(CStr(root("stateAfter"))) <> "design")
        root("finalStateReadBack") = stFinal
        root("finalEbMode") = ebFinal
        If root("programStillOpen") Then
            root("endNotApplied") = True
            root("programEnded") = False
            If CBool(root("endRequested")) And CBool(root("executedEnd")) Then
                ' The End COMMAND was delivered, but its teardown is QUEUED past this call
                ' (measured: state stays break for 6 s in-call, design immediately after the call
                ' returns). NEVER claim the end without the read-back: keep the probeId alive and
                ' ask for a CONFIRM call.
                m_bpProbeAwaitEnd = True
                m_bpProbePendingResult = CStr(root("probeResult"))
                m_bpProbePendingPos = posJ
                root("endPending") = True
                root("endNotAppliedReason") = "End was delivered (executedEnd=true) but design is NOT observable inside this call (queued teardown, measured); endPending=true and the same probeId stays valid for the confirm call"
                root("howToContinue") = "the End command was issued but its teardown is only observable AFTER this call returns (measured). Call breakpoints{action:probe, phase:observe, probeId:" & Chr$(34) & m_bpProbeLiveId & Chr$(34) & "} again to CONFIRM stateAfter=design by read-back; the behavioural result already measured is " & CStr(root("probeResult"))
                root("howToProceed") = root("howToContinue")
            ElseIf stillRun Then
                root("endNotAppliedReason") = "no in-call stop route delivered while the program RUNS: CommandBars are suspended in run state (measured) and a posted WM_KEYDOWN VK_CANCEL is not the Ctrl+Break accelerator (see ctrlBreakPost / ebModeAfterCtrlBreak)"
                root("howToProceed") = "the program is still RUNNING (measured). This build has no reliable in-process stop from RUN state: stop it with the hub ide_kill_and_relaunch, or press Ctrl+Break in the IDE and call control_execution{end}. Then start a new probe."
            Else
                root("endNotAppliedReason") = "the program is not in design and no delivered End was issued; nothing is claimed"
                root("howToProceed") = "read finalStateReadBack/finalEbMode and stop the program explicitly (control_execution{end} / ide_kill_and_relaunch)"
            End If
        Else
            root("endNotApplied") = False
            root("endNotAppliedReason") = ""
            root("programEnded") = True
        End If
        DisarmGateRelease
        If root("probeResult") = "stopped_at_target" Or root("probeResult") = "stopped_elsewhere" Or root("probeResult") = "did_not_stop" Then root("ok") = True
        root("cost") = "BEHAVIOURAL verification (phase 2 of 2): the program was started by phase=start, this call observed it, read position/callstack, then ended it and PROVED the state by read-back. This tool never calls SaveProject (no pre-run flush). The IDE has no breakpoint API, so this is the only honest channel for 'is my breakpoint effective'."
        root("elapsedMs") = Util.TickMs() - m_bpProbeT0
        BpProbeCleanupClose root
        If Not CBool(root("endPending")) Then m_bpProbeLiveId = ""
        BpProbeJson = JsonStringify(root)
        Exit Function
    End If
    ' ---------- phase=start ----------
    root("component") = comp
    root("targetLine") = lineN
    Set tgtObj = CreateObject("Scripting.Dictionary")
    tgtObj("component") = comp
    tgtObj("paneLine") = lineN
    Set root("target") = tgtObj
    If Len(comp) = 0 Or lineN <= 0 Then
        root("reason") = "component_and_line_required"
        Call BpProbeEarlyExit(root, "component_and_line_required")
        BpProbeJson = JsonStringify(root)
        Exit Function
    End If
    Set cls = McpBpPane.BpClassifyPaneLine(Me, comp, lineN)
    root("lineClass") = cls("lineClass")
    If Not CBool(cls("breakable")) Then
        ' FIX-13: a line the classifier is UNSURE about must still be probed - the RUN decides.
        ' Only a clearly non-executable position is refused before starting.
        lcNow = CStr(cls("lineClass"))
        If lcNow = "component_not_found" Or lcNow = "no_code_module" Or lcNow = "blank_line" Or lcNow = "comment_line" Then
            root("probeResult") = "line_not_breakable"
            Set root("classification") = cls
            Call BpProbeEarlyExit(root, "line_not_breakable")
            BpProbeJson = JsonStringify(root)
            Exit Function
        End If
        root("classificationCaveat") = lcNow
    End If
    st = GetIdeState()
    root("stateBefore") = st
    If st <> "design" Then
        root("probeResult") = "run_failed"
        root("reason") = "not_in_design: phase=start begins a NEW RUN, so it must be called from design (current state=" & st & "); observe a pending probe first or stop the program"
        root("state") = st
        Call BpProbeEarlyExit(root, "not_in_design")
        BpProbeJson = JsonStringify(root)
        Exit Function
    End If
    mdc = 0
    If WinOps.WoModalFastPresent(mdc) Then
        root("probeResult") = "run_failed"
        root("reason") = "blocked_by_modal"
        root("dialogPresent") = True
        root("dialogCount") = mdc
        root("modalTitleDeferred") = True
        Call BpProbeEarlyExit(root, "blocked_by_modal")
        BpProbeJson = JsonStringify(root)
        Exit Function
    End If
    ArmGateRelease "breakpoints_probe_start", 15000
    why = ""
    started = McpDb.DbClickStart(Me, why)
    root("executedStart") = started
    root("startedPending") = started
    root("startQueued") = True
    root("startWhy") = why
    If Not started Then
        root("probeResult") = "run_failed"
        root("reason") = "start_command_not_found"
        DisarmGateRelease
        Call BpProbeEarlyExit(root, "start_command_not_found")
        BpProbeJson = JsonStringify(root)
        Exit Function
    End If
    ' ---- issue the single-use probeId (a NEW start invalidates the previous id) ----
    m_bpProbeSeq = m_bpProbeSeq + 1
    m_bpProbeLiveId = "bp-" & Format$(Now, "yyyymmddhhnnss") & "-" & CStr(m_bpProbeSeq) & "-" & CStr(GetTickCount() And &HFFFF&)
    m_bpProbeLiveAt = Util.TickMs()
    m_bpProbeLiveComp = comp
    m_bpProbeLiveLine = lineN
    m_bpProbeLiveLedger = McpBpReg.BpProbeLedgerCount(Me)
    m_bpProbeAwaitEnd = False
    m_bpProbePendingResult = ""
    m_bpProbePendingPos = ""
    m_bpProbeT0 = Util.TickMs()
    root("probeId") = m_bpProbeLiveId
    root("probeIdTtlMs") = BP_PROBE_ID_TTL_MS
    root("probeResult") = "started_pending"
    root("ok") = True
    ' MEASURED, never assumed: right after the click the IDE still reads design because the Start
    ' command is QUEUED. 'run' is the EXPECTED next state, not a measurement - so it is published
    ' as stateAfterExpected and NEVER written into stateAfter.
    stAtReturn = GetIdeState()
    root("stateAfter") = stAtReturn
    root("stateAfterExpected") = "run"
    root("stateAfterVerifiedBy") = "ide_state_at_return"
    root("stateAfterNote") = "the Start command is QUEUED in the STA IDE: this is the MEASURED state at return (usually design); the run begins AFTER this call returns. Do not read stateAfter as 'the program finished'."
    root("howToContinue") = "call breakpoints{action:probe, phase:observe, probeId:" & Chr$(34) & m_bpProbeLiveId & Chr$(34) & "} within " & CStr(BP_PROBE_ID_TTL_MS) & " ms: it waits up to timeout_ms for the stop, reads position/callstack, ends the program and PROVES stateAfter=design by read-back"
    root("howToProceed") = root("howToContinue")
    DisarmGateRelease
    root("cost") = "BEHAVIOURAL verification, phase 1 of 2: this call really STARTS the program (it never saves the project / no pre-run flush). The IDE has no breakpoint API, so the behavioural answer must come from observation - and the STA IDE makes that impossible in the same call. Use phase=observe next; never read a single-call claim as a behavioural verdict."
    root("elapsedMs") = Util.TickMs() - m_bpProbeT0
    BpProbeCleanupClose root
    BpProbeJson = JsonStringify(root)
    Exit Function
BP_PR_ERR:
    On Error Resume Next
    root("ok") = False
    root("probeResult") = "run_failed"
    root("reason") = "unexpected_error"
    root("errorMessage") = Err.Description
    Call McpDb.DbClickEnd(Me)
    Call BpProbeEarlyExit(root, "unexpected_error")
    If Len(m_bpProbeLiveId) > 0 Then root("probeIdStillLive") = m_bpProbeLiveId
    DisarmGateRelease
    BpProbeJson = JsonStringify(root)
End Function
' FIX-14: ONE filler for every refusal receipt (top-level, nested set_breakpoint, native
' toggle failure): lineClass / lineText / nearestBreakable are always present when a line can
' be resolved (from args.line, or from the injected anchor's pane line).
Private Function BpEnrichRefusal(ByVal js As String, ByVal args As Object) As String
    BpEnrichRefusal = js
    On Error Resume Next
    Dim v As Variant
    If Not JsonParse(js, v) Then Err.Clear : Exit Function
    If Not IsObject(v) Then Err.Clear : Exit Function
    Dim d As Object
    Set d = v
    If Not d.Exists("reason") Then Err.Clear : Exit Function
    Dim comp As String
    Dim anchorArg As String
    Dim ln As Long
    Dim rsn As String
    comp = JsonGetStr(args, "component")
    anchorArg = JsonGetStr(args, "anchor")
    ln = JsonGetLong(args, "line", 0)
    rsn = JsonGetStr(d, "reason", "")
    ' FIX-19: anchor refusals ALWAYS get hits[] + an explicit classification, BEFORE the
    ' "already classified" shortcut and regardless of args.line. A repeated anchor cannot be
    ' resolved to ONE pane line, so lineClass stays explicitly unresolved (with the reason and
    ' every candidate in hits[]), never a guessed first hit.
    If rsn = "anchor_not_unique" Or rsn = "anchor_not_found" Then
        Dim hits As Object
        Set hits = McpBpPane.BpHitsOfAnchor(Me, comp, anchorArg)
        Set d("hits") = hits
        d("hitCount") = hits.Count
        Dim ucls As Object
        Set ucls = CreateObject("Scripting.Dictionary")
        ucls("breakable") = False
        ucls("anchorHitCount") = hits.Count
        If hits.Count >= 1 Then
            Dim h0 As Object
            Set h0 = hits.Item(1)
            Dim firstLn As Long
            firstLn = CLng(h0("paneLine"))
            Dim cls0 As Object
            Set cls0 = McpBpPane.BpClassifyPaneLine(Me, comp, firstLn)
            d("lineClass") = "unresolved"
            d("lineText") = CStr(h0("text"))
            d("unresolvedReason") = "anchor_matched_" & CStr(hits.Count) & "_lines: choose occurrence=1.." & CStr(hits.Count) & " from hits[]"
            d("candidateLineClass") = cls0("lineClass")
            Set d("nearestBreakable") = cls0("nearestBreakable")
            ucls("lineClass") = "unresolved"
            ucls("candidateLineClass") = cls0("lineClass")
        Else
            d("lineClass") = "unresolved"
            d("lineText") = ""
            d("unresolvedReason") = "anchor_not_found: no pane line matches the anchor"
            Dim uemp As Object
            Set uemp = CreateObject("Scripting.Dictionary")
            Set d("nearestBreakable") = uemp
            ucls("lineClass") = "unresolved"
        End If
        Set d("classification") = ucls
        BpEnrichRefusal = JsonStringify(d)
        Err.Clear
        Exit Function
    End If
    If d.Exists("lineClass") And d.Exists("nearestBreakable") Then
        If Len(CStr(d("lineClass"))) > 0 Then Err.Clear : Exit Function
    End If
    If ln <= 0 Then
        If Len(anchorArg) > 0 Then ln = McpBpPane.BpAnchorPaneLine(Me, comp, anchorArg)
    End If
    If ln <= 0 Then
        d("lineClass") = "unresolved"
        d("lineText") = ""
        d("unresolvedReason") = "line_unresolved: component/anchor/line did not resolve to a pane line"
        Dim ucls2 As Object
        Set ucls2 = CreateObject("Scripting.Dictionary")
        ucls2("lineClass") = "unresolved"
        ucls2("breakable") = False
        Set d("classification") = ucls2
        If Not d.Exists("nearestBreakable") Then
            Dim uemp2 As Object
            Set uemp2 = CreateObject("Scripting.Dictionary")
            Set d("nearestBreakable") = uemp2
        End If
        BpEnrichRefusal = JsonStringify(d)
        Err.Clear
        Exit Function
    End If
    Dim cls As Object
    Set cls = McpBpPane.BpClassifyPaneLine(Me, comp, ln)
    Dim lc As String
    lc = CStr(cls("lineClass"))
    If Len(lc) > 0 Then d("lineClass") = lc
    d("lineText") = cls("lineText")
    d("classification") = cls
    Set d("nearestBreakable") = cls("nearestBreakable")
    BpEnrichRefusal = JsonStringify(d)
    Err.Clear
End Function

' FIX-14: pane line of an injected anchor (trim-compare), 0 when absent.
' FIX-17: CommandBars liveness probe - a suspended model must refuse BEFORE any menu command.
Private Function BpCommandBarsSuspended() As Boolean
    ' reuse the SAME detector ide_state uses (GetIdeStateEx), so the gate cannot disagree
    ' with what ide_state reports.
    Dim ss As String
    Dim bs As Boolean
    ss = ""
    bs = False
    Call GetIdeStateEx(ss, bs)
    BpCommandBarsSuspended = bs
End Function

' FIX-17: every hit of an anchor, with paneLine + text + proc, so anchor_not_unique can be
' answered by choosing occurrence instead of guessing.

' FIX-17: CommandBarControl Id without letting a suspended model raise.
Public Function CtrlIdSafe(ByVal c As Object) As Long
    CtrlIdSafe = 0
    On Error Resume Next
    CtrlIdSafe = CLng(c.Id)
    Err.Clear
End Function


Private Function BpSetJson(ByVal args As Object, ByRef root As Object) As String
    Dim comp As String, anchor As String, id As String, mode As String
    comp = JsonGetStr(args, "component")
    anchor = JsonGetStr(args, "anchor")
    id = JsonGetStr(args, "id")
    mode = LCase$(Trim$(JsonGetStr(args, "mode")))
    If Len(mode) = 0 Then mode = "injected"
    root("mode") = mode
    If Len(comp) = 0 Then
        root("reason") = "component_required"
        BpSetJson = JsonStringify(root)
        Exit Function
    End If
    If Len(id) = 0 Then id = "bp-" & CStr(McpBpReg.BpRegistry(Me).Count + 1) & "-" & CStr(Int(Timer))
    root("id") = id
    Dim hc As Long
    hc = JsonGetLong(args, "hitCount", 1)
    If hc < 1 Then hc = 1
    root("hitCount") = hc
    Dim rec As Object
    If mode = "native" Then
        Dim cbRN As Object
        If CmdBarsRunRefusal("breakpoints:native", cbRN) Then
            BpSetJson = JsonStringify(cbRN)
            Exit Function
        End If
        If CmdBarsBreakRefusal("breakpoints:native", cbRN) Then
            BpSetJson = JsonStringify(cbRN)
            Exit Function
        End If
        Dim lineN As Long
        lineN = JsonGetLong(args, "line", 0)
        If lineN <= 0 Then
            root("reason") = "line_required_for_native_mode"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        ' FIX-22 (1): decide in the LEDGER before sending anything.
        '   same paneSha  -> already_set (a toggle would REMOVE it; never re-post)
        '   stale paneSha -> stale_native_record (no F9, no wait) unless clearStale=true
        Dim live0 As Object
        Set live0 = WinOps.WoHostLiveness(200)
        Set root("hostProbeBefore") = live0
        If Not CBool(live0("responds")) Then
            root("reason") = "host_unresponsive"
            root("sideEffects") = "none: no COM read and no F9 were attempted while the host was unresponsive"
            root("howToProceed") = "the IDE is not answering IsHungAppWindow/WM_NULL; wait for it to settle or restart, then retry - nothing was sent"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        Dim exists As Object
        Set exists = McpBpPane.BpFindNativeRecord(Me, comp, lineN)
        If Not exists Is Nothing Then
            Dim shaNow As String
            shaNow = McpBpPane.BpPaneSha(Me, comp)
            Dim shaAtSet As String
            shaAtSet = JsonGetStr(exists, "paneShaAtSet", "")
            root("paneLine") = lineN
            root("paneShaAtSet") = shaAtSet
            root("currentPaneSha") = shaNow
            If Len(shaAtSet) > 0 Then
                If StrComp(shaAtSet, shaNow, vbTextCompare) = 0 Then
                    root("reason") = "already_set"
                    Set root("existing") = exists
                    root("setAt") = JsonGetStr(exists, "setAt", "")
                    root("note") = "a native toggle would REMOVE the breakpoint; call clear first if you meant to replace it - no F9 was sent"
                    BpSetJson = JsonStringify(root)
                    Exit Function
                End If
                If Not JsonGetBool(args, "clearStale", False) Then
                    root("reason") = "stale_native_record"
                    Set root("existing") = exists
                    root("setAt") = JsonGetStr(exists, "setAt", "")
                    root("menuCommandSent") = False
                    root("postSent") = False
                    root("howToProceed") = "the persisted native record for this line was made when the pane text differed (paneShaAtSet != currentPaneSha). Clear it first (breakpoints{action:clear, id/component+line}) and set again, or pass clearStale=true to clear it and post now - no F9 was sent"
                    BpSetJson = JsonStringify(root)
                    Exit Function
                End If
                Call McpBpReg.BpRemoveLedgerId(Me, CStr(exists("id")))
                root("clearedStale") = True
                root("clearedStaleId") = CStr(exists("id"))
            End If
        End If
        ' FIX-7: classify the PANE line FIRST. A position VB6 refuses makes the Debug-menu
        ' toggle block inside a host modal that this single-threaded add-in cannot dismiss
        ' from the call itself, so an unusable line must be refused BEFORE any menu command.
        Dim bpCls As Object
        Set bpCls = McpBpPane.BpClassifyPaneLine(Me, comp, lineN)
        root("lineClass") = bpCls("lineClass")
        root("breakable") = bpCls("breakable")
        If Not CBool(bpCls("breakable")) Then
            Set root("classification") = bpCls
            root("reason") = "line_not_breakable"
            root("lineClass") = bpCls("lineClass")
            root("lineText") = bpCls("lineText")
            Set root("nearestBreakable") = bpCls("nearestBreakable")
            root("menuCommandSent") = False
            root("howToProceed") = "choose a statement line INSIDE a procedure body (see classification.nearestBreakable); mode=injected never opens a dialog"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        ' FIX-22: message-free presence check (no GetWindowText; the title is not needed here).
        Dim bpModalTitle As String
        bpModalTitle = ""
        Dim bpx As Long
        bpx = 0
        If WinOps.WoModalFastPresent(bpx) Then
            root("reason") = "blocked_by_modal"
            root("modalTitle") = ""
            root("modalTitleDeferred") = True
            root("dialogCount") = bpx
            root("menuCommandSent") = False
            root("howToProceed") = "a dialog is already up: dismiss it first (send_window_message / close_active_dialogs), then retry - no click is sent while it is up"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        ' FIX-17: the Debug-MENU toggle is NOT used here. Measured on t16: ctrl.Execute
        ' blocked for 40 s inside a host modal and the IDE then died. The native channel is
        ' now the ASYNC F9 accelerator (PostMessage -> returns at once), gated and bounded.
        root("channel") = "postmessage"
        root("menuCommandSent") = False
        root("postSent") = False
        root("wedge") = False
        root("stateUnreadable") = False
        Dim stPre As String
        Dim livePre As Object
        Set livePre = WinOps.WoHostLiveness(200)
        Set root("hostProbeBeforeState") = livePre
        If Not CBool(livePre("responds")) Then
            root("reason") = "host_unresponsive"
            root("sideEffects") = "none: no state read and no F9 were attempted"
            root("howToProceed") = "the IDE is not answering IsHungAppWindow/WM_NULL; wait or restart, then retry - nothing was sent"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        stPre = GetIdeState()
        If LCase$(stPre) <> "design" Then
            root("reason") = "not_in_design"
            root("state") = stPre
            root("howToProceed") = "the async breakpoint channel needs design mode; finish the run (control_execution{end}) and retry"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        Dim liveBars As Object
        Set liveBars = WinOps.WoHostLiveness(200)
        Set root("hostProbeBeforeCommandBars") = liveBars
        If Not CBool(liveBars("responds")) Then
            root("reason") = "host_unresponsive"
            root("sideEffects") = "none: no CommandBars read and no F9 were attempted"
            root("howToProceed") = "the IDE is not answering IsHungAppWindow/WM_NULL; wait or restart, then retry - nothing was sent"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        If BpCommandBarsSuspended() Then
            root("reason") = "commandbars_suspended"
            root("state") = stPre
            root("howToProceed") = "the VB6 CommandBars model is suspended (program running or IDE busy); stop it and retry - nothing was sent"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        Dim nBudget As Long
        nBudget = JsonGetLong(args, "timeout_ms", 15000)
        If nBudget < 1000 Then nBudget = 1000
        If nBudget > 120000 Then nBudget = 120000
        root("armedBudgetMs") = nBudget
        Dim liveCp As Object
        Set liveCp = WinOps.WoHostLiveness(200)
        Set root("hostProbeBeforeCodePane") = liveCp
        If Not CBool(liveCp("responds")) Then
            root("reason") = "host_unresponsive"
            root("sideEffects") = "none: no code-pane read and no F9 were attempted"
            root("howToProceed") = "the IDE is not answering IsHungAppWindow/WM_NULL; wait or restart, then retry - nothing was sent"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        Dim cpT As VBIDE.CodePane
        Set cpT = GetCodePane(comp)
        If cpT Is Nothing Then
            root("reason") = "no_code_pane"
            root("howToProceed") = "open the component's code pane, then retry"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        ' FIX-22f: no pane-text snapshot - the path is fire-and-forget and takes no post COM.
        On Error Resume Next
        Err.Clear
        cpT.SetSelection lineN, 1, lineN, 1
        If Err.Number <> 0 Then
            root("reason") = "selection_failed"
            root("errorMessage") = Err.Description
            Err.Clear
            On Error GoTo 0
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        On Error GoTo 0
        ' FIX-22f: capture the pane hash BEFORE the post; after the post NO COM is allowed, so
        ' the ledger record is built from these pre-captured values only.
        Dim paneShaPre As String
        paneShaPre = McpBpPane.BpPaneSha(Me, comp)
        Dim postRes As Object
        Set postRes = WinOps.WoPostF9ToFocus()
        root("postSent") = CBool(postRes("ok"))
        root("postTarget") = postRes("hwnd")
        root("postTargetClass") = postRes("className")
        If Not CBool(postRes("ok")) Then
            root("reason") = "native_channel_unavailable"
            root("postReason") = postRes("reason")
            root("howToProceed") = "the async F9 channel was not reachable (" & CStr(postRes("reason")) & "); use mode=injected (enumerable, cannot hang). The Debug-menu channel is deliberately NOT used: it was measured to block 40 s and then crash the IDE"
            BpSetJson = JsonStringify(root)
            Exit Function
        End If
        ' FIX-22f: FIRE-AND-FORGET. The native effect is NOT readable (no VBIDE API), so the
        ' old observation loop bought no information and could block the whole call. Post, take
        ' one pure-Win32 snapshot (IsHungAppWindow + GetClassName), write the ledger, return.
        Dim postedAt As Long
        postedAt = Util.TickMs()
        root("observationDeferred") = True
        root("howToObserve") = "breakpoints{action:probe} (bounded settle; the only honest observer)"
        root("verification") = "none: the IDE exposes NO breakpoint API; the F9 post is asynchronous and its effect cannot be read back; observation is deferred to breakpoints{action:probe} (tool claim only)"
        root("nativeStateVerified") = False
        root("caretKnown") = True
        root("caretLine") = lineN
        Dim imm As Object
        Set imm = WinOps.WoWin32ThreadState()
        root("immediateHostState") = CStr(imm("state"))
        root("immediateHostStateNote") = "IsHungAppWindow+GetClassName only; NOT the IDE design/break state; no message, no COM"
        root("stateAfter") = "not_observed"
        root("stateAfterSource") = "deferred_to_probe"
        root("ideLeftInBreakKnown") = False
        Dim sawBox As Boolean
        sawBox = False
        Dim mgR As Object
        Set mgR = WinOps.WoModalGuardResident()
        Dim mgSub As Object
        Set mgSub = CreateObject("Scripting.Dictionary")
        mgSub("tickCount") = mgR("tickCount")
        mgSub("sawBox") = False
        mgSub("refusedTicks") = mgR("refusedTicks")
        mgSub("modalCloseSent") = mgR("modalCloseSent")
        mgSub("observation") = "deferred"
        Set root("modalGuard") = mgSub
        Dim nTrace As Object
        Set nTrace = CreateObject("Scripting.Dictionary")
        nTrace("channel") = "postmessage"
        nTrace("vk") = "F9"
        nTrace("targetHwnd") = postRes("hwnd")
        nTrace("targetClass") = postRes("className")
        nTrace("postedAtMs") = postedAt
        nTrace("observation") = "deferred"
        nTrace("immediateHostState") = CStr(imm("state"))
        nTrace("hint") = "use breakpoints{action:probe} to observe the effect"
        Set root("nativeToggleTrace") = nTrace
        OpLog "NATIVE_POST_F9 comp=" & comp & " line=" & CStr(lineN) & " target=" & CStr(postRes("hwnd")) & " class=" & CStr(postRes("className")) & " postedAt=" & CStr(postedAt) & " observation=deferred immediateState=" & CStr(imm("state"))
        root("warning") = "mode=native: the VBIDE object model exposes NO breakpoint API, so this breakpoint cannot be enumerated or verified afterwards; the F9 post is fire-and-forget and observation is deferred to breakpoints{action:probe}"
        Dim rjObj As Object
        Set rjObj = CreateObject("Scripting.Dictionary")
        rjObj("ok") = True
        rjObj("channel") = "postmessage"
        rjObj("postSent") = True
        rjObj("observationDeferred") = True
        rjObj("menuCommandSent") = False
        Dim rj As String
        rj = JsonStringify(rjObj)
        root("toggleReceipt") = Left$(rj, 2000)
        ' No COM after the post: the record is assembled from pre-captured values.
        Set rec = CreateObject("Scripting.Dictionary")
        rec("id") = id
        rec("component") = comp
        rec("paneLine") = lineN
        rec("diskLine") = lineN
        rec("mode") = "native"
        rec("enabled") = True
        rec("setAt") = Format$(Now, "yyyy-mm-dd hh:nn:ss")
        rec("hitCount") = 0
        rec("hitCountTarget") = hc
        rec("paneShaAtSet") = paneShaPre
        rec("origin") = "tool"
        rec("evidence") = "fire_and_forget_post"
        rec("confidence") = "tool_claim_only"
        rec("nativeStateVerified") = False
        Dim regF As Object
        Set regF = McpBpReg.BpRegistry(Me)
        regF.Add id, rec
        Dim saveOk As Boolean
        saveOk = McpBpReg.BpRegSave(Me)
        root("recorded") = saveOk
        ' FIX-22i: verified write status; an invalid on-disk ledger is NEVER reported as ok.
        root("ledgerWrite") = m_bpLedgerStatus
        If Not saveOk Then
            root("ledgerWriteError") = McpBpCore.BpLedgerErrText(Me, m_bpLedgerStatusDetail)
            If Not m_bpLedgerStatusDetail Is Nothing Then Set root("ledgerWriteDetail") = m_bpLedgerStatusDetail
            root("ok") = False
            root("reason") = McpBpCore.BpLedgerReason(Me)
            root("howToProceed") = "the F9 post was sent (fire-and-forget), but the ledger could not be persisted as VALID JSON (see ledgerWriteError). The record is not durable and list may not show it; retry set after checking the ledger path/permissions."
        Else
            root("ok") = True
        End If
        Set root("breakpoint") = rec
        BpSetJson = JsonStringify(root)
        Exit Function
    End If
    ' injected (source marker)
    If Len(anchor) = 0 Then
        root("reason") = "anchor_required_for_injected_mode"
        root("hint") = "mode=native takes line=; mode=injected takes anchor=(the source line text to break before)"
        BpSetJson = JsonStringify(root)
        Exit Function
    End If
    Dim setr As String
    setr = ToolSetBreakpoint(comp, anchor, id, "")
    root("setBreakpointReceipt") = Left$(setr, 2000)
    Dim sv As Variant
    Dim sOk As Boolean
    sOk = True
    If JsonParse(setr, sv) Then
        If IsObject(sv) Then sOk = JsonGetBool(sv, "ok", True)
    End If
    If Not sOk Then
        root("ok") = False
        root("reason") = "set_breakpoint_failed"
        root("ghostPrevented") = True
        BpSetJson = JsonStringify(root)
        Exit Function
    End If
    Dim found As Object
    Set found = McpBpPane.BpFindInjected(Me, id)
    If found Is Nothing Then
        root("reason") = "set_breakpoint_failed"
        BpSetJson = JsonStringify(root)
        Exit Function
    End If
    Dim paneLine As Long
    paneLine = JsonGetLong(found, "line", 0)
    Set rec = McpBpPane.BpNewRecord(Me, comp, paneLine, "injected", id)
    rec("markerLine") = JsonGetLong(found, "markerLine", 0)
    rec("hitCountTarget") = hc
    rec("origin") = "tool"
    rec("evidence") = "source_marker_present"
    rec("confidence") = "verified_source_marker"
    Dim reg2 As Object
    Set reg2 = McpBpReg.BpRegistry(Me)
    reg2.Add id, rec
    Call McpBpReg.BpRegSave(Me)
    Set root("breakpoint") = rec
    root("ok") = True
    BpSetJson = JsonStringify(root)
End Function

Private Function BpListJson(ByRef root As Object) As String
    ' FIX-7: enumerate everything we can PROVE, and say exactly what we cannot.
' Sources merged: disk registry (vb6mcp/breakpoints.json) + this session + source markers.
    Dim out As Object
    Set out = New Collection
    Dim reg As Object
    Set reg = McpBpReg.BpRegistry(Me)
    Dim seen As Object
    Set seen = CreateObject("Scripting.Dictionary")
    Dim disk As Object
    Set disk = McpBpReg.BpRegLoad(Me)
    Dim i As Long
    Dim e As Object
    For i = 1 To disk.Count
        Set e = disk(i)
        Dim did As String
        did = JsonGetStr(e, "id", "")
        If Len(did) > 0 Then
            If Not reg.Exists(did) Then
                Dim dr As Object
                Set dr = CreateObject("Scripting.Dictionary")
                dr("id") = did
                dr("component") = JsonGetStr(e, "component", "")
                dr("paneLine") = JsonGetLong(e, "paneLine", 0)
                dr("diskLine") = JsonGetLong(e, "diskLine", 0)
                dr("mode") = JsonGetStr(e, "mode", "native")
                dr("enabled") = JsonGetBool(e, "enabled", True)
                dr("hitCount") = 0
                dr("hitCountTarget") = 1
                dr("paneShaAtSet") = JsonGetStr(e, "paneShaAtSet", "")
                dr("setAt") = JsonGetStr(e, "setAt", "")
                dr("from") = "disk"
                dr("origin") = "disk"
                dr("persistedAt") = JsonGetStr(e, "setAt", "")
                dr("confidence") = "tool_claim_only"
                out.Add dr
                seen(did) = True
            End If
        End If
    Next
    Dim k As Variant
    For Each k In reg.Keys
        Dim rec As Object
        Set rec = reg(k)
        rec("from") = "session"
        seen(CStr(rec("id"))) = True
        out.Add rec
    Next
    Dim inj As Object
    Set inj = McpBpPane.BpInjectedList(Me)
    For i = 1 To inj.Count
        Set e = inj(i)
        Dim eid As String
        eid = JsonGetStr(e, "id", "")
        If Len(eid) > 0 Then
            If Not seen.Exists(eid) Then
                Dim r2 As Object
                Set r2 = McpBpPane.BpNewRecord(Me, JsonGetStr(e, "component", ""), JsonGetLong(e, "line", 0), "injected", eid)
                r2("markerLine") = JsonGetLong(e, "markerLine", 0)
                r2("enabled") = JsonGetBool(e, "enabled", True)
                r2("from") = "source"
                out.Add r2
                seen(eid) = True
            End If
        End If
    Next
    Dim modes As Object
    Set modes = CreateObject("Scripting.Dictionary")
    Dim origins As Object
    Set origins = CreateObject("Scripting.Dictionary")
    Dim unverifiedN As Long
    unverifiedN = 0
    Dim staleN As Long
    staleN = 0
    For i = 1 To out.Count
        Set rec = out(i)
        Dim pshaNow As String
        pshaNow = McpBpPane.BpPaneSha(Me, CStr(rec("component")))
        rec("paneShaNow") = pshaNow
        rec("stale") = (Len(CStr(rec("paneShaAtSet"))) > 0 And StrComp(CStr(rec("paneShaAtSet")), pshaNow, vbTextCompare) <> 0)
        If CBool(rec("stale")) Then staleN = staleN + 1
        Dim clsA As Object
        Set clsA = McpBpPane.BpClassifyPaneLine(Me, CStr(rec("component")), CLng(rec("paneLine")))
        rec("lineClass") = clsA("lineClass")
        rec("breakableNow") = clsA("breakable")
        Dim mkey As String
        Dim fkey As String
        mkey = CStr(rec("mode"))
        fkey = CStr(rec("from"))
        If modes.Exists(mkey) Then modes(mkey) = CLng(modes(mkey)) + 1 Else modes(mkey) = 1
        If origins.Exists(fkey) Then origins(fkey) = CLng(origins(fkey)) + 1 Else origins(fkey) = 1
        Dim confA As String
        confA = "tool_claim_only"
        If rec.Exists("confidence") Then confA = CStr(rec("confidence"))
        If CBool(rec("stale")) Then confA = "stale"
        rec("confidence") = confA
        rec("origin") = fkey
        If confA = "tool_claim_only" Then unverifiedN = unverifiedN + 1
    Next
    Dim cap As Object
    Set cap = CreateObject("Scripting.Dictionary")
    cap("sourceMarkers") = "full"
    cap("sessionRecords") = "full"
    cap("sessionNativeVerified") = "none"
    cap("humanNative") = "NOT_ENUMERABLE_no_VBIDE_API"
    cap("diskBacked") = False
    cap("behaviouralProbe") = "available(action=probe)"
    cap("note") = "the VBIDE object model has NO breakpoint API: breakpoints set by a HUMAN inside the IDE cannot be listed, verified or cleared by this tool. Source markers (Debug.Assert) are fully enumerable; breakpoints set THROUGH this tool are remembered in the session AND in .vb6mcp/breakpoints.json. diskBacked=unknown until the IDE's own on-disk traces are measured."
    Set root("capability") = cap
    root("ledgerWriteFailed") = m_bpLedgerFailed
    If Not m_bpLedgerFailedDetail Is Nothing Then Set root("ledgerWriteDetail") = m_bpLedgerFailedDetail
    Dim counts As Object
    Set counts = CreateObject("Scripting.Dictionary")
    counts("total") = out.Count
    counts("stale") = staleN
    counts("unverified") = unverifiedN
    Set counts("byMode") = modes
    Set counts("byOrigin") = origins
    Set root("counts") = counts
    root("diskRegistry") = McpBpReg.BpRegPath(Me)
    root("ok") = True
    root("count") = out.Count
    Set root("list") = out
    BpListJson = JsonStringify(root)
End Function




' FIX-22: find a NATIVE ledger record for component+line across SESSION and DISK (a stale
' persisted record from a previous session is exactly the reported trigger).

' FIX-22: remove one id from BOTH the session registry and the persisted ledger.

' FIX-22: on project open/switch, load persisted records and mark NATIVE records stale when
' their pane hash no longer matches the current pane (cross-session contamination guard).
Private Sub BpMarkStaleNativeAfterOpen()
    On Error Resume Next
    Dim reg As Object
    Set reg = McpBpReg.BpRegistry(Me)
    Dim disk As Object
    Set disk = McpBpReg.BpRegLoad(Me)
    Dim i As Long
    For i = 1 To disk.Count
        Dim e As Object
        Set e = disk(i)
        Dim did As String
        did = JsonGetStr(e, "id", "")
        If Len(did) > 0 Then
            If Not reg.Exists(did) Then
                Dim r2 As Object
                Set r2 = CreateObject("Scripting.Dictionary")
                r2("id") = did
                r2("component") = JsonGetStr(e, "component", "")
                r2("paneLine") = JsonGetLong(e, "paneLine", 0)
                r2("diskLine") = JsonGetLong(e, "diskLine", 0)
                r2("mode") = JsonGetStr(e, "mode", "native")
                r2("enabled") = JsonGetBool(e, "enabled", True)
                r2("paneShaAtSet") = JsonGetStr(e, "paneShaAtSet", "")
                r2("setAt") = JsonGetStr(e, "setAt", "")
                r2("from") = "disk"
                r2("origin") = "disk"
                r2("confidence") = "tool_claim_only"
                r2("hitCount") = 0
                r2("hitCountTarget") = 1
                reg.Add did, r2
            End If
        End If
    Next
    Dim cache As Object
    Set cache = CreateObject("Scripting.Dictionary")
    Dim k As Variant
    For Each k In reg.Keys
        Dim rec As Object
        Set rec = reg(k)
        If LCase$(JsonGetStr(rec, "mode", "")) = "native" Then
            Dim comp As String
            comp = JsonGetStr(rec, "component", "")
            Dim cur As String
            If cache.Exists(comp) Then
                cur = cache(comp)
            Else
                cur = McpBpPane.BpPaneSha(Me, comp)
                cache(comp) = cur
            End If
            rec("paneShaNow") = cur
            rec("stale") = (Len(JsonGetStr(rec, "paneShaAtSet", "")) > 0 And StrComp(JsonGetStr(rec, "paneShaAtSet", ""), cur, vbTextCompare) <> 0)
            If CBool(rec("stale")) Then rec("verification") = "unverified_stale" Else rec("verification") = "unverified_current_pane"
            rec("staleCheckedAt") = Format$(Now, "yyyy-mm-dd hh:nn:ss")
        End If
    Next
    Call McpBpReg.BpRegSave(Me)
    Err.Clear
End Sub


Private Function BpClearJson(ByVal args As Object, ByRef root As Object) As String
    Dim id As String, comp As String
    id = JsonGetStr(args, "id")
    comp = JsonGetStr(args, "component")
    Dim lineN As Long
    lineN = JsonGetLong(args, "line", 0)
    ' FIX-22h: LEDGER-ONLY CLEAR. Clearing a breakpoint never enters an IDE path (no menu, no
    ' CommandBars, no GetCodePane/GetIdeState, no F9, no wait): the only RELIABLE effect we can
    ' produce is removing OUR OWN ledger record from session + disk. The IDE-side breakpoint
    ' cannot be read back or removed through any VBIDE API, so its state is declared unknown.
    Dim cleared As Object
    Set cleared = New Collection
    Dim clearedIds As Object
    Set clearedIds = CreateObject("Scripting.Dictionary")
    Dim saveOk As Boolean
    saveOk = BpClearLedgerTargets(id, comp, lineN, cleared, clearedIds)
    If cleared.Count = 0 Then
        root("ok") = False
        root("reason") = "no_such_breakpoint"
        root("id") = id
        root("component") = comp
        root("line") = lineN
        root("howToProceed") = "pass id= (returned by set/list) or component= + line= (PANE line). Only records recorded by THIS tool can be cleared; a breakpoint set by a human inside the IDE is NOT enumerable and cannot be found (no VBIDE breakpoint API)."
        BpClearJson = JsonStringify(root)
        Exit Function
    End If
    Set root("cleared") = cleared
    Set root("clearedIds") = clearedIds
    root("clearedCount") = cleared.Count
    root("ok") = saveOk
    ' FIX-22i: ok / failed / write_invalid - never a bare boolean. A write that was read back and
    ' failed parse/bytes/count validation is write_invalid, not ok.
    root("ledgerWrite") = m_bpLedgerStatus
    If Not saveOk Then
        root("reason") = McpBpCore.BpLedgerReason(Me)
        root("ledgerWriteError") = McpBpCore.BpLedgerErrText(Me, m_bpLedgerStatusDetail)
        If Not m_bpLedgerStatusDetail Is Nothing Then Set root("ledgerWriteDetail") = m_bpLedgerStatusDetail
    End If
    root("ideSideEffect") = "unknown_no_api"
    root("verification") = "none"
    root("nativeStateVerified") = False
    root("howToProceed") = "the ledger record(s) are gone from BOTH the session registry and the persisted ledger. NO IDE action was attempted: the VBIDE has no breakpoint API, so whether an IDE-side breakpoint still exists is UNKNOWN (it may still fire). For mode=injected records the source marker is NOT edited by clear - list may still report it from=source; remove/replace the marker with an edit tool if that is what you want."
    BpClearJson = JsonStringify(root)
End Function

' FIX-22h: the ONLY work clear does - filter the ledger (session registry + persisted disk list)
' by id OR component+paneLine, drop the matches, write the remainder back once. No IDE call here
' either: BpRegLoad/BpRegSaveCollection are pure file IO.
Private Function BpClearLedgerTargets(ByVal id As String, ByVal comp As String, ByVal lineN As Long, ByRef cleared As Object, ByRef clearedIds As Object) As Boolean
    BpClearLedgerTargets = False
    On Error Resume Next
    Dim reg As Object
    Set reg = McpBpReg.BpRegistry(Me)
    Dim disk As Object
    Set disk = McpBpReg.BpRegLoad(Me)
    Dim ids As Object
    Set ids = CreateObject("Scripting.Dictionary")
    Dim k As Variant
    Dim i As Long
    Dim e As Object
    Dim did As String
    If Len(id) > 0 Then
        If reg.Exists(id) Then ids(id) = True
    End If
    For i = 1 To disk.Count
        Set e = disk(i)
        did = JsonGetStr(e, "id", "")
        If Len(did) > 0 Then
            If Len(id) > 0 Then
                If StrComp(did, id, vbTextCompare) = 0 Then ids(did) = True
            ElseIf lineN > 0 Then
                If StrComp(JsonGetStr(e, "component", ""), comp, vbTextCompare) = 0 Then
                    If JsonGetLong(e, "paneLine", 0) = lineN Then ids(did) = True
                End If
            End If
        End If
    Next
    If lineN > 0 And Len(id) = 0 Then
        For Each k In reg.Keys
            Dim rs As Object
            Set rs = reg(k)
            If StrComp(CStr(rs("component")), comp, vbTextCompare) = 0 Then
                If CLng(rs("paneLine")) = lineN Then ids(CStr(rs("id"))) = True
            End If
        Next
    End If
    If ids.Count = 0 Then Exit Function
    Dim seen As Object
    Set seen = CreateObject("Scripting.Dictionary")
    ' collect first, remove afterwards: mutating the Dictionary inside For Each invalidates the
    ' enumerator (VB6 error 340) and would silently miss records.
    Dim rmKeys As Object
    Set rmKeys = New Collection
    For Each k In reg.Keys
        If ids.Exists(CStr(k)) Then
            cleared.Add reg(k)
            seen(CStr(k)) = True
            clearedIds(CStr(k)) = True
            rmKeys.Add CStr(k)
        End If
    Next
    Dim kr As Variant
    For Each kr In rmKeys
        If reg.Exists(CStr(kr)) Then reg.Remove CStr(kr)
    Next
    Dim keep As Object
    Set keep = New Collection
    For i = 1 To disk.Count
        Set e = disk(i)
        did = JsonGetStr(e, "id", "")
        If Len(did) > 0 Then
            If ids.Exists(did) Then
                If Not seen.Exists(did) Then
                    cleared.Add e
                    seen(did) = True
                    clearedIds(did) = True
                End If
            Else
                If Not reg.Exists(did) Then keep.Add e
            End If
        End If
    Next
    For Each k In reg.Keys
        keep.Add reg(k)
    Next
    BpClearLedgerTargets = McpBpReg.BpRegSaveCollection(Me, keep)
    Err.Clear
End Function

Private Function BpEnableDisableJson(ByVal args As Object, ByRef root As Object, ByVal enable As Boolean) As String
    root("enable") = enable
    Dim id As String, comp As String
    id = JsonGetStr(args, "id")
    comp = JsonGetStr(args, "component")
    Dim rec As Object
    Set rec = McpBpPane.BpRecOf(Me, id)
    If rec Is Nothing Then
        root("reason") = "breakpoint_not_found_in_session"
        root("note") = "enable/disable acts on a breakpoint SET BY THIS TOOL in this IDE session (id=); native on/off state cannot be read back from the IDE"
        BpEnableDisableJson = JsonStringify(root)
        Exit Function
    End If
    root("id") = id
    root("component") = rec("component")
    root("paneLine") = rec("paneLine")
    If StrComp(CStr(rec("mode")), "injected", vbTextCompare) = 0 Then
        Dim rj As String
        rj = BpToggleInjected(CStr(rec("component")), CStr(rec("id")), enable)
        root("injectedToggleReceipt") = Left$(rj, 1500)
        Dim changed As Boolean
        changed = False
        Dim v As Variant
        If JsonParse(rj, v) Then
            Dim d As Object
            Set d = v
            If Not d Is Nothing Then changed = JsonGetBool(d, "changed", False)
        End If
        If changed Then rec("enabled") = enable
        root("changed") = changed
        root("ok") = changed
        BpEnableDisableJson = JsonStringify(root)
        Exit Function
    End If
    ' native: the IDE cannot be queried, so the ONLY honest enable/disable is a caret-based toggle
    ' driven by the session record, and the receipt says the state was not verified.
    Dim cur As Boolean
    cur = CBool(rec("enabled"))
    If cur = enable Then
        root("ok") = True
        root("changed") = False
        root("note") = "the session record already says this native breakpoint is " & IIf(enable, "ENABLED", "DISABLED") & "; nothing was sent (the IDE cannot confirm it either way)"
        BpEnableDisableJson = JsonStringify(root)
        Exit Function
    End If
    Dim bpa2 As Object
    Set bpa2 = CreateObject("Scripting.Dictionary")
    bpa2("action") = "toggle"
    bpa2("component") = rec("component")
    bpa2("line") = rec("paneLine")
    Dim rj2 As String
    rj2 = ToolNativeBreakpoint(bpa2)
    root("toggleReceipt") = Left$(rj2, 1500)
    rec("enabled") = enable
    root("changed") = True
    root("nativeStateVerified") = False
    root("ok") = True
    BpEnableDisableJson = JsonStringify(root)
End Function

' enable/disable an INJECTED marker by commenting/uncommenting its assert line (line count and
' the marker block are preserved byte-for-byte apart from that one line).
Private Function BpToggleInjected(ByVal comp As String, ByVal id As String, ByVal enable As Boolean) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = comp
    root("id") = id
    root("enable") = enable
    root("ok") = False
    On Error GoTo BP_ERR
    Dim got As Boolean
    got = False
    Dim txt As String
    txt = PaneTextOfName(comp, got)
    If Len(txt) = 0 Then
        root("reason") = "component_not_found"
        BpToggleInjected = JsonStringify(root)
        Exit Function
    End If
    Dim arr() As String
    arr = Split(txt, vbCrLf)
    Dim beginMark As String
    Dim endMark As String
    beginMark = "' @mcp-break " & id & " begin"
    endMark = "' @mcp-break " & id & " end"
    Dim i As Long
    Dim bIdx As Long
    Dim eIdx As Long
    bIdx = -1
    eIdx = -1
    For i = 0 To UBound(arr)
        If InStr(1, arr(i), beginMark, vbTextCompare) > 0 Then bIdx = i
        If InStr(1, arr(i), endMark, vbTextCompare) > 0 Then eIdx = i
    Next
    If bIdx < 0 Or eIdx <= bIdx Then
        root("reason") = "marker_block_not_found"
        BpToggleInjected = JsonStringify(root)
        Exit Function
    End If
    Dim tIdx As Long
    tIdx = -1
    Dim t As String
    For i = bIdx + 1 To eIdx - 1
        t = Trim$(arr(i))
        If StrComp(t, "Debug.Assert False", vbTextCompare) = 0 Then tIdx = i
        If StrComp(t, "'Debug.Assert False", vbTextCompare) = 0 Then tIdx = i
    Next
    If tIdx < 0 Then
        root("reason") = "assert_line_not_found"
        BpToggleInjected = JsonStringify(root)
        Exit Function
    End If
    Dim cur As String
    cur = Trim$(arr(tIdx))
    If enable Then
        If StrComp(cur, "'Debug.Assert False", vbTextCompare) = 0 Then arr(tIdx) = "    Debug.Assert False"
    Else
        If StrComp(cur, "Debug.Assert False", vbTextCompare) = 0 Then arr(tIdx) = "    'Debug.Assert False"
    End If
    Dim after As String
    after = Join(arr, vbCrLf)
    Dim changed As Boolean
    changed = (StrComp(txt, after, vbTextCompare) <> 0)
    root("changed") = changed
    root("assertLine") = tIdx + 1
    If changed Then
        Dim wc As Long
        wc = SetCompTextMinimal(comp, txt, after)
        root("writeCalls") = wc
        Dim flush As String
        flush = ToolSaveProject("")
        root("flushReceipt") = Left$(flush, 800)
        root("paneSha256After") = Sha256.Sha256HexTextUtf8(PaneTextOfName(comp, got))
    End If
    root("ok") = changed
    BpToggleInjected = JsonStringify(root)
    Exit Function
BP_ERR:
    root("reason") = "unexpected_error"
    root("errorMessage") = Err.Description
    BpToggleInjected = JsonStringify(root)
End Function

Private Function BpClearAllJson(ByRef root As Object) As String
    Dim bpc As Object
    Set bpc = CreateObject("Scripting.Dictionary")
    bpc("action") = "clear_all"
    Dim rj As String
    rj = ToolNativeBreakpoint(bpc)
    root("nativeClearAllReceipt") = Left$(rj, 1500)
    Dim inj As Object
    Set inj = McpBpPane.BpInjectedList(Me)
    Dim cleared As Object
    Set cleared = New Collection
    Dim i As Long
    For i = 1 To inj.Count
        Dim e As Object
        Set e = inj(i)
        Dim eid As String, ecomp As String
        eid = JsonGetStr(e, "id", "")
        ecomp = JsonGetStr(e, "component", "")
        If Len(eid) > 0 And Len(ecomp) > 0 Then
            Dim r2 As String
            r2 = ToolClearBreakpoints(ecomp, eid, "")
            cleared.Add eid
        End If
    Next
    Set m_bpSession = Nothing
    root("ok") = True
    Set root("clearedInjected") = cleared
    root("clearedCount") = cleared.Count
    BpClearAllJson = JsonStringify(root)
End Function

' =====================================================================
' W-H2: get_locals / eval_at_frame / shallow inspection / watch
' =====================================================================

Private Function ToolGetLocals(ByVal args As Object) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("tool") = "get_locals"
    root("ok") = False
    root("localsAvailable") = False
    root("localsUnavailable") = False
    root("localsUnavailableReason") = ""
    root("localsSource") = "SOURCE-DECLARED NAMES (current procedure: parameter list + Dim/Static declarations in its body) + VALUES read in the IDE immediate context, which in BREAK mode is the IDE's own current (innermost) call frame. No engine-internal frame call is made (measured: the frame-set thunk terminated the IDE). Names are never invented; values are never guessed."
    root("depthLimit") = 2
    root("widthLimit") = 20
    Dim fi As Long
    fi = JsonGetLong(args, "frame_index", 0)
    root("frameIndex") = fi
    On Error GoTo GL_ERR
    Dim st As String
    st = GetIdeState()
    root("state") = st
    Dim allowBreak As Boolean
    allowBreak = JsonGetBool(args, "allowUnsafeInBreak", False)
    root("allowUnsafeInBreak") = allowBreak
    If st <> "break" Then
        root("localsUnavailable") = True
        root("localsUnavailableReason") = "not_in_break: get_locals reads a LIVE call frame; break first (set a breakpoint and run_until_break)"
        root("position") = McpDb.DbPositionOrFallback(Me, root)
        root("positionSource") = "none"
        root("callstack") = ""
        ToolGetLocals = JsonStringify(root)
        Exit Function
    End If
    ' WP-22-02 / B5: BREAK + no informed consent is a REFUSAL, not a value-read attempt.
    ' "I could not read the values" and "you did not agree to the risk" are different receipts
    ' and must stay distinguishable (the live FAIL mixed them into one ok:false).
    If Not allowBreak Then
        Dim glWa As Object
        Set glWa = New Collection
        glWa.Add "pass allowUnsafeInBreak:true (INFORMED CONSENT: the value reads evaluate in the IDE immediate context and a raising evaluation can wedge the single-threaded pipe; recovery is hub ide_kill_and_relaunch, NOT taskkill)"
        glWa.Add "or leave BREAK first with control_execution{mode:""continue""} (or step_*) and call get_locals in DESIGN/RUN, where nothing is evaluated in a break frame"
        root("ok") = False
        root("reason") = "break_eval_requires_opt_in"
        root("failureKind") = "toolError"
        root("refusedBeforeExecution") = True
        root("localsUnavailable") = False
        root("localsUnavailableReason") = ""
        root("localsAvailable") = False
        Set root("howToWorkAround") = glWa
        root("howToRecover") = "a refused call never armed the gate, so no recovery is needed; if a LATER opted-in read hangs: ide_state{release_inflight:true, release_min_held_ms:30000} frees the single-flight gate, and a wedged IDE process is restarted with the hub tool ide_kill_and_relaunch"
        root("note") = "REFUSED BEFORE EXECUTION: get_locals in BREAK only runs with allowUnsafeInBreak:true. No identifier was evaluated and nothing was read."
        root("position") = McpDb.DbPositionOrFallback(Me, root)
        root("positionSource") = "none"
        root("callstack") = Vba6Probe.CallstackJson(32)
        ToolGetLocals = JsonStringify(root)
        Exit Function
    End If
    root("optInAccepted") = True
    root("howToRecover") = "if this opted-in call hangs: ide_state{release_inflight:true, release_min_held_ms:30000} frees the single-flight gate; if the IDE process itself is wedged use the hub tool ide_kill_and_relaunch (NOT taskkill)"
    Dim posJ As String
    posJ = ToolCurrentPosition()
    root("position") = posJ
    root("positionSource") = "paneSelection"
    root("proc") = McpDb.DbPosField(Me, posJ, "proc")
    root("module") = McpDb.DbPosField(Me, posJ, "module")
    root("line") = McpDb.DbPosLine(Me, posJ)
    root("callstack") = Vba6Probe.CallstackJson(32)
    Dim diag As Object
    Set diag = CreateObject("Scripting.Dictionary")
    Dim ctxErr As String
    ctxErr = McpWh2.Wh2FrameContext(Me, fi, diag)
    If Len(ctxErr) > 0 Then
        root("localsUnavailable") = True
        root("localsUnavailableReason") = ctxErr
        root("frameBinding") = "ideImmediateContext"
        Set root("diagnostics") = diag
        ToolGetLocals = JsonStringify(root)
        Exit Function
    End If
    root("frameBinding") = "ideImmediateContext"
    root("contextAvailable") = True
    Dim vars As Object
    Set vars = McpWh2.Wh2SourceVars(Me, CStr(root("module")), CStr(root("proc")), root)
    root("sourceVarsCount") = vars.Count
    Set m_lastLocalNames = New Collection
    Dim vi As Long
    For vi = 1 To vars.Count
        m_lastLocalNames.Add CStr(vars(vi)("name"))
    Next
    root("namesAllowList") = "the names below are the ONLY identifiers transcript[].watch will evaluate (unknown names are refused, not evaluated - an unknown identifier can hang the in-flight call)"
    root("valueContext") = "ideImmediateContext: values are read from the IDE immediate context, which is NOT the break frame (measured: a*2 read 0 while a had been assigned 7) - treat every value as unverified; the NAMES are the reliable part"
    ' a bounded gate backstop for the value reads
    ArmGateRelease "get_locals", 8000
    root("gateArmedMs") = 8000
    Dim out As Object
    Set out = New Collection
    Dim i As Long
    Dim v As Object
    Dim rec As Object
    Dim okAny As Boolean
    okAny = False
    For i = 1 To vars.Count
        Set v = vars(i)
        Set rec = McpWh2.Wh2ValueShape(Me, CStr(v("name")), fi, diag)
        rec("kind") = v("kind")
        rec("declaredType") = v("declaredType")
        If v.Exists("paneLine") Then rec("paneLine") = v("paneLine")
        If v.Exists("paneLineSpace") Then rec("paneLineSpace") = v("paneLineSpace")
        If v.Exists("nameSource") Then rec("nameSource") = v("nameSource")
        If rec.Exists("error") Then
            rec("valueRead") = False
        ElseIf Len(CStr(rec("value"))) = 0 Then
            If StrComp(CStr(rec("typeName")), "Empty", vbTextCompare) = 0 Then
                rec("valueRead") = False
                rec("valueUnavailable") = True
                rec("note") = "the IDE immediate context returned no value for this name (it is NOT the break frame - measured); the NAME is still valid"
            Else
                rec("valueRead") = True
                okAny = True
            End If
        Else
            rec("valueRead") = True
            okAny = True
        End If
        rec("valueTrust") = "unverified (ideImmediateContext is not the break frame)"
        out.Add rec
    Next
    root("localsCount") = out.Count
    Set root("locals") = out
    Set root("diagnostics") = diag
    If out.Count = 0 Then
        root("localsUnavailable") = True
        root("localsUnavailableReason") = "no_declared_locals: the current procedure declares no parameters and no Dim/Static locals"
    ElseIf Not okAny Then
        root("localsUnavailable") = True
        root("localsUnavailableReason") = "values_unreadable: the NAMES above are the correct source declarations (sourceVarsCount>0); the VALUES are unavailable because the IDE immediate context is not the break frame (measured). This is a declared limitation, not a failure of the name scan."
    End If
    root("localsAvailable") = okAny
    root("ok") = okAny
    DisarmGateRelease
    root("gateReleased") = True
    root("releaseNote") = "ArmGateRelease(get_locals, 8000) was armed for the value reads and disarmed on return; if a value read ever hangs, ide_state{release_inflight:true} frees the single-flight gate"
    ToolGetLocals = JsonStringify(root)
    Exit Function
GL_ERR:
    root("ok") = False
    root("reason") = "unexpected_error"
    root("errorMessage") = Err.Description
    root("localsUnavailable") = True
    root("localsUnavailableReason") = "unexpected_error: " & Err.Description
    ToolGetLocals = JsonStringify(root)
End Function

Private Function ToolEvalAtFrame(ByVal args As Object) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("tool") = "eval_at_frame"
    root("ok") = False
    root("stopped_at") = ""
    root("frameBinding") = "ideImmediateContext"
    root("frameBindingNote") = "the IDE immediate context is NOT the break frame (measured: a*2 read 0 while a had been assigned 7); frame binding via the engine thunk is FORBIDDEN because it terminated the VB6 process (measured)"
    root("depthLimit") = 2
    root("widthLimit") = 20
    root("howToRecover") = "if this call hangs: ide_state{release_inflight:true, release_min_held_ms:30000} frees the single-flight gate; if the IDE process itself is wedged, restart it (a debug-time evaluation does not change the project on disk)"
    Dim expr As String
    expr = JsonGetStr(args, "expr")
    root("expr") = expr
    Dim fi As Long
    fi = JsonGetLong(args, "frame_index", 0)
    root("frameIndex") = fi
    Dim allowUnsafe As Boolean
    allowUnsafe = JsonGetBool(args, "allowUnsafeEval", False)
    root("allowUnsafeEval") = allowUnsafe
    Dim timeoutMs As Long
    timeoutMs = JsonGetLong(args, "timeoutMs", 0)
    If timeoutMs <= 0 Then timeoutMs = JsonGetLong(args, "timeout_ms", 5000)
    If timeoutMs < 1000 Then timeoutMs = 1000
    If timeoutMs > 60000 Then timeoutMs = 60000
    root("timeoutMs") = timeoutMs
    root("callerBudgetMs") = timeoutMs
    root("budgetNote") = "timeoutMs is a CALLER BUDGET HINT: the add-in cannot preempt an executing VB statement. If this call does not return within the budget, stop waiting and use howToRecover (ide_state{release_inflight:true, release_min_held_ms:5000}, restart the IDE if needed). The internal ArmGateRelease is armed for the budget + slack regardless."
    On Error GoTo EF_ERR
    If Len(expr) = 0 Then
        root("reason") = "expr_required"
        ToolEvalAtFrame = JsonStringify(root)
        Exit Function
    End If
    Dim objProblem2 As String
    objProblem2 = McpImTools.ImObjectExprProblem(Me, expr)
    If Len(objProblem2) > 0 Then
        root("stopped_at") = "refused"
        root("reason") = "object_expression_unsupported"
        root("rejectedToken") = objProblem2
        root("error") = "object/array EXPRESSIONS are not supported by the immediate channel (measured: a plain object assignment hangs the call). Assign the object to a PROJECT variable first and read scalar members, or evaluate a scalar expression."
        root("howToUnblock") = "no unblock exists for object/array expressions; use a project variable + scalar member reads"
        ToolEvalAtFrame = JsonStringify(root)
        Exit Function
    End If
    If fi <> 0 Then
        root("stopped_at") = "frame_binding_forbidden"
        root("reason") = "frame_binding_forbidden"
        root("error") = "OUTER frame_index is not supported: reaching another frame needs the VBA6 frame-set thunk, which is FORBIDDEN because it terminated the VB6 process (measured). Only frame 0 (the IDE current frame) is available, and even that is the immediate context, not the break frame."
        ToolEvalAtFrame = JsonStringify(root)
        Exit Function
    End If
    Dim st As String
    st = GetIdeState()
    root("state") = st
    Dim safeCtx As Boolean
    safeCtx = (st = "design")
    root("safeContext") = safeCtx
    If Not safeCtx Then
        If Not allowUnsafe Then
            root("stopped_at") = "refused"
            root("reason") = "eval_in_break_unsafe"
            root("error") = "evaluation in state '" & st & "' is REFUSED by default: the immediate context is not the break frame and a raising expression can hang the in-flight call (measured)"
            root("howToUnblock") = "pass allowUnsafeEval:true (the call is then wrapped in ArmGateRelease(timeout_ms, default 5000) and the receipt proves gateReleased), or evaluate in DESIGN where the immediate context is safe"
            ToolEvalAtFrame = JsonStringify(root)
            Exit Function
        End If
    End If
    ' ALWAYS arm the backstop: even a DESIGN-mode immediate_eval hung in a measured run
    ' (Array(1,2,3)), so no state is assumed safe; the gate lets the next read-only call
    ' force-release a call that never returns.
    ArmGateRelease "eval_at_frame", timeoutMs + 2000
    root("gateArmedMs") = timeoutMs + 2000
    Dim posJ As String
    posJ = ToolCurrentPosition()
    root("position") = posJ
    root("positionSource") = "paneSelection"
    root("proc") = McpDb.DbPosField(Me, posJ, "proc")
    root("module") = McpDb.DbPosField(Me, posJ, "module")
    Dim diag As Object
    Set diag = CreateObject("Scripting.Dictionary")
    diag("frameBinding") = "ideImmediateContext"
    Dim ev As Object
    Set ev = McpWh2.Wh2EvalRaw(Me, expr)
    If Not ev Is Nothing Then Set root("immediate") = ev
    ' EVAL SAFETY: a REFUSED-before-execution evaluation (or one blocked by a box left by an
    ' earlier abandoned call) is reported with its OWN structured shape, so the caller sees the
    ' real reason instead of the generic "eval" stop.
    If Not ev Is Nothing Then
        If ev.Exists("reason") Then
            Dim evReason As String
            evReason = CStr(ev("reason"))
            If evReason = "refused_would_raise" Or evReason = "previous_call_raised_and_blocked" Then
                root("ok") = False
                root("stopped_at") = CStr(ev("stopped_at"))
                root("reason") = evReason
                root("failureKind") = CStr(ev("failureKind"))
                root("refusedBeforeExecution") = True
                If ev.Exists("error") Then
                    If IsObject(ev("error")) Then Set root("error") = ev("error")
                End If
                If ev.Exists("precheck") Then
                    If IsObject(ev("precheck")) Then Set root("precheck") = ev("precheck")
                End If
                If ev.Exists("wouldRaise") Then root("wouldRaise") = CStr(ev("wouldRaise"))
                If ev.Exists("previousCallError") Then
                    If IsObject(ev("previousCallError")) Then Set root("previousCallError") = ev("previousCallError")
                End If
                root("note") = CStr(ev("note"))
                root("howToProceed") = CStr(ev("howToProceed"))
                Set root("diagnostics") = diag
                root("ideStateAfter") = GetIdeState()
                DisarmGateRelease
                root("gateReleased") = True
                ToolEvalAtFrame = JsonStringify(root)
                Exit Function
            End If
        End If
    End If
    Dim parsed As Boolean
    parsed = False
    If Not ev Is Nothing Then
        If ev.Exists("valueParsed") Then parsed = CBool(ev("valueParsed"))
    End If
    If parsed Then
        root("ok") = True
        root("value") = ev("value")
        root("typeName") = ev("typeName")
        root("output") = ev("output")
        root("outputTrimmed") = ev("outputTrimmed")
    Else
        root("stopped_at") = "eval"
        If ev Is Nothing Then
            root("error") = "immediate_eval returned nothing"
        Else
            root("error") = Left$(CStr(ev("outputTrimmed")), 600)
            If Len(CStr(root("error"))) = 0 Then root("error") = "no value parsed (ret=" & CStr(ev("ret")) & ", execAnswered=" & CStr(ev("execAnswered")) & ")"
        End If
    End If
    If safeCtx Or allowUnsafe Then
        Dim tnRoot As String
        tnRoot = ""
        If Not ev Is Nothing Then
            If ev.Exists("typeName") Then tnRoot = CStr(ev("typeName"))
        End If
        Set root("inspect") = McpWh2.Wh2Inspect(Me, expr, fi, diag, tnRoot)
    Else
        root("inspectSkipped") = "inspection only runs in a safe context (design or allowUnsafeEval)"
    End If
    Set root("diagnostics") = diag
    root("ideStillAnswering") = (Len(GetIdeState()) > 0)
    root("ideStateAfter") = GetIdeState()
    DisarmGateRelease
    root("gateReleased") = True
    root("releaseNote") = "ArmGateRelease(eval_at_frame) was armed for the evaluation and disarmed on return; a hung call is force-released by the next read-only call (ide_state{release_inflight:true, release_min_held_ms:...})"
    ToolEvalAtFrame = JsonStringify(root)
    Exit Function
EF_ERR:
    On Error Resume Next
    DisarmGateRelease
    root("ok") = False
    root("reason") = "unexpected_error"
    root("errorMessage") = Err.Description
    root("stopped_at") = "eval"
    ToolEvalAtFrame = JsonStringify(root)
End Function

 ' The evaluation CONTEXT used by get_locals / eval_at_frame.
 ' MEASURED (2026-10-20, live): calling the engine's internal frame-set thunk from a routine
 ' tool TERMINATED the VB6 process mid-call. A tool that can kill the host is not acceptable,
 ' so this code NEVER calls the thunk: in BREAK mode the IDE immediate context ALREADY evaluates
 ' in the current (innermost) frame, which is frame 0. An OUTER frame_index is refused with the
 ' reason instead of being attempted.

' The immediate_eval receipt as an object (nothing is assumed about its shape beyond the documented keys).

' Convenience: the CStr of an expression, or "" when it could not be read.

' ONE per-value shape shared by get_locals and transcript[].watch.

 ' Shallow inspection with EXPLICIT limits (depth 2 / width 20) and ObjPtr cycle detection.
 ' knownType is the TypeName the caller ALREADY has from the immediate_eval wrapper, so a scalar
 ' value costs ZERO extra IDE evaluations (the first live run was slow because it did 3 per var).

' The VB6 scalar type names: none of these needs object probing.

 ' (wrapper above) - knownType avoids a redundant TypeName evaluation at the top level

' ---- source-side variable names (never invented) ----


' ---- watch: the SAME per-value shape, merged into every transcript break/step ----

' =====================================================================
' W-H3: run_project (two-phase + env) and last_error (dialog body)
' =====================================================================

Private Function ToolRunProject(ByVal args As Object) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("tool") = "run_project"
    root("ok") = False
    ' ---- R-1021-02: fixed observability fields (always present) ----
    Dim rdkAllow As Boolean
    Dim rdkAuto As Object
    Dim rdkG As Object
    rdkAllow = JsonGetBool(args, "allowDiskMutation", False)
    Set rdkAuto = RunDiskAutoSaveBlock()
    RunDiskMergePrim root, rdkAuto
    root("saveOnRun") = False
    root("saveOnRunReason") = ""
    root("allowDiskMutation") = rdkAllow
    root("dirtyBeforeRun") = False
    Set root("diskWrites") = EmptyJsonArray()
    Set root("touchedFiles") = EmptyJsonArray()
    Set rdkG = Nothing
    root("startedPending") = False
    root("startedPid") = 0
    root("runningState") = ""
    root("firstBreakpointHit") = Null
    root("err") = ""
    Set root("envApplied") = EmptyJsonArray()
    root("envRestored") = False
    root("commandLineArgsSupported") = True
    Dim cmdArgs As String
    cmdArgs = JsonGetStr(args, "commandLineArgs")
    root("commandLineArgs") = cmdArgs
    Dim startMode As String
    startMode = JsonGetStr(args, "startMode")
    If Len(startMode) = 0 Then startMode = "Standalone"
    root("startModeRequested") = startMode
    Dim observe As Boolean
    observe = JsonGetBool(args, "observe", False)
    root("observe") = observe
    Dim timeoutMs As Long
    timeoutMs = JsonGetLong(args, "timeout_ms", 15000)
    If timeoutMs <= 0 Then timeoutMs = 15000
    If timeoutMs > 120000 Then timeoutMs = 120000
    root("timeoutMs") = timeoutMs
    ' ---- R-1021-07 addendum: observe budget + explicit done marker (WP-22-02) ----
    Dim obsMaxMs As Long
    obsMaxMs = JsonGetLong(args, "observe_max_wait_ms", 0)
    If obsMaxMs < 0 Then obsMaxMs = 0
    If obsMaxMs > 120000 Then obsMaxMs = 120000
    root("observeMaxWaitMs") = obsMaxMs
    Dim mkObj As Object
    Set mkObj = McpDb.DbObjOf(Me, args, "done_marker")
    Dim mkPath As String
    Dim mkContains As String
    Dim mkProblem As String
    mkPath = ""
    mkContains = ""
    mkProblem = ""
    root("doneMarkerRequested") = (Not mkObj Is Nothing)
    If Not mkObj Is Nothing Then
        mkPath = JsonGetStr(mkObj, "path", "")
        mkContains = JsonGetStr(mkObj, "contains", "")
        If Len(Trim$(mkPath)) = 0 Then mkProblem = "done_marker.path is required (an absolute path on the machine that runs the IDE; UNC allowed)"
        If Len(mkContains) = 0 And Len(mkProblem) = 0 Then mkProblem = "done_marker.contains is required (a case-sensitive text/byte sequence)"
    End If
    If Len(mkProblem) > 0 Then
        root("ok") = False
        root("reason") = "done_marker_invalid"
        root("error") = mkProblem
        root("howToProceed") = "pass done_marker:{path:""<absolute path on the IDE machine>"", contains:""<case-sensitive text>""} or omit the parameter"
        ToolRunProject = JsonStringify(root)
        Exit Function
    End If
    On Error GoTo RP_ERR
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    root("projectStartMode") = McpProjTools.ProjectStartModeText(Me, p)
    root("startModeApplied") = (StrComp(CStr(root("projectStartMode")), startMode, vbTextCompare) = 0)
    If Not CBool(root("startModeApplied")) Then
        root("startModeNote") = "the start mode is a PROJECT property (Project Properties -> Debugging) and cannot be switched at run time; the project currently reports '" & CStr(root("projectStartMode")) & "'"
    End If
    If Len(cmdArgs) > 0 Then
        root("reason") = "commandLineArgsUnsupported"
        root("commandLineArgsSupported") = False
        root("error") = "a Standard EXE started from the VB6 IDE does not receive Command$; Debugging-tab command-line arguments belong to the ActiveX Component start mode"
        root("howToGetArgs") = "build the EXE (make_project) and run it with the arguments, or open an ActiveX project and use its Debugging-tab arguments"
        ToolRunProject = JsonStringify(root)
        Exit Function
    End If
    If observe Then
        ' WP-22-02 / MCP-1021-43: the re-entry rule is EXPLICIT. Observing while the engine is broken
        ' used to pile a second call into the single-flight gate until the IDE was half dead.
        Dim stObs As String
        Dim preObsA As Long
        Dim preObsB As Long
        Dim preObsErr As Long
        preObsA = 0
        preObsB = 0
        On Error Resume Next
        preObsA = GetTickCount()
        stObs = GetIdeState()
        preObsB = GetTickCount()
        preObsErr = Err.Number
        Err.Clear
        On Error GoTo RP_ERR
        root("preObserveClockImpl") = "codetools_gettickcount"
        root("preObserveGetTickCountMs") = CDbl(preObsB) - CDbl(preObsA)
        If preObsErr <> 0 Then root("preObserveClockErrNumber") = preObsErr
        If (CDbl(preObsB) - CDbl(preObsA)) >= 1000# Then root("preObserveGetIdeStateBlocked") = True
        root("ideStateBeforeObserve") = stObs
        If stObs = "break" Then
            root("ok") = False
            root("reason") = "observe_in_break_not_supported"
            root("state") = "break"
            root("observedState") = "break"
            root("breakState") = True
            root("retrySafe") = False
            root("failureKind") = "toolError"
            root("howToProceed") = "observe only WATCHES a running program. While the engine is in BREAK: resume with control_execution{mode:""continue""} (or step_*), or stop it with control_execution{mode:""end""}, then observe again; a one-shot read of the break context is debug_session (one call, gate backstopped) or get_locals{allowUnsafeInBreak:true}."
            ToolRunProject = JsonStringify(root)
            Exit Function
        End If
        ToolRunProject = McpRe.RpObserve(Me, root, timeoutMs, obsMaxMs, mkPath, mkContains)
        Exit Function
    End If
    Dim st As String
    st = GetIdeState()
    root("ideStateBefore") = st
    If st <> "design" Then
        root("reason") = "not_in_design"
        root("error") = "run_project phase 1 STARTS the project, so the IDE must be in design (state=" & st & ")"
        RunDiskAttach root, rdkG, False, st
        ToolRunProject = JsonStringify(root)
        Exit Function
    End If
    ' ---- R-1021-02: gate + BEFORE snapshot (this project has no pre-run flush) ----
    Set rdkG = RunDiskGuardBegin("run_project", "run_project", "design", True, False, rdkAllow, False)
    If CBool(rdkG("refused")) Then
        ToolRunProject = JsonStringify(rdkG("payload"))
        Exit Function
    End If
    Dim applied As Object
    Set applied = New Collection
    Dim envObj As Object
    Set envObj = McpDb.DbObjOf(Me, args, "env")
    If Not envObj Is Nothing Then
        Dim k As Variant
        For Each k In envObj.Keys
            Dim nm As String
            nm = CStr(k)
            Dim oldVal As String
            oldVal = Environ$(nm)
            Dim rc As Long
            rc = SetEnvironmentVariableW(StrPtr(nm), StrPtr(CStr(envObj(k))))
            Dim rec As Object
            Set rec = CreateObject("Scripting.Dictionary")
            rec("name") = nm
            rec("value") = CStr(envObj(k))
            rec("set") = (rc <> 0)
            rec("previousValueWasPresent") = (Len(oldVal) > 0)
            rec("previousValue") = oldVal
            applied.Add rec
        Next
    End If
    Set root("envApplied") = applied
    Set m_envRestore = New Collection
    Dim ai As Long
    For ai = 1 To applied.Count
        m_envRestore.Add applied(ai)
    Next
    Dim why As String
    Dim started As Boolean
    why = ""
    started = McpDb.DbClickStart(Me, why)
    root("executedStart") = started
    root("startWhy") = why
    ' ---- R-1021-02: bounded wait for the QUEUED Start -------------------------
    ' run_project has NO pre-run flush, so a dirty Start with option=Prompt would
    ' raise a MODAL save box: in that case the wait is SKIPPED (never pump into it).
    If started And Not rdkG Is Nothing Then
        Dim rdkSkip As Boolean
        Dim rdkTw As Long
        Dim rdkJunk As String
        Dim rdkAtt2 As Long
        Dim rdkPmp2 As Boolean
        rdkSkip = CBool(rdkG("promptExpected"))
        If CBool(rdkG("dirty")) Then
            If CStr(rdkG("ideMode")) = "prompt" Or CStr(rdkG("ideMode")) = "unknown" Then rdkSkip = True
        End If
        If Not rdkSkip Then
            rdkTw = GetTickCount()
            rdkJunk = WaitIdeLeave("design", RUNSNAP_START_WAIT_MS, rdkAtt2, rdkPmp2)
            rdkG("waitMs") = GetTickCount() - rdkTw
            rdkG("waitAttempts") = rdkAtt2
            rdkG("waitPumped") = rdkPmp2
        End If
    End If
    If started Then
        root("startedPending") = True
        root("stopReason") = "started"
        root("runningState") = "pending"
        Dim hc As Object
        Set hc = CreateObject("Scripting.Dictionary")
        hc("tool") = "run_project"
        Dim ha As Object
        Set ha = CreateObject("Scripting.Dictionary")
        ha("observe") = True
        ha("timeout_ms") = timeoutMs
        Set hc("arguments") = ha
        Set root("howToContinue") = hc
        root("ok") = True
    Else
        root("reason") = "start_command_not_found"
        McpRe.RpRestoreEnv Me, root
    End If
    RunDiskAttach root, rdkG, started, GetIdeState()
    ToolRunProject = JsonStringify(root)
    Exit Function
RP_ERR:
    On Error Resume Next
    root("ok") = False
    root("reason") = "unexpected_error"
    root("errorMessage") = Err.Description
    McpRe.RpRestoreEnv Me, root
    RunDiskAttach root, rdkG, False, ""
    ToolRunProject = JsonStringify(root)
End Function




' WP-22-02: the done-marker probe. The file is read as BYTES (Binary/Get), so a pure-ASCII
' needle is encoding-independent; a non-ASCII needle is tried as system-ANSI bytes and as
' UTF-8 bytes and the receipt says which one matched. NOTHING is written and at most 65536
' bytes are read. The path belongs to the machine that runs this IDE (a remote middle
' service judges it there).




' WP-22-02: only a VB6 RUNTIME-ERROR box is a program error. An IDE dialog is the IDE's own UI
' and must never be reported as the program failing (measured: the old branch called the Find
' box an error). Chinese captions are built with ChrW so this source stays 7-bit ASCII.


' WP-22-02: the observe PRECHECK. A dialog must be classified BEFORE observe starts, so an IDE
' dialog can never be reported as a program failure and observe cannot be stacked into a modal.


' WP-22-02: the observe clock. VB6 Timer (Single seconds since midnight) is used on PURPOSE.
' The previous wait loop was bounded ONLY by its Do-While condition through a helper whose value
' was observed to stay constant on the live build (elapsedMs=0 for a 20 s observation, and a
' 3 s budget never fired), so the loop was effectively unbounded. Timer is a runtime intrinsic
' with no Declare, so it cannot silently read as a constant here.

' ---- WP-22-02 DIAGNOSTICS: honest readings + wait spans (no constants as measurements) ----
' The previous fix failed on the live build with BOTH candidate clocks reading 0, so this round
' instruments instead of guessing: every clock is read with its OWN On Error handler and its
' Err.Number/Err.Description are captured (never silently swallowed); the loop reports its real
' iteration count; per-procedure spans show WHERE the wall time went.
' WP-22-02: one span sample for a call made OUTSIDE RpObserve. DgNow returns 0 when no
' collector is installed, and DgSpan then records nothing (never a fake 0 ms span).





' A clock self-test that does NOT depend on any clock: Sleep 50, then compare readings.

' WP-22-02: the self-test WRITES ITS PARTIAL RESULTS INTO cst AS IT GOES. If anything raises,
' the handler records the error and still leaves start/end/delta present, so the receipt can
' never claim "no data" while the reason text points at data that was never serialized.

' Per-clock deltas between two RpClockReadAll() dictionaries; a Null reading yields a Null delta.

' The first clock whose read SUCCEEDED (no advance test here - usable for spans over a real wait).

' Bounded pump wait used ONLY when Sleep produced no measurable span: it does not claim time
' passed unless a readable clock actually changed across it.

' Persists a reading set into the diag dictionary WITHOUT letting a raise turn it into a
' silently missing key: the error lands in <key>Error* and the key itself stays present.










Private Function ToolLastError(ByVal args As Object) As String
    ' RE-1 (34a): the add-in's OWN Err at handler entry, captured BEFORE anything
    ' else in this function runs. CROSS-CHECK ONLY: this is the add-in's error
    ' context, not the debuggee's (and this function itself clears/overwrites Err
    ' further down), so it is published as errCrossCheck and is NEVER treated as
    ' authoritative.
    Dim rpXcNum As Long, rpXcDesc As String, rpXcAvail As Boolean
    On Error Resume Next
    rpXcNum = Err.Number
    rpXcDesc = Err.Description
    rpXcAvail = True
    On Error GoTo LE_ERR
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("tool") = "last_error"
    root("ok") = False
    root("stopped_at") = ""
    root("errNumber") = Null
    root("errDescription") = Null
    root("errSource") = Null
    Dim parsed As Object
    Set parsed = CreateObject("Scripting.Dictionary")
    parsed("number") = False
    parsed("description") = False
    parsed("source") = False
    Set root("errParsed") = parsed
    Set root("localsNames") = EmptyJsonArray()
    root("localsNamesSource") = "the identifier names enumerated by the LAST get_locals in this IDE session (source-declaration scan); empty when get_locals was never called"
    root("howToRecover") = "the runtime-error box is MODAL. dismiss:true READS the box first, then clicks DEBUG; when the box has NO Debug caption (that is the shape the IDE EXPRESSION EVALUATOR produces: body = Run-time error NNN, buttons OK + Help only) it clicks OK instead, and dismissedVia says which caption was used. The box End caption is NEVER clicked (End can leave the IDE unstable). When neither caption exists the box is LEFT UNTOUCHED and the answer carries runtimeErrorDialogDismissFailed + runtimeErrorDismiss{buttons,measuredEbMode}. MANUAL RECOVERY for an evaluator box: click OK, then ide_state{release_inflight:true, release_min_held_ms:5000}; if that still fails use the hub ide_kill_and_relaunch (NEVER taskkill)."
    On Error GoTo LE_ERR
    ' R-1021-05: with a runtime-error box up the IDE object model would still read "run",
    ' so the box is probed FIRST (Win32 window enumeration only, no marshaling) and the
    ' state is reported as the REAL state instead of a stale run.
    Dim reProbe As Object
    Set reProbe = McpRe.ReFindRuntimeErrorDialog(Me)
    Dim st As String
    If Not reProbe Is Nothing Then
        st = "runtime_error"
    Else
        st = GetIdeState()
    End If
    root("ideState") = st
    Dim dlgTitle As String
    Dim present As Boolean
    dlgTitle = ""
    present = WinOps.HasVisibleHostDialog(dlgTitle)
    ' R-1021-05: a visible #32770 is not necessarily a runtime-error box, so locate the
    ' box itself first (READ-ONLY scan; nothing is clicked here). A runtime-error box
    ' gets the capture path: READ the body, then (only when dismiss:true) click DEBUG
    ' and measure EbMode. The END caption is never clicked.
    Dim reDlg As Object
    Set reDlg = reProbe
    Dim reRes As Object
    Set reRes = Nothing
    If Not reDlg Is Nothing Then Set reRes = McpRe.ReCaptureRuntimeError(Me, JsonGetBool(args, "dismiss", False))
    Dim blk As Object
    Dim bodySrc As String
    bodySrc = "unavailable"
    ' FIX-4: the H3 dialog view is BEST-EFFORT. Before this boundary any
    ' failure inside it aborted the whole tool (that is how the live box swallowed
    ' the answer into "unexpected_error"). Now the failure is reported as
    ' errorDialogReadError and the rest of the receipt (capture / cache branches)
    ' is still produced. WinOps is NOT changed: only this call site is guarded.
    On Error Resume Next
    Err.Clear
    If present Then
        Set blk = McpBpCore.H3DialogBlock(Me, dlgTitle)
    Else
        Set blk = CreateObject("Scripting.Dictionary")
        blk("present") = False
        blk("title") = ""
        blk("body") = ""
        Set blk("buttons") = EmptyJsonArray()
    End If
    If Err.Number <> 0 Then
        Dim h3ErrNum As Long
        Dim h3ErrDesc As String
        h3ErrNum = Err.Number
        h3ErrDesc = Err.Description
        Err.Clear
        Set blk = CreateObject("Scripting.Dictionary")
        blk("present") = present
        blk("title") = dlgTitle
        blk("body") = ""
        Set blk("buttons") = EmptyJsonArray()
        Dim errRead As Object
        Set errRead = CreateObject("Scripting.Dictionary")
        errRead("number") = h3ErrNum
        errRead("description") = h3ErrDesc
        Set root("errorDialogReadError") = errRead
        root("errorDialogSource") = "unavailable"
        bodySrc = "unavailable"
    End If
    On Error GoTo LE_ERR
    Set root("errorDialog") = blk
    root("stopped_at") = IIf(present, "error_dialog", "no_error_dialog")
    Dim body As String
    body = ""
    ' FIX-4: when the runtime-error box IS recognised, its own body is the
    ' PRIMARY source (ReRuntimeErrorText is measured readable: read_active_dialogs
    ' returns the control texts). The H3 view is only a fallback, and bodySource says
    ' which one was used (runtime_error_probe | h3 | unavailable).
    If Not reDlg Is Nothing Then
        body = McpRe.ReRuntimeErrorText(Me, reDlg)
        If Len(body) > 0 Then bodySrc = "runtime_error_probe"
    End If
    If Len(body) = 0 Then
        If present Then body = CStr(blk("body"))
        If Len(body) > 0 Then bodySrc = "h3"
    End If
    blk("body") = body
    blk("bodySource") = bodySrc
    root("bodyBytes") = Len(body)
    If Len(body) > 0 Then
        Dim numText As String
        numText = McpBpCore.H3ParseErrNumber(Me, body)
        If Len(numText) > 0 Then
            root("errNumber") = CLng(Val(numText))
            parsed("number") = True
        End If
        Dim desc As String
        desc = McpBpCore.H3ParseErrDescription(Me, body)
        If Len(desc) > 0 Then
            root("errDescription") = desc
            parsed("description") = True
        End If
        Dim src As String
        src = McpBpCore.H3ParseErrSource(Me, body)
        If Len(src) > 0 Then
            root("errSource") = src
            parsed("source") = True
        End If
    End If
    ' ---- RE-1 (34a): STRUCTURED ERROR RECORD (read-only, zero engine calls) ----
    ' Field offsets are the ones the G2 runtime probe CONFIRMED across TWO IDE
    ' processes (fix/TASK_RUNTIME_PROBES/evidence/g2_mapping.json: verdict=CONFIRMED,
    ' eventVerdicts=[CONFIRMED,CONFIRMED], desc +0x08 / src +0x04 / num +0x1C).
    ' The read is pure GetModuleHandleW + CopyMemory, so it is legal while the modal
    ' runtime-error box owns the IDE thread (see the callstack note below).
    ' ADDITIVE ONLY: this block writes the err / errBasis / errChannel /
    ' errCrossCheck / errLocation keys and changes NOTHING that the tool already
    ' published - errNumber / errDescription / errSource / errParsed stay
    ' dialog-derived, and a read failure only fills the new keys (it never reaches
    ' LE_ERR, which would rewrite ok/reason/errorMessage).
    Dim recInfo As Object
    Dim errBlk As Object
    Dim chBlk As Object
    Dim selBlk As Object
    Dim flBlk As Object
    Dim xcBlk As Object
    Dim locBlk As Object
    Dim brArr As Object
    Dim brItem As Object
    Dim basisTxt As String
    Set recInfo = Nothing
    On Error Resume Next
    If Len(body) > 0 Then Set recInfo = Vba6Probe.ErrRecordInfo()
    Set errBlk = CreateObject("Scripting.Dictionary")
    errBlk("number") = Null
    errBlk("description") = Null
    errBlk("source") = Null
    errBlk("hresult") = Null
    errBlk("numberBasis") = "unavailable"
    Set selBlk = CreateObject("Scripting.Dictionary")
    selBlk("raw010") = Null
    selBlk("dword074") = Null
    selBlk("bit24") = Null
    selBlk("chosen") = Null
    selBlk("basis") = "unavailable"
    Set flBlk = CreateObject("Scripting.Dictionary")
    flBlk("source") = False
    flBlk("description") = False
    flBlk("number") = False
    Set brArr = New Collection
    Set chBlk = CreateObject("Scripting.Dictionary")
    chBlk("readOk") = False
    chBlk("recordUsed") = Null
    Set chBlk("selector") = selBlk
    Set chBlk("fields") = flBlk
    Set chBlk("bstrReads") = brArr
    chBlk("why") = Null
    basisTxt = "none"
    If Len(body) = 0 Then chBlk("why") = "no_error_dialog"
    If Len(body) > 0 Then basisTxt = "dialog"
    If Not recInfo Is Nothing Then
        If CBool(recInfo("readOk")) Then
            basisTxt = "vb6map"
            errBlk("number") = recInfo("number")
            errBlk("description") = recInfo("description")
            errBlk("source") = recInfo("source")
            errBlk("hresult") = recInfo("hresult")
            errBlk("numberBasis") = CStr(recInfo("numberBasis"))
            flBlk("source") = CBool(recInfo("sourceOk"))
            flBlk("description") = CBool(recInfo("descriptionOk"))
            flBlk("number") = (Not IsNull(recInfo("number")))
        ElseIf CStr(recInfo("why")) = "record_empty" Then
            basisTxt = "none"
        Else
            basisTxt = "unavailable"
        End If
        chBlk("readOk") = CBool(recInfo("readOk"))
        chBlk("recordUsed") = recInfo("recordUsed")
        selBlk("raw010") = recInfo("raw010")
        selBlk("dword074") = recInfo("dword074")
        selBlk("bit24") = recInfo("bit24")
        selBlk("chosen") = recInfo("chosen")
        selBlk("basis") = CStr(recInfo("selectorBasis"))
        chBlk("why") = recInfo("why")
    End If
    Set brItem = CreateObject("Scripting.Dictionary")
    brItem("offset") = "+0x04"
    brItem("ok") = False
    brItem("chars") = 0
    brItem("bytes") = 0
    brItem("error") = Null
    If Not recInfo Is Nothing Then
        brItem("ok") = CBool(recInfo("sourceOk"))
        brItem("chars") = CLng(recInfo("sourceChars"))
        brItem("bytes") = CLng(recInfo("sourceBytes"))
        brItem("error") = recInfo("sourceError")
    End If
    brArr.Add brItem
    Set brItem = CreateObject("Scripting.Dictionary")
    brItem("offset") = "+0x08"
    brItem("ok") = False
    brItem("chars") = 0
    brItem("bytes") = 0
    brItem("error") = Null
    If Not recInfo Is Nothing Then
        brItem("ok") = CBool(recInfo("descriptionOk"))
        brItem("chars") = CLng(recInfo("descriptionChars"))
        brItem("bytes") = CLng(recInfo("descriptionBytes"))
        brItem("error") = recInfo("descriptionError")
    End If
    brArr.Add brItem
    Set xcBlk = CreateObject("Scripting.Dictionary")
    xcBlk("available") = rpXcAvail
    If rpXcAvail Then
        xcBlk("number") = rpXcNum
        xcBlk("description") = rpXcDesc
    Else
        xcBlk("number") = Null
        xcBlk("description") = Null
    End If
    xcBlk("relation") = "addinThreadErrAtHandlerEntry"
    xcBlk("note") = "the add-in's own Err captured at last_error entry; NOT the debuggee's error and never authoritative - compare only"
    Set locBlk = CreateObject("Scripting.Dictionary")
    locBlk("line") = Null
    locBlk("column") = Null
    locBlk("file") = Null
    locBlk("basis") = "not_attempted"
    locBlk("why") = "the VBA6 exception record carries no line/column; resolving a position needs a virtual call inside the engine, which is out of scope for RE-1"
    Set root("err") = errBlk
    root("errBasis") = basisTxt
    Set root("errChannel") = chBlk
    Set root("errCrossCheck") = xcBlk
    Set root("errLocation") = locBlk
    If Len(body) > 0 Then
        If Not m_lastRuntimeError Is Nothing Then
            Set m_lastRuntimeError("err") = errBlk
            m_lastRuntimeError("errBasis") = basisTxt
            Set m_lastRuntimeError("errChannel") = chBlk
            Set m_lastRuntimeError("errCrossCheck") = xcBlk
            Set m_lastRuntimeError("errLocation") = locBlk
        End If
    End If
    Err.Clear
    On Error GoTo LE_ERR
    ' R-1021-05: the debug-engine callstack is a VBA6 call, so it is only read in a
    ' MEASURED break. While the modal runtime-error box owns the IDE thread no
    ' debug-engine call is made on this path at all (the box is read, DEBUG is clicked
    ' and EbMode is measured - nothing else).
    If st = "break" Then
        root("callstack") = Vba6Probe.CallstackJson(32)
        root("position") = ToolCurrentPosition()
        root("positionSource") = "paneSelection"
    Else
        Set root("callstack") = EmptyJsonArray()
        root("callstackUnavailable") = True
        root("callstackUnavailableReason") = "not in break: with the modal runtime-error box up no VBA6 debug-engine call is made on this path (the engine still reports EbMode=1 until DEBUG is clicked; the capture itself measures it and reports runtimeErrorBreakProof)"
        root("position") = Null
        root("positionSource") = "none"
    End If
    Dim names As Object
    Set names = New Collection
    If Not m_lastLocalNames Is Nothing Then
        Dim ni As Long
        For ni = 1 To m_lastLocalNames.Count
            names.Add CStr(m_lastLocalNames(ni))
        Next
    End If
    Set root("localsNames") = names
    ' ---- R-1021-05: live capture / CACHED capture / nothing --------------------
    root("cached") = False
    root("source_") = "live_error_dialog"
    root("ok") = present
    If Not reRes Is Nothing Then
        If CBool(reRes("found")) Then
            ' a RUNTIME-ERROR box: the body above was READ from it before any click
            root("stopped_at") = "error_dialog"
            root("ok") = True
            root("enteredBreak") = CBool(reRes("enteredBreak"))
            root("runEnded") = CBool(reRes("runEnded"))
            Set root("error") = reRes("error")
            Set root("runtimeError") = reRes("error")
            Set root("runtimeErrorBreakProof") = reRes("proof")
            If reRes.Exists("postDebugClick") Then
                If IsObject(reRes("postDebugClick")) Then Set root("postDebugClick") = reRes("postDebugClick")
            End If
            If reRes.Exists("dialogInfo") Then
                If IsObject(reRes("dialogInfo")) Then Set root("runtimeErrorDialog") = reRes("dialogInfo")
            End If
            root("cacheStored") = CBool(reRes("cacheStored"))
            ' RE-1 (34a) A11: a DISMISS that MEASURED the box is a completed observation even
            ' when the break proof is still pending, so the captured block is cached HERE
            ' (the calling side; McpRe.bas keeps its own key set and is not part of this
            ' batch) and the structured block rides on the same cache object.
            If (Not CBool(root("cacheStored"))) And JsonGetBool(args, "dismiss", False) Then
                If m_lastRuntimeError Is Nothing Then
                    If reRes.Exists("error") Then
                        If IsObject(reRes("error")) Then
                            Set m_lastRuntimeError = reRes("error")
                            m_lastRuntimeErrorAt = CStr(m_lastRuntimeError("capturedAt"))
                            Set m_lastRuntimeError("err") = errBlk
                            m_lastRuntimeError("errBasis") = basisTxt
                            Set m_lastRuntimeError("errChannel") = chBlk
                            Set m_lastRuntimeError("errCrossCheck") = xcBlk
                            Set m_lastRuntimeError("errLocation") = locBlk
                            root("cacheStored") = True
                        End If
                    End If
                End If
            End If
            root("readOnly") = (Not JsonGetBool(args, "dismiss", False))
            ' FIX-5: "what did I DO" is measured separately from "what did I SEE". A DEBUG
            ' click that was SENT and made the box disappear is a dismissal EVEN WHEN the
            ' break proof is still pending; a pending proof is never a dismissal failure.
            Dim clickSent As Boolean
            Dim boxGoneNow As Boolean
            Dim pdcLe As Object
            clickSent = False
            boxGoneNow = False
            Set pdcLe = Nothing
            If reRes.Exists("dismissClickSent") Then
                clickSent = CBool(reRes("dismissClickSent"))
            ElseIf reRes.Exists("debugClickSent") Then
                clickSent = CBool(reRes("debugClickSent"))
            End If
            If reRes.Exists("postDebugClick") Then
                If IsObject(reRes("postDebugClick")) Then Set pdcLe = reRes("postDebugClick")
            End If
            If Not pdcLe Is Nothing Then boxGoneNow = CBool(pdcLe("boxGone"))
            If CBool(reRes("ok")) Then
                If reRes.Exists("cachedCapture") Then
                    If IsObject(reRes("cachedCapture")) Then Set root("cachedCapture") = reRes("cachedCapture")
                End If
                If JsonGetBool(args, "dismiss", False) Then
                    root("dismissed") = (clickSent And boxGoneNow)
                    If clickSent Then
                        Dim viaLe As String
                        viaLe = "debug"
                        If reRes.Exists("dismissedVia") Then viaLe = CStr(reRes("dismissedVia"))
                        root("dismissedVia") = viaLe
                        If viaLe = "ok" Then
                            root("dismissButtonHwnd") = JsonGetLong(reRes("error"), "okButtonHwnd", 0)
                        Else
                            root("dismissButtonHwnd") = JsonGetLong(reRes("error"), "debugButtonHwnd", 0)
                        End If
                        ' (39) the SELECTION basis of the clicked button: control id first, caption as the
                        ' fallback. Present ONLY when this dismissal really resolved a button through
                        ' the dialog domain table (McpRe.ReIdFirstButton); a no-dialog / read-only
                        ' path carries neither key, so the frozen lane receipts are unchanged.
                        If reRes.Exists("dismissIdBasis") Then root("dismissIdBasis") = CStr(reRes("dismissIdBasis"))
                        If reRes.Exists("dismissControlId") Then root("dismissControlId") = CLng(reRes("dismissControlId"))
                    End If
                Else
                    root("dismissed") = False
                    root("dismissNote") = "read-only: the body was READ and nothing was clicked (pass dismiss:true to click DEBUG)"
                End If
                If reRes.Exists("breakPending") Then
                    If CBool(reRes("breakPending")) Then
                        root("breakPending") = True
                        root("breakPendingReason") = CStr(reRes("breakPendingReason"))
                        root("howToConfirm") = CStr(reRes("howToConfirm"))
                        If reRes.Exists("howToFinish") Then
                            If IsObject(reRes("howToFinish")) Then Set root("howToFinish") = reRes("howToFinish")
                        End If
                    End If
                End If
                If CBool(root("enteredBreak")) Then
                    root("position") = reRes("position")
                    root("positionSource") = "paneSelection"
                    root("proc") = reRes("proc")
                    root("module") = reRes("module")
                    root("line") = reRes("line")
                End If
            Else
                root("runtimeErrorDialogDismissFailed") = True
                If reRes.Exists("dismiss") Then
                    If IsObject(reRes("dismiss")) Then
                        Set root("runtimeErrorDismiss") = reRes("dismiss")
                        root("dismissError") = CStr(reRes("dismiss")("reason"))
                    End If
                End If
                root("dismissed") = False
                root("ok") = (Not JsonGetBool(args, "dismiss", False))
            End If
        End If
    ElseIf present Then
        ' a visible #32770 whose body carries no Run-time error marker: this tool clicks
        ' NOTHING on it (not End, not Continue) and says so.
        root("runtimeErrorDialog") = False
        ' FIX-5: honesty - a non-runtime #32770 must not look like the runtime-error path.
        root("stopped_at") = "non_runtime_dialog"
        root("dismissUnsupported") = "this box is not a VB6 runtime-error box (its body carries no Run-time error marker); last_error clicks NO caption on it - use read_active_dialogs / send_window_message explicitly if you really want to drive it"
        If JsonGetBool(args, "dismiss", False) Then
            root("dismissed") = False
            root("dismissError") = "not_a_runtime_error_box"
            root("ok") = False
        End If
    ElseIf Not present Then
        ' NO box up: hand back the CACHED capture (the old tool only worked live)
        Dim cachedBlk As Object
        Set cachedBlk = McpRe.ReErrorCacheBlock(Me)
        If Not cachedBlk Is Nothing Then
            root("cached") = True
            root("source_") = "cached_runtime_error"
            root("stopped_at") = "cached_runtime_error"
            root("ok") = True
            root("enteredBreak") = CBool(cachedBlk("stillInBreak"))
            root("errorStillInBreak") = CBool(cachedBlk("stillInBreak"))
            root("cachedAt") = CStr(cachedBlk("capturedAt"))
            root("errNumber") = cachedBlk("number")
            root("errDescription") = cachedBlk("description")
            root("errSource") = cachedBlk("source")
            parsed("number") = (Not IsNull(cachedBlk("number")))
            parsed("description") = (Len(CStr(cachedBlk("description"))) > 0)
            parsed("source") = (Len(CStr(cachedBlk("source"))) > 0)
            Set root("lastError") = cachedBlk
            ' RE-1 (34a): the cached capture carries the structured block, so the
            ' receipt hands back the CAPTURED error facts (not a live re-read).
            If Not m_lastRuntimeError Is Nothing Then
                If m_lastRuntimeError.Exists("err") Then
                    Set cachedBlk("err") = m_lastRuntimeError("err")
                    cachedBlk("errBasis") = CStr(m_lastRuntimeError("errBasis"))
                    Set cachedBlk("errChannel") = m_lastRuntimeError("errChannel")
                    Set cachedBlk("errCrossCheck") = m_lastRuntimeError("errCrossCheck")
                    Set cachedBlk("errLocation") = m_lastRuntimeError("errLocation")
                End If
            End If
            If cachedBlk.Exists("err") Then
                Set root("err") = cachedBlk("err")
                root("errBasis") = CStr(cachedBlk("errBasis"))
                Set root("errChannel") = cachedBlk("errChannel")
                Set root("errCrossCheck") = cachedBlk("errCrossCheck")
                Set root("errLocation") = cachedBlk("errLocation")
            End If
            Set root("error") = cachedBlk
            Set root("runtimeError") = cachedBlk
            Set root("position") = McpRe.ReCachedPositionBlock(Me, cachedBlk)
            root("positionSource") = "cached_capture"
            root("proc") = cachedBlk("proc")
            root("module") = cachedBlk("module")
            root("line") = cachedBlk("line")
            root("bodyBytes") = Len(CStr(cachedBlk("dialogText")))
            root("howToRecover") = "the capture is CACHED: it survives the box and the break, and a NEW run (Start / Start With Full Compile / Restart) or a run that ends normally invalidates it"
        End If
    End If
    root("cacheInvalidatedBy") = m_lastRuntimeErrorInvalidatedBy
    root("cacheInvalidatedAt") = m_lastRuntimeErrorInvalidatedAt
    ToolLastError = JsonStringify(root)
    Exit Function
LE_ERR:
    root("ok") = False
    root("reason") = "unexpected_error"
    root("errorMessage") = Err.Description
    ToolLastError = JsonStringify(root)
End Function




''

' =====================================================================
' R-1021-05: RUNTIME-ERROR CAPTURE -> BREAK. NEVER END.
' The rule (docs/20261021-runtime-error-break.md):
'   1. detect the VB6 runtime-error box (class #32770, owned by THIS process),
'   2. READ the body BEFORE any click (number / description / source),
'   3. click the DEBUG caption (its Chinese twin is matched by code point),
'   4. PROVE the engine really entered break: VBA6 EbMode = 2,
'   5. cache the capture (m_lastRuntimeError) for ide_state.lastError / last_error.
' The END caption is NEVER clicked on this path: End can leave the IDE unstable
' (handles may not be released). The End caption is only SEARCHED FOR, so a receipt
' can report endButtonPresent without ever sending it a message.
' A missing Debug button, or a click that does not produce EbMode = 2, is a
' STRUCTURED FAILURE (runtimeErrorDialogDismissFailed) and the box is left exactly
' as it was - the caller decides what to do next.
' =====================================================================

' Normalized caption: strip the mnemonic ampersand, an accelerator suffix in
' parentheses (half- or full-width) and trailing dots, then upper-case.

' The visible text of ONE dialog: title + every child control caption.

' A RUNTIME-error box says "Run-time error ..." / its Chinese twin. A COMPILE-error
' box does not, so a compile box is never handled by this path.



' READ-ONLY scan for the runtime-error dialog of this process. Nothing is clicked.

' Find one button by caption: the English caption (normalized, exact) or the Chinese
' twin (matched by code point, so the match is culture-independent).


' EVAL SAFETY: a runtime-error box raised by the IDE's EXPRESSION EVALUATOR has NO Debug
' caption - measured live: body "Run-time error '424': Object required", buttons OK + Help
' ONLY. There is no project frame to debug, so OK is the correct and only dismissal there.
' (The ChrW$ codes are the localized OK caption; the SOURCE stays 7-bit ASCII.)



' Run-time error number: the digits after the marker ("Run-time error '13':").

' Run-time error description: the text after the colon on the marker line, else the
' next non-empty line (the box may put both parts into one static control).


' The dialog as a receipt block: present/hwnd/title/buttons[]. Read from the Win32
' enumeration only - the IDE object model is never touched by this path.

' The RAW mode implied by the engine itself (0=design, 1=run, 2=break). Reported as
' stateRaw next to the dialog-driven decision, so a caller can see BOTH readings.

' The MEASURED outcome of the DEBUG click. This block exists so no receipt can claim
' enteredBreak without the measurement behind it - the field is written from this
' block and from nowhere else.


' Steps (2)+(3)+(4)+(5) of the rule for ONE runtime-error dialog.
'   doClick=False: READ ONLY (last_error without dismiss) - nothing is sent.
'   doClick=True : read first, then click DEBUG and PROVE EbMode = 2.

' The CACHED capture in the shape ide_state.lastError / last_error publish. ADDITIVE:
' no tool and no parameter is involved, and the block is ABSENT (Nothing) when no
' capture exists - which is how a stale cache is proven absent after a new run.


' A NEW run starts (Start / Start With Full Compile / Restart) or a run ends normally:
' the previous capture is STALE and must never be handed back by ide_state.lastError /
' last_error. An explicit End AFTER a captured break does NOT call this, so the caller
' can still read the error it was given.

' Merge a capture result into a debug/observe receipt. Three possible stopReasons, all
' derived from the MEASURED post-click EbMode (never assumed):
'   "runtime_error"                       - EbMode = 2: PROVEN break at the error line
'   "runtime_error_run_ended"             - EbMode = 0: the run ENDED instead of breaking
'   "runtime_error_dialog_dismiss_failed" - neither: the box is left untouched
' The END caption of the DIALOG is never clicked on any of the three paths.

' =====================================================================
' R-1021-05: control_execution{end|stop|restart} while a MODAL runtime-error box is up.
' Measured on a live IDE: with the box up nothing ends - ok=false,
' reason="state_not_changed", before=after="run" after ~12 s - and the End command can be
' QUEUED, so it may fire later when the box disappears. This path therefore:
'   1. touches NO CommandBars before the box is gone (Win32 window probe only),
'   2. READS the box, clicks DEBUG (NEVER the box's End caption),
'   3. MEASURES the result: EbMode=2 -> run the IDE's own End command;
'                            EbMode=0 -> the run already ended (already_not_running);
'                            anything else -> structured failure, the box is untouched.
' Receipt: runtimeErrorDialogResolved{how, ebModeAfterClick, elapsedMs}.
' =====================================================================



' =====================================================================
' W-C (P5): source freshness - disk file vs the IDE code pane, per component.
' COMPARISON CONTRACT (published in the receipt):
'   * fresh is decided by the NORMALIZED CODE TEXT comparison (disk file head /
'     Attribute lines stripped) - the same rule DiskMatchesPane uses;
'   * diskSha256 / ideSha256 are published for INFORMATION with hashSpace naming
'     the space each was taken in ("disk" = raw file bytes, "pane" = CodeModule text);
'   * diskFileMtime is INFORMATIONAL ONLY and is never a decision input.
' =====================================================================
Private Function SourceFreshnessJson(ByVal haveIde As Boolean) As Object
    Dim out As Object
    Set out = CreateObject("Scripting.Dictionary")
    Dim comps As Object
    Dim staleNames As Object
    Set comps = New Collection
    Set staleNames = New Collection
    out("applicable") = False
    out("freshnessSource") = "disk"
    out("hashSpaceDisk") = "disk (raw file bytes)"
    out("hashSpaceIde") = "pane (CodeModule text, same space as get_component_code coords=ide)"
    out("decision") = "normalized code-text compare (disk head/Attribute lines stripped) per component"
    out("diskFileMtimeIsInformational") = True
    Set out("components") = comps
    Set out("staleComponents") = staleNames
    out("staleCount") = 0
    out("allFresh") = False
    out("projectFresh") = False
    out("warning") = ""
    If Not haveIde Then
        out("reason") = "no IDE surface for this build: the CLI route compiles DISK, so there is no in-memory pane to compare"
        Set SourceFreshnessJson = out
        Exit Function
    End If
    On Error Resume Next
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    If p Is Nothing Then
        out("reason") = "no open project"
        Set SourceFreshnessJson = out
        Exit Function
    End If
    Dim i As Long
    Dim c As VBIDE.VBComponent
    Dim staleText As String
    staleText = ""
    For i = 1 To p.VBComponents.Count
        Set c = Nothing
        Set c = p.VBComponents.Item(i)
        If Not c Is Nothing Then
            Dim rec As Object
            Set rec = CreateObject("Scripting.Dictionary")
            rec("component") = c.Name
            Dim fn As String
            fn = ""
            fn = c.FileNames(1)
            rec("diskFile") = fn
            Dim diskSha As String
            diskSha = ""
            If Len(fn) > 0 Then
                If Len(Dir$(fn)) > 0 Then diskSha = Build.FileSha256(fn)
            End If
            rec("diskSha256") = diskSha
            Dim mt As String
            mt = ""
            If Len(fn) > 0 Then
                mt = Format$(FileDateTime(fn), "yyyy-mm-dd hh:nn:ss")
            End If
            rec("diskFileMtime") = mt
            Dim paneText As String
            paneText = ""
            Dim lineCount As Long
            lineCount = 0
            Dim cm As VBIDE.CodeModule
            Set cm = Nothing
            Set cm = c.CodeModule
            If Not cm Is Nothing Then
                lineCount = cm.CountOfLines
                If lineCount > 0 Then paneText = cm.Lines(1, lineCount)
            End If
            rec("ideSha256") = Sha256.Sha256HexTextUtf8(paneText)
            rec("paneLineCount") = lineCount
            Dim fresh As Boolean
            fresh = False
            If Len(diskSha) > 0 Then fresh = DiskMatchesPane(c.Name, paneText)
            rec("fresh") = fresh
            comps.Add rec
            If Not fresh Then
                staleNames.Add c.Name
                If Len(staleText) > 0 Then staleText = staleText & ", "
                staleText = staleText & c.Name
            End If
        End If
    Next
    out("applicable") = True
    out("freshnessSource") = "ide"
    out("staleCount") = staleNames.Count
    out("allFresh") = (staleNames.Count = 0)
    out("projectFresh") = (staleNames.Count = 0)
    If staleNames.Count > 0 Then
        out("warning") = "sourceFreshness: " & CStr(staleNames.Count) & " component(s) differ between the IDE code pane and the file on disk: " & staleText & ". route=ide compiles the IDE MEMORY (so those edits ARE compiled); call reload_component when the IDE memory must be replaced by the disk text."
    End If
    Err.Clear
    Set SourceFreshnessJson = out
End Function
' =====================================================================
' W-C: CLSID InprocServer32 guard (32-bit registry view; VB6 runs as a 32-bit process).
' =====================================================================
Private Function WcClsidKeyPath() As String
    WcClsidKeyPath = "HKLM\Software\Classes\CLSID\{4CB64903-3CBA-4AF6-852B-D534862A893D}\InprocServer32\"
End Function

Private Function WcInprocRead() As String
    WcInprocRead = ""
    On Error Resume Next
    Dim sh As Object
    Set sh = CreateObject("WScript.Shell")
    Dim v As String
    v = ""
    v = CStr(sh.RegRead(WcClsidKeyPath()))
    If Err.Number = 0 Then WcInprocRead = v
    Err.Clear
End Function

Private Function WcInprocWrite(ByVal val As String) As Boolean
    WcInprocWrite = False
    On Error Resume Next
    Dim sh As Object
    Set sh = CreateObject("WScript.Shell")
    sh.RegWrite WcClsidKeyPath(), val, "REG_SZ"
    If Err.Number = 0 Then WcInprocWrite = True
    Err.Clear
End Function
' =====================================================================
' W-C (P6): final artifact identity - sampled AFTER post-processing (the LAA
' PE-header patch) and verified by a SECOND read of the same file.
' =====================================================================
Private Function WcVbpRevisionText(ByVal vbpPath As String) As String
    WcVbpRevisionText = ""
    On Error Resume Next
    If Len(vbpPath) = 0 Then Exit Function
    If Len(Dir$(vbpPath)) = 0 Then Exit Function
    Dim fnum As Integer
    Dim ln As String
    fnum = FreeFile
    Open vbpPath For Input As #fnum
    Do While Not EOF(fnum)
        Line Input #fnum, ln
        If InStr(1, ln, "RevisionVer=", vbTextCompare) = 1 Then
            WcVbpRevisionText = Trim$(Mid$(ln, Len("RevisionVer=") + 1))
            Exit Do
        End If
    Loop
    Close #fnum
    Err.Clear
End Function

Private Function WcFinalArtifactJson(ByVal artifactPath As String, ByVal sampleDetail As String, ByVal vbpRevision As String) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("sampledAfterPostProcessing") = True
    d("samplePoint") = "post_laa"
    d("samplePointDetail") = sampleDetail
    d("verifiedOnDisk") = False
    d("sha256") = ""
    d("size") = 0
    d("mtime") = ""
    d("peFlags") = Null
    d("laaFlag") = Null
    d("fileVersion") = ""
    d("revisionVer") = vbpRevision
    d("revisionVerSource") = "disk"
    d("revisionMismatch") = False
    If Len(artifactPath) = 0 Then
        d("reason") = "no artifact path for this project"
        Set WcFinalArtifactJson = d
        Exit Function
    End If
    On Error Resume Next
    If Len(Dir$(artifactPath)) = 0 Then
        d("reason") = "the artifact is not on disk at " & artifactPath
        Set WcFinalArtifactJson = d
        Err.Clear
    Else
        d("path") = artifactPath
        d("sha256") = Build.FileSha256(artifactPath)
        d("size") = FileLen(artifactPath)
        d("mtime") = Format$(FileDateTime(artifactPath), "yyyy-mm-dd hh:nn:ss")
        Dim chars As Long
        Dim charsOff As Long
        Dim peErr As String
        If PeLaaRead(artifactPath, chars, charsOff, peErr) Then
            d("peFlags") = chars
            d("laaFlag") = ((chars And &H20) <> 0)
            d("peFlagsOffset") = charsOff
        Else
            d("peError") = peErr
        End If
        Dim fso As Object
        Set fso = CreateObject("Scripting.FileSystemObject")
        Dim fv As String
        fv = ""
        fv = fso.GetFileVersion(artifactPath)
        If Err.Number = 0 Then d("fileVersion") = fv
        Err.Clear
        Dim sha2 As String
        sha2 = Build.FileSha256(artifactPath)
        d("verifiedOnDisk") = (Len(CStr(d("sha256"))) > 0 And StrComp(sha2, CStr(d("sha256")), vbTextCompare) = 0)
        If Not CBool(d("verifiedOnDisk")) Then d("verifyNote") = "the second read produced " & sha2 & " - the digest is NOT stable, verifiedOnDisk=false"
        Dim ideRev As String
        ideRev = ""
        Dim pp As VBIDE.VBProject
        Set pp = Nothing
        Set pp = GetProject()
        If Not pp Is Nothing Then
            Dim v As Variant
            v = pp.Properties("RevisionVer")
            If Err.Number = 0 Then ideRev = Trim$(CStr(v))
            Err.Clear
        End If
        If Len(ideRev) > 0 Then
            d("revisionVerIde") = ideRev
            d("revisionVerSource") = "ide"
            d("revisionMismatch") = (StrComp(ideRev, vbpRevision, vbTextCompare) <> 0)
        End If
        Err.Clear
    End If
    Set WcFinalArtifactJson = d
End Function
' =====================================================================
' W-C guard: an EMPTY content must never silently truncate an existing file,
' and a VB source file must never be written as 0 bytes at all.
' =====================================================================

Private Function WcIsVbSourcePath(ByVal p As String) As Boolean
    WcIsVbSourcePath = False
    On Error Resume Next
    Dim e As String
    e = LCase$(Mid$(p, InStrRev(p, ".") + 1))
    If e = "bas" Or e = "cls" Or e = "frm" Or e = "ctl" Or e = "pag" Or e = "dsr" Or e = "vbp" Then WcIsVbSourcePath = True
    Err.Clear
End Function

Private Function WcEmptyContentGuard(ByVal pathRaw As String, ByVal content As String, ByVal confirmTruncate As Boolean) As Object
    Set WcEmptyContentGuard = Nothing
    m_wcTruncateAllowed = False
    On Error Resume Next
    If Len(Trim$(content)) > 0 Then Exit Function
    Dim pth As String
    pth = ResolvePath(pathRaw)
    If Len(pth) = 0 Then Exit Function
    Dim isVb As Boolean
    isVb = WcIsVbSourcePath(pth)
    Dim ex As Boolean
    ex = False
    ex = (Len(Dir$(pth)) > 0)
    If Err.Number <> 0 Then
        Err.Clear
        Exit Function
    End If
    Dim sz As Double
    sz = 0
    If ex Then
        sz = FileLen(pth)
        If Err.Number <> 0 Then
            Err.Clear
            Exit Function
        End If
    End If
    ' R-1021-01 (A): an EMPTY VB SOURCE is never a legitimate write, not even when
    ' the target does not exist yet - creating a 0-byte .bas is exactly how the
    ' stray residue was produced (a directory-enumerating collector then reads it
    ' as a real module). The existing-target case keeps its original wording; the
    ' new-target case says so through targetExists:false.
    If isVb Then
        Dim d As Object
        Set d = CreateObject("Scripting.Dictionary")
        d("ok") = False
        d("reason") = "empty_content_would_truncate"
        d("path") = pth
        d("attemptedPath") = pth
        d("targetExists") = ex
        d("existingSize") = sz
        d("vbSourceFile") = True
        d("vbSourceNeverEmpty") = True
        d("confirmTruncateGiven") = confirmTruncate
        d("created") = False
        If ex Then
            d("howToProceed") = "VB source files (.bas/.cls/.frm/.ctl/.pag/.dsr/.vbp) are never written as 0 bytes - an empty VB source cannot compile and this tool refuses even with confirm_truncate:true. Pass the real text, or delete the file explicitly with file_delete if that is genuinely intended."
        Else
            d("howToProceed") = "the target does not exist, but this tool refuses to CREATE a 0-byte VB source: an empty .bas/.cls/.frm/.ctl/.pag/.dsr/.vbp cannot compile and a directory-enumerating collector can mistake it for a real module. Pass the real text; use a non-VB extension if an empty placeholder is genuinely wanted."
        End If
        Set WcEmptyContentGuard = d
        Exit Function
    End If
    ' non-VB: a NEW target with empty content is allowed (it creates a 0-byte file
    ' on purpose and the write receipt proves it: bytes 0 + sha256 of empty).
    If Not ex Then Exit Function
    If sz <= 0 Then Exit Function
    Dim d2 As Object
    Set d2 = CreateObject("Scripting.Dictionary")
    d2("ok") = False
    d2("reason") = "empty_content_would_truncate"
    d2("path") = pth
    d2("attemptedPath") = pth
    d2("targetExists") = True
    d2("existingSize") = sz
    d2("vbSourceFile") = False
    d2("confirmTruncateGiven") = confirmTruncate
    d2("created") = False
    If Not confirmTruncate Then
        d2("howToProceed") = "pass confirm_truncate:true to intentionally empty this non-VB file"
        Set WcEmptyContentGuard = d2
        Exit Function
    End If
    m_wcTruncateAllowed = True
    Set WcEmptyContentGuard = Nothing
    Err.Clear
End Function

Private Function WcTruncateReceipt(ByVal jsonText As String) As String
    WcTruncateReceipt = jsonText
    If Not m_wcTruncateAllowed Then Exit Function
    If Len(jsonText) > 0 Then
        If Left$(jsonText, 1) = "{" Then
        WcTruncateReceipt = "{" & chr(34) & "truncated" & chr(34) & ":true," & chr(34) & "truncatedByConfirm" & chr(34) & ":true," & Mid$(jsonText, 2)
        End If
    End If
End Function

Private Function WcGuardedWriteFile(ByVal args As Object) As String
    Dim g As Object
    Set g = WcEmptyContentGuard(JsonGetStr(args, "path"), JsonGetStr(args, "content"), JsonGetBool(args, "confirm_truncate", False))
    If Not g Is Nothing Then
        WcGuardedWriteFile = JsonStringify(g)
        Exit Function
    End If
    WcGuardedWriteFile = WcTruncateReceipt(ToolWriteFile(JsonGetStr(args, "path"), JsonGetStr(args, "content"), JsonGetStr(args, "encoding", "auto"), JsonGetBool(args, "create_dirs", True), JsonGetBool(args, "backup", True), JsonGetStr(args, "validate")))
End Function

Private Function WcGuardedWriteSource(ByVal args As Object) As String
    Dim g As Object
    Set g = WcEmptyContentGuard(JsonGetStr(args, "path"), JsonGetStr(args, "text"), JsonGetBool(args, "confirm_truncate", False))
    If Not g Is Nothing Then
        WcGuardedWriteSource = JsonStringify(g)
        Exit Function
    End If
    WcGuardedWriteSource = WcTruncateReceipt(ToolWriteSource(JsonGetStr(args, "path"), JsonGetStr(args, "text"), JsonGetStr(args, "encoding"), JsonGetStr(args, "validate")))
End Function
' =====================================================================
' W-D (P11): one place for the "artifactChanged is false, so how do I get a
' compiler log?" answer. Called from BOTH make_project's false branch and the
' build tool's cache-hit / unchanged branches, so the wording cannot drift.
' =====================================================================
Private Sub WcAttachCompileLogHint(ByRef root As Object)
    On Error Resume Next
    If root Is Nothing Then Exit Sub
    If root.Exists("compileLogHint") Then Exit Sub
    root("compileLogHint") = "artifactChanged is false: nothing was compiled by this call. This is NOT a failure. The in-IDE Make route produces NO compiler log; for a real log re-run with diagnose:true (isolated compile of a COPY, returns log + firstError) or use route:""cli"" / the build tool."
    root("diagnoseRecommended") = True
    root("compileLogHintSemantics") = "artifactChanged:false means the artifact bytes did not change - it is neither a pass nor a failure by itself; read verdict/buildState for that."
    Err.Clear
End Sub
' =====================================================================
' W-E (P8): atomic .vbp component line maintenance for add_component /
' remove_component. ONLY the target component line changes; Reference= lines
' and the relative order of every other component line are preserved.
' Write strategy: TEMP FILE + REPLACE with a .bak backup; any failure puts the
' original bytes back and reports rolledBack=true.
' =====================================================================
Private Function WcAddComponentVbp(ByVal args As Object) As String
    Dim fpathSafe As String
    fpathSafe = ""
    Dim fileCreatedOk As Boolean
    fileCreatedOk = False
    On Error GoTo eh
    ' WHICH STEP is running when a failure happens. It is reported as failedAt and it
    ' decides the reason: a component-creation failure is NOT a .vbp failure.
    Dim stage As String
    stage = "create_component"
    Dim res As String
    res = ToolAddComponent(JsonGetStr(args, "type"), JsonGetStr(args, "name"), JsonGetStr(args, "code"))
    ' FIX-11: the IDE's "Add Form" dialog is inherently interactive (it asks which template).
    ' The guard presses CANCEL (IDCANCEL=2); report that as a structured refusal instead of
    ' letting the call look like a timeout or a half-created form.
    If WinOps.WoModalGuardCancelClicked() Then
        WcAddComponentVbp = "{" & WcJS("ok") & ":false," & WcJS("reason") & ":" & WcJS("cancelled_by_policy") & "," & WcJS("cancelledBy") & ":" & WcJS("modal_guard") & "," & WcJS("advice") & ":" & WcJS("creating a VB6 form through the IDE's Add Form command is inherently interactive (template selection); the guard pressed Cancel. Use non-interactive alternatives: add_component{type:""module""} or import_component of a prepared .frm") & "}"
        Exit Function
    End If
    WcAddComponentVbp = res
    Dim nm As String
    nm = JsonGetStr(args, "name")
    If Len(res) = 0 Then Exit Function
    If Left$(res, 1) <> "{" Then Exit Function
    If InStr(1, res, "error", vbTextCompare) > 0 Then Exit Function
    Dim kind As String
    kind = JsonGetStr(args, "type")
    Dim lk As String
    lk = LCase$(kind)
    ' FIXED receipt contract of this tool: EVERY success receipt answers the component name
    ' (root "component", added by ToolAddComponent), the member FILE path (filePath /
    ' componentFile) and fileSizeAfterWrite. The name-empty path and the designer path used
    ' to return early WITHOUT those three fields; they are filled in here (and the helper is
    ' the ONE place that builds them) so a caller never has to special-case which
    ' add_component shape came back.
    Dim comp As VBIDE.VBComponent
    Set comp = Nothing
    If Len(nm) = 0 Then
        On Error Resume Next
        Set comp = GetProject().VBComponents.Item(GetProject().VBComponents.Count)
        Err.Clear
        On Error GoTo 0
        If Not comp Is Nothing Then nm = comp.Name
        WcAddComponentVbp = "{" & WcAddComponentFileFacts(WcComponentMemberPath(comp, nm, kind)) & Mid$(res, 2)
        Exit Function
    End If
    If lk = "form" Or lk = "mdiform" Or lk = "usercontrol" Then
        Dim rj As String
        rj = "{" & WcJS("pairedBinaryUnsupported") & ":true,"
        rj = rj & WcJS("pairedBinaryReason") & ":" & WcJS("type " & kind & " needs a paired binary that this atomic path does not manage; nothing was changed") & ","
        rj = rj & WcJS("howToProceed") & ":" & WcJS("call add_component directly for designer components") & ","
        WcAddComponentVbp = rj & WcAddComponentFileFacts(WcComponentMemberPath(Nothing, nm, kind)) & Mid$(res, 2)
        Exit Function
    End If
    Dim ci As Long
    For ci = 1 To GetProject().VBComponents.Count
        If StrComp(GetProject().VBComponents.Item(ci).Name, nm, vbTextCompare) = 0 Then
            Set comp = GetProject().VBComponents.Item(ci)
            Exit For
        End If
    Next
    If comp Is Nothing Then
        Set comp = GetProject().VBComponents.Item(GetProject().VBComponents.Count)
        On Error Resume Next
        comp.Name = nm
        Err.Clear
        On Error GoTo 0
    End If
    Dim foundName As String
    foundName = ""
    If Not comp Is Nothing Then foundName = comp.Name
    ' ---- UNSAVED PROJECT: skip the file write and the .vbp sync ------------------
    ' VBProject.FileName is EMPTY for a project that has never been saved, which is the
    ' normal state right after add_project. Two things then cannot work:
    '   * the component FILE path is derived from the project directory, so it becomes a
    '     RELATIVE name ("Mod1.bas"): the write lands in the process working directory -
    '     a stray file in an unrelated place - or raises;
    '   * there is no .vbp on disk to sync (WcVbpAtomicSync already skips for this reason).
    ' Both steps are SKIPPED, not attempted-and-retried. The component itself already
    ' exists in the IDE; save_project materialises the .vbp and every component file.
    stage = "component_file"
    If Len(GetProject().FileName) = 0 Then
        Dim skipExtra As String
        skipExtra = WcJS("fileSyncSkipped") & ":" & WcJS("unsaved_project") & ","
        skipExtra = skipExtra & WcJS("fileSyncSkippedDetail") & ":" & WcJS("VBProject.FileName is empty, so the project has no directory yet: a component file path would be RELATIVE and the .vbp does not exist to be synced. Nothing was written to disk.") & ","
        skipExtra = skipExtra & WcAddComponentFileFacts("")
        skipExtra = skipExtra & WcJS("vbpChanged") & ":false,"
        skipExtra = skipExtra & WcJS("vbpSha256Before") & ":" & WcJS("") & ","
        skipExtra = skipExtra & WcJS("vbpSha256After") & ":" & WcJS("") & ","
        skipExtra = skipExtra & WcJS("vbpWritePasses") & ":0,"
        skipExtra = skipExtra & WcJS("rolledBack") & ":false,"
        skipExtra = skipExtra & WcJS("vbpNote") & ":" & WcJS("no .vbp on disk yet (unsaved project); nothing to sync") & ","
        skipExtra = skipExtra & WcJS("matOk") & ":false,"
        skipExtra = skipExtra & WcJS("foundName") & ":" & WcJS(foundName) & ","
        skipExtra = skipExtra & WcJS("writeErr") & ":" & WcJS("") & ","
        skipExtra = skipExtra & WcJS("dirExists") & ":false,"
        skipExtra = skipExtra & WcJS("rollbackFileRemoved") & ":false,"
        skipExtra = skipExtra & WcJS("howToProceed") & ":" & WcJS("the component exists in the IDE; call save_project (it writes the .vbp and every component file), after which file paths are real") & ","
        WcAddComponentVbp = "{" & skipExtra & Mid$(res, 2)
        Exit Function
    End If
    Dim pdir As String
    pdir = Left$(GetProject().FileName, InStrRev(GetProject().FileName, Chr$(92)))
    Dim fpath As String
    fpath = pdir & nm & WcCompExt(kind)
    Dim writeErr As String
    Dim matOk As Boolean
    matOk = WcWriteComponentFile(comp, fpath, writeErr)
    stage = "vbp_sync"
    Dim d As Object
    Set d = WcVbpAtomicSync(nm, kind, True)
    WcAddComponentVbp = WcSpliceVbpFields(res, d)
    Dim rollbackFileRemoved As Boolean
    rollbackFileRemoved = False
    If CBool(d("rolledBack")) Then
        If Len(Dir$(fpath)) > 0 Then
            On Error Resume Next
            Kill fpath
            Err.Clear
            On Error GoTo 0
            If Len(Dir$(fpath)) = 0 Then rollbackFileRemoved = True
        End If
    End If
    fileCreatedOk = (Len(Dir$(fpath)) > 0)
    fpathSafe = fpath
    Dim extra As String
    extra = ""
    extra = extra & WcJS("matOk") & ":" & WcJB(matOk) & ","
    extra = extra & WcJS("foundName") & ":" & WcJS(foundName) & ","
    extra = extra & WcAddComponentFileFacts(fpath)
    extra = extra & WcJS("writeErr") & ":" & WcJS(writeErr) & ","
    Dim dirOk As String
    dirOk = "false"
    If Len(Dir$(pdir, vbDirectory)) > 0 Then dirOk = "true"
    extra = extra & WcJS("dirExists") & ":" & dirOk & ","
    extra = extra & WcJS("vbpTrailingEolPolicy") & ":" & WcJS("exactly_one_crlf") & ","
    extra = extra & WcJS("rollbackFileRemoved") & ":" & WcJB(rollbackFileRemoved) & ","
    WcAddComponentVbp = "{" & extra & Mid$(WcAddComponentVbp, 2)
    Exit Function
eh:
    ' capture the error BEFORE anything clears it: the previous version called Err.Clear
    ' first and then reported Err.Number/Err.Description, so vbError was ALWAYS "0:" and
    ' the real cause was destroyed - which is exactly why this failure could not be
    ' diagnosed from the receipt. Errors are reported here, never swallowed.
    Dim errNum As Long
    Dim errDesc As String
    errNum = Err.Number
    errDesc = Err.Description
    Dim rbRemoved As Boolean
    rbRemoved = False
    On Error Resume Next
    If fileCreatedOk Then
        If Len(fpathSafe) > 0 Then
            If Len(Dir$(fpathSafe)) > 0 Then Kill fpathSafe
            If Len(Dir$(fpathSafe)) = 0 Then rbRemoved = True
        End If
    End If
    Err.Clear
    On Error GoTo 0
    Dim bad As String
    bad = "{" & WcJS("ok") & ":false,"
    bad = bad & WcJS("reason") & ":" & WcJS(IIf(stage = "create_component", "add_component_failed", "add_component_vbp_failed")) & ","
    bad = bad & WcJS("failedAt") & ":" & WcJS(stage) & ","
    bad = bad & WcJS("vbError") & ":" & WcJS(CStr(errNum) & ":" & errDesc) & ","
    bad = bad & WcJS("rolledBack") & ":true,"
    bad = bad & WcJS("vbpChanged") & ":false,"
    bad = bad & WcJS("rollbackFileRemoved") & ":" & WcJB(rbRemoved) & ","
    bad = bad & WcJS("howToRecover") & ":" & WcJS("the .vbp was NOT modified; remove the partially added component with remove_component and retry after fixing the write permission on the project directory") & "}"
    WcAddComponentVbp = bad
End Function

Private Function WcRemoveComponentVbp(ByVal args As Object) As String
    Dim nm As String
    nm = JsonGetStr(args, "name")
    Dim res As String
    res = ToolRemoveComponent(nm)
    WcRemoveComponentVbp = res
    If Len(nm) = 0 Then Exit Function
    If Len(res) = 0 Then Exit Function
    If Left$(res, 1) <> "{" Then Exit Function
    Dim d As Object
    Set d = WcVbpAtomicSync(nm, "", False)
    WcRemoveComponentVbp = WcSpliceVbpFields(res, d)
End Function

Private Function WcSpliceVbpFields(ByVal jsonText As String, ByVal d As Object) As String
    Dim frag As String
    frag = WcJS("vbpChanged") & ":" & WcJB(CBool(d("vbpChanged"))) & ","
    frag = frag & WcJS("vbpSha256Before") & ":" & WcJS(CStr(d("vbpSha256Before"))) & ","
    frag = frag & WcJS("vbpSha256After") & ":" & WcJS(CStr(d("vbpSha256After"))) & ","
    frag = frag & WcJS("vbpBackupPath") & ":" & WcJS(CStr(d("vbpBackupPath"))) & ","
    frag = frag & WcJS("vbpWritePasses") & ":" & CStr(CLng(d("vbpWritePasses"))) & ","
    frag = frag & WcJS("rolledBack") & ":" & WcJB(CBool(d("rolledBack"))) & ","
    frag = frag & WcJS("vbpOrderPolicy") & ":" & WcJS(CStr(d("vbpOrderPolicy"))) & ","
    frag = frag & WcJS("addedVbpLine") & ":" & WcJS(CStr(d("addedVbpLine"))) & ","
    frag = frag & WcJS("removedVbpLines") & ":" & CStr(d("removedVbpLinesJson")) & ","
    If Len(CStr(d("vbpNote"))) > 0 Then frag = frag & WcJS("vbpNote") & ":" & WcJS(CStr(d("vbpNote"))) & ","
    If Len(CStr(d("vbpReason"))) > 0 Then frag = frag & WcJS("vbpReason") & ":" & WcJS(CStr(d("vbpReason"))) & ","
    WcSpliceVbpFields = "{" & frag & Mid$(jsonText, 2)
End Function

Private Function WcJB(ByVal v As Boolean) As String
    WcJB = "false"
    If v Then WcJB = "true"
End Function

Private Function WcJS(ByVal v As String) As String
    Dim t As String
    t = Replace(v, Chr$(92), Chr$(92) & Chr$(92))
    t = Replace(t, Chr$(34), Chr$(92) & Chr$(34))
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    WcJS = Chr$(34) & t & Chr$(34)
End Function

Private Function WcCompExt(ByVal kind As String) As String
    Dim k As String
    k = LCase$(kind)
    WcCompExt = ".bas"
    If k = "class" Then WcCompExt = ".cls"
    If k = "form" Then WcCompExt = ".frm"
    If k = "mdiform" Then WcCompExt = ".frm"
    If k = "usercontrol" Then WcCompExt = ".ctl"
    If k = "proppage" Then WcCompExt = ".pag"
    If k = "userdoc" Then WcCompExt = ".dob"
    If k = "designer" Then WcCompExt = ".dsr"
    If k = "resource" Then WcCompExt = ".res"
End Function

Private Function WcCompToken(ByVal kind As String) As String
    Dim k As String
    k = LCase$(kind)
    WcCompToken = "Module"
    If k = "class" Then WcCompToken = "Class"
    If k = "form" Then WcCompToken = "Form"
    If k = "mdiform" Then WcCompToken = "MDIForm"
    If k = "usercontrol" Then WcCompToken = "UserControl"
    If k = "proppage" Then WcCompToken = "PropertyPage"
    If k = "userdoc" Then WcCompToken = "UserDocument"
    If k = "designer" Then WcCompToken = "Designer"
    If k = "resource" Then WcCompToken = "ResFile"
End Function

Private Function WcVbpCompName(ByVal ln As String) As String
    WcVbpCompName = ""
    Dim t As String
    t = Trim$(ln)
    Dim eq As Long
    eq = InStr(1, t, "=")
    If eq <= 1 Then Exit Function
    Dim key As String
    key = LCase$(Left$(t, eq - 1))
    If key <> "module" And key <> "class" And key <> "form" And key <> "mdiform" And key <> "usercontrol" And key <> "propertypage" And key <> "userdocument" And key <> "designer" And key <> "resfile" Then Exit Function
    Dim rest As String
    rest = Mid$(t, eq + 1)
    Dim semi As Long
    semi = InStr(1, rest, ";")
    If semi > 0 Then rest = Left$(rest, semi - 1)
    WcVbpCompName = Trim$(rest)
End Function

Private Function WcVbpAtomicSync(ByVal compName As String, ByVal compKind As String, ByVal isAdd As Boolean) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("vbpChanged") = False
    d("vbpSha256Before") = ""
    d("vbpSha256After") = ""
    d("vbpBackupPath") = ""
    d("vbpWritePasses") = 0
    d("rolledBack") = False
    d("vbpOrderPolicy") = "vb6_section"
    d("addedVbpLine") = ""
    d("removedVbpLinesJson") = "[]"
    d("vbpNote") = ""
    d("vbpReason") = ""
    On Error Resume Next
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    Dim vbp As String
    vbp = ""
    vbp = p.FileName
    If Len(vbp) = 0 Then
        d("vbpReason") = "the project has no file name (unsaved); .vbp was not touched"
        Set WcVbpAtomicSync = d
        Exit Function
    End If
    If Len(Dir$(vbp)) = 0 Then
        d("vbpReason") = "the .vbp is not on disk: " & vbp
        Set WcVbpAtomicSync = d
        Exit Function
    End If
    If Err.Number <> 0 Then
        Err.Clear
        d("vbpReason") = "the .vbp path could not be read from the IDE"
        Set WcVbpAtomicSync = d
        Exit Function
    End If
    d("vbpSha256Before") = Build.FileSha256(vbp)
    Dim text As String
    Dim encUsed As String
    Dim whyRead As String
    text = ""
    If Not Build.ReadSourceText(vbp, text, encUsed, whyRead) Then
        d("vbpReason") = "the .vbp could not be read as text: " & whyRead
        Set WcVbpAtomicSync = d
        Exit Function
    End If
    Dim norm As String
    norm = Replace(Replace(text, vbCrLf, vbLf), vbCr, vbLf)
    Dim lines() As String
    lines = Split(norm, vbLf)
    Dim n As Long
    n = UBound(lines)
    Dim i As Long
    Dim lastComp As Long
    Dim found As Long
    lastComp = -1
    found = -1
    For i = 0 To n
        If Len(WcVbpCompName(lines(i))) > 0 Then
            lastComp = i
            If StrComp(WcVbpCompName(lines(i)), compName, vbTextCompare) = 0 Then found = i
        End If
    Next
    Dim cnt As Long
    Dim newLine As String
    If isAdd Then
        If found >= 0 Then
            d("vbpNote") = "the component line already exists; .vbp was NOT touched"
            Set WcVbpAtomicSync = d
            Exit Function
        End If
        newLine = WcCompToken(compKind) & "=" & compName & "; " & compName & WcCompExt(compKind)
        Dim outLines() As String
        ReDim outLines(0 To n + 1)
        If lastComp < 0 Then lastComp = 0
        cnt = 0
        For i = 0 To n
            outLines(cnt) = lines(i)
            cnt = cnt + 1
            If i = lastComp Then
                outLines(cnt) = newLine
                cnt = cnt + 1
            End If
        Next
        lines = outLines
        n = cnt - 1
        d("addedVbpLine") = newLine
    Else
        If found < 0 Then
            d("vbpNote") = "no .vbp component line matches this name; nothing to remove"
            Set WcVbpAtomicSync = d
            Exit Function
        End If
        Dim remJson As String
        remJson = ""
        cnt = 0
        For i = 0 To n
            If StrComp(WcVbpCompName(lines(i)), compName, vbTextCompare) = 0 Then
                If Len(remJson) > 0 Then remJson = remJson & ","
                remJson = remJson & WcJS(lines(i))
                cnt = cnt + 1
            End If
        Next
        d("removedVbpLinesJson") = "[" & remJson & "]"
        Dim kept() As String
        ReDim kept(0 To n - cnt)
        Dim m As Long
        m = 0
        For i = 0 To n
            If StrComp(WcVbpCompName(lines(i)), compName, vbTextCompare) <> 0 Then
                kept(m) = lines(i)
                m = m + 1
            End If
        Next
        lines = kept
        n = m - 1
    End If
    Dim newText As String
    newText = Join(lines, vbCrLf)
    ' only re-add the final EOL when the split did NOT already leave an empty tail element
    If Right$(text, 2) = vbCrLf Then
        If n < 0 Then
            newText = newText & vbCrLf
        ElseIf Len(lines(n)) > 0 Then
            newText = newText & vbCrLf
        End If
    End If
    Dim tmp As String
    Dim bak As String
    tmp = vbp & ".wc_tmp"
    bak = vbp & ".wc_bak"
    d("vbpBackupPath") = bak
    Err.Clear
    WcWriteTextFile tmp, newText
    If Err.Number <> 0 Then
        d("vbpReason") = "could not write the temp .vbp: " & Err.Description
        Err.Clear
        Set WcVbpAtomicSync = d
        Exit Function
    End If
    If Len(Dir$(bak)) > 0 Then Kill bak
    FileCopy vbp, bak
    If Err.Number <> 0 Then
        d("vbpReason") = "could not back up the .vbp: " & Err.Description
        d("rolledBack") = True
        Err.Clear
        If Len(Dir$(tmp)) > 0 Then Kill tmp
        Set WcVbpAtomicSync = d
        Exit Function
    End If
    Dim oldName As String
    oldName = vbp & ".wc_old"
    If Len(Dir$(oldName)) > 0 Then Kill oldName
    Name vbp As oldName
    If Err.Number <> 0 Then
        d("vbpReason") = "could not move the original .vbp aside: " & Err.Description
        Err.Clear
        WcRestoreVbp vbp, bak, tmp
        d("rolledBack") = True
        Set WcVbpAtomicSync = d
        Exit Function
    End If
    Name tmp As vbp
    If Err.Number <> 0 Then
        d("vbpReason") = "could not put the new .vbp in place: " & Err.Description
        Err.Clear
        WcRestoreVbp vbp, bak, tmp
        d("rolledBack") = True
        Set WcVbpAtomicSync = d
        Exit Function
    End If
    If Len(Dir$(oldName)) > 0 Then Kill oldName
    d("vbpWritePasses") = 1
    d("vbpChanged") = True
    d("vbpSha256After") = Build.FileSha256(vbp)
    Dim back As String
    Dim enc2 As String
    Dim why2 As String
    back = ""
    If Build.ReadSourceText(vbp, back, enc2, why2) Then
        If back <> newText Then
            d("vbpReason") = "READ-BACK MISMATCH: restoring the original .vbp"
            WcRestoreVbp vbp, bak, ""
            d("vbpChanged") = False
            d("rolledBack") = True
            d("vbpSha256After") = Build.FileSha256(vbp)
        End If
    End If
    Err.Clear
    Set WcVbpAtomicSync = d
End Function

Private Sub WcWriteTextFile(ByVal path As String, ByVal text As String)
    Dim b() As Byte
    b = StrConv(text, vbFromUnicode)
    Dim f As Integer
    f = FreeFile
    Open path For Binary As #f
    Put #f, , b
    Close #f
End Sub

Private Sub WcRestoreVbp(ByVal vbp As String, ByVal bak As String, ByVal tmp As String)
    On Error Resume Next
    If Len(tmp) > 0 Then
        If Len(Dir$(tmp)) > 0 Then Kill tmp
    End If
    If Len(Dir$(bak)) > 0 Then
        If Len(Dir$(vbp)) > 0 Then Kill vbp
        FileCopy bak, vbp
    End If
    Err.Clear
End Sub

Private Sub WcNoopProbe()
End Sub

Private Function WcWriteComponentFile(ByVal comp As Object, ByVal fpath As String, ByRef writeErr As String) As Boolean
    WcWriteComponentFile = False
    writeErr = ""
    On Error GoTo eh
    If comp Is Nothing Then
        writeErr = "no component object"
        Exit Function
    End If
    Dim cl As Long
    Dim txt As String
    cl = 0
    txt = ""
    If Not comp.CodeModule Is Nothing Then
        cl = comp.CodeModule.CountOfLines
        If cl > 0 Then txt = comp.CodeModule.Lines(1, cl)
    End If
    Dim body As String
    body = "Attribute VB_Name = " & Chr$(34) & comp.Name & Chr$(34) & vbCrLf & txt & vbCrLf
    WcWriteTextFile fpath, body
    If Len(Dir$(fpath)) > 0 Then WcWriteComponentFile = True
    Exit Function
eh:
    writeErr = CStr(Err.Number) & ":" & Err.Description
End Function

Private Function WcFileSize(ByVal path As String) As Long
    WcFileSize = 0
    On Error Resume Next
    If Len(Dir$(path)) > 0 Then WcFileSize = FileLen(path)
    Err.Clear
End Function
' =====================================================================
' W-F (P3): transactional procedure move/delete. Panes are captured first;
' ANY failure restores BOTH sides. .vbp is never touched.
' =====================================================================
Private Function WfPaneLines(ByVal compName As String) As String()
    Dim t As String
    t = SafeCompText(compName)
    WfPaneLines = Split(Replace(Replace(t, vbCrLf, vbLf), vbCr, vbLf), vbLf)
End Function

Private Function WfProcSpan(ByVal compName As String, ByVal proc As String, ByRef sLine As Long, ByRef eLine As Long) As Boolean
    WfProcSpan = False
    sLine = 0
    eLine = 0
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, compName)
    If comp Is Nothing Then Exit Function
    If comp.CodeModule Is Nothing Then Exit Function
    WfProcSpan = McpCls.ProcRangeOf(Me, comp.CodeModule, proc, sLine, eLine)
End Function

Private Function WfNorm(ByVal t As String) As String
    Dim s As String
    s = Replace(t, vbCrLf, vbLf)
    s = Replace(s, vbCr, vbLf)
    Do While Len(s) > 0
        If Right$(s, 1) = Chr$(10) Or Right$(s, 1) = Chr$(32) Then
            s = Left$(s, Len(s) - 1)
        Else
            Exit Do
        End If
    Loop
    WfNorm = s
End Function

Private Function WfSetPane(ByVal compName As String, ByVal text As String) As Boolean
    WfSetPane = False
    On Error Resume Next
    Dim r As String
    r = ToolReplaceCode(compName, "set", 0, 0, text, "", "off", True)
    If Err.Number <> 0 Then
        Err.Clear
        Exit Function
    End If
    ' CodeModule may normalise the trailing newline, so compare the NORMALISED text
    If WfNorm(CompText(compName)) = WfNorm(text) Then WfSetPane = True
End Function

Private Function WfSha(ByVal t As String) As String
    WfSha = Sha256HexTextUtf8(t)
End Function

Private Function WfJoinRange(ByRef lines() As String, ByVal sLine As Long, ByVal eLine As Long) As String
    Dim i As Long
    Dim out As String
    out = ""
    For i = sLine - 1 To eLine - 1
        If i > sLine - 1 Then out = out & vbCrLf
        out = out & lines(i)
    Next
    WfJoinRange = out
End Function

Private Function WfRemoveRange(ByRef lines() As String, ByVal sLine As Long, ByVal eLine As Long) As String
    Dim out As String
    Dim i As Long
    Dim n As Long
    n = UBound(lines)
    out = ""
    For i = 0 To n
        If i < sLine - 1 Or i > eLine - 1 Then
            If Len(out) > 0 Then out = out & vbCrLf
            out = out & lines(i)
        End If
    Next
    WfRemoveRange = out
End Function

Private Function WfRemoveRanges(ByRef lines() As String, ByRef starts() As Long, ByRef ends() As Long, ByVal cnt As Long) As String
    Dim keep() As Boolean
    Dim i As Long
    Dim n As Long
    n = UBound(lines)
    ReDim keep(0 To n)
    For i = 0 To n
        keep(i) = True
    Next
    Dim k As Long
    For k = 0 To cnt - 1
        For i = starts(k) - 1 To ends(k) - 1
            If i >= 0 And i <= n Then keep(i) = False
        Next
    Next
    Dim out As String
    out = ""
    For i = 0 To n
        If keep(i) Then
            If Len(out) > 0 Then out = out & vbCrLf
            out = out & lines(i)
        End If
    Next
    WfRemoveRanges = out
End Function

Private Function ToolMoveProcedure(ByVal fromComp As String, ByVal proc As String, ByVal toComp As String, ByVal anchor As String) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("tool") = "move_procedure"
    root("ok") = False
    root("rolledBack") = False
    root("restoreVerified") = False
    root("vbpTouched") = False
    root("encoding") = "pane-text"
    root("bom") = "n/a (pane text, no file write)"
    Dim snaps As Object
    Set snaps = New Collection
    On Error GoTo eh
    Dim srcBefore As String
    Dim tgtBefore As String
    srcBefore = SafeCompText(fromComp)
    tgtBefore = SafeCompText(toComp)
    root("sourceSha256Before") = WfSha(srcBefore)
    root("targetSha256Before") = WfSha(tgtBefore)
    Dim sLine As Long
    Dim eLine As Long
    If Not WfProcSpan(fromComp, proc, sLine, eLine) Then
        root("reason") = "proc_not_found"
        ToolMoveProcedure = JsonStringify(root)
        Exit Function
    End If
    Dim srcLines() As String
    srcLines = WfPaneLines(fromComp)
    If eLine > UBound(srcLines) + 1 Then
        root("reason") = "proc_range_out_of_bounds"
        ToolMoveProcedure = JsonStringify(root)
        Exit Function
    End If
    Dim block As String
    block = WfJoinRange(srcLines, sLine, eLine)
    Dim tgtLines() As String
    tgtLines = WfPaneLines(toComp)
    Dim tn As Long
    tn = UBound(tgtLines)
    Dim atLine As Long
    atLine = tn + 1
    If Len(Trim$(anchor)) > 0 Then
        atLine = -1
        Dim ai As Long
        For ai = 0 To tn
            If Trim$(tgtLines(ai)) = Trim$(anchor) Then
                atLine = ai + 1
                Exit For
            End If
        Next
        If atLine < 0 Then
            root("reason") = "insert_anchor_not_found"
            ToolMoveProcedure = JsonStringify(root)
            Exit Function
        End If
    End If
    Dim outTgt As String
    outTgt = WfInsertBlock(tgtLines, atLine, block)
    UndoSnapshot fromComp, srcBefore
    UndoSnapshot toComp, tgtBefore
    snaps.Add "undo_snapshot:" & fromComp
    snaps.Add "undo_snapshot:" & toComp
    Set root("snapshots") = snaps
    If Not WfSetPane(toComp, outTgt) Then
        root("reason") = "target_insert_failed"
        If WfSetPane(toComp, tgtBefore) Then root("restoreVerified") = True
        root("rolledBack") = True
        ToolMoveProcedure = JsonStringify(root)
        Exit Function
    End If
    Dim outSrc As String
    outSrc = WfRemoveRange(srcLines, sLine, eLine)
    If Not WfSetPane(fromComp, outSrc) Then
        root("reason") = "source_delete_failed"
        Dim okA As Boolean
        okA = True
        If Not WfSetPane(fromComp, srcBefore) Then okA = False
        If Not WfSetPane(toComp, tgtBefore) Then okA = False
        root("restoreVerified") = okA
        root("rolledBack") = True
        ToolMoveProcedure = JsonStringify(root)
        Exit Function
    End If
    Dim moved As Object
    Set moved = CreateObject("Scripting.Dictionary")
    moved("from") = fromComp
    moved("to") = toComp
    moved("proc") = proc
    moved("lineCount") = eLine - sLine + 1
    moved("insertAfterLine") = atLine
    Set root("moved") = moved
    root("sourceSha256After") = WfSha(SafeCompText(fromComp))
    root("targetSha256After") = WfSha(SafeCompText(toComp))
    root("roundtrip_ok") = (Len(CompText(toComp)) > 0)
    root("ok") = True
    ToolMoveProcedure = JsonStringify(root)
    Exit Function
eh:
    root("reason") = "unexpected_error"
    root("errorMessage") = CStr(Err.Number) & ":" & Err.Description
    On Error Resume Next
    Err.Clear
    ToolMoveProcedure = JsonStringify(root)
End Function

Private Function WfInsertBlock(ByRef lines() As String, ByVal atLine As Long, ByVal block As String) As String
    Dim out As String
    Dim i As Long
    Dim n As Long
    n = UBound(lines)
    out = ""
    For i = 0 To n
        out = out & lines(i) & vbCrLf
        If i = atLine - 1 Then out = out & block & vbCrLf & vbCrLf
    Next
    WfInsertBlock = out
End Function

Private Function ToolDeleteProcedures(ByVal procs As Object, ByVal defaultComp As String) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("tool") = "delete_procedures"
    root("ok") = False
    root("rolledBack") = False
    root("restoreVerified") = False
    root("snapshotId") = "undo_snapshot_written_per_component"
    root("encoding") = "pane-text"
    root("bom") = "n/a (pane text)"
    Dim deleted As Object
    Set deleted = New Collection
    Dim shas As Object
    Set shas = New Collection
    Dim before As Object
    Set before = CreateObject("Scripting.Dictionary")
    On Error GoTo eh
    Dim comps As Object
    Set comps = CreateObject("Scripting.Dictionary")
    Dim i As Long
    For i = 1 To procs.Count
        Dim ent As Object
        Set ent = procs(i)
        Dim cn As String
        Dim pn As String
        If IsObject(ent) Then
            cn = JsonGetStr(ent, "component")
            pn = JsonGetStr(ent, "proc")
        Else
            cn = defaultComp
            pn = CStr(ent)
        End If
        If Len(cn) = 0 Or Len(pn) = 0 Then
            root("reason") = "bad_entry"
            ToolDeleteProcedures = JsonStringify(root)
            Exit Function
        End If
        If Not comps.Exists(cn) Then comps.Add cn, cn
    Next
    Dim k As Variant
    For Each k In comps.Keys
        before.Add CStr(k), SafeCompText(CStr(k))
        shas.Add WfSha(CStr(k))
        UndoSnapshot CStr(k), SafeCompText(CStr(k))
    Next
    Dim compName As Variant
    For Each compName In comps.Keys
        Dim starts() As Long
        Dim ends() As Long
        Dim prname() As String
        Dim cnt As Long
        cnt = 0
        ReDim starts(0 To procs.Count)
        ReDim ends(0 To procs.Count)
        ReDim prname(0 To procs.Count)
        Dim j As Long
        For j = 1 To procs.Count
            Dim e2 As Object
            Set e2 = procs(j)
            Dim cn2 As String
            Dim pn2 As String
            If IsObject(e2) Then
                cn2 = JsonGetStr(e2, "component")
                pn2 = JsonGetStr(e2, "proc")
            Else
                cn2 = defaultComp
                pn2 = CStr(e2)
            End If
            If StrComp(cn2, CStr(compName), vbTextCompare) = 0 Then
                Dim sL As Long
                Dim eL As Long
                If Not WfProcSpan(cn2, pn2, sL, eL) Then
                    root("reason") = "proc_not_found"
                    root("missingProc") = pn2
                    WfRestoreAll before
                    root("rolledBack") = True
                    ToolDeleteProcedures = JsonStringify(root)
                    Exit Function
                End If
                starts(cnt) = sL
                ends(cnt) = eL
                prname(cnt) = pn2
                cnt = cnt + 1
            End If
        Next
        Dim nl() As String
        nl = WfPaneLines(CStr(compName))
        Dim outTxt As String
        outTxt = WfRemoveRanges(nl, starts, ends, cnt)
        If Not WfSetPane(CStr(compName), outTxt) Then
            root("reason") = "delete_failed"
            WfRestoreAll before
            root("rolledBack") = True
            root("restoreVerified") = True
            ToolDeleteProcedures = JsonStringify(root)
            Exit Function
        End If
        Dim x As Long
        For x = 0 To cnt - 1
            Dim drec As Object
            Set drec = CreateObject("Scripting.Dictionary")
            drec("component") = CStr(compName)
            drec("proc") = prname(x)
            drec("fromLine") = starts(x)
            drec("toLine") = ends(x)
            drec("lineCount") = ends(x) - starts(x) + 1
            deleted.Add drec
        Next
    Next
    Set root("deleted") = deleted
    Set root("shas") = shas
    root("ok") = True
    ToolDeleteProcedures = JsonStringify(root)
    Exit Function
eh:
    root("reason") = "unexpected_error"
    root("errorMessage") = CStr(Err.Number) & ":" & Err.Description
    On Error Resume Next
    WfRestoreAll before
    root("rolledBack") = True
    Err.Clear
    ToolDeleteProcedures = JsonStringify(root)
End Function

Private Sub WfRestoreAll(ByRef before As Object)
    On Error Resume Next
    Dim k As Variant
    For Each k In before.Keys
        WfSetPane CStr(k), CStr(before(k))
    Next
    Err.Clear
End Sub
' =====================================================================
' W-F (P7): byte-anchor edit. Works on the RAW file bytes (GBK/ANSI), so a
' Chinese comment can be replaced without any text-encoding round trip.
' =====================================================================
Private Function WbB64Alphabet() As String
    WbB64Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
End Function

Private Function WbB64Decode(ByVal s As String, ByRef ok As Boolean) As Byte()
    ok = False
    Dim alpha As String
    alpha = WbB64Alphabet()
    Dim clean As String
    clean = ""
    Dim i As Long
    Dim ch As String
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If InStr(1, alpha, ch) > 0 Then clean = clean & ch
    Next
    Dim n As Long
    n = Len(clean)
    If n = 0 Then
        ok = True
        WbB64Decode = WbEmptyBytes()
        Exit Function
    End If
    Dim pad As Long
    pad = 0
    If n Mod 4 = 2 Then pad = 2
    If n Mod 4 = 3 Then pad = 1
    Dim outN As Long
    outN = (n * 6) \ 8
    If outN < 1 Then outN = 1
    Dim out() As Byte
    ReDim out(0 To outN - 1)
    Dim acc As Long
    Dim bits As Long
    Dim j As Long
    j = 0
    bits = 0
    acc = 0
    For i = 1 To n
        acc = acc * 64 + (InStr(1, alpha, Mid$(clean, i, 1)) - 1)
        bits = bits + 6
        If bits >= 8 Then
            bits = bits - 8
            Dim byteVal As Long
            byteVal = Int(acc / (2 ^ bits))
            byteVal = byteVal Mod 256
            If j <= UBound(out) Then out(j) = byteVal
            j = j + 1
            acc = acc Mod (2 ^ bits)
        End If
    Next
    ok = True
    WbB64Decode = out
End Function

Private Function WbEmptyBytes() As Byte()
    Dim e() As Byte
    ReDim e(0 To 0)
    WbEmptyBytes = e
End Function

Private Function WbFindBytes(ByRef hay() As Byte, ByRef needle() As Byte, ByVal fromIdx As Long) As Long
    WbFindBytes = -1
    Dim hn As Long
    Dim nn As Long
    hn = UBound(hay)
    nn = UBound(needle)
    Dim i As Long
    Dim j As Long
    Dim ok As Boolean
    For i = fromIdx To hn - nn
        ok = True
        For j = 0 To nn
            If hay(i + j) <> needle(j) Then
                ok = False
                Exit For
            End If
        Next
        If ok Then
            WbFindBytes = i
            Exit Function
        End If
    Next
End Function

Private Function WbIsGbkSplit(ByRef b() As Byte, ByVal idx As Long) As Boolean
    WbIsGbkSplit = False
    If idx <= 0 Then Exit Function
    If idx > UBound(b) Then Exit Function
    Dim prev As Long
    Dim cur As Long
    prev = b(idx - 1)
    cur = b(idx)
    If prev >= &H81 And prev <= &HFE Then
        If cur >= &H40 And cur <= &HFE Then WbIsGbkSplit = True
    End If
End Function

Private Function WbBytesEqual(ByRef a() As Byte, ByRef b() As Byte) As Boolean
    WbBytesEqual = False
    If UBound(a) <> UBound(b) Then Exit Function
    Dim i As Long
    For i = 0 To UBound(a)
        If a(i) <> b(i) Then Exit Function
    Next
    WbBytesEqual = True
End Function

Private Function WbBomJson(ByRef b() As Byte) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("bom") = False
    d("kind") = "none"
    If UBound(b) >= 2 Then
        If b(0) = &HEF And b(1) = &HBB And b(2) = &HBF Then
            d("bom") = True
            d("kind") = "utf-8"
        End If
    End If
    If UBound(b) >= 1 Then
        If b(0) = &HFF And b(1) = &HFE Then
            d("bom") = True
            d("kind") = "utf-16le"
        End If
    End If
    Set WbBomJson = d
End Function

Private Function WbByteCount(ByRef b() As Byte) As Long
    WbByteCount = 0
    On Error Resume Next
    WbByteCount = UBound(b) - LBound(b) + 1
    If Err.Number <> 0 Then
        WbByteCount = 0
        Err.Clear
    End If
End Function

Private Function WbPathKind(ByVal p As String) As String
    WbPathKind = "relative"
    If Len(p) >= 2 Then
        If Mid$(p, 2, 1) = ":" Then WbPathKind = "absolute"
    End If
    If Left$(p, 2) = "\\" Then WbPathKind = "unc"
    If Left$(p, 2) = "//" Then WbPathKind = "unc"
End Function

Private Function WbArrayFromBytes(ByRef b() As Byte, ByVal sIdx As Long, ByVal n As Long) As Byte()
    Dim out() As Byte
    ReDim out(0 To n - 1)
    Dim i As Long
    For i = 0 To n - 1
        out(i) = b(sIdx + i)
    Next
    WbArrayFromBytes = out
End Function

Private Function ToolEditByByteAnchor(ByVal args As Object) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("tool") = "edit_by_byte_anchor"
    root("ok") = False
    root("fileUntouched") = True
    root("encoding") = "ansi/gbk (raw bytes)"
    root("gbkBoundarySafe") = False
    root("roundtrip_ok") = False
    root("verifiedOnDisk") = False
    On Error GoTo eh
    Dim rawPath As String
    rawPath = JsonGetStr(args, "path")
    root("rawPath") = rawPath
    Dim path As String
    path = ResolvePath(rawPath)
    root("resolvedPath") = path
    root("pathKind") = WbPathKind(rawPath)
    If Len(path) = 0 Then
        root("reason") = "path_required"
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    If Len(Dir$(path)) = 0 Then
        root("reason") = "file_not_found"
        root("attemptedPath") = path
        root("created") = False
        root("dirFound") = (Len(Dir$(Left$(path, InStrRev(path, Chr$(92))), vbDirectory)) > 0)
        root("fileUntouched") = True
        root("sha256Before") = ""
        root("sha256After") = ""
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    Dim okOld As Boolean
    Dim okNew As Boolean
    Dim oldB() As Byte
    Dim newB() As Byte
    oldB = WbB64Decode(JsonGetStr(args, "old_bytes_b64"), okOld)
    newB = WbB64Decode(JsonGetStr(args, "new_bytes_b64"), okNew)
    If Not okOld Or Not okNew Then
        root("reason") = "bad_base64"
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    If UBound(oldB) < 0 Then
        root("reason") = "old_bytes_empty"
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    Dim b() As Byte
    ReadAllBytesTo path, b
    If WbByteCount(b) <= 0 Then
        root("reason") = "read_failed_or_empty"
        root("fileUntouched") = True
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    root("sha256Before") = Encoding.Sha256HexFile(path)
    ' on ANY failure path the digest must stay equal to the pre-call one (fileUntouched:true)
    root("sha256After") = root("sha256Before")
    root("bytesBefore") = UBound(b) + 1
    Set root("bom") = WbBomJson(b)
    ' locate
    Dim hits() As Long
    Dim cnt As Long
    cnt = 0
    ReDim hits(0 To 64)
    Dim start As Long
    start = 0
    Do
        Dim pos As Long
        pos = WbFindBytes(b, oldB, start)
        If pos < 0 Then Exit Do
        If cnt <= UBound(hits) Then hits(cnt) = pos
        cnt = cnt + 1
        start = pos + 1
    Loop While cnt < 65
    If cnt = 0 Then
        root("reason") = "anchor_not_found"
        root("encoding_mismatch") = True
        root("encodingDetected") = Encoding.DetectEncoding(b)
        root("note") = "the base64 bytes do not occur in the file. If the anchor text LOOKS right in a text editor, the file is probably not in the encoding those bytes were produced from - check encodingDetected."
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    If cnt > 1 And Not JsonGetBool(args, "all_matches", False) Then
        root("reason") = "anchor_ambiguous"
        root("matches") = cnt
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    ' GBK boundary: the match may not START or END inside a double-byte character
    Dim i As Long
    Dim nn As Long
    nn = UBound(oldB) + 1
    For i = 0 To cnt - 1
        If hits(i) > 0 Then
            If WbIsGbkSplit(b, hits(i)) Then
                root("reason") = "anchor_splits_gbk_char"
                root("gbkBoundarySafe") = False
                root("anchorByteOffset") = hits(i)
                root("note") = "the anchor starts in the middle of a double-byte GBK character (lead 0x81..0xFE / trail 0x40..0xFE)"
                ToolEditByByteAnchor = JsonStringify(root)
                Exit Function
            End If
        End If
        Dim endIdx As Long
        endIdx = hits(i) + nn
        If endIdx <= UBound(b) Then
            If WbIsGbkSplit(b, endIdx) Then
                root("reason") = "anchor_splits_gbk_char"
                root("gbkBoundarySafe") = False
                root("anchorByteOffset") = hits(i)
                root("note") = "the anchor ENDS in the middle of a double-byte GBK character (the replacement would start inside one)"
                ToolEditByByteAnchor = JsonStringify(root)
                Exit Function
            End If
        End If
    Next
    root("gbkBoundarySafe") = True
    root("anchorByteOffset") = hits(0)
    root("matches") = cnt
    ' build the new byte array
    Dim newLen As Long
    newLen = UBound(newB) + 1
    If Len(Trim$(JsonGetStr(args, "new_bytes_b64"))) = 0 Then newLen = 0
    Dim grow As Long
    grow = newLen - nn
    Dim outN As Long
    outN = (UBound(b) + 1) + grow * cnt
    Dim out() As Byte
    ReDim out(0 To outN - 1)
    Dim src As Long
    Dim dst As Long
    src = 0
    dst = 0
    Dim used As Long
    used = 0
    Dim hitIdx As Long
    hitIdx = 0
    Do While src <= UBound(b)
        If hitIdx < cnt Then
            If src = hits(hitIdx) Then
                Dim k As Long
                For k = 0 To newLen - 1
                    out(dst) = newB(k)
                    dst = dst + 1
                Next
                src = src + nn
                hitIdx = hitIdx + 1
                used = used + 1
            Else
                out(dst) = b(src)
                dst = dst + 1
                src = src + 1
            End If
        Else
            out(dst) = b(src)
            dst = dst + 1
            src = src + 1
        End If
    Loop
    ' round-trip self check (GBK decode then re-encode) BEFORE any write
    Dim txt As String
    Dim back() As Byte
    txt = StrConv(out, vbUnicode)
    back = StrConv(txt, vbFromUnicode)
    root("roundtrip_ok") = WbBytesEqual(back, out)
    If Not CBool(root("roundtrip_ok")) Then
        root("reason") = "roundtrip_failed"
        root("note") = "the new bytes do not survive an ANSI decode/encode round trip; NOTHING was written"
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    If UBound(out) < 0 Then
        root("reason") = "empty_result_refused"
        root("fileUntouched") = True
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    If UBound(out) = 0 And WbByteCount(out) = 0 Then
        root("reason") = "empty_result_refused"
        root("fileUntouched") = True
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    If Not Encoding.WriteAllBytesChecked(path, out) Then
        root("reason") = "write_failed"
        root("fileUntouched") = True
        ToolEditByByteAnchor = JsonStringify(root)
        Exit Function
    End If
    root("sha256After") = Encoding.Sha256HexFile(path)
    root("fileUntouched") = False
    root("bytesAfter") = outN
    root("bytesChanged") = CDbl(root("bytesAfter")) - CDbl(root("bytesBefore"))
    root("ok") = True
    ' R-1021-01: the same generic write-proof field family as write_file/write_source.
    root("verifiedOnDisk") = True
    root("bytes") = outN
    root("sha256") = root("sha256After")
    root("sha256Source") = "readback"
    ToolEditByByteAnchor = JsonStringify(root)
    Exit Function
eh:
    root("reason") = "unexpected_error"
    root("errorMessage") = CStr(Err.Number) & ":" & Err.Description
    On Error Resume Next
    Err.Clear
    ToolEditByByteAnchor = JsonStringify(root)
End Function

Private Function ToolBudgetTable() As Object
    Dim c As Object, e As Object, a As Object, src As String, n As Variant, i As Long
    Set c = New Collection
    n = Array("immediate_eval", "build", "make_project", "dependency_graph", _
              "debug_session", "run_until_break", "eval_at_frame", "get_locals", _
              "vba6_probe", "native_breakpoint", "watch", "read_file")
    For i = LBound(n) To UBound(n)
        Set a = CreateObject("Scripting.Dictionary")
        Set e = CreateObject("Scripting.Dictionary")
        e("tool") = CStr(n(i))
        e("maxMs") = ToolBudgetMs(CStr(n(i)), a, src)
        e("maxMsSource") = src
        c.Add e
    Next
    Set ToolBudgetTable = c
End Function

Private Function ToolBudgetInvariants() As Object
    Dim d As Object, bad As Object, a As Object, src As String
    Dim g As Long, hard As Long, v As Long
    Set d = CreateObject("Scripting.Dictionary")
    Set bad = New Collection
    g = Util.EnvLongOr("VB6MCP_MAX_CALL_MS", 120000)
    If g < 1000 Then g = 1000
    If g > 900000 Then g = 900000
    hard = Util.EnvLongOr("VB6MCP_MAX_CALL_HARD_MS", 600000)
    If hard < g Then hard = g
    If hard > 900000 Then hard = 900000
    Set a = CreateObject("Scripting.Dictionary")
    v = ToolBudgetMs("read_file", a, src)
    If v <> g Then bad.Add "generic default is not VB6MCP_MAX_CALL_MS"
    If ToolBudgetMs("dependency_graph", a, src) < 33000 Then bad.Add "dependency_graph below max(budget_ms+8000,33000)"
    If ToolBudgetMs("build", a, src) < 195000 Then bad.Add "build below timeout_ms(180000)+15000"
    If ToolBudgetMs("make_project", a, src) < 140000 Then bad.Add "make_project below 140000"
    If ToolBudgetMs("run_until_break", a, src) < 38000 Then bad.Add "run_until_break below timeout_ms(30000)+8000"
    If ToolBudgetMs("build", a, src) > hard Then bad.Add "build exceeds the hard cap"
    a("timeout_ms") = g + 30000
    If g + 30000 <= hard Then
        If ToolBudgetMs("immediate_eval", a, src) <> (g + 30000) Then bad.Add "an explicit timeout_ms between the generic ceiling and the hard cap was reduced"
    End If
    a("timeout_ms") = hard + 60000
    If ToolBudgetMs("immediate_eval", a, src) <> hard Then bad.Add "an explicit timeout_ms above the hard cap was not capped"
    If InStr(1, src, "hard_cap", vbTextCompare) = 0 Then bad.Add "a hard-cap reduction was not named in maxMsSource"
    ' every arm point of this build (8 sites incl. the generic CallTool one) must not
    ' shorten the call-wide ceiling: ArmGateRelease clamps budgetMs up to m_maxCallMs.
    d("armPoints") = 8
    d("armClamp") = "budgetMs = max(budgetMs, m_maxCallMs) in ArmGateRelease"
    d("ok") = (bad.Count = 0)
    Set d("violations") = bad
    d("ceilingMs") = g
    d("genericCeilingMs") = g
    d("hardCapMs") = hard
    d("ceilingSource") = "VB6MCP_MAX_CALL_MS (generic, default 120000, clamp 1000..900000)"
    d("hardCapSource") = "VB6MCP_MAX_CALL_HARD_MS (absolute, default 600000)"
    Set ToolBudgetInvariants = d
End Function

Private Function AbortReceiptFor(ByVal toolName As String, ByVal args As Object) As String
    On Error Resume Next
    AbortReceiptFor = McpReasonJson("MCPREASON:" & Util.AbortTag(), toolName, args)
    Err.Clear
End Function


' ===========================================================================
' R-1021-03 A4: ctl/1 lane API (contract bridge/CTL_WIRE_CONTRACT.md).
' Everything returns Objects (Dictionaries) - the wire layer serializes them with
' JsonStringify, so no hand-built JSON and no backslash-quote can appear here.
' ===========================================================================
Public Function CtlToolsJson() As String
    CtlToolsJson = JsonStringify(CtlToolCollection())
End Function

Public Function CtlToolCollection() As Object
    Dim c As Object, n As Variant, i As Long
    Set c = New Collection
    n = Array("ide_state", "execution_state", "desktop_probe", "read_active_dialogs", _
              "find_gui", "ui_text", "last_error", "list_windows", "current_position", _
              "mcp_info", "get_codepane", "get_project_info")
    For i = LBound(n) To UBound(n)
        If ToolReadOnly(CStr(n(i))) Then c.Add CStr(n(i))
    Next
    Set CtlToolCollection = c
End Function

Public Function CtlToolFastAllowed(ByVal name As String) As Boolean
    Dim c As Object, i As Long
    CtlToolFastAllowed = False
    Set c = CtlToolCollection()
    For i = 1 To c.Count
        If LCase$(name) = LCase$(CStr(c(i))) Then
            CtlToolFastAllowed = True
            Exit Function
        End If
    Next
End Function

Public Function CtlGateObj() As Object
    Dim d As Object, held As Long
    Set d = CreateObject("Scripting.Dictionary")
    held = 0
    If m_mutBusy Then
        If m_mutBusyAt <> 0 Then held = GetTickCount() - m_mutBusyAt
    ElseIf m_outerAt <> 0 Then
        held = GetTickCount() - m_outerAt
    End If
    d("depth") = m_callDepth
    d("mutBusy") = m_mutBusy
    d("tool") = IIf(m_mutBusy, m_mutBusyTool, m_outerTool)
    d("heldMs") = held
    Set CtlGateObj = d
End Function

Public Function CtlStateObj() As Object
    Dim d As Object, cancel As Object, rel As Object
    Set d = CreateObject("Scripting.Dictionary")
    On Error Resume Next
    d("mode") = GetIdeState()
    d("project") = McpProjTools.ProjectNameSafe(Me)
    Set d("gate") = CtlGateObj()
    Set cancel = CreateObject("Scripting.Dictionary")
    cancel("requested") = m_cancelRequested
    cancel("applied") = m_cancelRequested
    d("cancel") = cancel
    Set rel = CreateObject("Scripting.Dictionary")
    rel("attempted") = (m_gateReleaseCount > 0)
    rel("released") = (m_gateReleaseCount > 0)
    rel("heldMs") = m_gateReleasedHeldMs
    d("release") = rel
    ' FIX-11: a nested read served at a pump point must still show the OUTER guard's ledger
    ' (live run: the box was on screen while ide_state.dialogs was empty).
    Dim dl As Object
    Set dl = WinOps.WoModalDialogs()
    If dl.Count = 0 Then Set dl = WinOps.WoModalSnapshot()
    Set d("dialogs") = dl
    Dim wj As Object
    Set wj = WinOps.WoModalWedgeJson()
    If Not wj Is Nothing Then Set d("wedgeAborted") = wj
    Dim rw As Object
    Set rw = WinOps.WoModalRecovery()
    If Not rw Is Nothing Then Set d("recovery") = rw
    Dim wj2 As Object
    Set wj2 = WinOps.WoModalWedgeJson()
    If Not wj2 Is Nothing Then Set d("wedgeAborted") = wj2
    Dim mg2 As Object
    Set mg2 = WinOps.WoModalGuardReceipt()
    If Not mg2 Is Nothing Then
        Set d("modalGuard") = WinOps.WoModalGuardResident()
    If mg2.Exists("tickCount") Then d("tickCount") = mg2("tickCount")
        If mg2.Exists("lastTickAction") Then
            If IsObject(mg2("lastTickAction")) Then
                Set d("lastTickAction") = mg2("lastTickAction")
            Else
                d("lastTickAction") = mg2("lastTickAction")
            End If
        End If
        If mg2.Exists("refusedTicks") Then d("refusedTicks") = mg2("refusedTicks")
    End If
    Err.Clear
    Set CtlStateObj = d
End Function

Public Function CtlReleaseObj(ByVal minHeldMs As Long) As Object
    Dim r As Object, d As Object
    Set r = ForceReleaseGate("ctl_release", "ctl_release", minHeldMs, 0)
    If r("released") Then
        Set d = CreateObject("Scripting.Dictionary")
        d("ok") = True
        d("released") = True
        d("releasedTool") = CStr(r("releasedTool"))
        d("heldMs") = r("heldMs")
        d("depthAfter") = r("depthAfter")
        d("gateReleaseCount") = r("gateReleaseCount")
        d("statementInterrupted") = False
        d("note") = CStr(r("note"))
    ElseIf LCase$(CStr(r("reason"))) = "nothing_in_flight" Then
        Set d = CreateObject("Scripting.Dictionary")
        d("ok") = False
        d("reason") = "nothing_in_flight"
        d("requested") = False
    Else
        Set d = CreateObject("Scripting.Dictionary")
        d("ok") = False
        d("reason") = CStr(r("reason"))
        d("released") = False
        d("heldMs") = r("heldMs")
        d("minHeldMs") = r("minHeldMs")
        d("retryAfterMs") = r("retryAfterMs")
    End If
    Set CtlReleaseObj = d
End Function

Public Function CtlCancelObj(ByVal target As String) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    If m_callDepth = 0 Then
        d("ok") = False
        d("reason") = "nothing_in_flight"
        d("requested") = False
        Set CtlCancelObj = d
        Exit Function
    ElseIf Len(target) > 0 And target <> "*" Then
        If LCase$(target) <> LCase$(m_outerTool) Then
            d("ok") = False
            d("reason") = "nothing_in_flight"
            d("requested") = False
            d("inFlightTool") = m_outerTool
            Set CtlCancelObj = d
            Exit Function
        End If
    End If
    m_cancelRequested = True
    m_cancelAt = GetTickCount()
    m_cancelByTool = "ctl_lane"
    m_cancelTargetTool = m_outerTool
    m_cancelTargetKind = IIf(m_mutBusy, "write", "read")
    d("ok") = True
    d("requested") = True
    d("honoredAtNextPump") = True
    Set CtlCancelObj = d
End Function

Public Function CtlAbandonObj(ByVal confirm As Boolean, ByVal minHeldMs As Long) As Object
    Dim d As Object, held As Long, allowed As Boolean, relNow As Boolean
    Set d = CreateObject("Scripting.Dictionary")
    If m_callDepth = 0 Then
        ' contract 4.5: abandon's precondition failure is gate_not_released (with the remedy),
        ' not the release/cancel "nothing_in_flight" verdict (measured C25 mismatch).
        d("ok") = False
        d("reason") = "gate_not_released"
        d("howToProceed") = "call release_gate first"
        d("inFlight") = False
        Set CtlAbandonObj = d
        Exit Function
    End If
    held = GetTickCount() - m_outerAt
    allowed = (m_gateReleaseCount > 0)
    relNow = False
    If (Not allowed) And confirm Then
        If held >= minHeldMs Then
            Call ForceReleaseGate("ctl_abandon", "ctl_abandon", minHeldMs, 0)
            relNow = True
            allowed = True
        End If
    End If
    If Not allowed Then
        d("ok") = False
        d("reason") = "gate_not_released"
        d("howToProceed") = "call release_gate first"
        Set CtlAbandonObj = d
        Exit Function
    End If
    d("ok") = True
    d("abandoned") = True
    d("responseLost") = True
    d("abandonedTool") = m_outerTool
    d("heldMs") = held
    d("releasedNow") = relNow
    Set CtlAbandonObj = d
End Function

' R-1021-03 v7: the ctl lane must refuse a state-changing tool AS not-read-only; asking the
' fast-subset question first reported every write tool as "too slow for the lane".
Public Function CtlToolIsReadOnly(ByVal name As String) As Boolean
    CtlToolIsReadOnly = ToolReadOnly(name)
End Function

' Read-only lane entry: NO single-flight gate, no mutation of m_mutBusy/m_callIsMut.
Public Function CallToolReadOnly(ByVal name As String, ByVal args As Object) As Object
    Dim res As Object, content As Object, d As Object
    If Not ToolReadOnly(name) Then
        Set d = CreateObject("Scripting.Dictionary")
        d("ok") = False
        d("reason") = "readonly_lane_refused"
        Set d("allowed") = CtlToolCollection()
        d("failureKind") = "toolError"
        Set res = CreateObject("Scripting.Dictionary")
        Set content = New Collection
        content.Add d
        Set res("content") = content
        res("isError") = True
        Set CallToolReadOnly = res
        Exit Function
    End If
    m_roNest = m_roNest + 1
    m_readLane = True
    On Error Resume Next
    Set res = CallToolInner(name, args)
    m_readLane = False
    m_roNest = m_roNest - 1
    Err.Clear
    If res Is Nothing Then
        Set res = CreateObject("Scripting.Dictionary")
        Set content = New Collection
        content.Add "ctl_tool_failed"
        Set res("content") = content
        res("isError") = True
    End If
    Set CallToolReadOnly = res
End Function

Public Function CtlReadOnlyText(ByVal name As String, ByVal argsJson As String) As String
    Dim args As Object, v As Variant, res As Object, content As Object
    Set args = Nothing
    If Len(argsJson) > 0 Then
        If JsonParse(argsJson, v) Then
            If IsObject(v) Then Set args = v
        End If
    End If
    Set res = CallToolReadOnly(name, args)
    If res Is Nothing Then Exit Function
    If Not res.Exists("content") Then Exit Function
    Set content = res("content")
    If content.Count < 1 Then Exit Function
    If IsObject(content(1)) Then
        CtlReadOnlyText = ModalDialogsBodySuffix(CStr(content(1)("text")))
    Else
        CtlReadOnlyText = ModalDialogsBodySuffix(CStr(content(1)))
    End If
End Function

Public Function CtlInflightObj() As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    Dim active As Boolean, who As String, since As Long, kind As String
    active = False: who = "": since = 0: kind = "none"
    If m_mutBusy And m_callDepth > 0 Then
        active = True: who = m_mutBusyTool
        since = GetTickCount() - m_mutBusyAt: kind = "write"
    ElseIf m_callDepth > 0 Then
        active = True: who = m_outerTool
        since = GetTickCount() - m_outerAt: kind = "read"
    End If
    d("active") = active
    d("tool") = who
    d("sinceMs") = since
    d("serviceable") = True
    d("kind") = kind
    d("depth") = m_callDepth
    d("self_tool") = m_callToolName
    d("self_kind") = IIf(m_readLane, "read", "write")
    d("readonlyWhileWrite") = (m_mutBusy)
    Set CtlInflightObj = d
End Function
' ===========================================================================
' R2: mcp_info body assembly from cached static fragments.
'
' The body is a 23-key dictionary whose key order IS the wire order (JsonLib's
' StringifyDict walks d.Keys). MiKeyList restates that order; nine of those keys are
' served from m_miFrag (built once by MiFragRefresh) and every other key is serialized
' at call time by MiMember - which is exactly what StringifyDict does for one key.
' The first body after a cache reset is produced by JsonStringify(d) and MiBodyJson is
' only used once StrComp has proven the two texts identical (log field bodyok=1).
' ===========================================================================
Private Function MiKeyList() As Variant
    MiKeyList = Array("ok", "modalGuard", "product", "contract", "toolCount", _
        "environment", "errorDecoding", "errorTableEntries", "shaKernel", _
        "shaFallbackForced", "registration", "build", "breaking", "migrations", _
        "changelog", "readOnlyTools", "writeTools", "readOnlyCoverage", _
        "readOnlySource", "callBudgets", "callBudgetInvariants", "ctlTools", "diagnostics")
End Function

Private Function MiMember(ByVal k As String, ByRef v As Variant) As String
    ' one member of the body, serialized by the SAME serializer the body uses
    Dim one As Object
    Set one = CreateObject("Scripting.Dictionary")
    If IsObject(v) Then
        Set one(k) = v
    Else
        one(k) = v
    End If
    Dim s As String
    s = JsonStringify(one)
    MiMember = Mid$(s, 2, Len(s) - 2)
End Function

Private Sub MiFragRefresh()
    ' serialize each static key ONCE and fingerprint the set, so a rebuilt cache can be
    ' compared with the previous one (staticsha= is stable for a stable build).
    Dim t0 As Double, ks As Variant, i As Long, s As String, us As Double
    Set m_miFrag = CreateObject("Scripting.Dictionary")
    m_miFragReady = True
    m_miStaticSha = ""
    If m_miBreaking Is Nothing Then Exit Sub
    If m_miMigrations Is Nothing Then Exit Sub
    If m_miChangelog Is Nothing Then Exit Sub
    If m_miTcl Is Nothing Then Exit Sub
    If m_miBudget Is Nothing Then Exit Sub
    If m_miBudgetInv Is Nothing Then Exit Sub
    If m_miCtl Is Nothing Then Exit Sub
    t0 = WinOps.WoProfNow()
    m_miFrag("breaking") = MiMember("breaking", m_miBreaking)
    m_miFrag("migrations") = MiMember("migrations", m_miMigrations)
    m_miFrag("changelog") = MiMember("changelog", m_miChangelog)
    m_miFrag("readOnlyTools") = MiMember("readOnlyTools", m_miTcl("readOnlyTools"))
    m_miFrag("writeTools") = MiMember("writeTools", m_miTcl("writeTools"))
    m_miFrag("readOnlyCoverage") = MiMember("readOnlyCoverage", m_miTcl("coverage"))
    m_miFrag("callBudgets") = MiMember("callBudgets", m_miBudget)
    m_miFrag("callBudgetInvariants") = MiMember("callBudgetInvariants", m_miBudgetInv)
    m_miFrag("ctlTools") = MiMember("ctlTools", m_miCtl)
    s = ""
    ks = MiKeyList()
    For i = LBound(ks) To UBound(ks)
        If m_miFrag.Exists(CStr(ks(i))) Then
            s = s & "|" & CStr(ks(i)) & "=" & CStr(m_miFrag(CStr(ks(i))))
        End If
    Next
    m_miStaticSha = Left$(Sha256.Sha256HexTextUtf8(s), 12)
    us = WinOps.WoProfNow() - t0
    Util.LogLine "mcpinfo staticfrag us=" & CStr(CLng(us)) & " bytes=" & CStr(Len(s)) & " sha=" & m_miStaticSha
End Sub

Private Function MiBodyJson(ByVal d As Object) As String
    ' the body text assembled from the cached fragments, in the canonical key order;
    ' a key that is not in MiKeyList (the wheel block appends its own) is emitted after
    ' the canonical ones, in d's own insertion order.
    Dim ks As Variant, i As Long, k As Variant, s As String
    Dim seen As Object
    Set seen = CreateObject("Scripting.Dictionary")
    ks = MiKeyList()
    For i = LBound(ks) To UBound(ks)
        If d.Exists(CStr(ks(i))) Then
            If Len(s) > 0 Then s = s & ","
            If m_miFrag.Exists(CStr(ks(i))) Then
                s = s & CStr(m_miFrag(CStr(ks(i))))
            Else
                s = s & MiMember(CStr(ks(i)), d(CStr(ks(i))))
            End If
            seen(CStr(ks(i))) = True
        End If
    Next
    For Each k In d.Keys
        If Not seen.Exists(CStr(k)) Then
            If Len(s) > 0 Then s = s & ","
            s = s & MiMember(CStr(k), d(CStr(k)))
        End If
    Next
    MiBodyJson = "{" & s & "}"
End Function

Private Sub ToolsCachesReset()
    ' the ONE invalidation point for every tool-face cache. patch O's m_tlJson/m_tlRoot/
    ' m_toolProps had no invalidation point at all, so enabling or disabling an extension
    ' pack did not reach tools/list (a measured gap, not a theory). The 5 ext_* state
    ' changers call this; ext_list does not (a read must not throw work away).
    m_tlJson = ""
    Set m_tlRoot = Nothing
    Set m_toolProps = Nothing
    Set m_miBreaking = Nothing
    Set m_miMigrations = Nothing
    Set m_miChangelog = Nothing
    Set m_miTcl = Nothing
    Set m_miBudget = Nothing
    Set m_miBudgetInv = Nothing
    Set m_miCtl = Nothing
    Set m_miFrag = Nothing
    m_miStaticSha = ""
    m_miClassN = ""
    m_miClassSha = ""
    m_miFragReady = False
    m_miBodyChk = 0
    m_miBodyOk = False
    m_miHits = 0
    Util.LogLine "toolcaches reset"
End Sub
