        End If
    Else
        root("registrationApplicable") = True
        root("registrationUntouched") = True
    End If
    root("ok") = br.ok
    root("exitCode") = ec
    ' v1.11.12: HARD BUDGET evidence (additive). On every NON-timeout path the historical
    ' ok / verdict values are untouched; only a KILLED compiler overrides them (at the end).
    root("timedOut") = hbTimedOut
    root("budgetEnforced") = hbTimedOut
    root("budgetMs") = hbAppliedBudget
    root("budgetSource") = hbBudgetSrc
    root("killMethod") = hbKillMethod
    root("childPid") = hbChildPid
    root("compilerElapsedMs") = hbProcMs
    root("childLeftover") = hbLeftover
    ' file/line are reported ONLY when the log actually carried a file(line) STRUCTURE.
    ' A project-level error must leave them ABSENT - filling reportedLine = 0 as if it were a real
    ' line is exactly the fabrication this card is about.
    If Len(br.file) > 0 Then root("file") = br.file
    If br.reportedLine > 0 Then root("reportedLine") = br.reportedLine
    If br.diskLine > 0 Then root("diskLine") = br.diskLine
    ' WHICH kind of first error this is - file-line | project-level | log-unparsed.
    ' (br.verdict itself stays the artifact verdict: artifact / log-keyword-only / artifact-missing.)
    If Len(br.file) > 0 And br.reportedLine > 0 Then
        root("firstErrorKind") = "file-line"
    ElseIf Len(br.message) > 0 Then
        root("firstErrorKind") = "project-level"
    ElseIf br.unparsed Then
        root("firstErrorKind") = "log-unparsed"
    End If
    ' ruling 4: this response carries line numbers whenever the compiler located an
    ' error, so it must carry coords too (reportedLine is 0-based IDE, diskLine 1-based)
    If br.reportedLine > 0 Then Set root("coords") = CoordsDict(br.reportedLine + 1, off, "ide", (off >= 0))
    root("key") = br.key
    root("message") = br.message
    ' this branch used to ASSERT that no error text existed. That assertion was FALSE on the
    ' measured input (the log carried '必须有启动窗体 或 Sub Main()' plus a 编译失败。 summary line); it
    ' only reflected that the parser recognised nothing. A receipt must never claim an absence it
    ' cannot prove: report the structured unparsed state and carry the raw line + a bounded excerpt.
    If Len(br.rawLine) > 0 Then root("rawLine") = br.rawLine
    ' the honest provenance of the value - err-marker | fail-marker-up | none
    If Len(br.matchRule) > 0 Then root("matchRule") = br.matchRule
    ' provable log facts (encoding the reader used + real byte size on disk)
    If Len(br.logEncoding) > 0 Then root("logEncoding") = br.logEncoding
    ' calibration: logBytes ALONE is ambiguous (0 can mean a genuinely empty file OR an
    ' unreadable one).  So the pair is published together and logBytes is only written when the
    ' reader actually read the file - logEncoding = "empty_or_unreadable" is the unreadable case,
    ' and a real 0-byte file reports logBytes = 0 WITH a readable encoding.
    If br.logBytes > 0 Or (Len(br.logEncoding) > 0 And br.logEncoding <> "empty_or_unreadable") Then root("logBytes") = br.logBytes
    If br.unparsed Then
        root("verdict") = "log-unparsed"
        root("logExcerpt") = br.logExcerpt
        root("message") = "isolated /make failed (exit code " & CStr(ec) & ") and no structured error line was recognised in the compiler log; the log is at logPath (see logExcerpt)"
    End If
    root("logPath") = logPath
    ' (i18n): expose how the verdict was reached
    root("artifact") = artifact
    ' artifactSize must not present a STALE file's size as though a
    ' build had produced it. It is meaningful only when a fresh artifact was verified;
    ' otherwise it is 0 and any old size moves to staleArtifactSize.
    If CStr(br.verdict) = "artifact" Then
        root("artifactSize") = br.artifactSize
    Else
        root("artifactSize") = 0
        If br.artifactSize > 0 Then root("staleArtifactSize") = br.artifactSize
    End If
    root("okByKeyword") = br.okByKeyword
    root("verdict") = br.verdict
    ' ---- alpha: compiled is NOT the same as artifact updated
    root("artifactPath") = artifact
    If Len(artifact) = 0 Then
        ' no artifact path: artifactChanged cannot be judged, and claiming false
        ' would read like the "locked" verdict - say it is unknown instead
        root("artifactChecked") = False
        root("artifactNote") = "the project declares no ExeName32 and no in-IDE Make target, so the artifact path is unknown and artifactChanged cannot be judged"
    Else
        root("artifactChanged") = artChanged
        If Not artChanged Then WcAttachCompileLogHint root
        If aAfterExists Then root("artifactMtime") = ArtifactMtimeText(True, aAfterTime)
    End If
    If Len(artifact) > 0 And Not artChanged Then
        ' The compiler can compile cleanly and still fail to WRITE the artifact when
        ' another process holds it. That case reports NO compile-error location
        ' (br.file stays empty), so it is distinguishable from a real compile error
        ' in a language-independent way. A located error is never called "compiled".
        Dim locatedErr As Boolean
        locatedErr = (Len(br.file) > 0)
        Dim writeOnlyFail As Boolean
        writeOnlyFail = (ec = 0) Or br.okByKeyword Or (Len(Trim$(br.message)) = 0)
        If aAfterExists And (Not locatedErr) And writeOnlyFail Then
            root("ok") = True
            root("verdict") = "compiled-no-artifact-change"
            root("artifactLockedHint") = "the code compiled but the artifact was NOT rewritten: it is most likely held open by another process (close it), or the build wrote identical bytes"
            ' (item 1): every exception above is a HYPOTHESIS.
            ' On this route the receipt cannot tell them apart from a compile failure,
            ' so say that instead of implying the build was merely redundant.
            root("unbuiltReasonUnknown") = True
            root("artifactNote") = "NOT built: the artifact was neither produced nor rewritten, and this route cannot say WHY - a compile failure is possible (compiled/okByKeyword are not evidence). Use make_project with diagnose=true, or build a COPY of the project with an isolated VB6.EXE /make, to get a real compiler log and firstError."
        End If
    End If
    ' ---- incremental feedback -----------------------------
    ' ---- incremental feedback -----------------------------
    root("cached") = False
    If useIde Then root("path") = "make_project" Else root("path") = "make"
    ' state the route explicitly and account for the blocking time.
    ' (R7-4): the actual command line + the structured /d list, so the
    ' "did my macro really get passed?" question is answerable from the receipt alone.
    CcArgsInto root, cmdArgs, ccExtra, ccArgs, defines, useIde
    root("projectPath") = vbp
    If useIde Then
        root("route") = "make_project"
        ' FIX-24 (F6): the in-IDE route compiles the PANE; lift the pane-vs-disk measurement the
        ' delegated make_project published, so this receipt (and the build cache) can say whether
        ' the compiled source matched the disk file.
        root("compiledFrom") = "pane"
        root("compiledFromBasis") = "the in-IDE Make compiled the code pane (no compiler subprocess, no file read)"
        Dim pdmTok As String, pdmNum As String, pdmNm As String
        pdmTok = IdeJsonToken(ideMakeJson, "paneDiskMismatch")
        If pdmTok = "true" Then root("paneDiskMismatch") = True
        If pdmTok = "false" Then root("paneDiskMismatch") = False
        pdmNum = IdeJsonToken(ideMakeJson, "paneDiskMismatchCount")
        If Len(pdmNum) > 0 Then
            On Error Resume Next
            root("paneDiskMismatchCount") = CLng(Val(pdmNum))
            If Err.Number <> 0 Then Err.Clear
            On Error GoTo 0
        End If
        pdmNm = IdeJsonStrMember(ideMakeJson, "paneDiskMismatchNames")
        If Len(pdmNm) > 0 Then root("paneDiskMismatchNames") = pdmNm
        If CBool(root("paneDiskMismatch")) Then
            root("paneDiskMismatchNote") = "the in-IDE Make compiled the PANE while it differed from the DISK for " & pdmNum & " component(s); a cached verdict from this build does not describe the disk source (verify will report buildSource=cache-pane-disk-mismatch)"
        End If
    Else
        root("route") = "make"
        ' FIX-24 (F6): the isolated /make reads the files on disk, so pane/disk cannot diverge on
        ' this route (a pane that disagrees with the disk is simply not what got compiled).
        root("compiledFrom") = "disk"
        root("compiledFromBasis") = "VB6.EXE /make compiles the .vbp and its component FILES as they are on disk"
        root("paneDiskMismatch") = False
        root("paneDiskMismatchCount") = 0
        root("paneDiskMismatchNames") = ""
    End If
    ' (R5): make_project{route:"cli"} delegates HERE, and an isolated
    ' VB6.EXE /make cannot compile a project the IDE holds - so that call silently
    ' becomes an in-IDE Make. Say so, instead of letting the caller believe /make ran,
    ' and stop presenting the in-IDE route's exitCode 0 as a compiler verdict.
    Dim cliDelegated As Boolean
    cliDelegated = (LCase$(m_makeRouteOverride) = "ide")
    root("requestedRoute") = ""
    root("routeDowngraded") = False
    root("exitCodeApplies") = (Not useIde)
    If cliDelegated Then
        root("requestedRoute") = "cli"
        If useIde Then
            root("routeDowngraded") = True
            root("routeDowngradeReason") = "route=cli asked for an isolated VB6.EXE /make, but this project is open in the IDE and the IDE holds the file, so the isolated compiler cannot take it. The call fell back to the in-IDE Make (VBProject.MakeCompiledFile), which starts NO compiler subprocess and therefore writes no /out log."
        End If
    End If
    If useIde Then
        root("exitCodeNote") = "exitCode is 0 because NO compiler subprocess ran on this route (VBProject.MakeCompiledFile reports only success or failure). Do NOT read exitCode 0 as ""the compiler found no errors"" - read verdict, artifactChanged and output{} instead."
    End If
    Dim bk As Object
    Set bk = CreateObject("Scripting.Dictionary")
    bk("serverBlockedMs") = GetTickCount() - el0
    bk("prepMs") = elPrep - el0
    bk("compileMs") = GetTickCount() - elPrep
    If useIde Then
        bk("timeoutMs") = 0
        bk("timeoutApplies") = False
        bk("note") = "in-IDE Make: no compiler subprocess, so timeout_ms does not apply to this route"
    Else
        bk("timeoutMs") = timeoutMs
        bk("timeoutApplies") = True
        bk("note") = "timeout_ms bounds ONLY the compiler subprocess (VB6.EXE /make); the fingerprint/cache preprocessing is not bounded by it"
    End If
    Set root("blocking") = bk
    If Len(ideMakeJson) > 0 Then
        root("ideMake") = ideMakeJson
        ' R-1021-04 (item 2): lift the in-IDE route's save/dirty outcome and its
        ' diagnostic verdict, so a caller does not have to parse the nested receipt to
        ' learn whether anything was written on its behalf or why no first error exists.
        Dim lmTok As String
        lmTok = IdeJsonToken(ideMakeJson, "refused")
        If lmTok = "true" Then
            ideRefused = True
            root("refused") = True
        End If
        lmTok = IdeJsonStrMember(ideMakeJson, "howToProceed")
        If Len(lmTok) > 0 Then root("howToProceed") = lmTok
        lmTok = IdeJsonToken(ideMakeJson, "buildStarted")
        If lmTok = "true" Then
            root("buildStarted") = True
        ElseIf lmTok = "false" Then
            root("buildStarted") = False
        End If
        lmTok = IdeJsonStrMember(ideMakeJson, "autoSaveVia")
        If Len(lmTok) = 0 Then root("autoSaveVia") = ""
        lmTok = IdeJsonToken(ideMakeJson, "autoSaved")
        If lmTok = "true" Then
            root("autoSaved") = True
        ElseIf lmTok = "false" Then
            root("autoSaved") = False
        End If
        lmTok = IdeJsonStrMember(ideMakeJson, "autoSaveVia")
        If Len(lmTok) > 0 Then root("autoSaveVia") = lmTok
        lmTok = IdeJsonStrMember(ideMakeJson, "autoSavedComponents")
        If Len(lmTok) > 0 Then root("autoSavedComponents") = lmTok
        lmTok = IdeJsonStrMember(ideMakeJson, "dirtyComponents")
        If Len(lmTok) > 0 Then root("dirtyComponents") = lmTok
        lmTok = IdeJsonStrMember(ideMakeJson, "firstErrorUnavailableReason")
        If Len(lmTok) > 0 Then root("firstErrorUnavailableReason") = lmTok
        lmTok = IdeJsonStrMember(ideMakeJson, "firstErrorUnavailableSource")
        If Len(lmTok) > 0 Then root("firstErrorUnavailableSource") = lmTok
        lmTok = IdeJsonToken(ideMakeJson, "firstErrorUnavailable")
        If lmTok = "true" Then root("firstErrorUnavailable") = True
        lmTok = IdeJsonToken(ideMakeJson, "dirtyComponentCount")
        If Len(lmTok) > 0 Then
