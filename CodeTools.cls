    Set RunDiskObservePendingPrompt = d
End Function

Private Function RunDiskFinish(ByVal g As Object) As Object
    Dim fin As Object
    Dim ds As Object
    Dim after As Object
    Dim meta2 As Object
    Dim shaPaths As Object
    Dim dsum As Object
    Dim dc As Object
    Dim i As Long
    Dim defaultAttr As String
    Dim diff As Object
    Dim fp As Object
    Dim writes As Object
    Dim w As Object
    Dim beforeMeta As Object
    Dim files As Object
    Set fin = CreateObject("Scripting.Dictionary")
    Set ds = CreateObject("Scripting.Dictionary")
    Set fin("diskWrites") = EmptyJsonArray()
    Set fin("touchedFiles") = EmptyJsonArray()
    ds("taken") = False
    fin("attribution") = "none"
    On Error Resume Next
    If g Is Nothing Then
        ds("basis") = "no_guard_context"
        Set fin("diskSnapshot") = ds
        Set RunDiskFinish = fin
        Exit Function
    End If
    If g.Exists("notStartPath") Then
        If CBool(g("notStartPath")) Then
            ds("basis") = "not_a_start_path: this call executed no Start command, so the IDE could not have auto-saved on it"
            Set fin("diskSnapshot") = ds
            Set RunDiskFinish = fin
            Exit Function
        End If
    End If
    Set beforeMeta = Nothing
    If g.Exists("snapMetaBefore") Then Set beforeMeta = g("snapMetaBefore")
    Set files = Nothing
    If g.Exists("files") Then Set files = g("files")
    If files Is Nothing Then
        ds("basis") = "no_snapshot_files: the project had no .vbp on disk when this call began"
        Set fin("diskSnapshot") = ds
        fin("attribution") = "unknown"
        Set RunDiskFinish = fin
        Exit Function
    End If
    If Not g.Exists("before") Then
        ds("basis") = "before_snapshot_missing"
        Set fin("diskSnapshot") = ds
        fin("attribution") = "unknown"
        Set RunDiskFinish = fin
        Exit Function
    End If
    Set meta2 = CreateObject("Scripting.Dictionary")
    Set shaPaths = CreateObject("Scripting.Dictionary")
    If g.Exists("dirtySummary") Then
        Set dsum = g("dirtySummary")
        If Not dsum Is Nothing Then
            Set dc = dsum("dirtyComponents")
            If Not dc Is Nothing Then
                For i = 1 To dc.Count
                    If Len(CStr(dc.Item(i)("file"))) > 0 Then shaPaths(LCase$(CStr(dc.Item(i)("file")))) = True
                Next
            End If
        End If
    End If
    Set after = Build.DiskSnapTake(files, shaPaths, meta2)
    Build.DiskSnapFillChanged g("before"), after
    defaultAttr = "ide_auto_save"
    If g.Exists("willFlush") Then
        If CBool(g("willFlush")) Then
            If CBool(g("flushRan")) Then defaultAttr = "unknown"
        End If
    End If
    Set diff = Build.DiskSnapDiff(g("before"), after, defaultAttr)
    Set fp = Nothing
    If g.Exists("flushPaths") Then Set fp = g("flushPaths")
    Set writes = diff("writes")
    For i = 1 To writes.Count
        Set w = writes.Item(i)
        If CBool(g("flushRan")) Then
            If fp Is Nothing Then
                w("attribution") = "unknown"
            ElseIf fp.Exists(LCase$(CStr(w("file")))) Then
                w("attribution") = "mcp_pre_run_flush"
            Else
                w("attribution") = "ide_auto_save"
            End If
        Else
            w("attribution") = "ide_auto_save"
        End If
    Next
    Set fin("diskWrites") = writes
    Set fin("touchedFiles") = diff("touched")
    ds("taken") = True
    ds("hashMode") = meta2("hashMode")
    ds("budgetBytes") = meta2("budgetBytes")
    ds("checkedFiles") = meta2("checkedFiles")
    ds("filesTotal") = meta2("fileCount")
    ds("bytesTotal") = meta2("totalBytes")
    If Not beforeMeta Is Nothing Then
        If beforeMeta.Exists("snapshotMs") Then
            ds("snapshotMs") = CLng(meta2("snapshotMs")) + CLng(beforeMeta("snapshotMs"))
        Else
            ds("snapshotMs") = meta2("snapshotMs")
        End If
        If beforeMeta.Exists("gatedReason") Then ds("gatedReason") = CStr(beforeMeta("gatedReason"))
    Else
        ds("snapshotMs") = meta2("snapshotMs")
    End If
    ds("startWaitMs") = CLng(g("waitMs"))
    If g.Exists("vbpPath") Then ds("vbpPath") = CStr(g("vbpPath"))
    ds("fullHashUpToBytes") = CLng(RUNSNAP_FULL_HASH_MAX)
    If CStr(meta2("hashMode")) = "gated" Then
        ds("gatedNote") = "project above the full-hash budget: the .vbp and the dirty components were hashed; a file whose size/mtime did not move is compared by size+mtime only, and an un-taken digest is reported as empty plus a reason"
    End If
    Set fin("diskSnapshot") = ds
    If writes.Count > 0 Then fin("attribution") = "mixed"
    Err.Clear
    Set RunDiskFinish = fin
End Function

Private Function RunDiskFinishForReceipt(ByVal g As Object) As Object
    Dim fin As Object
    Dim f As Object
    Set fin = CreateObject("Scripting.Dictionary")
    On Error Resume Next
    If g Is Nothing Then Set g = RunDiskEmptyGuard("", "", False)
    If Not g.Exists("finDone") Then
        Set f = RunDiskFinish(g)
        If Not f Is Nothing Then
            Set g("fin") = f
            g("finDone") = True
        End If
    End If
    Set f = Nothing
    If g.Exists("fin") Then Set f = g("fin")
    If Not f Is Nothing Then
        If f.Exists("diskWrites") Then Set fin("diskWrites") = f("diskWrites")
        If f.Exists("touchedFiles") Then Set fin("touchedFiles") = f("touchedFiles")
        If f.Exists("diskSnapshot") Then Set fin("diskSnapshot") = f("diskSnapshot")
    End If
    fin("promptExpected") = CBool(g("promptExpected"))
    Err.Clear
    Set RunDiskFinishForReceipt = fin
End Function

Private Sub RunDiskAttachDeferred(ByRef root As Object)
    On Error Resume Next
    Dim res As Object
    If m_runDiskDeferredResult Is Nothing Then Exit Sub
    Set res = m_runDiskDeferredResult
    res("emittedInThisReceipt") = True
    If root.Exists("deferredStart") Then Set root("deferredStartPrevious") = root("deferredStart")
    Set root("deferredStart") = res
    Set m_runDiskDeferredResult = Nothing
    Err.Clear
End Sub

Public Sub RunDiskAttach(ByRef root As Object, ByVal g As Object, ByVal executed As Boolean, ByVal afterState As String)
    Dim auto As Object
    Dim fin As Object
    Dim ds As Object
    Dim pr As Object
    Dim dsumForAttach As Object
    On Error GoTo RDK_ATTACH_ERR
    m_runDiskDiag = "s1"
    RunDiskAttachDeferred root
    m_runDiskDiag = "s2"
    If g Is Nothing Then Set g = RunDiskEmptyGuard("", "", False)
    m_runDiskDiag = "s3"
    If g.Exists("auto") Then
        Set auto = g("auto")
        m_runDiskDiag = "s4"
        RunDiskMergePrim root, auto
    End If
    m_runDiskDiag = "s5"
    root("saveOnRun") = False
    If CBool(g("flushRan")) Then root("saveOnRun") = True
    root("saveOnRunReason") = ""
    If CBool(g("flushRan")) Then root("saveOnRunReason") = "mcp_pre_run_flush"
    root("allowDiskMutation") = CBool(g("allowDiskMutation"))
    root("dirtyBeforeRun") = CBool(g("dirty"))
    If CBool(g("dirtyUnknown")) Then root("dirtyUnknown") = True
    m_runDiskDiag = "s6"
    If g.Exists("dirtySummary") Then
        Set dsumForAttach = g("dirtySummary")
        If Not dsumForAttach Is Nothing Then Set root("dirty") = dsumForAttach
    End If
    m_runDiskDiag = "s7"
    Set fin = RunDiskFinishForReceipt(g)
    m_runDiskDiag = "s8"
    If fin.Exists("diskWrites") Then Set root("diskWrites") = fin("diskWrites")
    If fin.Exists("touchedFiles") Then Set root("touchedFiles") = fin("touchedFiles")
    If fin.Exists("diskSnapshot") Then Set root("diskSnapshot") = fin("diskSnapshot")
    m_runDiskDiag = "s9"
    If CBool(g("promptExpected")) Then
        root("savePromptExpected") = True
        root("savePromptPresent") = False
        root("savePromptObservation") = "not_observable_inside_the_call: the Start command is QUEUED on the IDE pump, so the save prompt (IDE option = Prompt) appears AFTER this receipt is sent; the next tools/call receipt carries savePromptPresent/startDialog"
        Set root("howToProceedSavePrompt") = RunDiskPromptHowTo()
    End If
    m_runDiskDiag = "s10"
    If CBool(g("deferredRestart")) Then
        Set ds = CreateObject("Scripting.Dictionary")
        ds("pending") = True
        ds("emittedInThisReceipt") = False
        ds("diskSnapshotRef") = CStr(g("deferredRef"))
        ds("startedAt") = ""
        ds("ideMode") = CStr(g("ideMode"))
        ds("ctxStored") = True
        ds("note") = "restart = End + a DEFERRED Start; the Start (and any IDE save it triggers) runs after this receipt. The next tools/call receipt completes it as deferredStart{...} (never silently dropped)."
        If root.Exists("deferredStart") Then Set root("deferredStartPrevious") = root("deferredStart")
        Set root("deferredStart") = ds
        Set m_runDiskDeferredPending = ds
        Set m_runDiskDeferredCtx = g
    End If
    m_runDiskDiag = "s11"
    If Not m_runPromptPending Is Nothing Then
        If CLng(m_runPromptPending("t0")) <> CLng(g("t0")) Then
            Set pr = RunDiskObservePendingPrompt()
            If CBool(pr("observed")) Then
                root("savePromptPresent") = True
                If pr.Exists("startDialog") Then Set root("startDialog") = pr("startDialog")
            Else
                If Not root.Exists("savePromptPresent") Then root("savePromptPresent") = False
                If pr.Exists("note") Then root("savePromptObservation") = CStr(pr("note"))
            End If
        End If
    End If
    m_runDiskDiag = ""
    Err.Clear
    Exit Sub
RDK_ATTACH_ERR:
    Dim diagStage As String
    diagStage = m_runDiskDiag
    m_runDiskDiag = "attach@" & diagStage & ":" & CStr(Err.Number) & ":" & Err.Description
    Err.Clear
    If Not root.Exists("saveOnRun") Then root("saveOnRun") = False
    If Not root.Exists("saveOnRunReason") Then root("saveOnRunReason") = ""
    If Not root.Exists("diskWrites") Then Set root("diskWrites") = EmptyJsonArray()
    If Not root.Exists("touchedFiles") Then Set root("touchedFiles") = EmptyJsonArray()
    If Not root.Exists("diskSnapshot") Then
        Set ds = CreateObject("Scripting.Dictionary")
        ds("taken") = False
        ds("basis") = "attach_error"
        Set root("diskSnapshot") = ds
    End If
    root("runDiskDiag") = m_runDiskDiag
End Sub

Public Sub RunDiskAttachPhase2(ByRef root As Object)
    Dim ds As Object
    Dim pr As Object
    On Error Resume Next
    RunDiskAttachDeferred root
    Set ds = CreateObject("Scripting.Dictionary")
    ds("taken") = False
    ds("basis") = "phase2_does_not_start: this call only OBSERVES an already-started program, so the IDE could not have auto-saved on this call"
    Set root("diskSnapshot") = ds
    If Not m_runPromptPending Is Nothing Then
        Set pr = RunDiskObservePendingPrompt()
        If CBool(pr("observed")) Then
            root("savePromptPresent") = True
            If pr.Exists("startDialog") Then Set root("startDialog") = pr("startDialog")
        Else
            If Not root.Exists("savePromptPresent") Then root("savePromptPresent") = False
            If pr.Exists("note") Then root("savePromptObservation") = CStr(pr("note"))
        End If
    End If
    Err.Clear
End Sub

Private Sub RunDiskCompleteDeferred()
    Dim p As Object
    Dim ctx As Object
    Dim res As Object
    Dim fin As Object
    Dim pr As Object
    On Error Resume Next
    If m_runDiskDeferredPending Is Nothing Then Exit Sub
    Set p = m_runDiskDeferredPending
    Set ctx = Nothing
    If Not m_runDiskDeferredCtx Is Nothing Then Set ctx = m_runDiskDeferredCtx
    If ctx Is Nothing Then
        If p.Exists("ctx") Then Set ctx = p("ctx")
    End If
    Set res = CreateObject("Scripting.Dictionary")
    res("pending") = False
    res("emittedInThisReceipt") = False
    res("startedAt") = CStr(p("startedAt"))
    res("diskSnapshotRef") = CStr(p("diskSnapshotRef"))
    res("ideMode") = CStr(p("ideMode"))
    If ctx Is Nothing Then
        Set res("diskWrites") = EmptyJsonArray()
        Set res("touchedFiles") = EmptyJsonArray()
        res("note") = "the deferred Start had no before-snapshot, so nothing can be compared"
    Else
        If ctx.Exists("finDone") Then ctx.Remove "finDone"
        If ctx.Exists("fin") Then ctx.Remove "fin"
        Set fin = RunDiskFinish(ctx)
        Set res("diskWrites") = fin("diskWrites")
        Set res("touchedFiles") = fin("touchedFiles")
        Set res("diskSnapshot") = fin("diskSnapshot")
        If CBool(ctx("promptExpected")) Then
            res("savePromptExpected") = True
            Set res("howToProceedSavePrompt") = RunDiskPromptHowTo()
        End If
    End If
    If Not m_runPromptPending Is Nothing Then
        Set pr = RunDiskObservePendingPrompt()
        If CBool(pr("observed")) Then
            res("savePromptPresent") = True
            If pr.Exists("startDialog") Then Set res("startDialog") = pr("startDialog")
        End If
    End If
    Set m_runDiskDeferredResult = res
    Set m_runDiskDeferredPending = Nothing
    Set m_runDiskDeferredCtx = Nothing
    Set m_runDiskPendingCtx = Nothing
    Err.Clear
End Sub

Private Function RunDiskDeferredSplice(ByVal outText As String) As String
    Dim js As String
    RunDiskDeferredSplice = outText
    On Error Resume Next
    If m_runDiskDeferredResult Is Nothing Then Exit Function
    If Len(outText) < 2 Then Exit Function
    If Left$(outText, 1) <> "{" Then Exit Function
    If Right$(outText, 1) <> "}" Then Exit Function
    js = JsonStringify(m_runDiskDeferredResult)
    If Len(js) < 2 Then Exit Function
    RunDiskDeferredSplice = Left$(outText, Len(outText) - 1) & "," & Chr$(34) & "deferredStart" & Chr$(34) & ":" & js & "}"
    Set m_runDiskDeferredResult = Nothing
    Err.Clear
End Function

' =====================================================================
' FIX-32 (WP-22-05 follow-up): it wrote the .vbp but the receipt said
' filesWritten:[]. Two tools write project files as a SIDE EFFECT of an IDE
' call and used to report nothing about it:
'   * set_project_options{description} - a VBIDE property put makes the IDE
'     mark the project dirty; the .vbp is then persisted by the IDE at the NEXT
'     project save, NOT necessarily inside this call. FIX-32 measured that on a
'     clean fixture the call itself wrote NOTHING (three probes: fixture46.vbp
'     stayed 735 B / 8122EADA..., modFix.bas stayed 198 B / 4B94856F...), while
'     a later save_project / build flush / injected-breakpoint save DID rewrite
'     it. So the book reports the empty result honestly instead of assuming
'     the earlier WP-22-05 observation, and still catches a real write;
'   * breakpoints{action:set|clear_all|enable|disable} - the injected
'     source-marker path ends in a project save, which rewrites the .vbp and/or
'     the component file (measured: same-millisecond mtimes).
'
' The book below is a READ-BACK comparison, not a promise: size + sha256 of the
' .vbp and of every project file are taken before and after the call, so
'   * a file whose CONTENT changed appears in diskWrites[] as
'     {file,beforeBytes,beforeSha,afterBytes,afterSha,reason,attribution};
'   * a file rewritten with IDENTICAL bytes appears in touchedFiles[] with
'     shaSame:true and BOTH mtimes;
'   * a call that moved nothing gets TWO EMPTY ARRAYS (entries are NEVER
'     invented).
' afterSha is the digest read from disk AFTER the call, so an external
' Get-FileHash matches it byte for byte.
' =====================================================================
Private Function F32VbpPath() As String
    Dim p As VBIDE.VBProject
    F32VbpPath = ""
    On Error Resume Next
    Set p = GetProject()
    If Not p Is Nothing Then
        If Len(CStr(p.FileName)) > 0 Then F32VbpPath = CStr(p.FileName)
    End If
    Err.Clear
End Function

' BEFORE half. A project with no .vbp on disk cannot be compared, so the
' returned context says WHY it was not taken instead of failing the tool call.
Public Function F32SnapBegin(ByVal why As String) As Object
    Dim ctx As Object
    Dim vbp As String
    Dim p As VBIDE.VBProject
    Dim files As Object
    Dim shaPaths As Object
    Dim meta As Object
    Dim snap As Object
    Set ctx = CreateObject("Scripting.Dictionary")
    ctx("taken") = False
    ctx("why") = why
    ctx("vbpPath") = ""
    ctx("basis") = ""
    Set F32SnapBegin = ctx
    On Error Resume Next
    vbp = F32VbpPath()
    If Len(vbp) = 0 Then
        ctx("basis") = "no_project_file: the project has no .vbp on disk, so there is nothing to compare"
        Err.Clear
        Exit Function
    End If
    If Dir$(vbp) = "" Then
        ctx("basis") = "project_file_missing: " & vbp & " is not on disk"
        Err.Clear
        Exit Function
    End If
    Set p = GetProject()
    Set files = Build.DiskProjectFilesEx(vbp, RunDiskIdeFiles(p))
    Set shaPaths = CreateObject("Scripting.Dictionary")
    shaPaths(LCase$(vbp)) = True
    Set meta = CreateObject("Scripting.Dictionary")
    Set snap = Build.DiskSnapTake(files, shaPaths, meta)
    If snap Is Nothing Then
        ctx("basis") = "before_snapshot_aborted: the before-snapshot did not finish"
        Err.Clear
        Exit Function
    End If
    ctx("taken") = True
    ctx("vbpPath") = vbp
    Set ctx("files") = files
    Set ctx("before") = snap
    Set ctx("metaBefore") = meta
    Err.Clear
End Function

' AFTER half: {diskWrites, touchedFiles, diskSnapshot, diskAttribution}.
Public Function F32SnapFinish(ByVal ctx As Object, ByVal why As String, ByVal attribution As String) As Object
    Dim out As Object
    Dim ds As Object
    Dim p As VBIDE.VBProject
    Dim files As Object
    Dim shaPaths As Object
    Dim meta2 As Object
    Dim after As Object
    Dim diff As Object
    Dim writes As Object
    Dim w As Object
    Dim i As Long
    Set out = CreateObject("Scripting.Dictionary")
    Set out("diskWrites") = EmptyJsonArray()
    Set out("touchedFiles") = EmptyJsonArray()
    Set ds = CreateObject("Scripting.Dictionary")
    ds("taken") = False
    ds("why") = why
    ds("attribution") = attribution
    ds("basis") = ""
    Set out("diskSnapshot") = ds
    out("diskAttribution") = attribution
    Set F32SnapFinish = out
    On Error Resume Next
    If ctx Is Nothing Then
        ds("basis") = "no_snapshot_context"
        Err.Clear
        Exit Function
    End If
    If Not CBool(ctx("taken")) Then
        ds("basis") = CStr(ctx("basis"))
        Err.Clear
        Exit Function
    End If
    Set p = GetProject()
    Set files = Build.DiskProjectFilesEx(CStr(ctx("vbpPath")), RunDiskIdeFiles(p))
    Set shaPaths = CreateObject("Scripting.Dictionary")
    shaPaths(LCase$(CStr(ctx("vbpPath")))) = True
    Set meta2 = CreateObject("Scripting.Dictionary")
    Set after = Build.DiskSnapTake(files, shaPaths, meta2)
    If after Is Nothing Then
        ds("basis") = "after_snapshot_aborted: the disk could not be read back, so no write is claimed"
        Err.Clear
        Exit Function
    End If
    Build.DiskSnapFillChanged ctx("before"), after
    Set diff = Build.DiskSnapDiff(ctx("before"), after, attribution)
    Set writes = diff("writes")
    For i = 1 To writes.Count
        Set w = writes.Item(i)
        w("reason") = why
        w("attribution") = attribution
    Next
    Set out("diskWrites") = writes
    Set out("touchedFiles") = diff("touched")
    ds("taken") = True
    ds("hashMode") = CStr(meta2("hashMode"))
    ds("budgetBytes") = CLng(meta2("budgetBytes"))
    ds("checkedFiles") = CLng(meta2("checkedFiles"))
    ds("filesTotal") = CLng(meta2("fileCount"))
    ds("bytesTotal") = meta2("totalBytes")
    ds("snapshotMs") = CLng(meta2("snapshotMs"))
    ds("vbpPath") = CStr(ctx("vbpPath"))
    ds("basis") = "read-back comparison: size+sha256 of the .vbp and every project file, taken before and after this call; diskWrites[] holds CONTENT changes, touchedFiles[] holds a rewrite with identical bytes (shaSame:true). No entry is added when nothing moved."
    If CStr(meta2("hashMode")) = "gated" Then
        ds("gatedNote") = "project above the full-hash budget: only the .vbp and the files whose size/mtime moved were hashed after the call; an un-taken digest is reported as an empty string plus a reason (beforeShaNote/afterShaNote), never invented"
    End If
    Err.Clear
End Function

' Put the book on a receipt dictionary (a tool that stringifies its own root
' AFTER the call uses this) and add the written paths to the additive
' sideEffects.filesWritten[] audit block.
Private Sub F32AttachBook(ByRef root As Object, ByVal book As Object)
    Dim writes As Object
    Dim i As Long
    On Error Resume Next
    If root Is Nothing Then Exit Sub
    If book Is Nothing Then Exit Sub
    If book.Exists("diskWrites") Then Set root("diskWrites") = book("diskWrites")
    If book.Exists("touchedFiles") Then Set root("touchedFiles") = book("touchedFiles")
    If book.Exists("diskSnapshot") Then Set root("diskSnapshot") = book("diskSnapshot")
    If book.Exists("diskAttribution") Then root("diskAttribution") = book("diskAttribution")
    If book.Exists("diskWrites") Then
        Set writes = book("diskWrites")
        If Not writes Is Nothing Then
            For i = 1 To writes.Count
                ManifestAdd m_seFiles, CStr(writes.Item(i)("file"))
            Next
        End If
    End If
    Err.Clear
End Sub

' Put the book on an ALREADY STRINGIFIED receipt (breakpoints builds its text
' inside the per-action function, so the write happens there). The fields are
' spliced into the trailing brace, the same way RunDiskDeferredSplice does it.
Public Function F32SpliceBook(ByVal outText As String, ByVal book As Object) As String
    Dim js As String
    F32SpliceBook = outText
    On Error Resume Next
    If book Is Nothing Then Exit Function
    If Len(outText) < 2 Then Exit Function
    If Left$(LTrim$(outText), 1) <> "{" Then Exit Function
    If Right$(outText, 1) <> "}" Then Exit Function
    If InStr(1, outText, Chr$(34) & "diskWrites" & Chr$(34), vbTextCompare) > 0 Then Exit Function
    js = JsonStringify(book)
    If Len(js) < 3 Then Exit Function
    F32SpliceBook = Left$(outText, Len(outText) - 1) & "," & Mid$(js, 2)
    Err.Clear
End Function

Public Function ToolControlExecution(ByVal mode As String, Optional ByVal allowDiskMutation As Boolean = False) As String
    Dim m As String
    m = LCase$(mode)
    ' contract v1.16.0 (measured): END/STOP while the program RUNS has a WORKING path. DbClickEnd()
    ' returns TRUE in run state and really stops the program (probe confirm legs V1/V2/V4), so the
    ' old pre-check refusal (commandbars_unavailable_while_running) was a FALSE rejection for
    ' end/stop. Route exactly those two modes through the measured path; every other mode keeps
    ' the refusal, because its CommandBars use is not measured safe while running.
    If (m = "end" Or m = "stop") And IdeEbMode() = 1 Then
        ToolControlExecution = RunStateEndJson(m)
        Exit Function
    End If
    Dim cbR As Object
    If CmdBarsRunRefusal("control_execution", cbR) Then
        ToolControlExecution = JsonStringify(cbR)
        Exit Function
    End If

    ' R-1021-05: a MODAL runtime-error box must be resolved BEFORE any CommandBars call.
    ' Measured: with the box up, End executed but the IDE stayed in "run"
    ' (ok=false / reason=state_not_changed / before=after=run, ~12 s) and the End command
    ' may be QUEUED. The probe here is Win32-only (this process's own windows); on a hit
    ' the dedicated path runs and returns WITHOUT ever touching CommandBars while the box
    ' is up, and the dialog's End/Continue captions are never clicked.
    If m = "end" Or m = "stop" Or m = "restart" Then
        Dim rePre As Object
        Set rePre = McpRe.ReFindRuntimeErrorDialog(Me)
        If Not rePre Is Nothing Then
            ' WP-22-02: with a modal runtime-error box up, CommandBars QUEUE (measured 12 s) -
            ' so a CommandBars-driven resolve is NOT bounded. Answer structured instead and let the
            ' caller dismiss the box through the dedicated (message-based) channel first.
            Dim cbD As Object
            Set cbD = CreateObject("Scripting.Dictionary")
            cbD("tool") = "control_execution"
            cbD("mode") = m
            cbD("ok") = False
            cbD("executed") = False
            cbD("state") = "runtime_error"
            cbD("reason") = "commandbars_command_not_delivered"
            cbD("commandBarsTouched") = False
            cbD("blockedBy") = "runtime_error_dialog"
            cbD("boundedMs") = CB_CMD_DEADLINE_MS
            Set cbD("runtimeErrorDialog") = McpRe.ReDialogInfoBlock(Me, rePre)
            Dim cbSteps As Object
            Set cbSteps = New Collection
            cbSteps.Add "runtime_error_dialog_detected"
            cbSteps.Add "commandBars_delivery_skipped (it would queue behind the modal box)"
            Set cbD("attemptedSteps") = cbSteps
            cbD("howToProceed") = "a modal VB6 runtime-error box owns the IDE thread and CommandBars QUEUE behind it (measured 12 s): dismiss the box first with last_error{dismiss:true} (or send_window_message clicking End), then retry control_execution{end}."
            ToolControlExecution = JsonStringify(cbD)
            Exit Function
            Exit Function
        End If
    Else
        ' R-1021-05: EVERY other mode (run / continue / step*) would reach CommandBars,
        ' and with the modal runtime-error box up those commands QUEUE (measured). This is
        ' therefore a structured, NON-executing failure: the box is not clicked and no
        ' CommandBars call is made.
        Dim rePre2 As Object
        Set rePre2 = McpRe.ReFindRuntimeErrorDialog(Me)
        If Not rePre2 Is Nothing Then
            Dim blkRoot As Object
            Set blkRoot = CreateObject("Scripting.Dictionary")
            blkRoot("tool") = "control_execution"
            blkRoot("mode") = m
            blkRoot("ok") = False
            blkRoot("executed") = False
            blkRoot("state") = "runtime_error"
            blkRoot("stateBefore") = "runtime_error"
            blkRoot("reason") = "blocked_by_runtime_error_dialog"
            blkRoot("notExecuted") = True
            blkRoot("modeNotRun") = m
            blkRoot("resolvedRuntimeErrorDialog") = False
            blkRoot("errorBreakPending") = True
            Set blkRoot("runtimeErrorDialog") = McpRe.ReDialogInfoBlock(Me, rePre2)
            blkRoot("advice") = "a modal VB6 runtime-error box is up: this mode would reach CommandBars, which QUEUES while the box owns the IDE thread, so NOTHING was executed and NO caption was clicked. Resolve the box first - last_error{dismiss:true} reads it, clicks DEBUG and measures EbMode; control_execution{end} resolves it and ends the run; ide_state reports state=runtime_error with errorBreakPending=true."
            RunDiskAttach blkRoot, Nothing, False, "runtime_error"
            ToolControlExecution = JsonStringify(blkRoot)
            Exit Function
        End If
    End If
    ' (P4 D7): inputSchema advertises "run (start, or continue when
    ' already broken)", but the code took the design path, whose mandatory pre-run
    ' "save the project" step the IDE REFUSES in break state (measured:
    '   拒绝的权限), so run was unusable exactly where it was documented to work.
    ' While broken the menu item is Continue, so go straight there.
    If m = "run" Then
        If GetIdeState() = "break" Then m = "continue"
    End If
    ' ---- R-1021-02: informed-consent gate + BEFORE snapshot -----------------
    ' The BEFORE snapshot is taken HERE, before the run/full_compile pre-run
    ' flush below, so the flush's own writes are inside the compared window.
    Dim rdkFlush As Boolean
    Dim rdkStart As Boolean
    Dim rdkSt0 As String
    Dim rdkG As Object
    rdkFlush = (m = "run" Or m = "full_compile" Or m = "fullcompile")
    rdkStart = (rdkFlush Or m = "step_into" Or m = "stepinto" Or m = "step_over" Or m = "stepover" Or m = "step_out" Or m = "stepout" Or m = "run_to_cursor" Or m = "runtocursor" Or m = "restart")
    rdkSt0 = GetIdeState()
    Set rdkG = Nothing
    If rdkStart Then
        Set rdkG = RunDiskGuardBegin("control_execution", m, rdkSt0, True, rdkFlush, allowDiskMutation, (m = "restart"))
        If CBool(rdkG("refused")) Then
            ToolControlExecution = JsonStringify(rdkG("payload"))
            Exit Function
        End If
    End If
    ' (the dry-run review restart): "restart" is deliberately NOT part of this pre-run FLUSH.
    ' A restart is End + a DEFERRED Start (m_server.RequestRestart -> McpServer.ConsumeRestart
    ' -> McpServer.DoRestart -> CodeTools.DoDeferredStart, which only clicks Start), and it is
    ' issued exactly WHILE THE PROGRAM IS RUNNING - which is precisely when the full
    ' save_project path below CANNOT work: in run mode the IDE refuses every source write with
    ' the localized "permission denied", so the flush raised
    ' "Could not save the project before running: <denied>" and the caller got
    ' {ok:false, reason:"ide_busy_in_run_mode"} instead of the documented restartPending:true
    ' (measured 2026-10-15; tests/battery_test.py expects restartPending).
    ' WHERE THE PERSISTENCE GUARANTEE STILL COMES FROM (so nothing is silently lost): a
    ' restart can only follow a run, and run/full_compile BOTH still go through this flush
    ' (unchanged below), which writes the .vbp and every component through ToolSaveProject.
    ' The design-time project is FROZEN while the program runs, so a restart cannot introduce
    ' new unsaved edits - the on-disk project is already at least as new as the one being
    ' restarted, and the deferred Start has nothing left to persist. The FileName guard below
    ' still applies to run/full_compile exactly as before.
    If m = "run" Or m = "full_compile" Or m = "fullcompile" Then
        ' Running an unsaved project makes VB6 pop a modal Save dialog which
        ' blocks the IDE and the MCP server. Saving only the .vbp is NOT enough:
        ' a component that has never been written to disk still makes the IDE
        ' open "文件另存为" (measured 2026-09-21: the run stalls with a modal
        ' dialog and the caller sees only "mode=run, state=design"), so flush
        ' everything through the same path save_project uses.
        Dim sp As VBIDE.VBProject
        Set sp = GetProject()
        If Len(sp.FileName) = 0 Then
            Err.Raise vbObjectError + 41, "CodeTools", "Project has no file name: running would open VB6's Save dialog. Call save_project with a path first, then retry."
        End If
        Dim saveJson As String
        Dim svErr As Long
        Dim svDesc As String
        saveJson = ""
        svErr = 0
        svDesc = ""
        On Error Resume Next
        saveJson = ToolSaveProject("")
        svErr = Err.Number
        svDesc = Err.Description
        Err.Clear
        On Error GoTo 0
        If svErr <> 0 Then Err.Raise vbObjectError + 41, "CodeTools", "Could not save the project before running: " & svDesc
        OpLog "control_execution " & m & ": pre-run flush " & Left$(saveJson, 200)
        ' R-1021-02: remember WHAT the pre-run flush wrote, so the disk diff can
        ' attribute mcp_pre_run_flush vs ide_auto_save instead of guessing.
        If Not rdkG Is Nothing Then
            Dim rdkFp As Object
            Dim rdkV As Variant
            Dim rdkW As Variant
            Set rdkFp = CreateObject("Scripting.Dictionary")
            If Len(saveJson) > 0 Then
                If JsonParse(saveJson, rdkV) Then
                    On Error Resume Next
                    If IsObject(rdkV) Then
                        If rdkV.Exists("projectDirWrites") Then
                            For Each rdkW In rdkV("projectDirWrites")
                                rdkFp(LCase$(CStr(rdkW))) = True
                            Next
                        End If
                    End If
                    Err.Clear
                End If
            End If
            Set rdkG("flushPaths") = rdkFp
            rdkG("flushRan") = True
        End If
    End If
    Dim ctrl As Object
    Dim execCount As Long
    Dim whyExec As String
    execCount = 0
    ' remember the state BEFORE the command so the response can prove a
    ' transition instead of reporting a stale snapshot.
    Dim beforeState As String
    m_stateRecovered = False
    beforeState = GetIdeState()

    ' R-1021-05: Start / Start With Full Compile / Restart begin a NEW run, so a cache
    ' captured from the previous run is STALE and is invalidated HERE. (A "run" that
    ' happens while broken was rewritten to "continue" at the top of this function, so
    ' a Continue from the captured break never reaches this line.)
    If m = "run" Or m = "full_compile" Or m = "fullcompile" Or m = "restart" Then
        McpRe.ReInvalidateRuntimeError Me, "new_run_started"
    End If
    ' WP-22-02: bound the delivery attempt. The gate is armed for CB_CMD_DEADLINE_MS so a hung
    ' CommandBars.Execute cannot hold the single-flight gate for seconds; liveness is checked with
    ' a bounded probe first, and an unresponsive host answers structured instead of executing.
    Dim cbLive As Object
    Set cbLive = WinOps.WoHostLiveness(CB_CMD_DEADLINE_MS)
    If Not CBool(cbLive("responds")) Then
        Dim cbU As Object
        Set cbU = CreateObject("Scripting.Dictionary")
        cbU("tool") = "control_execution"
        cbU("mode") = m
        cbU("ok") = False
        cbU("executed") = False
        cbU("state") = GetIdeState()
        cbU("reason") = "commandbars_command_not_delivered"
        cbU("commandBarsTouched") = False
        cbU("boundedMs") = CB_CMD_DEADLINE_MS
        Set cbU("hostProbe") = cbLive
        Dim cbU2 As Object
        Set cbU2 = New Collection
        cbU2.Add "host_liveness_probe"
        Set cbU("attemptedSteps") = cbU2
        cbU("howToProceed") = "the IDE did not answer a bounded liveness probe, so no command was sent. Wait for it to settle (or restart the IDE), then retry."
        ToolControlExecution = JsonStringify(cbU)
        Exit Function
    End If
    ArmGateRelease "control_execution", CB_CMD_DEADLINE_MS
    Dim cbT0 As Long
    cbT0 = Util.TickMs()
    If m = "restart" Then
        Set ctrl = McpFindTools.FindCmd(Me, "end", "Debug|Run|" & ChrW$(&H8C03) & ChrW$(&H8BD5) & "|" & ChrW$(&H8FD0) & ChrW$(&H884C), "End|" & ChrW$(&H7ED3) & ChrW$(&H675F))
        If ctrl Is Nothing Then Set ctrl = m_cachedEnd Else Set m_cachedEnd = ctrl
        If ctrl Is Nothing Then Err.Raise vbObjectError + 41, "CodeTools", "Menu command not found: End"
        execCount = execCount + ExecIfEnabled(ctrl, m)
        ' the End teardown completes on the IDE message pump only after
        ' this response is sent; arm a deferred Start instead of
        ' clicking Start right away (it would still be disabled)
        If Not m_server Is Nothing Then m_server.RequestRestart
    Else
        Dim cands As String
        Dim barCands As String
        Select Case m
            Case "run"
                ' Start (design state) or Continue (already running or broken):
                ' the localized IDE renames the item, so try both captions.
                cands = "Start|" & ChrW$(&H542F) & ChrW$(&H52A8) & "|Continue|" & ChrW$(&H7EE7) & ChrW$(&H7EED)
                barCands = "Debug|Run|" & ChrW$(&H8C03) & ChrW$(&H8BD5) & "|" & ChrW$(&H8FD0) & ChrW$(&H884C)
            Case "continue", "resume"
                cands = "Continue|" & ChrW$(&H7EE7) & ChrW$(&H7EED)
                barCands = "Debug|Run|" & ChrW$(&H8C03) & ChrW$(&H8BD5) & "|" & ChrW$(&H8FD0) & ChrW$(&H884C)
            Case "step_into", "stepinto"
                cands = "Step Into|" & ChrW$(&H9010) & ChrW$(&H8BED) & ChrW$(&H53E5)
                barCands = "Debug|Run|" & ChrW$(&H8C03) & ChrW$(&H8BD5) & "|" & ChrW$(&H8FD0) & ChrW$(&H884C)
            Case "step_over", "stepover"
                cands = "Step Over|" & ChrW$(&H9010) & ChrW$(&H8FC7) & ChrW$(&H7A0B)
                barCands = "Debug|Run|" & ChrW$(&H8C03) & ChrW$(&H8BD5) & "|" & ChrW$(&H8FD0) & ChrW$(&H884C)
            Case "step_out", "stepout"
                cands = "Step Out|" & ChrW$(&H8DF3) & ChrW$(&H51FA)
                barCands = "Debug|Run|" & ChrW$(&H8C03) & ChrW$(&H8BD5) & "|" & ChrW$(&H8FD0) & ChrW$(&H884C)
            Case "run_to_cursor", "runtocursor"
                cands = "Run To Cursor|" & ChrW$(&H8FD0) & ChrW$(&H884C) & ChrW$(&H5230) & ChrW$(&H5149) & ChrW$(&H6807) & ChrW$(&H5904)
                barCands = "Debug|Run|" & ChrW$(&H8C03) & ChrW$(&H8BD5) & "|" & ChrW$(&H8FD0) & ChrW$(&H884C)
            Case "full_compile", "fullcompile"
                cands = "Start With Full Compile|" & ChrW$(&H5168) & ChrW$(&H7F16) & ChrW$(&H8BD1) & ChrW$(&H6267) & ChrW$(&H884C)
                barCands = "Run|Menu Bar|" & ChrW$(&H8FD0) & ChrW$(&H884C) & "|" & ChrW$(&H83DC) & ChrW$(&H5355) & ChrW$(&H6761)
            Case "break"
                cands = "Break|" & ChrW$(&H4E2D) & ChrW$(&H65AD)
                barCands = "Debug|Run|" & ChrW$(&H8C03) & ChrW$(&H8BD5) & "|" & ChrW$(&H8FD0) & ChrW$(&H884C)
            Case "end", "stop"
                cands = "End|" & ChrW$(&H7ED3) & ChrW$(&H675F)
                barCands = "Debug|Run|" & ChrW$(&H8C03) & ChrW$(&H8BD5) & "|" & ChrW$(&H8FD0) & ChrW$(&H884C)
            Case Else
                Err.Raise vbObjectError + 41, "CodeTools", "Invalid mode: " & mode
        End Select
        Set ctrl = McpFindTools.FindCmd(Me, m, barCands, cands)
        If ctrl Is Nothing Then
            Select Case m
                Case "run": Set ctrl = m_cachedStart
                Case "break": Set ctrl = m_cachedBreak
                Case "end", "stop": Set ctrl = m_cachedEnd
                Case "full_compile", "fullcompile": Set ctrl = m_cachedFull
                Case "step_into", "stepinto": Set ctrl = m_cachedStepInto
                Case "step_over", "stepover": Set ctrl = m_cachedStepOver
                Case "step_out", "stepout": Set ctrl = m_cachedStepOut
                Case "run_to_cursor", "runtocursor": Set ctrl = m_cachedRtc
            End Select
        End If
        ' Card fallback 2: FindBarControl filters bars by the localized,
        ' state-dependent bar NAME and descends ONE popup level only. Walk every
        ' CommandBar recursively by caption before giving up.
        If ctrl Is Nothing Then Set ctrl = McpFindTools.FindBarControlDeep(Me, cands)
        If Not ctrl Is Nothing Then
            Select Case m
                Case "run": Set m_cachedStart = ctrl
                Case "break": Set m_cachedBreak = ctrl
                Case "end", "stop": Set m_cachedEnd = ctrl
                Case "full_compile", "fullcompile": Set m_cachedFull = ctrl
                Case "step_into", "stepinto": Set m_cachedStepInto = ctrl
                Case "step_over", "stepover": Set m_cachedStepOver = ctrl
                Case "step_out", "stepout": Set m_cachedStepOut = ctrl
                Case "run_to_cursor", "runtocursor": Set m_cachedRtc = ctrl
            End Select
        End If
        ' 'continue' does not exist in the Debug menu in design
        ' state at all (the IDE shows Start, not Continue), so the lookup failed and
        ' the tool raised a bare "Menu command not found" - exactly the opaque symptom
        ' this card is about. Every mode now answers with the same structured failure
        ' instead of aborting, and names the captions that were searched.
        If ctrl Is Nothing Then
            Dim nf As Object
            Set nf = CreateObject("Scripting.Dictionary")
            nf("mode") = m
            nf("executed") = False
            nf("reason") = "not_found"
            nf("candidates") = cands
            nf("state") = GetIdeState()
            ToolControlExecution = JsonStringify(nf)
            Exit Function
        End If
        execCount = ExecIfEnabledWhy(ctrl, m, whyExec)
        ' (D3) a suspended CommandBars window (post-run) makes these items look disabled while
        ' nothing is running. Clear it ONCE and retry ONCE; the receipt records the recovery.
        If execCount = 0 And InStr(1, whyExec, "disabled", vbTextCompare) > 0 Then
            If m = "run" Or m = "continue" Or m = "resume" Or m = "break" Or m = "step_into" Or m = "step_over" Or m = "step_out" Or m = "run_to_cursor" Then
                Dim nr2 As Object
                Set nr2 = McpDb.DbNudgeBarsOut(Me)
                If CBool(nr2("attempted")) Then
                    Set ctrl = Nothing
                    Set ctrl = McpFindTools.FindCmd(Me, m, barCands, cands)
                    If ctrl Is Nothing Then Set ctrl = McpFindTools.FindBarControlDeep(Me, cands)
                    If Not ctrl Is Nothing Then
                        whyExec = ""
                        execCount = ExecIfEnabledWhy(ctrl, m, whyExec)
                        m_stateRecovered = CBool(nr2("recovered"))
                    End If
                End If
            End If
        End If
    End If
    ' ---- R-1021-02: bounded wait for the QUEUED Start to be processed --------
    ' Without it the AFTER snapshot would be taken before the IDE saved anything.
    ' SKIPPED when a dirty Start may raise the IDE's MODAL save prompt
    ' (option = Prompt/unknown): pumping into that modal loop would hang this call.
    If execCount > 0 And Not rdkG Is Nothing Then
        If CBool(rdkG("startCmd")) Then
            Dim rdkSkip As Boolean
            Dim rdkDirtyNow As Boolean
            Dim rdkTw As Long
            Dim rdkJunk As String
            Dim rdkAtt As Long
            Dim rdkPmp As Boolean
            rdkSkip = CBool(rdkG("promptExpected"))
            rdkDirtyNow = CBool(rdkG("dirty"))
            If rdkFlush Then
                If CBool(rdkG("flushRan")) Then rdkDirtyNow = False
            End If
            If rdkDirtyNow Then
                If CStr(rdkG("ideMode")) = "prompt" Or CStr(rdkG("ideMode")) = "unknown" Then rdkSkip = True
            End If
            If Not rdkSkip Then
                rdkTw = GetTickCount()
                rdkJunk = WaitIdeLeave(rdkSt0, RUNSNAP_START_WAIT_MS, rdkAtt, rdkPmp)
                rdkG("waitMs") = GetTickCount() - rdkTw
                rdkG("waitAttempts") = rdkAtt
                rdkG("waitPumped") = rdkPmp
            End If
        End If
    End If
    ' break/end/stop: yield so the debug toolbar reflects the new
    ' state. run/full_compile/restart: DoEvents would block inside
    ' the running app's modal message loop and the RPC response
    ' would never be sent, so return immediately after Execute.
    ' single steps are short: yield so the IDE reflects the new line.
    ' run/continue/run_to_cursor may run the app for a long time - DoEvents
    ' would block inside the app message loop and the RPC response would
    ' never be sent, so those return immediately after Execute.
    ' the Run/Debug menu command is processed ASYNCHRONOUSLY on the IDE
    ' message pump, so ONE DoEvents is not enough. Measured on a DoEvents loop: end
    ' answered {executed:true, state:"run"} while an independent ide_state probe ~2s
    ' later was already "design" - the command had worked, the receipt was stale. Poll
    ' for the transition (bounded) and never claim success when the state never moves.
    Dim expectChange As Boolean
    expectChange = (m = "break" Or m = "end" Or m = "stop" Or m = "restart")
    Dim afterState As String
    Dim endPollAttempts As Long
    Dim endPollPumped As Boolean
    Dim endPollElapsed As Long
    Dim endPollT0 As Long
    afterState = GetIdeState()
    If expectChange And execCount > 0 Then
        endPollT0 = GetTickCount()
        afterState = WaitIdeLeave(beforeState, CB_CMD_STATE_WAIT_MS, endPollAttempts, endPollPumped)
        endPollElapsed = GetTickCount() - endPollT0
    End If
    DisarmGateRelease
    Dim cbOver As Boolean
    cbOver = ((Util.TickMs() - cbT0) > CB_CMD_DEADLINE_MS)
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("mode") = m
    root("executed") = (execCount > 0)
    root("stateBefore") = beforeState
    ' break answered {"executed":false} with no reason at all, so a
    ' caller could not tell "already broken" from "the item is disabled".
    If execCount = 0 Then
        If Len(whyExec) > 0 Then
            root("reason") = whyExec
        ElseIf m = "break" And GetIdeState() = "break" Then
            root("reason") = "already_broken"
        Else
            root("reason") = "not_executed"
        End If
        ' (D3) an End/Stop that finds NOTHING running is a SUCCESS, not a failure. In the
        ' post-run suspended window the End item is disabled precisely BECAUSE the program has
        ' already ended (measured: EbMode=0, 0% CPU, End disabled, the old state read said run).
        If (m = "end" Or m = "stop") And IdeEbMode() = 0 And GetIdeState() = "design" Then
            root("ok") = True
            root("state_not_changed") = True
            root("alreadyNotRunning") = True
            root("reason") = "already_not_running"
            root("programEnded") = True
            root("endPending") = False
            root("endCommandDelivered") = False
            root("stateAfterVerifiedBy") = "ide_state"
            root("stateAfterReadBack") = afterState
            root("deliveryVsStateNote") = "nothing was running (measured: EbMode=0 and design), so no End command was delivered; programEnded=true is a MEASURED state statement, not a delivery claim."
        End If
    End If
    On Error Resume Next
    root("caption") = ctrl.Caption
    On Error GoTo 0
    If m = "restart" Then root("restartPending") = True
    root("state") = afterState
    If m_stateRecovered Then root("stateRecovered") = True
    ' FIX-6: the wait is MEASURABLE from the receipt (measured values, never hard-coded).
    root("endPollPumped") = endPollPumped
    root("endPollMs") = endPollElapsed
    If McpRe.RePollSane(Me, endPollAttempts, endPollElapsed) Then
        root("endPollAttempts") = endPollAttempts
    Else
        root("endPollAttemptsSuspect") = True
        root("endPollAttemptsRaw") = endPollAttempts
        root("endPollNote") = "counter failed sanity check (average < 10 ms per poll): the wait may have regressed to a busy loop - do not trust endPollAttempts"
    End If
    ' (receipt honesty, same discipline as the A batch): a menu item that was
    ' found and executed is NOT proof that the IDE changed state. If a command that must
    ' change the state did not, say so structurally instead of reporting executed:true.
    If expectChange And execCount > 0 And afterState = beforeState Then
        ' ok/reason/state_not_changed semantics are DELIBERATELY unchanged: clients may
        ' already branch on them. FIX-6 only adds the "queued but not observed" layer.
        root("ok") = False
        root("reason") = "commandbars_command_not_delivered"
        root("commandBarsTouched") = True
        root("boundedMs") = CB_CMD_DEADLINE_MS
        root("deliveryBudgetOverrun") = cbOver
        Dim cbAt As Object
        Set cbAt = New Collection
        cbAt.Add "find_commandbar(caption candidates resolved)"
        cbAt.Add "execute_commandbar"
        cbAt.Add "bounded_state_wait(" & CStr(CB_CMD_STATE_WAIT_MS) & " ms)"
        Set root("attemptedSteps") = cbAt
        root("howToProceed") = "the IDE accepted the command but did not leave state " & beforeState & " within " & CStr(CB_CMD_STATE_WAIT_MS) & " ms. If a modal runtime-error box is up, dismiss it first (last_error{dismiss:true} / send_window_message) and retry; if the debugger is paused at a breakpoint use continue/step instead of end."
        root("before") = beforeState
        root("after") = afterState
        root("advice") = "the IDE did not leave state '" & beforeState & "' within the bounded wait. MEASURED: this is NOT a missing pump - the wait loop pumps (endPollPumped/endPollAttempts say so) and the command IS processed, but the design transition is only observable AFTER this call returns (measured: ide_state is design ~2 s later). Re-probe with ide_state."
        ' contract v1.16.0: DELIVERY and STATE are two observations and must not look like one
        ' field contradicting another. A command not observed inside the bounded wait is NOT
        ' proof that it was not applied, so re-read with a pumped settle and publish BOTH: the
        ' command was not observed (endCommandDelivered=false) and what the read-back says
        ' (stateAfterVerifiedBy=ide_state + programEnded). ok/reason are deliberately NOT turned
        ' into success - this is honesty, not cosmetics.
        Dim cbReRead As String
        Dim cbReSrc As String
        Dim cbReBars As Boolean
        Dim cbReStreak As Long
        Dim cbReDeadline As Long
        cbReRead = afterState
        cbReSrc = ""
        cbReBars = False
        cbReStreak = 0
        cbReDeadline = Util.TickMs() + 3000
        Do
            cbReRead = GetIdeStateEx(cbReSrc, cbReBars)
            If LCase$(cbReRead) = "design" Then cbReStreak = cbReStreak + 1 Else cbReStreak = 0
            If cbReStreak >= 3 Then Exit Do
            If Util.TickMs() >= cbReDeadline Then Exit Do
            If CanPump() Then DoEvents
            McpDb.DbBriefWait Me, 50
        Loop
        root("endCommandDelivered") = False
        root("stateAfterReadBack") = cbReRead
        root("stateAfterReadBackSource") = cbReSrc
        root("stateAfterReadBackDesignStreak") = cbReStreak
        root("stateAfterVerifiedBy") = "ide_state"
        root("programEnded") = (cbReStreak >= 3)
        root("deliveryVsStateNote") = "endCommandDelivered=false is about the COMMAND (not observed in the bounded wait); programEnded/stateAfterReadBack is about the STATE (measured by read-back). MEASURED: the End teardown can become visible only after this call returns, so the late read-back is the honest answer - ok/reason stay as not-delivered on purpose."
    End If
    If execCount > 0 And (m = "end" Or m = "stop" Or m = "restart") Then
        If afterState = "design" Then
            root("endQueued") = False
            root("confirmed") = True
            root("confirmedBy") = "ideState_poll"
        Else
            ' FIX-6 additive pending shape - ok / reason are NOT touched.
            root("endQueued") = True
            root("confirmed") = False
            root("confirmedBy") = ""
            root("howToConfirm") = "ide_state"
            Dim genFin As Object
            Set genFin = New Collection
            genFin.Add "call ide_state (read-only) - it will report the state AFTER the IDE command dispatch; measured: design appears ~2 s after this call returns, never inside it"
            Set root("howToFinish") = genFin
        End If
    End If
    If root.Exists("endPollAttemptsSuspect") Then
        If CBool(root("endPollAttemptsSuspect")) Then
            If root.Exists("advice") Then root("advice") = CStr(root("advice")) & " " & CStr(root("endPollNote"))
        End If
    End If
    ' ---- R-1021-02: fixed receipt block on EVERY mode ------------------------
    RunDiskAttach root, rdkG, (execCount > 0), afterState
    ToolControlExecution = JsonStringify(root)
End Function

' FIX-6b: a bounded poll WITH a sleep. Single source of truth for the "impossible value"
' guard: a sleeping poll costs >= ~10 ms per iteration, so attempts > elapsedMs/10 + 2
' means the loop was busy-spinning (no sleep) or the counter is polluted.

' pump the message loop until the IDE leaves fromState (bounded).
Private Function WaitIdeLeave(ByVal fromState As String, ByVal timeoutMs As Long, ByRef pollAttempts As Long, ByRef pumped As Boolean) As String
    ' FIX-6: this loop ALREADY pumps (measured question: is the missing design proof a
    ' missing pump? NO). The two ByRef outputs exist so the receipt can PROVE whether a
    ' pump actually happened and how many polls were taken - they are measured, not
    ' assumed. The pump/abort logic itself is unchanged.
    Dim t0 As Long, s As String
    pollAttempts = 0
    pumped = False
    t0 = GetTickCount()
    s = GetIdeState()
    Do While s = fromState And (GetTickCount() - t0) < timeoutMs
        ' guarded - a host modal box up means the pump would wedge instead of
        ' letting the IDE change state, and the receipt already says so honestly.
        If CanPump() Then
            DoEvents
            pumped = True
        End If
        ' FIX-6b: SLEEP between polls. Measured defect: the old tight DoEvents loop spun
        ' ~8 us per iteration and logged 1,475,903 polls in a 12 s wait (a full core), and
        ' the number looked impossible in the receipt. 50 ms per iteration keeps the same
        ' timeout semantics (~240 polls in 12 s) at negligible CPU.
        McpDb.DbBriefWait Me, 50
        ' the cooperative abort is honoured HERE, at a pump point
        ' of the in-flight call (a re-entrant ide_state{cancel_inflight:true} set the flag).
        MaybeHonorCancel
        If Util.PumpAbortDue() Then Exit Do
        s = GetIdeState()
        pollAttempts = pollAttempts + 1
    Loop
    WaitIdeLeave = s
End Function

' ---------------------------------------------------------------------
' native IDE breakpoint (Debug menu; does not modify any source file)
' ---------------------------------------------------------------------
Public Function BreakpointLocationProblem(ByVal comp As String, ByVal line As Long, _
                                           ByRef outKind As String, ByRef outWhy As String, _
                                           ByRef outText As String) As String
    ' Returns "" when the position can hold a breakpoint, else a short reason code.
    ' VB6 refuses breakpoints in "some regions": blank lines, comment lines and the
    ' declaration section. Asking anyway aimed the IDE at a position it will not
    ' accept, and the request died with the connection closed and no reply.
    '
    ' an earlier fix (defect #11): the reasons are now split into two classes and
    ' the caller MUST be able to tell them apart:
    '   * EXACT   - component_not_found / no_code_module / line_out_of_range /
    '               blank_line / comment_line / declaration_section. VB6 itself computes
    '               these through the code-module API (CountOfDeclarationLines, Lines).
    '   * HEURISTIC - breakpoint_not_allowed_on_line, with outKind naming the class:
    '               continuation_line / procedure_header / procedure_footer /
    '               attribute_line / declaration_statement. These are LANGUAGE-LEVEL
    '               facts about VB6, NOT a query: the extensibility model exposes no
    '               breakpoint API and no "can I break here?" call, so this is a
    '               conservative PRE-FILTER and it says so in the receipt
    '               (heuristic:true). It can only ever REFUSE a line; a line it accepts
    '               may still be refused by the IDE, and that residue is covered by the
    '               bounded modal guard in WinOps (MODAL_GUARD_WAIT_MS).
    ' WHY CONSERVATIVE ERRORS TOWARD REFUSAL: refusing a line VB6 would have accepted
    ' costs the caller one retry; letting VB6 refuse it used to cost the whole session's
    ' write path (measured: the Debug-menu toggle hung ~1 minute behind a modal "this
    ' line cannot hold a breakpoint" box and every later write answered reason=busy -
    ' A11 section 4).
    On Error Resume Next
    If Len(comp) = 0 Then Exit Function
    Dim c As VBIDE.VBComponent
    Set c = McpFindTools.FindComponent(Me, comp)
    If c Is Nothing Then
        BreakpointLocationProblem = "component_not_found"
        Exit Function
    End If
    Dim cm As VBIDE.CodeModule
    Set cm = c.CodeModule
    If cm Is Nothing Then
        BreakpointLocationProblem = "no_code_module"
        Exit Function
    End If
    If line < 1 Or line > cm.CountOfLines Then
        BreakpointLocationProblem = "line_out_of_range"
        Exit Function
    End If
    If line <= cm.CountOfDeclarationLines Then
        BreakpointLocationProblem = "declaration_section"
        Exit Function
    End If
    Dim txt As String
    txt = Trim$(cm.Lines(line, 1))
    outText = txt
    If Len(txt) = 0 Then
        BreakpointLocationProblem = "blank_line"
        Exit Function
    End If
    If Left$(txt, 1) = "'" Then
        BreakpointLocationProblem = "comment_line"
        Exit Function
    End If
    If LCase$(Left$(txt, 4)) = "rem " Or LCase$(txt) = "rem" Then
        BreakpointLocationProblem = "comment_line"
        Exit Function
    End If
    ' ---- an earlier fix (defect #11): the HEURISTIC pre-filter -----------
    Dim lo As String
    lo = LCase$(txt)
    ' A procedure can carry an access modifier, and "Public Function X()" is a PROCEDURE
    ' HEADER - not a declaration statement. Stripping ONE leading modifier for the header
    ' test (and leaving lo intact for the declaration test) is what keeps lineKind honest:
    ' measured on this card, "Public Function Sum2(...)" was first reported as
    ' declaration_statement, which would have told the caller the wrong thing.
    Dim core As String
    core = lo
    If McpBpPane.BpStartsWord(Me, core, "public ") Then core = Mid$(core, 8)
    If McpBpPane.BpStartsWord(Me, core, "private ") Then core = Mid$(core, 9)
    If McpBpPane.BpStartsWord(Me, core, "friend ") Then core = Mid$(core, 8)
    If McpBpPane.BpStartsWord(Me, core, "global ") Then core = Mid$(core, 8)
    If McpBpPane.BpStartsWord(Me, core, "static ") Then core = Mid$(core, 8)
    ' (a) a CONTINUATION line: the previous physical line ends with the VB6 line
    '     continuation character, so this line does not START a statement.
    If line > 1 Then
        Dim prev As String
        prev = RTrim$(cm.Lines(line - 1, 1))
        If Len(prev) > 0 Then
            If Right$(prev, 1) = "_" Then
                outKind = "continuation_line"
                outWhy = "this line continues the statement that starts on the previous physical line, so it does not start a statement of its own"
                BreakpointLocationProblem = "breakpoint_not_allowed_on_line"
                Exit Function
            End If
        End If
    End If
    ' (b) a PROCEDURE header or footer is not an executable statement. This is the
    '     class that produced the measured sample (a line inside a module whose pane
    '     numbering is offset by its Attribute line resolves to a Function header).
    If McpBpPane.BpStartsWord(Me, core, "sub ") Or McpBpPane.BpStartsWord(Me, core, "function ") Or _
       McpBpPane.BpStartsWord(Me, core, "property ") Or McpBpPane.BpStartsWord(Me, core, "declare ") Then
        outKind = "procedure_header"
        outWhy = "this is a procedure header (Sub/Function/Property/Declare), not an executable statement"
        BreakpointLocationProblem = "breakpoint_not_allowed_on_line"
        Exit Function
    End If
    If lo = "end sub" Or lo = "end function" Or lo = "end property" Then
        outKind = "procedure_footer"
        outWhy = "this is the END line that closes a procedure, not an executable statement"
        BreakpointLocationProblem = "breakpoint_not_allowed_on_line"
        Exit Function
    End If
    ' (c) a source-file ATTRIBUTE line. VB6 does not always count Attribute/VERSION as
    '     declaration lines, so this test has to be separate from the section test.
    If McpBpPane.BpStartsWord(Me, lo, "attribute ") Or McpBpPane.BpStartsWord(Me, lo, "version ") Then
        outKind = "attribute_line"
        outWhy = "this is a source-file attribute line (Attribute/VERSION), not code"
        BreakpointLocationProblem = "breakpoint_not_allowed_on_line"
        Exit Function
    End If
    ' (d) a DECLARATION statement. The declaration-SECTION test above only covers
    '     module-level declarations that VB6 counts; VB6 also refuses a breakpoint on
    '     Option/Dim/Static/Const/Type/Enum and on the module-level Public/Private/
    '     Friend/Global form (an in-procedure Dim is the common case in the wild).
    If McpBpPane.BpStartsWord(Me, lo, "dim ") Or McpBpPane.BpStartsWord(Me, lo, "static ") Or _
       McpBpPane.BpStartsWord(Me, lo, "const ") Or McpBpPane.BpStartsWord(Me, lo, "option ") Or _
       McpBpPane.BpStartsWord(Me, lo, "type ") Or McpBpPane.BpStartsWord(Me, lo, "enum ") Or _
       McpBpPane.BpStartsWord(Me, lo, "public ") Or McpBpPane.BpStartsWord(Me, lo, "private ") Or _
       McpBpPane.BpStartsWord(Me, lo, "friend ") Or McpBpPane.BpStartsWord(Me, lo, "global ") Then
        outKind = "declaration_statement"
        outWhy = "this is a declaration statement (Option/Dim/Static/Const/Type/Enum, or a module-level Public/Private/Friend/Global), not an executable statement"
        BreakpointLocationProblem = "breakpoint_not_allowed_on_line"
        Exit Function
    End If
    outKind = ""
    outWhy = ""
End Function

' an earlier fix: does a line start with the KEYWORD w (case-insensitive)? w already
' carries its own trailing space, so the word boundary is inherent. Used only by the
' conservative breakpoint pre-filter above.

' an earlier fix (defect #11): the machine-readable detail for a pre-check
' refusal, so a caller never has to guess WHICH class of position was refused and
' whether the verdict was exact or heuristic.
Public Sub BreakpointRejectDetail(ByVal reason As String, ByRef why As String, _
                                   ByRef advice As String, ByRef note As String)
    advice = "move the caret to an executable statement inside a procedure and retry"
    note = "nothing was executed and no menu command was sent, so this refusal cannot open a host modal"
    Select Case reason
        Case "component_not_found"
            why = "the component name was not found in the active project"
            advice = "call get_component_list and use the exact component name"
        Case "no_code_module"
            why = "the component has no code module (it is a designer-only component)"
            advice = "address a component that has code (a module, class module or form)"
        Case "line_out_of_range"
            why = "the line number is outside the code module's own line count"
            advice = "call get_component_code (coords=ide) and use a line it actually returns"
        Case "declaration_section"
            why = "the line is inside the module's declaration section (VB6 computes CountOfDeclarationLines itself)"
        Case "blank_line"
            why = "the line is blank, so there is no statement to break on"
        Case "comment_line"
            why = "the line is a comment (a leading apostrophe or a Rem statement)"
        Case "breakpoint_not_allowed_on_line"
            ' why / kind come from the classifier itself
            note = "HEURISTIC PRE-FILTER, not VB6's own verdict: the extensibility model exposes no breakpoint API and no 'can I break here?' query, so this is a language-level classification. It can only ever refuse a line; a line it accepts may still be refused by the IDE, and that residue is covered by the bounded modal guard (see the modal* fields of the receipt)."
    End Select
End Sub

Public Function ToolNativeBreakpoint(ByVal args As Object) As String
    Dim cbR As Object
    If CmdBarsRunRefusal("native_breakpoint", cbR) Then
        ToolNativeBreakpoint = JsonStringify(cbR)
        Exit Function
    End If
    If CmdBarsBreakRefusal("native_breakpoint", cbR) Then
        ToolNativeBreakpoint = JsonStringify(cbR)
        Exit Function
    End If
    Dim action As String
    action = LCase$(JsonGetStr(args, "action"))
    Dim barCands As String
    Dim ctrlCands As String
    barCands = "Debug|Run|" & ChrW$(&H8C03) & ChrW$(&H8BD5) & "|" & ChrW$(&H8FD0) & ChrW$(&H884C)
    Dim comp As String
    Dim line As Long
    comp = JsonGetStr(args, "component")
    line = JsonGetLong(args, "line", 0)
    ' Card: a breakpoint request aimed at a position VB6 will not accept used to
    ' take down the request (connection closed, no reply). Validate first and
    ' answer with a structured failure instead.
    Dim preReason As String
    preReason = ""
    ' an earlier fix (defect #11): the pre-check now also reports WHAT KIND of
    ' position was refused and WHY, so a heuristic refusal can never be mistaken for
    ' VB6's own ruling.
    Dim preKind As String
    Dim preWhy As String
    Dim preText As String
    Dim preAdvice As String
    Dim preNote As String
    preKind = ""
    preWhy = ""
    preText = ""
    preAdvice = ""
    preNote = ""
    ' an earlier fix : the bounded modal-guard budget for the menu-driven toggle.
    Dim mgWait As Long
    mgWait = MODAL_GUARD_WAIT_MS
    Dim cp As VBIDE.CodePane
    ' (R18-2 / R18-3): BEFORE anything moves, remember the caret and the pane
    ' text so the receipt can PROVE the pane was not rewritten and the caret was put back.
    Dim curOk As Boolean
    Dim curSL As Long, curSC As Long, curEL As Long, curEC As Long
    Dim pAssertComp As String, pAssertBefore As String
    Dim pAssertOn As Boolean
    Dim curRestored As Boolean
    Dim curNote As String
    Dim fgBefore As Long, fgAfter As Long
    curOk = False
    pAssertOn = False
    pAssertComp = ""
    pAssertBefore = ""
    curRestored = False
    curNote = "not attempted"
    fgBefore = WoFrontHwnd()
    Select Case action
        Case "toggle"
            ctrlCands = "Toggle Breakpoint|" & ChrW$(&H5207) & ChrW$(&H6362) & ChrW$(&H65AD) & ChrW$(&H70B9)
            If line > 0 Then
                preReason = BreakpointLocationProblem(comp, line, preKind, preWhy, preText)
                If Len(preReason) = 0 Then
                    Set cp = GetCodePane(comp)
                    On Error Resume Next
                    Err.Clear
                    If cp Is Nothing Then
                        preReason = "no_code_pane"
                    Else
                        ' R18-3: the IDE has NO breakpoint API, so "Toggle Breakpoint" acts on the
                        ' CARET (Debug menu item). Save the caret and the pane text here; both are
                        ' restored/checked after the menu command has run.
                        curSL = 0: curSC = 0: curEL = 0: curEC = 0
                        cp.GetSelection curSL, curSC, curEL, curEC
                        If Err.Number = 0 Then curOk = True
                        Err.Clear
                        pAssertComp = comp
                        pAssertBefore = PaneTextOfName(comp, pAssertOn)
                        cp.SetSelection line, 1, line, 1
                        If Err.Number <> 0 Then
                            preReason = "selection_failed"
                            Err.Clear
                        End If
                    End If
                    On Error GoTo 0
                End If
            End If
        Case "clear_all"
            ctrlCands = "Clear All Breakpoints|" & ChrW$(&H6E05) & ChrW$(&H9664) & ChrW$(&H6240) & ChrW$(&H6709) & ChrW$(&H65AD) & ChrW$(&H70B9)
            ' R18-2: clear_all names no component, so the assertion target is the ACTIVE code
            ' pane. When there is none, the assertion is reported as notApplicable rather than
            ' skipped silently. Clear All Breakpoints does not touch the code text either.
            pAssertComp = PaneCompOfActive()
            If Len(pAssertComp) > 0 Then pAssertBefore = PaneTextOfName(pAssertComp, pAssertOn)
        Case Else
            Err.Raise vbObjectError + 84, "CodeTools", "Invalid action: " & action & " (expected toggle/clear_all)"
    End Select
    ' FIX-17: never reach ctrl.Execute from a state where it can block.
    If Len(preReason) = 0 Then
        If LCase$(GetIdeState()) <> "design" Then
            preReason = "not_in_design"
            preKind = "state_gate"
            preWhy = "state=" & GetIdeState()
            preText = ""
            preAdvice = "finish the run (control_execution end) and retry"
            preNote = "no menu command was sent"
        ElseIf BpCommandBarsSuspended() Then
            preReason = "commandbars_suspended"
            preKind = "state_gate"
            preWhy = "the CommandBars model is suspended while a program runs"
            preText = ""
            preAdvice = "stop the running program and retry"
            preNote = "no menu command was sent"
        End If
    End If
    If Len(preReason) > 0 Then
        Dim rej As Object
        Set rej = CreateObject("Scripting.Dictionary")
        Call BreakpointRejectDetail(preReason, preWhy, preAdvice, preNote)
        ' an earlier fix (defect #11): a structured refusal that NAMES the class of
        ' position and says whether the verdict is exact (a code-module query VB6 itself
        ' computes) or heuristic (this file's language-level classifier). The menu command
        ' is NEVER sent on this path, so no host modal can appear: that is the whole point
        ' of pre-checking, and the receipt states it as a fact (menuCommandSent / modal).
        rej("ok") = False
        rej("action") = action
        rej("executed") = False
        rej("reason") = preReason
        rej("lineKind") = preKind
        rej("why") = preWhy
        rej("lineText") = preText
        rej("heuristic") = (preReason = "breakpoint_not_allowed_on_line")
        rej("advice") = preAdvice
        rej("menuCommandSent") = False
        rej("modalDetected") = False
        rej("modalClickedButton") = ""
        rej("modalWaitedMs") = 0
        rej("modalRecoveredBy") = "not_needed: the refusal happens BEFORE any menu command, so this call cannot open a host modal"
        rej("modalGuard") = "not armed on this path - no menu command is sent and no host modal can be opened by this call"
        rej("modalSideEffects") = "none: nothing was sent to the IDE"
        rej("modalPolicy") = "PRE-CHECK FIRST: a position VB6 refuses makes the Debug-menu toggle block inside a host modal that this single-threaded add-in cannot dismiss from the call that opened it (measured: ~1 minute, then every later write answered reason=busy). When the pre-check can refuse, it does, and the menu is never touched."
        rej("modalNote") = "this is a STRUCTURED REFUSAL, not a timeout and not a swallowed dialog. See heuristic/lineKind/why for whether the verdict is exact or a conservative pre-filter."
        ' the same facts under the names an earlier request asked for
        rej("clickedButton") = ""
        rej("waitedMs") = 0
        If Len(comp) > 0 Then rej("component") = comp
        If line > 0 Then rej("line") = line
        If Len(comp) > 0 And line > 0 Then
            ' ruling 4
            Set rej("coords") = CoordsDictOfName(comp, line, "ide")
        End If
        rej("state") = GetIdeState()
        rej("note") = preNote
        ToolNativeBreakpoint = JsonStringify(rej)
        Exit Function
    End If
    ' ---- an earlier fix (defect #11): arm the bounded modal guard -------------
    ' The pre-check above is a HEURISTIC and can only be conservative, so the residue -
    ' a line it accepted that VB6 still refuses - must not be able to hang the session
    ' again. The guard's Cancel-first policy dismisses VB6's "this line cannot hold a
    ' breakpoint" box (a plain OK/Help message box) from the watchdog tick, which is the
    ' only channel the host's modal loop still dispatches. ArmGateRelease is the
    ' BACKSTOP: if the toggle still never returns, the NEXT tool call releases the
    ' single-flight gate by itself instead of the caller having to know about
    ' ide_state{release_inflight}.
    Dim mgT0 As Long
    mgT0 = 0
    Dim mgJsonNote As String
    mgJsonNote = ""
    WinOps.WoModalGuardSiteArm "native_breakpoint", mgWait
    ArmGateRelease "native_breakpoint", mgWait + 5000
    Dim ctrl As Object
    Set ctrl = McpFindTools.FindCmd(Me, action, barCands, ctrlCands)
    If ctrl Is Nothing Then
        WinOps.WoModalGuardSiteDisarm
        DisarmGateRelease
        Err.Raise vbObjectError + 84, "CodeTools", "Debug menu item not found for action=" & action & ". The CommandBars model is suspended while the program runs - stop it (end/break) and retry."
    End If
    Dim n As Long
    Dim tglT0 As Long
    tglT0 = Util.TickMs()
    OpLog "NATIVE_BP_BEGIN action=" & action & " ctrlId=" & CStr(CtrlIdSafe(ctrl)) & " caption=" & CStr(ctrl.Caption) & " state=" & GetIdeState() & " dialog=" & CStr(WinOps.HasVisibleHostDialog(mgJsonNote))
    n = ExecIfEnabled(ctrl, action)
    ' guarded - see Util.PumpGateBlocked.
    If CanPump() Then DoEvents
    ' The host modal loop drives WheelTick itself; this bounded pump covers the case
    ' where the box is merely POSTED rather than reached synchronously.
    Call ModalGuardSettle(mgWait)
    OpLog "NATIVE_BP_END action=" & action & " executed=" & CStr(n) & " elapsedMs=" & CStr(Util.TickMs() - tglT0) & " state=" & GetIdeState() & " pumped=ModalGuardSettle"
    WinOps.WoModalGuardSiteDisarm
    DisarmGateRelease
    ' ---- R18-3 compensation: restore the caret, then give the foreground back --------
    ' VB6 exposes NO breakpoint API (see list_breakpoints), and the Debug menu item acts on
    ' the CARET, so there is NO channel that sets an IDE-native breakpoint "without moving
    ' the cursor and without changing text". What can be done - and is done here - is to
    ' put the caret back exactly where it was and to hand the foreground back to whatever
    ' window owned it. The receipt says all three facts so the trade-off is visible.
    If LCase$(action) = "toggle" Then
        If curOk Then
            On Error Resume Next
            Set cp = GetCodePane(comp)
            If cp Is Nothing Then
                curNote = "the code pane could not be resolved again, so the caret was NOT restored"
            Else
                Err.Clear
                cp.SetSelection curSL, curSC, curEL, curEC
                If Err.Number = 0 Then
                    curRestored = True
                    curNote = "the caret was put back at the selection read before the toggle"
                Else
                    curNote = "SetSelection raised " & CStr(Err.Number) & " (" & Err.Description & "); the caret was NOT restored"
                    Err.Clear
                End If
            End If
            On Error GoTo 0
        Else
            curNote = "the caret could not be read before the toggle, so nothing could be restored"
        End If
    Else
        curNote = "action " & action & " does not move the caret"
    End If
    fgAfter = WoFrontHwnd()
    If fgAfter <> fgBefore Then
        WoFrontRestore fgBefore
        fgAfter = WoFrontHwnd()
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("action") = action
    root("executed") = (n > 0)
    root("caption") = ctrl.Caption
    root("controlId") = CtrlIdSafe(ctrl)
    root("cursorRestored") = curRestored
    root("cursorNote") = curNote
    root("foregroundBefore") = fgBefore
    root("foregroundAfter") = fgAfter
    root("foregroundTookFocus") = (fgAfter <> fgBefore)
    root("foregroundReadable") = (fgBefore <> 0 Or fgAfter <> 0)
    ' (A): a menu-driven toggle CANNOT be issued without activating the IDE, so
    ' quiet mode can only GIVE THE FOREGROUND BACK (done above). Report that honestly rather
    ' than claiming a suppression that did not happen.
    If QuietActive() Then
        root("quietModeSuppressedFocus") = False
        root("quietModeForegroundRestored") = (fgAfter = fgBefore)
        root("quietModeNote") = "quiet mode is ON, but a Debug-menu breakpoint toggle cannot be issued without activating the IDE: the foreground was taken and then GIVEN BACK (foregroundTookFocus / quietModeForegroundRestored say which). Quiet mode does not suppress this one - it only compensates for it."
    End If
    root("ideNativeBreakpointApi") = False
    root("breakpointWithoutCursorMove") = False
    root("breakpointQuietNote") = "VB6's extensibility model exposes NO breakpoint API (list_breakpoints says the same), and the Debug menu item acts on the caret; there is therefore NO channel that sets an IDE-native breakpoint without moving the cursor. This tool moves the caret to the target line and, as compensation, restores the previous selection afterwards (cursorRestored) and gives the foreground back (foregroundTookFocus). The alternative, set_breakpoint, does not move the caret but WRITES text (an injected Debug.Assert marker block)."
    If Len(comp) > 0 Then root("component") = comp
    If line > 0 Then root("line") = line
    If Len(comp) > 0 And line > 0 Then
        ' ruling 4
        Set root("coords") = CoordsDictOfName(comp, line, "ide")
    End If
    root("state") = GetIdeState()
    root("note") = "Menu-driven IDE breakpoint: no source file was modified. The IDE keeps breakpoints only for the current session."
    ' R18-2: the write-after assertion. A native breakpoint is menu-driven and writes no
    ' text, so the contract here is "the pane text is UNCHANGED"; a change flips the
    ' receipt to ok:false / reason:paneTextMismatch with the differing lines.
    ' an earlier fix : the guard receipt, on every path. It never invents a
    ' dismissal: modalDetected=false means no blocking box was seen inside the budget,
    ' and modalRecoveredBy says which of {not_needed, modal_guard_click,
    ' modal_guard_timeout} actually happened.
    Call MergeModalGuard(root)
    PaneAssertFinish root, pAssertComp, pAssertBefore, pAssertOn, "native_breakpoint"
    ToolNativeBreakpoint = JsonStringify(root)
End Function

' ---- data access for the MCP resource layer (not tools) ----

Public Function ComponentNamesList() As Object
    Dim items As Object
    Set items = New Collection
    Dim p As VBIDE.VBProject
    Dim c As VBIDE.VBComponent
    On Error Resume Next
    Set p = GetProject()
    If p Is Nothing Then
        Set ComponentNamesList = items
        On Error GoTo 0
        Exit Function
    End If
    For Each c In p.VBComponents
        items.Add c.Name
    Next
    On Error GoTo 0
    Set ComponentNamesList = items
End Function

Public Function ComponentCodeText(ByVal name As String) As String
    On Error Resume Next
    Dim c As VBIDE.VBComponent
    Set c = McpFindTools.FindComponent(Me, name)
    If c Is Nothing Then Exit Function
    ' guard the empty-component case (CountOfLines = 0 => Lines(1,0) = error 5)
    If c.CodeModule.CountOfLines > 0 Then ComponentCodeText = c.CodeModule.Lines(1, c.CodeModule.CountOfLines)
End Function


' ---------------------------------------------------------------------
' offline VB tooling (VbFmt.bas): formatter and cross-project rename
' ---------------------------------------------------------------------
Private Function ToolFormatCode(ByVal args As Object) As String
    Dim path As String
    path = JsonGetStr(args, "path")
    If Len(path) = 0 Then Err.Raise vbObjectError + 81, "CodeTools", "path is required"
    Dim indentUnit As String
    indentUnit = JsonGetStr(args, "indent")
    If Len(indentUnit) = 0 Then indentUnit = "    "
    ToolFormatCode = VbFmt.FormatJson(ResolvePath(path), indentUnit, JsonGetBool(args, "apply", False))
End Function

Private Function ToolRenameSymbol(ByVal args As Object) As String
    Dim vbp As String
    vbp = JsonGetStr(args, "path")
    If Len(vbp) = 0 Then Err.Raise vbObjectError + 83, "CodeTools", "path is required (the .vbp)"
    Dim vbpFull As String
    vbpFull = ResolvePath(vbp)
    ' (the missing-vbp finding): a NONEXISTENT .vbp used to be reported as a successful 0-change dry
    ' run - ProjShip.ReadTextFile returns "" for a missing file, so the component list came back
    ' empty and nothing was found to rename. Refuse it, and say which paths were tried.
    If Not CtlFileExists(vbpFull) Then
        Dim nf As Object
        Set nf = CreateObject("Scripting.Dictionary")
        nf("ok") = False
        nf("reason") = "project_file_not_found"
        nf("tool") = "rename_symbol"
        nf("argument") = "path"
        nf("path") = vbp
        nf("resolvedPath") = vbpFull
        Dim nfTried As Object
        Set nfTried = New Collection
        nfTried.Add vbp
        If StrComp(vbp, vbpFull, vbTextCompare) <> 0 Then nfTried.Add vbpFull
        Set nf("triedPaths") = nfTried
        nf("message") = "project file not found: " & vbpFull
        nf("suggestedAction") = "pass the path of an EXISTING .vbp; a relative path resolves against the project directory, not the process working directory"
        nf("sideEffects") = "none: the call was refused before any file was read or written"
        ToolRenameSymbol = JsonStringify(nf)
        Exit Function
    End If
    ' (S3): an EXISTING file that is not a VB6 project used to answer as a SUCCESSFUL
    ' 0-change dry run - ProjShip.ComponentPaths simply finds no Module=/Class= lines in it. This is
    ' the sibling of 's project_file_not_found, but a DIFFERENT condition: the path does
    ' resolve to a real file, it just is not a .vbp (the declared contract of `path`). Refuse before
    ' anything is read or written.
    If LCase$(Right$(vbpFull, 4)) <> ".vbp" Then
        Dim naj As Object
        Set naj = CreateObject("Scripting.Dictionary")
        naj("ok") = False
        naj("reason") = "not_a_project_file"
        naj("tool") = "rename_symbol"
        naj("argument") = "path"
        naj("path") = vbp
        naj("resolvedPath") = vbpFull
        Dim najDot As Long
        Dim najExt As String
        najExt = ""
        najDot = InStrRev(vbpFull, ".")
        If najDot > 0 Then najExt = Mid$(vbpFull, najDot)
        naj("looksLike") = najExt
        Dim najTried As Object
        Set najTried = New Collection
        najTried.Add vbp
        If StrComp(vbp, vbpFull, vbTextCompare) <> 0 Then najTried.Add vbpFull
        Set naj("triedPaths") = najTried
        naj("message") = "not a VB6 project file (.vbp): " & vbpFull
        naj("suggestedAction") = "pass the path of the .vbp whose component files should be searched; to rename a COMPONENT (module/class/form) use rename_component"
        naj("sideEffects") = "none: the call was refused before any file was read or written"
        ToolRenameSymbol = JsonStringify(naj)
        Exit Function
    End If
    ToolRenameSymbol = VbFmt.RenameJson(vbpFull, JsonGetStr(args, "old_name"), JsonGetStr(args, "new_name"), _
                                        JsonGetBool(args, "dry_run", True), JsonGetBool(args, "skip_attributes", True))
End Function

' ---------------------------------------------------------------------
' project group / project snapshot / packaging / VCS (ProjShip.bas)
' ---------------------------------------------------------------------
Private Function Qq(ByVal s As String) As String
    Qq = Chr$(34) & s & Chr$(34)
End Function

Private Function ToolVbgGroup(ByVal args As Object) As String
    Dim action As String
    action = LCase$(JsonGetStr(args, "action"))
    Dim raw As String
    raw = JsonGetStr(args, "path")
    If Len(raw) = 0 Then Err.Raise vbObjectError + 77, "CodeTools", "path is required (the .vbg project group)"
    Dim vbg As String
    vbg = ResolvePath(raw)
    Dim proj As String
    proj = JsonGetStr(args, "project")
    If Len(proj) > 0 Then proj = ResolvePath(proj)
    Select Case action
        Case "list"
            ToolVbgGroup = ProjShip.VbgListJson(vbg)
        Case "add"
            If Len(proj) = 0 Then Err.Raise vbObjectError + 77, "CodeTools", "project is required for action=add"
            ToolVbgGroup = ProjShip.VbgAddJson(vbg, proj)
        Case "remove"
            If Len(proj) = 0 Then Err.Raise vbObjectError + 77, "CodeTools", "project is required for action=remove"
            ToolVbgGroup = ProjShip.VbgRemoveJson(vbg, proj)
        Case Else
            Err.Raise vbObjectError + 77, "CodeTools", "Invalid action: " & action & " (expected list/add/remove)"
    End Select
End Function

Private Function ToolProjectSnapshot(ByVal args As Object) As String
    Dim action As String
    action = LCase$(JsonGetStr(args, "action"))
    Dim rawPath As String
    rawPath = JsonGetStr(args, "path")
    Dim rawDir As String
    rawDir = JsonGetStr(args, "dir")
    Select Case action
        Case "create"
            If Len(rawPath) = 0 Then Err.Raise vbObjectError + 78, "CodeTools", "path is required for action=create"
            Dim dir As String
            dir = ""
            If Len(rawDir) > 0 Then dir = ResolvePath(rawDir)
            ToolProjectSnapshot = ProjShip.SnapshotCreateJson(ResolvePath(rawPath), dir)
        Case "restore"
            If Len(rawDir) = 0 Then Err.Raise vbObjectError + 78, "CodeTools", "dir is required for action=restore"
            Dim csv As String
            csv = ""
            ToolProjectSnapshot = ProjShip.SnapshotRestoreJson(ResolvePath(rawDir), csv)
        Case "list"
            If Len(rawPath) = 0 Then Err.Raise vbObjectError + 78, "CodeTools", "path is required for action=list"
            ToolProjectSnapshot = ProjShip.SnapshotListJson(ResolvePath(rawPath))
        Case Else
            Err.Raise vbObjectError + 78, "CodeTools", "Invalid action: " & action & " (expected create/restore/list)"
    End Select
End Function

Private Function ToolPackageApp(ByVal args As Object) As String
    Dim rawPath As String
    rawPath = JsonGetStr(args, "path")
    If Len(rawPath) = 0 Then Err.Raise vbObjectError + 79, "CodeTools", "path is required (the .vbp to package)"
    Dim exe As String
    exe = JsonGetStr(args, "exe_path")
    If Len(exe) > 0 Then exe = ResolvePath(exe)
    Dim outDir As String
    outDir = JsonGetStr(args, "out_dir")
    If Len(outDir) > 0 Then outDir = ResolvePath(outDir)
    ToolPackageApp = ProjShip.PackageJson(ResolvePath(rawPath), exe, outDir, JsonGetStr(args, "level"))
