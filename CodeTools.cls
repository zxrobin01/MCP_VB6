        root("cacheSkippedReason") = "project_dirty_cache_invalid"
        root("cacheSkippedNote") = "a cached artifact was NOT used as this call's answer: the IDE holds unsaved changes (memory != disk), so the source that produced the cached artifact is not the source in the editor. The call proceeded to the in-IDE Make, which saves the project first."
        root("cacheSkippedDirtyComponents") = CStr(cacheSkipScan("dirtyNames"))
        root("cacheSkippedDirtyCount") = CLng(cacheSkipScan("dirtyCount"))
