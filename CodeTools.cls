' file tools (disk)
' =====================================================================

Private Function ToolListFiles(ByVal path As String, ByVal pattern As String, ByVal recursive As Boolean, ByVal maxEntries As Long) As String
    If maxEntries <= 0 Then maxEntries = 500
    Dim base As String
    base = McpProjTools.ProjectDir(Me)
    Dim target As String
    If Len(path) = 0 Then
        target = base
        If Len(target) = 0 Then Err.Raise vbObjectError + 30, "CodeTools", "No project open and no path given"
    Else
        target = ResolvePath(path)
    End If
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(target) Then Err.Raise vbObjectError + 31, "CodeTools", "Directory not found: " & target
    Dim patterns As Variant
    If Len(pattern) = 0 Then pattern = "*"
    patterns = Split(pattern, ";")
    Dim results As Object
    Set results = New Collection
    Dim count As Long
    Dim truncated As Boolean
    WalkDir fso, fso.GetFolder(target), patterns, results, base, recursive, maxEntries, count, truncated
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("path") = target
    root("count") = count
    root("truncated") = truncated
    Set root("files") = results
    ToolListFiles = JsonStringify(root)
End Function

' R-1021-01: the ONE pre-flight every disk READ tool runs. Existence is decided
' with a read-only probe BEFORE any read primitive executes, so a missing path
' answers with a structured file_not_found instead of a generic unreadable
' message, and it can never reach an Open statement (Encoding.ReadAllBytesTo is
' guarded too - the Open used to CREATE the 0-byte residue).
Private Function ReadInputFileRefusal(ByVal toolName As String, ByVal rawPath As String, ByRef fullPath As String) As String
    ReadInputFileRefusal = ""
    fullPath = ResolvePath(rawPath)
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If fso.FileExists(fullPath) Then Exit Function
    Dim pe As Boolean, isDir As Boolean
    pe = False
    isDir = False
    isDir = CBool(fso.FolderExists(fullPath))
    Dim par As String
    par = fso.GetParentFolderName(fullPath)
    If Len(par) > 0 Then pe = CBool(fso.FolderExists(par))
    ReadInputFileRefusal = Util.InputFileMissingJson(toolName, rawPath, fullPath, pe, isDir)
End Function

Private Function ToolReadFile(ByVal path As String, ByVal maxLines As Long) As String
    Dim full As String
    full = ResolvePath(path)
    Dim rfGuard As String
    rfGuard = ReadInputFileRefusal("read_file", path, full)
    If Len(rfGuard) > 0 Then
        ToolReadFile = rfGuard
        Exit Function
    End If
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FileExists(full) Then Err.Raise vbObjectError + 32, "CodeTools", "File not found: " & full
    Dim content As String
    content = ReadTextAuto(full)
    If maxLines > 0 Then
        Dim lines() As String
        lines = Split(Replace(content, vbCrLf, vbLf), vbLf)
        If UBound(lines) >= maxLines Then
            Dim head() As String
            ReDim head(0 To maxLines - 1)
            Dim i As Long
            For i = 0 To maxLines - 1
                MaybePump
                head(i) = lines(i)
            Next
            content = Join(head, vbCrLf) & vbCrLf & "... (truncated at " & CStr(maxLines) & " lines; total " & CStr(UBound(lines) + 1) & ")"
        End If
    End If
    ToolReadFile = content
End Function

Private Function ToolWriteFile(ByVal path As String, ByVal content As String, ByVal encoding As String, ByVal createDirs As Boolean, _
                              ByVal backup As Boolean, ByVal validateMode As String) As String
    Dim full As String
    full = ResolvePath(path)
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    ' R-1021-01: a CREATE (target did not exist) is reported explicitly, so a
    ' legitimate 0-byte non-VB file can still be told apart from a truncation.
    Dim wfExistedBefore As Boolean
    wfExistedBefore = (Len(Dir$(full)) > 0)
    Dim wfCreated As Object
    Set wfCreated = New Collection
    If createDirs Then
        Dim parent As String
        parent = fso.GetParentFolderName(full)
        ' Same structured refusal as write_source when the parent cannot exist.
        On Error Resume Next
        EnsureDirTracked parent, wfCreated
        Err.Clear
        On Error GoTo 0
        If Len(parent) > 0 Then
            If Not fso.FolderExists(parent) Then
                ToolWriteFile = WriteNotVisibleRefusal("write_file", full, "parent_not_creatable", "", "", 0, parent)
                Exit Function
            End If
        End If
    End If
    Dim enc As String
    enc = LCase$(encoding)
    If enc = "auto" Then
        If IsVbFileExt(full) Then enc = "ansi" Else enc = "utf-8"
    End If
    Dim backupPath As String
    backupPath = ""
    If backup And fso.FileExists(full) Then
        backupPath = full & ".bak"
        If fso.FileExists(backupPath) Then fso.DeleteFile backupPath, True
        fso.CopyFile full, backupPath
        ' remaining: a .bak that is not readable back must not be advertised.
        Dim bakOk As Boolean
        bakOk = False
        On Error Resume Next
        If fso.FileExists(backupPath) Then
            If fso.GetFile(backupPath).Size = fso.GetFile(full).Size Then bakOk = True
        End If
        On Error GoTo 0
        If Not bakOk Then backupPath = ""
    End If
    Dim bytes() As Byte
    Select Case enc
        Case "utf-8"
            bytes = Utf8Encode(content)
        Case "utf-16"
            bytes = Utf16Encode(content)
        Case Else
            bytes = AnsiEncode(content)
            enc = "ansi"
    End Select
    ' byte-level round-trip assertion on the WRITE side (see write_source).
    ' The comparison lives in BytesDecodeEqualTo because this procedure's 'encoding'
    ' parameter shadows the Encoding module.
    Dim wfEnc As String
    wfEnc = enc
    If wfEnc = "utf-16" Then wfEnc = "utf-16le"
    If Not BytesDecodeEqualTo(bytes, wfEnc, content) Then
        ToolWriteFile = UnencodableRefusal("write_file", full, enc, content)
        Exit Function
    End If
    ' beta-3: lint a VB source file BEFORE it is written (warn-only).
    Dim lintPk As Object
    If IsVbFileExt(full) Then
        Set lintPk = LintPack(content, InferKind(full))
        ' gamma-4: refuse BEFORE the file is touched
        Dim wfref As String
        wfref = StrictRefusal(full, "write_file", lintPk, validateMode)
        If Len(wfref) > 0 Then
            ToolWriteFile = wfref
            Exit Function
        End If
    End If
    ' VB6's "Open ... For Binary Access Write" does NOT truncate the
    ' file, so writing SHORTER content left the previous tail behind (measured: a
    ' 50-byte file written down to 10 bytes kept 40 bytes of the old content and
    ' reported bytesWritten=10). Delete the target first so the bytes on disk are
    ' exactly the new content. The backup above has already been taken.
    On Error Resume Next
    If fso.FileExists(full) Then fso.DeleteFile full, True
    Err.Clear
    On Error GoTo 0
    ' R-1021-01: empty content leaves the byte array uninitialised, and UBound on
    ' it raised VB error 9 AFTER Open had already created the target: the 0-byte
    ' file stayed behind and Close never ran. Count the bytes first, Put only when
    ' there are any, and turn a failed Open/Put into a structured refusal.
    Dim wfN As Long
    wfN = WbByteCount(bytes)
    Dim wfWant As String
    If wfN > 0 Then
        wfWant = Sha256.Sha256HexBytes(bytes)
    Else
        wfWant = Sha256.Sha256HexTextUtf8("")
    End If
    Dim fnum As Integer
    fnum = FreeFile
    On Error GoTo wfWriteFail
    Open full For Binary Access Write As #fnum
    If wfN > 0 Then Put #fnum, , bytes
    Close #fnum
    On Error GoTo 0
    ' the same read-back assertion as write_source - never claim a write that is
    ' not readable back from the target path.
    Dim wfGot As String, wfBackB() As Byte
    If Len(Dir$(full)) = 0 Then
        ToolWriteFile = WriteNotVisibleRefusal("write_file", full, "write_not_visible", wfWant, "", wfN)
        Exit Function
    End If
    ' NB: this procedure's 'encoding' PARAMETER shadows the Encoding module (see the
    ' note above), so call the class-local reader instead of Encoding.ReadAllBytesTo.
    wfBackB = ReadAllBytes(full)
    If WbByteCount(wfBackB) > 0 Then
        wfGot = Sha256.Sha256HexBytes(wfBackB)
    Else
        wfGot = Sha256.Sha256HexTextUtf8("")
    End If
    If wfGot <> wfWant Then
        ToolWriteFile = WriteNotVisibleRefusal("write_file", full, "write_verify_failed", wfWant, wfGot, wfN)
        Exit Function
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("file") = full
    root("encoding") = enc
    root("bytesWritten") = wfN
    root("size") = wfN
    root("exists") = True
    root("verifiedOnDisk") = True
    ' R-1021-01 (write-proof contract): ok + bytes + sha256 are published by EVERY
    ' write tool, and the digest is the one computed from the bytes READ BACK.
    root("ok") = True
    root("bytes") = wfN
    root("sha256") = wfGot
    root("sha256Source") = "readback"
    root("created") = Not wfExistedBefore
    Set root("createdDirs") = wfCreated
    root("createdDirsCount") = wfCreated.Count
    If Len(backupPath) > 0 Then root("backup") = backupPath
    If IsProjectFile(full) Then
        root("note") = "File belongs to the open project. Use reload_component to load it into the IDE, or use replace_code for live in-memory edits."
    End If
    CopyLintPack root, lintPk
    ToolWriteFile = JsonStringify(root)
    Exit Function
wfWriteFail:
    Dim wfFailCode As Long
    wfFailCode = Err.Number
    On Error Resume Next
    Close #fnum
    ToolWriteFile = WriteNotVisibleRefusal("write_file", full, "write_failed", wfWant, "", wfN)
    Err.Clear
End Function

Private Function ToolSearchInFiles(ByVal query As String, ByVal path As String, ByVal pattern As String, ByVal isRegex As Boolean, ByVal caseSensitive As Boolean, ByVal maxResults As Long, ByVal wantProc As Boolean, ByVal wantLead As Boolean) As String
    If maxResults <= 0 Then maxResults = 200
    Dim base As String
    base = McpProjTools.ProjectDir(Me)
    Dim target As String
    If Len(path) = 0 Then
        target = base
        If Len(target) = 0 Then Err.Raise vbObjectError + 30, "CodeTools", "No project open and no path given"
    Else
        target = ResolvePath(path)
    End If
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(target) Then Err.Raise vbObjectError + 31, "CodeTools", "Directory not found: " & target
    Dim patterns As Variant
    If Len(pattern) = 0 Then pattern = DEFAULT_SEARCH_PATTERNS
    patterns = Split(pattern, ";")
    Dim re As Object
    Set re = Nothing
    If isRegex Then
        Set re = CreateObject("VBScript.RegExp")
        re.Pattern = query
        re.Global = False
        re.IgnoreCase = Not caseSensitive
    End If
    Dim results As Object
    Set results = New Collection
    Dim count As Long
    Dim truncated As Boolean
    Dim filesScanned As Long
    SearchWalk fso, fso.GetFolder(target), patterns, re, query, isRegex, caseSensitive, maxResults, results, count, truncated, filesScanned, base, wantProc, wantLead
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("query") = query
    root("regex") = isRegex
    root("caseSensitive") = caseSensitive
    root("path") = target
    root("filesScanned") = filesScanned
    root("resultsCount") = count
    root("truncated") = truncated
    If wantProc Or wantLead Then
        root("procedureMapping") = "COMMENT SEARCH additive mapping (module ProcMap): each result's proc/procBodyLine come from a LEXICAL scan of the FILE lines (search_in_files has no IDE CodeModule for an arbitrary file) - procSource=text_scan names that authority; leadingComment is the contiguous single-quote comment block directly above the header with no blank line between. Flags absent => this receipt is key-for-key unchanged."
    End If
    Set root("results") = results
    ToolSearchInFiles = JsonStringify(root)
End Function

' =====================================================================
' build / run tools
' =====================================================================

' (B-family): {path, exists, size, mtime, mtimeText, sha256} of one file,
' read back FROM DISK, so a save receipt can assert what really landed instead of
' assuming it.  Every failure is reported in note= instead of raising.
Private Function FileSnapOf(ByVal path As String) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("path") = path
    d("exists") = False
    d("size") = 0
    d("mtime") = 0
    d("mtimeText") = ""
    d("sha256") = ""
    d("note") = ""
    If Len(path) = 0 Then
        d("note") = "no file: the project has no .vbp on disk"
        Set FileSnapOf = d
        Exit Function
    End If
    On Error Resume Next
    Dim n As Double
    n = FileLen(path)
    If Err.Number <> 0 Then
        d("note") = "unreadable: " & Err.Description
        Err.Clear
        On Error GoTo 0
        Set FileSnapOf = d
        Exit Function
    End If
    d("exists") = True
    d("size") = n
    Dim b() As Byte
    Encoding.ReadAllBytesTo path, b
    If Err.Number = 0 Then
        d("sha256") = Sha256.Sha256HexBytes(b)
    Else
        d("note") = "digest unavailable: " & Err.Description
        Err.Clear
    End If
    Err.Clear
    On Error GoTo 0
    Dim fso As Object, f As Object
    On Error Resume Next
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Err.Number = 0 Then
        Set f = fso.GetFile(path)
        If Err.Number = 0 Then
            d("mtime") = f.DateLastModified
            d("mtimeText") = Format$(f.DateLastModified, "yyyy-mm-dd HH:mm:ss")
        End If
    End If
    Err.Clear
    On Error GoTo 0
    Set FileSnapOf = d
End Function

' the project-level values the IDE holds but the .vbp ON DISK does not carry.
' Empty string = the file agrees with the IDE.  THIS is the assertion that catches the
' measured fake success: the IDE reported Saved=True and the tool answered
' projectSaved=True while Description= was never written to the file.

' join a Collection of strings (VB6 has no Join for one).
Private Function JoinText(ByVal col As Object, ByVal sep As String) As String
    Dim i As Long, out As String
    out = ""
    If col Is Nothing Then
        JoinText = out
        Exit Function
    End If
    For i = 1 To col.Count
        If i > 1 Then out = out & sep
        out = out & CStr(col(i))
    Next i
    JoinText = out
End Function

' the first 1-based line at which two texts differ (0 when both are empty).
' Used to report where a write REALLY landed instead of the line that was requested.
Private Function FirstDifferingLine(ByVal before As String, ByVal after As String) As Long
    Dim a() As String, b() As String, i As Long, n As Long
    a = McpCls.TextLines(Me, before)
    b = McpCls.TextLines(Me, after)
    If UBound(a) < 0 Then
        If UBound(b) < 0 Then FirstDifferingLine = 0 Else FirstDifferingLine = 1
        Exit Function
    End If
    n = UBound(a)
    If UBound(b) < n Then n = UBound(b)
    For i = 0 To n
        If a(i) <> b(i) Then
            FirstDifferingLine = i + 1
            Exit Function
        End If
    Next i
    FirstDifferingLine = n + 2
End Function

' v1.11.12 helpers: .vbp line order + deleted-lines evidence.
' =====================================================================
' .vbp LINE-ORDER PRESERVATION
'
' VB6 rewrites the whole .vbp on SaveAs and writes the components in the order the IDE
' holds them in memory. A component Reload MOVES that component to the end of the
' in-memory list, so the next save rewrote the Class= / Module= / Form= lines in a
' different order: a semantically empty diff that polluted git and the gates. These
' helpers snapshot the non-comment line order BEFORE a save, detect a pure reorder after
' it, and put the ORIGINAL order back without dropping anything VB6 wrote. Only the ORDER
' is restored; every line comes from the file VB6 just wrote.
'
' A .vbp comment line starts with an apostrophe; blank lines are cosmetic. The
' ORDER-SENSITIVE sequence is therefore "every non-blank, non-comment line".
' =====================================================================

' the ORDER-SENSITIVE sequence of a line array, plus each entry's 0-based PHYSICAL line
' index. (TextLines already splits CRLF / CR / LF.)

' True when the two sequences carry the SAME multiset of lines, i.e. the difference can
' only be an ORDER change. Duplicates are matched one-for-one, so two identical
' Reference= lines cannot make a reorder look like a content change.

' the setting name of a .vbp line ("Class=CodeTools; CodeTools.cls" -> "Class"), or the
' whole trimmed line when it carries no "=".

' {preserved, sameSet, changes[]}: every line that MOVED, with its physical before/after
' line number and its 1-based order index on both sides (capped at VBP_ORDER_MAX_CHANGES).

' Rewrite AFTER so its non-comment lines follow BEFORE's order. True ONLY when AFTER
' carries the SAME multiset of lines (a pure reorder); a content change is refused rather
' than shuffled, because that would move lines VB6 changed for a reason.

' value of a "Name=value" line of a .vbp text ("" when the line is absent).

' the order sequence as a JSON array, CAPPED at VBP_ORDER_MAX_LINES so a 110-component
' project cannot blow up the receipt. vbpOrderLinesCapped reports the cap.

' an empty JSON array (a Collection), so a receipt can always publish [] instead of dropping
' the key.
Public Function EmptyJsonArray() As Object
    Dim c As Object
    Set c = New Collection
    Set EmptyJsonArray = c
End Function

' the component order the IDE holds IN MEMORY, as a lowercase "a|b|c|" key.
Private Function CompOrderKey() As String
    CompOrderKey = ""
    Dim p As VBIDE.VBProject
    Dim c As VBIDE.VBComponent
    Dim s As String
    On Error Resume Next
    Set p = GetProject()
    If p Is Nothing Then
        Err.Clear
        On Error GoTo 0
        Exit Function
    End If
    For Each c In p.VBComponents
        s = s & LCase$(c.Name) & "|"
    Next
    Err.Clear
    On Error GoTo 0
    CompOrderKey = s
End Function

' every component whose 1-based index changed between two CompOrderKey() snapshots.
Private Function CompOrderMoves(ByVal beforeKey As String, ByVal afterKey As String) As Object
    Dim out As Object
    Set out = New Collection
    If Len(beforeKey) = 0 Or Len(afterKey) = 0 Then
        Set CompOrderMoves = out
        Exit Function
    End If
    Dim a() As String, b() As String
    Dim i As Long, j As Long, nm As String, hit As Long
    a = Split(beforeKey, "|")
    b = Split(afterKey, "|")
    For i = 0 To UBound(a)
        nm = a(i)
        If Len(nm) > 0 Then
            hit = -1
            For j = 0 To UBound(b)
                If b(j) = nm Then
                    hit = j
                    Exit For
                End If
            Next
            If hit >= 0 Then
                If hit <> i Then
                    Dim d As Object
                    Set d = CreateObject("Scripting.Dictionary")
                    d("component") = nm
                    d("beforeIndex") = i + 1
                    d("afterIndex") = hit + 1
                    out.Add d
                End If
            End If
        End If
    Next
    Set CompOrderMoves = out
End Function

' v1.11.12: how many lines a batch REMOVED and the removed text (capped). Counted from
' the SAME line-level LCS preview_edit renders, so the write receipt and the preview
' cannot disagree about what was removed.
Private Function DeletedLinesInfo(ByVal before As String, ByVal after As String) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("deletedLines") = 0
    d("deletedText") = ""
    d("deletedTextLines") = 0
    d("deletedTextTruncated") = False
    d("deletedTextLimit") = VBP_DELETED_MAX_CHARS
    Set DeletedLinesInfo = d
    If before = after Then Exit Function
    Dim plan As Object
    Set plan = EditTxn.DiffPlan(before, after, 0, 0)
    Dim hs As Object
    Set hs = plan("hunks")
    Dim a() As String
    a = McpCls.TextLines(Me, before)
    Dim i As Long, j As Long, h As Object, s As String
    Dim total As Long
    total = 0
    For i = 1 To hs.Count
        Set h = hs(i)
        If CStr(h("kind")) = "delete" Then total = total + CLng(h("oldCount"))
    Next
    Dim txt As String, shown As Long, chars As Long, cut As Boolean
    txt = ""
    shown = 0
    chars = 0
    cut = False
    For i = 1 To hs.Count
        Set h = hs(i)
        If CStr(h("kind")) = "delete" Then
            For j = 0 To CLng(h("oldCount")) - 1
                If Not cut Then
                    s = a(CLng(h("oldStart")) - 1 + j)
                    If chars + Len(s) + 2 > VBP_DELETED_MAX_CHARS Then
                        cut = True
                    Else
                        If shown > 0 Then txt = txt & vbCrLf
                        txt = txt & s
                        chars = chars + Len(s) + 2
                        shown = shown + 1
                    End If
                End If
            Next
        End If
    Next
    d("deletedLines") = total
    d("deletedTextLines") = shown
    d("deletedTextTruncated") = cut
    If cut Then
        d("deletedText") = txt & vbCrLf & "... (truncated: " & CStr(total) & " line(s) removed, " & CStr(shown) & " shown; the cap is VBP_DELETED_MAX_CHARS = " & CStr(VBP_DELETED_MAX_CHARS) & " characters)"
    Else
        d("deletedText") = txt
    End If
End Function

' =====================================================================
' W-H4 (D8+D9): ONE-call debug session.
' The VB6 IDE is STA / single-threaded: while the debugger holds the IDE
' thread no second call can be dispatched, so a session cannot be driven
' call by call. This tool compresses run -> hit -> context -> actions ->
' end into ONE call and returns the transcript.
' It MUST NOT save: control_execution's "run" performs a pre-run flush, so
' the Start command is clicked directly here (receipt: preRunSave=false).
' =====================================================================
' W-H4: a break is observable through TWO independent signals. EbMode (VBA6) flips to 2
' the moment the debugger stops, while the caption/toolbar-derived GetIdeState() may lag;
' polling BOTH (and NOT relying on DoEvents alone, which pumps the host loop and can swallow
' the transition) is what makes hit observation reliable.

' W-H4: a bounded REAL wait (busy tick loop, no DoEvents) so the IDE gets CPU time
' without our pumping swallowing the debug transition.

' W-H4: attribute one observed break to the breakpoint list (increment hitCount).
' The IDE exposes no per-breakpoint hit API, so the attribution is "first armed breakpoint with
' the lowest pane line that has not been counted yet" - recorded with hitCountNote so nobody
' mistakes it for a native counter.

' W-H4: a break entry must NEVER be lost because the position read failed.

Private Function ToolDebugSession(ByVal args As Object) As String
    Dim root As Object, tr As Object
    Set root = CreateObject("Scripting.Dictionary")
    Set tr = New Collection
    root("tool") = "debug_session"
    root("ok") = False
    root("wedged") = False
    root("endQueued") = False
    root("preRunSave") = False
    root("startedPid") = 0
    root("stopReason") = ""
    Dim timeoutMs As Long
    timeoutMs = JsonGetLong(args, "timeout_ms", 60000)
    If timeoutMs <= 0 Then timeoutMs = 60000
    If timeoutMs > 600000 Then timeoutMs = 600000
    root("timeoutMs") = timeoutMs
    root("hitCountTotal") = 0
    Set m_watchExprs = McpDb.DbObjOf(Me, args, "watch")
    m_watchFrame = 0
    root("runArgs") = JsonGetStr(args, "runArgs")
    Dim attach As Boolean
    attach = JsonGetBool(args, "attach", False)
    root("attach") = attach
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    Dim vbpPath As String
    vbpPath = p.FileName
    root("vbpPath") = vbpPath
    Dim diskBefore As String
    diskBefore = ""
    If Len(vbpPath) > 0 Then diskBefore = Sha256HexFile(vbpPath)
    root("diskVbpShaBefore") = diskBefore
    Dim bpsRef As Object
    Set bpsRef = Nothing
    Dim leaveRunning As Boolean
    leaveRunning = True
    On Error GoTo H4_ERR
    Dim st0 As String
    st0 = GetIdeState()
    root("ideStateBefore") = st0
    ' ---- ATTACH mode: drive an ALREADY RUNNING/BROKEN IDE (no Start click) ----
    If attach Then
        If st0 = "design" Then
            root("reason") = "attach_not_running"
            root("howToStart") = "call debug_session once with attach=false (arm+start) and then attach=true with the returned howToContinue arguments"
            leaveRunning = True
            McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, leaveRunning
            ToolDebugSession = JsonStringify(root)
            Exit Function
        End If
        If st0 = "run" Then
            Dim ta As Long
            ta = Util.TickMs()
            Dim reA As Object
            Do While (Util.TickMs() - ta) < timeoutMs
                DoEvents
                If Util.PumpAbortDue() Then Exit Do
                If Util.PumpAbortDue() Then Exit Do
                If Util.PumpAbortDue() Then Exit Do
                McpDb.DbBriefWait Me, 40
                ' R-1021-05: probe the runtime-error box BEFORE DbBreakNow: DbBreakNow asks
                ' CommandBars, which queues while the modal box owns the thread. On a hit the
                ' capture path READS the box, clicks DEBUG (never End) and MEASURES EbMode.
                Set reA = McpRe.ReCaptureRuntimeError(Me, True)
                If CBool(reA("found")) Then Exit Do
                If McpDb.DbBreakNow(Me) Then Exit Do
            Loop
            ' R-1021-05: the run stopped on a runtime-error box
            If Not reA Is Nothing Then
                If CBool(reA("found")) Then
                    McpRe.ReMergeRuntimeError Me, root, reA
                    If CStr(root("state")) = "break" Then Call McpDb.DbAddTranscript(Me, tr, "runtime_error", McpDb.DbPositionOrFallback(Me, root), "")
                    root("actionsNotRun") = True
                    root("actionsSkippedReason") = "the run stopped on a runtime-error box: the add-in read the box, clicked DEBUG and measured the engine state; the requested actions were NOT executed so the captured error and the stop position stay intact"
                    leaveRunning = True
                    McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, leaveRunning
                    ToolDebugSession = JsonStringify(root)
                    Exit Function
                End If
            End If
            If Not McpDb.DbBreakNow(Me) Then
                root("stopReason") = "timeout"
                root("stillRunning") = True
                leaveRunning = True
                McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, leaveRunning
                ToolDebugSession = JsonStringify(root)
                Exit Function
            End If
        End If
        McpDb.DbNoteHit Me, root, bpsRef
        McpDb.DbAddTranscript Me, tr, "break", McpDb.DbPositionOrFallback(Me, root), ""
        McpDb.DbRunActions Me, args, tr, timeoutMs, root
        leaveRunning = False
        McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, leaveRunning
        ToolDebugSession = JsonStringify(root)
        Exit Function
    End If
    ' ---- refuse to start from break (never assume design) --------------
    If (Not attach) And st0 = "break" Then
        root("reason") = "already_in_break"
        root("hint") = "call control_execution{mode:""end""} first, then retry debug_session"
        leaveRunning = True
        McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, leaveRunning
        ToolDebugSession = JsonStringify(root)
        Exit Function
    End If
    ' ---- disk identity of the .vbp BEFORE anything (external read, declared above) ----
    ' ---- arm the breakpoints (pane line space, echoed with disk line) --
    Set bpsRef = McpDb.DbArmBreakpoints(Me, args)
    If Len(m_bpArmRefusal) > 0 Then
        root("ok") = False
        root("reason") = "line_not_breakable_batch"
        root("batchRefused") = m_bpArmRefusal
        root("menuCommandSent") = False
        McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, True
        ToolDebugSession = JsonStringify(root)
        Exit Function
    End If
    Set root("breakpoints") = bpsRef
    ' ---- start the program WITHOUT saving ------------------------------
    Dim whyStart As String
    whyStart = ""
    Dim started As Boolean
    started = McpDb.DbClickStart(Me, whyStart)
    root("executedStart") = started
    root("startWhy") = whyStart
    If started Then
        root("startedPid") = CLng(DbGetCurrentProcessId())
        ' ---- wait for the first hit / exit / timeout -------------------
        ' the Run/Debug menu command is processed ASYNCHRONOUSLY: the state is still
        ' "design" immediately after the click, so waiting for break/design now would
        ' read the click's own latency as an immediate process exit. Wait (bounded) for
        ' the state to LEAVE design first, and only then judge break / exit / timeout.
        Dim tStart As Long
        Dim stLeave As String
        tStart = Util.TickMs()
        ' R-1021-05: probe the modal runtime-error box BEFORE the IDE object model is asked
        ' anything; with the box up nothing on this path may touch CommandBars. A hit is
        ' left to the wait loop below, which captures it (READ -> DEBUG -> MEASURE EbMode).
        If Not McpRe.ReFindRuntimeErrorDialog(Me) Is Nothing Then
            stLeave = "runtime_error"
        Else
            stLeave = GetIdeState()
        End If
        Do While (Util.TickMs() - tStart) < 8000
            If Util.CanPump() Then DoEvents
            If Not McpRe.ReFindRuntimeErrorDialog(Me) Is Nothing Then
                stLeave = "runtime_error"
                Exit Do
            End If
            stLeave = GetIdeState()
            If stLeave <> "design" Then Exit Do
        Loop
        Dim t0 As Long
        Dim stNow As String
        Dim reCap As Object
        t0 = Util.TickMs()
        ' R-1021-05: with the modal runtime-error box up the IDE object model is not
        ' consulted at all on this path (the probe is Win32-only).
        If Not McpRe.ReFindRuntimeErrorDialog(Me) Is Nothing Then
            stNow = "runtime_error"
        Else
            stNow = GetIdeState()
        End If
        Do While (Util.TickMs() - t0) < timeoutMs
            DoEvents
            If Util.PumpAbortDue() Then Exit Do
            If Util.PumpAbortDue() Then Exit Do
            If Util.PumpAbortDue() Then Exit Do
            McpDb.DbBriefWait Me, 40
            ' R-1021-05: probe FIRST: READ the box, click DEBUG (never End) and MEASURE
            ' EbMode. GetIdeState / DbBreakNow are reached ONLY when no box is up.
            Set reCap = McpRe.ReCaptureRuntimeError(Me, True)
            If CBool(reCap("found")) Then
                stNow = "runtime_error"
                Exit Do
            End If
            stNow = GetIdeState()
            If McpDb.DbBreakNow(Me) Then Exit Do
            If stNow = "design" Then Exit Do
        Loop
        root("ideStateAfterWait") = stNow
        ' R-1021-05: the run stopped on a runtime-error box. Report it as its OWN stop
        ' reason; the requested actions are NOT run so the captured error and the stop
        ' position stay intact (call debug_session{attach:true} again to drive them).
        If Not reCap Is Nothing Then
            If CBool(reCap("found")) Then
                McpRe.ReMergeRuntimeError Me, root, reCap
                root("actionsNotRun") = True
                root("actionsSkippedReason") = "the run stopped on a runtime-error box: the add-in read the box, clicked DEBUG and measured the engine state; the requested actions were NOT executed so the captured error and the stop position stay intact"
                If CStr(root("state")) = "break" Then Call McpDb.DbAddTranscript(Me, tr, "runtime_error", McpDb.DbPositionOrFallback(Me, root), "")
                leaveRunning = True
                McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, leaveRunning
                ToolDebugSession = JsonStringify(root)
                Exit Function
            End If
        End If
        If stNow = "break" Then
            root("stopReason") = "initial_break"
            McpDb.DbNoteHit Me, root, bpsRef
            McpDb.DbAddTranscript Me, tr, "break", McpDb.DbPositionOrFallback(Me, root), ""
            McpDb.DbRunActions Me, args, tr, timeoutMs, root
            leaveRunning = False
        ElseIf stNow = "design" Then
            ' STA: the Start command is executed only AFTER this call returns. Do not lie with process_exit.
            root("startedPending") = True
            root("stopReason") = "started"
            root("ideStateAtReturn") = GetIdeState()
            Dim hc As Object
            Set hc = CreateObject("Scripting.Dictionary")
            hc("tool") = "debug_session"
            Dim ha As Object
            Set ha = CreateObject("Scripting.Dictionary")
            ha("attach") = True
            ha("timeout_ms") = timeoutMs
            Set hc("arguments") = ha
            Set root("howToContinue") = hc
            leaveRunning = True
        Else
            root("stopReason") = "timeout"
            root("stillRunning") = True
            leaveRunning = True
        End If
    Else
        root("reason") = "start_command_not_found"
        root("detail") = whyStart
        leaveRunning = True
    End If
    ' ---- ONE finaliser on EVERY path (D2): end attempt + disk identity --
    McpDb.DbFinalize Me, root, tr, vbpPath, diskBefore, leaveRunning
    ToolDebugSession = JsonStringify(root)
    Exit Function

H4_ERR:
    Dim em As String
    em = Err.Description
    On Error Resume Next
    root("ok") = False
    root("reason") = "unexpected_error"
    root("errorMessage") = em
    root("ideStateAfter") = GetIdeState()
    If root("ideStateAfter") = "break" Or root("ideStateAfter") = "run" Then
        root("endQueued") = True
        Set root("howToFinish") = McpDb.DbHowToFinish(Me)
    End If
    If Len(CStr(root("stopReason"))) = 0 Then root("stopReason") = "error"
    McpDb.DbFinalizeDiskAndHits Me, root, vbpPath, diskBefore, tr
    ToolDebugSession = JsonStringify(root)
End Function

' (D1/D2) ONE finaliser for EVERY debug_session return path.
' D1: the End command is QUEUED while the call holds the IDE thread, so an in-call wait can
' never observe it. A still-broken/still-running state after the bounded wait is therefore
' reported as endQueued=true + howToFinish, NOT as wedged. wedged=true is reserved for the
' case where an EbMode=2 break context is held while the IDE's CommandBars model is gone AND
' one activate_component recovery attempt did not bring it back.
' D2: the disk identity (diskVbpShaAfter / savedDuringCall / reorderedDuringCall) is computed
' on EVERY path, including the timeout and the error paths.


' (D2) transcript + disk identity + verdict, ALWAYS, on every return path.

' Click the End menu item WITHOUT the 12 s state wait of control_execution: that wait cannot
' observe a QUEUED command, so the finaliser does its own bounded 3 s confirmation instead.

' (D1/D3) one bounded recovery attempt for a suspended CommandBars window + its receipt block.

' The component to activate when the CommandBars window must be cleared: the ACTIVE one when
' the IDE still knows it, else the first component of the project.

' {NAME:value} objects from the args bag, or Nothing.

' arm every requested breakpoint through the EXISTING native_breakpoint toggle
' path (no new breakpoint code), echo paneLine/diskLine/armed/hitCount.

' click the Start/Continue menu command WITHOUT the pre-run flush




' =====================================================================
' P1/P12: .vbp Reference= paths and junction (link) aliases.
'
' Symptom this exists for: VB6 computes the RELATIVE path of a Reference=
' against the directory the project was OPENED from, so a project opened
' through a directory junction carries a path that resolves only while the
' alias exists. Read from the canonical location the same line resolves beside
' the real tree and the reference is MISSING, although the IDE built fine.
'
' The repair never guesses: a relative path is resolved to a REAL file first
' (alias base, then the canonical base), the real file is re-expressed relative
' to the canonical project directory, and the new value must itself resolve back
' to that same real file before it is written. Absolute, UNC and placeholder
' paths are reported and left alone. The switch VB6MCP_REFS_FROM_ALIAS=1
' restores the legacy behaviour (references left relative to the alias
' directory) for A/B comparison only.
' =====================================================================

' the directory part of a path ("" when there is none).
Public Function DirOfPath(ByVal p As String) As String
    Dim i As Long
    DirOfPath = ""
    If Len(p) = 0 Then Exit Function
    i = InStrRev(p, "\")
    If i > 0 Then DirOfPath = Left$(p, i - 1)
End Function

' the legacy-behaviour switch: 1/true/on/yes => compute references from the
' directory the project was opened from (default: from the canonical path).
Public Function RefsFromAliasOn() As Boolean
    Dim s As String
    s = LCase$(Trim$(Environ$("VB6MCP_REFS_FROM_ALIAS")))
    If Len(s) = 0 Then Exit Function
    If s = "1" Or s = "true" Or s = "on" Or s = "yes" Then RefsFromAliasOn = True
End Function

' {projectPath, realProjectPath, projectPathIsAlias, realPathTier,
'  realPathError, warning, warningDetail, refsBase, refsFromAlias} for the OPEN
' project. projectPath is the spelling the IDE holds; realProjectPath is what
' GetFinalPathNameByHandleW resolves it to.

' the per-call reference evidence: canonicalized[] / skipped[] / unresolvedCount.
Private Function NewRefsInfo() As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    Set d("canonicalized") = New Collection
    Set d("skipped") = New Collection
    d("unresolvedCount") = 0
    Set NewRefsInfo = d
End Function

' the path field of a .vbp Reference= line ("" when the line carries none).
' Layout: Reference=*\G{GUID}#<version>#<lcid>#<path>#<description>

' the same Reference= line with ONLY its path field replaced.

Public Sub RefsRecord(ByRef info As Object, ByVal refName As String, ByVal before As String, _
                       ByVal after As String, ByVal changed As Boolean, ByVal relativeTo As String, _
                       ByVal target As String)
    Dim c As Object
    Set c = CreateObject("Scripting.Dictionary")
    c("name") = refName
    c("before") = before
    c("after") = after
    c("changed") = changed
    c("relativeTo") = relativeTo
    c("target") = target
    c("exists") = True
    info("canonicalized").Add c
End Sub

Public Sub RefsSkip(ByRef info As Object, ByVal refPath As String, ByVal reason As String, ByVal detail As String)
    Dim c As Object
    Set c = CreateObject("Scripting.Dictionary")
    c("path") = refPath
    c("reason") = reason
    c("detail") = detail
    info("skipped").Add c
End Sub

' A/B mode (legacy switch on): rewrite NOTHING, but report every reference path
' so the two arms of the switch can be compared line by line.

' Rewrites the RELATIVE path field of every Reference= line so it resolves from
' realDir. The text is transformed IN MEMORY; the caller writes it once.

' the repair for a save path that does not go through save_project (the in-IDE
' compile route saves the project itself). Returns 1 when the .vbp was written.

Public Function ToolSaveProject(Optional ByVal path As String) As String
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    ' Hard guard: VB6 raises an access violation in USER32 (WER 0xc0000005,
    ' measured 2026-09-21) while saving a project that references a component
    ' file which is missing from disk. Refuse instead of taking the IDE down.
    Dim missing As String
    missing = MissingComponentFiles(p)
    ' VB6 silently DROPS a component whose file is missing, so the dangling
    ' reference is only visible in the .vbp text. Saving while it is there
    ' crashes the IDE (access violation in USER32), so refuse and say exactly
    ' which line to fix.
    Dim dangling As String
    dangling = ""
    If Len(p.FileName) > 0 Then dangling = MissingVbpFiles(p.FileName)
    If Len(missing) > 0 Then dangling = dangling & missing
    If Len(dangling) > 0 Then
        OpLog "save_project REFUSED: dangling references " & dangling
        Err.Raise vbObjectError + 88, "CodeTools", "refusing to save: the project references component files that do not exist on disk, and saving this state crashes VB6 (access violation in USER32). Restore the files or remove the dangling lines from the .vbp first. Missing: " & dangling
    End If
    AuditAdd "save_project", "begin", p.Name & " gitpath=" & p.FileName
    Dim pPath As String
    pPath = Trim$(path)
    ' remember every file this call writes, so the receipt can list them.
    Dim vbpWritten As String
    vbpWritten = ""
    On Error Resume Next
    If Len(pPath) > 0 Then
        If Len(p.FileName) = 0 Or LCase$(p.FileName) <> LCase$(pPath) Then
            Err.Clear
            p.SaveAs pPath
            If Err.Number = 0 Then vbpWritten = pPath Else Err.Clear
        End If
    End If
    On Error GoTo 0
    Dim baseDir As String
    baseDir = McpProjTools.ProjectDir(Me)
    Dim saved As Object
    Set saved = New Collection
    Dim skipped As Object
    Set skipped = New Collection
    Dim cWrites As Object
    Set cWrites = New Collection
    ' reopen: {component name -> file snapshot BEFORE this call rewrote
    ' it}. The receipt then reports the write's own evidence (size / mtime /
    ' digest moved) instead of asserting the write happened from the pane alone.
    Dim preSnap As Object
    Set preSnap = CreateObject("Scripting.Dictionary")
    Dim comp As VBIDE.VBComponent
    For Each comp In p.VBComponents
        On Error Resume Next
        Dim dirty As Boolean
        dirty = comp.IsDirty
        On Error GoTo 0
        ' forms: IsDirty is unreliable (designer edits do not always
        ' set it) - treat components that were never saved (no file
        ' name) as needing a save so run/make never trigger VB6's
        ' modal Save dialogs
        If dirty Or Len(comp.FileNames(1)) = 0 Then
            If Len(comp.FileNames(1)) > 0 Then
                Dim cf As String
                cf = comp.FileNames(1)
                On Error Resume Next
                Set preSnap(comp.Name) = FileSnapOf(cf)
                On Error GoTo 0
                comp.SaveAs cf
                ManifestAdd cWrites, cf
                saved.Add comp.Name
            ElseIf Len(baseDir) > 0 Then
                Dim ext As String
                Select Case comp.Type
                    Case 1  ' vbext_ct_StdModule
                        ext = ".bas"
                    Case 2  ' vbext_ct_ClassModule
                        ext = ".cls"
                    Case 3, 5, 6  ' MSForm / VBForm / VBMDIForm
                        ' (this build reports standard forms as type 5)
                        ext = ".frm"
                    Case 4  ' vbext_ct_ResFile
                        ext = ".res"
                    Case Else
                        ext = ""
                End Select
                If Len(ext) > 0 Then
                    Dim tgt As String
                    tgt = baseDir & "\" & comp.Name & ext
                    On Error Resume Next
                    Set preSnap(comp.Name) = FileSnapOf(tgt)
                    On Error GoTo 0
                    comp.SaveAs tgt
                    ManifestAdd cWrites, tgt
                    saved.Add comp.Name
                Else
                    skipped.Add comp.Name
                End If
            Else
                skipped.Add comp.Name
            End If
        End If
    Next
    ' =====================================================================
    ' (B-family): DO NOT trust VBProject.Saved, and ASSERT the result by reading
    ' the files back.  Measured on this build: after set_project_options{description} the
    ' IDE still answered Saved=True, the old code answered projectSaved=True, and the .vbp
    ' on disk carried NO Description= line - a project-level change was silently NOT
    ' persisted while the receipt claimed success.  The project file is flushed
    ' UNCONDITIONALLY (VB6 skips the write when the in-memory project already equals the
    ' file, so this does not churn it) and BOTH the project file and every component this
    ' call reported as saved are verified on disk afterwards.
    ' =====================================================================
    Dim vbpPath As String
    vbpPath = ""
    If Len(pPath) > 0 Then
        vbpPath = pPath
    ElseIf Len(p.FileName) > 0 Then
        vbpPath = p.FileName
    End If
    ' v1.11.12: snapshot the .vbp NON-COMMENT line order BEFORE the flush. VB6 writes the
    ' components in the order the IDE holds them in memory, and a component Reload moves a
    ' component to the end of that list, so the save came back with the same lines in a
    ' different order (a semantically empty diff that polluted git and the gates).
    Dim vbpOrderReady As Boolean
    Dim vbpBeforeSeq() As String, vbpBeforeIdx() As Long
    Dim vbpTextBefore As String
    vbpOrderReady = False
    vbpTextBefore = ""
    If Len(vbpPath) > 0 Then
        vbpTextBefore = ProjShip.ReadTextFile(vbpPath)
        If Len(vbpTextBefore) > 0 Then
            Dim vbpBeforeLines() As String
            vbpBeforeLines = McpCls.TextLines(Me, vbpTextBefore)
            vbpBeforeSeq = McpProjTools.VbpOrderSeq(Me, vbpBeforeLines, vbpBeforeIdx)
            vbpOrderReady = True
        End If
    End If
    Dim vbpBefore As Object
    Set vbpBefore = FileSnapOf(vbpPath)
    Dim projectSaveErr As String
    projectSaveErr = ""
    If Len(vbpPath) > 0 Then
        On Error Resume Next
        Err.Clear
        p.SaveAs vbpPath
        If Err.Number <> 0 Then
            projectSaveErr = "0x" & Hex$(Err.Number) & " " & Err.Description
            Err.Clear
        End If
        On Error GoTo 0
        If Err.Number = 0 Then vbpWritten = vbpPath
    End If
    Dim vbpAfter As Object
    Set vbpAfter = FileSnapOf(vbpPath)
    ' v1.11.12: ORDER + REVISION evidence, then PUT THE ORIGINAL ORDER BACK when VB6 only
    ' reordered the same lines. Only the ORDER is restored - every line comes from the file
    ' VB6 just wrote - so nothing the IDE wrote is dropped.
    Dim vbpTextAfter As String
    Dim vbpAfterSeq() As String, vbpAfterIdx() As Long
    Dim vbpOrderPreserved As Boolean, vbpOrderRestored As Boolean, vbpOrderFinalOk As Boolean
    Dim vbpSameSet As Boolean, vbpRestoreFailed As Boolean, vbpAfterSeqOk As Boolean
    Dim vbpDelta As Object, vbpOrderChanges As Object
    Dim vbpRestoreErr As String, vbpOrderNote As String
    Dim vbpRevBefore As String, vbpRevAfter As String
    Set vbpOrderChanges = New Collection
    vbpOrderPreserved = True
    vbpOrderRestored = False
    vbpOrderFinalOk = True
    vbpSameSet = False
    vbpAfterSeqOk = False
    vbpRestoreFailed = False
    vbpRestoreErr = ""
    vbpOrderNote = ""
    vbpTextAfter = ""
    vbpRevBefore = McpProjTools.VbpSettingValue(Me, vbpTextBefore, "RevisionVer")
    vbpRevAfter = ""
    ' P1/P12: WHERE the project is open (alias spelling) and WHERE it really
    ' lives (canonical spelling). Computed ONCE and published by the receipt; it
    ' is also the base the Reference= rewrite below uses.
    Dim projPaths As Object
    Set projPaths = McpProjTools.ProjectPathInfo(Me, p)
    Dim refsInfo As Object
    Set refsInfo = NewRefsInfo()
    Dim refsRewritePasses As Long
    refsRewritePasses = 0
    Dim refsAliasDir As String, refsRealDir As String
    refsAliasDir = DirOfPath(CStr(projPaths("projectPath")))
    refsRealDir = DirOfPath(CStr(projPaths("realProjectPath")))
    If vbpOrderReady Then
        vbpTextAfter = ProjShip.ReadTextFile(vbpPath)
        If Len(vbpTextAfter) > 0 Then
            Dim vbpAfterLines() As String
            vbpAfterLines = McpCls.TextLines(Me, vbpTextAfter)
            vbpAfterSeq = McpProjTools.VbpOrderSeq(Me, vbpAfterLines, vbpAfterIdx)
            vbpAfterSeqOk = True
            Set vbpDelta = McpProjTools.VbpOrderDelta(Me, vbpBeforeSeq, vbpBeforeIdx, vbpAfterSeq, vbpAfterIdx)
            vbpOrderPreserved = CBool(vbpDelta("preserved"))
            vbpSameSet = CBool(vbpDelta("sameSet"))
            Set vbpOrderChanges = vbpDelta("changes")
            ' v1.11.12 order restore and the P1/P12 Reference= rewrite are applied
            ' to the SAME in-memory text and flushed in ONE write pass, so a save
            ' never rewrites the .vbp twice.
            Dim vbpRestoreNeeded As Boolean
            Dim vbpWriteText As String
            vbpRestoreNeeded = False
            vbpWriteText = vbpTextAfter
            If Not vbpOrderPreserved Then
                If vbpSameSet Then
                    Dim vbpRestoredText As String
                    If McpProjTools.VbpRestoreOrder(Me, vbpTextAfter, vbpBeforeSeq, vbpRestoredText) Then
                        vbpWriteText = vbpRestoredText
                        vbpRestoreNeeded = True
                    Else
                        vbpRestoreFailed = True
                        vbpRestoreErr = "the reordered .vbp does not carry the same line set, so a pure reorder could not be rebuilt"
                    End If
                Else
                    vbpOrderNote = "the .vbp CONTENT changed (a line was added, removed or edited), so only a pure reorder can be restored; the ORDER was left exactly as VB6 wrote it and is reported in vbpOrderChanges[]"
                End If
            End If
            If Not vbpRestoreFailed Then
                vbpWriteText = McpProjTools.VbpRefRewriteText(Me, vbpWriteText, refsAliasDir, refsRealDir, projPaths, refsInfo)
            End If
            If Not vbpRestoreFailed Then
                If StrComp(vbpWriteText, vbpTextAfter, vbBinaryCompare) <> 0 Then
                    If ProjShip.WriteTextFile(vbpPath, vbpWriteText) Then
                        refsRewritePasses = 1
                        Dim vbpBack As String
                        vbpBack = ProjShip.ReadTextFile(vbpPath)
                        If Len(vbpBack) > 0 Then
                            vbpTextAfter = vbpBack
                            Dim vbpBackLines() As String
                            vbpBackLines = McpCls.TextLines(Me, vbpBack)
                            vbpAfterSeq = McpProjTools.VbpOrderSeq(Me, vbpBackLines, vbpAfterIdx)
                            vbpAfterSeqOk = True
                            vbpOrderRestored = vbpRestoreNeeded
                            If vbpRestoreNeeded Then
                                Dim z As Long
                                vbpOrderRestored = McpProjTools.VbpSameLineSet(Me, vbpBeforeSeq, vbpAfterSeq)
                                If vbpOrderRestored Then
                                    If UBound(vbpAfterSeq) <> UBound(vbpBeforeSeq) Then
                                        vbpOrderRestored = False
                                    Else
                                        For z = 0 To UBound(vbpBeforeSeq)
                                            If vbpAfterSeq(z) <> vbpBeforeSeq(z) Then vbpOrderRestored = False
                                        Next
                                    End If
                                End If
                                If Not vbpOrderRestored Then
                                    vbpRestoreFailed = True
                                    vbpRestoreErr = "the original order was written back but the READ-BACK .vbp still does not carry it"
                                End If
                            End If
                        Else
                            vbpRestoreFailed = True
                            vbpRestoreErr = "the .vbp could not be read back after the order/reference rewrite"
                        End If
                    Else
                        vbpRestoreFailed = True
                        vbpRestoreErr = "writing the original line order / repaired references back failed (ProjShip.WriteTextFile returned False: the bytes could not be read back)"
                    End If
                End If
            End If
            vbpOrderFinalOk = (vbpOrderPreserved Or vbpOrderRestored)
            If vbpRestoreFailed Then vbpOrderFinalOk = False
            Set vbpAfter = FileSnapOf(vbpPath)
        Else
            vbpOrderFinalOk = False
            vbpRestoreFailed = True
            vbpRestoreErr = "the .vbp could not be read back after the save, so the line order could not be verified"
        End If
        vbpRevAfter = McpProjTools.VbpSettingValue(Me, vbpTextAfter, "RevisionVer")
    Else
        vbpOrderNote = "no pre-save snapshot of the .vbp was possible (the project had no file on disk before this call), so the order contract was not evaluated"
    End If
    Dim vbpMissing As String
    vbpMissing = McpProjTools.VbpMissingProps(Me, vbpPath, p)
    Dim badComps As Object
    Set badComps = New Collection
    ' reopen: the independent POSITIVE assertions are a separate failure
    ' family with their own sentence, so a receipt can no longer say "still
    ' differs from the pane" when the real problem was a missing head.
    Dim badPos As Object
    Set badPos = New Collection
    Dim checks As Object
    Set checks = New Collection
    Dim ci As Long
    Dim cn As String
    On Error Resume Next
    For ci = 1 To saved.Count
        cn = CStr(saved(ci))
        Err.Clear
        Dim cMatched As Boolean
        cMatched = DiskMatchesPane(cn, CompText(cn))
        If Not cMatched Then badComps.Add cn
        Dim cBefore As Object
        If preSnap.Exists(cn) Then
            Set cBefore = preSnap(cn)
        Else
            Set cBefore = FileSnapOf("")
        End If
        Dim cRec As Object
        Set cRec = ComponentCheckRecord(cn, cMatched, cBefore)
        If Not CBool(cRec("positiveAssertionsOk")) Then badPos.Add cn
        checks.Add cRec
        Err.Clear
    Next
    On Error GoTo 0
    Dim projectFileOk As Boolean
    projectFileOk = True
    If Len(vbpPath) > 0 Then
        If Not CBool(vbpAfter("exists")) Then projectFileOk = False
        If Len(vbpMissing) > 0 Then projectFileOk = False
    End If
    Dim okSave As Boolean
    okSave = projectFileOk
    If okSave Then okSave = (badComps.Count = 0)
    If okSave Then okSave = (badPos.Count = 0)
    If okSave Then okSave = (Len(projectSaveErr) = 0)
    If okSave Then okSave = CBool(p.Saved)
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("project") = p.Name
    root("projectSaved") = okSave
    root("ok") = okSave
    If Not okSave Then
        Dim whySave As String
        whySave = ""
        If Len(projectSaveErr) > 0 Then whySave = "the project file flush raised " & projectSaveErr
        If Len(whySave) = 0 Then
            If Len(vbpPath) > 0 Then
                If Not CBool(vbpAfter("exists")) Then whySave = "the project file is not on disk after the flush attempt"
            End If
        End If
        If Len(whySave) = 0 Then
            If Len(vbpMissing) > 0 Then whySave = "the project file on disk does NOT carry the current project-level value(s) [" & vbpMissing & "]; the IDE reported Saved=" & CStr(p.Saved) & " but the file was not rewritten"
        End If
        If Len(whySave) = 0 Then
            If badComps.Count > 0 Then whySave = "reported as saved but the file on disk still differs from the pane: " & JoinText(badComps, ",")
        End If
        If Len(whySave) = 0 Then
            If badPos.Count > 0 Then whySave = "reported as saved but the file failed the independent positive assertions (exists / non-empty / head still present on disk): " & JoinText(badPos, ",")
        End If
        If Len(whySave) = 0 Then whySave = "the IDE still reports unsaved project changes after the flush attempt (Saved=False)"
        root("okReason") = whySave
    End If
    Dim pf As Object
    Set pf = CreateObject("Scripting.Dictionary")
    pf("path") = vbpPath
    pf("written") = vbpWritten
    pf("changedOnDisk") = (CStr(vbpBefore("sha256")) <> CStr(vbpAfter("sha256")))
    pf("sha256Before") = vbpBefore("sha256")
    pf("sha256After") = vbpAfter("sha256")
    pf("sizeBefore") = vbpBefore("size")
    pf("sizeAfter") = vbpAfter("size")
    pf("mtimeBefore") = vbpBefore("mtimeText")
    pf("mtimeAfter") = vbpAfter("mtimeText")
    pf("missingProjectValues") = vbpMissing
    Set root("projectFile") = pf
    ' R-1021-01: the SAME write-proof field family as the file writers, for the
    ' project FILE. save_project is the one writer that CAN claim verifiedOnDisk:
    ' the .vbp is read back (and re-hashed here) after the flush.
    root("bytes") = vbpAfter("size")
    root("sha256") = vbpAfter("sha256")
    root("sha256Source") = "readback"
    If CBool(vbpAfter("exists")) Then
        Dim vbpRehash As String
        vbpRehash = Encoding.Sha256HexFile(vbpPath)
        root("verifiedOnDisk") = (Len(vbpRehash) > 0 And StrComp(vbpRehash, CStr(vbpAfter("sha256")), vbTextCompare) = 0)
        If Not CBool(root("verifiedOnDisk")) Then root("verifyNote") = "the second read of the .vbp produced " & vbpRehash & "; verifiedOnDisk=false"
    Else
        root("verifiedOnDisk") = False
    End If
    ' P1/P12: WHERE the project is open vs WHERE it really lives, and what the
    ' single .vbp write pass did to the relative Reference= paths.
    root("projectPath") = projPaths("projectPath")
    root("realProjectPath") = projPaths("realProjectPath")
    root("projectPathIsAlias") = projPaths("projectPathIsAlias")
    root("realPathTier") = projPaths("realPathTier")
    root("realPathError") = projPaths("realPathError")
    root("warning") = projPaths("warning")
    If Len(CStr(projPaths("warningDetail"))) > 0 Then root("warningDetail") = projPaths("warningDetail")
    root("refsBase") = projPaths("refsBase")
    root("refsFromAlias") = projPaths("refsFromAlias")
    root("refsRewritePasses") = refsRewritePasses
    Set root("refsCanonicalized") = refsInfo("canonicalized")
    Set root("refsSkipped") = refsInfo("skipped")
    root("refsUnresolvedCount") = refsInfo("unresolvedCount")
    ' reopen: per-component evidence behind "this component was saved".
    ' ALWAYS present (empty array when nothing was saved). Each record carries
    ' designerComponent / designerCheck (code-only for .frm/.ctl/.dsr/.pag),
    ' matched, the independent positive assertions and the write's own
    ' size+mtime+digest movement.
    Set root("componentChecks") = checks
    Set root("savedComponents") = saved
    Set root("skippedComponents") = skipped
    ' the write manifest is ALWAYS present (empty array when the call wrote
    ' nothing, e.g. an already-clean project). It lists every file this call wrote: the project
    ' file when it was (re)saved plus each component file written by SaveAs. That is a superset
    ' of "files inside the project directory" - a component bound to a file outside it is listed
    ' too, so nothing can hide behind the field name.
    Dim pdw As Object
    Set pdw = New Collection
    ManifestAdd pdw, vbpWritten
    Dim wi As Long
    On Error Resume Next
    For wi = 1 To cWrites.Count
        ManifestAdd pdw, cWrites(wi)
    Next
    On Error GoTo 0
    ManifestMergeUndo pdw
    Set root("projectDirWrites") = pdw
    ' v1.11.12: .vbp ORDER + REVISION evidence (the top-level field names are the contract).
    root("vbpOrderChecked") = vbpOrderReady
    root("vbpOrderPreserved") = vbpOrderPreserved
    root("vbpOrderRestored") = vbpOrderRestored
    root("vbpOrderFinalPreserved") = vbpOrderFinalOk
    Set root("vbpOrderChanges") = vbpOrderChanges
    root("vbpOrderChangeCount") = vbpOrderChanges.Count
    root("vbpRevisionBefore") = vbpRevBefore
    root("vbpRevisionAfter") = vbpRevAfter
    Dim vbpRevBumped As Boolean
    vbpRevBumped = False
    If Len(vbpRevBefore) > 0 Then
        If Len(vbpRevAfter) > 0 Then
            If vbpRevBefore <> vbpRevAfter Then vbpRevBumped = True
        End If
    End If
    root("vbpRevisionBumped") = vbpRevBumped
    root("vbpOrderLinesCapped") = VBP_ORDER_MAX_LINES
    If vbpOrderReady Then
        Set root("vbpOrderLinesBefore") = McpProjTools.VbpSeqJsonArray(Me, vbpBeforeSeq)
        If vbpAfterSeqOk Then
            Set root("vbpOrderLinesAfter") = McpProjTools.VbpSeqJsonArray(Me, vbpAfterSeq)
        Else
            Set root("vbpOrderLinesAfter") = EmptyJsonArray()
        End If
    Else
        Set root("vbpOrderLinesBefore") = EmptyJsonArray()
        Set root("vbpOrderLinesAfter") = EmptyJsonArray()
    End If
    If Len(vbpOrderNote) = 0 Then
        If CBool(root("vbpRevisionBumped")) Then
            vbpOrderNote = "RevisionVer WAS bumped by this save: both values were READ from the .vbp on disk before and after the flush (" & vbpRevBefore & " -> " & vbpRevAfter & ")."
        Else
            vbpOrderNote = "RevisionVer was NOT bumped by this save: both values were READ from the .vbp on disk before and after the flush (" & vbpRevBefore & " -> " & vbpRevAfter & ")."
        End If
        If vbpOrderPreserved Then
            vbpOrderNote = vbpOrderNote & " The non-comment line order was preserved by VB6 (no reorder was observed)."
        ElseIf vbpOrderRestored Then
            vbpOrderNote = vbpOrderNote & " VB6 wrote the same lines in a different order; the pre-save order was RESTORED on disk (vbpOrderRestored=true) and read back."
        Else
            vbpOrderNote = vbpOrderNote & " VB6 wrote a different order and it was NOT restored: " & vbpRestoreErr
        End If
    End If
    root("vbpOrderNote") = vbpOrderNote
    If vbpRestoreFailed Then
        ' a save that leaves the .vbp reordered when it COULD be restored is reported as a
        ' structured failure instead of a quiet success.
        root("ok") = False
        root("projectSaved") = okSave
        root("reason") = "vbp_order_restore_failed"
        root("okReason") = "the project file was saved but its original line order could NOT be restored: " & vbpRestoreErr
    End If
    ToolSaveProject = JsonStringify(root)
End Function

' reopen: the evidence record for ONE component this call reported as
' saved. A code-section match alone is not accepted: the file must exist, be
' non-empty and still carry its head, and the write's own size/mtime/digest
' movement is reported (changedOnDisk) so a caller can see the flush did work.
' NOTE: changedOnDisk is evidence, NOT a gate - VB6 skips the write when the
' in-memory project already equals the file, and a dirty-but-identical component
' is a legitimate no-op save (gating on it would re-create the false failure this
' fix removes).
Private Function ComponentCheckRecord(ByVal name As String, ByVal matched As Boolean, _
                                      ByVal before As Object) As Object
    On Error Resume Next
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("name") = name
    d("matched") = matched
    Dim f As String
    f = ""
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    If Not comp Is Nothing Then f = comp.FileNames(1)
    Dim ext As String
    ext = ""
    If InStrRev(f, ".") > 0 Then ext = LCase$(Mid$(f, InStrRev(f, ".")))
    Dim designer As Boolean
    designer = IsDesignerExt(ext)
    d("designerComponent") = designer
    If designer Then
        d("designerCheck") = "code-only"
    Else
        d("designerCheck") = "not-applicable"
    End If
    d("path") = f
    Dim after As Object
    Set after = FileSnapOf(f)
    d("exists") = CBool(after("exists"))
    d("sizeAfter") = CDbl(after("size"))
    d("sha256After") = CStr(after("sha256"))
    d("existsBefore") = CBool(before("exists"))
    d("sizeBefore") = CDbl(before("size"))
    d("sha256Before") = CStr(before("sha256"))
    d("mtimeBefore") = CStr(before("mtimeText"))
    d("mtimeAfter") = CStr(after("mtimeText"))
    d("changedOnDisk") = (CStr(before("sha256")) <> CStr(after("sha256")))
    Dim disk As String
    disk = ""
    If Len(f) > 0 Then disk = Build.ReadLogAnsi(f)
    Dim headFound As Boolean
    Dim headKind As String
    Dim dummy As String
    headFound = False
    headKind = "none"
    dummy = ""
    If Len(disk) > 0 Then dummy = CodeSectionOfDisk(disk, headFound, headKind)
    d("headerFound") = headFound
    d("headerKind") = headKind
    Dim posOk As Boolean
    posOk = True
    If Not CBool(after("exists")) Then posOk = False
    If CDbl(after("size")) <= 0 Then posOk = False
    If designer Then
        If Not headFound Then posOk = False
    End If
    d("positiveAssertionsOk") = posOk
    Set ComponentCheckRecord = d
End Function

' Resolve the real build target and never leave it empty.
' VB6 opens its Make Project file dialog whenever BuildFileName is empty,
' and a title-based dialog match cannot rescue that.
Private Function MakeTargetPath(ByVal p As VBIDE.VBProject, ByVal outputPath As String) As String
    Dim dir As String, stem As String, ext As String
    If Len(outputPath) > 0 Then
        MakeTargetPath = ResolvePath(outputPath)
        Exit Function
    End If
    If Len(p.BuildFileName) > 0 Then
        MakeTargetPath = p.BuildFileName
        Exit Function
    End If
    If Len(p.FileName) = 0 Then Exit Function
    dir = Left$(p.FileName, InStrRev(p.FileName, "\"))
    stem = Mid$(p.FileName, Len(dir) + 1)
    If LCase$(Right$(stem, 4)) = ".vbp" Then stem = Left$(stem, Len(stem) - 4)
    Select Case p.Type
        Case 3: ext = ".dll"
        Case 4: ext = ".ocx"
        Case Else: ext = ".exe"
    End Select
    MakeTargetPath = dir & stem & ext
End Function

' (the product-artifact review / the artifact review / the build-state review): the artifact is a PRODUCT, not scratch
' space. The old implementation DELETED the existing output before every Make
' ("delete the target first, or VB6 pops an overwrite dialog"), so a Make that
' failed, timed out, or merely put up VB6's own Make Project box left the caller
' with NO artifact at all - a real add-in EXE was measured going 5,750,837 B ->
' ENOENT / size 0, and had to restore it from a backup. Now the old artifact is
' MOVED ASIDE (never deleted), restored on every failure path, and its
' {exists,size,mtime,sha256} is reported before and after as output{}.
' =====================================================================
' (the product-artifact review / the artifact review / the build-state review / the artifact-lock review): artifact bookkeeping.
' =====================================================================

' {path,exists,size,mtime,mtimeText,sha256} of a build artifact. A build receipt
' can then never be handed back without saying what happened to the product itself.
Private Function ArtifactFullSnap(ByVal path As String) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("path") = path
    d("exists") = False
    d("size") = 0
    d("mtime") = 0
    d("mtimeText") = ""
    ' (F1): the digest key is OMITTED (and a reason given) whenever the
    ' digest cannot be computed. Before this, an exclusive-locked artifact was reported
    ' as sha256=E3B0C442... - the digest of an EMPTY input - while exists=true and
    ' size=16384. Publishing a wrong value is worse than omitting the field.
    d("sha256Available") = False
    d("sha_unavailable_reason") = "artifact_does_not_exist"
    On Error Resume Next
    If Len(path) > 0 Then
        Dim fso As Object
        Set fso = CreateObject("Scripting.FileSystemObject")
        If fso.FileExists(path) Then
            d("exists") = True
            d("size") = CDbl(fso.GetFile(path).Size)
            d("mtime") = CDbl(fso.GetFile(path).DateLastModified)
            d("mtimeText") = Format$(fso.GetFile(path).DateLastModified, "yyyy-mm-dd hh:nn:ss")
            Dim shaWhy As String
            Dim hv As String
            shaWhy = ""
            hv = Build.FileSha256Why(path, shaWhy)
            If Len(hv) > 0 Then
                d("sha256") = hv
                d("sha256Available") = True
                d("sha_unavailable_reason") = ""
            Else
                d("sha_unavailable_reason") = shaWhy
            End If
        End If
    End If
    On Error GoTo 0
    Set ArtifactFullSnap = d
End Function

' (R1): reading an ABSENT dictionary key with the default-property syntax
' auto-ADDS it as Empty (a Scripting.Dictionary gotcha) and CStr(Empty) is "", so a
' snapshot whose digest could not be computed must be read deliberately, not with CStr.
Private Function SnapSha(ByVal snap As Object) As String
    SnapSha = ""
    If snap Is Nothing Then Exit Function
    Dim v As Variant
    On Error Resume Next
    Err.Clear
    v = snap("sha256")
    If Err.Number <> 0 Then
        Err.Clear
        On Error GoTo 0
        Exit Function
    End If
    On Error GoTo 0
    If IsNull(v) Then Exit Function
    SnapSha = CStr(v)
End Function

' (the artifact-lock review / S point 5): is the artifact actually LOCKED by someone?
' WMI names a lock owner only when the file is a running process image, so an
' independent test is needed: try to take an exclusive lock ourselves. Opening
' For Binary with Lock Read Write never truncates the file, and it fails with
' error 70 when another process holds the file.
Private Function ArtifactWriteLocked(ByVal path As String) As Boolean
    ArtifactWriteLocked = False
    If Len(path) = 0 Then Exit Function
    On Error Resume Next
    If Dir$(path) = "" Then Exit Function
    Dim fn As Long
    fn = FreeFile
    Err.Clear
    Open path For Binary Access Read Lock Read Write As #fn
    If Err.Number <> 0 Then
        ArtifactWriteLocked = True
        Err.Clear
        Exit Function
    End If
    Close #fn
    On Error GoTo 0
End Function

' which process holds the artifact? Windows has no API that
' names a file lock owner, so the RUNNING IMAGE is matched instead: a client that
' holds the built .exe has it as its process image. Best effort - 0 means unknown,
' and a caller must never present 0 as "not locked".
Private Function ArtifactHolderPid(ByVal path As String) As Long
    ArtifactHolderPid = 0
    If Len(path) = 0 Then Exit Function
    On Error Resume Next
    If Dir$(path) = "" Then Exit Function
    ' (F3): ExecutablePath alone MISSED a real holder (the verifier measured
    ' the holder as pid 19340 while this function answered 0). Three passes now:
    '   (1) same normalized full path, (2) same FILE NAME, (3) the artifact path named in
    '   a process command line. A pass-2/3 hit is weaker, so it is only used when no
    '   exact hit exists - and a genuinely unnamed holder still answers 0, which the
    '   receipt must describe as UNKNOWN (never as "unlocked").
    Dim svc As Object, col As Object, o As Object, exe As String, cmd As String
    Dim wantNorm As String, wantBase As String
    wantNorm = LCase$(Replace(path, "/", "\"))
    wantBase = LCase$(Mid$(path, InStrRev(path, "\") + 1))
    Dim weakPid As Long
    weakPid = 0
    Set svc = GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
    If svc Is Nothing Then Exit Function
    Set col = svc.ExecQuery("SELECT ProcessId, ExecutablePath, CommandLine FROM Win32_Process")
    If col Is Nothing Then Exit Function
    For Each o In col
        exe = ""
        exe = CStr(o.ExecutablePath)
        If Len(exe) > 0 Then
            If StrComp(LCase$(Replace(exe, "/", "\")), wantNorm, vbTextCompare) = 0 Then
                ArtifactHolderPid = CLng(o.ProcessId)
                Exit For
            End If
            If weakPid = 0 Then
                If LCase$(Mid$(exe, InStrRev(exe, "\") + 1)) = wantBase Then weakPid = CLng(o.ProcessId)
            End If
        End If
        If weakPid = 0 Then
            cmd = ""
            cmd = CStr(o.CommandLine)
            If Len(cmd) > 0 Then
                If InStr(1, cmd, path, vbTextCompare) > 0 Then weakPid = CLng(o.ProcessId)
            End If
        End If
    Next
    If ArtifactHolderPid = 0 Then ArtifactHolderPid = weakPid
    On Error GoTo 0
End Function

' (discipline 98): ONE key set for make_project on EVERY path, so no
' branch can silently drop a field the caller depends on. Callers overwrite what
' they know; everything else keeps the documented default.
' =====================================================================
' (A10): LAA (IMAGE_FILE_LARGE_ADDRESS_AWARE) is applied by the
' MCP add-in ITSELF - no external EditBin.exe is required.
' VB6's linker does not set PE Characteristics bit 0x0020, and the author's
' release script used to patch it afterwards, so every build that went through
' make_project silently lost the flag. The PE header is now rewritten in place
' (exactly 2 bytes, one Put), re-read to VERIFY, and rolled back when the
' verification fails. An artifact that already carries the flag is untouched.
' =====================================================================
' (A10): is the IMAGE signed?  IMAGE_DIRECTORY_ENTRY_SECURITY (index 4)
' of the optional header's data directory names the certificate table. A non-zero
' size means an Authenticode signature is attached, and rewriting the PE header
' afterwards would invalidate it - so LaaPatchJson refuses instead of breaking it
' silently. Only the SIZE field is read (the offset differs between PE32/PE32+).
Private Function PeCertTableSize(ByVal path As String, ByRef certBytes As Long, ByRef ok As Boolean, ByRef errMsg As String) As Boolean
    PeCertTableSize = False
    certBytes = 0
    ok = False
    errMsg = ""
    Dim f As Integer
    On Error GoTo Bad
    f = FreeFile
    Open path For Binary Access Read As #f
    Dim sig As Long
    Get #f, 1, sig
    If (sig And &HFFFF&) <> &H5A4D& Then
        Close #f
        errMsg = "not a PE image"
        Exit Function
    End If
    Dim lfanew As Long
    Get #f, 61, lfanew
    If lfanew <= 0 Then
        Close #f
        errMsg = "e_lfanew is invalid"
        Exit Function
    End If
    Dim optPos As Long
    optPos = lfanew + 25
    Dim magic As Integer
    Get #f, optPos, magic
    Dim sizePos As Long
    If magic = &H10B Then
        sizePos = optPos + 128 + 4
    ElseIf magic = &H20B Then
        sizePos = optPos + 144 + 4
    Else
        Close #f
        errMsg = "unknown optional-header magic " & CStr(magic)
        Exit Function
    End If
    Dim sv As Long
    Get #f, sizePos, sv
    Close #f
    certBytes = sv
    ok = True
    PeCertTableSize = True
    Exit Function
Bad:
    Dim en As Long, ed As String
    en = Err.Number
    ed = Err.Description
    On Error Resume Next
    Close #f
    errMsg = "could not read the optional header: VB error " & CStr(en) & " (" & ed & ")"
    Err.Clear
End Function

' (A10 constraint 2): LAA only enlarges a 32-bit image's user address
' space on a 64-bit Windows (or a 32-bit Windows booted with /3GB). Report whether
' the flag can actually take effect on THIS machine instead of implying it always does.
Private Function LaaMachineEffective() As Boolean
    Dim pa As String, pa32 As String
    pa = UCase$(Environ$("PROCESSOR_ARCHITECTURE"))
    pa32 = UCase$(Environ$("PROCESSOR_ARCHITEW6432"))
    LaaMachineEffective = (Len(pa32) > 0) Or (pa = "AMD64") Or (pa = "IA64")
End Function

' =====================================================================
' (A10): WHERE does the LAA decision come from?
' Priority: per-call parameter laa > the .vbp NAMED section [VB6MCP] (LAA / LAANote)
' > the optional sidecar <vbpDir>\.vb6mcp.json > the environment variable VB6MCP_LAA
' > the global default (ON).
' Survival rule for the .vbp source: a NAMED section that is present WHEN THE PROJECT
' IS LOADED is re-emitted verbatim by VB6 on every save and survives long-term; a
' section APPENDED externally WHILE the project is open is overwritten by that save -
' so write the .vbp with the IDE CLOSED, or use the sidecar file, which can be written
' at any time. It is the ROOT-area keys that the in-memory model overwrites (the
' CondComp case is that class), NOT a named section.
' =====================================================================
Private Function IsBoolLike(ByVal v As Variant, ByRef outBool As Boolean) As Boolean
    IsBoolLike = False
    outBool = False
    If IsNull(v) Then Exit Function
    If IsObject(v) Then Exit Function
    If VarType(v) = vbBoolean Then
        outBool = CBool(v)
        IsBoolLike = True
        Exit Function
    End If
    Dim s As String
    s = LCase$(Trim$(CStr(v)))
    If s = "true" Or s = "1" Or s = "yes" Or s = "on" Then
        outBool = True
        IsBoolLike = True
        Exit Function
    End If
    If s = "false" Or s = "0" Or s = "no" Or s = "off" Then
        outBool = False
        IsBoolLike = True
    End If
End Function

' (A10): the PRIMARY switch lives in the project's OWN .vbp, in a
' custom section:
'     [VB6MCP]
'     LAA=1
'     LAANote=this project needs >2GB
' EXACT survival rule (measured): a section that was PRESENT WHEN THE PROJECT WAS
' LOADED survives every IDE save, because VB6 re-emits it verbatim; a section
' APPENDED to the .vbp from outside WHILE the project is open is LOST on the IDE's
' next save, because it was never in the in-memory project model. So write this
' section while the IDE has the project CLOSED, or use the sidecar file below,
' which can be written at any time.
' Keys are read case-insensitively; 1/true/yes/on = true, 0/false/no/off = false;
' an ILLEGAL value is reported, never silently defaulted.
' Returns True when the section produced a decision; False with an EMPTY errMsg
' when the section/key is simply absent (the caller falls through to the next
' source); False with a NON-EMPTY errMsg when the section exists but is unusable.
Private Function LaaVbpSection(ByVal vbp As String, ByRef found As Boolean, ByRef keyPresent As Boolean, _
        ByRef want As Boolean, ByRef note As String, ByRef errMsg As String) As Boolean
    LaaVbpSection = False
    found = False
    keyPresent = False
    want = False
    note = ""
    errMsg = ""
    Dim txt As String
    txt = Build.ReadLogAnsi(vbp)
    If Len(txt) = 0 Then Exit Function
    Dim lines() As String
    lines = Split(Replace(Replace(txt, vbCrLf, vbLf), vbCr, vbLf), vbLf)
    Dim i As Long, ln As String, low As String
    Dim inSec As Boolean, rawVal As String, keyName As String
    Dim seenLaa As Boolean, seenNote As String
    inSec = False
    seenLaa = False
    seenNote = ""
    For i = LBound(lines) To UBound(lines)
        ln = Trim$(lines(i))
        low = LCase$(ln)
        If Len(ln) > 0 Then
            If Left$(ln, 1) = "[" Then
                ' a new section ends the one we were reading
                If inSec Then Exit For
                If low = "[vb6mcp]" Then
                    inSec = True
                    found = True
                End If
            ElseIf inSec Then
                Dim eq As Long
                eq = InStr(ln, "=")
                If eq > 0 Then
                    keyName = LCase$(Trim$(Left$(ln, eq - 1)))
                    rawVal = Trim$(Mid$(ln, eq + 1))
                    If keyName = "laa" Then
                        Dim vb As Boolean
                        If IsBoolLike(rawVal, vb) Then
                            want = vb
                            seenLaa = True
                        Else
                            errMsg = "the [VB6MCP] section of " & vbp & " has LAA=" & rawVal & ", which is not a recognised boolean (1/true/yes/on or 0/false/no/off), so this project's LAA setting is UNKNOWN. Nothing was silently defaulted: the LAA step was SKIPPED. Fix the value or remove the key (a per-call laa argument overrides it)."
                            LaaVbpSection = False
                            Exit Function
                        End If
                    ElseIf keyName = "laanote" Then
                        seenNote = rawVal
                    End If
                End If
            End If
        End If
    Next
    keyPresent = seenLaa
    note = seenNote
    If seenLaa Then
        LaaVbpSection = True
    ElseIf found Then
        ' the section exists without a LAA key: not a decision, fall through
        LaaVbpSection = False
    End If
End Function

Private Function LaaSidecarPath(ByVal vbp As String) As String
    Dim fso As Object
    Dim dir As String
    On Error Resume Next
    Set fso = CreateObject("Scripting.FileSystemObject")
    dir = fso.GetParentFolderName(vbp)
    On Error GoTo 0
    If Len(dir) = 0 Then Exit Function
    LaaSidecarPath = PathJoin(dir, ".vb6mcp.json")
End Function

' True  = the decision is usable (want/src/projFile/note are set)
' False = a configuration source EXISTS but is unusable; errMsg says what, and
'         NO default is substituted (the LAA step must be skipped, not guessed).
Private Function LaaResolve(ByVal vbp As String, ByVal laaGiven As Boolean, ByVal laaParam As Boolean, _
        ByRef want As Boolean, ByRef src As String, ByRef projFile As String, _
        ByRef note As String, ByRef errMsg As String) As Boolean
    LaaResolve = True
    want = True
    src = "global-default"
    note = ""
    errMsg = ""
    projFile = LaaSidecarPath(vbp)
    If laaGiven Then
        want = laaParam
        src = "param"
        note = "the laa argument was passed on THIS call, so it decides"
        Exit Function
    End If
    ' (2) the project's OWN [VB6MCP] section (PRIMARY source; VB6 preserves
    ' unknown sections when it saves the .vbp).
    Dim vFound As Boolean, vKey As Boolean, vWant As Boolean, vNote As String, vErr As String
    vFound = False
    vKey = False
    vWant = False
    vNote = ""
    vErr = ""
    If LaaVbpSection(vbp, vFound, vKey, vWant, vNote, vErr) Then
        want = vWant
        src = "vb-project"
        note = "the [VB6MCP] section of the .vbp decides for this project"
        If Len(vNote) > 0 Then note = note & ": " & vNote
        Exit Function
    End If
    If Len(vErr) > 0 Then
        LaaResolve = False
        src = "vb-project-error"
        errMsg = vErr
        Exit Function
    End If
    ' (3) the optional sidecar <vbpDir>\.vb6mcp.json overrides for projects whose
    ' .vbp is managed by external tools.
    If Len(projFile) > 0 Then
        Dim has As Boolean
        has = False
        On Error Resume Next
        Err.Clear
        has = (Dir$(projFile) <> "")
        If Err.Number <> 0 Then has = False
        Err.Clear
        On Error GoTo 0
        If has Then
            Dim txt As String
            txt = Build.ReadLogAnsi(projFile)
            Dim parsed As Variant
            If Not JsonLib.JsonParse(txt, parsed) Then
                LaaResolve = False
                src = "project-file-error"
                errMsg = "the project sidecar " & projFile & " exists but is NOT valid JSON, so this project's LAA setting is UNKNOWN. Nothing was silently defaulted: the LAA step was SKIPPED. Fix the file (e.g. {""laa"": true}) or delete it - a per-call laa argument overrides it."
                Exit Function
            End If
            If Not IsObject(parsed) Then
                LaaResolve = False
                src = "project-file-error"
                errMsg = "the project sidecar " & projFile & " is valid JSON but not a JSON OBJECT, so this project's LAA setting is UNKNOWN. The LAA step was SKIPPED (nothing was defaulted)."
                Exit Function
            End If
            Dim o As Object
            Set o = parsed
            If Not o.Exists("laa") Then
                LaaResolve = False
                src = "project-file-error"
                errMsg = "the project sidecar " & projFile & " has no laa key, so this project's LAA setting is UNKNOWN. The LAA step was SKIPPED (nothing was defaulted); add {""laa"": true|false} or delete the file."
                Exit Function
            End If
            Dim pv As Variant
            Dim pb As Boolean
            pv = o("laa")
            If IsBoolLike(pv, pb) Then
                want = pb
                src = "project-file"
                note = "the project sidecar decides for this project"
                If o.Exists("laaNote") Then note = note & ": " & CStr(o("laaNote"))
                Exit Function
            End If
            LaaResolve = False
            src = "project-file-error"
            errMsg = "the project sidecar " & projFile & " has a laa value that is not true/false, so this project's LAA setting is UNKNOWN. The LAA step was SKIPPED (nothing was defaulted)."
            Exit Function
        End If
    End If
    Dim ev As String
    ev = Trim$(Environ$("VB6MCP_LAA"))
    If Len(ev) > 0 Then
        Dim eb As Boolean
        If IsBoolLike(ev, eb) Then
            want = eb
            src = "env"
            note = "the environment variable VB6MCP_LAA decides"
            Exit Function
        End If
        LaaResolve = False
        src = "env-error"
        errMsg = "the environment variable VB6MCP_LAA is set to a value that is not true/false, so the LAA setting is UNKNOWN. The LAA step was SKIPPED (nothing was defaulted)."
        Exit Function
    End If
    note = "no per-call laa argument, no project sidecar and no VB6MCP_LAA: the global default (ON) applies"
End Function

' A configuration refusal must LOOK like one: never a green receipt.
Private Sub LaaConfigRefusal(ByVal root As Object, ByVal projFile As String, ByVal errMsg As String)
    root("laaRequested") = False
    root("laaApplicable") = False
    root("laaBefore") = False
    root("laaAfter") = False
    root("laaSet") = False
    root("laaAlready") = False
    root("laaBytesPatched") = 0
    root("laaError") = errMsg
    root("laaNote") = "the LAA configuration could not be resolved, so NO PE header was touched. This is NOT a silent fallback to the default."
    root("laaOk") = False
    root("laaFlag") = "IMAGE_FILE_LARGE_ADDRESS_AWARE (0x0020)"
    root("laaMethod") = "the add-in rewrites the PE header itself; an external EditBin.exe is NOT required"
    root("laaProjectFile") = projFile
    root("laaMachineEffective") = LaaMachineEffective()
    Dim e As Object
    Set e = CreateObject("Scripting.Dictionary")
    Set root("laa") = e
End Sub

Private Function PeLaaRead(ByVal path As String, ByRef chars As Long, ByRef charsOff As Long, ByRef errMsg As String) As Boolean
    PeLaaRead = False
    chars = 0
    charsOff = 0
    errMsg = ""
    Dim f As Integer
    Dim nFileBytes As Double
    On Error GoTo Bad
    nFileBytes = FileLen(path)
    f = FreeFile
    Open path For Binary Access Read As #f
    Dim sig As Long
    Get #f, 1, sig
    If (sig And &HFFFF&) <> &H5A4D& Then
        Close #f
        errMsg = "not a PE image: the DOS signature at offset 0 is not MZ"
        Exit Function
    End If
    Dim lfanew As Long
    Get #f, 61, lfanew
    If lfanew <= 0 Then
        Close #f
        errMsg = "not a PE image: e_lfanew reads " & CStr(lfanew)
        Exit Function
    End If
    If CDbl(lfanew) + 24 > nFileBytes Then
        Close #f
        errMsg = "truncated PE header: e_lfanew=" & CStr(lfanew) & " but the file is only " & CStr(CLng(nFileBytes)) & " bytes"
        Exit Function
    End If
    Dim peSig As Long
    Get #f, lfanew + 1, peSig
    If peSig <> &H4550& Then
        Close #f
        errMsg = "not a PE image: no PE signature at e_lfanew"
        Exit Function
    End If
    Dim lo As Byte, hi As Byte
    charsOff = lfanew + 23
    Get #f, charsOff, lo
    Get #f, charsOff + 1, hi
    Close #f
    chars = CLng(lo) + CLng(hi) * 256
    PeLaaRead = True
    Exit Function
Bad:
    Dim en As Long, ed As String
    en = Err.Number
    ed = Err.Description
    On Error Resume Next
    Close #f
    errMsg = "could not read the PE header: VB error " & CStr(en) & " (" & ed & ")"
    Err.Clear
End Function

Private Function PeWriteChars(ByVal path As String, ByVal charsOff As Long, ByVal newChars As Long, ByRef errMsg As String) As Boolean
    PeWriteChars = False
    errMsg = ""
    Dim f As Integer
    On Error GoTo Bad
    f = FreeFile
    ' Binary + Access Read Write opens WITHOUT truncation: only the 2 bytes that
    ' are Put change, and one Put of a 2-byte array is a single write.
    Open path For Binary Access Read Write As #f
    Dim two(0 To 1) As Byte
    two(0) = CByte(newChars And &HFF&)
    two(1) = CByte((newChars And &HFF00&) \ &H100&)
    Put #f, charsOff, two
    Close #f
    PeWriteChars = True
    Exit Function
Bad:
    Dim en As Long, ed As String
    en = Err.Number
    ed = Err.Description
    On Error Resume Next
    Close #f
    errMsg = "VB error " & CStr(en) & " (" & ed & ")"
    If en = 70 Then errMsg = errMsg & " - the artifact is read-only or held open by another process"
    If en = 75 Then errMsg = errMsg & " - the artifact path is not writable"
    Err.Clear
End Function

' Returns {applicable, laaBefore, laaAfter, laaSet, already, bytesPatched, peOk, error, note}
Private Function LaaPatchJson(ByVal artifact As String, ByVal want As Boolean) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("artifact") = artifact
    d("requested") = want
    d("applicable") = False
    d("laaBefore") = False
    d("laaAfter") = False
    d("laaSet") = False
    d("already") = False
    d("bytesPatched") = 0
    d("peOk") = False
    d("error") = ""
    d("note") = ""
    d("signedImage") = False
    d("certificateTableBytes") = 0
    d("laaSkippedReason") = ""
    d("laaRefusedReason") = ""
    If Not want Then
        d("note") = "laa=false: the caller switched the LAA step off for this call; the artifact was not examined"
        Set LaaPatchJson = d
        Exit Function
    End If
    If Len(artifact) = 0 Then
        d("error") = "laa: the artifact path is unknown, so the PE header cannot be examined or patched"
        Set LaaPatchJson = d
        Exit Function
    End If
    Dim exists As Boolean
    exists = False
    On Error Resume Next
    Err.Clear
    exists = (Dir$(artifact) <> "")
    If Err.Number <> 0 Then exists = False
    Err.Clear
    On Error GoTo 0
    If Not exists Then
        d("error") = "laa: the artifact does not exist on disk yet (" & artifact & "), so there is no PE header to patch"
        Set LaaPatchJson = d
        Exit Function
    End If
    ' ---- (A10 constraint 5): NEVER patch this add-in's own DLL ---------
    ' An ActiveX DLL's LAA is decided by the HOST process's address space, so setting
    ' it on VB6MCP.dll would be meaningless. make_project/build patch only the TARGET
    ' product's artifact; if the target IS this DLL, skip it and say so.
    Dim ownPath As String
    ownPath = ""
    On Error Resume Next
    Err.Clear
    ownPath = McpBuildTools.BuildPath(Me)
    On Error GoTo 0
    If Len(ownPath) > 0 Then
        If PathsSame(ownPath, artifact) Then
            d("laaSkippedReason") = "own_addin_dll"
            d("note") = "the target artifact IS this add-in's own DLL (the ActiveX server being built); LAA on an ActiveX DLL is decided by the host process, so the flag was deliberately NOT written"
            Set LaaPatchJson = d
            Exit Function
        End If
    End If
    Dim chars As Long, charsOff As Long, peErr As String
    Dim peOk As Boolean
    peOk = PeLaaRead(artifact, chars, charsOff, peErr)
    d("peOk") = peOk
    If Not peOk Then
        d("error") = "laa: " & peErr
        Set LaaPatchJson = d
        Exit Function
    End If
    d("applicable") = True
    Dim isLaa As Boolean
    isLaa = ((chars And &H20&) <> 0)
    d("laaBefore") = isLaa
    d("laaAfter") = isLaa
    If isLaa Then
        d("already") = True
        d("note") = "idempotent: the artifact already carries IMAGE_FILE_LARGE_ADDRESS_AWARE (0x0020); nothing was written"
        Set LaaPatchJson = d
        Exit Function
    End If
    ' ---- (A10 constraint 1): code signing must come AFTER the flag -----
    ' An Authenticode certificate lives in a PE data directory that a header edit
    ' invalidates. A signed artifact is REFUSED rather than silently broken; the flag
    ' must be set BEFORE signing (signing is the last step), or laa=false must be
    ' passed deliberately. Nothing is written on this path.
    Dim certBytes As Long, certOk As Boolean, certErr As String
    certBytes = 0
    certOk = False
    certErr = ""
    If PeCertTableSize(artifact, certBytes, certOk, certErr) Then
        If certBytes <> 0 Then
            d("signedImage") = True
            d("certificateTableBytes") = certBytes
            d("laaRefusedReason") = "signed_image"
            d("error") = "laa: the artifact carries an Authenticode certificate table (" & CStr(certBytes) & " bytes). Rewriting the PE header would INVALIDATE that signature, so the flag was NOT written. Set the flag BEFORE code signing (signing must be the last step), or pass laa=false to accept a non-LAA artifact deliberately."
            Set LaaPatchJson = d
            Exit Function
        End If
    Else
        d("certCheckError") = certErr
    End If
    Dim wrErr As String
    If Not PeWriteChars(artifact, charsOff, chars Or &H20&, wrErr) Then
        d("error") = "laa: could not write the PE characteristics word: " & wrErr
        Set LaaPatchJson = d
        Exit Function
    End If
    Dim chars2 As Long, off2 As Long, peErr2 As String
    If PeLaaRead(artifact, chars2, off2, peErr2) Then
        If (chars2 And &H20&) <> 0 Then
            d("laaAfter") = True
            d("laaSet") = True
            d("bytesPatched") = 2
            d("note") = "IMAGE_FILE_LARGE_ADDRESS_AWARE (0x0020) was written into the PE header by the MCP add-in (no EditBin.exe) and the file was re-read to verify"
            Set LaaPatchJson = d
            Exit Function
        End If
    End If
    Dim rbErr As String
    Dim rbOk As Boolean
    rbOk = PeWriteChars(artifact, charsOff, chars, rbErr)
    d("laaAfter") = False
    d("laaSet") = False
    If rbOk Then
        d("error") = "laa: the write was not confirmed by a re-read; the original characteristics word was put back (rollback ok). The artifact is unchanged."
    Else
        d("error") = "laa: the write was not confirmed by a re-read AND the rollback failed (" & rbErr & "). The PE header may be damaged - rebuild, or restore from the .before-build copy."
    End If
    Set LaaPatchJson = d
End Function

' Publishes the LAA result into a receipt under BOTH the flat names the card
' asks for (laaBefore/laaAfter/laaSet) and a laa{} object with the detail.
Private Sub ApplyLaaInto(ByVal root As Object, ByVal artifact As String, ByVal want As Boolean)
    Dim r As Object
    Set r = LaaPatchJson(artifact, want)
    root("laaRequested") = want
    root("laaApplicable") = CBool(r("applicable"))
    root("laaBefore") = CBool(r("laaBefore"))
    root("laaAfter") = CBool(r("laaAfter"))
    root("laaSet") = CBool(r("laaSet"))
    root("laaAlready") = CBool(r("already"))
    root("laaBytesPatched") = CLng(r("bytesPatched"))
    root("laaError") = CStr(r("error"))
    root("laaNote") = CStr(r("note"))
    root("laaOk") = (Len(CStr(r("error"))) = 0)
    root("laaFlag") = "IMAGE_FILE_LARGE_ADDRESS_AWARE (0x0020)"
    root("laaMethod") = "the add-in rewrites the PE header itself; an external EditBin.exe is NOT required"
    root("laaSkippedReason") = CStr(r("laaSkippedReason"))
    root("laaRefusedReason") = CStr(r("laaRefusedReason"))
    root("laaSignedImage") = CBool(r("signedImage"))
    root("laaCertificateTableBytes") = CLng(r("certificateTableBytes"))
    root("laaMachineEffective") = LaaMachineEffective()
    root("laaMachineEffectiveNote") = ""
    If Not CBool(root("laaMachineEffective")) Then root("laaMachineEffectiveNote") = "LAA only enlarges a 32-bit image's user address space on 64-bit Windows (or 32-bit Windows booted with /3GB); on this machine the flag is a promise that does not change the address space"
    Set root("laa") = r
End Sub

' =====================================================================
' DIAGNOSTIC MODE - an isolated VB6.EXE /make on a
' COPY of the .vbp plus its components. The in-IDE Make route has no compiler
' subprocess, and running /make on the project the IDE holds yields exit 0 and
' no log; a copy has neither problem. The real project and the real artifact
' are never touched.
' =====================================================================
Public Function PathJoin(ByVal dir As String, ByVal name As String) As String
    If Len(dir) = 0 Then
        PathJoin = name
        Exit Function
    End If
    If Right$(dir, 1) = Chr$(92) Then
        PathJoin = dir & name
    Else
        PathJoin = dir & Chr$(92) & name
    End If
End Function

Private Function IsProjectComponentKey(ByVal low As String) As Boolean
    IsProjectComponentKey = False
    If Left$(low, 5) = "form=" Then IsProjectComponentKey = True
    If Left$(low, 7) = "module=" Then IsProjectComponentKey = True
    If Left$(low, 6) = "class=" Then IsProjectComponentKey = True
    If Left$(low, 12) = "usercontrol=" Then IsProjectComponentKey = True
    If Left$(low, 13) = "propertypage=" Then IsProjectComponentKey = True
    If Left$(low, 9) = "designer=" Then IsProjectComponentKey = True
    If Left$(low, 11) = "relateddoc=" Then IsProjectComponentKey = True
    If Left$(low, 10) = "resfile32=" Then IsProjectComponentKey = True
End Function

' Copies every file entry of the .vbp into tmpDir (relative paths preserved),
' rewrites ExeName32 so the isolated make writes INSIDE tmpDir, and returns the
' path of the copied .vbp.
Private Function CopyProjectForIsolatedMake(ByVal vbp As String, ByVal tmpDir As String, _
        ByRef outVbp As String, ByRef nCopied As Long, ByRef missing As String, ByRef errMsg As String, _
        ByRef compatFile As String) As Boolean
    CopyProjectForIsolatedMake = False
    outVbp = ""
    nCopied = 0
    missing = ""
    errMsg = ""
    compatFile = ""
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    On Error GoTo Bad
    Dim text As String
    text = Build.ReadLogAnsi(vbp)
    If Len(text) = 0 Then
        errMsg = "the .vbp could not be read as text: " & vbp
        Exit Function
    End If
    Dim srcDir As String
    srcDir = fso.GetParentFolderName(vbp)
    Dim lines() As String
    lines = Split(Replace(Replace(text, vbCrLf, vbLf), vbCr, vbLf), vbLf)
    Dim outLines() As String
    ReDim outLines(LBound(lines) To UBound(lines))
    Dim i As Long, ln As String, low As String, val As String
    Dim exeName As String, exeFound As Boolean
    exeName = ""
    exeFound = False
    ' The binary-compatibility reference (CompatibleEXE32 / the legacy CompatibleEXE) is a
    ' PROJECT input, not an optional extra: with CompatibleMode="1"/"2" and the file absent,
    ' VB6 does not stop - it silently falls back to No Compatibility and mints NEW class IDs,
    ' so the isolated artifact's type library no longer matches every existing registration.
    Dim compatKey As String, compatVal As String, compatQuoted As Boolean
    compatKey = ""
    compatVal = ""
    compatQuoted = False
    For i = LBound(lines) To UBound(lines)
        ln = lines(i)
        low = LCase$(Trim$(ln))
        outLines(i) = ln
        If IsProjectComponentKey(low) Then
            Dim p As Long
            p = InStr(ln, "=")
            If p > 0 Then
                val = Trim$(Mid$(ln, p + 1))
                Dim sc As Long
                sc = InStr(val, ";")
                If sc > 0 Then val = Trim$(Mid$(val, sc + 1))
                If Len(val) > 0 Then
                    Dim src As String
                    src = PathJoin(srcDir, val)
                    If Not fso.FileExists(src) Then
                        missing = missing & val & ";"
                    Else
                        Dim dst As String
                        dst = PathJoin(tmpDir, val)
                        Dim dd As String
                        dd = fso.GetParentFolderName(dst)
                        On Error Resume Next
                        If Not fso.FolderExists(dd) Then fso.CreateFolder dd
                        On Error GoTo Bad
                        fso.CopyFile src, dst, True
                        ' remaining: copiedFiles must count files that really landed.
                        Dim isB() As Byte
                        Encoding.ReadAllBytesTo dst, isB
                        If Encoding.ByteCount(isB) > 0 Then
                            nCopied = nCopied + 1
                        Else
                            If Len(missing) > 0 Then missing = missing & ","
                            missing = missing & val & "(copy_not_readable_back)"
                        End If
                        Dim ext As String
                        ext = LCase$(fso.GetExtensionName(val))
                        If ext = "frm" Or ext = "ctl" Or ext = "dsr" Then
                            Dim frx As String
                            frx = Left$(src, Len(src) - 4) & ".frx"
                            If fso.FileExists(frx) Then
                                fso.CopyFile frx, Left$(dst, Len(dst) - 4) & ".frx", True
                                nCopied = nCopied + 1
                            End If
                        ElseIf ext = "pag" Then
                            ' A PropertyPage's design-time blob sits in a sibling .pgx; without it
                            ' the copied page cannot be loaded by the isolated compiler.
                            Dim pgx As String
                            pgx = Left$(src, Len(src) - 4) & ".pgx"
                            If fso.FileExists(pgx) Then
                                fso.CopyFile pgx, Left$(dst, Len(dst) - 4) & ".pgx", True
                                nCopied = nCopied + 1
                            End If
                        End If
                    End If
                End If
            End If
        ElseIf Left$(low, 16) = "compatibleexe32=" Then
            compatKey = "CompatibleEXE32"
            compatVal = Trim$(Mid$(ln, InStr(ln, "=") + 1))
            ' VB6 itself writes this value QUOTED (CompatibleEXE32="dist/compat/x.dll"), so the
            ' quotes must be stripped before the path is used - otherwise the reference is
            ' looked up with quotes in its name and reported missing.
            If Len(compatVal) >= 2 Then
                If Left$(compatVal, 1) = Chr$(34) And Right$(compatVal, 1) = Chr$(34) Then
                    compatVal = Mid$(compatVal, 2, Len(compatVal) - 2)
                    compatQuoted = True
                End If
            End If
        ElseIf Left$(low, 14) = "compatibleexe=" Then
            compatKey = "CompatibleEXE"
            compatVal = Trim$(Mid$(ln, InStr(ln, "=") + 1))
            If Len(compatVal) >= 2 Then
                If Left$(compatVal, 1) = Chr$(34) And Right$(compatVal, 1) = Chr$(34) Then
                    compatVal = Mid$(compatVal, 2, Len(compatVal) - 2)
                    compatQuoted = True
                End If
            End If
        ElseIf Left$(low, 10) = "exename32=" Then
            exeName = Trim$(Mid$(ln, InStr(ln, "=") + 1))
            exeFound = True
        End If
    Next
    ' ---- the binary-compatibility reference goes INTO the isolated tree ----
    If Len(compatVal) > 0 Then
        Dim cSrc As String, cRel As String, cAbs As Boolean, cDst As String
        cAbs = (InStr(compatVal, ":") > 0)
        If Not cAbs Then
            If Left$(compatVal, 2) = Chr$(92) & Chr$(92) Then cAbs = True
        End If
        If cAbs Then
            cSrc = compatVal
            cRel = fso.GetFileName(compatVal)
        Else
            cSrc = PathJoin(srcDir, compatVal)
            cRel = compatVal
        End If
        If Not fso.FileExists(cSrc) Then
            ' Do not pretend the copy is complete: name the MISSING reference so a caller can
            ' tell "the compatibility input was not available" from "the compiler failed".
            If Len(missing) > 0 Then missing = missing & ","
            missing = missing & compatKey & "=" & compatVal & "(compatibility_reference_missing)"
        Else
            cDst = PathJoin(tmpDir, cRel)
            Dim cDd As String
            cDd = fso.GetParentFolderName(cDst)
            On Error Resume Next
            If Not fso.FolderExists(cDd) Then EnsureDir cDd
            Err.Clear
            On Error GoTo Bad
            fso.CopyFile cSrc, cDst, True
            Dim cb() As Byte
            Encoding.ReadAllBytesTo cDst, cb
            If Encoding.ByteCount(cb) > 0 Then
                nCopied = nCopied + 1
                compatFile = cDst
            Else
                If Len(missing) > 0 Then missing = missing & ","
                missing = missing & compatKey & "=" & compatVal & "(copy_not_readable_back)"
            End If
            ' An ABSOLUTE reference would keep pointing OUTSIDE the isolated tree; the one .vbp
            ' line that names it is rewritten to the copy's relative name.
            If cAbs Then
                For i = LBound(outLines) To UBound(outLines)
                    If LCase$(Left$(Trim$(outLines(i)), Len(compatKey) + 1)) = LCase$(compatKey) & "=" Then
                        If compatQuoted Then
                            outLines(i) = compatKey & "=" & Chr$(34) & cRel & Chr$(34)
                        Else
                            outLines(i) = compatKey & "=" & cRel
                        End If
                    End If
                Next
            End If
        End If
    End If
    If Len(exeName) = 0 Then exeName = fso.GetFileName(vbp)
    Dim stem As String, extn As String
    stem = fso.GetBaseName(exeName)
    extn = fso.GetExtensionName(exeName)
    If Len(extn) = 0 Then extn = "exe"
    Dim isoName As String
    isoName = stem & "_isolated." & extn
    If exeFound Then
        For i = LBound(outLines) To UBound(outLines)
            If LCase$(Left$(Trim$(outLines(i)), 10)) = "exename32=" Then outLines(i) = "ExeName32=" & isoName
        Next
    Else
        ReDim Preserve outLines(LBound(outLines) To UBound(outLines) + 1)
        outLines(UBound(outLines)) = "ExeName32=" & isoName
    End If
    outVbp = PathJoin(tmpDir, fso.GetFileName(vbp))
    ' remaining: the copied .vbp must be readable back or the isolated /make
    ' would silently compile nothing.
    If Not ProjShip.WriteTextFile(outVbp, Join(outLines, vbCrLf)) Then
        errMsg = "isolated copy failed: " & outVbp & " was not readable back after writing"
        Exit Function
    End If
    CopyProjectForIsolatedMake = True
    Exit Function
Bad:
    errMsg = "isolated copy failed: VB error " & CStr(Err.Number) & " (" & Err.Description & ")"
End Function

' (rule K): shape-preserving copy of a firstError object.
' Returns Nothing when the source holds nothing REAL, so the caller can leave the member ABSENT
' instead of publishing an empty shell ({"file":"","line":0,"lineSpace":"disk","text":""}) - and
' "the object exists" is itself an assertion, so an object that says nothing must not exist.
' Only members that exist AND carry a real value are copied:
'   file    - only when non-empty;
'   line    - only when > 0, and lineSpace="disk" is written ONLY together with such a line;
'   lineIde - only when > 0;
'   text    - only when non-blank.
' Every member is read through .Exists, because Scripting.Dictionary RAISES on a missing key - and
' the sources here are now rule-K shaped, so keys legitimately go missing.
Private Function FirstErrorCopy(ByVal src As Object) As Object
    If src Is Nothing Then Exit Function
    Dim out As Object
    Set out = CreateObject("Scripting.Dictionary")
    On Error Resume Next
    If src.Exists("file") Then
        If Len(CStr(src("file"))) > 0 Then out("file") = CStr(src("file"))
    End If
    If src.Exists("line") Then
        If CLng(Val(CStr(src("line")))) > 0 Then
            out("line") = CLng(Val(CStr(src("line"))))
            out("lineSpace") = "disk"
        End If
    End If
    If src.Exists("lineIde") Then
        If CLng(Val(CStr(src("lineIde")))) > 0 Then out("lineIde") = CLng(Val(CStr(src("lineIde"))))
    End If
    If src.Exists("text") Then
        If Len(Trim$(CStr(src("text")))) > 0 Then out("text") = CStr(src("text"))
    End If
    On Error GoTo 0
    If out.Count > 0 Then Set FirstErrorCopy = out
End Function

Private Sub DiagnoseInto(ByVal root As Object, ByVal vbp As String, ByVal timeoutMs As Long, ByVal reason As String)
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    ' (review D5) attempted means a CHILD PROCESS REALLY STARTED, so it starts FALSE and is
    ' set only after the isolated /make receipt proves a pid / a kill.
    d("attempted") = False
    d("reason") = reason
    d("route") = "isolated_copy_make"
    d("ok") = False
    d("tmpDir") = ""
    d("vbpCopy") = ""
    d("copiedFiles") = 0
    d("missingFiles") = ""
    d("logPath") = ""
    d("log") = ""
    d("logBytes") = 0
    d("errorCount") = 0
    d("exitCode") = -1
    ' v1.11.12: the isolated compile's HARD budget (see RunExeHardBudget). Defaults make the
    ' key set fixed on EVERY exit of this procedure; attempted=true only once a subprocess ran.
    d("timedOut") = False
    d("budgetEnforced") = False
    d("budgetMs") = 0
    d("budgetSource") = "not_applicable"
    Dim imD As Object
    Set imD = CreateObject("Scripting.Dictionary")
    imD("attempted") = False
    imD("pid") = 0
    imD("exitCode") = -1
    imD("killed") = False
    imD("killMethod") = ""
    imD("elapsedMs") = 0
    imD("leftover") = False
    imD("budgetMs") = 0
    Set d("isolatedMake") = imD
    d("artifactPath") = ""
    d("artifactExists") = False
    d("artifactSize") = 0
    d("error") = ""
    d("note") = "compiles a COPY of the .vbp plus its component files in a temp directory with an isolated VB6.EXE /make; the project in the IDE and the real artifact are NOT touched. The copy reflects the files ON DISK, so unsaved pane edits are not in it."
    ' (rule K, site #1): NO firstError shell is created here any more.  The object used
    ' to be fabricated unconditionally as {file:"", line:0, lineSpace:"disk", text:""}, which
    ' asserted a first error that had not been found - the fabrication this card is about, one
    ' level down.  The real value, when there is one, is copied from the isolated /make receipt at
    ' site #2 below; every early exit of this procedure now returns a diagnosis WITHOUT firstError,
    ' which is the honest shape for "we never got as far as looking".
    On Error GoTo Bad
    Dim tmpBase As String
    tmpBase = Environ$("TEMP")
    If Len(tmpBase) = 0 Then tmpBase = Environ$("TMP")
    If Len(tmpBase) = 0 Then
        d("error") = "no TEMP directory is defined, so an isolated copy cannot be made"
        Set root("diagnosis") = d
        Exit Sub
    End If
    Dim tmpDir As String
    tmpDir = PathJoin(tmpBase, "vb6mcp_diag_" & Format$(Now, "yyyymmdd_hhnnss") & "_" & CStr(GetTickCount() And &HFFFF&))
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    fso.CreateFolder tmpDir
    d("tmpDir") = tmpDir
    Dim vbpCopy As String, nCopied As Long, missing As String, copyErr As String, compatCopy As String
    If Not CopyProjectForIsolatedMake(vbp, tmpDir, vbpCopy, nCopied, missing, copyErr, compatCopy) Then
        ' (review D5) no child was started: budget stays 0 / not_applicable and the failure is
        ' named as a preflight (copy) error, not as a compiler result.
        d("error") = copyErr
        d("preflightError") = copyErr
        d("budgetMs") = 0
        d("budgetSource") = "not_applicable"
        d("budgetEnforced") = False
        Set root("diagnosis") = d
        Exit Sub
    End If
    d("vbpCopy") = vbpCopy
    d("copiedFiles") = nCopied
    d("missingFiles") = missing
    ' The isolated copy carries the project INPUTS, not just its components: the
    ' binary-compatibility reference is reported by name so its presence is checkable.
    If Len(compatCopy) > 0 Then
        d("compatibilityReference") = compatCopy
        d("compatibilityReferenceCopied") = True
    Else
        d("compatibilityReferenceCopied") = False
    End If
    Dim logPath As String
    logPath = PathJoin(tmpDir, "isolated_make.log")
    d("logPath") = logPath
    ' v1.11.12: CLAMPED hard budget for the isolated compiler. timeout_ms<=0 uses the DEFAULT
    ' (never "unbounded"); the receipt names the rule that decided the applied value.
    Dim diagBudget As Long, diagSrc As String
    diagSrc = "timeout_ms"
    diagBudget = timeoutMs
    If diagBudget <= 0 Then
        diagBudget = DIAG_MAKE_BUDGET_DEFAULT_MS
        diagSrc = "default"
    End If
    If diagBudget < DIAG_MAKE_BUDGET_MIN_MS Then
        diagBudget = DIAG_MAKE_BUDGET_MIN_MS
        diagSrc = "clamped_min"
    ElseIf diagBudget > DIAG_MAKE_BUDGET_MAX_MS Then
        diagBudget = DIAG_MAKE_BUDGET_MAX_MS
        diagSrc = "clamped_max"
    End If
    ' (review D5) d(budgetMs)/d(budgetSource) are written only AFTER the receipt proves a
    ' child ran; a start failure leaves the not_applicable defaults in place.
    ' ToolBuild already knows how to run an isolated VB6.EXE /make, read the log
    ' and locate the first error; reuse it. laaWant=False: the isolated image is
    ' throwaway - the REAL artifact is patched by the caller.
    Dim json As String
    json = ToolBuild(vbpCopy, "", logPath, diagBudget, True, False, False)
    Dim parsed As Variant
    If Not JsonLib.JsonParse(json, parsed) Then
        d("error") = "the isolated /make receipt could not be parsed"
        Set root("diagnosis") = d
        Exit Sub
    End If
    If Not IsObject(parsed) Then
        d("error") = "the isolated /make receipt was not a JSON object"
        Set root("diagnosis") = d
        Exit Sub
    End If
    Dim o As Object
    Set o = parsed
    If o.Exists("exitCode") Then d("exitCode") = CLng(Val(CStr(o("exitCode"))))
    ' v1.11.12: the hard-budget facts of the isolated compiler (see RunExeHardBudget).
    If o.Exists("timedOut") Then d("timedOut") = CBool(o("timedOut"))
    If o.Exists("budgetEnforced") Then d("budgetEnforced") = CBool(o("budgetEnforced"))
    imD("exitCode") = CLng(d("exitCode"))
    imD("killed") = CBool(d("budgetEnforced"))
    If o.Exists("childPid") Then imD("pid") = CLng(Val(CStr(o("childPid"))))
    ' (review D5) a pid (or a kill) is the proof that a compiler process really started.
    If imD("pid") > 0 Or CBool(d("timedOut")) Then d("attempted") = True
    imD("attempted") = CBool(d("attempted"))
    If CBool(d("attempted")) Then
        d("budgetMs") = diagBudget
        d("budgetSource") = diagSrc
        imD("budgetMs") = diagBudget
    Else
        d("budgetMs") = 0
        d("budgetSource") = "not_applicable"
        d("budgetEnforced") = False
        d("timedOut") = False
        imD("budgetMs") = 0
    End If
    If o.Exists("killMethod") Then imD("killMethod") = CStr(o("killMethod"))
    If o.Exists("compilerElapsedMs") Then imD("elapsedMs") = CLng(Val(CStr(o("compilerElapsedMs"))))
    If o.Exists("childLeftover") Then imD("leftover") = CBool(o("childLeftover"))
    If o.Exists("logBytes") Then d("logBytes") = CLng(Val(CStr(o("logBytes"))))
    If o.Exists("log") Then d("log") = CStr(o("log"))
    ' (step B): carry the reader's measured pair into the diagnosis too, so the
    ' "non-empty file, empty read" question is answerable on this route as well.
    If o.Exists("rawLen") Then d("rawLen") = CLng(Val(CStr(o("rawLen"))))
    If o.Exists("rawSha256") Then d("rawSha256") = CStr(o("rawSha256"))
    If o.Exists("errorCount") Then d("errorCount") = CLng(Val(CStr(o("errorCount"))))
    If o.Exists("artifact") Then d("artifactPath") = CStr(o("artifact"))
    If o.Exists("output") Then
        If IsObject(o("output")) Then
            Dim ob As Object
            Set ob = o("output")
            If ob.Exists("exists") Then d("artifactExists") = CBool(ob("exists"))
            If ob.Exists("size") Then d("artifactSize") = CDbl(Val(CStr(ob("size"))))
        End If
    End If
    ' (rule K, site #2): copy the source object MEMBER BY MEMBER, only for members that
    ' really exist and carry a real value.  The old body read ofe("file")/ofe("line")/ofe("text")
    ' unconditionally (a missing key RAISES on Scripting.Dictionary - and the source is now
    ' rule-K shaped, so keys legitimately go missing) and it re-asserted lineSpace="disk" for a
    ' line that may never have existed.  Absent source object => no firstError at all.
    If o.Exists("firstError") Then
        If IsObject(o("firstError")) Then
            Dim ofe As Object
            Set ofe = o("firstError")
            Dim fe2 As Object
            Set fe2 = FirstErrorCopy(ofe)
            If Not fe2 Is Nothing Then Set d("firstError") = fe2
        End If
    End If
    If CBool(d("timedOut")) Then
        d("ok") = False
        d("error") = "the isolated /make was KILLED at the " & CStr(diagBudget) & " ms hard budget (pid " & CStr(imD("pid")) & "; " & CStr(imD("killMethod")) & "); a timed-out compile is NOT a compile verdict" & IIf(CBool(imD("leftover")), " - WARNING: the child was still listed by tasklist right after the kill", " - tasklist confirmed no leftover child")
    ElseIf CLng(d("errorCount")) = 0 And CBool(d("artifactExists")) Then
        d("ok") = True
    ElseIf CLng(d("errorCount")) > 0 Then
        d("error") = "the isolated /make reported " & CStr(d("errorCount")) & " error(s); see firstError and log"
    Else
        d("error") = "the isolated /make produced no artifact and no error count; read log and see diagnosisUnavailableReason"
    End If
    Set root("diagnosis") = d
    Exit Sub
Bad:
    d("error") = "diagnosis failed: VB error " & CStr(Err.Number) & " (" & Err.Description & ")"
    On Error Resume Next
    Set root("diagnosis") = d
End Sub

