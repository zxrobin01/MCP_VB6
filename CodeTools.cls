    root("modalDetected") = mg("modalDetected")
    root("modalTitle") = mg("modalTitle")
    root("modalBody") = mg("modalBody")
    root("modalClickedButton") = mg("modalClickedButton")
    root("modalClicked") = mg("modalClicked")
    root("modalWaitMs") = mg("modalWaitMs")
    root("modalWaitedMs") = mg("modalWaitedMs")
    root("modalSideEffects") = mg("modalSideEffects")
    root("modalRecoveredBy") = mg("modalRecoveredBy")
    root("modalPolicy") = mg("modalPolicy")
    root("modalRefusedReason") = mg("modalRefusedReason")
    root("modalHostRisk") = mg("modalHostRisk")
    root("modalHostRiskClass") = mg("modalHostRiskClass")
    root("modalNote") = mg("modalNote")
    root("modalUnresolvable") = mg("modalUnresolvable")
    If mg.Exists("tickCount") Then root("tickCount") = mg("tickCount")
    If mg.Exists("firstSeenAtMs") Then root("firstSeenAtMs") = mg("firstSeenAtMs")
    If mg.Exists("deadlineAtMs") Then root("deadlineAtMs") = mg("deadlineAtMs")
    If mg.Exists("refusedTicks") Then root("refusedTicks") = mg("refusedTicks")
    If mg.Exists("lastTickAction") Then
        If IsObject(mg("lastTickAction")) Then
            Set root("lastTickAction") = mg("lastTickAction")
        Else
            root("lastTickAction") = mg("lastTickAction")
        End If
    End If
    If mg.Exists("modalCloseSent") Then root("modalCloseSent") = mg("modalCloseSent")
    root("howToRecover") = mg("howToRecover")
    If mg.Exists("modalButtons") Then
        If IsObject(mg("modalButtons")) Then Set root("modalButtons") = mg("modalButtons")
    End If
    ' The same facts under the names an earlier request asked for, so a caller can read
    ' either spelling. NOTE: a bare `sideEffects` is deliberately NOT aliased - that is
    ' the global additive audit block added by SealedReceipt, and overwriting it would
    ' destroy other evidence.
    root("clickedButton") = mg("modalClickedButton")
    root("waitedMs") = mg("modalWaitedMs")
    Err.Clear
End Sub

' v1.11.12: the HOST-MODAL block, computed from LIVE windows of THIS process and kept
' INDEPENDENT of timedOut. blocking = a #32770 box is up AND (risk=known OR it
' owner-disables its owner). hwnd/title/controls describe the FIRST box (the dialogs[]
' array carries every box with its own hwnd/title/controls/ownerDisabled).
Private Sub ApplyHostModalFields(ByRef root As Object, ByVal stage As String)
    On Error Resume Next
    Dim risk As String, reason As String, riskClass As String, details As String
    Dim ndlg As Long
    ndlg = WinOps.HostModalRiskProbe("#32770", risk, reason, riskClass, details)
    Dim dialogs As Object
    Set dialogs = New Collection
    Dim cols As Object
    Set cols = New Collection
    Dim firstHwnd As Long, firstTitle As String, anyOwned As Boolean
    firstHwnd = 0
    firstTitle = ""
    anyOwned = False
    ' the full dialog tree (hwnd/title/controls/ownerDisabled) comes from the SAME reader
    ' read_active_dialogs uses; a parse failure keeps the block with dialogs=[]
    Dim js As String
    js = WinOps.ReadActiveDialogsJson("#32770", True, 0)
    If Len(js) > 0 Then
        Dim v As Variant
        If JsonParse(js, v) Then
            If IsObject(v) Then
                Dim rd As Object
                Set rd = v
                Dim ds As Variant
                Dim isObj As Boolean
                If JsonGet(rd, "dialogs", ds, isObj) Then
                    If isObj Then
                        Dim col As Collection
                        Set col = ds
                        Dim i As Long, k As Long
                        For i = 1 To col.Count
                            If IsObject(col.Item(i)) Then
                                Dim dobj As Object
                                Set dobj = col.Item(i)
                                Dim e As Object
                                Set e = CreateObject("Scripting.Dictionary")
                                e("hwnd") = JsonGetLong(dobj, "hwnd", 0)
                                e("title") = JsonGetStr(dobj, "title", "")
                                Dim od As Boolean
                                od = JsonGetBool(dobj, "ownerDisabled", False)
                                e("ownerDisabled") = od
                                If od Then anyOwned = True
                                Dim kids As Variant
                                Dim isK As Boolean
                                If Not JsonGet(dobj, "controls", kids, isK) Then
                                    Set kids = New Collection
                                ElseIf Not isK Then
                                    Set kids = New Collection
                                End If
                                Set e("controls") = kids
                                dialogs.Add e
                                If firstHwnd = 0 Then
                                    firstHwnd = CLng(e("hwnd"))
                                    firstTitle = CStr(e("title"))
                                    Set cols = kids
                                End If
                            End If
                        Next
                    End If
                End If
            End If
        End If
    End If
    ' the ARMED modal guard is a second, independent observer: it reports a box it SAW
    ' during this call even after the box was dismissed (the live probe below then sees
    ' nothing). Both sources say "the host was modal during this call".
    Dim mg As Object
    Set mg = WinOps.WoModalGuardReceipt()
    Dim guardSeen As Boolean
    Dim gHwnd As Long, gTitle As String
    guardSeen = False
    gHwnd = 0
    gTitle = ""
    If Not mg Is Nothing Then
        If mg.Exists("modalDetected") Then guardSeen = CBool(mg("modalDetected"))
        If mg.Exists("modalHwnd") Then gHwnd = CLng(Val(CStr(mg("modalHwnd"))))
        If mg.Exists("modalTitle") Then gTitle = CStr(mg("modalTitle"))
    End If
    If firstHwnd = 0 And gHwnd <> 0 Then firstHwnd = gHwnd
    If Len(firstTitle) = 0 Then firstTitle = gTitle
    Dim blocking As Boolean
    blocking = ((ndlg > 0) And ((risk = "known") Or anyOwned)) Or guardSeen
    root("host_modal_blocking") = blocking
    root("host_modal_stage") = stage
    Dim hm As Object
    Set hm = CreateObject("Scripting.Dictionary")
    hm("blocking") = blocking
    hm("stage") = stage
    hm("count") = ndlg
    hm("risk") = risk
    hm("riskReason") = reason
    hm("riskClass") = riskClass
    hm("ownerDisabled") = anyOwned
    hm("hwnd") = firstHwnd
    hm("title") = firstTitle
    Set hm("controls") = cols
    Set hm("dialogs") = dialogs
    hm("observedDuringCall") = guardSeen
    hm("source") = "live #32770 enumeration of THIS process (WinOps.ReadActiveDialogsJson + WinOps.HostModalRiskProbe) PLUS the armed modal guard's own observation (WinOps.WoModalGuardReceipt.modalDetected); read-only, nothing is sent"

    Set root("host_modal") = hm
    If blocking Then
        If Len(CStr(root("stopReason"))) = 0 Then root("stopReason") = "host_modal_blocking"
    End If
    Err.Clear
End Sub

' The same receipt as a JSON FRAGMENT (no outer braces), for the tools whose reply is a
' JSON TEXT rather than a Dictionary (vba6_probe). Built by serialising a Dictionary and
' stripping its braces, so no hand-rolled escaping can break the shape.
Private Function ModalGuardFragment() As String
    On Error Resume Next
    ModalGuardFragment = ""
    Dim mg As Object
    Set mg = WinOps.WoModalGuardReceipt()
    If mg Is Nothing Then Exit Function
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("modalGuard") = "armed"
    d("modalDetected") = mg("modalDetected")
    d("modalTitle") = mg("modalTitle")
    d("modalBody") = mg("modalBody")
    d("modalClickedButton") = mg("modalClickedButton")
    d("modalClicked") = mg("modalClicked")
    d("modalWaitMs") = mg("modalWaitMs")
    d("modalWaitedMs") = mg("modalWaitedMs")
    d("modalSideEffects") = mg("modalSideEffects")
    d("modalRecoveredBy") = mg("modalRecoveredBy")
    d("modalPolicy") = mg("modalPolicy")
    d("modalRefusedReason") = mg("modalRefusedReason")
    d("modalHostRisk") = mg("modalHostRisk")
    d("modalHostRiskClass") = mg("modalHostRiskClass")
    d("modalNote") = mg("modalNote")
    d("clickedButton") = mg("modalClickedButton")
    d("waitedMs") = mg("modalWaitedMs")
    Dim whole As String
    whole = JsonStringify(d)
    If Len(whole) > 2 Then
        If Left$(whole, 1) = "{" Then ModalGuardFragment = Mid$(whole, 2, Len(whole) - 2)
    End If
    Err.Clear
End Function

