    root("diagnosisAvailable") = logFromThisCall
    root("diagnosisUnavailableReason") = ""
    root("diagnosisAlternative") = ""
    If Not logFromThisCall Then
        If useIde Then
            root("diagnosisUnavailableReason") = "this route (in-IDE Make / VBProject.MakeCompiledFile) has NO compiler subprocess, so no /out log and no compiler error text can exist for it - structurally, not as a failure of this call"
            root("diagnosisAlternative") = "run the isolated compiler where the IDE does NOT hold the project: call build{project=<a COPY of the .vbp>}, or make_project on a copy. An isolated VB6.EXE /make cannot compile a file the IDE has open - it exits 0 without writing the log."
        Else
            root("diagnosisUnavailableReason") = "the isolated /make subprocess ran but wrote no readable log at logPath"
            root("diagnosisAlternative") = "re-run and check that logPath is writable, or read firstError: when the compiler located an error it is still populated from the process output."
        End If
    End If
    ' (Lead's K criterion): only emit firstError when something REAL was recognised.
    ' Emitting {file:"", line:0, lineSpace:"disk", lineIde:0, text:""} when nothing was parsed
    ' asserts the EXISTENCE of a first error that was never found - the same fabrication, one level
    ' down, and it is the object a consumer actually reads.  Unparsed => the object is absent, and
    ' lineSpace is never asserted for an error we do not have.
    If Len(br.file) > 0 Or br.reportedLine > 0 Or Len(Trim$(br.message)) > 0 Then
        Dim feOut As Object
        Set feOut = CreateObject("Scripting.Dictionary")
        If Len(br.file) > 0 Then feOut("file") = br.file
        If br.diskLine > 0 Then
            feOut("line") = br.diskLine
            feOut("lineSpace") = "disk"
        End If
        If br.reportedLine > 0 Then feOut("lineIde") = br.reportedLine
        If Len(Trim$(br.message)) > 0 Then feOut("text") = br.message
        Set root("firstError") = feOut
    End If
    If Len(br.file) = 0 And Len(Trim$(br.message)) > 0 Then
        root("firstErrorNote") = "the compiler reported a message without a file location, so firstError.file is empty; firstError.text still carries the diagnostic"
    End If
    ' ---- (3.2): is the artifact held by a running process? ----------
    Set root("output") = ArtifactFullSnap(artifact)

    ' R-1021-04: fixed build-receipt fields (additive; existing keys keep their
    ' meaning). artifact mirrors output with a bytes alias, logUnavailable is
    ' explicit, and elapsedMs is always present.
    Dim artFixed As Object
    Set artFixed = ArtifactFullSnap(artifact)
    If CBool(artFixed("exists")) Then
        artFixed("bytes") = artFixed("size")
    Else
        artFixed("bytes") = 0
    End If
    Set root("artifact") = artFixed

    If selfHeldOnly Then
        Dim rpf As Object
        Set rpf = CreateObject("Scripting.Dictionary")
        rpf("held") = True
        rpf("holderPid") = holderInfo("holderPid")
        rpf("holderKind") = holderInfo("holderKind")
        rpf("holderIsSelf") = True
        rpf("reason") = "project_held_by_ide"
        rpf("action") = "in_ide_make_instead"
        rpf("note") = "this IDE holds the project, so an isolated /make was not started; the in-IDE Make route produced this receipt"
        Set root("cliPreflight") = rpf
    End If
    root("logPath") = logPath
    If Not root.Exists("logBytes") Then root("logBytes") = 0
    If root.Exists("logAvailable") Then
        root("logUnavailable") = Not CBool(root("logAvailable"))
    Else
        root("logUnavailable") = True
    End If
    If CBool(root("logUnavailable")) Then
        If Not root.Exists("logUnavailableReason") Then root("logUnavailableReason") = "cli_failed"
    End If
    root("artifactStashed") = artStashed
    If artStashed Then
        root("artifactStashPath") = artBackup
        root("artifactStashRetained") = artStashRetained
        If artStashRetained Then root("artifactStashNote") = "the compile DID refresh the artifact, but the per-call stash could not be removed (the path still exists after Kill), so it is reported as retained instead of being silently left behind. The name is unique per call (<exe>.buildstash-<pid>-<ticks>) and can never collide with the RETAINED <exe>.before-build recovery candidate."
    End If
    If artRestored Then root("artifactRestored") = True
    root("elapsedMs") = GetTickCount() - el0
    root("pending") = (Not CBool(root("output")("exists"))) And br.ok And Len(artifact) > 0
    If CBool(root("pending")) Then root("pending_how_to_confirm") = "the artifact has not appeared yet: re-read output.exists / output.size / output.sha256 and check the file starts with a PE header (MZ at offset 0); do not read compiled/ok as evidence."
    root("artifact_locked") = False
    root("artifact_locker_pid") = 0
    root("artifact_locked_advice") = ""
    root("artifact_holder_pid") = 0
    If Len(artifact) > 0 And (Not artChanged) Then
        Dim holderBpid As Long
        holderBpid = ArtifactHolderPid(artifact)
        Dim bWriteLocked As Boolean
        bWriteLocked = ArtifactWriteLocked(artifact)
        If holderBpid > 0 Or bWriteLocked Then
            root("artifact_locked") = True
            root("artifact_locker_pid") = holderBpid
            root("artifact_holder_pid") = holderBpid
            If holderBpid > 0 Then
                root("artifact_locked_hint") = "the artifact was not rewritten and its image is running as pid " & CStr(holderBpid)
            Else
                root("artifact_locked_hint") = "the artifact was not rewritten and an exclusive open of it failed, so another process holds it (the OS names no lock owner: artifact_locker_pid = 0 means UNKNOWN, not unlocked)"
            End If
            root("artifact_locked_advice") = "do NOT just retry: rename the existing artifact first (e.g. <name>.locked-build) or close the process holding it, then rebuild"
        End If
    End If
    ' ---- (A10): LAA on the artifact --------------------------------
    If laaUsable Then
        ApplyLaaInto root, artifact, laaWant
    Else
        LaaConfigRefusal root, laaProjFile, laaCfgErr
    End If
    root("laaSource") = laaSrc
    root("laaProjectFile") = laaProjFile
    root("laaSourceNote") = laaSrcNote
    root("laaConfigError") = laaCfgErr
    ' W-C (P6): FINAL artifact identity - sampled AFTER the LAA patch, verified by a second read.
    Dim wcDetail2 As String
    wcDetail2 = "after_compile"
    If CBool(root("laaSet")) Or CBool(root("laaAlready")) Then wcDetail2 = "after_laa_patch"
    Set root("final") = WcFinalArtifactJson(artifact, wcDetail2, WcVbpRevisionText(vbp))
    root("artifactChangedBasedOn") = "final"
    If CBool(root("laaSet")) Then
        root("artifactChanged") = True
        root("artifactChangedNote") = "the LAA PE patch changed the artifact bytes AFTER the compile, so artifactChanged is true on the FINAL bytes"
    End If
    ' WP-22-04 (MCP-1022-50): same defect and the same fix as make_project.
    ' FIX-23: same isolation as the make_project site - receipt shaping must never be able to
    ' turn a finished build receipt into unexpected_error(450).
    Dim finxErrN2 As Long, finxErrD2 As String
    On Error Resume Next
    Err.Clear
    Call Build.FinalizeArtifactOutput(root, artifact)
    finxErrN2 = Err.Number
    finxErrD2 = Err.Description
    Err.Clear
    On Error GoTo 0
    If finxErrN2 <> 0 Then
        root("outputFinalizeOk") = False
        root("outputFinalizeErrorCode") = finxErrN2
        root("outputFinalizeError") = finxErrD2
        root("outputFinalizeNote") = "the artifact-identity reshaping step (Build.FinalizeArtifactOutput) raised VB error " & CStr(finxErrN2) & " (" & finxErrD2 & "); output{} is the snapshot taken BEFORE that step and every other field of this receipt is unaffected. This is an ADD-IN defect reported as data instead of reason=unexpected_error."
        root("outputFinalizeAdvice") = "read output{} and artifact{} for the artifact identity and report outputFinalizeErrorCode with this receipt; the compile result itself is not implicated"
    Else
        root("outputFinalizeOk") = True
        root("outputFinalizeErrorCode") = 0
    End If
    If useIde Then root("laaNote") = "the route was the in-IDE Make (see ideMake), which already ran the LAA step; this receipt re-read the artifact and reports its real state"
    ' v1.11.12: the TERMINAL stop reason. timedOut wins over every other state: a killed
    ' compiler is NOT a compile verdict, so ok/verdict/pending are overridden ONLY here and
    ' ONLY when the child was actually killed.
    If hbTimedOut Then
        root("ok") = False
        root("verdict") = "timeout"
        root("pending") = False
        root("buildState") = "failed"
        root("timeoutNote") = "the isolated VB6.EXE compiler subprocess was KILLED at the " & CStr(hbAppliedBudget) & " ms hard budget (childPid " & CStr(hbChildPid) & "; " & hbKillMethod & "). A timed-out compile is NOT a compile verdict and the artifact state is reported separately in output{}. " & IIf(hbLeftover, "WARNING: tasklist still listed the child right after the kill.", "tasklist did not list the child after the kill (no leftover).")
        root("suggestedAction") = "the compile did not finish inside budgetMs: raise timeout_ms (max " & CStr(BUILD_BUDGET_MAX_MS) & " ms), or build a smaller project, then retry. Do not read ok=false as a compiler error."
    Else
        If Not CBool(root("ok")) Then
            root("budgetNote") = "the budget did not expire, so ok/verdict are the compiler result (unchanged semantics)."
        Else
            root("budgetNote") = "the compile finished inside budgetMs; ok/verdict are the compiler result (unchanged semantics)."
        End If
    End If

    ' R-1021-04: hardened. a compile is only a SUCCESS with a refreshed artifact whose
    ' sha256 was read back from the file; compiled:true alone is not a build.
    If CBool(root("ok")) Then
        Dim okArt As Object
        Set okArt = root("artifact")
        Dim okChanged As Boolean
        okChanged = False
        If root.Exists("artifactChanged") Then okChanged = CBool(root("artifactChanged"))
        If (Not CBool(okArt("exists"))) Or (Not okChanged) Or (Len(CStr(okArt("sha256"))) = 0) Then
            root("ok") = False
            root("okDemotionReason") = "compiled:true alone is not a build: the artifact was not refreshed (or its sha256 could not be read), so ok is demoted to false"
            If Not root.Exists("buildState") Then root("buildState") = "completed_without_artifact_change"
            If Not root.Exists("suggestedAction") Then root("suggestedAction") = "read verdict/artifact/output; close any process holding the artifact and rebuild, or use make_project route=cli with diagnose=true for a real compiler log"
        Else
            root("buildState") = "completed"
            root("okBasis") = "artifactChanged=true and artifact.sha256 was read from the refreshed file"
        End If
    End If
    ' R-1021-04 (item 5): in-IDE Make diagnostics. compiled=true means the
    ' compiler accepted the code; artifactChanged decides whether it was BUILT.
    ' A real failure is probed (code pane + error box) and reports
    ' firstErrorUnavailable + reason instead of a fabricated line.
    If useIde Then
        Dim ideCompiled As Boolean
        ideCompiled = (InStr(1, ideMakeJson, Chr$(34) & "compiled" & Chr$(34) & ":true", vbTextCompare) > 0)
        If ideCompiled Then
            root("errorCount") = 0
            If CBool(root("ok")) Then
                If Not root.Exists("firstError") Then root("firstErrorNote") = "success: no compiler diagnostics exist on the in-IDE route"
            Else
                If Not root.Exists("firstError") Then root("firstErrorNote") = "the in-IDE Make compiled without errors, but the artifact was not refreshed; this is not a compile error (read artifactChanged/artifactLockedHint)"
            End If
        Else
            If (Not root.Exists("firstError")) And (Not ideRefused) Then
                Dim ideProbe As Object
                Set ideProbe = IdeFirstErrorProbe()
                Dim makeErrText As String
                makeErrText = IdeJsonStrMember(ideMakeJson, "makeErrorText")
                If CBool(ideProbe("found")) Then
                    Dim feMerge As Object
                    Set feMerge = ideProbe("firstError")
                    If Len(makeErrText) > 0 Then
                        ' MERGE: the code pane proves the LOCATION, Err.Description
                        ' proves the MESSAGE. The line is only ever the code pane's.
                        feMerge("dialogText") = makeErrText
                        feMerge("dialogTextSource") = "make_error"
                        feMerge("source") = "make_error+" & CStr(feMerge("source"))
                    End If
                    Set root("firstError") = feMerge
                    root("errorCount") = 1
                    root("firstErrorSource") = "in_ide_make"
                ElseIf Len(makeErrText) > 0 Then
                    Dim feMakeOnly As Object
                    Set feMakeOnly = CreateObject("Scripting.Dictionary")
                    feMakeOnly("dialogText") = makeErrText
                    feMakeOnly("dialogTextSource") = "make_error"
                    feMakeOnly("lineUnavailable") = True
                    feMakeOnly("source") = "make_error"
                    Set root("firstError") = feMakeOnly
                    root("errorCount") = 1
                    root("firstErrorSource") = "in_ide_make"
                Else
                    root("firstErrorUnavailable") = True
                    root("firstErrorUnavailableReason") = CStr(ideProbe("reason"))
                    root("firstErrorUnavailableSource") = "in_ide_make"
                End If
            End If
        End If
    End If
    ' R-1021-04 (item A): object members of the nested in-IDE receipt that this entry
    ' could not rebuild are published here too - a receipt that reports the outcome must
    ' carry the evidence for it. ADDITIVE and last-resort only: an outer member always
    ' wins, and nothing is invented when the nested receipt has none.
    If Len(ideMakeJson) > 0 Then
        Dim ideParsed As Variant
        If JsonParse(ideMakeJson, ideParsed) Then
            If IsObject(ideParsed) Then
                If Not root.Exists("firstError") Then
                    If ideParsed.Exists("firstError") Then
                        If IsObject(ideParsed("firstError")) Then
                            Set root("firstError") = ideParsed("firstError")
                            root("firstErrorSource") = "make_project"
                        End If
                    End If
                End If
                If Not root.Exists("saveError") Then
                    If ideParsed.Exists("saveError") Then
                        If IsObject(ideParsed("saveError")) Then
                            Set root("saveError") = ideParsed("saveError")
                        End If
                    End If
                End If
            End If
        End If
    End If
    ToolBuild = JsonStringify(root)
End Function

Private Function ToolEditByAnchor(ByVal name As String, ByVal anchor As String, ByVal newText As String, _
                                 ByVal expectedSha As String, ByVal occurrence As Long, ByVal matchMode As String, _
                                 ByVal scopeObj As Object, ByVal validateMode As String, ByVal snapshotOn As Boolean) As String
    Dim cur As String, nx As String, em As String
    ' the same segment timing replace_code reports, so the ~10 s can be
    ' attributed instead of guessed.
    Dim tEntry As Long, tRead As Long, tPredict As Long, tLint As Long, tWrite As Long
    tEntry = GetTickCount()
    cur = CompText(name)
    GuardSha cur, expectedSha
    tRead = GetTickCount()
    Dim hitLine As Long, matched As String, rsn As String, cnt As Long
    ' how many pane lines the anchor matched (1 = single line).
    Dim spanLines As Long
    ' one op, so no batch index is built; the candidate list is built only in
    ' the failure branch below (it costs a whole-text split + a ProcOfLine per hit).
    Dim hitsA() As Long
    Dim eRaw() As String, eNorm() As String
    Dim eFirst As Object, eCnts As Object, eRawFirst As Object, eRawCnts As Object
    If Not ResolveAnchor(name, cur, anchor, matchMode, scopeObj, occurrence, (occurrence <= 0), hitLine, matched, rsn, hitsA, cnt, spanLines, eRaw, eNorm, eFirst, eCnts, eRawFirst, eRawCnts) Then
        Dim root As Object
        Set root = CreateObject("Scripting.Dictionary")
        root("ok") = False
        root("reason") = rsn
        root("component") = name
        root("anchor") = anchor
        root("occurrence") = occurrence
        root("hitCount") = cnt
        Set root("hits") = HitList(name, cur, hitsA, cnt)
        ' ruling 4: hits[].line are line numbers, so this failure carries coords too
        Set root("coords") = CoordsDictOfName(name, 1, "ide")
        root("lineSpace") = "ide"
        root("lineSpaceHint") = "hits[].line are IDE code-pane lines; get_component_code's numbered output is DISK lines (ideLine = diskLine - coords.headerOffset)"
        root("note") = "the component was NOT modified"
        ToolEditByAnchor = JsonStringify(root)
        Exit Function
    End If
    Dim curLines() As String
    curLines = McpCls.TextLines(Me, cur)
    ' (the structural-gate review/the wording review): the same PRE-WRITE structural gate.
    Dim pairRefE As String
    pairRefE = PreWritePairingRefusal("edit_by_anchor", name, newText, "new_text")
    If Len(pairRefE) > 0 Then
        ToolEditByAnchor = pairRefE
        Exit Function
    End If
    ' ---- beta-2
    If IsContinuationTail(curLines, hitLine) Then
        ToolEditByAnchor = GuardReject(name, "edit_by_anchor", "inside_continuation", _
            "the anchor line " & CStr(hitLine) & " is the tail of a logical line: line " & CStr(hitLine - 1) & " ends with a VB continuation _. Replacing it would split that logical line; anchor the FIRST line of the logical statement instead.", _
            hitLine, hitLine, LineCount(cur))
        Exit Function
    End If
    ' a MULTI-LINE anchor replaces the WHOLE matched block, not
    ' only its first line (the A batch answered anchor_not_found for a pasted block).
    ' The extra matched lines are removed with D ops; ApplyLineOps sorts DESCENDING, so
    ' the trailing D ops are applied before the R at the block's first line.
    Dim lineOps() As String
    Dim nOps As Long
    nOps = spanLines
    If nOps < 1 Then nOps = 1
    ReDim lineOps(0 To nOps - 1)
    lineOps(0) = "R" & vbTab & CStr(hitLine) & vbTab & Replace(newText, vbCrLf, Chr$(1))
    Dim q As Long
    For q = 1 To nOps - 1
        lineOps(q) = "D" & vbTab & CStr(hitLine + q)
    Next q
    nx = EditTxn.ApplyLineOps(cur, lineOps, em)
    tPredict = GetTickCount()
    If Len(em) > 0 Then Err.Raise vbObjectError + 82, "CodeTools", em
    ' (the structural-gate review reverse direction): an anchor block may legally be a FRAGMENT, so
    ' judge the RESULT: refuse only when the pane was balanced and would stop being so.
    Dim ppRefE As String
    ppRefE = PredictedPairingRefusal("edit_by_anchor", name, cur, nx, "anchor at line " & CStr(hitLine) & " (" & CStr(nOps) & " line(s))")
    If Len(ppRefE) > 0 Then
        ToolEditByAnchor = ppRefE
        Exit Function
    End If
    ' ---- beta-3 + gamma-4
    Dim pack As Object
    ' region target = the anchor line that was just edited.
    Set pack = LintPackForEdit(nx, KindOfName(name), LineCount(cur), hitLine)
    tLint = GetTickCount()
    Dim sref As String
    sref = StrictRefusal(name, "edit_by_anchor", pack, validateMode)
    If Len(sref) > 0 Then
        ToolEditByAnchor = sref
        Exit Function
    End If
    ' opt-in snapshot. This tool already snapshots through the write funnel
    ' (default behaviour, unchanged); when the caller asks explicitly we take it HERE and
    ' tell the funnel to skip, so snapshot=true still writes exactly ONE file.
    If snapshotOn Then UndoSnapshot name, cur
    Dim wCalls As Long
    wCalls = SetCompTextMinimal(name, cur, nx, snapshotOn)
    tWrite = GetTickCount()
    Dim extra As Object
    Set extra = CreateObject("Scripting.Dictionary")
    extra("writeCalls") = wCalls
        extra("hunks") = m_lastWriteHunks
    extra("readMs") = tRead - tEntry
    extra("predictMs") = tPredict - tRead
    extra("lintMs") = tLint - tPredict
    extra("writeMs") = tWrite - tLint
    AddWritePhases extra
    Dim rq As Object
    Set rq = CreateObject("Scripting.Dictionary")
    rq("mode") = "anchor"
    rq("anchor") = anchor
    rq("occurrence") = occurrence
    rq("match") = IIf(Len(Trim$(matchMode)) = 0, "normalized", matchMode)
    If Not scopeObj Is Nothing Then Set rq("scope") = scopeObj
    Set extra("requestedRange") = rq
    Set extra("appliedRange") = AppliedRangeDict(hitLine, hitLine + nOps - 1)
    extra("clamped") = False
    extra("matchedText") = matched
    extra("matchedLine") = hitLine
    extra("matchedSpanLines") = nOps
    ' echo the TARGET PROCEDURE first/last line, before and
    ' after, computed from the pane text on both sides - so a line-number drift shows
    ' up in the receipt itself instead of silently editing another procedure.
    Set extra("procBefore") = ProcEchoDict(cur, hitLine)
    Set extra("procAfter") = ProcEchoDict(nx, hitLine)
    ToolEditByAnchor = ChangeResult2(name, cur, nx, pack, extra, tEntry)
End Function

' alpha: the candidate lines of a rejected anchor, with the enclosing
' procedure and the raw line text, so the caller can pick one instead of guessing.
' called ONLY when a failure must be reported (the success path used to build
' this for every op). procMemo caches CodeModule.ProcOfLine per line for the duration of
' one tool call, so a repeated line is never probed twice.
Private Function HitList(ByVal name As String, ByVal text As String, ByRef hits() As Long, ByVal cnt As Long, Optional ByVal procMemo As Object = Nothing) As Object
    Dim arr As Object
    Set arr = New Collection
    Dim lines() As String
    lines = McpCls.TextLines(Me, text)
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    Dim i As Long, ln As Long
    For i = 0 To cnt - 1
        MaybePump
        ln = hits(i)
        Dim d As Object
        Set d = CreateObject("Scripting.Dictionary")
        d("line") = ln
        d("proc") = ProcNameOfLineCached(comp, ln, procMemo)
        If ln >= 1 And ln <= UBound(lines) + 1 Then d("text") = lines(ln - 1)
        arr.Add d
    Next
    Set HitList = arr
End Function

Private Function ProcNameOfLine(ByVal comp As VBIDE.VBComponent, ByVal line As Long) As String
    On Error Resume Next
    ProcNameOfLine = ""
    If comp Is Nothing Then Exit Function
    If comp.CodeModule Is Nothing Then Exit Function
    ProcNameOfLine = comp.CodeModule.ProcOfLine(line, vbext_pk_Proc)
End Function

' ProcOfLine is a COM call; remember it per line for the duration of one tool
' call. Errors inside ProcNameOfLine already collapse to "" (see there), so an error entry
' is cached as "" - the same value the uncached call would return.
Private Function ProcNameOfLineCached(ByVal comp As VBIDE.VBComponent, ByVal line As Long, ByVal procMemo As Object) As String
    If procMemo Is Nothing Then
        ProcNameOfLineCached = ProcNameOfLine(comp, line)
        Exit Function
    End If
    If procMemo.Exists(line) Then
        ProcNameOfLineCached = procMemo(line)
        Exit Function
    End If
    Dim p As String
    p = ProcNameOfLine(comp, line)
    procMemo(line) = p
    ProcNameOfLineCached = p
End Function

' =====================================================================
' contract v1.16.0 (the batch-editing card): MULTI-COMPONENT anchor batch for apply_edits / preview_edit.
'
' The add-in is single-threaded (STA) and cannot do asynchronous work, so "many changes" used
' to cost one round trip per call. This layer compresses N ops across up to 40 components into
' ONE call: ONE pre-edit _undo snapshot per touched component, ONE rollback unit, NO new tool.
' A single-component call is DELEGATED to the unchanged single core, so its receipt stays
' key-for-key identical.
'
' CONTRACT
'   * edits[] items may carry component; the tool-level name is the DEFAULT component.
'     Both missing => ok:false reason=component_required + opIndex, nothing written.
'   * expected_shas:[{component,sha256}] is a pre-write guard (the legacy expected_sha256
'     still guards the default/single component). Any mismatch => refusal with
'     guards[{component,expected,actual,ok}] and NO writes.
'   * order: ops apply in edits[] order; inside a component every anchor is resolved on that
'     component's UPDATED text (earlier ops may move later anchors). Components are
'     independent, so the relative order BETWEEN components does not change the result.
'   * all-or-nothing: a component is written only after all of ITS ops resolved; on any
'     failure every component already written is restored to its pre-batch pane text and the
'     restore is PROVEN by read-back (restoreVerified), then ok:false + failedOpIndex (GLOBAL)
'     + hits[] + rolledBack:true.
'   * limits: max_ops (default 200, capped 1000) and 40 components; exceeding either is
'     ok:false reason=batch_too_large + limits{ops,components,max_ops}, nothing written.
' =====================================================================
Private Function BatchBaseObj(ByVal toolName As String) As Object
    Dim f As Object
    Set f = CreateObject("Scripting.Dictionary")
    f("tool") = toolName
    f("ok") = False
    f("readOnly") = (toolName = "preview_edit")
    Set BatchBaseObj = f
End Function

Private Function BatchNewestUndo(ByVal compName As String) As String
    ' the snapshot PATH the just-taken _undo snapshot landed on (empty when snapshots are off)
    On Error Resume Next
    BatchNewestUndo = ""
    Dim d As String
    d = UndoDir()
    If Len(d) = 0 Then Exit Function
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(d) Then Exit Function
    Dim stem As String
    stem = SafeFileStem(compName) & "."
    Dim f As Object, best As String
    best = ""
    For Each f In fso.GetFolder(d).Files
        If Left$(f.Name, Len(stem)) = stem Then
            If f.Name > best Then best = f.Name
        End If
    Next
    If Len(best) > 0 Then BatchNewestUndo = CtlJoinPath(d, best)
    Err.Clear
End Function

Private Function BatchCollectOps(ByVal args As Object, ByVal defName As String, ByRef opsColl As Object, _
                                 ByRef compColl As Object, ByRef badIndex As Long, ByRef why As String) As Boolean
    BatchCollectOps = False
    Set opsColl = New Collection
    Set compColl = New Collection
    badIndex = -1
    why = ""
    Dim edits As Object
    Set edits = JsonGetAny(args, "edits")
    Dim n As Long
    n = CollectionCount(edits)
    If n = 0 Then
        why = "edits_required"
        Exit Function
    End If
    Dim i As Long, it As Variant, d As Object, c As String
    i = 0
    For Each it In edits
        If Not IsObject(it) Then
            badIndex = i
            why = "edits_item_not_object"
            Exit Function
        End If
        Set d = it
        c = Trim$(defName)
        If d.Exists("component") Then
            If Len(Trim$(CStr(d("component")))) > 0 Then c = Trim$(CStr(d("component")))
        End If
        If Len(c) = 0 Then
            badIndex = i
            why = "component_required"
            Exit Function
        End If
        opsColl.Add d
        compColl.Add c
        i = i + 1
    Next
    BatchCollectOps = True
End Function

Private Function BatchOrder(ByVal compColl As Object, ByRef order As Object, ByRef keyMap As Object) As Long
    Set order = New Collection
    Set keyMap = CreateObject("Scripting.Dictionary")
    Dim i As Long, c As String, k As String
    For i = 1 To compColl.Count
        c = CStr(compColl(i))
        k = LCase$(c)
        If Not keyMap.Exists(k) Then
            keyMap(k) = order.Count + 1
            order.Add c
        End If
    Next
    BatchOrder = order.Count
End Function

Private Function BatchAllNamed(ByVal compColl As Object, ByVal name As String) As Boolean
    BatchAllNamed = (Len(Trim$(name)) > 0)
    If Not BatchAllNamed Then Exit Function
    Dim i As Long
    For i = 1 To compColl.Count
        If LCase$(CStr(compColl(i))) <> LCase$(Trim$(name)) Then
            BatchAllNamed = False
            Exit Function
        End If
    Next
End Function

Private Function BatchSubEdits(ByVal opsColl As Object, ByVal compColl As Object, ByVal compName As String, _
                               ByRef idxColl As Object) As Object
    Dim c As Object
    Set c = New Collection
    Set idxColl = New Collection
    Dim i As Long
    For i = 1 To opsColl.Count
        If LCase$(CStr(compColl(i))) = LCase$(compName) Then
            c.Add opsColl(i)
            idxColl.Add i - 1
        End If
    Next
    Set BatchSubEdits = c
End Function

Private Function BatchLimitRefusalJson(ByVal toolName As String, ByVal nOps As Long, ByVal nComp As Long, ByVal maxOps As Long) As String
    Dim f As Object, lim As Object
    Set f = BatchBaseObj(toolName)
    f("reason") = "batch_too_large"
    f("message") = "the batch has " & CStr(nOps) & " op(s) across " & CStr(nComp) & " component(s); the limits are max_ops=" & CStr(maxOps) & " and 40 components. Nothing was written."
    Set lim = CreateObject("Scripting.Dictionary")
    lim("ops") = nOps
    lim("components") = nComp
    lim("max_ops") = maxOps
    lim("max_components") = 40
    Set f("limits") = lim
    f("note") = "the limit is checked BEFORE any snapshot, resolve or write"
    BatchLimitRefusalJson = JsonStringify(f)
End Function

Private Function BatchGuardOne(ByVal guards As Object, ByVal comp As String, ByVal expected As String) As Boolean
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("component") = comp
    d("expected") = UCase$(Trim$(expected))
    Dim act As String
    act = ""
    If Len(Trim$(comp)) > 0 Then act = Sha256.Sha256HexTextUtf8(CompText(Trim$(comp)))
    d("actual") = UCase$(act)
    d("ok") = (Len(Trim$(comp)) > 0 And Len(Trim$(expected)) > 0 And UCase$(Trim$(expected)) = UCase$(act))
    guards.Add d
    BatchGuardOne = CBool(d("ok"))
End Function

Private Function BatchGuards(ByVal args As Object, ByVal order As Object, ByVal expectedSha As String, _
                             ByVal defName As String, ByRef guards As Object, ByRef why As String) As Boolean
    BatchGuards = True
    why = ""
    Set guards = New Collection
    Dim anyBad As Boolean
    anyBad = False
    If Len(Trim$(expectedSha)) > 0 Then
        Dim target As String
        target = Trim$(defName)
        If Len(target) = 0 Then
            If order.Count = 1 Then target = CStr(order(1))
        End If
        If Len(target) = 0 Then
            why = "expected_sha256_without_target_component"
            BatchGuards = False
            Exit Function
        End If
        anyBad = Not BatchGuardOne(guards, target, expectedSha)
    End If
    Dim xa As Object
    Set xa = JsonGetAny(args, "expected_shas")
    If Not xa Is Nothing Then
        Dim i As Long, d As Object
        For i = 1 To CollectionCount(xa)
            Set d = Nothing
            Set d = xa(i)
            If Not d Is Nothing Then
                If Not BatchGuardOne(guards, McpCls.DictStr(Me, d, "component"), McpCls.DictStr(Me, d, "sha256")) Then anyBad = True
            End If
        Next
    End If
    If anyBad Then why = "guard_sha_mismatch"
    BatchGuards = Not anyBad
End Function

Private Function BatchGuardRefusalJson(ByVal toolName As String, ByVal guards As Object, ByVal why As String, _
                                       ByVal nOps As Long, ByVal nComp As Long) As String
    Dim f As Object
    Set f = BatchBaseObj(toolName)
    f("reason") = why
    f("message") = "a pre-write guard rejected the batch: nothing was resolved, snapshotted or written"
    Set f("guards") = guards
    f("appliedOps") = 0
    f("totalOps") = nOps
    f("componentsInBatch") = nComp
    f("note") = "expected_shas (and the legacy expected_sha256 for the default component) must match the CURRENT pane text; no file and no pane was touched"
    BatchGuardRefusalJson = JsonStringify(f)
End Function

Private Function JsonToDict(ByVal s As String, ByRef outD As Object) As Boolean
    JsonToDict = False
    Set outD = Nothing
    If Len(Trim$(s)) = 0 Then Exit Function
    Dim v As Variant
    If Not JsonParse(s, v) Then Exit Function
    If Not IsObject(v) Then Exit Function
    Set outD = v
    JsonToDict = True
End Function

Private Sub BatchMergeInto(ByRef dst As Object, ByVal src As Object)
    If src Is Nothing Then Exit Sub
    Dim k As Variant
    For Each k In src.Keys
        If IsObject(src(CStr(k))) Then
            Set dst(CStr(k)) = src(CStr(k))
        Else
            dst(CStr(k)) = src(CStr(k))
        End If
    Next
End Sub

Private Function ToolApplyEdits(ByVal args As Object) As String
    Dim t0 As Long
    t0 = GetTickCount()
    Dim defComp As String, expectedSha As String, matchMode As String, validateMode As String
    defComp = JsonGetStr(args, "name")
    expectedSha = JsonGetStr(args, "expected_sha256")
    matchMode = JsonGetStr(args, "match")
    validateMode = JsonGetStr(args, "validate")
    Dim snapshotOn As Boolean
    snapshotOn = SnapshotOptIn(args)
    Dim hasGuards As Boolean, hasMax As Boolean
    hasGuards = (Not JsonGetAny(args, "expected_shas") Is Nothing)
    hasMax = HasArg(args, "max_ops")
    Dim opsColl As Object, compColl As Object, badIdx As Long, why As String
    If Not BatchCollectOps(args, defComp, opsColl, compColl, badIdx, why) Then
        If why = "edits_required" Then
            ToolApplyEdits = ToolApplyEditsSingle(defComp, JsonGetAny(args, "edits"), expectedSha, matchMode, validateMode, snapshotOn)
            Exit Function
        End If
        Dim cr As Object
        Set cr = BatchBaseObj("apply_edits")
        cr("reason") = why
        cr("opIndex") = badIdx
        cr("note") = "nothing was resolved, snapshotted or written"
        cr("howToProceed") = "give every edits[] item a component, or pass the tool-level name as the DEFAULT component"
        ToolApplyEdits = JsonStringify(cr)
        Exit Function
    End If
    Dim order As Object, keyMap As Object, nComp As Long, nOps As Long
    nOps = opsColl.Count
    nComp = BatchOrder(compColl, order, keyMap)
    If nComp = 1 And (Not hasGuards) And (Not hasMax) And BatchAllNamed(compColl, defComp) Then
        ToolApplyEdits = ToolApplyEditsSingle(defComp, JsonGetAny(args, "edits"), expectedSha, matchMode, validateMode, snapshotOn)
        Exit Function
    End If
    Dim maxOps As Long
    maxOps = JsonGetLong(args, "max_ops", 200)
    If maxOps <= 0 Then maxOps = 200
    If maxOps > 1000 Then maxOps = 1000
    If nOps > maxOps Or nComp > 40 Then
        ToolApplyEdits = BatchLimitRefusalJson("apply_edits", nOps, nComp, maxOps)
        Exit Function
    End If
    Dim guards As Object
    If Not BatchGuards(args, order, expectedSha, defComp, guards, why) Then
        ToolApplyEdits = BatchGuardRefusalJson("apply_edits", guards, why, nOps, nComp)
        Exit Function
    End If
    Dim preText As Object, preSha As Object, snapIds As Object
    Set preText = CreateObject("Scripting.Dictionary")
    Set preSha = CreateObject("Scripting.Dictionary")
    Set snapIds = CreateObject("Scripting.Dictionary")
    Dim i As Long, c As String, k As String, ct As String
    For i = 1 To nComp
        c = CStr(order(i))
        k = LCase$(c)
        ct = CompText(c)
        If Len(ct) = 0 Then
            Dim nf As Object
            Set nf = BatchBaseObj("apply_edits")
            nf("reason") = "component_not_found"
            nf("component") = c
            nf("opIndex") = 0
            nf("note") = "the component has no readable code pane; nothing was snapshotted or written"
            ToolApplyEdits = JsonStringify(nf)
            Exit Function
        End If
        preText(k) = ct
        preSha(k) = UCase$(Sha256.Sha256HexTextUtf8(ct))
    Next
    Dim snapList As Object
    Set snapList = New Collection
    For i = 1 To nComp
        c = CStr(order(i))
        k = LCase$(c)
        Call UndoSnapshot(c, CStr(preText(k)))
        snapIds(k) = BatchNewestUndo(c)
        Dim sd As Object
        Set sd = CreateObject("Scripting.Dictionary")
        sd("component") = c
        sd("path") = CStr(snapIds(k))
        sd("shaBefore") = CStr(preSha(k))
        snapList.Add sd
    Next
    Dim compsOut As Object, opDone As Object
    Set compsOut = New Collection
    Set opDone = CreateObject("Scripting.Dictionary")
    Dim primary As Object, lastPrimary As Object, primaryName As String
    Set primary = Nothing
    Set lastPrimary = Nothing
    primaryName = ""
    For i = 1 To nOps
        c = CStr(compColl(i))
        k = LCase$(c)
        Dim oneE As Object
        Set oneE = New Collection
        oneE.Add opsColl(i)
        Dim res As String, perr As String
        res = ""
        perr = ""
        On Error Resume Next
        res = ToolApplyEditsSingle(c, oneE, "", matchMode, validateMode, False, True)
        If Err.Number <> 0 Then
            perr = Err.Description
            Err.Clear
        End If
        On Error GoTo 0
        Dim pv As Object
        Set pv = Nothing
        If Len(perr) = 0 Then Call JsonToDict(res, pv)
        Dim opOk As Boolean
        opOk = False
        If Len(perr) = 0 And Not pv Is Nothing Then
            If pv.Exists("ok") Then
                If CBool(pv("ok")) Then opOk = True
            End If
            If Not opOk Then
                If pv.Exists("reason") Then
                    If InStr(1, CStr(pv("reason")), "no_write", vbTextCompare) = 1 Then opOk = True
                End If
            End If
        End If
        If Not opOk Then
            ' ---- FAILURE: restore EVERY TOUCHED component (the failing one included: its earlier
            ' ops were already written) and PROVE the restore by read-back ----
            Dim allOk As Boolean, restored As Object, q As Long
            allOk = True
            Set restored = New Collection
            For q = 1 To nComp
                Dim rc As String, rk As String, curNow As String
                rc = CStr(order(q))
                rk = LCase$(rc)
                curNow = CompText(rc)
                If UCase$(Sha256.Sha256HexTextUtf8(curNow)) <> UCase$(CStr(preSha(rk))) Then
                    Call SetCompTextMinimal(rc, curNow, CStr(preText(rk)), True)
                End If
                Dim rd As Object
                Set rd = CreateObject("Scripting.Dictionary")
                rd("component") = rc
                rd("shaBefore") = CStr(preSha(rk))
                rd("shaAfterRollback") = UCase$(Sha256.Sha256HexTextUtf8(CompText(rc)))
                rd("restored") = (UCase$(CStr(rd("shaAfterRollback"))) = UCase$(CStr(preSha(rk))))
                If Not CBool(rd("restored")) Then allOk = False
                restored.Add rd
            Next
            Dim compFail As Object
            Set compFail = New Collection
            For q = 1 To nComp
                Dim cf As Object
                Set cf = CreateObject("Scripting.Dictionary")
                rc = CStr(order(q))
                rk = LCase$(rc)
                cf("component") = rc
                cf("opsAppliedBeforeFailure") = 0
                If opDone.Exists(rk) Then cf("opsAppliedBeforeFailure") = CLng(opDone(rk))
                cf("shaBefore") = CStr(preSha(rk))
                cf("shaAfter") = UCase$(Sha256.Sha256HexTextUtf8(CompText(rc)))
                cf("verified") = (UCase$(CStr(cf("shaAfter"))) = UCase$(CStr(preSha(rk))))
                cf("snapshotId") = CStr(snapIds(rk))
                cf("status") = "restored_to_pre_batch"
                compFail.Add cf
            Next
            Dim f As Object
            Set f = BatchBaseObj("apply_edits")
            Call BatchMergeInto(f, pv)
            f("ok") = False
            f("multiComponent") = True
            f("component") = c
            f("failedOpIndex") = i - 1
            f("globalOpIndex") = i - 1
            If Len(perr) > 0 Then
                f("reason") = "engine_error"
                f("message") = perr
            ElseIf Not f.Exists("reason") Then
                f("reason") = "component_receipt_unusable"
            ElseIf Len(CStr(f("reason"))) = 0 Then
                f("reason") = "component_receipt_unusable"
            End If
            f("rolledBack") = True
            f("restoreVerified") = allOk
            Set f("restoredComponents") = restored
            f("appliedOps") = 0
            f("totalOps") = nOps
            f("appliedOpsBeforeRollback") = i - 1
            Set f("guards") = guards
            Set f("components") = compFail
            Set f("snapshots") = snapList
            f("batchElapsedMs") = GetTickCount() - t0
            f("note") = "all-or-nothing batch: every touched component was restored to its pre-batch pane text and PROVEN by read-back (restoreVerified); the failing op itself wrote nothing"
            ToolApplyEdits = JsonStringify(f)
            Exit Function
        End If
        opDone(k) = CLng(opDone(k)) + 1
        If primary Is Nothing Then
            Set primary = pv
            primaryName = c
        End If
        If LCase$(c) = LCase$(primaryName) Then Set lastPrimary = pv
    Next
    ' ---- success: per-component final state, MEASURED from the live pane ----
    Set compsOut = New Collection
    For i = 1 To nComp
        c = CStr(order(i))
        k = LCase$(c)
        Dim nd As Object
        Set nd = CreateObject("Scripting.Dictionary")
        nd("component") = c
        nd("ops") = CLng(opDone(k))
        nd("shaBefore") = CStr(preSha(k))
        nd("shaAfter") = UCase$(Sha256.Sha256HexTextUtf8(CompText(c)))
        nd("verified") = (UCase$(CStr(nd("shaAfter"))) = UCase$(Sha256.Sha256HexTextUtf8(CompText(c))))
        nd("snapshotId") = CStr(snapIds(k))
        nd("status") = "written"
        compsOut.Add nd
    Next
    Dim root As Object
    If lastPrimary Is Nothing Then
        Set root = CreateObject("Scripting.Dictionary")
    Else
        Set root = lastPrimary
    End If
    root("ok") = True
    root("multiComponent") = True
    root("component") = primaryName
    root("sha256Before") = CStr(preSha(LCase$(primaryName)))
    root("sha256After") = UCase$(Sha256.Sha256HexTextUtf8(CompText(primaryName)))
    root("paneTextSha256") = root("sha256After")
    root("appliedOps") = nOps
    root("totalOps") = nOps
    Set root("components") = compsOut
    Set root("guards") = guards
    Set root("snapshots") = snapList
    Dim lim As Object
    Set lim = CreateObject("Scripting.Dictionary")
    lim("ops") = nOps
    lim("components") = nComp
    lim("max_ops") = maxOps
    lim("max_components") = 40
    Set root("limits") = lim
    root("batchElapsedMs") = GetTickCount() - t0
    root("editOrderSemantics") = "ops apply in edits[] order; inside a component every anchor is resolved against that component's UPDATED text (earlier ops may move later anchors). Components are independent, so the order BETWEEN components does not change the result."
    root("readOnly") = False
    Dim rq As Object
    Set rq = CreateObject("Scripting.Dictionary")
    rq("mode") = "anchor-batch-multi"
    rq("ops") = nOps
    rq("components") = nComp
    rq("match") = IIf(Len(Trim$(matchMode)) = 0, "normalized", matchMode)
    Set root("requestedRange") = rq
    ToolApplyEdits = JsonStringify(root)
End Function

Private Function ToolPreviewEdit(ByVal args As Object) As String
    Dim t0 As Long
    t0 = GetTickCount()
    Dim defComp As String, matchMode As String
    defComp = JsonGetStr(args, "name")
    matchMode = JsonGetStr(args, "match")
    Dim opsColl As Object, compColl As Object, badIdx As Long, why As String
    If Not BatchCollectOps(args, defComp, opsColl, compColl, badIdx, why) Then
        If why = "edits_required" Then
            ToolPreviewEdit = ToolPreviewEditSingle(defComp, JsonGetAny(args, "edits"), matchMode)
            Exit Function
        End If
        Dim cr As Object
        Set cr = BatchBaseObj("preview_edit")
        cr("reason") = why
        cr("opIndex") = badIdx
        cr("note") = "nothing was resolved or rendered; preview_edit never writes"
        ToolPreviewEdit = JsonStringify(cr)
        Exit Function
    End If
    Dim order As Object, keyMap As Object, nComp As Long, nOps As Long
    nOps = opsColl.Count
    nComp = BatchOrder(compColl, order, keyMap)
    If nComp = 1 And BatchAllNamed(compColl, defComp) Then
        ToolPreviewEdit = ToolPreviewEditSingle(defComp, JsonGetAny(args, "edits"), matchMode)
        Exit Function
    End If
    Dim maxOps As Long
    maxOps = JsonGetLong(args, "max_ops", 200)
    If maxOps <= 0 Then maxOps = 200
    If maxOps > 1000 Then maxOps = 1000
    If nOps > maxOps Or nComp > 40 Then
        ToolPreviewEdit = BatchLimitRefusalJson("preview_edit", nOps, nComp, maxOps)
        Exit Function
    End If
    Dim compsOut As Object
    Set compsOut = New Collection
    Dim totalHunks As Long
    totalHunks = 0
    Dim i As Long, c As String
    For i = 1 To nComp
        c = CStr(order(i))
        Dim idxColl As Object, subE As Object
        Set subE = BatchSubEdits(opsColl, compColl, c, idxColl)
        Dim curT As String, newT As String
        curT = CompText(c)
        newT = curT
        Dim okAll As Boolean, failPV As Object, failPerr As String
        okAll = True
        Set failPV = Nothing
        failPerr = ""
        Dim e As Long
        For e = 1 To subE.Count
            Dim oneE As Object
            Set oneE = New Collection
            oneE.Add subE(e)
            Dim res As String, perr As String
            res = ""
            perr = ""
            On Error Resume Next
            res = ToolApplyEditsSingle(c, oneE, "", matchMode, "off", False, True, True, newT)
            If Err.Number <> 0 Then
                perr = Err.Description
                Err.Clear
            End If
            On Error GoTo 0
            Dim pv As Object
            Set pv = Nothing
            If Len(perr) = 0 Then Call JsonToDict(res, pv)
            Dim opOk As Boolean
            opOk = False
            If Len(perr) = 0 And Not pv Is Nothing Then
                If pv.Exists("ok") Then
                    If CBool(pv("ok")) Then opOk = True
                End If
            End If
            If Not opOk Then
                okAll = False
                Set failPV = pv
                failPerr = perr
                Exit For
            End If
            newT = CStr(pv("previewNewText"))
        Next
        If Not okAll Then
            Dim f As Object
            Set f = BatchBaseObj("preview_edit")
            f("reason") = "preview_component_failed"
            f("component") = c
            If Len(failPerr) > 0 Then f("message") = failPerr
            If Not failPV Is Nothing Then
                Call BatchMergeInto(f, failPV)
                f("failedOpIndex") = CLng(idxColl(e))
            Else
                f("failedOpIndex") = CLng(idxColl(1))
            End If
            Set f("components") = compsOut
            f("note") = "preview_edit writes nothing; the per-op dry run failed at the reported global index"
            ToolPreviewEdit = JsonStringify(f)
            Exit Function
        End If
        Dim d As Object, pl As Object
        Set d = CreateObject("Scripting.Dictionary")
        d("component") = c
        d("ops") = subE.Count
        d("sha256Before") = UCase$(Sha256.Sha256HexTextUtf8(curT))
        d("sha256After") = UCase$(Sha256.Sha256HexTextUtf8(newT))
        Set pl = EditTxn.DiffPlan(curT, newT, 3, PreviewDiffMaxLines())
        d("diff") = pl("diff")
        Set d("hunks") = pl("hunks")
        d("algorithm") = pl("algorithm")
        d("contextLines") = 3
        d("lineDelta") = LineCount(newT) - LineCount(curT)
        If d.Exists("hunks") Then
            On Error Resume Next
            totalHunks = totalHunks + d("hunks").Count
            Err.Clear
            On Error GoTo 0
        End If
        compsOut.Add d
    Next
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("ok") = True
    root("tool") = "preview_edit"
    root("multiComponent") = True
    root("readOnly") = True
    root("writes") = False
    root("appliedOps") = 0
    root("totalOps") = nOps
    Set root("components") = compsOut
    root("totalHunks") = totalHunks
    root("batchElapsedMs") = GetTickCount() - t0
    root("editOrderSemantics") = "ops apply in edits[] order; inside a component every anchor is resolved against that component UPDATED text. Components are independent."
    Dim lim As Object
    Set lim = CreateObject("Scripting.Dictionary")
    lim("ops") = nOps
    lim("components") = nComp
    lim("max_ops") = maxOps
    lim("max_components") = 40
    Set root("limits") = lim
    root("note") = "preview only: nothing was written; hunks are grouped per component"
    ToolPreviewEdit = JsonStringify(root)
End Function
Private Function ToolApplyEditsSingle(ByVal name As String, ByVal edits As Object, ByVal expectedSha As String, _
                                ByVal matchMode As String, ByVal validateMode As String, ByVal snapshotOn As Boolean, _
                                Optional ByVal snapTaken As Boolean = False, Optional ByVal dryRun As Boolean = False, Optional ByVal dryRunStart As String = "") As String
    Dim cur As String, nx As String, em As String, ops() As String
    Dim engTagA As String
    ' segment timing (same shape as replace_code).
    Dim tEntry As Long, tRead As Long, tPredict As Long, tLint As Long, tWrite As Long
    tEntry = GetTickCount()
    cur = CompText(name)
    If dryRun And Len(Trim$(dryRunStart)) > 0 Then cur = dryRunStart
    GuardSha cur, expectedSha
    tRead = GetTickCount()
    ' same up-front refusal as preview_edit (before ANY resolve or write).
    Dim tooBigA As String
    tooBigA = AnchorBatchTooLarge("apply_edits", name, CollectionCount(edits), LineCount(cur))
    If Len(tooBigA) > 0 Then
        ToolApplyEditsSingle = tooBigA
        Exit Function
    End If
    ops = McpBuildTools.BuildOps(Me, edits)
    ' (the structural-gate review/the wording review): the same PRE-WRITE pairing gate, op by op.
    Dim pj As Long, pp() As String, ptxt As String, pr As String
    For pj = LBound(ops) To UBound(ops)
        pp = Split(ops(pj), vbTab, 3)
        ptxt = ""
        If UBound(pp) >= 2 Then ptxt = OpUnesc(pp(2))
        If Len(ptxt) > 0 Then
            pr = PreWritePairingRefusal("apply_edits", name, ptxt, "op " & CStr(pj))
            If Len(pr) > 0 Then
                ToolApplyEditsSingle = pr
                Exit Function
            End If
        End If
    Next pj
    ' gamma-5/6/7: resolve EVERY op (occurrence + match) to a concrete line BEFORE
    ' anything is written, and keep the beta-2 continuation refusal on the resolved
    ' line. Then the whole batch is applied once through the line-addressed engine, so
    ' apply_edits stays all-or-nothing.
    Dim n As Long, i As Long, parts() As String
    n = UBound(ops) - LBound(ops) + 1
    Dim lineOps() As String
    Dim firstHit As Long
    ' a Collection, because a MULTI-LINE anchor removes a BLOCK:
    ' the extra matched lines need their own D ops, so the op count is no longer n.
    Dim colOps As Object
    Set colOps = New Collection
    Dim matches As Object
    Set matches = New Collection
    Dim curLines() As String
    curLines = McpCls.TextLines(Me, cur)
    ' ONE index for the WHOLE batch. ResolveAnchor used to do three whole-text
    ' passes per op (VbAnchor.FindHitsEx + HitList's TextLines + matchedText's TextLines)
    ' plus one CodeModule.ProcOfLine COM call per hit, i.e. O(s x N) for s ops. The index
    ' answers a unique anchor in O(1); the HitList of a rejected op is built in the failure
    ' branch only. The exact-match index is built lazily and only if some op asks for it.
    Dim iRaw() As String, iNorm() As String
    Dim iFirst As Object, iCnts As Object, iRawFirst As Object, iRawCnts As Object
    If Len(cur) > 0 Then VbAnchor.BuildNormIndex cur, iRaw, iNorm, iFirst, iCnts
    Dim procMemo As Object
    Set procMemo = CreateObject("Scripting.Dictionary")
    Dim hitsA() As Long
    For i = 0 To n - 1
        MaybePump
        parts = Split(ops(i), vbTab)
        Dim op As String, anc As String, txt As String
        op = parts(0)
        ' undo the TAB escape (OpEsc in BuildOps). Without this a TAB in
        ' the text shifted the fields and the occurrence conversion below raised the
        ' undiagnosable "类型不匹配".
        anc = OpUnesc(parts(1))
        txt = ""
        If UBound(parts) >= 2 Then txt = OpUnesc(parts(2))
        Dim occ As Long, mch As String
        occ = 0
        mch = matchMode
        If UBound(parts) >= 3 Then occ = CLng("0" & parts(3))
        If UBound(parts) >= 4 Then
            If Len(Trim$(parts(4))) > 0 Then mch = OpUnesc(parts(4))
        End If
        Dim hitLine As Long, matched As String, rsn As String, cnt As Long
        Dim spanLinesA As Long
        If Not ResolveAnchor(name, cur, anc, mch, Nothing, occ, (occ <= 0), hitLine, matched, rsn, hitsA, cnt, spanLinesA, iRaw, iNorm, iFirst, iCnts, iRawFirst, iRawCnts) Then
            Dim bd As Object
            Set bd = CreateObject("Scripting.Dictionary")
            bd("ok") = False
            bd("reason") = rsn
            bd("component") = name
            bd("failedOpIndex") = i
            bd("anchor") = anc
            bd("occurrence") = occ
            bd("hitCount") = cnt
            Set bd("hits") = HitList(name, cur, hitsA, cnt, procMemo)
            ' ruling 4: the failing op maps to a line, so carry coords + the space
            Set bd("coords") = CoordsDictOfName(name, 1, "ide")
            bd("lineSpace") = "ide"
            bd("lineSpaceHint") = "hits[].line are IDE code-pane lines; get_component_code's numbered output is DISK lines (ideLine = diskLine - coords.headerOffset)"
            bd("note") = "the batch was NOT applied (apply_edits is all-or-nothing)"
            ToolApplyEditsSingle = JsonStringify(bd)
            Exit Function
        End If
        ' v1.11.12: op "D" deletes the whole matched block and never carries text. The old
        ' code DROPPED a caller's text without a word, so "delete this block and put that
        ' in its place" looked like it had worked. The three states are now fixed: text
        ' ABSENT and text "" both mean delete (both decode to an empty payload), and a
        ' NON-EMPTY text is refused as delete_with_text instead of being ignored.
        If op = "D" And Len(txt) > 0 Then
            ToolApplyEditsSingle = GuardReject(name, "apply_edits", "delete_with_text", _
                "op " & CStr(i) & " is D (delete) but carries " & CStr(Len(txt)) & " character(s) of text; a D op deletes the WHOLE matched block and its text must be absent or empty. Use op ""R"" with the replacement text to replace a block, or drop the text.", _
                hitLine, hitLine + spanLinesA - 1, LineCount(cur))
            Exit Function
        End If
        If op = "R" Or op = "D" Then
            If IsContinuationTail(curLines, hitLine) Then
                ToolApplyEditsSingle = GuardReject(name, "apply_edits", "inside_continuation", _
                    "op " & CStr(i) & " (" & op & ") targets line " & CStr(hitLine) & ", which is the tail of a logical line: line " & CStr(hitLine - 1) & " ends with a VB continuation _. Widen the range or anchor the first line of the statement.", _
                    hitLine, hitLine, LineCount(cur))
                Exit Function
            End If
        ElseIf op = "I" Then
            If IsContinuationTail(curLines, hitLine) Then
                ToolApplyEditsSingle = GuardReject(name, "apply_edits", "inside_continuation", _
                    "op " & CStr(i) & " (I) inserts after line " & CStr(hitLine) & ", which ends with a VB continuation _, so the insertion would split that logical line.", _
                    hitLine, hitLine, LineCount(cur))
                Exit Function
            End If
        End If
        If firstHit = 0 Then firstHit = hitLine
        colOps.Add op & vbTab & CStr(hitLine) & vbTab & txt
        ' the rest of a multi-line anchor match is REMOVED. Since v1.11.12 this holds for
        ' op "D" as well: a D op on a MULTI-LINE anchor deletes the WHOLE matched block
        ' (one line-addressed D per matched line), which is what the block semantics say.
        If (op = "R" Or op = "D") And spanLinesA > 1 Then
            Dim dq As Long
            For dq = 1 To spanLinesA - 1
                colOps.Add "D" & vbTab & CStr(hitLine + dq)
            Next dq
        End If
        Dim md As Object
        Set md = CreateObject("Scripting.Dictionary")
        md("opIndex") = i
        md("line") = hitLine
        md("text") = matched
        matches.Add md
    Next
    ' materialise the (possibly longer) op list once.
    Dim cN As Long, cI As Long
    cN = colOps.Count
    If cN < 1 Then cN = 1
    ReDim lineOps(0 To cN - 1)
    For cI = 0 To cN - 1
        lineOps(cI) = CStr(colOps(cI + 1))
    Next cI
    nx = EditTxn.ApplyLineOps(cur, lineOps, em)
    tPredict = GetTickCount()
    ' ApplyLineOps receives RESOLVED line ops, so its only caller-input errMsg is
    ' "unknown op X" (the anchor-shaped failures never get here: apply_edits resolves every op
    ' through ResolveAnchor first and answers those structurally already). Everything else is an
    ' engine invariant and keeps this bare raise.
    If Len(em) > 0 Then
        engTagA = EngineRefusalTag(em, ops, cur, matchMode)
        If Len(engTagA) > 0 Then Err.Raise vbObjectError + 84, "CodeTools", engTagA
        Err.Raise vbObjectError + 84, "CodeTools", em
    End If
    ' v1.11.12: deleting the LAST line(s) of a component is a structured refusal. An empty
    ' code pane is not a usable editing outcome (the caller cannot restore it with a second
    ' anchor edit), so refuse it instead of writing an empty module.
    If Len(Trim$(nx)) = 0 Then
        ToolApplyEditsSingle = GuardReject(name, "apply_edits", "would_empty_component", _
            "the batch would remove every line of component '" & name & "' (it has " & CStr(LineCount(cur)) & " line(s) now). Deleting the last line of a component is refused; keep at least one line, or remove the component with remove_component.", _
            1, LineCount(cur), LineCount(cur))
        Exit Function
    End If
    ' (the structural-gate review reverse direction): the same result-level judgement for the batch.
    Dim ppRefB As String
    ppRefB = PredictedPairingRefusal("apply_edits", name, cur, nx, CStr(n) & " op(s)")
    If Len(ppRefB) > 0 Then
        ToolApplyEditsSingle = ppRefB
        Exit Function
    End If
    ' contract v1.16.0 (the batch-editing card): DRY RUN for the multi-component preview. Same resolve +
    ' same line-op engine, but NOTHING is linted, snapshotted or written: the caller gets the
    ' would-be final pane text and builds the hunks itself. Default false keeps the legacy path
    ' byte-for-byte.
    If dryRun Then
        Dim dr As Object
        Set dr = CreateObject("Scripting.Dictionary")
        dr("ok") = True
        dr("dryRun") = True
        dr("component") = name
        dr("sha256Before") = Sha256.Sha256HexTextUtf8(cur)
        dr("sha256After") = Sha256.Sha256HexTextUtf8(nx)
        dr("previewOldText") = cur
        dr("previewNewText") = nx
        ToolApplyEditsSingle = JsonStringify(dr)
        Exit Function
    End If
    ' ---- beta-3 + gamma-4
    Dim pack As Object
    ' region target = the first edited line of the batch.
    Set pack = LintPackForEdit(nx, KindOfName(name), LineCount(cur), firstHit)
    tLint = GetTickCount()
    Dim asref As String
    asref = StrictRefusal(name, "apply_edits", pack, validateMode)
    If Len(asref) > 0 Then
        ToolApplyEditsSingle = asref
        Exit Function
    End If
    ' opt-in snapshot. Same shape as edit_by_anchor: explicit call here, the
    ' funnel is told to skip, so snapshot=true still writes exactly ONE file.
    If snapshotOn And Not snapTaken Then UndoSnapshot name, cur
    Dim wCalls As Long
    wCalls = SetCompTextMinimal(name, cur, nx, (snapshotOn Or snapTaken))
    tWrite = GetTickCount()
    Dim extra As Object
    Set extra = CreateObject("Scripting.Dictionary")
    extra("writeCalls") = wCalls
        extra("hunks") = m_lastWriteHunks
    extra("readMs") = tRead - tEntry
    extra("predictMs") = tPredict - tRead
    extra("lintMs") = tLint - tPredict
    extra("writeMs") = tWrite - tLint
    AddWritePhases extra
    ' v1.11.12: the receipt states exactly how many lines the batch REMOVED and shows the
    ' removed text (capped). Before this a delete op left no machine-readable trace of what
    ' it removed. The count comes from the SAME line-level LCS preview_edit renders, so the
    ' two tools cannot disagree.
    Dim delInfo As Object
    Set delInfo = DeletedLinesInfo(cur, nx)
    extra("deletedLines") = delInfo("deletedLines")
    extra("deletedText") = delInfo("deletedText")
    extra("deletedTextLines") = delInfo("deletedTextLines")
    extra("deletedTextTruncated") = delInfo("deletedTextTruncated")
    extra("deletedTextLimit") = delInfo("deletedTextLimit")
    extra("deleteTextPolicy") = "op D accepts an ABSENT text and an EMPTY text (both decode to an empty payload and delete the matched block); a NON-EMPTY text is refused with reason=delete_with_text. Use op R to replace a block."
    ' report every per-op key this tool cannot honour (it reads
    ' op/anchor/text plus match/occurrence) instead of ignoring it without a word.
    OpKeyAuditInto extra, edits, "|op|anchor|text|match|occurrence|", NoteApplyEditsOpKeys()
    Dim rq As Object
    Set rq = CreateObject("Scripting.Dictionary")
    rq("mode") = "anchor-batch"
    rq("ops") = CollectionCount(edits)
    rq("match") = IIf(Len(Trim$(matchMode)) = 0, "normalized", matchMode)
    Set extra("requestedRange") = rq
    Set extra("appliedRange") = ChangedRegion(cur, nx)
    extra("clamped") = False
    ' the affected procedure's first/last pane line before and after.
    Set extra("procBefore") = ProcEchoDict(cur, firstHit)
    Set extra("procAfter") = ProcEchoDict(nx, firstHit)
    Set extra("matchedLines") = matches
    If matches.Count > 0 Then
        extra("matchedLine") = matches(1)("line")
        extra("matchedText") = matches(1)("text")
    End If
    ToolApplyEditsSingle = ChangeResult2(name, cur, nx, pack, extra, tEntry)
End Function

' beta-2 for the anchor batch: every op must land outside a VB
' continuation. Returns True plus the failing 0-based op index and an explanation.
Private Function ContinuationProblemOps(ByVal text As String, ByRef ops() As String, ByRef badOp As Long, ByRef detail As String) As Boolean
    Dim lines() As String
    lines = McpCls.TextLines(Me, text)
    Dim i As Long
    For i = LBound(ops) To UBound(ops)
        MaybePump
        Dim parts() As String
        parts = Split(ops(i), vbTab)
        If UBound(parts) >= 1 Then
            Dim o As String, anchor As String
            o = parts(0)
            anchor = OpUnesc(parts(1))
            Dim hits() As Long, cnt As Long
            VbAnchor.FindHits text, anchor, hits, cnt
            If cnt >= 1 Then
                Dim ln As Long
                ln = hits(0)
                If o = "R" Or o = "D" Then
                    If IsContinuationTail(lines, ln) Then
                        badOp = i
                        detail = "op " & CStr(i) & " (" & o & ") targets line " & CStr(ln) & ", the tail of a logical line (line " & CStr(ln - 1) & " ends with a VB continuation _)"
                        ContinuationProblemOps = True
                        Exit Function
                    End If
                ElseIf o = "I" Then
                    If ln >= 1 And ln <= UBound(lines) + 1 Then
                        If EndsWithCont(lines(ln - 1)) Then
                            badOp = i
                            detail = "op " & CStr(i) & " (I) inserts after line " & CStr(ln) & ", which ends with a VB continuation _, so the insertion would split that logical line"
                            ContinuationProblemOps = True
                            Exit Function
                        End If
                    End If
                End If
            End If
        End If
    Next
    ContinuationProblemOps = False
End Function

Private Function EndsWithCont(ByVal line As String) As Boolean
    Dim t As String
    t = RTrim$(Vb6Lint.StripCode(line))
    If Len(t) < 2 Then Exit Function
    If Right$(t, 1) <> "_" Then Exit Function
    Dim pc As String
    pc = Mid$(t, Len(t) - 1, 1)
    If pc = " " Or pc = vbTab Then EndsWithCont = True
End Function

' ---------------------------------------------------------------------------
' preview_edit / apply_edits answered a NON-RESOLVING ANCHOR with a bare
' Err.Raise vbObjectError + 84. CallToolInner can only wrap that as
' {ok:false, reason:"unexpected_error", vbErrorCode:-2147221420} - a value the caller cannot
' branch on, although "the anchor I passed is not in the pane" is ordinary CALLER INPUT.
'
' EditTxn.bas contains NO Err.Raise at all: ApplyEdits / ApplyLineOps report every failure as a
' plain errMsg string. This function is the ONE place that decides which errMsg values are
' caller input (-> a structured refusal through the MCPREASON channel) and which are engine
' invariants (-> the historical bare raise, byte for byte).
'
'   caller input : "op N failed: anchor not found"      -> anchor_not_found
'                  "op N failed: anchor not unique (C)" -> anchor_not_unique
'                  "unknown op X"                       -> unknown_op
'   invariants   : "bad op at N", "line N out of range (1..M)", "sha mismatch"
' (section 3: none of the three can be produced by a record BuildOps
'                   emits, by a RESOLVED line set, or by preview_edit, which passes
'                   expected_sha256 = ""; they stay a bare raise on purpose and are documented)
'
' The tag carries NUMBERS ONLY (reason|opIndex|hitCount|containsHits|firstContainsLine|paneLines|
' anchorHasCrLf): an anchor can contain a "|", so it never travels through the "|"-separated
' channel - McpReasonJson reads it back out of the caller's OWN args instead.
'
' Every diagnostic runs INSIDE the failure branch only (never on the success path). Array
' subscripts are always bounds-checked on their own line first: VB6 And/Or do not short-circuit
', so "check the bound" and "take the element" must never share one expression.
Private Function EngineRefusalTag(ByVal em As String, ByRef ops() As String, ByVal cur As String, Optional ByVal defMatch As String = "") As String
    EngineRefusalTag = ""
    Dim reason As String
    Dim idx As Long
    idx = -1
    If EngineOpFailure(em, "anchor not found", idx) Then
        reason = "anchor_not_found"
    ElseIf EngineOpFailure(em, "anchor not unique", idx) Then
        reason = "anchor_not_unique"
    ElseIf Left$(em, 11) = "unknown op " Then
        reason = "unknown_op"
        idx = EngineOpIndex(ops, Mid$(em, 12))
    Else
        Exit Function
    End If
    ' ---- diagnostics for the ONE failing op ----
    Dim anc As String
    Dim recLine As String
    recLine = EngineOpRecord(ops, idx)
    Dim parts() As String
    ' the failing op's OWN per-op match wins over the tool's default, so the hit
    ' count reported below is the count the resolver REALLY used. Diagnosing a per-op
    ' match="exact" op with the NORMALIZED count (and then claiming a case difference cannot
    ' be the cause) would declare an un-triggerable cause - discipline 39.
    Dim effMch As String
    effMch = defMatch
    If Len(recLine) > 0 Then
        parts = Split(recLine, vbTab)
        If McpCls.LineUbound(Me, parts) >= 1 Then anc = OpUnesc(parts(1))
        If McpCls.LineUbound(Me, parts) >= 4 Then
            If Len(Trim$(parts(4))) > 0 Then effMch = OpUnesc(parts(4))
        End If
    End If
    Dim hits() As Long, hitN As Long
    VbAnchor.FindHitsEx cur, anc, effMch, 0, 0, hits, hitN
    Dim lines() As String
    lines = McpCls.TextLines(Me, cur)
    Dim paneN As Long
    paneN = McpCls.LineUbound(Me, lines) + 1
    If paneN < 0 Then paneN = 0
    Dim containsN As Long, firstContains As Long, i As Long
    Dim na As String
    containsN = 0
    firstContains = 0
    ' the fragment scan uses the SAME comparator as the hit scan, so under
    ' match="exact" it stays a RAW binary compare and cannot report a case-differing line as
    ' a "fragment" under a normalization that was not applied.
    If LCase$(Trim$(effMch)) = "exact" Then
        For i = 0 To McpCls.LineUbound(Me, lines)
            MaybePump
            If InStr(1, lines(i), anc, vbBinaryCompare) > 0 Then
                containsN = containsN + 1
                If firstContains = 0 Then firstContains = i + 1
            End If
        Next
    Else
        na = VbAnchor.NormLine(anc)
        If Len(na) > 0 Then
            For i = 0 To McpCls.LineUbound(Me, lines)
                MaybePump
                If InStr(1, VbAnchor.NormLine(lines(i)), na, vbBinaryCompare) > 0 Then
                    containsN = containsN + 1
                    If firstContains = 0 Then firstContains = i + 1
                End If
            Next
        End If
    End If
    Dim hasCrLf As Long
    hasCrLf = 0
    If InStr(anc, vbCr) > 0 Then hasCrLf = 1
    If InStr(anc, vbLf) > 0 Then hasCrLf = 1
    EngineRefusalTag = "MCPREASON:" & reason & "|" & CStr(idx) & "|" & CStr(hitN) & "|" _
        & CStr(containsN) & "|" & CStr(firstContains) & "|" & CStr(paneN) & "|" & CStr(hasCrLf)
End Function

' "op <digits> failed: <tail>" -> the 0-based op index. Hand-parsed (no regex object): the digits
' are validated one character at a time, and the index is only accepted when Err stayed clear.
Private Function EngineOpFailure(ByVal em As String, ByVal tail As String, ByRef idx As Long) As Boolean
    EngineOpFailure = False
    idx = -1
    If Len(em) < 8 Then Exit Function
    If Left$(em, 3) <> "op " Then Exit Function
    Dim p As Long
    p = InStr(4, em, " failed: ")
    If p = 0 Then Exit Function
    Dim s As String, k As Long, ch As String
    s = Mid$(em, 4, p - 4)
    If Len(s) = 0 Then Exit Function
    For k = 1 To Len(s)
        ch = Mid$(s, k, 1)
        If ch < "0" Or ch > "9" Then Exit Function
    Next
    Dim rest As String
    rest = Mid$(em, p + 9)
    If InStr(1, rest, tail, vbBinaryCompare) <> 1 Then Exit Function
    On Error Resume Next
    idx = CLng(s)
    If Err.Number <> 0 Then
        Err.Clear
        idx = -1
        Exit Function
    End If
    On Error GoTo 0
    EngineOpFailure = True
End Function

' the 0-based index of the first op record whose op field equals opStr, or -1.
Private Function EngineOpIndex(ByRef ops() As String, ByVal opStr As String) As Long
    EngineOpIndex = -1
    Dim i As Long, u As Long, parts() As String
    u = McpCls.LineUbound(Me, ops)
    For i = 0 To u
        If Len(Trim$(ops(i))) > 0 Then
            parts = Split(ops(i), vbTab)
            If McpCls.LineUbound(Me, parts) >= 0 Then
                If parts(0) = opStr Then
                    EngineOpIndex = i
                    Exit Function
                End If
            End If
        End If
    Next
End Function

' ops(idx) with the bound checked FIRST (never "idx <= UBound And ops(idx)").
Private Function EngineOpRecord(ByRef ops() As String, ByVal idx As Long) As String
    EngineOpRecord = ""
    If idx < 0 Then Exit Function
    If idx > McpCls.LineUbound(Me, ops) Then Exit Function
    EngineOpRecord = ops(idx)
End Function

' ---------------------------------------------------------------------------
' per-op keys the caller supplied but this tool does NOT honour.
'
' The DECLARED per-op shape of an anchor batch is exactly {op, anchor, text}
' (docs/tools_schema.json:1498 for apply_edits, :1540 for preview_edit; CONTRACTS.md's
' B+C table declares match/occurrence/scope on edit_by_anchor only). On top of that
' declared shape BOTH apply_edits and preview_edit HONOUR per-op match and occurrence
' (: preview_edit used to resolve through EditTxn.ApplyEdits, which read
' fields 0..2 only, so the two tools disagreed in BOTH directions), and NO tool reads a
' per-op scope (BuildOps never looks at that key at all).
'
' Silently ignoring a key the caller believes took effect changes WHERE an edit lands:
' the caller asks for "the 2nd hit" or "exact case" and quietly gets the default
' semantics. So every key outside the honoured set is REPORTED in the receipt instead.
' A call that stays inside the declared shape gets exactly the historical key set --
' nothing is added -- which is why the success path stays byte-for-byte identical.
'
' honoured is pipe-delimited with a leading and a trailing pipe ("|op|anchor|text|");
' the comparison is BINARY, matching the case sensitivity of Scripting.Dictionary and
' DictStr. Bounds are taken on their own statements first (VB6 And/Or do not
' short-circuit - discipline 34).
Private Function OpKeyAuditRows(ByVal edits As Object, ByVal honoured As String) As Object
    Dim rows As Object, it As Variant, d As Object, k As Variant
    Dim keys As Collection, rw As Object, klist() As String
    Dim idx As Long, j As Long
    Set rows = New Collection
    idx = 0
    For Each it In edits
        If IsObject(it) Then
            Set d = it
            Set keys = New Collection
            For Each k In d.Keys
                If InStr(1, honoured, "|" & CStr(k) & "|", vbBinaryCompare) = 0 Then keys.Add CStr(k)
            Next
            If keys.Count > 0 Then
                Set rw = CreateObject("Scripting.Dictionary")
                rw("opIndex") = idx
                ReDim klist(0 To keys.Count - 1)
                For j = 1 To keys.Count
                    klist(j - 1) = keys(j)
                Next
                rw("keys") = klist
                rows.Add rw
            End If
        End If
        idx = idx + 1
    Next
    Set OpKeyAuditRows = rows
End Function

' merge the audit into a receipt dictionary -- and ONLY when there is
' something to report. With an input inside the declared shape the receipt keeps its
' historical key set byte for byte.
Private Sub OpKeyAuditInto(ByVal root As Object, ByVal edits As Object, ByVal honoured As String, ByVal note As String)
    Dim rows As Object, it As Variant, total As Long, u As Long, l As Long
    Set rows = OpKeyAuditRows(edits, honoured)
    If rows.Count = 0 Then Exit Sub
    total = 0
    For Each it In rows
        l = LBound(it("keys"))
        u = UBound(it("keys"))
        total = total + u - l + 1
    Next
    Set root("ignoredOpKeys") = rows
    root("ignoredOpKeyCount") = total
    root("opKeysHonoured") = Split(Mid$(honoured, 2, Len(honoured) - 2), "|")
    root("ignoredOpKeysNote") = note
End Sub

Private Function NotePreviewOpKeys() As String
    NotePreviewOpKeys = "preview_edit honours the DECLARED per-op keys {op, anchor, text} plus a per-op match and occurrence - the " & _
        "SAME set apply_edits honours. Both tools resolve through one pipeline (one norm index, ResolveAnchor, the " & _
        "beta-2 continuation guard), so a preview taken here predicts the write those tools perform. A per-op scope is read by NO tool " & _
        "at all (BuildOps never looks at the key), so it had no effect: the anchor was resolved over the WHOLE module. For a " & _
        "range-limited edit use edit_by_anchor, which declares match/occurrence/scope."
End Function

Private Function NoteApplyEditsOpKeys() As String
    NoteApplyEditsOpKeys = "apply_edits honours the DECLARED per-op keys {op, anchor, text} plus a per-op match and occurrence; " & _
        "nothing else is read from an op. A per-op scope is read by NO tool, so it had no effect here: the anchor was resolved over " & _
        "the WHOLE module. For a range-limited edit use edit_by_anchor, which declares match/occurrence/scope."
End Function

Private Function ToolPreviewEditSingle(ByVal name As String, ByVal edits As Object, ByVal matchMode As String) As String
    Dim cur As String, nx As String, em As String, ops() As String, root As Object
    Dim engTag As String
    Dim ctxLines As Long
    ctxLines = 3
    cur = CompText(name)
    ' refuse an over-large batch BEFORE any work (structured, diagnosable).
    Dim tooBig As String
    tooBig = AnchorBatchTooLarge("preview_edit", name, CollectionCount(edits), LineCount(cur))
    If Len(tooBig) > 0 Then
        ToolPreviewEditSingle = tooBig
        Exit Function
    End If
    ' ---- preview_edit walks the SAME parse as apply_edits -----------------
    ' It used to call EditTxn.ApplyEdits, which reads only record fields 0..2 of every op and
    ' always requires a UNIQUE anchor. A per-op match / occurrence was therefore NOT applied,
    ' and there was no beta-2 continuation guard. Measured on the SAME input in ONE IDE session
    ' (内部证据): per-op match="exact" gave preview SUCCESS
    ' while the write answered anchor_not_found, and per-op occurrence=2 gave preview
    ' anchor_not_unique while the write SUCCEEDED - the two tools disagreed in BOTH directions,
    ' so a preview could not predict the write. This is now the same three steps as
    ' ToolApplyEdits: ONE norm index for the whole batch, ResolveAnchor with the per-op
    ' match/occurrence, the same continuation guard, then the same line-addressed engine.
    ops = McpBuildTools.BuildOps(Me, edits)
    Dim n As Long, i As Long, parts() As String
    n = UBound(ops) - LBound(ops) + 1
    ' a MULTI-LINE anchor replaces the WHOLE matched block - exactly the
    ' ops apply_edits writes. The preview used to emit only the R at the block's first line,
    ' so previewing a multi-line anchor disagreed with the write it is supposed to predict.
    Dim lineOps() As String
    Dim colPre As Object
    Set colPre = New Collection
    Dim curLines() As String
    curLines = McpCls.TextLines(Me, cur)
    Dim iRaw() As String, iNorm() As String
    Dim iFirst As Object, iCnts As Object, iRawFirst As Object, iRawCnts As Object
    If Len(cur) > 0 Then VbAnchor.BuildNormIndex cur, iRaw, iNorm, iFirst, iCnts
    Dim hitsA() As Long
    For i = 0 To n - 1
        MaybePump
        parts = Split(ops(i), vbTab)
        Dim op As String, anc As String, txt As String
        op = parts(0)
        anc = OpUnesc(parts(1))
        txt = ""
        If UBound(parts) >= 2 Then txt = OpUnesc(parts(2))
        Dim occ As Long, mch As String
        occ = 0
        mch = ""
        If UBound(parts) >= 3 Then occ = CLng("0" & parts(3))
        If UBound(parts) >= 4 Then
            If Len(Trim$(parts(4))) > 0 Then mch = OpUnesc(parts(4))
        End If
        Dim hitLine As Long, matched As String, rsn As String, cnt As Long
        Dim spanPre As Long
        If Not ResolveAnchor(name, cur, anc, mch, Nothing, occ, (occ <= 0), hitLine, matched, rsn, hitsA, cnt, spanPre, iRaw, iNorm, iFirst, iCnts, iRawFirst, iRawCnts) Then
            ' +: the refusal RECEIPT SHAPE must not move, so the
            ' failure travels as the very same "op N failed: anchor not found|not unique (C)"
            ' text EditTxn.ApplyEdits produced and EngineRefusalTag still owns the mapping.
            Dim etxt As String
            etxt = "op " & CStr(i) & " failed: " & rsn
            If rsn = "anchor_not_found" Then etxt = "op " & CStr(i) & " failed: anchor not found"
            If rsn = "anchor_not_unique" Then etxt = "op " & CStr(i) & " failed: anchor not unique (" & CStr(cnt) & ")"
            engTag = EngineRefusalTag(etxt, ops, cur, mch)
            If Len(engTag) > 0 Then Err.Raise vbObjectError + 84, "CodeTools", engTag
            Err.Raise vbObjectError + 84, "CodeTools", etxt
        End If
        ' v1.11.12: the SAME three-state D text rule the write applies, byte for byte, so a
        ' preview can never say OK for a batch the write refuses (and vice versa).
        If op = "D" And Len(txt) > 0 Then
            ToolPreviewEditSingle = GuardReject(name, "preview_edit", "delete_with_text", _
                "op " & CStr(i) & " is D (delete) but carries " & CStr(Len(txt)) & " character(s) of text; a D op deletes the WHOLE matched block and its text must be absent or empty. Use op ""R"" with the replacement text to replace a block, or drop the text.", _
                hitLine, hitLine + spanPre - 1, LineCount(cur))
            Exit Function
        End If
        ' beta-2 continuation refusal: byte for byte the rule ToolApplyEdits applies. The
        ' preview used to have NO guard here, so a range that splits a continued statement
        ' previewed as OK and was then REFUSED by the write.
        If op = "R" Or op = "D" Then
            If IsContinuationTail(curLines, hitLine) Then
                ToolPreviewEditSingle = GuardReject(name, "preview_edit", "inside_continuation", _
                    "op " & CStr(i) & " (" & op & ") targets line " & CStr(hitLine) & ", which is the tail of a logical line: line " & CStr(hitLine - 1) & " ends with a VB continuation _. Widen the range or anchor the first line of the statement.", _
                    hitLine, hitLine, LineCount(cur))
                Exit Function
            End If
        ElseIf op = "I" Then
            If IsContinuationTail(curLines, hitLine) Then
                ToolPreviewEditSingle = GuardReject(name, "preview_edit", "inside_continuation", _
                    "op " & CStr(i) & " (I) inserts after line " & CStr(hitLine) & ", which ends with a VB continuation _, so the insertion would split that logical line.", _
                    hitLine, hitLine, LineCount(cur))
                Exit Function
            End If
        End If
        colPre.Add op & vbTab & CStr(hitLine) & vbTab & txt
        ' the rest of a multi-line anchor match is REMOVED, exactly as ToolApplyEdits does
        ' (now including op "D", whose multi-line anchor deletes the WHOLE block), so the
        ' preview predicts the write byte for byte.
        If (op = "R" Or op = "D") And spanPre > 1 Then
            Dim dqPre As Long
            For dqPre = 1 To spanPre - 1
                colPre.Add "D" & vbTab & CStr(hitLine + dqPre)
            Next dqPre
        End If
    Next
    ' materialise the (possibly longer) op list once.
    Dim cNPre As Long, cIPre As Long
    cNPre = colPre.Count
    If cNPre < 1 Then cNPre = 1
    ReDim lineOps(0 To cNPre - 1)
    For cIPre = 0 To cNPre - 1
        lineOps(cIPre) = CStr(colPre(cIPre + 1))
    Next cIPre
    nx = EditTxn.ApplyLineOps(cur, lineOps, em)
    ' a non-resolving anchor is CALLER INPUT and is answered above (structured).
    ' ApplyLineOps receives RESOLVED line ops here, so its only caller-input errMsg is
    ' "unknown op X"; everything else is an engine invariant and keeps the bare raise.
    If Len(em) > 0 Then
        engTag = EngineRefusalTag(em, ops, cur, "")
        If Len(engTag) > 0 Then Err.Raise vbObjectError + 84, "CodeTools", engTag
        Err.Raise vbObjectError + 84, "CodeTools", em
    End If
    ' v1.11.12: the SAME would-empty refusal the write answers, so preview cannot promise
    ' a deletion the write refuses.
    If Len(Trim$(nx)) = 0 Then
        ToolPreviewEditSingle = GuardReject(name, "preview_edit", "would_empty_component", _
            "the batch would remove every line of component '" & name & "' (it has " & CStr(LineCount(cur)) & " line(s) now). Deleting the last line of a component is refused; keep at least one line, or remove the component with remove_component.", _
            1, LineCount(cur), LineCount(cur))
        Exit Function
    End If
    ' the preview must predict the SAME structural refusal the write
    ' gives - otherwise "preview OK, write refused" comes back one tool later.
    Dim ppRefP As String
    ppRefP = PredictedPairingRefusal("preview_edit", name, cur, nx, CStr(n) & " op(s)")
    If Len(ppRefP) > 0 Then
        ToolPreviewEditSingle = ppRefP
        Exit Function
    End If
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = name
    ' (contract invariant 8): diff and hunks both come from the SAME
    ' line-level LCS plan, so they can never disagree.
    Dim pl As Object
    ' cap the diff TEXT (hunks are never capped - they are the complete
    ' machine-readable description of every change). The cap is applied WHILE the diff is
    ' built, so a megabyte the caller cannot use is never materialised. With the default
    ' cap an uncapped-size diff gets the extra diffTruncated/diffLinesShown/diffLinesTotal/
    ' diffLimitLines/diffNote keys; when nothing is cut the receipt keeps its historical
    ' key set byte for byte.
    Set pl = EditTxn.DiffPlan(cur, nx, ctxLines, PreviewDiffMaxLines())
    root("diff") = pl("diff")
    Set root("hunks") = pl("hunks")
    root("contextLines") = ctxLines
    root("contextApplied") = True
    root("algorithm") = pl("algorithm")
    If pl.Exists("note") Then root("algorithmNote") = pl("note")
    If pl.Exists("diffTruncated") Then
        root("diffTruncated") = True
        root("diffLinesShown") = pl("diffLinesShown")
        root("diffLinesTotal") = pl("diffLinesTotal")
        root("diffLimitLines") = pl("diffLimitLines")
        root("diffNote") = "the diff TEXT is capped: it shows the first " & CStr(pl("diffLinesShown")) & " of " & CStr(pl("diffLinesTotal")) & " diff lines. Every change is still fully described by hunks[] (kind/start/count/oldStart/oldCount/newStart/newCount), so nothing about WHAT would change is hidden - only lines of the rendered text are omitted. Raise VB6MCP_PREVIEW_DIFF_MAX_LINES (0 = unlimited) to get the whole text."
    End If
    root("lineDelta") = LineCount(nx) - LineCount(cur)
    Set root("coords") = CoordsDictOfName(name, 1, "ide")
    ' +: report every per-op key this tool cannot honour. Since
    ' preview_edit resolves through the SAME pipeline as apply_edits and therefore
    ' honours op/anchor/text plus a per-op match and occurrence; only a per-op scope is left.
    OpKeyAuditInto root, edits, "|op|anchor|text|match|occurrence|", NotePreviewOpKeys()
    ' this tool has no top-level `match` argument at all (its declared
    ' inputSchema is {name, edits}), so a top-level match used to be dropped silently
    ' while the SIBLING apply_edits honours it -- preview and write could then disagree.
    If Len(Trim$(matchMode)) > 0 Then
        root("ignoredArgs") = Array("match")
        root("ignoredArgsNote") = "preview_edit has no top-level `match` parameter; the argument you passed was IGNORED, so this " & _
            "preview describes the DEFAULT (normalized) matching for every op that does not carry its own per-op match - a per-op " & _
            "match/occurrence IS honoured. apply_edits and edit_by_anchor DO honour the top-level match, so a preview " & _
            "taken here with match=" & Trim$(matchMode) & " can still disagree with the write those tools perform."
    End If
    ToolPreviewEditSingle = JsonStringify(root)
End Function

' how many lines of the rendered diff preview_edit returns. Measured before
' this cap existed: a 49,921-line diff (27k fixture, s=500 spread) produced a 1,277,502 B
' response, and the procedure fixture produced a 1.20 MB diff even at s=50. 2,000 lines is
' the default; 0 disables the cap. Configurable via VB6MCP_PREVIEW_DIFF_MAX_LINES (same
' style as VB6MCP_LINT_MAX_DIAG / VB6MCP_ANCHOR_MAX_WORK).
Private Function PreviewDiffMaxLines() As Long
    Dim s As String, v As Long
    Const DEF As Long = 2000
    v = DEF
    s = Trim$(Environ$("VB6MCP_PREVIEW_DIFF_MAX_LINES"))
    If Len(s) > 0 Then
        On Error Resume Next
        v = CLng(s)
        If Err.Number <> 0 Then v = DEF
        On Error GoTo 0
    End If
    If v < 0 Then v = 0
    PreviewDiffMaxLines = v
End Function

' "the write did not become visible" - a STRUCTURED REFUSAL, never a success
' shape. Motivated by a measured silent no-op: write_source to a path whose parent directory
' did not exist returned bytesWritten + sha256 and wrote NOTHING (the Open inside
' Encoding.WriteAllBytesTo fails and is swallowed by design).
Private Function WriteNotVisibleRefusal(ByVal toolName As String, ByVal target As String, ByVal reason As String, ByVal expectedSha As String, ByVal actualSha As String, ByVal bytesIntended As Long, Optional ByVal missingParent As String = "") As String
    Dim r As Object
    Set r = CreateObject("Scripting.Dictionary")
    r("ok") = False
    r("tool") = toolName
    r("target") = target
    r("reason") = reason
    r("expectedSha256") = expectedSha
    r("actualSha256") = actualSha
    r("bytesIntended") = bytesIntended
    If reason = "parent_not_creatable" Then
        ' The PRIMARY reason name is parent_dir_missing (it names the condition the caller
        ' must react to). The historical name stays readable through reasonLegacy/reasonAliases
        ' so an existing consumer that branches on parent_not_creatable keeps working.
        r("reason") = "parent_dir_missing"
        r("reasonLegacy") = "parent_not_creatable"
        Dim al As Object
        Set al = New Collection
        al.Add "parent_not_creatable"
        Set r("reasonAliases") = al
        r("parentDirMissing") = True
        r("missingPath") = missingParent
        r("detail") = "the PARENT DIRECTORY of the target does not exist and could not be created - a file may sit on that path, or the path is not writable. Nothing was written; missingPath names the directory and target names the file."
    ElseIf reason = "write_not_visible" Then
        r("detail") = "the write did NOT become visible on disk: after the write returned there is no file at the target path. The success shape is deliberately NOT returned - do not treat this call as written. Check the parent directory, the path spelling and permissions."
    ElseIf reason = "write_failed" Then
        r("detail") = "the write itself failed (the target could not be opened for writing, or the write call raised). Nothing is reported as written."
    Else
        r("detail") = "the bytes on disk do not match the bytes that were to be written (expected sha256 " & expectedSha & ", found " & actualSha & "). This call is NOT reported as a successful write."
    End If
    r("verdictHint") = "a write tool may only answer 'written' when the bytes are readable back from the target path"
    WriteNotVisibleRefusal = JsonStringify(r)
End Function

Private Function ToolWriteSource(ByVal path As String, ByVal text As String, ByVal enc As String, ByVal validateMode As String) As String
    Dim full As String, b() As Byte, root As Object
    full = ResolvePath(path)
    ' R-1021-01: report whether this call CREATED the target (it did not exist).
    Dim wsExistedBefore As Boolean
    wsExistedBefore = (Len(Dir$(full)) > 0)
    If Len(enc) = 0 Then
        If IsVbFileExt(full) Then enc = "ansi" Else enc = "utf-8"
    End If
    ' beta-3: lint a VB source file BEFORE it is written (warn-only).
    Dim pack As Object
    If IsVbFileExt(full) Then
        Set pack = LintPack(text, InferKind(full))
        ' gamma-4: refuse BEFORE the file is touched
        Dim wsref As String
        wsref = StrictRefusal(full, "write_source", pack, validateMode)
        If Len(wsref) > 0 Then
            ToolWriteSource = wsref
            Exit Function
        End If
    End If
    Encoding.EncodeText text, enc, b
    ' byte-level round-trip assertion on the WRITE side.  The bytes about to
    ' be written must decode back to EXACTLY the caller's text; a lossy encode is a
    ' structured refusal, never a silent substitution.
    Dim wsBack As String
    Encoding.DecodeBytes b, enc, wsBack
    If wsBack <> text Then
        ToolWriteSource = UnencodableRefusal("write_source", full, enc, text)
        Exit Function
    End If
    ' (1) create the parent directory - write_file has done this since its
    ' create_dirs default, and the same caller expectation applies here; (2) VERIFY the write
    ' on disk and refuse if it did not land. Measured before the fix: a missing parent
    ' returned bytesWritten=43 + a sha256 and wrote nothing at all.
    Dim wsParent As String, wsFso As Object
    Set wsFso = CreateObject("Scripting.FileSystemObject")
    wsParent = wsFso.GetParentFolderName(full)
    Dim wsWant As String, wsBackB() As Byte, wsGot As String
    If Encoding.ByteCount(b) > 0 Then
        wsWant = Sha256.Sha256HexBytes(b)
    Else
        wsWant = Sha256.Sha256HexTextUtf8("")
    End If
    ' an uncreatable parent must be a STRUCTURED refusal that NAMES the target.
    ' Measured before this hardening: reason=unexpected_error, vbErrorCode=58, and no target
    ' field at all (a FILE was sitting on the path).
    Dim wsCreated As Object
    Set wsCreated = New Collection
    On Error Resume Next
    EnsureDirTracked wsParent, wsCreated
    Err.Clear
    On Error GoTo 0
    If Len(wsParent) > 0 Then
        If Not wsFso.FolderExists(wsParent) Then
            ToolWriteSource = WriteNotVisibleRefusal("write_source", full, "parent_not_creatable", wsWant, "", Encoding.ByteCount(b), wsParent)
            Exit Function
        End If
    End If
    ' the checked primitive (write + read the bytes back) - the sha256 assertion
    ' three lines below is the second, independent read-back.
    WriteAllBytesChecked full, b
    If Len(Dir$(full)) = 0 Then
        ToolWriteSource = WriteNotVisibleRefusal("write_source", full, "write_not_visible", wsWant, "", Encoding.ByteCount(b))
        Exit Function
    End If
    Encoding.ReadAllBytesTo full, wsBackB
    If Encoding.ByteCount(wsBackB) > 0 Then
        wsGot = Sha256.Sha256HexBytes(wsBackB)
    Else
        wsGot = Sha256.Sha256HexTextUtf8("")
    End If
    If wsGot <> wsWant Then
        ToolWriteSource = WriteNotVisibleRefusal("write_source", full, "write_verify_failed", wsWant, wsGot, Encoding.ByteCount(b))
        Exit Function
    End If
    Set root = CreateObject("Scripting.Dictionary")
    root("file") = full
    root("encoding") = enc
    root("bytesWritten") = Encoding.ByteCount(b)
    root("size") = Encoding.ByteCount(b)
    root("exists") = True
    root("sha256") = wsWant
    root("verifiedOnDisk") = True
    ' R-1021-01 (write-proof contract): ok + bytes are published here as well, so
    ' write_file and write_source answer with the SAME field family.
    root("ok") = True
    root("bytes") = Encoding.ByteCount(b)
    root("sha256Source") = "readback"
    root("created") = Not wsExistedBefore
    Set root("createdDirs") = wsCreated
    root("createdDirsCount") = wsCreated.Count
    CopyLintPack root, pack
    ToolWriteSource = JsonStringify(root)
End Function

' TRUE when the pane and the FILE differ ONLY by hidden Attribute lines (which the file
' carries because VB6's SaveAs materialises them, and which no code pane shows).
' The comparison strips the designer head first (the pane never carries it) and drops
' every line whose first token is Attribute; attrCount receives how many were dropped.
Private Function AttributeOnlyDiff(ByVal paneText As String, ByVal diskPath As String, ByRef attrCount As Long) As Boolean
    AttributeOnlyDiff = False
    attrCount = 0
    If Len(diskPath) = 0 Then Exit Function
    Dim rawB() As Byte, enc As String, diskText As String, body As String
    On Error Resume Next
    Encoding.ReadAllBytesTo diskPath, rawB
    If Err.Number <> 0 Then
        Err.Clear
        Exit Function
    End If
    enc = Encoding.DetectEncoding(rawB)
    If Len(enc) = 0 Then enc = "ansi"
    Encoding.DecodeBytes rawB, enc, diskText
    Err.Clear
    On Error GoTo 0
    body = StrippedDiskText(diskText, "", False)
    ' Compare the MEANINGFUL lines only: blank lines are ignored on both sides (a hidden
    ' Attribute line that sat inside a procedure leaves no blank line in the pane, so a
    ' line-for-line comparison would report a difference that is not source), and every
    ' Attribute line is dropped. What remains must be IDENTICAL for the diff to be called
    ' attribute-only.
    Dim lines() As String, i As Long, kept As String, paneSquash As String
    lines = Split(Replace(Replace(body, vbCrLf, vbLf), vbCr, vbLf), vbLf)
    kept = ""
    For i = LBound(lines) To UBound(lines)
        If Left$(Trim$(lines(i)), 10) = "Attribute " Then
            attrCount = attrCount + 1
        ElseIf Len(Trim$(lines(i))) > 0 Then
            kept = kept & Trim$(lines(i)) & vbLf
        End If
    Next
    lines = Split(Replace(Replace(paneText, vbCrLf, vbLf), vbCr, vbLf), vbLf)
    paneSquash = ""
    For i = LBound(lines) To UBound(lines)
        If Len(Trim$(lines(i))) > 0 Then paneSquash = paneSquash & Trim$(lines(i)) & vbLf
    Next
    AttributeOnlyDiff = (kept = paneSquash)
End Function

' =====================================================================
' contract v1.16.0: requireCompiler for verify / verify_scope.
'
' WHY. lint is this project's OWN rule engine and a clean lint is NOT a compile pass.
' A caller that needs COMPILER authority can demand it. The evidence is produced the only
' way this add-in can produce it honestly: an ISOLATED VB6.EXE /make over a COPY of the
' project, so
'   * the project the IDE holds is never handed to /make (that route exits 0 and writes
'     no log), and
'   * the REAL artifact and the real project directory are never touched.
' The copy reflects the files ON DISK; unsaved pane edits are not in it and the receipt
' says so (compiler.compiledFrom = "disk_copy").
'
' FAIL-CLOSED. When the compiler cannot be resolved, cannot be started, produces no log,
' or is killed at the budget, the call is REFUSED with ok:false, a structured reason,
' compilerProbe{resolved,path,why} and howToProceed - a lint verdict is NEVER substituted.
'
' CLSID GUARD. A /make registers what it builds, which rewrites this add-in's own
' InprocServer32 to the copy's DLL; the value is captured first and put back, and the
' receipt reports registrationRewritten / registrationRestored.
' =====================================================================
Private Function VcCompilerExe(ByRef resolvedFrom As String, ByRef why As String) As String
    ' Resolution order is published on every receipt. An explicit environment override wins
    ' so a lane can demonstrate the "no compiler" refusal without changing any machine
    ' setting; otherwise the compiler IS the VB6.EXE that hosts this add-in.
    VcCompilerExe = ""
    resolvedFrom = ""
    why = ""
    Dim p As String
    p = Trim$(Environ$("VB6MCP_COMPILER_EXE"))
    If Len(p) > 0 Then
        resolvedFrom = "env:VB6MCP_COMPILER_EXE"
        If Dir$(p) = "" Then
            why = "the path in VB6MCP_COMPILER_EXE does not exist on disk: " & p
            Exit Function
        End If
        VcCompilerExe = p
        Exit Function
    End If
    resolvedFrom = "vbe.FullName"
    On Error Resume Next
    p = ""
    If Not m_vbe Is Nothing Then p = CStr(m_vbe.FullName)
    If Err.Number <> 0 Then Err.Clear
    On Error GoTo 0
    If Len(p) = 0 Then
        why = "the hosting IDE did not report its executable path (VBE.FullName is empty or unreadable)"
        Exit Function
    End If
    If Dir$(p) = "" Then
        why = "the executable reported by VBE.FullName does not exist on disk: " & p
        Exit Function
    End If
    VcCompilerExe = p
End Function

Private Function VcCompilerHowTo(ByVal reason As String) As String
    Select Case reason
        Case "compiler_timeout"
            VcCompilerHowTo = "the isolated /make was killed at the " & CStr(VC_COMPILE_BUDGET_MS) & " ms budget, so no compiler verdict exists; retry when the machine is less loaded, or pass requireCompiler=false for the lint/IDE-vs-disk answer"
        Case "project_not_on_disk"
            VcCompilerHowTo = "save the project first (save_project): /make compiles FILES, so a project with no .vbp on disk cannot be compiled"
        Case Else
            VcCompilerHowTo = "pass requireCompiler=false for the lint/IDE-vs-disk answer, or make a compiler available (a 32-bit VB6.EXE is the compiler used here; VB6MCP_COMPILER_EXE can point at one) and retry"
    End Select
End Function

Private Function VcCompilerRefusalJson(ByVal toolName As String, ByVal reason As String, ByVal probe As Object) As String
    ' ONE shape for every requireCompiler refusal. Nothing here claims anything about the
    ' component or the project: compiler authority was not obtained, so the call checked
    ' nothing about them and the receipt says exactly that.
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = reason
    d("tool") = toolName
    d("requireCompiler") = True
    d("authority") = "none"
    Set d("compilerProbe") = probe
    d("howToProceed") = VcCompilerHowTo(reason)
    d("note") = "requireCompiler:true demands COMPILER evidence and a lint verdict is never substituted, so this refusal is not a statement about the component or the project"
    If toolName = "verify_scope" Then
        ' the documented counter invariant must hold on EVERY receipt: a refusal checked nothing
        d("checked") = 0
        d("pass") = 0
        d("fail") = 0
        d("unknown") = 0
        d("countsConsistent") = True
    End If
    VcCompilerRefusalJson = JsonStringify(d)
End Function

Private Function VcCompilerFetch(ByRef outComp As Object, ByRef outProbe As Object, ByRef outReason As String) As Boolean
    VcCompilerFetch = False
    Set outComp = Nothing
    Set outProbe = CreateObject("Scripting.Dictionary")
    outReason = ""
    outProbe("resolved") = False
    outProbe("path") = ""
    outProbe("resolvedFrom") = ""
    outProbe("why") = ""
    Dim exePath As String
    Dim src As String
    Dim why As String
    exePath = VcCompilerExe(src, why)
    outProbe("resolvedFrom") = src
    outProbe("path") = exePath
    If Len(exePath) = 0 Then
        outProbe("why") = "compiler_exe_not_resolved: " & why
        outReason = "compiler_not_configured"
        Exit Function
    End If
    outProbe("resolved") = True
    Dim vbpPath As String
    vbpPath = F32VbpPath()
    outProbe("projectPath") = vbpPath
    If Len(vbpPath) = 0 Then
        outProbe("why") = "project_not_on_disk: the open project has no .vbp on disk"
        outReason = "project_not_on_disk"
        Exit Function
    End If
    Dim tmpBase As String
    tmpBase = Util.TempDir()
    If Len(tmpBase) = 0 Then
        outProbe("why") = "no_temp_dir: TEMP is not defined, so an isolated copy cannot be made"
        outReason = "compiler_not_configured"
        Exit Function
    End If
    Dim tmpDir As String
    tmpDir = PathJoin(tmpBase, "vb6mcp_verify_make_" & Format$(Now, "yyyymmdd_hhnnss") & "_" & CStr(GetTickCount() And &HFFFF&))
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    On Error Resume Next
    fso.CreateFolder tmpDir
    Err.Clear
    On Error GoTo 0
    If Not fso.FolderExists(tmpDir) Then
        outProbe("why") = "temp_copy_failed: the isolated copy directory could not be created: " & tmpDir
        outReason = "compiler_not_configured"
        Exit Function
    End If
    outProbe("tmpDir") = tmpDir
    Dim vbpCopy As String
    Dim nCopied As Long
    Dim missing As String
    Dim copyErr As String
    Dim compatCopy As String
    If Not CopyProjectForIsolatedMake(vbpPath, tmpDir, vbpCopy, nCopied, missing, copyErr, compatCopy) Then
        outProbe("why") = "temp_copy_failed: " & copyErr
        outReason = "compiler_not_configured"
        Exit Function
    End If
    outProbe("copyPath") = vbpCopy
    outProbe("copiedFiles") = nCopied
    outProbe("missingFiles") = missing
    outProbe("compatibilityReferenceCopied") = (Len(compatCopy) > 0)
    Dim logPath As String
    logPath = PathJoin(tmpDir, "isolated_make.log")
    Dim cmdArgs As String
    cmdArgs = "/make " & Chr$(34) & vbpCopy & Chr$(34) & " /out " & Chr$(34) & logPath & Chr$(34)
    Dim budgetMs As Long
    budgetMs = VC_COMPILE_BUDGET_MS
    Dim ec As Long
    Dim timedOut As Boolean
    Dim childPid As Long
    Dim killMethod As String
    Dim procMs As Long
    Dim leftover As Boolean
    Dim regBefore As String
    regBefore = WcInprocRead()
    Dim started As Boolean
    started = RunExeHardBudget(exePath, cmdArgs, budgetMs, ec, timedOut, childPid, killMethod, procMs, leftover)
    ' /make registers what it builds: put THIS add-in's CLSID value back before anything else.
    Dim regAfter As String
    Dim regRewritten As Boolean
    Dim regRestored As Boolean
    regRewritten = False
    regRestored = False
    regAfter = WcInprocRead()
    If Len(regBefore) > 0 Then
        If StrComp(regBefore, regAfter, vbTextCompare) <> 0 Then
            regRewritten = True
            regRestored = WcInprocWrite(regBefore)
            regAfter = WcInprocRead()
        End If
    End If
    outProbe("registrationRewritten") = regRewritten
    outProbe("registrationRestored") = regRestored
    outProbe("exitCode") = ec
    outProbe("timedOut") = timedOut
    outProbe("childPid") = childPid
    outProbe("compilerElapsedMs") = procMs
    outProbe("killMethod") = killMethod
    outProbe("childLeftover") = leftover
    outProbe("logPath") = logPath
    outProbe("budgetMs") = budgetMs
    If Not started Then
        outProbe("why") = "compiler_start_failed: VB6.EXE could not be started from " & exePath
        outReason = "compiler_not_configured"
        Exit Function
    End If
    Dim logExists As Boolean
    Dim logBytes As Long
    logExists = False
    logBytes = 0
    On Error Resume Next
    If Len(Dir$(logPath)) > 0 Then
        logExists = True
        logBytes = FileLen(logPath)
    End If
    Err.Clear
    On Error GoTo 0
    outProbe("logExists") = logExists
    outProbe("logBytes") = logBytes
    If (Not logExists) Or logBytes <= 0 Then
        outProbe("why") = "compiler_log_not_produced: the isolated /make produced no readable log (" & logPath & ")"
        outReason = "compiler_not_configured"
        Exit Function
    End If
    Dim bres As TBuildResult
    Dim rawLog As String
    bres = Build.ParseBuild(logPath, -1)
    rawLog = bres.raw
    Dim errN As Long
    errN = Build.CountBuildErrors(rawLog)
    outProbe("logEncoding") = bres.logEncoding
    outProbe("errorCount") = errN
    outProbe("compilerSaidOk") = bres.ok
    outProbe("matchRule") = bres.matchRule
    Dim artPath As String
    artPath = Build.ArtifactPathOf(vbpCopy)
    Dim aExists As Boolean
    Dim aSize As Double
    aExists = False
    aSize = 0
    On Error Resume Next
    If Len(artPath) > 0 Then
        If Len(Dir$(artPath)) > 0 Then
            aExists = True
            aSize = CDbl(FileLen(artPath))
        End If
    End If
    Err.Clear
    On Error GoTo 0
    outProbe("artifactPath") = artPath
    outProbe("artifactExists") = aExists
    outProbe("artifactSize") = aSize
    If timedOut Then
        outProbe("why") = "compiler_timeout: the isolated /make was killed at the " & CStr(budgetMs) & " ms budget"
        outReason = "compiler_timeout"
        Exit Function
    End If
    Dim bState As Long
    Dim bNote As String
    If errN > 0 Then
        bState = 0
        bNote = "the isolated /make over a COPY of the project on disk reported " & CStr(errN) & " compile error(s); log: " & logPath
    ElseIf bres.ok And aExists Then
        bState = 1
        bNote = "the isolated /make over a COPY of the project on disk succeeded (0 errors); log: " & logPath
    ElseIf aExists Then
        bState = 0
        bNote = "the isolated /make produced an artifact but its log carries no success marker: NOT a proven compiler pass; log: " & logPath
    Else
        bState = 0
        bNote = "the isolated /make produced no artifact and its log carries no success marker; log: " & logPath
    End If
    Set outComp = CreateObject("Scripting.Dictionary")
    outComp("path") = exePath
    outComp("resolvedFrom") = src
    outComp("logPath") = logPath
    outComp("logBytes") = logBytes
    outComp("logEncoding") = bres.logEncoding
    outComp("errorCount") = errN
    outComp("exitCode") = ec
    outComp("compilerSaidOk") = bres.ok
    outComp("matchRule") = bres.matchRule
    outComp("artifactPath") = artPath
    outComp("artifactExists") = aExists
    outComp("artifactChanged") = (aExists And (Not timedOut))
    outComp("artifactSize") = aSize
    outComp("compiledFrom") = "disk_copy"
    outComp("projectPath") = vbpPath
    outComp("copyPath") = vbpCopy
    outComp("tmpDir") = tmpDir
    outComp("copiedFiles") = nCopied
    outComp("missingFiles") = missing
    outComp("compatibilityReferenceCopied") = (Len(compatCopy) > 0)
    outComp("budgetMs") = budgetMs
    outComp("childPid") = childPid
    outComp("compilerElapsedMs") = procMs
    outComp("killMethod") = killMethod
    outComp("childLeftover") = leftover
    outComp("registrationRewritten") = regRewritten
    outComp("registrationRestored") = regRestored
    outComp("buildState") = bState
    outComp("buildNote") = bNote
    outComp("note") = "compiler evidence: an ISOLATED VB6.EXE /make over a COPY of the project's DISK files (unsaved pane edits are not in the copy; the real project and the real artifact are not touched). A /make registers what it builds, so this add-in's InprocServer32 is captured and restored (registrationRewritten/registrationRestored)."
    VcCompilerFetch = True
End Function

Private Function ToolVerify(ByVal name As String, ByVal diskPath As String, ByVal baselineText As String, ByVal requireCompiler As Boolean, Optional ByVal buildOverride As Long = -1, Optional ByVal buildSourceOverride As String = "") As String
    Dim cur As String, path As String, off As Long, kind As String
    ' ---- contract v1.16.0: requireCompiler ----
    ' The DEFAULT path (requireCompiler=false) is untouched: the receipt stays byte-for-byte
    ' what it was. When compiler authority is demanded the refusal happens BEFORE any
    ' lint/compare work, so a lint verdict can never be presented in place of a compiler one.
    Dim vcComp As Object
    Dim vcProbe As Object
    Dim vcWhy As String
    If requireCompiler Then
        If Not VcCompilerFetch(vcComp, vcProbe, vcWhy) Then
            If Len(vcWhy) = 0 Then vcWhy = "compiler_not_configured"
            ToolVerify = VcCompilerRefusalJson("verify", vcWhy, vcProbe)
            Exit Function
        End If
        buildOverride = CLng(vcComp("buildState"))
        buildSourceOverride = "compiler-isolated"
    End If
    ' segmented timing. was rescoped to "where do the ~3.9 s
    ' of verify_scope actually go?" - the previous round attributed it by guessing.
    Dim t0 As Long, tRead As Long, tMeta As Long, tFp As Long, tHash As Long, tVc As Long
    Dim tmLint As Long, tmDiag As Long, tmDisk As Long
    t0 = GetTickCount()
    cur = CompText(name)
    tRead = GetTickCount()
    path = DiskPathOf(name, diskPath)
    ' ONE implementation (see SharedHeaderOffset): headerLines + the accumulated hidden
    ' inline Attribute map. The old scalar (disk lines - pane lines) counted the hidden
    ' inline Attribute lines TWICE and made a correctly saved component read as MISMATCH.
    off = McpCls.SharedHeaderOffset(Me, name)
    kind = KindOfComponent(McpFindTools.FindComponent(Me, name))
    tMeta = GetTickCount()
    ' passing buildLogPath="" left buildOk at -1 (unknown), and an
    ' unknown build still produced overall:PASS. Resolve a REAL verdict here,
    ' preferring the build cache (key+hash must match, i.e. the recorded
    ' build is still current); otherwise report honestly that it is unknown.
    Dim bState As Long
    Dim bSource As String
    Dim bNote As String
    Dim vcLoaded As Boolean
    Dim vcAt As Double
    ' FIX-27 (R4.7): the build evidence must be AUDITABLE from the receipt alone: which source the
    ' recorded build compiled, and what the authority of the verdict is.
    Dim vCompFrom As String
    vCompFrom = ""
    vcLoaded = False
    vcAt = 0
    bState = -1
    bSource = "none"
    bNote = "no build has been recorded for this project; run build for a real compile verdict"
    On Error Resume Next
    Dim prj As VBIDE.VBProject
    Set prj = GetProject()
    If Not prj Is Nothing Then
        If Len(prj.FileName) > 0 Then
            Dim vcomps As Object
            Dim vfp As Object
            Set vfp = Build.BuildFingerprint(prj.FileName, "", vcomps)
            Dim vc As Object
            Set vc = CreateObject("Scripting.Dictionary")
            vc("key") = "": vc("hash") = "": vc("ok") = False: vc("exitCode") = 0
            vc("artifact") = "": vc("size") = 0: vc("logPath") = "": vc("at") = 0
            vc("verdict") = "": vc("okByKeyword") = False
            ' FIX-24 (F6): optional compiled-source axis; defaults keep an old cache record readable.
            vc("compiledFrom") = "": vc("paneDiskMismatch") = False: vc("paneDiskMismatchCount") = 0
            If Build.CacheLoad(vc) Then
                vcLoaded = True
                vcAt = CDbl(vc("at"))
                If CStr(vc("key")) = CStr(vfp("key")) Then
                    ' FIX-24 (F6): a build that compiled the PANE while the DISK differed cannot
                    ' speak for the disk file this verify compares against - downgrade instead of
                    ' answering cache-fresh.
                    vCompFrom = CStr(vc("compiledFrom"))
                    If (CStr(vc("compiledFrom")) = "pane") And CBool(vc("paneDiskMismatch")) Then
                        bState = -1
                        bSource = "cache-pane-disk-mismatch"
                        bNote = "the last recorded build compiled the IDE PANE while the DISK file differed for " & CStr(vc("paneDiskMismatchCount")) & " component(s) at build time, so its verdict does not describe the disk source this verify compares against. Save the project and rebuild, or treat this component as unknown."
                    ElseIf CStr(vc("hash")) = CStr(vfp("hash")) Then
                        If CBool(vc("ok")) Then bState = 1 Else bState = 0
                        bSource = "cache-fresh"
                        bNote = ""
                    Else
                        bSource = "cache-stale"
                        bNote = "the project changed after the last recorded build; run build for a current verdict"
                    End If
                Else
                    bSource = "cache-other-project"
                    bNote = "the build cache holds a different project; run build for this one"
                End If
            End If
        End If
    End If
    On Error GoTo 0
    tFp = GetTickCount()
    ' contract v1.16.0: caller-supplied COMPILER evidence (verify/verify_scope requireCompiler).
    ' -1 keeps the cache-based behaviour byte-for-byte; 0/1 REPLACE the cached build evidence
    ' with the compiler verdict obtained by VcCompilerFetch.
    If buildOverride >= 0 Then
        bState = buildOverride
        bSource = buildSourceOverride
        If Len(bSource) = 0 Then bSource = "compiler-isolated"
        bNote = "compiler evidence: an isolated VB6.EXE /make over a COPY of the project on disk (see the compiler block of this receipt)"
    End If
    ' ---- alpha: coords + the build artifact this verdict used
    Dim ex As Object
    Set ex = CreateObject("Scripting.Dictionary")
    Set ex("coords") = CoordsDict(1, off, "ide", (Len(path) > 0))
    ex("ideSha256") = Sha256.Sha256HexTextUtf8(cur)
    ' FIX-27 (R4.7): who says what about the build. buildCompiledFrom names the SOURCE the recorded
    ' build compiled (pane / disk / unknown); buildAuthority names the KIND of authority behind the
    ' verdict (cache_current / pane_compiled_cache / cache_stale / other_project_cache / none) and
    ' buildAuthorityNote says it in words. Together with buildSource they are auditable: a caller
    ' can tell "the compiler ran on the disk" from "a cached verdict about the pane, not the disk".
    If Len(vCompFrom) = 0 Then vCompFrom = "unknown"
    ex("buildCompiledFrom") = vCompFrom
    ex("buildAuthority") = McpBuildTools.BuildAuthorityOf(Me, bSource)
    ex("buildAuthorityNote") = McpBuildTools.BuildAuthorityNote(Me, bSource, vCompFrom)
    tHash = GetTickCount()
    ex("headerOffset") = off
    ' contract v1.16.0: the compiler verdict IS the build evidence on this path.
    If requireCompiler Then
        ex("requireCompiler") = True
        ex("authority") = "compiler"
        Set ex("compiler") = vcComp
    End If
    If vcLoaded Then
        Dim artPath As String
        artPath = CStr(vc("artifact"))
        If Len(artPath) > 0 Then
            Dim aEx As Boolean, aSz As Double, aTm As Double
            ArtifactSnap artPath, aEx, aSz, aTm
            ex("artifactPath") = artPath
            If aEx Then ex("artifactMtime") = ArtifactMtimeText(True, aTm)
            Dim artCh As Boolean
            artCh = False
            If aEx Then artCh = Build.ArtifactBuilt(artPath, vcAt, aSz)
            ex("artifactChanged") = artCh
            If bSource = "cache-fresh" And aEx And Not artCh Then
                ex("verdict") = "compiled-no-artifact-change"
                ex("artifactLockedHint") = "the recorded build says success but the artifact on disk was not refreshed (locked, or identical bytes)"
            End If
        End If
    End If
    ' Attribute-only annotation: VB6's SaveAs writes the component's HIDDEN Attribute lines into
    ' the FILE, while a code pane never shows them. A plain text comparison can therefore
    ' report a difference that is NOT a source change. It is reported as its own field so a
    ' caller (and a human reading a git diff) never has to count it as a real edit.
    Dim attrN As Long, attrOnly As Boolean
    attrN = 0
    attrOnly = AttributeOnlyDiff(cur, path, attrN)
    ex("attributeOnlyDiff") = attrOnly
    ex("attributeLineCount") = attrN
    If attrOnly Then ex("attributeOnlyNote") = "the pane and the FILE agree once the hidden Attribute lines (which a pane never shows) are ignored: this is attribute materialisation, not a source change"
    Dim extraJson As String
    extraJson = JsonStringify(ex)
    extraJson = Mid$(extraJson, 2, Len(extraJson) - 2)
    Dim vres As String
    vres = Verify.VerifyComponent(kind, cur, path, off, baselineText, "", name, bState, bSource, bNote, extraJson, tmLint, tmDiag, tmDisk)
    tVc = GetTickCount()
    ' splice the segment timings into the receipt. ADDITIVE only - every
    ' verdict field above is computed exactly as before.
    Dim tseg As Object
    Set tseg = CreateObject("Scripting.Dictionary")
    tseg("totalMs") = GetTickCount() - t0
    tseg("readCompTextMs") = tRead - t0
    tseg("metaMs") = tMeta - tRead
    tseg("fingerprintMs") = tFp - tMeta
    tseg("hashMs") = tHash - tFp
    tseg("verifyComponentMs") = tVc - tHash
    tseg("lintMs") = tmLint
    tseg("diagnosticsJsonMs") = tmDiag
    tseg("diskCompareMs") = tmDisk
    Dim segJson As String
    segJson = JsonStringify(tseg)
    segJson = Mid$(segJson, 2, Len(segJson) - 2)
    If Len(vres) > 1 Then
        ToolVerify = Left$(vres, Len(vres) - 1) & "," & segJson & "}"
    Else
        ToolVerify = vres
    End If
End Function



Private Function ToolInjectTrace(ByVal name As String, ByVal proc As String, ByVal exprs As String, ByVal id As String, ByVal expectedSha As String) As String
    Dim cur As String, em As String, nx As String
    ' the same segment timing edit_by_anchor/apply_edits report,
    ' so a slow inject is attributed instead of guessed.
    Dim tEntry As Long, tRead As Long, tPredict As Long, tLint As Long, tWrite As Long
    tEntry = GetTickCount()
    cur = CompText(name)
    GuardSha cur, expectedSha
    tRead = GetTickCount()
    ' NEVER emit code that cannot compile. A modal compile-error dialog
    ' blocks the whole IDE (end/remove_trace included), so an invisible symbol is a
    ' structured refusal decided LEXICALLY - VB6 is never asked to compile.
    Dim refusal As String
    refusal = TraceExprRefusal(name, cur, proc, exprs)
    If Len(refusal) > 0 Then
        ToolInjectTrace = refusal
        Exit Function
    End If
    ' the emitted guard calls McpTrace/McpTraceOn, so the target project
    ' must contain modMcpTrace. Attach it HERE (before the injected text is written) and
    ' PROVE it landed - the card forbids telling the caller to import a file by hand.
    Dim modInfo As Object
    Set modInfo = CreateObject("Scripting.Dictionary")
    EnsureTraceModule modInfo
    If Not TraceGen.InjectTrace(cur, proc, exprs, id, nx, em) Then Err.Raise vbObjectError + 85, "CodeTools", em
    tPredict = GetTickCount()
    Dim pack As Object
    ' region target = the instrumented procedure's declaration line.
    Set pack = LintPackForEdit(nx, KindOfName(name), LineCount(cur), ProcHeaderLineOf(nx, proc))
    tLint = GetTickCount()
    ' write only the changed range (SetCompText did delete-all + insert-all,
    ' i.e. TWO whole-module reformats; measured 15.7 s vs 31 ms on 27,000 lines).
    Dim wCalls As Long
    wCalls = SetCompTextMinimal(name, cur, nx)
    tWrite = GetTickCount()
    ' say what the emitted guard needs and where the sink will be, instead
    ' of "it looks successful" while nothing can possibly be written.
    Dim extra As Object
    Set extra = CreateObject("Scripting.Dictionary")
    extra("guard") = "runtime"
    extra("expressionCheck") = "ok"
    extra("checkedExpressions") = exprs
    extra("guardLine") = "If McpTraceOn() Then"
    extra("condCompRequired") = False
    extra("condCompNote") = "the emitted guard is a RUNTIME check, so it does not depend on the project's CondComp. A '#If MCP_TRACE' block would be COMPILE-TIME: the VBIDE object model does not expose CondComp and project_meta edits the .vbp text, so an already-loaded project keeps its old in-memory CondComp and the block is compiled out (measured)."
    extra("moduleRequired") = "modMcpTrace"
    extra("moduleHint") = "inject_trace ATTACHES modMcpTrace automatically when the project does not have it: the module source is embedded in the add-in, the header comment language is chosen UI-FIRST (the IDE's own UI language when it can be read, else the running VB6.EXE version resource, else English), and the attachment is VERIFIED by re-reading the component list. Nothing has to be imported by hand. remove_trace removes the module again together with the injected blocks."
    extra("modulePresentBefore") = modInfo("modulePresentBefore")
    extra("moduleAutoAttached") = modInfo("moduleAutoAttached")
    extra("moduleAttachAction") = modInfo("moduleAttachAction")
    If modInfo.Exists("moduleAttachMs") Then extra("moduleAttachMs") = modInfo("moduleAttachMs")
    If modInfo.Exists("ideLanguage") Then extra("ideLanguage") = modInfo("ideLanguage")
    If modInfo.Exists("ideLanguageSource") Then extra("ideLanguageSource") = modInfo("ideLanguageSource")
    If modInfo.Exists("ideMenuLanguage") Then extra("ideMenuLanguage") = modInfo("ideMenuLanguage")
    If modInfo.Exists("ideMenuLanguageSource") Then extra("ideMenuLanguageSource") = modInfo("ideMenuLanguageSource")
    If modInfo.Exists("commentLanguage") Then extra("commentLanguage") = modInfo("commentLanguage")
    If modInfo.Exists("commentLanguageSource") Then extra("commentLanguageSource") = modInfo("commentLanguageSource")
    If modInfo.Exists("commentLanguageRule") Then extra("commentLanguageRule") = modInfo("commentLanguageRule")
    If modInfo.Exists("moduleCodeLines") Then extra("moduleCodeLines") = modInfo("moduleCodeLines")
    If modInfo.Exists("moduleCodeSha256") Then extra("moduleCodeSha256") = modInfo("moduleCodeSha256")
    If modInfo.Exists("moduleCodeSha256Note") Then extra("moduleCodeSha256Note") = modInfo("moduleCodeSha256Note")
    If modInfo.Exists("moduleAttachError") Then extra("moduleAttachError") = modInfo("moduleAttachError")
    If modInfo.Exists("moduleAttachNote") Then extra("moduleAttachNote") = modInfo("moduleAttachNote")
    extra("sinkPath") = SinkPathOf()
    extra("sinkNote") = "MCP_TRACE_FILE if set, else %TEMP%\mcp_trace.jsonl"
    ' do not let the caller discover a broken sink by running the program
    ' and finding no file. Probe the sink directory here, and check that the project can
    ' actually call the guard (modMcpTrace is what defines McpTrace/McpTraceOn).
    Dim psp As Object
    Set psp = SinkProbe()
    extra("sinkDir") = psp("sinkDir")
    extra("sinkDirExists") = psp("sinkDirExists")
    extra("sinkDirWritable") = psp("sinkDirWritable")
    If psp.Exists("sinkAdvice") Then extra("sinkAdvice") = psp("sinkAdvice")
    Dim moduleNow As Boolean
    moduleNow = ModulePresent(name)
    extra("modulePresent") = moduleNow
    extra("readyToTrace") = (moduleNow And CBool(psp("sinkDirWritable")))
    If Not moduleNow Then
        extra("moduleMissingAdvice") = "modMcpTrace is STILL missing after the automatic attach attempt, so the injected guard cannot compile: VB6 will raise a MODAL compile-error dialog (measured: Compile error / Sub or Function not defined) that blocks end and remove_trace. moduleAttachAction/moduleAttachError say why the attach failed - the failure is reported, never silently downgraded."
        extra("readyToTrace") = False
    End If
    extra("enableHint") = "set MCP_TRACE_ON=1 (or MCP_TRACE_FILE=<path>) in the environment of the VB6 process BEFORE starting it; McpTraceOn() reads the environment at call time. THREE preconditions are checked in this same receipt: (1) modulePresent - inject_trace attaches modMcpTrace automatically and verifies it, so a false here means the attach FAILED (see moduleAttachError) and the guard cannot compile; (2) sinkDirWritable/sinkAdvice - the sink directory must be creatable (the generated module MkDirs it, else falls back to %TEMP%\mcp_trace.jsonl and logs the reason to MCP_TRACE_ERR_FILE); (3) readyToTrace - true only when both hold."
    extra("shipNote") = "the injected blocks call McpTrace/McpTraceOn, which are defined in modMcpTrace: if you keep the calls and build/ship an EXE or DLL, that module must be compiled into it. remove_trace removes the injected blocks AND the auto-attached module."
    extra("runtimeCost") = "with the runtime guard the call is always compiled: one boolean check per traced line"
    ' the segmented timing the card requires (read/predict/lint/write + write count).
    extra("writeCalls") = wCalls
        extra("hunks") = m_lastWriteHunks
    extra("readMs") = tRead - tEntry
    extra("predictMs") = tPredict - tRead
    extra("lintMs") = tLint - tPredict
    extra("writeMs") = tWrite - tLint
    AddWritePhases extra
    ToolInjectTrace = ChangeResult2(name, cur, nx, pack, extra, tEntry)
End Function

Private Function ToolRemoveTrace(ByVal name As String, ByVal id As String, ByVal expectedSha As String) As String
    Dim cur As String, em As String, nx As String
    Dim tEntry As Long, tRead As Long, tPredict As Long, tLint As Long, tWrite As Long
    tEntry = GetTickCount()
    cur = CompText(name)
    GuardSha cur, expectedSha
    tRead = GetTickCount()
    If Not TraceGen.RemoveTrace(cur, id, nx, em) Then Err.Raise vbObjectError + 85, "CodeTools", em
    tPredict = GetTickCount()
    Dim pack As Object
    Set pack = LintPack(nx, KindOfName(name))
    tLint = GetTickCount()
    ' write only the changed range (SetCompText did delete-all + insert-all,
    ' i.e. TWO whole-module reformats; measured 15.7 s vs 31 ms on 27,000 lines).
    Dim wCalls As Long
    wCalls = SetCompTextMinimal(name, cur, nx)
    tWrite = GetTickCount()
    ' only THIS id's injected block is removed. modMcpTrace is KEPT BY DESIGN -
    ' the user may have added code to it, and other @mcp-trace blocks elsewhere may still
    ' call it, so the project would stop compiling without it. The receipt reports the state
    ' and the manual removal steps. (The automatic removal was withdrawn.)
    Dim modInfo As Object
    Set modInfo = CreateObject("Scripting.Dictionary")
    ReportTraceModuleKept modInfo
    ' (an earlier verification, section 15.2): cleaning the PANE is not enough. After a run,
    ' VB6's pre-run save has already written the injected block to the FILE, so the disk
    ' keeps a copy, the pane and the disk silently diverge and verify() reports FAIL.
    ' Flush the cleaned pane the same way set_breakpoint/clear_breakpoints do, then say
    ' honestly whether the disk now matches (ok:false + reason when it does not).
    Dim paneNow As String
    paneNow = CompText(name)
    Dim flushErr As String
    flushErr = ""
    On Error Resume Next
    ToolSaveProject ""
    If Err.Number <> 0 Then flushErr = Err.Description
    Err.Clear
    On Error GoTo 0
    Dim extra As Object
    Set extra = CreateObject("Scripting.Dictionary")
    extra("flushed") = True
    extra("saved") = True
    extra("diskAfterRemoveSha256") = ComponentFileSha(name)
    extra("diskStillHasMarker") = (InStr(1, DiskTextOfName(name), "@mcp-trace " & id) > 0)
    If Not DiskMatchesPane(name, paneNow) Then
        extra("ok") = False
        extra("saved") = False
        If Len(flushErr) > 0 Then
            extra("reason") = "disk_not_flushed"
            extra("note") = "the block is gone from the code pane but the FILE still holds it (flush failed: " & flushErr & "); call save_project, or expect verify() to report FAIL"
        Else
            extra("reason") = "disk_still_differs"
            extra("note") = "the block is gone from the code pane but the FILE still differs; call save_project, or expect verify() to report FAIL"
        End If
    End If
    extra("writeCalls") = wCalls
        extra("hunks") = m_lastWriteHunks
    extra("readMs") = tRead - tEntry
    extra("predictMs") = tPredict - tRead
    extra("lintMs") = tLint - tPredict
    extra("writeMs") = tWrite - tLint
    extra("modulePresentBefore") = modInfo("modulePresentBefore")
    extra("moduleRemoved") = modInfo("moduleRemoved")
    extra("moduleLeftInPlace") = modInfo("moduleLeftInPlace")
    extra("moduleAutogenMarker") = modInfo("moduleAutogenMarker")
    extra("moduleRemoveReason") = modInfo("moduleRemoveReason")
    If modInfo.Exists("moduleRemoveNote") Then extra("moduleRemoveNote") = modInfo("moduleRemoveNote")
    If modInfo.Exists("moduleKeptNote") Then extra("moduleKeptNote") = modInfo("moduleKeptNote")
    If modInfo.Exists("moduleFileOnDisk") Then extra("moduleFileOnDisk") = modInfo("moduleFileOnDisk")
    AddWritePhases extra
    ToolRemoveTrace = ChangeResult2(name, cur, nx, pack, extra, tEntry)
End Function

Private Function ToolFaultInject(ByVal name As String, ByVal proc As String, ByVal mode As String, ByVal value As String, ByVal id As String, ByVal expectedSha As String) As String
    Dim cur As String, em As String, nx As String
