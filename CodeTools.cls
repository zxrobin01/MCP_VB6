' True when the file on disk holds exactly the code pane's text, ignoring the
' trailing newline VB6 writes and the file's ANSI encoding. Comparing the two
' raw hashes would always differ (bytes vs text), so consistency is decided on
' normalised text; the raw hashes are reported separately.
' Normalised code text: line feeds unified, trailing newlines dropped, and the
' Attribute VB_* metadata lines removed. VB6 keeps e.g. "Attribute VB_Name" in the
' .bas FILE but the code module does not expose it, so modLoop.bas has 50 file
' lines while the pane reports 49 - comparing the raw texts would never match.
' item 3 (spec: 内部证据).
' this wrapper NO LONGER carries its own head rule.  The split itself is
' CodeSectionOfDisk() below - the SAME function the save_project code-only check
' (ComponentCheckRecord / DiskMatchesPane) uses - so add_code (which appends a FILE) and
' the designer check can never disagree about where a component's head ends.  The
' duplicated rule WAS the defect: it tested the line AFTER "VERSION" for BEGIN/BEGIN- and
' therefore did not skip the "Object = ..." lines a form publishes for every hosted
' ActiveX part.  MEASURED on ServerForm.frm: it stopped after ONE line and handed the
' whole designer block back as "code" (stop@1; the shared rule gives stop@38, with
' body[0]="Option Explicit").
' FAILURE SAFETY (the whole point): if the pane is empty, or the derived body cannot be
' reconciled with the pane (equal / prefix either way / same first line), the caliber is
' 'unknown' and the DISK TEXT IS RETURNED UNCHANGED - 'rather do not split than eat the
' body'. verifyPane=False asks for the structural strip alone (add_code appends a FILE,
' so there is no pane of that file to validate - the file-vs-pane decision).
Private Function StrippedDiskText(ByVal disk As String, ByVal paneText As String, _
                                  Optional ByVal verifyPane As Boolean = True, _
                                  Optional ByRef outCaliber As String = "") As String
    On Error Resume Next
    outCaliber = "unknown"
    StrippedDiskText = disk
    If Len(disk) = 0 Then Exit Function
    ' ---- 1..3. the head is stripped by the ONE shared splitter ---------
    Dim headFound As Boolean
    Dim headKind As String
    headFound = False
    headKind = "none"
    Dim body As String
    body = CodeSectionOfDisk(disk, headFound, headKind)
    ' ---- 4. failure safety -------------------------------------------
    If verifyPane Then
        Dim ok As Boolean
        ok = False
        If Len(paneText) = 0 Then
            ok = False
        ElseIf body = paneText Then
            ok = True
        ElseIf Len(body) > Len(paneText) Then
            If Left$(body, Len(paneText)) = paneText Then ok = True
        ElseIf Len(paneText) > Len(body) Then
            If Left$(paneText, Len(body)) = body Then ok = True
        End If
        If Not ok Then
            Dim bl() As String, pl() As String
            bl = Split(Replace(Replace(body, vbCrLf, vbLf), vbCr, vbLf), vbLf)
            pl = Split(Replace(Replace(paneText, vbCrLf, vbLf), vbCr, vbLf), vbLf)
            If UBound(bl) >= 0 Then
                If UBound(pl) >= 0 Then
                    If bl(0) = pl(0) Then ok = True
                End If
            End If
        End If
        If Not ok Then
            outCaliber = "unknown"
            StrippedDiskText = disk
            Err.Clear
            Exit Function
        End If
    End If
    outCaliber = "ok"
    StrippedDiskText = body
    Err.Clear
End Function

' .cls designer block: BEGIN .. END, nesting counted.
Private Function ClsHeadBlockEnd(ByRef lines() As String, ByVal startIdx As Long, ByVal lastIdx As Long) As Long
    Dim depth As Long, i As Long, u As String
    depth = 0
    i = startIdx
    Do While i <= lastIdx
        MaybePump
        u = UCase$(Trim$(lines(i)))
        If u = "BEGIN" Then
            depth = depth + 1
        ElseIf u = "END" Then
            depth = depth - 1
            If depth <= 0 Then
                ClsHeadBlockEnd = i + 1
                Exit Function
            End If
        End If
        i = i + 1
    Loop
    ClsHeadBlockEnd = i
End Function

' .frm/.ctl/.dsr designer block: Begin .. End with nested Begin / BeginProperty.
Private Function DesignerHeadBlockEnd(ByRef lines() As String, ByVal startIdx As Long, ByVal lastIdx As Long) As Long
    Dim depth As Long, i As Long, u As String
    depth = 0
    i = startIdx
    Do While i <= lastIdx
        MaybePump
        u = UCase$(Trim$(lines(i)))
        If u = "BEGIN" Or Left$(u, 6) = "BEGIN " Or u = "BEGINPROPERTY" Or Left$(u, 14) = "BEGINPROPERTY " Then
            depth = depth + 1
        ElseIf u = "END" Or u = "ENDPROPERTY" Then
            depth = depth - 1
            If depth <= 0 Then
                DesignerHeadBlockEnd = i + 1
                Exit Function
            End If
        End If
        i = i + 1
    Loop
    DesignerHeadBlockEnd = i
End Function

Private Function NormalizeCode(ByVal text As String) As String
    ' linear. This used to accumulate with "out = out & lines(i) & vbLf"
    ' once per line, which is O(n^2) on a BSTR: an earlier measurement took 31-50 s on a
    ' 27,003-line / 1.5 MB pane, reproduced as 52,106 ms by verify_scope (it reaches
    ' here through DiskMatchesPane). The kept lines are now collected into a String()
    ' and joined ONCE, and the trailing-LF trim is done with a single Left$ instead
    ' of a per-character loop; measured 3,203 ms -> 15 ms at 27,003 lines, and the
    ' output is bit-identical.
    Dim lines() As String, i As Long, n As Long, k As Long, t As String
    Dim keep() As String, out As String, ln As Long
    ' reopen: an EMPTY text is a legitimate input (an empty code
    ' section, an empty code pane) and its normal form is "". Until now it was a
    ' LATENT ERROR: VB6's Split("") returns an EMPTY array (UBound = -1), so
    ' n = -1 and "ReDim keep(0 To n)" raised error 9 (subscript out of range).
    ' Every caller reaches here through On Error Resume Next, so the raise did
    ' not surface - it silently ABORTED the comparison and left the caller's
    ' boolean at False. That is the second half of the measured empty-pane false
    ' failure: even with the disk side correctly stripped to "", this function
    ' raised on BOTH operands and DiskMatchesPane could only answer False.
    If Len(text) = 0 Then Exit Function
    lines = Split(Replace(text, vbCrLf, vbLf), vbLf)
    n = UBound(lines)
    If n < 0 Then Exit Function
    ReDim keep(0 To n)
    k = 0
    For i = 0 To n
        MaybePump
        t = Trim$(lines(i))
        If LCase$(Left$(t, 10)) <> "attribute " Then
            keep(k) = lines(i)
            k = k + 1
        End If
    Next
    If k = 0 Then Exit Function
    If k <= n Then ReDim Preserve keep(0 To k - 1)
    out = Join(keep, vbLf) & vbLf
    ln = Len(out)
    Do While ln > 0 And Mid$(out, ln, 1) = vbLf
        ln = ln - 1
    Loop
    NormalizeCode = Left$(out, ln)
End Function

' the disk text from the pane's FIRST line onwards, i.e. with the
' file's own header (designer block + Attribute lines) removed. Without this the
' comparison was structurally false for EVERY form: a .frm file starts with the
' designer block, NormalizeCode only strips Attribute lines, so the two normalised
' texts could never be equal (measured: onDisk=false on every set_breakpoint
' against Form1 while the file had in fact just been rewritten).
Private Function PaneTailOfDisk(ByVal disk As String, ByVal paneText As String) As String
    On Error Resume Next
    PaneTailOfDisk = disk
    Dim plines() As String, dlines() As String
    plines = Split(Replace(Replace(paneText, vbCrLf, vbLf), vbCr, vbLf), vbLf)
    dlines = Split(Replace(Replace(disk, vbCrLf, vbLf), vbCr, vbLf), vbLf)
    If UBound(plines) < 0 Then Exit Function
    Dim first As String, i As Long, j As Long, out As String
    first = plines(0)
    For i = 0 To UBound(dlines)
        MaybePump
        If dlines(i) = first Then
            ' ONE Join of the slice instead of a per-line accumulation
            ' (quadratic on a whole module).
            PaneTailOfDisk = JoinRange(dlines, i, UBound(dlines))
            Exit Function
        End If
    Next
End Function

Private Function DiskMatchesPane(ByVal name As String, ByVal paneText As String) As Boolean
    On Error Resume Next
    DiskMatchesPane = False
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, name)
    If comp Is Nothing Then Exit Function
    Dim f As String
    f = ""
    f = comp.FileNames(1)
    If Len(f) = 0 Then Exit Function
    If Dir$(f) = "" Then Exit Function
    Dim disk As String
    disk = Build.ReadLogAnsi(f)
    If Len(disk) = 0 Then Exit Function
    ' (re-opened, writer-hygiene 2026-10-16): the DISK-SIDE code section
    ' is derived STRUCTURALLY - a pure function of the disk bytes - never by
    ' searching the disk for the pane's first line.
    ' MEASURED FALSE FAILURE (this build, a throw-away fixture project, component
    ' FormEmpty): replace_code{operation:"set", code:""} leaves the pane empty
    ' (newTotalLines 0), and save_project then answered
    '   ok:false / okReason "reported as saved but the file on disk still
    '   differs from the pane: FormEmpty"
    ' while FormEmpty.frm HAD just been rewritten correctly by the flush.
    ' Mechanism: CompText returns "" for an empty code module, and
    ' PaneTailOfDisk bailed out at its OWN guard "If UBound(plines) < 0 Then
    ' Exit Function" - VB6's Split("") returns an EMPTY array (UBound = -1) - so
    ' it returned the disk text UNCHANGED and the comparison became
    '   NormalizeCode(the whole .frm: VERSION / Begin VB.Form ... End /
    '                 Attribute VB_Exposed = False) = NormalizeCode("")
    ' which can never be true. The same naive route also mis-splits whenever the
    ' pane's first line occurs inside the designer head.
    ' The assertion is NOT weakened: the head is removed by a structural rule,
    ' the remaining CODE SECTION must equal the pane, and for a designer file the
    ' head must STILL be on disk; componentChecks[] additionally carries the
    ' independent positive assertions (exists / non-empty / head present) and the
    ' write's own size+mtime+digest evidence.
    Dim ext As String
    ext = ""
    If InStrRev(f, ".") > 0 Then ext = LCase$(Mid$(f, InStrRev(f, ".")))
    Dim body As String
    Dim headFound As Boolean
    Dim headKind As String
    body = ""
    headFound = False
    headKind = "none"
    If IsDesignerExt(ext) Then
        body = CodeSectionOfDisk(disk, headFound, headKind)
        ' a designer file whose head is gone is not a match, whatever the rest says
        If Not headFound Then Exit Function
    ElseIf Len(paneText) = 0 Then
        ' an empty pane means an empty code section - the same structural strip,
        ' not the pane-anchored search that cannot run without a first line
        body = CodeSectionOfDisk(disk, headFound, headKind)
    Else
        body = PaneTailOfDisk(disk, paneText)
    End If
    DiskMatchesPane = (NormalizeCode(body) = NormalizeCode(paneText))
End Function

' Designer extensions: the file itself carries a designer head, which is why
' this is decided from the path and not from the component object.
Private Function IsDesignerExt(ByVal ext As String) As Boolean
    IsDesignerExt = (ext = ".frm" Or ext = ".ctl" Or ext = ".dsr" Or ext = ".pag")
End Function

' reopen: the STRUCTURAL head stripper behind DiskMatchesPane. It is a
' pure function of the disk bytes; headFound is True only when a head was really
' recognised and consumed, so a caller can assert "the head is still there"
' instead of trusting the remainder.
'   .frm/.ctl/.dsr/.pag  VERSION <x.y> -> "Object = ..." lines (one per hosted
'                        ActiveX part) -> Begin..End (nested Begin/BeginProperty)
'                        -> the leading contiguous Attribute block
'   .cls                 VERSION <x> -> BEGIN..END (nested) -> Attribute block
'   .bas / other         the leading contiguous Attribute block
' MEASURED (ServerForm.frm, 1067 lines): the older StrippedDiskText head rule
' tested the line AFTER "VERSION" for BEGIN/BEGIN-, so on a form that hosts an
' OCX it stopped after ONE line and handed the whole designer block back as
' "code" (stop@1; with the Object= skip it is stop@38, body[0]="Option
' Explicit"). That is why this rule skips the Object= lines.
' it now skips them UNCONDITIONALLY (the ext parameter is gone) and this
' function is the ONLY implementation - StrippedDiskText() above is a thin wrapper over
' it.  A duplicated rule is a rule that drifts: the copy in StrippedDiskText is what made
' add_code write the designer head into the pane.
Private Function CodeSectionOfDisk(ByVal disk As String, _
                                   ByRef headFound As Boolean, ByRef headKind As String) As String
    On Error Resume Next
    headFound = False
    headKind = "none"
    CodeSectionOfDisk = disk
    If Len(disk) = 0 Then Exit Function
    Dim lines() As String
    lines = Split(Replace(Replace(disk, vbCrLf, vbLf), vbCr, vbLf), vbLf)
    Dim n As Long, i As Long, u As String
    n = UBound(lines)
    If n < 0 Then Exit Function
    Do While i <= n And Len(Trim$(lines(i))) = 0
        i = i + 1
    Loop
    If i > n Then Exit Function
    If Left$(UCase$(Trim$(lines(i))), 8) = "VERSION " Then
        i = i + 1
        ' "Object = ..." lines are skipped UNCONDITIONALLY.  VB6 writes one per
        ' hosted ActiveX part and ONLY inside a designer head, so the rule does not need
        ' the file extension to recognise them; gating it on IsDesignerExt() is what let
        ' the two copies of this rule drift apart.  A .cls/.bas never has such a line
        ' here (a .cls goes VERSION -> BEGIN, a .bas has no VERSION at all).
        Do While i <= n And Left$(LCase$(Trim$(lines(i))), 7) = "object "
            i = i + 1
        Loop
        If i > n Then Exit Function
        u = UCase$(Trim$(lines(i)))
        If u = "BEGIN" Then
            i = ClsHeadBlockEnd(lines, i, n)
            headKind = "class"
        ElseIf Left$(u, 6) = "BEGIN " Then
            i = DesignerHeadBlockEnd(lines, i, n)
            headKind = "designer"
        Else
            ' VERSION with no block: not a head this rule knows - do not guess
            Exit Function
        End If
        headFound = True
    End If
    Dim attrStart As Long
    attrStart = i
    Do While i <= n
        MaybePump
        If LCase$(Left$(Trim$(lines(i)), 10)) = "attribute " Then
            i = i + 1
        Else
            Exit Do
        End If
    Loop
    If i > attrStart Then
        headFound = True
        If headKind = "none" Then headKind = "attributes"
    End If
    If i > n Then
        CodeSectionOfDisk = ""
    Else
        CodeSectionOfDisk = JoinRange(lines, i, n)
    End If
End Function

' apply a trace-breakpoint edit and then reconcile the DISK
' with the code pane HONESTLY.
' The edit used to live only in the IDE pane. The injected block reached the file
' only as a side effect of run's pre-run flush, so clear_breakpoints
' answered with fresh hashes while the disk still held the injection - a fake
' "cleared" state (P4: now=9ECDFD47 != backup=9FCE7D14). We now flush and report
' diskSha256 / paneSha256 / onDisk, and when the disk cannot be made to match we
' answer ok:false with a reason instead of claiming success.
' is 'line' a statement INSIDE a procedure body? See the body of this
' function for why the VBIDE proc queries are not usable for it.
Private Function InsideProcedureBody(ByVal name As String, ByVal line As Long, ByVal paneText As String) As Boolean
    On Error Resume Next
    InsideProcedureBody = False
    If line < 1 Then Exit Function
    ' Use the lint engine's own procedure map: it is a real VB parser, whereas
    ' VBIDE's ProcOfLine attributes a blank line before a procedure to that procedure
    ' and ProcBodyLine returns the declaration line itself on this build (both
    ' measured - two earlier versions of this guard let the declaration through and
    ' the project then stopped compiling).
    Vb6Lint.Lint paneText, KindOfName(name)
    If Len(Vb6Lint.ProcBodyOwner(line)) > 0 Then InsideProcedureBody = True
End Function

Private Function BreakpointEdit(ByVal name As String, ByVal op As String, ByVal anchor As String, _
                                ByVal id As String, ByVal expectedSha As String) As String
    Dim cur As String, em As String, nx As String
    ' segmented timing for set_breakpoint/clear_breakpoints (this receipt used to
    ' carry ok/ideTotalLines only).
    Dim tEntry As Long, tRead As Long, tPredict As Long, tLint As Long, tWrite As Long
    tEntry = GetTickCount()
    cur = CompText(name)
    GuardSha cur, expectedSha
    tRead = GetTickCount()
    If op = "clear" Then
        If Not TraceGen.ClearBreakpoint(cur, id, nx, em) Then Err.Raise vbObjectError + 88, "CodeTools", em
    Else
        ' beta-2: never inject inside a VB line continuation
        Dim curLines() As String
        curLines = McpCls.TextLines(Me, cur)
        Dim hits() As Long, cnt As Long
        VbAnchor.FindHits cur, anchor, hits, cnt
        If cnt >= 1 Then
            If IsContinuationTail(curLines, hits(0)) Then
                BreakpointEdit = GuardReject(name, "set_breakpoint", "inside_continuation", _
                    "the anchor line " & CStr(hits(0)) & " is the tail of a logical line (line " & CStr(hits(0) - 1) & " ends with a VB continuation _); injecting there would split it. Anchor the first line of the logical statement.", _
                    hits(0), hits(0), LineCount(cur))
                Exit Function
            End If
            ' the injected Debug.Assert False must land INSIDE a procedure.
            If Not InsideProcedureBody(name, hits(0), cur) Then
                BreakpointEdit = GuardReject(name, "set_breakpoint", "anchor_outside_procedure", _
                    "the anchor line " & CStr(hits(0)) & " is not inside a procedure body (it is a module-level line or a procedure declaration). Injecting Debug.Assert False there puts executable code OUTSIDE any procedure, and the project then stops compiling with 'invalid outside procedure'. Anchor a statement inside the procedure body instead.", _
                    hits(0), hits(0), LineCount(cur))
                Exit Function
            End If
        End If
        If Not TraceGen.SetBreakpoint(cur, anchor, id, nx, em) Then Err.Raise vbObjectError + 88, "CodeTools", em
    End If
    tPredict = GetTickCount()
    ' beta-3: lint the RESULT before it is written (warn-only)
    Dim pack As Object
    ' region target = the anchored line (set); clear has no line -> whole.
    Dim bpTarget As Long
    If op = "set" Then
        If cnt >= 1 Then bpTarget = hits(0)
    End If
    Set pack = LintPackForEdit(nx, KindOfName(name), LineCount(cur), bpTarget)
    tLint = GetTickCount()
    ' write only the changed range (SetCompText did delete-all + insert-all,
    ' i.e. TWO whole-module reformats; measured 15.7 s vs 31 ms on 27,000 lines).
    Dim wCalls As Long
    wCalls = SetCompTextMinimal(name, cur, nx)
    tWrite = GetTickCount()
    Dim paneNow As String
    paneNow = CompText(name)
    Dim paneSha As String
    paneSha = Sha256.Sha256HexTextUtf8(paneNow)
    ' flush the pane to its file; a failure is reported, never hidden
    Dim flushErr As String
    flushErr = ""
    On Error Resume Next
    ToolSaveProject ""
    If Err.Number <> 0 Then flushErr = Err.Description
    Err.Clear
    On Error GoTo 0
    Dim diskSha As String
    diskSha = ComponentFileSha(name)
    Dim matches As Boolean
    matches = DiskMatchesPane(name, paneNow)
    Dim why As String
    why = ""
    If Not matches Then
        If Len(flushErr) > 0 Then
            why = "not persisted to disk: " & flushErr
        Else
            why = "disk still differs from the code pane after the flush attempt"
        End If
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("component") = name
    root("operation") = op
    ' the same project-directory write manifest as every other write receipt.
    Dim pdwB As Object
    Set pdwB = New Collection
    ManifestMergeUndo pdwB
    Set root("projectDirWrites") = pdwB
    root("sha256Before") = Sha256.Sha256HexTextUtf8(cur)
    root("sha256After") = paneSha
    root("lineDelta") = PaneLineCount(paneNow) - PaneLineCount(cur)
    root("newTotalLines") = PaneLineCount(paneNow)
    root("trailingBlankLine") = TrailBlank(paneNow)
    ' Card criterion 3: the disk/pane reconciliation fields
    root("paneSha256") = paneSha
    root("diskSha256") = diskSha
    root("onDisk") = matches
    root("ok") = (Len(why) = 0)
    If Len(why) > 0 Then root("reason") = why
    ' ---- alpha: coords + the IDE-read line count
    Dim ideTotal As Long
    ideTotal = CompLineCount(name)
    root("ideTotalLines") = ideTotal
    If ideTotal <> LineCount(paneNow) Then root("syncWarning") = SyncWarningText(ideTotal, LineCount(paneNow))
    Set root("coords") = CoordsDictOfName(name, 1, "ide")
    ' segmented timing (was ok/ideTotalLines only).
    root("writeCalls") = wCalls
    root("hunks") = m_lastWriteHunks
    root("readMs") = tRead - tEntry
    root("predictMs") = tPredict - tRead
    root("lintMs") = tLint - tPredict
    root("writeMs") = tWrite - tLint
    AddWritePhases root
    root("totalMs") = GetTickCount() - tEntry
    CopyLintPack root, pack
    BreakpointEdit = ReceiptJson(root)
End Function

' / F2-A: the catalogue is now HONEST about how each entry can actually be
' driven. executableVia = control_execution (a real control_execution mode) |
' native_breakpoint (the Debug-menu toggle, no source marker) | command_bars (only the
' CommandBars execution path reaches it) | command_bars:open_only (the entry only OPENS a
' debug window - no tool can READ that window's contents). viaNote carries the reason when
' the entry is NOT reachable through control_execution. Pure OUTPUT addition: no parameter
' and no tool description depends on it, so no re-freeze is involved.
Private Sub AddDbg(ByVal arr As Object, ByVal id As String, ByVal keys As String, ByVal english As String, ByVal via As String, Optional ByVal viaNote As String = "")
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("id") = id
    d("keys") = keys
    d("english") = english
    d("executableVia") = via
    If Len(viaNote) > 0 Then d("viaNote") = viaNote
    ' (authorized scope): expose the LIVE CommandBars Id and
    ' shortcutText next to the static catalogue, so a caller can drive the menu
    ' without any localized text. Resolution reuses the Id+shortcut rule, so an
    ' ambiguous Id is never trusted alone; when the control cannot be resolved
    ' live we report the values measured in and say so.
    Dim sc As String
    Dim wantId As Long
    sc = ""
    wantId = CmdId(id, sc)
    Dim c As Object
    Set c = FindBarControlById(m_vbe, "", english, wantId, sc)
    On Error Resume Next
    If Not c Is Nothing Then
        d("menuId") = c.Id
        d("shortcutText") = c.ShortcutText
        d("caption") = c.Caption
        d("idSource") = "live"
    Else
        d("menuId") = wantId
        d("shortcutText") = sc
        d("idSource") = "table"
    End If
    On Error GoTo 0
    arr.Add d
End Sub

Private Function ToolDebugCommands() As String
    Dim arr As Object, root As Object
    Set arr = New Collection
    AddDbg arr, "run", "F5", "Start", "control_execution"
    AddDbg arr, "break", "Ctrl+Break", "Break", "control_execution"
    AddDbg arr, "end", "Shift+F5", "End", "control_execution"
    AddDbg arr, "step_into", "F8", "Step Into", "control_execution"
    AddDbg arr, "step_over", "Shift+F8", "Step Over", "control_execution"
    AddDbg arr, "step_out", "Ctrl+Shift+F8", "Step Out", "control_execution"
    AddDbg arr, "run_to_cursor", "Ctrl+F8", "Run To Cursor", "control_execution"
    ' / F2 (S ruling: STOP DECLARING it as a control_execution mode; F2-B is NOT
    ' implemented). The entry stays because the command DOES exist in the IDE and IS reachable
    ' - but only through the CommandBars path (command_bars{action:"execute"} by id/caption),
    ' never through control_execution, whose Select Case has no branch for it.
    AddDbg arr, "set_next_statement", "Ctrl+F9", "Set Next Statement", "command_bars", "control_execution has no branch for this mode"
    AddDbg arr, "toggle_breakpoint", "F9", "Toggle Breakpoint", "native_breakpoint"
    AddDbg arr, "clear_all_breakpoints", "Ctrl+Shift+F9", "Clear All Breakpoints", "native_breakpoint"
    AddDbg arr, "immediate_window", "Ctrl+G", "Immediate Window", "command_bars:open_only"
    AddDbg arr, "locals_window", "", "Locals Window", "command_bars:open_only"
    AddDbg arr, "watch_window", "", "Watch Window", "command_bars:open_only"
    Set root = CreateObject("Scripting.Dictionary")
    Set root("commands") = arr
    root("note") = "Fixed catalog. Each entry carries executableVia: control_execution (a real control_execution mode), native_breakpoint, or command_bars:open_only (the entry only OPENS a debug window - no tool can READ its contents). Captions are localized (the Chinese IDE uses different labels)."
    ToolDebugCommands = JsonStringify(root)
End Function

Private Function ToolGenerateStub(ByVal name As String) As String
    ToolGenerateStub = StubGen.StubJson(name, CompText(name))
End Function

Private Function ToolDependencyGraph(Optional ByVal charQuota As Long = 0, Optional ByVal budgetMs As Long = 0) As String
    ' ALWAYS set it (0 clears): a previous call's quota must never leak into this one.
    DepGraph.DepSetQuotaOverride charQuota
    ' report the wall time of the whole build (the 179 s could not be
    ' attributed without it) and the total characters scanned, so a regression is
    ' visible in the receipt instead of as an unresponsive IDE.
    Dim t0 As Long
    t0 = GetTickCount()
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    Dim comp As VBIDE.VBComponent
    Dim cm As VBIDE.CodeModule
    Dim chars As Double
    DepGraph.DepReset
    DepGraph.DepBudgetStart budgetMs
    DepGraph.DepSetStage "collect"
    On Error Resume Next
    For Each comp In p.VBComponents
        MaybePump
        If Util.PumpAbortDue() Then
        ToolDependencyGraph = AbortReceiptFor("dependency_graph", Nothing)
        Exit Function
        End If
        If DepGraph.DepBudgetHit() Then Exit For
        Err.Clear
        Set cm = comp.CodeModule
        If Not cm Is Nothing Then
            If cm.CountOfLines > 0 Then
                Dim tx As String
                tx = cm.Lines(1, cm.CountOfLines)
                chars = chars + Len(tx)
                DepGraph.DepAdd comp.Name, tx
            End If
        End If
    Next
    On Error GoTo 0
    ' r4: tell the builder how many components the project REALLY has, so a
    ' cut in the collection loop above cannot make componentsTotal collapse to the
    ' number of components that happened to be collected.
    DepGraph.DepSetComponentsTotal p.VBComponents.Count
    Dim js As String
    js = DepGraph.DepGraphJson()
    ' additive: splice ms/chars straight after the opening brace
    ToolDependencyGraph = "{" & Chr$(34) & "ms" & Chr$(34) & ":" & CStr(GetTickCount() - t0) _
        & "," & Chr$(34) & "chars" & Chr$(34) & ":" & CStr(CLng(chars)) & "," & Mid$(js, 2)
End Function

Private Function ToolPurityCheck(ByVal name As String) As String
    DepGraph.DepReset
    DepGraph.DepBudgetStart 0
    DepGraph.DepAdd name, CompText(name)
    ToolPurityCheck = DepGraph.DepGraphJson()
End Function

' both public-API tools now run under the SAME wall-clock
' budget as dependency_graph. With `name` they scan exactly that component (the
' result is unchanged, plus additive cost fields). With NO name they used to be
' unbounded; now they walk the components under the budget and return
' per-component counts plus budgetExhausted/elapsedMs/stage.
' membersOnly=true is the light mode: only members[] is produced, which also skips
' the second CollectMembers parse that ApiExportJson/ApiSpecText pays for.
Private Function ToolExportPublicApi(ByVal name As String, ByVal membersOnly As Boolean) As String
    Dim t0 As Long
    t0 = Util.TickMs()
    Dim js As String
    If Len(name) > 0 Then
        If membersOnly Then
            js = ApiSig.ApiMembersJson(CompText(name))
        Else
            js = ApiSig.ApiExportJson(CompText(name))
        End If
        ToolExportPublicApi = "{" & Q2("component") & ":" & J2(name) _
            & "," & Q2("elapsedMs") & ":" & CStr(Util.TickMs() - t0) _
            & "," & Q2("budgetExhausted") & ":false" _
            & "," & Q2("membersOnly") & ":" & LCase$(CStr(membersOnly)) _
            & "," & Mid$(js, 2)
        Exit Function
    End If
    ToolExportPublicApi = ApiProjectJson(t0, membersOnly, "", False)
End Function

' One refusal shape for BOTH entry points (component and whole-project), so the receipt
' set never depends on whether a component name was supplied.
Private Function SpecBaselineUnusableJson(ByVal scope As String, ByVal component As String, _
        ByVal problem As String, ByVal badLine As Long, ByVal badText As String, ByVal lines As Long) As String
    Dim rb As Object
    Set rb = CreateObject("Scripting.Dictionary")
    rb("ok") = False
    rb("reason") = "baseline_unusable"
    rb("scope") = scope
    If Len(component) > 0 Then rb("component") = component
    rb("baselineProblem") = problem
    rb("baselineLines") = lines
    rb("badLine") = badLine
    rb("badLineText") = badText
    rb("acceptedBaselineFormat") = "one member per line: kind<TAB>name<TAB>signature (the 'spec' field export_public_api returns), newline separated; parameter names are not part of the spec"
    rb("hint") = "pass the spec field of export_public_api directly: this tool DECODES a spec that still carries literal \\n / \\t / \\r (the form a JSON string field has) and reports baselineNormalized:true. If the text is still refused, decode the field once yourself (JSON-decode) and pass the decoded text, which must be lines of kind<TAB>name signature."
    rb("detail") = "the baseline could not be parsed as a spec, so NO comparison was possible. Nothing was reported as removed or added, because that would be a guess rather than a comparison."
    rb("comparedAgainstBaseline") = False
    SpecBaselineUnusableJson = JsonStringify(rb)
End Function

Private Function ToolCheckPublicApi(ByVal name As String, ByVal baseline As String, ByVal membersOnly As Boolean) As String
    If Len(baseline) = 0 Then Err.Raise vbObjectError + 95, "CodeTools", "baseline spec is required"
    ' A spec returned as a JSON STRING FIELD carries literal \\n / \\t / \\r. Decode it before
    ' anything else and say so: feeding the escaped text back must not look like a wrong baseline.
    Dim baseUse As String, baseNorm As Boolean
    baseUse = ApiSig.ApiSpecNormalizeEscapes(baseline, baseNorm)
    Dim t0 As Long
    t0 = Util.TickMs()
    ' A baseline that is not spec text CANNOT be compared. Refusing is the only honest
    ' answer: this used to fall through to the light member path, so a deliberately wrong
    ' baseline came back with no violations, no added[] and no comparison at all.
    Dim badLine As Long, badText As String, specLines As Long, specProblem As String
    ' The whole-project entry point validates the SAME baseline inside ApiProjectJson, with
    ' scope="project": deciding it HERE for an empty name would label that refusal
    ' "component" and hide which entrance failed.
    If Len(name) > 0 Then
        specProblem = ApiSig.ApiSpecProblem(baseUse, badLine, badText, specLines)
        If Len(specProblem) > 0 Then
            ToolCheckPublicApi = SpecBaselineUnusableJson("component", name, specProblem, badLine, badText, specLines)
            Exit Function
        End If
    End If
    Dim js As String
    If Len(name) > 0 Then
        Dim diffJs As String, memJs As String
        ' ALWAYS compare when a component name is given. membersOnly only decides whether
        ' the member table is ADDED to the receipt.
        diffJs = ApiSig.ApiDiffSpecJson(baseUse, CompText(name))
        js = diffJs
        If membersOnly Then
            memJs = ApiSig.ApiMembersJson(CompText(name))
            js = "{" & Mid$(memJs, 2, Len(memJs) - 2) & "," & Mid$(diffJs, 2)
        End If
        ToolCheckPublicApi = "{" & Q2("component") & ":" & J2(name) _
            & "," & Q2("elapsedMs") & ":" & CStr(Util.TickMs() - t0) _
            & "," & Q2("budgetExhausted") & ":false" _
            & "," & Q2("membersOnly") & ":" & LCase$(CStr(membersOnly)) _
            & "," & Q2("comparedAgainstBaseline") & ":true" _
            & "," & Q2("baselineNormalized") & ":" & LCase$(CStr(baseNorm)) _
            & "," & Q2("baselineLines") & ":" & CStr(specLines) _
            & "," & Mid$(js, 2)
        Exit Function
    End If
    ToolCheckPublicApi = ApiProjectJson(t0, membersOnly, baseUse, True, baseNorm)
End Function

' the BOUNDED whole-project walk shared by both tools above. It never
' runs longer than the budget, and it always says how far it got (scanned vs
' componentCount) plus whether it stopped early.
Private Function ApiProjectJson(ByVal t0 As Long, ByVal membersOnly As Boolean, _
        ByVal baseline As String, ByVal isDiff As Boolean, Optional ByVal baselineNormalized As Boolean = False) As String
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    Dim budgetMs As Long, elapsed As Long, scanned As Long, total As Long
    Dim chars As Double
    Dim exhausted As Boolean
    budgetMs = Util.EnvLongOr("VB6MCP_BUDGET_MS", DepGraph.DEP_BUDGET_DEFAULT_MS)
    If budgetMs <= 0 Then budgetMs = DepGraph.DEP_BUDGET_DEFAULT_MS
    total = p.VBComponents.Count
    ' The SAME baseline contract applies when no name is given: a baseline that is not
    ' spec text cannot be compared, and every current member must not be reported as
    ' added merely because the baseline was unreadable.
    Dim blLine As Long, blText As String, blCount As Long, blProblem As String
    If isDiff Then
        blProblem = ApiSig.ApiSpecProblem(baseline, blLine, blText, blCount)
        If Len(blProblem) > 0 Then
            ApiProjectJson = SpecBaselineUnusableJson("project", "", blProblem, blLine, blText, blCount)
            Exit Function
        End If
    End If
    Dim body As String, entry As String, tx As String
    Dim first As Boolean
    Dim comp As VBIDE.VBComponent
    Dim cm As VBIDE.CodeModule
    Dim bC As Long, aC As Long, rm As Long, cg As Long, ad As Long
    body = ""
    first = True
    On Error Resume Next
    For Each comp In p.VBComponents
        MaybePump
        elapsed = GetTickCount() - t0
        If elapsed < 0 Then elapsed = 0
        If elapsed >= budgetMs Then
            exhausted = True
            Exit For
        End If
        Err.Clear
        Set cm = Nothing
        Set cm = comp.CodeModule
        tx = ""
        If Not cm Is Nothing Then
            If cm.CountOfLines > 0 Then tx = cm.Lines(1, cm.CountOfLines)
        End If
        chars = chars + Len(tx)
        If isDiff Then
            bC = 0
            aC = 0
            rm = 0
            cg = 0
            ad = 0
            entry = ApiSig.ApiDiffSpecCountsJson(baseline, tx, bC, aC, rm, cg, ad)
            entry = Q2("component") & ":" & J2(comp.Name) & "," & Q2("count") & ":" & CStr(aC) & "," & Q2("diff") & ":" & entry
        ElseIf membersOnly Then
            entry = ApiSig.ApiMembersJson(tx)
            ' Mid$(entry, 2, Len(entry) - 2) drops the object's BOTH braces: the wrapper
            ' below adds its own pair, and keeping the trailing one produced {{"..."}}
            ' (malformed JSON, caught by the small-project regression).
            entry = Q2("component") & ":" & J2(comp.Name) & "," & Mid$(entry, 2, Len(entry) - 2)
        Else
            entry = ApiSig.ApiExportJson(tx)
            entry = Q2("component") & ":" & J2(comp.Name) & "," & Mid$(entry, 2, Len(entry) - 2)
        End If
        If Not first Then body = body & ","
        first = False
        body = body & "{" & entry & "}"
        scanned = scanned + 1
    Next
    On Error GoTo 0
    elapsed = GetTickCount() - t0
    If elapsed < 0 Then elapsed = 0
    If scanned >= total Then exhausted = False
    ApiProjectJson = "{" & Q2("scope") & ":" & Q2("project") _
        & "," & Q2("components") & ":[" & body & "]" _
        & "," & Q2("scanned") & ":" & CStr(scanned) _
        & "," & Q2("componentCount") & ":" & CStr(total) _
        & "," & Q2("chars") & ":" & CStr(CLng(chars)) _
        & "," & Q2("membersOnly") & ":" & LCase$(CStr(membersOnly)) _
        & "," & Q2("comparedAgainstBaseline") & ":" & LCase$(CStr(isDiff)) _
        & "," & Q2("baselineNormalized") & ":" & LCase$(CStr(baselineNormalized)) _
        & "," & Q2("baselineLines") & ":" & CStr(blCount) _
        & "," & Q2("budgetExhausted") & ":" & LCase$(CStr(exhausted)) _
        & "," & Q2("budgetMs") & ":" & CStr(budgetMs) _
        & "," & Q2("elapsedMs") & ":" & CStr(elapsed) _
        & "," & Q2("stage") & ":" & Q2("project") & "}"
End Function

' minimal JSON string helpers for the two record builders above.
' PRIVATE, so nothing else in this module changes.
Private Function Q2(ByVal s As String) As String
    Q2 = Chr$(34) & s & Chr$(34)
End Function

Private Function J2(ByVal s As String) As String
    Dim t As String, b As String
    b = Chr$(92)
    t = Replace(s, b, b & b)
    t = Replace(t, Chr$(34), b & Chr$(34))
    t = Replace(t, vbCr, "")
    t = Replace(t, vbLf, " ")
    J2 = Chr$(34) & t & Chr$(34)
End Function

Private Function ToolExecutionState(ByVal pid As Long) As String
    If pid <= 0 Then pid = WinProbe.CurrentProcessId()
    ToolExecutionState = WinProbe.ExecutionStateJson(pid)
End Function

' helpers

' gamma-4: validate="strict" refuses the write when the PRE-WRITE lint found
' severity=error diagnostics; "off" skips lint; "warn" (default) keeps the A-batch
' behaviour. Returns "" when the write may proceed, otherwise the refusal JSON.
Private Function StrictRefusal(ByVal target As String, ByVal toolName As String, ByVal pack As Object, ByVal validateMode As String) As String
    StrictRefusal = ""
    If LCase$(Trim$(validateMode)) <> "strict" Then Exit Function
    If pack Is Nothing Then Exit Function
    Dim es As Long
    es = 0
    On Error Resume Next
    es = CLng(pack("lintSummary")("errors"))
    On Error GoTo 0
    If es <= 0 Then Exit Function
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = "lint_errors"
    d("component") = target
    d("tool") = toolName
    d("validate") = "strict"
    d("lintErrors") = es
    d("detail") = "validate:'strict' refused the write: the result has " & CStr(es) & " severity=error diagnostic(s). Nothing was written (IDE and file are unchanged)."
    CopyLintPack d, pack
    StrictRefusal = JsonStringify(d)
End Function

' ===========================================================================
' structured refusals for a bad ENUM argument and for a missing
' project file. Both are caller-input conditions, so both answer with the same
' verdict vocabulary the classifier uses (reason / argument / allowedValues
' / suggestedAction / sideEffects) instead of silently accepting the value.
' ===========================================================================
Private Function EnumArgRefusalJson(ByVal tool As String, ByVal argName As String, ByVal badValue As String, ByVal reason As String, ByVal allowed As Object) As String
    On Error Resume Next
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = reason
    d("tool") = tool
    d("argument") = argName
    d("value") = badValue
    Set d("allowedValues") = allowed
    Dim near As String
    near = NearMatchOf(badValue, allowed)
    If Len(near) > 0 Then d("nearMatch") = near
    Dim sug As String
    If reason = "required_argument_missing" Then
        d("message") = argName & " is required (expected " & JoinList(allowed, "/") & ")"
        sug = "supply the reported argument (see 'argument' / 'allowedValues') and retry"
    Else
        d("message") = "Invalid " & argName & ": " & badValue & " (expected " & JoinList(allowed, "/") & ")"
        sug = "use one of allowedValues and retry"
        If Len(near) > 0 Then sug = sug & " (did you mean '" & near & "'?)"
    End If
    d("suggestedAction") = sug
    d("sideEffects") = "none: the call was refused BEFORE any IDE access or write"
    EnumArgRefusalJson = JsonStringify(d)
End Function

' The nearest legal value at Levenshtein distance <= 2, or "" when nothing is close.
Private Function NearMatchOf(ByVal bad As String, ByVal allowed As Object) As String
    On Error Resume Next
    Dim v As Variant, best As String, bestD As Long, dd As Long
    best = ""
    bestD = 3
    For Each v In allowed
        dd = Levenshtein(LCase$(Trim$(bad)), LCase$(CStr(v)))
        If dd < bestD Then
            bestD = dd
            best = CStr(v)
        End If
    Next
    NearMatchOf = best
End Function

Private Function Levenshtein(ByVal a As String, ByVal b As String) As Long
    Dim la As Long, lb As Long, i As Long, j As Long, cost As Long
    la = Len(a)
    lb = Len(b)
    If la = 0 Then
        Levenshtein = lb
        Exit Function
    End If
    If lb = 0 Then
        Levenshtein = la
        Exit Function
    End If
    Dim prev() As Long, cur() As Long
    ReDim prev(0 To lb)
    ReDim cur(0 To lb)
    For j = 0 To lb
        prev(j) = j
    Next j
    For i = 1 To la
        cur(0) = i
        For j = 1 To lb
            cost = 1
            If Mid$(a, i, 1) = Mid$(b, j, 1) Then cost = 0
            cur(j) = prev(j) + 1
            If cur(j - 1) + 1 < cur(j) Then cur(j) = cur(j - 1) + 1
            If prev(j - 1) + cost < cur(j) Then cur(j) = prev(j - 1) + cost
        Next j
        For j = 0 To lb
            prev(j) = cur(j)
        Next j
    Next i
    Levenshtein = prev(lb)
End Function

Private Function JoinList(ByVal c As Object, ByVal sep As String) As String
    Dim v As Variant, s As String
    For Each v In c
        If Len(s) > 0 Then s = s & sep
        s = s & CStr(v)
    Next
    JoinList = s
End Function

' gamma-5/6/7: resolve one anchor (+ occurrence/match/scope) to a concrete IDE line.
' requireUnique keeps the A-batch semantics (an ambiguous anchor is refused) when the
' caller did not ask for a specific occurrence; giving occurrence:N allows repeats.
' convergence: the batch index is supplied by the caller (iRaw/iNorm/iFirst/
' iCnts, built ONCE per batch with VbAnchor.BuildNormIndex) so a unique anchor is answered
' in O(1) and matchedText comes off iRaw instead of a per-op TextLines. The candidate
' HitList - a whole-text split PLUS one CodeModule.ProcOfLine COM call per hit - is no
' longer built here: the caller builds it only when it has to REPORT a failure, so the
' success path of a batch makes ZERO ProcOfLine calls. With no index (caller passed
' nothing, e.g. the single-op edit_by_anchor path) the old exact linear scan is used, so
' those receipts cannot move.
Private Function ResolveAnchor(ByVal name As String, ByVal text As String, ByVal anchor As String, _
                               ByVal matchMode As String, ByVal scopeObj As Object, _
                               ByVal occurrence As Long, ByVal requireUnique As Boolean, _
                               ByRef lineOut As Long, ByRef matchedText As String, _
                               ByRef reason As String, ByRef hits() As Long, ByRef hitCount As Long, _
                               ByRef spanLines As Long, _
                               ByRef iRaw() As String, ByRef iNorm() As String, _
                               ByRef iFirst As Object, ByRef iCnts As Object, _
                               ByRef iRawFirst As Object, ByRef iRawCnts As Object) As Boolean
    ResolveAnchor = False
    lineOut = 0
    matchedText = ""
    reason = ""
    spanLines = 1
    Dim scopeStart As Long, scopeEnd As Long
    scopeStart = 0
    scopeEnd = 0
    If Not scopeObj Is Nothing Then
        scopeStart = JsonGetLong(scopeObj, "start_line", 0)
        scopeEnd = JsonGetLong(scopeObj, "end_line", 0)
        Dim sp As String
        sp = McpCls.DictStr(Me, scopeObj, "proc")
        If Len(sp) > 0 Then
            Dim cm As VBIDE.CodeModule
            On Error Resume Next
            Set cm = McpFindTools.FindComponent(Me, name).CodeModule
            On Error GoTo 0
            If cm Is Nothing Then
                reason = "scope_proc_not_found"
                Exit Function
            End If
            Dim ps As Long, pe As Long
            If Not McpCls.ProcRangeOf(Me, cm, sp, ps, pe) Then
                reason = "scope_proc_not_found"
                Exit Function
            End If
            scopeStart = ps
            scopeEnd = pe
        End If
    End If
    Dim cnt As Long
    ' a MULTI-LINE anchor matches a BLOCK - every anchor line
    ' consecutively - which is exactly what a caller who pasted three lines expected.
    ' A single-line anchor keeps the old path (index when the batch built one, else the
    ' linear scan), so those receipts cannot move.
    Dim blkN As Long
    blkN = 1
    If InStr(1, anchor, vbLf) > 0 Or InStr(1, anchor, vbCr) > 0 Then blkN = VbAnchor.AnchorLineCount(anchor)
    If blkN > 1 Then
        blkN = VbAnchor.FindBlockHitsEx(text, anchor, matchMode, scopeStart, scopeEnd, hits, cnt)
        If blkN < 1 Then blkN = 1
        spanLines = blkN
    Else
        If McpCls.LineUbound(Me, iNorm) >= 0 Then
            McpFindTools.FindHitsIdx Me, text, iRaw, iNorm, iFirst, iCnts, iRawFirst, iRawCnts, anchor, matchMode, scopeStart, scopeEnd, hits, cnt
        Else
            VbAnchor.FindHitsEx text, anchor, matchMode, scopeStart, scopeEnd, hits, cnt
        End If
    End If
    hitCount = cnt
    If cnt = 0 Then
        reason = "anchor_not_found"
        Exit Function
    End If
    Dim idx As Long
    If occurrence > 0 Then
        If occurrence > cnt Then
            reason = "anchor_not_found"
            Exit Function
        End If
        idx = occurrence - 1
    Else
        If requireUnique And cnt > 1 Then
            reason = "anchor_not_unique"
            Exit Function
        End If
        idx = 0
    End If
    lineOut = hits(idx)
    Dim mSrc() As String
    If McpCls.LineUbound(Me, iRaw) >= 0 Then
        mSrc = iRaw
    Else
        mSrc = McpCls.TextLines(Me, text)
    End If
    If lineOut >= 1 And lineOut <= UBound(mSrc) + 1 Then
        If spanLines > 1 Then
            ' the matched TEXT of a block anchor is the whole
            ' block, joined with vbCrLf - the receipt must show what it really matched.
            Dim bEnd As Long, bi As Long
            bEnd = lineOut + spanLines - 1
            If bEnd > UBound(mSrc) + 1 Then bEnd = UBound(mSrc) + 1
            matchedText = ""
            For bi = lineOut To bEnd
                If Len(matchedText) > 0 Then matchedText = matchedText & vbCrLf
                matchedText = matchedText & mSrc(bi - 1)
            Next bi
        Else
            matchedText = mSrc(lineOut - 1)
        End If
    End If
    ResolveAnchor = True
End Function

' UBound of a Split result, safely -1 for an empty array (same helper shape
' as EditTxn's, which is module-private there and therefore not reachable from here).

' hits for ONE anchor against the batch index. Byte-identical to
' VbAnchor.FindHitsEx (same order, same array shape, the same empty-pane convention), but
' O(1) when the anchor is UNIQUE and O(scope) when a scope is given. An ambiguous anchor
' still takes the exact linear scan, so its hit list and occurrence=k semantics cannot
' move. VbAnchor.CountLines is deliberately NOT used here: the index already knows the
' line count, and the old code called CountLines twice per op on the whole text.

' the raw-line index is built LAZILY - only a batch that uses
' match:"exact" pays for it.
Public Sub EnsureRawIndex(ByRef iRaw() As String, ByRef rawFirst As Object, ByRef rawCnts As Object)
    If Not (rawFirst Is Nothing) Then Exit Sub
    Set rawFirst = CreateObject("Scripting.Dictionary")
    Set rawCnts = CreateObject("Scripting.Dictionary")
    Dim i As Long, k As String
    For i = 0 To McpCls.LineUbound(Me, iRaw)
        MaybePump
        k = iRaw(i)
        If rawFirst.Exists(k) Then
            rawCnts(k) = CLng(rawCnts(k)) + 1
        Else
            rawFirst(k) = i + 1
            rawCnts(k) = 1
        End If
    Next
End Sub

Private Function ScopeObjOf(ByVal args As Object, ByVal key As String) As Object
    On Error Resume Next
    Set ScopeObjOf = Nothing
    Set ScopeObjOf = args(key)
End Function

' ================= delta tools (read-only) ======================

' delta-1: unsaved components in the IDE next to uncommitted files in git.
' READ-ONLY: it only reads the component model and runs read-only git subcommands.
Private Function ToolWorkspaceStatus(ByVal repoArg As String) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    Dim dirty As Object
    Set dirty = New Collection
    Dim prj As VBIDE.VBProject
    Dim openCount As Long
    openCount = 0
    On Error Resume Next
    Set prj = GetProject()
    On Error GoTo 0
    Dim i As Long
    If Not prj Is Nothing Then
        On Error Resume Next
        openCount = prj.VBComponents.Count
        On Error GoTo 0
        For i = 1 To openCount
            Dim comp As VBIDE.VBComponent
            On Error Resume Next
            Set comp = prj.VBComponents(i)
            On Error GoTo 0
            If Not comp Is Nothing Then
                Dim d As Object
                Set d = CreateObject("Scripting.Dictionary")
                d("name") = comp.Name
                d("file") = ComponentFileNameOf(comp)
                Dim dr As Boolean
                dr = False
                On Error Resume Next
                dr = comp.IsDirty
                On Error GoTo 0
                d("isDirty") = dr
                If dr Then dirty.Add d
            End If
        Next
    End If
    Set root("dirtyComponents") = dirty
    root("dirtyCount") = dirty.Count
    root("ideOpenComponents") = openCount
    root("readOnly") = True
    Dim repo As String
    repo = repoArg
    If Len(repo) = 0 Then repo = ActiveProjectDir()
    Dim git As Object
    Set git = CreateObject("Scripting.Dictionary")
    If Len(repo) = 0 Then
        git("available") = False
        git("note") = "no project is open in the IDE and no repo argument was given"
    Else
        repo = ResolvePath(repo)
        Dim st As String, ds As String, so As String
        st = ""
        ds = ""
        so = ""
        ' WScript.Shell.Exec only drains the pipe after the child exits, so a git
        ' status whose output exceeds the pipe buffer DEADLOCKS and looks like a
        ' timeout (measured). Redirect to a temp file and read the file instead.
        Dim tmpF As String
        tmpF = Environ$("TEMP") & "\vb6mcp_git_status.txt"
        On Error Resume Next
        st = ProjShip.RunCaptureJson("cmd.exe", "/c git -C " & Qq(repo) & " status --porcelain=v1 -b > " & Qq(tmpF) & " 2>&1", 60000)
        so = ""
        so = Build.ReadLogAnsi(tmpF)
        ds = ProjShip.RunCaptureJson("git.exe", "-C " & Qq(repo) & " --no-pager diff --stat", 30000)
        On Error GoTo 0
        git("repo") = repo
        git("available") = (Len(so) >= 0)
        git("branch") = BranchOfPorcelain(so)
        git("ahead") = CountTag(so, "ahead ")
        git("behind") = CountTag(so, "behind ")
        Dim fls As Object
        Set fls = ParsePorcelain(so)
        Set git("files") = fls
        git("fileCount") = fls.Count
        git("statusText") = so
        git("diffStat") = JsonUnescape(JsonFieldRaw(ds, "stdout"))
        git("exitCode") = CLng(Val("0" & JsonFieldRaw(st, "exitCode")))
        If Len(JsonFieldRaw(st, "error")) > 0 Then git("error") = JsonUnescape(JsonFieldRaw(st, "error"))
        If JsonFieldRaw(st, "timedOut") = "true" Then git("timedOut") = True
    End If
    Set root("git") = git
    ToolWorkspaceStatus = JsonStringify(root)
End Function

' delta-2: IDE-vs-disk + lint for a set of components, summary first and only the
' FAILING components in detail. READ-ONLY.
Private Function ToolVerifyScope(ByVal comps As Object, ByVal pathArg As String, ByVal baselineText As String, ByVal requireCompiler As Boolean) As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    ' segmented timing (enumerate / read / lint / compare / nested verify).
    Dim t0 As Long, tEnum As Long, tSeg As Long, tRead As Long, tLint As Long, tCmp As Long, tVer As Long
    t0 = GetTickCount()
    ' ---- contract v1.16.0: requireCompiler ----
    ' ONE project-level compiler verdict for the whole sweep: the compiler has no per-component
    ' mode and a compile speaks about the project. A refusal happens BEFORE anything is read,
    ' so lint can never stand in for the compiler; the counters stay mutually exclusive.
    Dim vcComp As Object
    Dim vcProbe As Object
    Dim vcWhy As String
    If requireCompiler Then
        If Not VcCompilerFetch(vcComp, vcProbe, vcWhy) Then
            If Len(vcWhy) = 0 Then vcWhy = "compiler_not_configured"
            ToolVerifyScope = VcCompilerRefusalJson("verify_scope", vcWhy, vcProbe)
            Exit Function
        End If
    End If
    Dim prj As VBIDE.VBProject
    On Error Resume Next
    Set prj = GetProject()
    On Error GoTo 0
    Dim names As Object
    Set names = New Collection
    Dim it As Variant
    If Not comps Is Nothing Then
        For Each it In comps
            MaybePump
            names.Add CStr(it)
        Next
    ElseIf Not prj Is Nothing Then
        Dim i As Long
        For i = 1 To prj.VBComponents.Count
            MaybePump
            names.Add prj.VBComponents(i).Name
        Next
    End If
    tEnum = GetTickCount()
    Dim passN As Long, failN As Long, checkedN As Long
    ' WP-22-04: components whose ONLY IDE-vs-disk difference is one VB6 ignores (identifier
    ' case / trailing whitespace / hidden Attribute lines). Counted separately (a SUBSET of
    ' pass) so "not a fail" is visible instead of silently inflating pass.
    Dim caseOnlyN As Long
    ' FIX-24 (F2): components that are IDENTICAL (diffKind none) are not case-only; they get their
    ' own additive counter so caseOnly keeps its documented meaning.
    Dim identicalN As Long
    ' COUNT SEMANTICS (contract v1.11.9): the three counters are MUTUALLY EXCLUSIVE - every
    ' checked component lands in exactly ONE of them:
    '   pass    = verify answered PASS;
    '   fail    = verify answered FAIL (a PROVEN inconsistency);
    '   unknown = any other verdict: the component could not be PROVEN either way (e.g. only
    '             the build evidence is missing).  UNKNOWN is NOT a fail.
    ' INVARIANT (every receipt): pass + fail + unknown == checked, failures[] holds proven
    ' inconsistencies only, unknowns[] holds the unknowns only, and NO component appears in
    ' both; countsConsistent publishes the check so a broken counter cannot pass unnoticed.
    Dim unknownN As Long
    Dim unknowns As Object
    Set unknowns = New Collection
    Dim fails As Object
    Set fails = New Collection
    Dim nm As Variant
    For Each nm In names
        MaybePump
        Dim cur As String, dp As String, pack As Object
        tSeg = GetTickCount()
        cur = CompText(CStr(nm))
        tRead = tRead + (GetTickCount() - tSeg)
        tSeg = GetTickCount()
        dp = DiskPathOf(CStr(nm), pathArg)
        ' the LOCAL whole-module lint (LintPack) cost ~1.1 s on the 27,000-line
        ' fixture, and the nested ToolVerify below lints the SAME text again - so the same
        ' module was linted TWICE. The nested verify is the authoritative verdict, so its
        ' lint counts are reused (same text, same engine, measured identical). This removes
        ' duplicate work, not a check.
        tLint = tLint + (GetTickCount() - tSeg)
        Dim ideEq As Boolean
        ideEq = False
        ' The scope verdict MUST be the same answer verify gives for this component: it is
        ' read back from the nested verify receipt below (the previous code ran a SECOND,
        ' different comparison here - DiskMatchesPane - and the two entry points could answer
        ' oppositely on the same component, which is exactly what was observed in the field).
        ' The scope verdict must agree with calling verify on each component, so run the
        ' authoritative per-component verify ONCE and reuse it for BOTH the verdict and the
        ' lint counts.: the previous code linted the same text twice (its own
        ' LintPack + the lint inside this verify); on the 27,000-line fixture that duplicate
        ' was ~1.1 s of verify_scope's time.
        Dim vo As String, overall As String
        vo = ""
        tSeg = GetTickCount()
        On Error Resume Next
        If requireCompiler Then
            vo = ToolVerify(CStr(nm), pathArg, baselineText, False, CLng(vcComp("buildState")), "compiler-isolated")
        Else
            vo = ToolVerify(CStr(nm), pathArg, baselineText, False)
        End If
        On Error GoTo 0
        tVer = tVer + (GetTickCount() - tSeg)
        overall = JsonUnescape(JsonFieldRaw(vo, "overall"))
        If Len(overall) = 0 Then overall = "UNKNOWN"
        ' ONE comparison, ONE verdict: take ideEqualsDisk from the same receipt.
        tSeg = GetTickCount()
        ideEq = (LCase$(Trim$(JsonUnescape(JsonFieldRaw(vo, "ideEqualsDisk")))) = "true")
        tCmp = tCmp + (GetTickCount() - tSeg)
        ' DiagnosticsJson emits "line" from m_diag(i).physLine - exactly what DiagLine
        ' returned as "editLine" - so these values equal the old FirstDiagText(pack) output.
        Dim lerr As String, lwarn As String, rid As String, rln As String, rmsg As String
        lerr = JsonFieldRaw(vo, "lintErrors")
        lwarn = JsonFieldRaw(vo, "lintWarnings")
        rid = JsonUnescape(JsonFieldRaw(vo, "ruleId"))
        rln = JsonFieldRaw(vo, "line")
        rmsg = JsonUnescape(JsonFieldRaw(vo, "message"))
        Dim lintErrN As Long, lintWarnN As Long, firstDiag As String
        lintErrN = 0
        If IsNumeric(lerr) Then lintErrN = CLng(Val(lerr))
        lintWarnN = 0
        If IsNumeric(lwarn) Then lintWarnN = CLng(Val(lwarn))
        firstDiag = ""
        If Len(rid) > 0 Then firstDiag = rid & " @line " & rln & ": " & rmsg
        ' The key ORDER of the detail object is unchanged from before.
        Dim d As Object
        Set d = CreateObject("Scripting.Dictionary")
        d("component") = CStr(nm)
        d("file") = dp
        d("ideEqualsDisk") = ideEq
        d("lintErrors") = lintErrN
        d("lintWarnings") = lintWarnN
        d("firstDiagnostic") = firstDiag
        d("verifyOverall") = overall
        checkedN = checkedN + 1
        ' W-D (P11): a scope FAIL means ONE thing only - the IDE text and the disk file are
        ' PROVEN different. Lint findings are reported per component (lintErrors) and counted
        ' separately (lintOnly); they never turn into a fail here.
        ' WP-22-04: a PROVEN diff means a REAL one. Verify.bas classifies every differing line
        ' and publishes foldableOnly / diffKind / realDiffLines; a difference that folds away
        ' (identifier CASE, trailing whitespace, hidden Attribute lines) is NOT a proven
        ' inconsistency - VB6 compares identifiers case-insensitively. Measured MCP-1022-49:
        ' 8 of 10 freshly reloaded components were fail/ide_disk_diff_proven while every
        ' differing line was the same identifier in a different case.
        Dim foldable As Boolean
        Dim diffK As String
        Dim realDiffN As Long
        foldable = (LCase$(Trim$(JsonUnescape(JsonFieldRaw(vo, "foldableOnly")))) = "true")
        diffK = JsonUnescape(JsonFieldRaw(vo, "diffKind"))
        realDiffN = 0
        If IsNumeric(JsonFieldRaw(vo, "realDiffLines")) Then realDiffN = CLng(Val(JsonFieldRaw(vo, "realDiffLines")))
        d("diffKind") = diffK
        d("caseOnlyLines") = JsonFieldRaw(vo, "caseOnlyLines")
        d("whitespaceOnlyLines") = JsonFieldRaw(vo, "whitespaceOnlyLines")
        d("realDiffLines") = realDiffN
        d("foldableOnly") = foldable
        Dim provenDiff As Boolean
        provenDiff = False
        If Not ideEq Then provenDiff = True
        Dim vd As String
        vd = JsonUnescape(JsonFieldRaw(vo, "ideDisk"))
        If (vd = "MISMATCH" Or vd = "NOT-SYNCED" Or vd = "READ-FAIL") And (Not foldable) Then provenDiff = True
        ' FIX-27 (R4.8) / FIX-28: a component whose recorded build compiled the PANE while the DISK
        ' differed has NO verdict about the disk source. That is UNPROVEN, not proven bad: it goes
        ' to unknowns[] (with the basis), NEVER to failures[] - fail is reserved for a PROVEN source
        ' inconsistency. FIX-27 put it in failures[] and the build cache is a PROJECT-level record,
        ' so one pane-only build turned EVERY component red - including the ones with
        ' diffKind:"none"/realDiffLines:0 - which is exactly the false red this batch exists to
        ' remove. The counter identity pass+fail+unknown==checked stays exact (one bucket only).
        Dim vBuildFrom As String
        Dim vBuildSrc As String
        vBuildFrom = JsonUnescape(JsonFieldRaw(vo, "buildCompiledFrom"))
        vBuildSrc = JsonUnescape(JsonFieldRaw(vo, "buildSource"))
        If (LCase$(vBuildFrom) = "pane") And (vBuildSrc = "cache-pane-disk-mismatch") Then
            d("failBasis") = "build_from_pane"
            d("bucket") = "unknown"
            d("reason") = "build_from_pane"
            d("buildCompiledFrom") = vBuildFrom
            d("buildSource") = vBuildSrc
            d("retrySuggested") = True
            d("buildFromPaneNote") = "the recorded build compiled the IDE PANE while the DISK differed, so this component has no verdict about the disk source; save the project and rebuild"
            unknownN = unknownN + 1
            unknowns.Add d
        ElseIf provenDiff Then
            ' MCP-1022-49 (c): a component that was JUST reloaded can answer with its OLD text on
            ' the first read (measured on LSSScoreType). Read back ONCE and re-verify: the retry
            ' is the same comparison on fresh text, never a weakened one.
            Dim pane2 As String
            Dim retryVo As String
            Dim retryVd As String
            Dim retryProven As Boolean
            pane2 = CompText(CStr(nm))
            retryVo = ""
            On Error Resume Next
            If requireCompiler Then
                retryVo = ToolVerify(CStr(nm), pathArg, baselineText, False, CLng(vcComp("buildState")), "compiler-isolated")
            Else
                retryVo = ToolVerify(CStr(nm), pathArg, baselineText, False)
            End If
            On Error GoTo 0
            retryProven = True
            If LCase$(Trim$(JsonUnescape(JsonFieldRaw(retryVo, "ideEqualsDisk")))) = "true" Then retryProven = False
            retryVd = JsonUnescape(JsonFieldRaw(retryVo, "ideDisk"))
            If retryVd = "OK" Then retryProven = False
            If LCase$(Trim$(JsonUnescape(JsonFieldRaw(retryVo, "foldableOnly")))) = "true" Then retryProven = False
            d("readBackRetried") = True
            If Not retryProven Then
                ' the SECOND read agrees with the disk: the first read was the stale one
                d("failBasis") = "none"
                d("settledAfterRetry") = True
                d("bucket") = "pass"
                passN = passN + 1
            ElseIf pane2 <> cur Then
                ' the PANE TEXT itself moved between two reads: that is NOT a file mismatch
                d("failBasis") = "pane_not_settled"
                d("reason") = "pane_not_settled"
                d("retrySuggested") = True
                d("bucket") = "unknown"
                unknownN = unknownN + 1
                unknowns.Add d
            Else
                d("failBasis") = "ide_disk_diff_proven"
                d("bucket") = "fail"
                failN = failN + 1
                fails.Add d
            End If
        ElseIf overall = "FAIL" Or overall = "UNKNOWN" Then
            d("failBasis") = "none"
            d("bucket") = "unknown"
            unknownN = unknownN + 1
            unknowns.Add d
        Else
            ' WP-22-04 BUG FIX: this branch is a PASSING component. It used to add to
            ' unknownN/unknowns[] as well, which is why pass was permanently 0 while unknown
            ' absorbed every pass and pass+fail+unknown still looked consistent.
            d("failBasis") = "none"
            d("bucket") = "pass"
            passN = passN + 1
        End If
        ' FIX-24 (F2): caseOnly answers how many components differ ONLY in a way VB6 folds away.
        ' A component whose diffKind is none is IDENTICAL, and counting it made 5 clean components
        ' report caseOnly:5 (measured) - the opposite of the field meaning. Only the foldable
        ' DIFFERENCE kinds count; identical gets its own additive counter.
        If diffK = "none" Then identicalN = identicalN + 1
        If foldable And FoldableDiffKind(diffK) Then caseOnlyN = caseOnlyN + 1
    Next
    root("checked") = checkedN
    root("pass") = passN
    root("fail") = failN
    root("unknown") = unknownN
    ' the receipt proves its own arithmetic: pass + fail + unknown == checked.
    root("countsConsistent") = (checkedN = (passN + failN + unknownN))
    ' WP-22-04: the foldable bucket is NOT a fourth counter - it is a SUBSET of pass.
    root("caseOnly") = caseOnlyN
    root("caseOnlyMeaning") = "components whose ONLY IDE-vs-disk difference folds away (identifier case / trailing whitespace / hidden Attribute lines) AND whose diffKind is a foldable difference kind. An IDENTICAL component (diffKind none) is NOT counted here - see identical. They are counted in pass, never in fail"
    root("identical") = identicalN
    root("identicalMeaning") = "components whose IDE text EQUALS the disk text (diffKind none). Additive counter, a SUBSET of pass, deliberately excluded from caseOnly (FIX-24 F2)"
    Set root("unknowns") = unknowns
    root("totalMs") = GetTickCount() - t0
    root("enumerateMs") = tEnum - t0
    root("readCompTextMs") = tRead
    root("lintMs") = tLint
    root("compareMs") = tCmp
    root("verifyMs") = tVer
    Set root("failures") = fails
    root("readOnly") = True
    root("note") = "read-only sweep: each component is compared IDE-vs-disk and linted; only failing components are listed in detail"
    If requireCompiler Then
        root("requireCompiler") = True
        root("authority") = "compiler"
        Set root("compiler") = vcComp
        root("compilerScope") = "project: ONE isolated VB6.EXE /make over a COPY of the project's DISK files; every component verdict in this sweep is corroborated by that single compiler verdict (the compiler has no per-component mode)"
        root("compilerNote") = "the compiler compiled the files ON DISK; unsaved pane edits are NOT in that copy"
    End If
    ToolVerifyScope = ReceiptJson(root)
End Function

' delta-3: machine-readable todo list from the process bus + git. READ-ONLY.
Private Function ToolTodoStatus() As String
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    Dim base As String
    base = McpFindTools.FindBusRoot(Me)
    If Len(base) = 0 Then base = McpProjTools.ProjectDir(Me)
    If Len(base) = 0 Then base = App.Path
    Dim tasks As Object, reps As Object
    Set tasks = New Collection
    Set reps = New Collection
    Dim tdir As String
    tdir = Environ$("VB6MCP_TASKS_DIR")
    If Len(tdir) > 0 And Right$(tdir, 1) = "\" Then tdir = Left$(tdir, Len(tdir) - 1)
    If Len(tdir) > 0 Then
        CollectMd tdir & "\tasks", tasks
        CollectMd tdir & "\reports", reps
    Else
        CollectMd base & "\\tasks\P1", tasks
        CollectMd base & "\\reports\P1", reps
    End If
    Dim openN As Long, i As Long
    openN = 0
    For i = 1 To tasks.Count
        MaybePump
        Dim st As String
        st = LCase$(CStr(tasks(i)("status")))
        If st <> "done" And st <> "verified" Then openN = openN + 1
    Next
    root("taskCount") = tasks.Count
    root("openTasks") = openN
    Set root("tasks") = tasks
    root("reportCount") = reps.Count
    Set root("reports") = reps
    root("readOnly") = True
    root("note") = "read-only: Markdown files under the task folder's tasks/ and reports/ subfolders are scanned for status + title; the task folder is auto-discovered from the project tree, or set VB6MCP_TASKS_DIR to point at it explicitly"
    ToolTodoStatus = JsonStringify(root)
End Function

' ---------------------------------------------------------------------------
' contract v1.3.0 mechanism 3: machine-readable version identity. READ-ONLY.
' build.sha256 is read from the DLL on disk at call time; breaking[] is the
' machine-readable twin of the initialize.instructions BREAKING block.
' ---------------------------------------------------------------------------
' =====================================================================
' contract v1.6.0 
'   replace_in_files - cross-component literal/regex replace over the OPEN project
'   undo_edit        - explicit single-step restore of a component's PANE text
' =====================================================================

' The undo store lives next to the project (<project>\_undo), gated by the SAME switch
' as every other project-directory write (ProjectDirWritesKilled): with
' VB6MCP_ALLOW_PROJECTDIR_WRITES=0 no snapshot is written and undo_edit reports none.
' Snapshot files are UTF-8 (binary Put/Get through Utf8.bas), so non-ASCII code survives.
Private Function UndoDir() As String
    Dim d As String
    d = McpProjTools.ProjectDir(Me)
    If Len(d) = 0 Then Exit Function
    UndoDir = CtlJoinPath(d, "_undo")
End Function

Private Function UndoStamp() As String
    UndoStamp = Format$(Now, "yyyymmdd-hhnnss") & "-" & Format$(GetTickCount() And &HFFFF&, "00000")
End Function

Private Function SafeFileStem(ByVal s As String) As String
    Dim i As Long, ch As String, r As String
    r = ""
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If (ch >= "0" And ch <= "9") Or (ch >= "A" And ch <= "Z") Or (ch >= "a" And ch <= "z") Or ch = "_" Or ch = "-" Then
            r = r & ch
        Else
            r = r & "_"
        End If
    Next
    SafeFileStem = r
End Function

Public Sub WriteTextUtf8File(ByVal path As String, ByVal text As String)
    On Error Resume Next
    Dim f As Integer
    f = FreeFile
    Open path For Binary As #f
    If Len(text) > 0 Then
        Dim b() As Byte
        b = Utf8.Utf8Encode(text)
        Put #f, , b
    End If
    Close #f
    Err.Clear
End Sub

Public Function ReadTextUtf8File(ByVal path As String, ByRef ok As Boolean) As String
    On Error Resume Next
    ok = False
    Dim f As Integer, n As Long
    f = FreeFile
    Open path For Binary As #f
    n = LOF(f)
    If n > 0 Then
        Dim b() As Byte
        ReDim b(0 To n - 1)
        Get #f, , b
        ReadTextUtf8File = Utf8.Utf8DecodeBytes(b)
    End If
    Close #f
    If Err.Number = 0 Then ok = True
    Err.Clear
End Function

' read the opt-in "snapshot" argument. The declared JSON type is boolean, but
' the card / FAQ both speak of snapshot=on, and JsonGetBool only accepts true/1 - so this
' reads the RAW value and treats true / 1 / on / yes (case-insensitive) as ON. Anything
' else - including an absent key - is OFF, which is what keeps the default zero-cost.
Private Function SnapshotOptIn(ByVal args As Object) As Boolean
    SnapshotOptIn = False
    If args Is Nothing Then Exit Function
    On Error Resume Next
    If Not args.Exists("snapshot") Then Exit Function
    Dim v As Variant
    v = args("snapshot")
    If IsNull(v) Then Exit Function
    If VarType(v) = vbBoolean Then
        SnapshotOptIn = CBool(v)
        Err.Clear
        Exit Function
    End If
    Dim s As String
    s = LCase$(Trim$(CStr(v)))
    SnapshotOptIn = (s = "true" Or s = "1" Or s = "on" Or s = "yes")
    Err.Clear
End Function

' (P8): called by the single text-write funnel just before the pane changes.
' Never fatal - a failed snapshot must not break the edit, and undo_edit simply reports
' that no snapshot exists.
Private Sub UndoSnapshot(ByVal compName As String, ByVal before As String)
    On Error Resume Next
    If Len(compName) = 0 Then Exit Sub
    If McpProjTools.ProjectDirWritesKilled(Me) Then Exit Sub
    Dim d As String
    d = UndoDir()
    If Len(d) = 0 Then Exit Sub
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If fso Is Nothing Then Exit Sub
    If Not fso.FolderExists(d) Then fso.CreateFolder d
    ' capture the path and record it in THIS call's project-directory write
    ' manifest, so the receipt can enumerate it (write failures stay silent by design, and
    ' a snapshot that did not land is NOT reported).
    Dim snapPath As String
    snapPath = CtlJoinPath(d, SafeFileStem(compName) & "." & UndoStamp() & ".txt")
    WriteTextUtf8File snapPath, before
    If CtlFileExists(snapPath) Then
        ManifestAdd m_dirWrites, snapPath
        ' item 6: the same path, also recorded for the sideEffects block.
        SeAdd m_seUndo, snapPath
    End If
    Err.Clear
End Sub

' CompText itself can raise on a 0-line component (two zero-line rulings); both new tools
' must treat "no text" as "no hits", never as a failure.
Private Function SafeCompText(ByVal name As String) As String
    On Error Resume Next
    SafeCompText = CompText(name)
    Err.Clear
End Function

Private Function CountOccur(ByVal hay As String, ByVal needle As String) As Long
    If Len(needle) = 0 Then Exit Function
    Dim n As Long, p As Long
    n = 0
    p = 1
    Do
        p = InStr(p, hay, needle, vbBinaryCompare)
        If p = 0 Then Exit Do
        n = n + 1
        p = p + Len(needle)
    Loop
    CountOccur = n
End Function

' CR 归一化（窗格文本没有行尾 CRLF，磁盘文件有）——等价 oracle 必须先归一化。
Private Function CrNorm(ByVal s As String) As String
    Dim t As String
    t = Replace(s, vbCrLf, vbLf)
    t = Replace(t, vbCr, vbLf)
    CrNorm = t
End Function

Private Function NormPathKey(ByVal p As String, ByVal fso As Object) As String
    Dim s As String
    s = Trim$(p)
    If Len(s) = 0 Then Exit Function
    On Error Resume Next
    If fso.FolderExists(s) Then s = fso.GetFolder(s).Path
    If fso.FileExists(s) Then s = fso.GetFile(s).Path
    Err.Clear
    Do While Len(s) > 3
        If Right$(s, 1) = "\" Then s = Left$(s, Len(s) - 1) Else Exit Do
    Loop
    NormPathKey = s
End Function

' expected_shas[] entry lookup: the caller may name a component OR its file path.
Private Function ExpectedShaFor(ByVal arr As Object, ByVal compName As String, ByVal filePath As String) As String
    On Error Resume Next
    ExpectedShaFor = ""
    If arr Is Nothing Then Exit Function
    Dim i As Long, e As Object, key As String
    For i = 1 To arr.Count
        Set e = arr.Item(i)
        If Not e Is Nothing Then
            key = ""
            key = CStr(e("file"))
            If Len(key) > 0 Then
                If StrComp(key, compName, vbTextCompare) = 0 Then
                    ExpectedShaFor = LCase$(CStr(e("sha256")))
                    Exit Function
                End If
                If Len(filePath) > 0 Then
                    If StrComp(key, filePath, vbTextCompare) = 0 Then
                        ExpectedShaFor = LCase$(CStr(e("sha256")))
                        Exit Function
                    End If
                End If
            End If
        End If
    Next
End Function

Private Function LintCountOf(ByVal pack As Object, ByVal key As String) As Long
    On Error Resume Next
    LintCountOf = 0
    If pack Is Nothing Then Exit Function
    Dim v As Variant
    v = pack(key)
    If IsNumeric(v) Then LintCountOf = CLng(v)
End Function

' ---------------------------------------------------------------------
' P7: replace_in_files
' ---------------------------------------------------------------------
Private Function ToolReplaceInFiles(ByVal path As String, ByVal query As String, ByVal replacement As String, _
        ByVal useRegex As Boolean, ByVal dryRun As Boolean, ByVal expectedShas As Object, _
        ByVal validateMode As String, ByVal maxFiles As Long) As String
    Dim tEntry As Long
    tEntry = GetTickCount()
    Dim proj As VBIDE.VBProject
    Set proj = GetProject()
    If proj Is Nothing Then
        Err.Raise vbObjectError + 120, "CodeTools", "MCPREASON:no_project|open a project first|there is no active project to replace in; nothing was written"
    End If
    If Len(Trim$(query)) = 0 Then
        Err.Raise vbObjectError + 121, "CodeTools", "MCPREASON:empty_query|pass a non-empty query|an empty query matches every position; nothing was written"
    End If
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Dim pf As String
    pf = ""
    On Error Resume Next
    pf = proj.FileName
    Err.Clear
    On Error GoTo 0
    ' path (when given) must name THIS project: the tool never writes a project the
    ' add-in is not attached to, so "only ever a copy" is enforced, not just advised.
    If Len(Trim$(path)) > 0 Then
        Dim want As String, okPath As Boolean
        want = NormPathKey(path, fso)
        okPath = False
        If Len(pf) > 0 Then
            If StrComp(want, NormPathKey(pf, fso), vbTextCompare) = 0 Then okPath = True
            If StrComp(want, NormPathKey(fso.GetParentFolderName(pf), fso), vbTextCompare) = 0 Then okPath = True
        End If
        If Not okPath Then
            Err.Raise vbObjectError + 122, "CodeTools", "MCPREASON:not_the_open_project|pass the open project's .vbp or its directory|replace_in_files only rewrites the project this add-in is attached to (" & pf & "); nothing was written"
        End If
    End If
    If maxFiles <= 0 Then maxFiles = 200
    If maxFiles > 1000 Then maxFiles = 1000
    Dim re As Object
    If useRegex Then
        On Error Resume Next
        Set re = CreateObject("VBScript.RegExp")
        re.Global = True
        re.IgnoreCase = False
        re.Pattern = query
        If Err.Number <> 0 Then
            Dim em As String
            em = Err.Description
            Err.Clear
            On Error GoTo 0
            Err.Raise vbObjectError + 123, "CodeTools", "MCPREASON:bad_regex|fix the pattern|the regex engine rejected the pattern: " & em & "; nothing was written"
        End If
        On Error GoTo 0
    End If
    Dim files As Object, applied As Object, appliedText As Object
    Set files = New Collection
    Set applied = New Collection
    Set appliedText = CreateObject("Scripting.Dictionary")
    Dim scanned As Long, changedFiles As Long, totalHits As Long, wouldChange As Long
    Dim stopped As Boolean, rolledBack As Boolean, stoppedAt As String, note As String
    Dim c As VBIDE.VBComponent
    For Each c In proj.VBComponents
        If scanned >= maxFiles Then
            note = "max_files cap reached (" & CStr(maxFiles) & "); the rest was NOT scanned"
            Exit For
        End If
        scanned = scanned + 1
        MaybePump
        Dim nm As String, fp As String, txt As String
        nm = c.Name
        fp = ComponentFileNameOf(c)
        Dim entry As Object
        Set entry = CreateObject("Scripting.Dictionary")
        entry("comp") = nm
        If Len(fp) > 0 Then entry("file") = fp
        entry("hits") = 0
        entry("changed") = False
        entry("skipped") = False
        entry("shaBefore") = ""
        entry("shaAfter") = ""
        txt = SafeCompText(nm)
        Dim cnt As Long, nt As String, firstHitLine As Long
        cnt = 0
        nt = ""
        firstHitLine = 0
        If Len(txt) > 0 Then
            If useRegex Then
                If re.Test(txt) Then
                    Dim ms As Object
                    Set ms = re.Execute(txt)
                    cnt = ms.Count
                    nt = re.Replace(txt, replacement)
                    Dim idx As Long
                    idx = ms.Item(0).FirstIndex
                    firstHitLine = CountOccur(Left$(txt, idx), vbCrLf) + 1
                End If
            Else
                cnt = CountOccur(txt, query)
                If cnt > 0 Then
                    nt = Replace(txt, query, replacement)
                    firstHitLine = CountOccur(Left$(txt, InStr(1, txt, query, vbBinaryCompare) - 1), vbCrLf) + 1
                End If
            End If
        End If
        If cnt = 0 Then
            files.Add entry
        Else
            totalHits = totalHits + cnt
            entry("hits") = cnt
            entry("firstHitLine") = firstHitLine
            entry("shaBefore") = Sha256.Sha256HexTextUtf8(txt)
            entry("shaAfter") = Sha256.Sha256HexTextUtf8(nt)
            Dim wantSha As String
            wantSha = ExpectedShaFor(expectedShas, nm, fp)
            If Len(wantSha) > 0 Then
                If StrComp(wantSha, CStr(entry("shaBefore")), vbTextCompare) <> 0 Then
                    entry("skipped") = True
                    entry("reason") = "expected_sha_mismatch"
                    entry("expectedSha256") = wantSha
                    files.Add entry
                    GoTo NextComp
                End If
            End If
            ' validate gate: same helper the other write tools use. strict => refuse to
            ' write that component (a real failure => stop + roll back).
            Dim pack As Object, sref As String
            Set pack = LintPackForEdit(nt, KindOfName(nm), LineCount(txt), firstHitLine)
            entry("lintErrors") = LintCountOf(pack, "lintErrors")
            entry("lintWarnings") = LintCountOf(pack, "lintWarnings")
            sref = StrictRefusal(nm, "replace_in_files", pack, validateMode)
            If Len(sref) > 0 Then
                entry("skipped") = True
                entry("reason") = "validate_strict_failed"
                If dryRun Then
                    files.Add entry
                    GoTo NextComp
                End If
                files.Add entry
                stopped = True
                stoppedAt = nm
                Exit For
            End If
            If dryRun Then
                wouldChange = wouldChange + 1
                files.Add entry
                GoTo NextComp
            End If
            ' APPLY: one minimal text transaction per component (per-component atomic)
            Dim wrote As Long
            wrote = SetCompTextMinimal(nm, txt, nt)
            If wrote <= 0 Then
                entry("reason") = "write_failed"
                files.Add entry
                stopped = True
                stoppedAt = nm
                Exit For
            End If
            Dim back As String
            back = SafeCompText(nm)
            If StrComp(CrNorm(back), CrNorm(nt), vbBinaryCompare) <> 0 Then
                entry("reason") = "pane_verify_failed"
                entry("shaAfter") = Sha256.Sha256HexTextUtf8(back)
                files.Add entry
                stopped = True
                stoppedAt = nm
                Exit For
            End If
            entry("changed") = True
            entry("shaAfter") = Sha256.Sha256HexTextUtf8(back)
            ' R-1021-01: the pane read-back IS verified; the bytes are the UTF-8 bytes
            ' of that pane text. verifiedOnDisk stays false at the top level.
            entry("sha256") = entry("shaAfter")
            entry("paneTextSha256") = entry("shaAfter")
            Dim backUtf8() As Byte
            backUtf8 = Utf8Encode(back)
            entry("bytes") = Encoding.ByteCount(backUtf8)
            entry("paneBytes") = entry("bytes")
            entry("bytesUnit") = "utf-8-bytes-of-pane-text"
            entry("writeCalls") = wrote
            entry("hunks") = m_lastWriteHunks
            changedFiles = changedFiles + 1
            applied.Add nm
            appliedText(nm) = txt
            files.Add entry
        End If
NextComp:
    Next c
    ' ---- honest failure semantics: stop + roll the applied components back ----
    If stopped Then
        rolledBack = True
        Dim ai As Long
        For ai = 1 To applied.Count
            Dim an As String, curTxt As String
            an = CStr(applied.Item(ai))
            curTxt = SafeCompText(an)
            If SetCompTextMinimal(an, curTxt, CStr(appliedText(an))) <= 0 Then rolledBack = False
            MaybePump
        Next
        If rolledBack Then changedFiles = 0
    End If
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = Not stopped
    ' one snapshot per written component is enumerated here as well.
    Dim pdwR As Object
    Set pdwR = New Collection
    ManifestMergeUndo pdwR
    Set d("projectDirWrites") = pdwR
    If stopped Then
        d("reason") = "write_stopped"
        d("advice") = "the receipt's summary says exactly what was applied and whether the rollback completed; nothing is claimed to be atomic across components"
    End If
    d("dryRun") = dryRun
    d("regex") = useRegex
    Set d("files") = files
    Dim s As Object
    Set s = CreateObject("Scripting.Dictionary")
    s("files") = scanned
    s("filesChanged") = changedFiles
    s("wouldChange") = wouldChange
    s("totalHits") = totalHits
    Dim ap As Object
    Set ap = New Collection
    For ai = 1 To applied.Count
        ap.Add CStr(applied.Item(ai))
    Next
    Set s("applied") = ap
    If stopped Then
        s("stoppedAt") = stoppedAt
        s("rolledBack") = rolledBack
        If Not rolledBack Then
            s("note") = "STOPPED on " & stoppedAt & "; the rollback could NOT be completed - the applied set above is exactly what remains"
        End If
    End If
    If Len(note) > 0 Then
        If s.Exists("note") Then s("note") = s("note") & " | " & note Else s("note") = note
    End If
    Set d("summary") = s
    ' R-1021-01: this tool rewrites the IDE's in-memory code PANES; the disk is not
    ' touched by this call, so verifiedOnDisk:true would be a lie. The pane
    ' read-back is what IS verified, and the disk note says when the disk changes.
    d("verifiedOnDisk") = False
    d("verifiedInIdePane") = True
    d("writeTarget") = "ide-code-pane"
    d("diskNote") = "the disk changes only when save_project runs or the IDE auto-saves; verifiedOnDisk is false ON PURPOSE - a pane write is not a disk write"
    d("totalMs") = GetTickCount() - tEntry
    ToolReplaceInFiles = ReceiptJson(d)
End Function

' ---------------------------------------------------------------------
' P8: undo_edit
' ---------------------------------------------------------------------
' the one sentence that turns "no snapshot" into an actionable next call.
Private Function NoSnapshotHint() As String
    NoSnapshotHint = "pass snapshot=true (""on""/""yes""/1 also accepted) to replace_code / apply_edits / edit_by_anchor to write a pre-edit pane snapshot; then undo_edit can restore it. set, apply_edits and edit_by_anchor already snapshot by default; replace_code's replace/insert/append/delete do NOT unless snapshot=true"
End Function

Private Function ToolUndoEdit(ByVal component As String, ByVal action As String, ByVal ts As String, ByVal toDisk As Boolean) As String
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = True
    d("action") = action
    ' the manifest is the SAME Collection object for the whole call, so the
    ' snapshot written later by the restore path is visible when the receipt is serialised.
    Set d("projectDirWrites") = m_dirWrites
    If toDisk Then
        d("ok") = False
        d("reason") = "to_disk_not_supported"
        d("component") = component
        d("ts") = ts
        d("diskUntouched") = True
        d("advice") = "undo_edit restores the component's PANE text only; call save_project to flush the whole project to disk"
        ToolUndoEdit = JsonStringify(d)
        Exit Function
    End If
    Dim dir As String
    dir = UndoDir()
    d("undoDir") = dir
    If Len(dir) = 0 Then
        d("ok") = False
        d("reason") = "no_project_dir"
        d("advice") = "save the project first (save_project with a path); the undo store lives next to the project"
        ToolUndoEdit = JsonStringify(d)
        Exit Function
    End If
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(dir) Then
        d("ok") = False
        ' when the caller NAMED a component, the reason says so and points at the
        ' opt-in that creates one; the generic (no component) case keeps the old reason.
        If Len(component) > 0 Then
            d("reason") = "no_snapshot_for_component"
            d("component") = component
            d("hint") = NoSnapshotHint()
        Else
            d("reason") = "no_snapshot"
        End If
        ' found live - assigning an object to a Dictionary item without Set
        ' raises VB error 450, so the "no snapshot store yet" path returned unexpected_error
        ' instead of the intended structured {ok:false, reason:"no_snapshot"}.
        Set d("snapshots") = New Collection
        d("advice") = "no snapshot exists yet: snapshots are written before every component text write (and are disabled while VB6MCP_ALLOW_PROJECTDIR_WRITES=0)"
        ToolUndoEdit = JsonStringify(d)
        Exit Function
    End If
    ' collect all snapshots (newest ts LAST: the filename sorts by yyyymmdd-hhnnss-ttttt)
    Dim snaps As Object
    Set snaps = New Collection
    Dim f As Object
    For Each f In fso.GetFolder(dir).Files
        Dim leaf As String, p1 As Long, compPart As String, tsPart As String
        leaf = f.Name
        If LCase$(Right$(leaf, 4)) = ".txt" Then
            p1 = InStrRev(leaf, ".", Len(leaf) - 4)
            If p1 > 1 Then
                compPart = Left$(leaf, p1 - 1)
                tsPart = Mid$(leaf, p1 + 1, Len(leaf) - p1 - 4)
                Dim se As Object
                Set se = CreateObject("Scripting.Dictionary")
                se("component") = compPart
                se("file") = f.Path
                se("ts") = tsPart
                se("bytes") = f.Size
                snaps.Add se
            End If
        End If
    Next
    If LCase$(action) = "list" Then
        Dim sel As Object
        Set sel = New Collection
        Dim si As Long
        For si = 1 To snaps.Count
            If Len(component) = 0 Then
                sel.Add snaps.Item(si)
            ElseIf StrComp(CStr(snaps.Item(si)("component")), component, vbTextCompare) = 0 Then
                sel.Add snaps.Item(si)
            End If
        Next
        d("count") = sel.Count
        Set d("snapshots") = sel
        If sel.Count = 0 Then
            d("ok") = False
            ' a NAMED component with no snapshot is its own structured case.
            If Len(component) > 0 Then
                d("reason") = "no_snapshot_for_component"
                d("component") = component
                d("hint") = NoSnapshotHint()
            Else
                d("reason") = "no_snapshot"
            End If
        End If
        ToolUndoEdit = JsonStringify(d)
        Exit Function
    End If
    ' restore: the newest snapshot for that component (or the exact ts), unless the
    ' caller named a file. TS comparison is a prefix/equality on the stamp.
    Dim chosen As Object, ci As Long, cand As Object
    Set chosen = Nothing
    For ci = 1 To snaps.Count
        Set cand = snaps.Item(ci)
        If Len(component) = 0 Or StrComp(CStr(cand("component")), component, vbTextCompare) = 0 Then
            If Len(ts) = 0 Then
                Set chosen = cand
            ElseIf StrComp(CStr(cand("ts")), ts, vbTextCompare) = 0 Then
                Set chosen = cand
            End If
        End If
    Next
    If chosen Is Nothing Then
        d("ok") = False
        d("component") = component
        d("ts") = ts
        ' name what IS available so the caller can retry without guessing
        Dim av As Object
        Set av = New Collection
        For ci = 1 To snaps.Count
            If Len(component) = 0 Or StrComp(CStr(snaps.Item(ci)("component")), component, vbTextCompare) = 0 Then
                av.Add CStr(snaps.Item(ci)("ts"))
            End If
        Next
        Set d("available") = av
        ' a named component with NO snapshot at all is a distinct structured case
        ' (and names the opt-in that creates one); a merely-absent ts on a component that DOES
        ' have snapshots keeps snapshot_not_found + available[].
        If Len(component) > 0 And av.Count = 0 Then
            d("reason") = "no_snapshot_for_component"
            d("hint") = NoSnapshotHint()
        Else
            d("reason") = "snapshot_not_found"
        End If
        ToolUndoEdit = JsonStringify(d)
        Exit Function
    End If
    Dim backOk As Boolean
    Dim snapText As String
    snapText = ReadTextUtf8File(CStr(chosen("file")), backOk)
    If Not backOk Then
        d("ok") = False
        d("reason") = "snapshot_unreadable"
        d("file") = chosen("file")
        ToolUndoEdit = JsonStringify(d)
        Exit Function
    End If
    Dim compName As String
    compName = CStr(chosen("component"))
    Dim comp As VBIDE.VBComponent
    Set comp = McpFindTools.FindComponent(Me, compName)
    If comp Is Nothing Then
        d("ok") = False
        d("reason") = "component_not_found"
        d("component") = compName
        d("advice") = "the component this snapshot belongs to is not in the open project; the snapshot file is left untouched"
        ToolUndoEdit = JsonStringify(d)
        Exit Function
    End If
    Dim cur As String
    cur = SafeCompText(compName)
    d("component") = compName
    d("ts") = chosen("ts")
    d("shaBefore") = Sha256.Sha256HexTextUtf8(cur)
    d("snapshotSha256") = Sha256.Sha256HexTextUtf8(snapText)
    If StrComp(CrNorm(cur), CrNorm(snapText), vbBinaryCompare) = 0 Then
        d("restored") = False
        d("shaAfter") = d("shaBefore")
        d("diskUntouched") = True
        d("note") = "the pane already equals that snapshot; nothing was written"
        ToolUndoEdit = JsonStringify(d)
        Exit Function
    End If
    Dim wr As Long
    wr = SetCompTextMinimal(compName, cur, snapText)
    d("writeCalls") = wr
    d("hunks") = m_lastWriteHunks
    Dim nowTxt As String
    nowTxt = SafeCompText(compName)
    d("shaAfter") = Sha256.Sha256HexTextUtf8(nowTxt)
    d("restored") = (StrComp(CrNorm(nowTxt), CrNorm(snapText), vbBinaryCompare) = 0)
    d("diskUntouched") = True
    If Not CBool(d("restored")) Then
        d("ok") = False
        d("reason") = "restore_verify_failed"
    End If
    ToolUndoEdit = JsonStringify(d)
End Function

' attach the wheel snapshot and stamp the ONE pane-top channel that really
' answers on this IDE: VBIDE ActiveCodePane.TopLine (1-based, 0 = no active pane). The
' wheel object's own lastTopLineBefore/After come from EM_GETFIRSTVISIBLELINE and read -1
' because the code pane exposes no RichEdit20A child (measured); this key is the
' cross-checkable replacement. Pure output - no new tool, no description change.
Private Sub StampWheelNow(ByVal root As Object)
    Dim wo As Object
    Set wo = WinOps.WheelStateObj()
    wo("paneTopLineNow") = ActivePaneTopLine()
    Set root("wheel") = wo
End Sub

Private Function ActivePaneTopLine() As Long
    On Error Resume Next
    ActivePaneTopLine = 0
    Dim cp As VBIDE.CodePane
    Set cp = m_vbe.ActiveCodePane
    If cp Is Nothing Then Exit Function
    ActivePaneTopLine = cp.TopLine
    If Err.Number <> 0 Then ActivePaneTopLine = 0
    On Error GoTo 0
End Function

' =====================================================================
' final fix: the optional code-pane wheel.
'
' The wheel subclasses the pane's own window (class "VbaWindow"), but the pane
' does NOT respond to WM_VSCROLL: measured 2026-10-09 on the real code pane
' (hwnd=23464986, "P1067 - modLong (Code)"), SB_LINEDOWN x2 / SB_PAGEDOWN /
' SB_LINEUP x2 all left CodePane.TopLine at 1 with SendMessage returning 0 -
' i.e. the message arrives and is ignored. Setting TopLine through the object
' model IS observable and reversible (4/4). WinOps.bas is a standard module with
' no VBIDE reference, so it reaches these three helpers through the late-bound
' sink that McpServer wires at start-up (WinOps.WheelSetSink m_tools).
'
' The mapping key is the window caption: measured GetWindowText(VbaWindow) ==
' CodePane.Window.Caption VERBATIM. The "(Code)" suffix is never parsed - a
' localised IDE changes it, and the whole string is what both sides carry.
' =====================================================================

' Captions of every code pane that is open right now. Used by WheelScan to tell a
' code pane apart from the Immediate / Watch / Locals windows, which share the
' same window class. Read-only.
Public Function WheelPaneCaptions() As Object
    On Error Resume Next
    Dim c As Object
    Set c = New Collection
    Dim cp As VBIDE.CodePane
    Dim n As Long
    n = 0
    For Each cp In m_vbe.CodePanes
        If Not cp Is Nothing Then
            If Not cp.Window Is Nothing Then
                c.Add cp.Window.Caption
                n = n + 1
            End If
        End If
    Next
    m_wheelCapsSource = "all"
    If n = 0 Then
        ' (measured 2026-10-13: in BREAK mode the
        ' VBE.CodePanes collection yields NOTHING here - the pane the debugger opened
        ' exists, yet every VbaWindow was classified not_a_code_pane - while
        ' VBE.ActiveCodePane still answers (get_codepane{active} works in break).
        ' Fall back to the ACTIVE pane so a code pane that first appears IN BREAK can
        ' still be hooked. The source is published (WheelPaneCaptionsSource) so the
        ' receipt says why the table looks the way it does.
        Dim ap As VBIDE.CodePane
        Set ap = m_vbe.ActiveCodePane
        If Not ap Is Nothing Then
            If Not ap.Window Is Nothing Then
                c.Add ap.Window.Caption
                n = n + 1
                m_wheelCapsSource = "active_fallback"
            End If
        End If
        If n = 0 Then m_wheelCapsSource = "empty"
    End If
    Set WheelPaneCaptions = c
    Err.Clear
End Function

' (the code-pane caption measurement): read-only companion - WHERE the last caption table came from.
Public Function WheelPaneCaptionsSource() As String
    WheelPaneCaptionsSource = m_wheelCapsSource
End Function

' Current TopLine of the pane whose caption is caption; -1 when no pane matches.
Public Function WheelPaneTopByCaption(ByVal caption As String) As Long
    On Error Resume Next
    WheelPaneTopByCaption = -1
    m_wheelTopStatus = "ok"
    m_wheelTopErr = ""
    Dim cp As VBIDE.CodePane
    Set cp = McpFindTools.FindCodePaneByCaption(Me, caption)
    If cp Is Nothing Then
        m_wheelTopStatus = "pane_not_found"
        Exit Function
    End If
    Dim v As Long
    Err.Clear
    v = cp.TopLine
    If Err.Number <> 0 Then
        ' (the code-pane caption measurement): DO NOT collapse this into the same -1 as "not found".
        m_wheelTopStatus = "pane_not_writable_in_break"
        m_wheelTopErr = "TopLine READ refused: VB error " & CStr(Err.Number) & " (" & Err.Description & ")"
        Err.Clear
        Exit Function
    End If
    WheelPaneTopByCaption = v
    Err.Clear
End Function

' Move the viewport of the pane whose caption is caption, then READ IT BACK.
' wantLines / wantPages: exactly one is non-zero; the sign is the direction.
' Returns the pane's TopLine after the move, or -1 when no pane matches that
' caption (the caller must then NOT count the wheel as handled).
' Only TopLine is written - the caret and the selection are never touched.
Public Function WheelScrollPaneByCaption(ByVal caption As String, ByVal wantLines As Long, ByVal wantPages As Long) As Long
    On Error Resume Next
    WheelScrollPaneByCaption = -1
    m_wheelTopStatus = "ok"
    m_wheelTopErr = ""
    Dim cp As VBIDE.CodePane
    Set cp = McpFindTools.FindCodePaneByCaption(Me, caption)
    If cp Is Nothing Then
        m_wheelTopStatus = "pane_not_found"
        Exit Function
    End If
    Dim n As Long
    n = wantLines
    If wantPages <> 0 Then n = n + wantPages * cp.CountOfVisibleLines
    If n = 0 Then
        WheelScrollPaneByCaption = cp.TopLine
        Exit Function
    End If
    Dim lastLine As Long
    lastLine = 1
    If Not cp.CodeModule Is Nothing Then
        If cp.CodeModule.CountOfLines > 0 Then lastLine = cp.CodeModule.CountOfLines
    End If
    Dim t As Long
    t = cp.TopLine + n
    If t < 1 Then t = 1
    If t > lastLine Then t = lastLine
    Err.Clear
    cp.TopLine = t
    If Err.Number <> 0 Then
        ' (the code-pane caption measurement): the pane WAS resolved; the IDE refused the WRITE. That
        ' is a DIFFERENT failure from "no pane matched" and is reported as such, with the
        ' real VB error - never as the generic caption failure.
        m_wheelTopStatus = "pane_not_writable_in_break"
        m_wheelTopErr = "TopLine WRITE refused (target " & CStr(t) & " of " & CStr(lastLine) & "): VB error " & CStr(Err.Number) & " (" & Err.Description & ")"
        Err.Clear
        Exit Function
    End If
    ' read back what the IDE actually accepted, never what we hoped for
    Err.Clear
    WheelScrollPaneByCaption = cp.TopLine
    If Err.Number <> 0 Then
        m_wheelTopStatus = "pane_not_writable_in_break"
        m_wheelTopErr = "TopLine READ-BACK refused: VB error " & CStr(Err.Number) & " (" & Err.Description & ")"
        WheelScrollPaneByCaption = -1
    End If
    Err.Clear
End Function

' Verbatim (case-sensitive) caption match over every open code pane.

' (the code-pane caption measurement): "<project> - <component> (Code)" -> "<component>".
' A trailing bracketed suffix is dropped whatever its language ("(Code)", "(代码)"),
' because the component name never contains a bracket here.
Public Function ComponentNameFromPaneCaption(ByVal caption As String) As String
    ComponentNameFromPaneCaption = ""
    Dim s As String
    s = caption
    Dim i As Long, q As Long
    q = 0
    For i = Len(s) To 1 Step -1
        If Mid$(s, i, 1) = "(" Or Mid$(s, i, 1) = "[" Then
            q = i
            Exit For
        End If
    Next
    If q > 0 Then s = RTrim$(Left$(s, q - 1))
    Dim p As Long
    p = InStrRev(s, " - ")
    If p > 0 Then s = Mid$(s, p + 3)
    ComponentNameFromPaneCaption = Trim$(s)
End Function

' (the code-pane caption measurement): read-only companion - which channel resolved the last lookup.
Public Function WheelResolveVia() As String
    WheelResolveVia = m_wheelResolveVia
End Function

' (the code-pane caption measurement): the REAL outcome of the last TopLine read/write, so a caller
' can tell "no pane matched" from "the pane was found but the IDE refused the write".
Public Function WheelTopStatus() As String
    WheelTopStatus = m_wheelTopStatus
End Function

Public Function WheelTopError() As String
    WheelTopError = m_wheelTopErr
End Function

' =====================================================================
' R-1021-01 (requirement 4): a BOUNDED, read-only diagnostic scan for 0-byte
' component files. It is a FIELD on mcp_info, never a new tool: no input
' schema, no tool count and no frozen face changes.
'   * cost is bounded on purpose (project dir + ONE level, <=500 files examined,
'     <=20 hits reported, truncated reported honestly) so mcp_info stays cheap;
'   * 'untracked' is NOT claimed: this scan starts NO external process (no git),
'     so the basis is 'not-a-project-component'.
'   * nothing here writes, creates or deletes anything.
' =====================================================================
Private Function StrayIsComponentExt(ByVal fso As Object, ByVal fname As String) As Boolean
    Dim e As String
    e = LCase$(fso.GetExtensionName(fname))
    StrayIsComponentExt = (e = "bas" Or e = "cls" Or e = "frm" Or e = "ctl" Or e = "pag" Or e = "dsr" Or e = "vbp")
End Function

Private Function StrayScanFolder(ByVal fso As Object, ByVal dirPath As String, ByVal comps As Object, _
        ByVal hits As Object, ByRef scanned As Long, ByRef truncated As Boolean) As Boolean
    StrayScanFolder = True
    On Error Resume Next
    Dim fl As Object, f As Object
    Set fl = fso.GetFolder(dirPath)
    If Err.Number <> 0 Then
        Err.Clear
        StrayScanFolder = False
        Exit Function
    End If
    For Each f In fl.Files
        scanned = scanned + 1
        If scanned > 500 Then
            truncated = True
            Err.Clear
            Exit Function
        End If
        If Err.Number = 0 Then
            If f.Size = 0 Then
                If StrayIsComponentExt(fso, f.Name) Then
                    If hits.Count >= 20 Then
                        truncated = True
                    Else
                        Dim h As Object
                        Set h = CreateObject("Scripting.Dictionary")
                        h("path") = f.Path
                        h("fileName") = f.Name
                        h("bytes") = 0
                        h("notAProjectComponent") = Not comps.Exists(LCase$(f.Path))
                        h("mtime") = Format$(f.DateLastModified, "yyyy-mm-dd hh:nn:ss")
                        h("hint") = "0-byte file with a VB component extension: a directory-enumerating collector can mistake it for a real module; delete it explicitly if it was not created on purpose"
                        hits.Add h
                    End If
                End If
            End If
        End If
        MaybePump
    Next
    Err.Clear
End Function

Private Function StrayEmptyComponentScan() As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = True
    d("kind") = "diagnostic"
    d("basis") = "not-a-project-component"
    d("basisNote") = "a 0-byte file whose extension is a VB component extension and which is not one of the open project's component files. 'untracked' cannot be decided here: this scan starts NO external process (no git), so it never claims git-untracked."
    d("maxFiles") = 500
    d("maxHits") = 20
    d("maxDepth") = 1
    ' R-1021-01: the KEY is ALWAYS present - even with zero hits, even when the scan is
    ' skipped. Acceptance/automation must be able to ask "is there a stray?" and get a
    ' deterministic answer instead of inferring from a MISSING field (a conditionally
    ' emitted field is not decidable). count:0 + truncated:false is the empty answer.
    Dim hits As Object
    Set hits = New Collection
    Dim scanned As Long
    Dim truncated As Boolean
    scanned = 0
    truncated = False
    Set d("strayEmptyComponentFiles") = hits
    Set d("files") = hits
    d("scanned") = 0
    d("truncated") = False
    d("count") = 0
    Dim rootDir As String

    rootDir = McpProjTools.ProjectDir(Me)
    If Len(rootDir) = 0 Then
        d("skipped") = "no open project: the scan needs a project directory"
        Set StrayEmptyComponentScan = d
        Exit Function
    End If
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    d("projectDir") = rootDir
    d("gitRepoPresent") = CBool(fso.FolderExists(fso.BuildPath(rootDir, ".git")))
    Dim comps As Object
    Set comps = CreateObject("Scripting.Dictionary")
    On Error Resume Next
    Dim prj As VBIDE.VBProject
    Set prj = GetProject()
    Err.Clear
    On Error GoTo 0
    If Not prj Is Nothing Then
        Dim c As VBIDE.VBComponent
        For Each c In prj.VBComponents
            Dim cf As String
            cf = ""
            On Error Resume Next
            cf = c.FileNames(1)
            Err.Clear
            On Error GoTo 0
            If Len(cf) > 0 Then comps(LCase$(cf)) = True
        Next
    End If
    StrayScanFolder fso, rootDir, comps, hits, scanned, truncated
    On Error Resume Next
    Dim subs As Object, sub_ As Object
    Set subs = fso.GetFolder(rootDir).SubFolders
    If Err.Number = 0 Then
        If Not subs Is Nothing Then
          For Each sub_ In subs
            If LCase$(sub_.Name) <> ".git" Then
                If Not truncated Then
                    StrayScanFolder fso, sub_.Path, comps, hits, scanned, truncated
                End If
            End If
            MaybePump
          Next
        End If
    End If
    Err.Clear
    On Error GoTo 0
    d("scanned") = scanned
    d("truncated") = truncated
    d("count") = hits.Count
    ' the two keys are the SAME collection: strayEmptyComponentFiles is the documented
    ' name (always present); files is kept as an additive alias for existing readers.
    Set d("strayEmptyComponentFiles") = hits
    Set d("files") = hits
    Set StrayEmptyComponentScan = d
End Function

Private Function ToolMcpInfo() As String
    Dim d As Object
    Dim mcpFnT0 As Double
    Dim mcpTmp As Double
    Dim mcpStaticUs As Double, mcpClassUs As Double, mcpBudgetUs As Double
    Dim mcpCtlUs As Double, mcpScanUs As Double, mcpRegUs As Double
    Dim mcpWheelUs As Double, mcpJsonUs As Double, mcpTotalUs As Double
    Dim mcpEnvUs As Double, mcpModalUs As Double, mcpBuildUs As Double
    Dim mcpShaUs As Double, mcpTcUs As Double
    Dim mcpCpu0 As Double, mcpCpuUs As Double, mcpRestUs As Double
    Dim mcpBytes As Long, mcpClassN As String, mcpClassSha As String
    Dim mcpLine As String
    Dim mcpBody As String
    Dim mcpNoCache As Boolean
    mcpCpu0 = WinOps.WoThreadCpuUs()
    mcpFnT0 = WinOps.WoProfNow()
    ' R2: VB6MCP_TOOLS_CACHE=0 restores the OLD path for the mcp_info static subtrees
    ' (breaking/migrations/changelog, classification, budgets, ctlTools) AND for the body
    ' assembly: everything is rebuilt and re-serialized on every call, exactly like R1.
    ' Read once per call - mcp_info is an explicit call, so one Environ$ read is free.
    mcpNoCache = (Trim$(Environ$("VB6MCP_TOOLS_CACHE")) = "0")
    Set d = CreateObject("Scripting.Dictionary")
    Dim mcpT0 As Double
    d("ok") = True
    mcpTmp = WinOps.WoProfNow()
    Set d("modalGuard") = WinOps.WoModalGuardResident()
    mcpModalUs = WinOps.WoProfNow() - mcpTmp
    d("product") = VB6MCP_PRODUCT_VERSION
    d("contract") = VB6MCP_CONTRACT_VERSION
    mcpTmp = WinOps.WoProfNow()
    d("toolCount") = ToolCount()
    mcpTcUs = WinOps.WoProfNow() - mcpTmp
    ' read-only environment fingerprint (host EXE version, ANSI code page, UI language,
    ' OS build). Computed HERE and only HERE - mcp_info is an explicit call, so nothing
    ' periodic pays for it.
    mcpT0 = WinOps.WoProfNow()
    Set d("environment") = WinOps.EnvironmentInfoObj()
    mcpEnvUs = WinOps.WoProfNow() - mcpT0
    WinOps.WoProfAdd 20, mcpEnvUs
    ' (contract v1.3.2, optional fields): this build can decode a VB error code
    ' back to its HRESULT family via P2@s 85-entry table (R65/R66). The raw `hresult`
    ' field additionally needs dwMessageId@s RVA, which no document states - asked of P2
    ' as a separate later item - so no hresult value is emitted yet (never a fabricated one).
    d("errorDecoding") = True
    d("errorTableEntries") = 85
    ' which SHA kernel is ACTUALLY in force, so the forced-fallback evidence
    ' stops being ambiguous. if/else because the earlier one-liner plus a cross-module
    ' Private call did not compile. NOTE: this edit also RESTORES errorTableEntries, which
    ' an earlier block deletion of mine had removed by accident.
    mcpTmp = WinOps.WoProfNow()
    d("shaKernel") = Sha256.ShaKernelName()
    If Sha256.ShaKernelName() = "vb6-fallback" Then
        d("shaFallbackForced") = True
    Else
        d("shaFallbackForced") = False
    End If
    mcpShaUs = WinOps.WoProfNow() - mcpTmp
    mcpT0 = WinOps.WoProfNow()
    Dim b As Object
    Set b = CreateObject("Scripting.Dictionary")
    b("sha256") = McpBuildTools.BuildSha256(Me)
    b("builtAt") = McpBuildTools.BuildBuiltAt(Me)
    ' make the freshness AUDITABLE. sha256/builtAt are read from the
    ' file at call time (same function that feeds instructions.BUILT); path says
    ' WHICH file was read and readAt says WHEN, so a stale value cannot be mistaken
    ' +: sha256/builtAt describe the DLL AS IT WAS LOADED, and are now a
    ' LOAD-TIME CONSTANT (CodeTools memoizes them; they used to be re-hashed on every 15 ms tick).
    ' path says WHICH file was loaded and readAt says WHEN the receipt was rendered. A redeploy that
    ' replaces that file under a RUNNING IDE is a SEPARATE fact and is reported as such:
    ' onDiskChanged is a cheap (size, mtime) stat at >=1 s cadence - never a hash - and the running
    ' build keeps its truthful sha256 until the IDE is restarted.
    b("path") = McpBuildTools.BuildPath(Me)
    b("readAt") = Format$(Now, "yyyy-mm-dd hh:nn:ss")
    b("onDiskChanged") = McpBuildTools.BuildOnDiskChanged(Me)
    b("onDiskSignature") = McpBuildTools.BuildOnDiskSignature(Me)
    mcpBuildUs = WinOps.WoProfNow() - mcpT0
    WinOps.WoProfAdd 19, mcpBuildUs
    ' SOURCE INPUT SET (the .vbp plus every component file it lists, strict mode) and is
    ' stable across rebuilds and machines. Both values are read from the generated
    ' BuildStamp.bas, INCLUDING the algorithm id, so a future vb6src/2 propagates here
    ' without touching this code.
    b("sourceHash") = VB6MCP_SOURCE_HASH
    b("sourceAlgo") = VB6MCP_SOURCE_ALGO
    ' (increment 1): the registration accounting is READABLE, not just written -
    ' a counter nobody can read is not accounting.  Additive field (no tool, no description,
    ' no input schema change -> the frozen tool face is untouched).
    mcpTmp = WinOps.WoProfNow()
    Set d("registration") = Util.RegistrationInfo()
    mcpRegUs = WinOps.WoProfNow() - mcpTmp
    Set d("build") = b
    mcpTmp = WinOps.WoProfNow()
    If m_miBreaking Is Nothing Or mcpNoCache Then
        Set m_miBreaking = BreakingList()
        Set m_miMigrations = MigrationsList()
        Set m_miChangelog = ChangelogList()
        m_miFragReady = False
        mcpStaticUs = WinOps.WoProfNow() - mcpTmp
    Else
        mcpStaticUs = 0
    End If
    Set d("breaking") = m_miBreaking
    Set d("migrations") = m_miMigrations
    Set d("changelog") = m_miChangelog
    ' R-1021-01: bounded diagnostic for 0-byte component residue (requirement 4).
    ' R-1021-03 A1: auditable read-only classification (additive; no tool or description changed).
    mcpTmp = WinOps.WoProfNow()
    If m_miTcl Is Nothing Or mcpNoCache Then
        Set m_miTcl = ToolClassification()
        If IsObject(m_miTcl) Then
            m_miClassN = CStr(m_miTcl("coverage")("readOnly")) & "/" & _
                        CStr(m_miTcl("coverage")("write")) & "/" & _
                        CStr(m_miTcl("coverage")("declared"))
            m_miClassSha = Left$(Sha256.Sha256HexTextUtf8(ToolClassificationFingerprint(m_miTcl)), 12)
        End If
        m_miFragReady = False
        mcpClassUs = WinOps.WoProfNow() - mcpTmp
    Else
        mcpClassUs = 0
    End If
    mcpClassN = m_miClassN
    mcpClassSha = m_miClassSha
    Set d("readOnlyTools") = m_miTcl("readOnlyTools")
    Set d("writeTools") = m_miTcl("writeTools")
    Set d("readOnlyCoverage") = m_miTcl("coverage")
    d("readOnlySource") = "ToolReadOnly"
    mcpTmp = WinOps.WoProfNow()
    If m_miBudget Is Nothing Or mcpNoCache Then
        Set m_miBudget = ToolBudgetTable()
        Set m_miBudgetInv = ToolBudgetInvariants()
        m_miFragReady = False
        mcpBudgetUs = WinOps.WoProfNow() - mcpTmp
    Else
        mcpBudgetUs = 0
    End If
    Set d("callBudgets") = m_miBudget
    Set d("callBudgetInvariants") = m_miBudgetInv
    mcpTmp = WinOps.WoProfNow()
    If m_miCtl Is Nothing Or mcpNoCache Then
        Set m_miCtl = CtlToolCollection()
        m_miFragReady = False
        mcpCtlUs = WinOps.WoProfNow() - mcpTmp
    Else
        mcpCtlUs = 0
    End If
    Set d("ctlTools") = m_miCtl
    mcpTmp = WinOps.WoProfNow()
    Set d("diagnostics") = StrayEmptyComponentScan()
    mcpScanUs = WinOps.WoProfNow() - mcpTmp
    ' read-only wheel state (pure addition; no new tool, no description change).
    mcpTmp = WinOps.WoProfNow()
    StampWheelNow d
    mcpWheelUs = WinOps.WoProfNow() - mcpTmp
    mcpT0 = WinOps.WoProfNow()
    If Not mcpNoCache Then
        If Not m_miFragReady Then MiFragRefresh
    End If
    ' no-cache mode: authoritative serializer on every call, and the one-shot proof is
    ' left PENDING so a later cache-enabled call re-proves it instead of trusting a
    ' verdict that this call did not produce.
    If mcpNoCache Then
        mcpBody = JsonStringify(d)
        m_miBodyChk = 0
    ElseIf m_miBodyChk = 0 Then
        ' R2 one-shot proof: the fragment assembler must reproduce the authoritative text
        ' byte for byte before it is ever trusted. A mismatch keeps JsonStringify forever.
        mcpBody = JsonStringify(d)
        If StrComp(MiBodyJson(d), mcpBody, vbBinaryCompare) = 0 Then
            m_miBodyOk = True
        Else
            m_miBodyOk = False
        End If
        m_miBodyChk = 1
    ElseIf m_miBodyOk Then
        mcpBody = MiBodyJson(d)
        m_miHits = m_miHits + 1
    Else
        mcpBody = JsonStringify(d)
    End If
    ToolMcpInfo = mcpBody
    mcpJsonUs = WinOps.WoProfNow() - mcpT0
    WinOps.WoProfAdd 21, mcpJsonUs
    mcpTotalUs = WinOps.WoProfNow() - mcpFnT0
    mcpCpuUs = WinOps.WoThreadCpuUs() - mcpCpu0
    ' rest = wall time that no named probe explains (the eight managed segments plus
    ' the four exclusion probes). It is computed here so it never has to be derived by hand.
    mcpRestUs = mcpTotalUs - (mcpStaticUs + mcpClassUs + mcpBudgetUs + mcpCtlUs _
                + mcpScanUs + mcpRegUs + mcpWheelUs + mcpJsonUs _
                + mcpEnvUs + mcpModalUs + mcpBuildUs + mcpShaUs)
    mcpBytes = Len(ToolMcpInfo)
    mcpLine = "mcpinfo parts us= static=" & CStr(CLng(mcpStaticUs)) & " class=" & CStr(CLng(mcpClassUs)) & " budget=" & CStr(CLng(mcpBudgetUs)) & " ctlTools=" & CStr(CLng(mcpCtlUs)) & " scan=" & CStr(CLng(mcpScanUs)) & " reg=" & CStr(CLng(mcpRegUs)) & " wheel=" & CStr(CLng(mcpWheelUs)) & " json=" & CStr(CLng(mcpJsonUs))
    mcpLine = mcpLine & " total=" & CStr(CLng(mcpTotalUs)) & " wall=" & CStr(CLng(mcpTotalUs)) & " cpu=" & CStr(CLng(mcpCpuUs)) & " env=" & CStr(CLng(mcpEnvUs)) & " modalGuard=" & CStr(CLng(mcpModalUs)) & " build=" & CStr(CLng(mcpBuildUs)) & " sha=" & CStr(CLng(mcpShaUs)) & " toolCount=" & CStr(CLng(mcpTcUs))
    mcpLine = mcpLine & " rest=" & CStr(CLng(mcpRestUs)) & " bytes=" & CStr(mcpBytes) & " classN=" & mcpClassN & " classSha=" & mcpClassSha & " staticsha=" & m_miStaticSha & " hits=" & CStr(m_miHits) & " bodyok=" & IIf(m_miBodyOk, "1", "0")
    Util.LogLine mcpLine
End Function

Private Function BreakingEntry(ByVal since As String, ByVal what As String, ByVal instead As String) As Object
    Dim e As Object
    Set e = CreateObject("Scripting.Dictionary")
    e("since") = since
    e("what") = what
    e("instead") = instead
    Set BreakingEntry = e
End Function

Private Function BreakingList() As Object
    Dim c As Object
    Set c = New Collection
    c.Add BreakingEntry("v1.2.0", _
        "get_component_code: coords default disk -> ide (the numbering is now IDE line numbers)", _
        "pass coords=""disk"" for the old text/numbering; the response is a JSON envelope, text in result.text")
    c.Add BreakingEntry("v1.2.0", _
        "replace_code: an out-of-range or continuation edit is REJECTED (range_beyond_end / inside_continuation)", _
        "branch on ok/reason; deletedLines=0 is no longer a success signal, and the IDE content does not change")
    c.Add BreakingEntry("v1.2.0", _
        "write-class tools: validate=off|warn|strict, and edit-side failures carry ok:false + reason", _
        "read reason before retrying; strict refuses the write before the IDE or the disk is touched")
    c.Add BreakingEntry("v1.2.0", _
        "write_file now TRUNCATES; build/make_project/verify report artifactChanged/verdict", _
        "judge a build by artifactChanged/verdict (compiled-no-artifact-change = NOT built), not by ok alone")
    c.Add BreakingEntry("v1.3.0", _
        "version visibility: initialize.instructions banner + per-response mcp:{product,contract} stamp + mcp_info", _
        "purely additive: no existing field, parameter or tool signature changed")
    c.Add BreakingEntry("v1.5.0", _
        "three message-only window tools were added: read_active_dialogs / close_active_dialogs / send_window_message", _
        "purely additive: no existing tool's inputSchema changed. close_active_dialogs never runs automatically and only clicks safe captions; send_window_message only reaches windows of the VB6 process that hosts the add-in")
    c.Add BreakingEntry("v1.6.0", _
        "two tools were added: replace_in_files (cross-component literal/regex replace) and undo_edit (single-step component undo)", _
        "purely additive: no existing tool's inputSchema changed (109 -> 111). replace_in_files defaults to dry_run=true and only ever rewrites the OPEN project; undo_edit restores the component PANE and never touches a file on disk")
    c.Add BreakingEntry("v1.6.0", _
        "send_window_message: HIGH-RISK messages (WM_CLOSE 0x0010 / WM_QUIT 0x0012 / WM_SYSCOMMAND 0x0112) are REFUSED with reason=high_risk_message unless confirm=true", _
        "pass confirm=true only when acting on THAT window IS the intent; nothing was sent when refused. Its parameter is message (an argument named msg is ignored and fails with reason=bad_message) and a raw number (0x0111 / 522 / &H20A) is accepted alongside the named messages")
    c.Add BreakingEntry("v1.8.0", _
        "replace_code with operation=replace or operation=delete now REFUSES the call when expected_sha256 is absent (reason=expected_sha256_required); the hub gained the ide_restart tool (add-in 107 + hub 5 = 112)", _
        "pass expected_sha256 - the refusal carries currentSha256 so it is a single retry; get_component_code reports the same sha. insert/append/set are unchanged. ide_restart only ever stops OUR OWN instance (port >= 8767) and never the external 8766 one")
    c.Add BreakingEntry("v1.6.0", _
        "add_component(type=form): the form is now created by the IDE ITSELF through its own Add Form command, not by a .frm we synthesize", _
        "the receipt carries createdVia: ide_dialog | synthesized (plus ideRouteNote on the fallback) and projectDirWrites is [] on the IDE route; the call waits for the add-in watchdog to press the IDE's own modal confirm button, so it takes about 3.5-4.9 s instead of milliseconds. The synthesized fallback still exists, now with LinkTopic = the component name and the IDE's real default geometry (3015/120/465/4560)")
    c.Add BreakingEntry("v1.6.0", _
        "recorded tool-face limitations: command_bars{list} does NOT enumerate the Add-Ins popup (only execute-by-caption or by id reaches those items), and the AddFromTemplate form route is unavailable on this machine (no plain form template exists in the source templates folder or the VB6 Template\Forms folder) and was deliberately NOT implemented", _
        "reach the settings entry with command_bars{action:""execute"",control:""VB6 MCP Settings...""}; create forms with add_component(type=form) as usual")
    c.Add BreakingEntry("v1.9.0", _
        "three tools were added - immediate_eval / immediate_run / ide_quiet_mode - and ide_state gained release_inflight / release_min_held_ms plus a release{} block (add-in 111 -> 114)", _
        "purely additive for existing callers: no existing tool lost a parameter, and no existing receipt changed on the quiet-OFF / no-release path. ide_state now ALWAYS carries a release{} block with a fixed key set (the same discipline as cancel{}), and read-only receipts gain gate* keys ONLY after a forced release has actually happened")
    c.Add BreakingEntry("v1.10.0", _
        "+1 tool: desktop_probe (read-only live desktop/interactivity identity; fail-closed: ok:false + failureKind=""api_unavailable"" when an API fails). +3 OPTIONAL file-fed params (vba6_probe.exec_line_file / immediate_eval.expression_file / immediate_run.code_file, ADDITIVE). 12 tool DESCRIPTIONS were neutralized (internal label text only - no behaviour change); vba6_probe gains a 7-value structured failure envelope and the immediate_* exec_error wrappers add channel_error / statement_raised (ADDITIVE)", _
        "purely additive for existing callers: no existing parameter was removed and no existing receipt changed. The 3 new parameters are OPTIONAL (absent = current behaviour) and desktop_probe is a new READ-ONLY tool. The 10 description-only changes are internal label text and change no behaviour and no receipt field. vba6_probe now reports a 7-value failureKind (not_loaded / alloc_failed / arg_out_of_range / address_invalid / not_readable / engine_zero / refused_by_design) and the immediate_* exec_error wrappers add channel_error / statement_raised")
    c.Add BreakingEntry("v1.11.13", _
        "last_error{dismiss:true} no longer clicks END on a VB6 runtime-error box: it READS the body, clicks DEBUG and reports the MEASURED engine state. A box without a Debug button, or a click whose measured state is neither break nor design, is a STRUCTURED FAILURE (runtimeErrorDialogDismissFailed) that leaves the box untouched", _
        "END is unsafe on this path (handles may not be released and the IDE can become unstable), so it is never sent. Read runtimeErrorDialogDismissFailed + runtimeErrorDismiss{buttons,measuredEbMode} and decide yourself; ide_state.lastError and last_error{} hand the capture back from cache after the box is gone")

    ' (contract v1.7.0): the snapshot parameter added by is
    ' ADDITIVE - it is optional and defaults to off, so no existing call changes behaviour
    ' (cross-build A/B over the shared call sequence: 0 differences). This version therefore
    ' adds NO breaking entry ON PURPOSE: fabricating one would misreport the semantics, and
    ' deleting the historical entries above would falsify the record. The v1.7.0 note lives
    ' in MigrationsList() instead.
    c.Add BreakingEntry("v1.13.0", _
        "hub tool face: +1 hub tool ide_kill_and_relaunch{pid, project?, ready_wait_ms?} and an OPTIONAL ide_start.ready_wait_ms; a target refusal carries onlinePids[] / targetDiagnostic / howToProceed and 0 live instances answer reason=no_live_ide (reasonLegacy=no_ide_running); build / make_project(route=cli) / project_meta are served OFFLINE by the hub when no IDE is live", _
        "purely additive for the ADD-IN face: no add-in tool and no add-in parameter changed (toolCount stays 120). A caller that required reason=no_ide_running must also accept no_live_ide - the legacy value rides along as reasonLegacy. ide_start ready:false is a truthful timeout, NOT a failed start: poll ide_list for the returned pid")
    c.Add BreakingEntry("v1.14.0", _
        "hub tool face: ide_restart gains TWO OPTIONAL parameters - wait_ms (bound how long ONE call blocks) and opId (continue/poll an operation a previous call returned) - and EVERY path now carries opId/started/state(done|refused|error|in_progress)/finished/elapsedMs/currentStep/lastKnownState/opRule", _
        "ADDITIVE for the ADD-IN face: no add-in tool and no add-in parameter changed (toolCount stays 120). A restart that outlives wait_ms answers pending:true + state=in_progress + opId instead of looking like a failure (a client-side request timeout is NOT this tool's answer); ide_restart{opId} answers from the in-process operation registry and starts NOTHING; a SECOND restart while one is in flight is refused with reason=restart_in_progress, because it could stop the process the first one just started. content[0].text is ONE JSON document: an array/scalar body becomes {singleDocument:true, data, receipt} (an empty result is data:[]) and a non-JSON body becomes a structured content_not_json document, while an object body keeps its flat shape; VB6MCP_LEGACY_TEXTBODY=1 restores the old two-part form for ONE version.")
    c.Add BreakingEntry("v1.15.0", _
        "ADD-IN face parameter change: run_project gains TWO OPTIONAL parameters - observe_max_wait_ms (integer, ms, default timeout_ms, clamped 1000..120000) and done_marker (object {path, contains}; path is on the machine that runs the IDE, UNC allowed; the first 65536 bytes are read as bytes and nothing is written; contains is CASE-SENSITIVE, a pure-ASCII value is byte-exact and a non-ASCII value is tried as UTF-8 and as system ANSI) - and get_locals gains ONE OPTIONAL parameter, allowUnsafeInBreak (boolean, default false)", _
        "ADDITIVE for existing callers: absent parameters keep today's behaviour for run_project (timeout_ms still bounds observe) and for get_locals in DESIGN. BREAKING for callers that read locals in BREAK: get_locals now REFUSES with reason=break_eval_requires_opt_in + howToWorkAround unless allowUnsafeInBreak:true - the opt-in does NOT guarantee the statement will not hang, and a hang is recovered with the hub-side ide_kill_and_relaunch (not taskkill). run_project(observe) gains a decidable state (done-by-marker | exited | break | error | timeout, a CLOSED five-value set where done-by-marker implies marker.matched:true and a requested-but-unmatched marker reports marker.unmet:true), observedState, elapsedMs, marker{...} and pipeReleasedByReturn:true. The budget BOUNDS the wait loop: a timeout is ok:true + timeout:true + " & _
            "retrySafe:true + suggestedAction=observe_again with the measured elapsedMs (not a failure) and marker.unmetReason names the budget; observe in BREAK is REFUSED with reason=observe_in_break_not_supported; a #32770 dialog is CLASSIFIED (observe_blocked_by_ide_dialog + dialogPrecheck, isProgramError:false) instead of being called an error.")
    c.Add BreakingEntry("v1.16.0", _
        "ADD-IN face, purely ADDITIVE: breakpoints gains the action value probe (behavioural breakpoint verification) and verify / verify_scope gain ONE OPTIONAL boolean parameter, requireCompiler (default false)", _
        "no parameter was removed or retyped and no receipt changes when the new action/parameter is absent. breakpoints{action:probe} REALLY STARTS the program (design state + no modal box required, bounded by timeout_ms, always ended, never saved) and answers probeResult=stopped_at_target|stopped_elsewhere|did_not_stop|timeout|run_failed plus target/position/stateBefore/stateAfter/probeCleanup. verify/verify_scope{requireCompiler:true} REFUSE with reason=compiler_not_configured + compilerProbe{resolved,path,why} when no compiler is available (a lint verdict is never substituted) and otherwise answer authority=compiler + compiler{path,logPath,errorCount,artifactChanged}. Tool count unchanged: add-in 120 -> 120; hub and DSH-facing counts are unaffected by this add-in-face change.")
    Set BreakingList = c
End Function

Private Function MigrationsList() As Object
    Dim c As Object
    Set c = New Collection
    c.Add "line numbers: read coords.default (and lineSpace) in every response before editing; edit tools take IDE line numbers, get_component_code defaults to coords=""ide"""
    c.Add "prefer anchor edits over line numbers: edit_by_anchor / apply_edits with expected_sha256"
    c.Add "call mcp_info once after initialize: product/contract/toolCount + the BREAKING list + how to compare build.sha256"
    c.Add "v1.6.0: replace_in_files defaults to dry_run=true and only rewrites the OPEN project; expected_shas[] makes a mismatching component SKIPPED (never written) and a failure STOPS the run, rolling the applied components back or reporting the exact applied set"
    c.Add "v1.6.0: undo_edit restores a component's PANE text from <project>\_undo\<component>.<ts>.txt (UTF-8). A snapshot is written before every component text write and is gated by VB6MCP_ALLOW_PROJECTDIR_WRITES; to_disk=true is refused (use save_project to flush the project)"
    c.Add "v1.6.0: send_window_message takes message (not msg), accepts raw numbers, and needs confirm=true for WM_CLOSE / WM_QUIT / WM_SYSCOMMAND"
    c.Add "v1.6.0: control_execution.mode's enum now lists the 12 values the implementation really accepts (resume / stop / stepinto / stepover / stepout / runtocursor / fullcompile included as compatibility aliases)"
    c.Add "v1.8.0: replace_code{replace|delete} now REQUIRES expected_sha256 (a line-number edit must pin the text it was measured against; the refusal carries currentSha256 so the fix is one retry) - this is the only caller-visible break. insert/append/set stay optional. validate_code gains an OPTIONAL baseline and every diagnostic gains proc/procOffset/fingerprint/stableKey plus an always-present baseline_diff{added,removed}. ide_state gains cancel_inflight/cancel_target and every read-only receipt carries inflight{}. write-class tools refuse a block that does not pair its own first/last procedure keywords BEFORE writing"
    c.Add "v1.7.0: replace_code / apply_edits / edit_by_anchor accept an OPTIONAL snapshot (boolean, default false; the strings ""on""/""yes""/""1"" are also accepted). snapshot=true guarantees exactly ONE pre-edit pane snapshot so undo_edit can restore that edit; with the argument absent behaviour is UNCHANGED (additive). replace_code's replace/insert/append/delete write no snapshot by default; apply_edits / edit_by_anchor already snapshot by default. undo_edit answers reason=no_snapshot_for_component plus a hint when a NAMED component has no snapshot"
    c.Add "v1.7.0: the frozen tool face was re-frozen once for that additive parameter - tools/schema_baseline.json == docs/tools_schema.json (sha256 1EE3BFA9E917AB6E5D148D409FB6B33ACA91EF2B20C7988E39ADE589536108BE); the tool count is unchanged at 111, and mcp_info.breaking gains NO v1.7.0 entry because nothing in this version breaks a caller"
    c.Add "v1.9.0: immediate_eval / immediate_run run statements in the ACTIVE project's immediate context and carry the VALUE and the PRINTED text out through a private temp file - no Immediate-window pane read, and no Open/Print/Close for the caller. A statement that RAISES still blocks the IDE (On Error is REFUSED on this channel with ret=40036 - measured), so timeout_ms is a GATE-AGE threshold and NOT a hard timeout; immediate_* ARM that release, so the NEXT tool call heals the session by itself, and ide_state{release_inflight:true, release_min_held_ms} forces the gate open on demand"
    c.Add "v1.9.0: ide_state{release_inflight:true} FORCE-RELEASES the single-flight gate of a call that never came back. The receipt reports {released, releasedTool, heldMs, abandonedSeq, statementInterrupted:false} and says the blocked call is STILL RUNNING; the abandoned frame's unwind is swallowed exactly once, so the depth can never be decremented twice. release_min_held_ms (default 60000) keeps a HEALTHY long call from losing the guarantee"
    c.Add "v1.9.0: ide_quiet_mode{on,ttl_ms} is a session-level switch. While ON, control_window{action:""activate""} does NOT call Window.SetFocus (the receipt says quietModeSuppressedFocus:true) and EVERY tools/call receipt carries quiet{...,advisory}. quiet OFF is byte-for-byte the previous behaviour, and foregroundReadable=false means the handle could not be READ (a LIVE value that can be 0 on a locked or non-interactive desktop) - never read that as the focus having been left alone"
    c.Add "v1.13.0: with no live IDE, build / make_project(route:""cli"") / project_meta are served OFFLINE by the hub (offline:true, targetResolved:false) and need project= / path= explicitly; IDE-facing tools answer reason=no_live_ide with onlinePids[]/howToProceed[] instead of a pid-level target_mismatch. ide_start now waits for the add-in (ready / readyWaitMs / readyChecks / pollingHint; optional ready_wait_ms, default 15000) and reuses an already-open .vbp. ide_kill_and_relaunch{pid, project?, ready_wait_ms?} is the hub-side reset that does not depend on the add-in pipe"
    c.Add "v1.14.0: ide_restart is a CONTINUABLE operation - it waits at most wait_ms (default 25000, env VB6MCP_HUB_RESTART_WAIT_MS, clamped 1500..300000) and then answers ok:false + pending:true + state=""in_progress"" + opId + currentStep + lastKnownState (this is NOT a failure; do NOT start a second restart). Continue it with ide_restart{opId:""...""} - that reads the in-process registry (30 minute TTL, forgotten by a hub restart) and starts NOTHING. A second restart while one is in flight answers reason=restart_in_progress + inProgress{opId}. The content channel is now ONE document for array/scalar bodies: {singleDocument:true, data, receipt}; an empty result is data:[]; VB6MCP_LEGACY_TEXTBODY=1 restores the old two-part form for one version"
    c.Add "v1.15.0: run_project(observe) is bounded by observe_max_wait_ms (default timeout_ms, clamped 1000..120000) and can end at done_marker:{path,contains} (path on the IDE machine; first 65536 bytes read as bytes; contains is case-sensitive; non-ASCII tried as UTF-8 and as ANSI); state is a CLOSED FIVE-value set: done-by-marker (ONLY when marker.matched:true), exited (the program ended normally), break, error, timeout - and a requested-but-unmatched marker reports marker.unmet:true - with observedState/elapsedMs/marker{...}/pipeReleasedByReturn. The budget is enforced INSIDE the wait loop, so a timeout is a real early return: ok:true + timeout:true + retrySafe:true + suggestedAction=observe_again, elapsedMs measured (a parsed-but-unused budget let the live build run to program exit). observe in BREAK is " & _
        "refused with observe_in_break_not_supported. get_locals in BREAK is refused with break_eval_requires_opt_in unless allowUnsafeInBreak:true (informed consent: it does NOT guarantee no hang; recover with the hub-side ide_kill_and_relaunch, not taskkill); every failure receipt carries gateReleased + howToRecover"
    Set MigrationsList = c
End Function

