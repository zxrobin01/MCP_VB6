    Set m("host_modal") = hmEmpty
    Dim imEmpty As Object
    Set imEmpty = CreateObject("Scripting.Dictionary")
    imEmpty("attempted") = False
    imEmpty("pid") = 0
    imEmpty("exitCode") = -1
    imEmpty("killed") = False
