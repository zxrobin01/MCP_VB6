' Contract v1.1.0 batch A: ide_state / list_breakpoints / find_gui
' All three are READ-ONLY observers: none of them may change state.
' =====================================================================

' Contract section 1: the IDE mode, read live. Deliberately NOT cached - the whole
' point is that a design/run/break switch is visible on the very next call.
Private Function ToolIdeState(Optional ByVal cancelInflight As Boolean = False, Optional ByVal cancelTarget As String = "", Optional ByVal releaseInflight As Boolean = False, Optional ByVal releaseMinHeldMs As Long = 0) As String
    On Error Resume Next
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    ' =====================================================================
    ' R-1021-05: the MODAL runtime-error box is a REAL state and it is decided FIRST.
    ' Measured on a live IDE stopped on the box: state="run", running=true, ebMode=1,
    ' commandBarsSuspended=true, stateSource="ebMode+commandBars" - so neither EbMode nor
    ' CommandBars describes this state. The probe below uses THIS PROCESS'S OWN WINDOWS
    ' ONLY (EnumWindows + EnumChildWindows + GetWindowTextW): a direct Win32 path that
    ' neither marshals to the IDE's thread, nor waits, nor sends anything, and NOTHING is
    ' clicked here. Only when the box is absent does the existing EbMode-first path run,
    ' and then the receipt is byte-for-byte the previous shape.
    ' =====================================================================
    Dim reDlg As Object
    Set reDlg = McpRe.ReFindRuntimeErrorDialog(Me)
    Dim eb As Long
    eb = IdeEbMode()
    Dim st As String
    Dim stateSource As String
    Dim barsSuspended As Boolean
    stateSource = ""
    barsSuspended = False
    If Not reDlg Is Nothing Then
        st = "runtime_error"
        stateSource = "runtime_error_dialog"
    Else
        st = GetIdeStateEx(stateSource, barsSuspended)
    End If
    root("state") = st
    root("ebMode") = eb
    Set root("modalGuard") = WinOps.WoModalGuardResident()
    If Not reDlg Is Nothing Then
        root("title") = WinProbe.MainWindowTitleOf(WinProbe.CurrentProcessId())
        root("project") = ""
    Else
        root("title") = IdeMainTitle()
        root("project") = McpProjTools.ProjectNameSafe(Me)
    End If
    root("running") = (st = "run")
    root("notRunning") = (st = "design")
    If Not reDlg Is Nothing Then
        root("commandBarsSuspended") = True
        root("commandBarsProbed") = False
        root("commandBarsSuspendedSource") = "modal_runtime_error_dialog: measured TRUE while the box is up; CommandBars is NOT probed on this path because the decision comes from the Win32 dialog probe alone (the box owns the IDE thread in its own modal loop)"
        root("errorBreakPending") = True
        root("projectNote") = "not read on this path: the project name comes from the IDE object model, which is not consulted while the modal dialog owns the thread (the dialog title carries the project/app name)"
        root("stateDetail") = "the runtime-error dialog was detected by this process's own window enumeration; no IDE object-model call was made"
        Set root("runtimeErrorDialog") = McpRe.ReDialogInfoBlock(Me, reDlg)
    Else
        root("commandBarsSuspended") = barsSuspended
    End If
    root("stateSource") = stateSource
    ' (D3) a suspended-bars window with NO debug context is the post-run window: clear it with
    ' ONE activate_component so the NEXT debug_session{attach:true} is not misled into "run".
    ' While the modal runtime-error box owns the thread this nudge is SKIPPED (object-model call).
    If Not reDlg Is Nothing Then
        root("autoRecoverSkipped") = "runtime_error_dialog"
    ElseIf eb = 0 And (barsSuspended Or stateSource = "ebMode+commandBars") Then
        Set root("autoRecover") = McpDb.DbNudgeBarsOut(Me)
        st = GetIdeStateEx(stateSource, barsSuspended)
        root("state") = st
        root("running") = (st = "run")
        root("notRunning") = (st = "design")
        root("commandBarsSuspended") = barsSuspended
        root("stateSource") = stateSource
    End If
    ' the pump gate is MEASURABLE from a read-only tool, so a caller can see that a
    ' pump was WITHHELD (and why) instead of having to guess. Additive; no new tool, no
    ' parameter change.
    Set root("pump") = PumpStatsObj()
    ' read-only wheel state next to the IDE state (pure addition; no new tool
    ' and no description change, so no re-freeze). See WinOps.WheelStateObj for the
    ' three-reason decision table.
    StampWheelNow root
    ' the cancel{} block, with a FIXED key set on every path.
    Dim cb As Object
    Set cb = CancelRequestBody("ide_state", cancelTarget, cancelInflight)
    If cb Is Nothing Then
        Set cb = CreateObject("Scripting.Dictionary")
        cb("requested") = cancelInflight
        cb("applied") = False
        cb("targetTool") = ""
        cb("targetKind") = ""
        cb("sinceMs") = 0
        cb("depth") = m_callDepth
        cb("reason") = "internal_error"
        cb("honorMinMs") = CANCEL_HONOR_MIN_MS
        cb("note") = "the cancel request could not be evaluated; nothing was changed"
    End If
    Set root("cancel") = cb
    ' (C / defect #10): the release{} block, with a FIXED key set on every path
    ' (same discipline as cancel{} above). This read-only tool is the only channel that is
    ' still served while the gate is stuck, so it is where the forced release lives.
    Dim rb As Object
    Set rb = ReleaseRequestBody(releaseInflight, releaseMinHeldMs)
    If rb Is Nothing Then
        Set rb = CreateObject("Scripting.Dictionary")
        rb("attempted") = True
        rb("released") = False
        rb("reason") = "internal_error"
        rb("note") = "the release request could not be evaluated; nothing was changed"
    End If
    Set root("release") = rb
    ' R-1021-05: the CACHED runtime-error capture, ADDITIVE and ABSENT when none exists
    ' (no tool, no parameter: the key appears only after a capture measured the engine).
    Dim le As Object
    Set le = McpRe.ReErrorCacheBlock(Me)
    If Not le Is Nothing Then
        ' RE-1 (34a): the structured error block is stored on the cached capture, so it
        ' is merged HERE (calling side) and McpRe.ReErrorCacheBlock keeps its key set
        ' unchanged (McpRe.bas is NOT part of this batch).
        If Not m_lastRuntimeError Is Nothing Then
            If m_lastRuntimeError.Exists("err") Then
                Set le("err") = m_lastRuntimeError("err")
                le("errBasis") = m_lastRuntimeError("errBasis")
                Set le("errChannel") = m_lastRuntimeError("errChannel")
                Set le("errCrossCheck") = m_lastRuntimeError("errCrossCheck")
                Set le("errLocation") = m_lastRuntimeError("errLocation")
            End If
        End If
        Set root("lastError") = le
    End If

    ' P1#1: mode is ALWAYS present in the success receipt (additive; state stays the raw value).
    Dim mb As Object
    Set mb = IdeModeBlock(st, stateSource, eb)
    root("mode") = CStr(mb("mode"))
    root("modeBasis") = CStr(mb("modeBasis"))
    If mb.Exists("modeConflict") Then Set root("modeConflict") = mb("modeConflict")
    ToolIdeState = JsonStringify(root)
End Function

' (C): build the release{} block of an ide_state receipt. The KEY SET is fixed
' and identical on every path, exactly like cancel{} (discipline 98).
Private Function ReleaseRequestBody(ByVal requested As Boolean, ByVal minHeldMs As Long) As Object
    If requested Then
        If minHeldMs <= 0 Then minHeldMs = GATE_RELEASE_MIN_MS
        Set ReleaseRequestBody = ForceReleaseGate("ide_state", "forced_release", minHeldMs, 1)
        Exit Function
    End If
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("attempted") = False
    d("released") = False
    d("releasedTool") = ""
    d("releasedKind") = ""
    d("heldMs") = 0
    d("minHeldMs") = GATE_RELEASE_MIN_MS
    d("retryAfterMs") = 0
    d("depthBefore") = m_callDepth
    d("depthAfter") = m_callDepth
    d("targetDepth") = 1
    d("mutBusyBefore") = m_mutBusy
    d("abandonedSeq") = 0
    d("reason") = "not_requested"
    d("gateReleaseCount") = m_gateReleaseCount
    d("statementInterrupted") = False
    d("timeoutMsEnforcedBy") = "gate_age_threshold"
    d("note") = "pass release_inflight=true (optionally release_min_held_ms) to FORCE-RELEASE the single-flight gate of a call that never came back. Read-only, so it is served while the gate is held."
    d("recoveryAction") = ""
    d("recoveryHint") = ""
    Set ReleaseRequestBody = d
End Function

' The IDE main window caption. RUN mode suspends the VBIDE object model, so fall
