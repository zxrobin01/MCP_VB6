Public Function ToolsListResultJson() As String
    ' Unchanged contract: this hands back the SAME JSON text the uncached
    ' JsonRpcResult(id, BuildToolsListResult()) produced.
    If m_tlOff = 0 Then
        m_tlOff = 1
        If Trim$(Environ$("VB6MCP_TOOLS_CACHE")) = "0" Then m_tlOff = -1
    End If
    If m_tlOff = 1 Then
        If Len(m_tlJson) > 0 Then
            WinOps.WoProfCacheHit Len(m_tlJson)
            ToolsListResultJson = m_tlJson
            Exit Function
        End If
    End If
    Dim t0 As Double, s As String, tag As String
    tag = "off"
    If m_tlOff = 1 Then tag = "on"
    t0 = WinOps.WoProfNow()
    s = JsonStringify(BuildToolsListResult())
    WinOps.WoProfCacheMiss Len(s)
    Util.LogLine "toolslist build us=" & CStr(CLng(WinOps.WoProfNow() - t0)) & " bytes=" & CStr(Len(s)) & " tools=" & CStr(ToolCount()) & " cache=" & tag
    If m_tlOff = 1 Then m_tlJson = s
    ToolsListResultJson = s
End Function

' A1: the tool-face builder lives in McpFace.bas; CodeTools.cls stays the state host.
Public Function BuildToolsListResult() As Object
    Set BuildToolsListResult = McpFace.BuildToolsListResult(m_tlRootOff, m_tlRoot)
End Function

