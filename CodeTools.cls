                ' the authoritative 5-argument callstack call
                outText = Vba6Probe.CallstackFunctionJson(JsonGetLong(args, "cs_fn", -1))
            ElseIf JsonGetBool(args, "mem_dump", False) Then
                ' "mem_rva" may NAME the image -- "vb6+0x1234" or
                ' "vba6+0x1234". A plain number keeps its historic VBA6.DLL meaning,
                ' so no existing caller changes behaviour.
                Dim r23Spec As String, r23Which As String, r23Rva As Long, r23Mod As Long
                r23Spec = JsonGetStr(args, "mem_rva")
                r23Rva = Vba6Probe.ResolveRvaSpec(r23Spec, r23Which)
                r23Mod = 0
                If r23Which = "vb6" Then r23Mod = Vba6Probe.HostBase()
                Dim r13AddrRaw As String, r13Addr2 As Long, r13Over2 As Boolean
                r13AddrRaw = JsonGetStr(args, "mem_addr")
                If Len(r13AddrRaw) = 0 Then
                    outText = Vba6Probe.MemDumpJson(r23Rva, 0, JsonGetLong(args, "mem_len"), r23Mod)
                ElseIf Not TryParseHexOrLong(r13AddrRaw, r13Addr2, r13Over2) Then
                    outText = ArgRangeJson("vba6_probe", "mem_addr", r13AddrRaw, r13Over2)
                Else
                    outText = Vba6Probe.MemDumpJson(r23Rva, r13Addr2, JsonGetLong(args, "mem_len"), r23Mod)
                End If
            ElseIf JsonGetBool(args, "worker_call", False) Then
                outText = Vba6Probe.WorkerCallJson(JsonGetStr(args, "worker_text"), JsonGetBool(args, "worker_bstr", True), JsonGetLong(args, "worker_p1", 1), JsonGetLong(args, "worker_p2", 1), JsonGetLong(args, "worker_p3", 0), JsonGetLong(args, "worker_p4", 0), JsonGetLong(args, "worker_p5", 1), JsonGetLong(args, "worker_p6", 1), JsonGetLong(args, "worker_p7", 0), JsonGetBool(args, "worker_set_bit", False), JsonGetBool(args, "worker_p2_engine", False))
            ElseIf Len(JsonGetStr(args, "rva_call")) > 0 Then
                ' "rva_call" may carry an argument list after ';',
                ' e.g. "0x61D34;0,4,0" -> CallRvaArgsJson (N args, N<=6).
                Dim rcCallSpec As String, rcCallSemi As Long, rcPipe As Long, rcDumpLen As Long
                rcCallSpec = JsonGetStr(args, "rva_call")
                ' a leading "vb6:" targets the HOST image (VB6.EXE),
                ' e.g. "vb6:0x1234;a1,a2". No prefix = VBA6.DLL (unchanged).
                Dim r23Mod2 As Long
                r23Mod2 = 0
                If LCase$(Left$(rcCallSpec, 4)) = "vb6:" Then
                    r23Mod2 = Vba6Probe.HostBase()
                    rcCallSpec = Mid$(rcCallSpec, 5)
                End If
                ' optional "|dump=N" -> atomic create+dump of the returned pointer
                rcDumpLen = 0
                rcPipe = InStr(rcCallSpec, "|dump=")
                If rcPipe > 0 Then
                    rcDumpLen = CLng(Val(Mid$(rcCallSpec, rcPipe + 6)))
                    rcCallSpec = Left$(rcCallSpec, rcPipe - 1)
                End If
                rcCallSemi = InStr(rcCallSpec, ";")
                If rcCallSemi > 0 Then
                    outText = Vba6Probe.CallRvaArgsJson(ParseHexOrLong(Left$(rcCallSpec, rcCallSemi - 1)), Mid$(rcCallSpec, rcCallSemi + 1), rcDumpLen, r23Mod2)
                Else
                    outText = Vba6Probe.CallRvaJson(ParseHexOrLong(rcCallSpec), JsonGetLong(args, "rva_argc"), JsonGetLong(args, "rva_a1"), JsonGetLong(args, "rva_a2"), r23Mod2)
                End If
            ElseIf JsonGetBool(args, "frame_set", False) Then
                outText = Vba6Probe.CallFrameSetterJson(JsonGetLong(args, "frame_set_a1"), JsonGetLong(args, "frame_set_a2", 1))
            ElseIf JsonGetBool(args, "frame_probe", False) Then
                outText = Vba6Probe.FrameStateJson()
            ElseIf JsonGetBool(args, "exec_probe", False) Then
                ' (R17): the exec probe goes through a wrapper that splits
                ' "the statement raised" from "the forward/channel died" and carries the VB
                ' error as structure. The other probe branches are untouched.
                outText = ToolVba6ExecProbe(args)
            Else
                outText = Vba6Probe.ProbeRunJson(JsonGetBool(args, "run_break_probes", False), JsonGetBool(args, "force", False), JsonGetStr(args, "ident"), JsonGetStr(args, "step"), JsonGetLong(args, "frame_index"))
            End If
        Case "project_changes"
            outText = Changes.RevisionJson(JsonGetLong(args, "since", 0), JsonGetBool(args, "clear", False))
        Case "export_public_api"
            outText = UnknownArgRefusal(args, "export_public_api", "|name|membersOnly|")
            If Len(outText) = 0 Then outText = ToolExportPublicApi(JsonGetStr(args, "name"), JsonGetBool(args, "membersOnly", False))
        Case "check_public_api"
            outText = UnknownArgRefusal(args, "check_public_api", "|name|baseline|membersOnly|")
            If Len(outText) = 0 Then outText = ToolCheckPublicApi(JsonGetStr(args, "name"), JsonGetStr(args, "baseline"), JsonGetBool(args, "membersOnly", False))
        Case "dependency_graph"
            outText = ToolDependencyGraph(JsonGetLong(args, "char_quota", 0), JsonGetLong(args, "budget_ms", 0))
        Case "purity_check"
            outText = ToolPurityCheck(JsonGetStr(args, "name"))
        Case "generate_stub"
            outText = ToolGenerateStub(JsonGetStr(args, "name"))
        Case "record_fixture"
            outText = Fixture.FixRecordJson(ResolvePath(JsonGetStr(args, "path")), JsonGetStr(args, "text"))
        Case "compare_fixture"
            outText = Fixture.FixCompareJson(ResolvePath(JsonGetStr(args, "path")), JsonGetStr(args, "text"))
        Case "ext_list"
            outText = Extensions.ListJson()
        Case "ext_enable"
            outText = Extensions.EnableJson(JsonGetStr(args, "name"))
            ToolsCachesReset
        Case "ext_disable"
            outText = Extensions.DisableJson(JsonGetStr(args, "name"))
            ToolsCachesReset
        Case "ext_reload"
            outText = Extensions.ReloadJson()
            ToolsCachesReset
        Case "ext_install"
            outText = Extensions.InstallJson(ResolvePath(JsonGetStr(args, "path")))
            ToolsCachesReset
        Case "ext_uninstall"
            outText = Extensions.UninstallJson(JsonGetStr(args, "name"))
            ToolsCachesReset
        Case "workspace_status"
            outText = ToolWorkspaceStatus(JsonGetStr(args, "repo"))
        Case "verify_scope"
            outText = ToolVerifyScope(AnyObjOf(args, "components"), JsonGetStr(args, "path"), JsonGetStr(args, "baseline"), JsonGetBool(args, "requireCompiler", False))
        Case "todo_status"
            outText = ToolTodoStatus()
        Case "mcp_info"
            outText = ToolMcpInfo()
        Case "replace_in_files"
            outText = ToolReplaceInFiles(JsonGetStr(args, "path"), JsonGetStr(args, "query"), JsonGetStr(args, "replacement"), _
                JsonGetBool(args, "regex", False), JsonGetBool(args, "dry_run", True), AnyObjOf(args, "expected_shas"), _
                JsonGetStr(args, "validate", "warn"), JsonGetLong(args, "max_files"))
        Case "undo_edit"
            outText = ToolUndoEdit(JsonGetStr(args, "component"), JsonGetStr(args, "action", "restore"), _
                JsonGetStr(args, "ts"), JsonGetBool(args, "to_disk", False))
        Case Else
            ' extension library dispatch (returns empty when the name is not ours)
            outText = Extensions.Dispatch(name, args)
            If Len(outText) = 0 Then Err.Raise vbObjectError + 100, "CodeTools", "Unknown tool: " & name
DispatchTail:
    ' R-1021-03 A3: non-exception abort fallback (a pump loop under On Error Resume Next
    ' can swallow the raise; the tag recorded by PumpHook is still pending here).
    If m_callDepth = 1 Then
        If Util.AbortPending() Then
            If InStr(1, outText, """reason"":""timeout""", vbTextCompare) = 0 Then
                If InStr(1, outText, """stopReason"":""timeout""", vbTextCompare) = 0 Then
                    If InStr(1, outText, "cancelled_by_request", vbTextCompare) = 0 Then outText = AbortReceiptFor(name, args)
                End If
            End If
        End If
    End If
    ' R-1021-02: attach a completed deferredStart to ANY JSON receipt (not only
    ' Start-class calls), so a deferred restart result can never be lost.
    outText = RunDiskDeferredSplice(outText)
    ' R12: the live desktop{} block on the input-family receipts (measured, never inferred).
    ' send_window_message is NOT refused on a non-interactive desktop: its PostMessage path
    ' was measured to deliver while another process owned the foreground.
    Select Case name
    Case "send_window_message", "activate_component", "native_breakpoint"
        If Len(outText) > 0 Then outText = JsonPrependMembers(outText, WinOps.WoDesktopFieldsJson())
    Case "set_codepane"
        If JsonGetBool(args, "activate", False) And Len(outText) > 0 Then outText = JsonPrependMembers(outText, WinOps.WoDesktopFieldsJson())
    End Select
    End Select
    item("text") = StampMcp(ModalDialogsBodySuffix(SealedReceipt(name, outText)))
    content.Add item
    Set res("content") = content
    res("isError") = False
    Audit.AuditAdd name, "ok", Left$(outText, 200)
    Set CallToolInner = res
    Exit Function
Fail:
    ' never surface an empty message: an empty Err.Description used to come back
    ' as a bare "Error: " that hid the real cause
    Dim failMsg As String
    failMsg = Err.Description
    If Len(failMsg) = 0 Then failMsg = "error " & CStr(Err.Number) & " in " & Err.Source
    ' (contract v1.3.2): capture the error number HERE, once, and clear it.
    ' VB6@s Err object is per-thread and persists; several helpers run between this point
    ' and the JSON builders, so re-reading Err late could attribute a stale or unrelated
    ' code to this receipt. Only this captured value is ever reported.
    Dim failVbErr As Long
    failVbErr = Err.Number
    Err.Clear
    Audit.AuditAdd name, "error", failMsg
    ' R-1021-03 A3: a swallowed abort can surface as an unrelated error; the recorded
    ' tag is authoritative. Never overwrite a receipt that already says timeout/cancelled.
    If m_callDepth = 1 Then
        If Util.AbortPending() Then
            Dim abRes As Object, abContent As Object, abItem As Object
            Set abRes = CreateObject("Scripting.Dictionary")
            Set abContent = New Collection
            Set abItem = CreateObject("Scripting.Dictionary")
            abItem("type") = "text"
            abItem("text") = StampMcp(ModalDialogsBodySuffix(SealedReceipt(name, AbortReceiptFor(name, args))))
            abContent.Add abItem
            Set abRes("content") = abContent
            abRes("isError") = False
            Set CallToolInner = abRes
            Exit Function
        End If
    End If
    ' a tagged guard is a REFUSAL, not an error - answer it with the same
    ' structured shape as GuardReject (ok:false + reason), not a bare message.
    If Left$(failMsg, 10) = "MCPREASON:" Then
        Dim mcpRes As Object, mcpContent As Object, mcpItem As Object
        Set mcpRes = CreateObject("Scripting.Dictionary")
        Set mcpContent = New Collection
        Set mcpItem = CreateObject("Scripting.Dictionary")
        mcpItem("type") = "text"
        mcpItem("text") = StampMcp(ModalDialogsBodySuffix(SealedReceipt(name, McpReasonJson(failMsg, name, args))))
        mcpContent.Add mcpItem
        Set mcpRes("content") = mcpContent
        mcpRes("isError") = False
        Set CallToolInner = mcpRes
        Exit Function
    End If
    ' Contract v1.1.0 (non-schema): while the debugger is stopped the
    ' IDE refuses source writes with a bare localized "permission denied". That is not
    ' a generic failure - the caller must be told WHY and how to recover, so a raw
    ' VB6 permission error in break mode is answered structurally.
    If IsIdeBusyPermissionError(failMsg) Then
        item("text") = StampMcp(ModalDialogsBodySuffix(SealedReceipt(name, IdeBusyBreakJson(name, failMsg, failVbErr))))
        content.Add item
        Set res("content") = content
        res("isError") = True
        Set CallToolInner = res
        Exit Function
    End If
    ' (the refusal-classification finding): a CLASSIFIED condition (our own raise whose message family
    ' is known, or a measured native VB/COM code) answers with a branchable STRUCTURED
    ' refusal instead of the bare ok:false/reason:"unexpected_error" envelope. This runs
    ' only after the MCPREASON branch and the IDE-busy branch, i.e. only on calls that used
    ' to answer unexpected_error - the success path and every existing structured refusal
    ' never reach here. An empty return keeps the old envelope byte-identical.
    Dim clsRefusalJson As String
    clsRefusalJson = ClassifiedRefusalJson(name, failMsg, failVbErr)
    If Len(clsRefusalJson) > 0 Then
        ' FIX-19: anchor_not_unique / anchor_not_found are RAISED, so they reach THIS catch and
        ' never pass through BpSetJson - enrich the classified refusal with hits[] and the four
        ' fields here too, or the receipt stays field-less.
        If LCase$(name) = "breakpoints" Then clsRefusalJson = BpEnrichRefusal(clsRefusalJson, args)
        item("text") = StampMcp(ModalDialogsBodySuffix(SealedReceipt(name, clsRefusalJson)))
        content.Add item
        Set res("content") = content
        res("isError") = False
        Set CallToolInner = res
        Exit Function
    End If
    ' structured envelope for an unexpected VB error (the tagged-guard and
    ' break-mode branches above are unchanged).
    ' /: a native VB 438 on ANY tool class is answered with a STRUCTURED refusal
    ' (reason:"ide_model_not_ready") carrying the RAW IDE message and a retry hint, instead of
    ' the unexpected_error catch-all below. It sits AFTER the ClassifiedRefusalJson branch so
    ' every already-classified condition is untouched, and an empty return means "not this
    ' case" - the old envelope then stays byte-identical.
    Dim modelRefusalJson As String
    modelRefusalJson = IdeModelNotReadyJson(name, failMsg, failVbErr)
    If Len(modelRefusalJson) > 0 Then
        item("text") = StampMcp(ModalDialogsBodySuffix(SealedReceipt(name, modelRefusalJson)))
        content.Add item
        Set res("content") = content
        res("isError") = False
        Set CallToolInner = res
        Exit Function
    End If
    item("text") = StampMcp(ModalDialogsBodySuffix(SealedReceipt(name, UnexpectedErrorJson(name, failMsg, failVbErr))))
    content.Add item
    Set res("content") = content
    res("isError") = True
    Set CallToolInner = res
End Function

' =====================================================================
' project tools
' =====================================================================

Private Function ToolGetProjectInfo() As String
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    ' ideState works in every mode (toolbar + caption fallback)
    d("ideState") = GetIdeState()
    ' ---------------------------------------------------------------------------
    ' "no project open" is a LEGAL IDE state, not a fault. It used to fall
    ' out of GetProject() as a raw VB error and came back as ok:false/unexpected_error,
    ' which made the STATE AXIS unusable exactly when a caller needs it (right after
    ' remove_project, with the settings form open, or from automation). The question is
    ' answered instead of failing it: name/fileName are null, the lists are empty and
    ' noProject says so. (The probe used read this receipt's MISSING name as
    ' "name: null" - the shape is now explicit.)
    ' ---------------------------------------------------------------------------
    If m_vbe Is Nothing Then
        d("noProject") = True
        d("name") = Null
        d("fileName") = Null
        d("componentCount") = 0
        Set d("components") = New Collection
        Set d("references") = New Collection
        Set d("projects") = New Collection
        d("projectPath") = Null
        d("realProjectPath") = Null
        d("projectPathIsAlias") = False
        d("realPathTier") = 0
        d("realPathError") = ""
        d("warning") = ""
        d("refsBase") = ""
        d("refsFromAlias") = RefsFromAliasOn()
        d("note") = "the add-in has no live VBIDE connection; nothing could be read"
        ToolGetProjectInfo = JsonStringify(d)
        Exit Function
    End If
    If m_vbe.VBProjects.Count = 0 Then
        d("noProject") = True
        d("name") = Null
        d("fileName") = Null
        d("componentCount") = 0
        Set d("components") = New Collection
        Set d("references") = New Collection
        Set d("projects") = New Collection
        d("projectPath") = Null
        d("realProjectPath") = Null
        d("projectPathIsAlias") = False
        d("realPathTier") = 0
        d("realPathError") = ""
        d("warning") = ""
        d("refsBase") = ""
        d("refsFromAlias") = RefsFromAliasOn()
        d("note") = "no project is open in the IDE; the project-scoped fields are null/empty"
        ToolGetProjectInfo = JsonStringify(d)
        Exit Function
    End If
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    ' run mode locks most VBProject properties ('Access denied'): read
    ' them all under On Error Resume Next and emit what we can
    On Error Resume Next
    d("name") = p.Name
    d("fileName") = p.FileName
    d("projectType") = McpProjTools.ProjectTypeName(Me, p)
    d("description") = p.Description
    d("vbVersion") = m_vbe.Version
    d("vbeName") = m_vbe.Name
    d("vbeFullName") = m_vbe.FullName
    d("templatePath") = m_vbe.TemplatePath
    d("projectSaved") = p.Saved
    d("helpFile") = p.HelpFile
    d("helpContextID") = p.HelpContextID
    d("buildFileName") = p.BuildFileName
    d("compatibleOleServer") = p.CompatibleOleServer
    d("startMode") = StartModeName(p)
    Dim sup As Variant
    sup = p.VBComponents.StartUpObject
    If Not IsNull(sup) And Not IsEmpty(sup) Then d("startupObject") = CStr(sup)
    d("groupFileName") = m_vbe.VBProjects.FileName
    Dim sp As VBIDE.VBProject
    Set sp = m_vbe.VBProjects.StartProject
    If Not sp Is Nothing Then d("startProject") = sp.Name
    d("readOnlyMode") = m_vbe.ReadOnlyMode
    d("displayModel") = DisplayModelName()
    Set d("components") = ComponentListArr()
    ' componentCount exists in BOTH the normal and the no-project receipt, so a
    ' caller does not have to special-case the field; 0 means "no components" in either state.
    d("componentCount") = d("components").Count
    Set d("references") = ReferenceListArr()
    Set d("projects") = McpProjTools.ProjectListArr(Me)
    On Error GoTo 0
    ' P1/P12: the spelling the project was opened with, the canonical path it really
    ' lives at, and the base the relative Reference= paths are computed from.
    Dim pInfo As Object
    Set pInfo = McpProjTools.ProjectPathInfo(Me, p)
    d("projectPath") = pInfo("projectPath")
    d("realProjectPath") = pInfo("realProjectPath")
    d("projectPathIsAlias") = pInfo("projectPathIsAlias")
    d("realPathTier") = pInfo("realPathTier")
    d("realPathError") = pInfo("realPathError")
    d("warning") = pInfo("warning")
    If Len(CStr(pInfo("warningDetail"))) > 0 Then d("warningDetail") = pInfo("warningDetail")
    d("refsBase") = pInfo("refsBase")
    d("refsFromAlias") = pInfo("refsFromAlias")
    d("noProject") = False      ' ALWAYS present (true in the two no-project branches above)
    ToolGetProjectInfo = JsonStringify(d)
End Function

Private Function ToolSetProjectOptions(ByVal description As String, ByVal helpFile As String, ByVal helpContextId As Long, ByVal startupObject As String, ByVal startProject As String, ByVal buildFileName As String, ByVal activeProject As String, ByVal readOnlyMode As Boolean, ByVal readOnlyModeSet As Boolean) As String
    Dim p As VBIDE.VBProject
    Set p = GetProject()
    Dim applied As Object
    Set applied = New Collection
    ' FIX-32: the property puts below make the IDE persist the PROJECT FILE, and
    ' that write used to be invisible (filesWritten:[]). Take the before-print of
    ' the project files HERE so the write is reported with its own bytes+sha.
    Dim f32Ctx As Object
    Dim f32Book As Object
    Set f32Ctx = F32SnapBegin("project-option-write")
    On Error GoTo Fail
    If Len(description) > 0 Then
        p.Description = description
        applied.Add "description"
    End If
    If Len(helpFile) > 0 Then
        p.HelpFile = helpFile
        applied.Add "helpFile"
    End If
    If helpContextId <> 0 Then
        p.HelpContextID = helpContextId
        applied.Add "helpContextID"
    End If
    Dim startupObjectError As String
    startupObjectError = ""
    If Len(startupObject) > 0 Then
        Dim vbps0 As VBIDE.VBComponents
        Set vbps0 = p.VBComponents
        ' this build rejects the VBIDE StartUpObject put for EVERY value
        ' (measured: "Sub Main", the module name and the form name all raise
        ' "invalid procedure call or argument"), so report it structurally and let the
        ' other options still apply instead of failing the whole call.
        On Error Resume Next
        Err.Clear
        vbps0.StartUpObject = startupObject
        If Err.Number <> 0 Then
            startupObjectError = Err.Description & " (0x" & Hex$(Err.Number) & ")"
            Err.Clear
        End If
        On Error GoTo Fail
        If Len(startupObjectError) = 0 Then applied.Add "startupObject"
    End If
    If Len(buildFileName) > 0 Then
        p.BuildFileName = buildFileName
        applied.Add "buildFileName"
    End If
    If Len(startProject) > 0 Then
        Dim tgt As VBIDE.VBProject
        Set tgt = McpFindTools.FindProject(Me, startProject)
        Dim vbps1 As VBIDE.VBProjects
        Set vbps1 = m_vbe.VBProjects
        vbps1.StartProject = tgt
        applied.Add "startProject"
    End If
    If Len(activeProject) > 0 Then
        Dim ap As VBIDE.VBProject
        Set ap = McpFindTools.FindProject(Me, activeProject)
        Set m_vbe.ActiveVBProject = ap
        applied.Add "activeProject"
    End If
    If readOnlyModeSet Then
        m_vbe.ReadOnlyMode = IIf(readOnlyMode, 1, 0)
        applied.Add "readOnlyMode"
    End If
    ' FIX-32: the puts above have run - compare the project files on disk and put
    ' the result on the receipt (diskWrites[] with before/after bytes+sha for a
    ' CONTENT change, touchedFiles[] for an identical rewrite, two EMPTY arrays
    ' when this call wrote nothing).
    MaybePump
    Set f32Book = F32SnapFinish(f32Ctx, "project-option-write", "set_project_options")
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    root("project") = p.Name
    Set root("applied") = applied
    Call F32AttachBook(root, f32Book)
    If Len(startupObjectError) > 0 Then
        root("startupObjectError") = startupObjectError
        root("startupObjectWorkaround") = "the VBIDE StartUpObject put is rejected on this build for every value; the supported route is the project file: set Startup=""<FormName|Sub Main>"" in the .vbp and reopen the project (measured: with Startup=""Sub Main"" a run starts at modMain.Main)"
    End If
    ToolSetProjectOptions = JsonStringify(root)
    Exit Function
Fail:
    Err.Raise vbObjectError + 43, "CodeTools", "set_project_options failed: " & Err.Description
End Function

' FIX-19: the project OPEN/ADD/REMOVE family must never enter a synchronous VBProjects host
' call while the IDE is in break/run: that path has wedged and crashed VB6 (measured WER
' c0000005 in VBA6). Refuse structurally instead; NEVER end the user's program for them.



' ===================== 3a host-write accounting =====================
' MEASURED 2026-10-23: VBProjects.Remove (and open_project's preSave+close path) silently
' writes the unsaved project into the IDE CURRENT DIRECTORY (and, for a NAMED project, into
' that project's own directory) and can overwrite same-named component files; the old
' receipts reported discardedUnsavedChanges:true / filesWritten:[] / savedBeforeClose:true
' while that happened. VBProject.Saved is READ-ONLY in VBIDE (an isolated diag build fails
' to compile with a read-only-property error), so the write CANNOT be suppressed from the
' add-in - these helpers only report it honestly.
' Snapshots are best effort: depth 1, fail-open, capped at 2000 files per directory.

Private Function EmptyColl() As Object
    Set EmptyColl = New Collection
End Function

Private Function HostWritePreventedWhy() As String
    HostWritePreventedWhy = "VBProject.Saved is read-only in VBIDE (measured 2026-10-23 in an isolated diag build: cannot assign to a read-only property), so a host write cannot be suppressed from the add-in"
End Function

' ===================== 33b: dirty + UNTITLED close-path gate =====================
' MEASURED 33a (21 sessions): closing a DIRTY UNTITLED project makes VB6 persist it into
' the IDE current directory (工程1.vbp/.vbw + component files, overwriting same-named files)
' and VBProject.Saved is read-only, so the write cannot be suppressed. 33b therefore REFUSES
' that close by default with a structured receipt and ZERO disk writes; allowHostWrite:true
' restores the 3a behaviour (write + honest hostWrites/sideEffects report).
Private Function ProjectIsUntitled(ByVal p As VBIDE.VBProject, ByRef known As Boolean) As Boolean
    ProjectIsUntitled = False
    known = False
    If p Is Nothing Then Exit Function
    On Error Resume Next
    Dim fn As String
    Err.Clear
    fn = p.FileName
    If Err.Number <> 0 Then
        Err.Clear
        Exit Function
    End If
    On Error GoTo 0
    known = True
    If Len(fn) = 0 Then ProjectIsUntitled = True
End Function

' 33b.1 S1: the component-level dirty flag is VBComponent.IsDirty. VBComponent.Saved is NOT a
' member of that interface on this build - reading it raises 438 (object does not support this
' property or method), which is what made the 33b dirtyComponents[] list permanently empty.
' Both close paths (open_project's exclusive gate and remove_project) call THIS one helper, so
' they cannot disagree about the component list or about whether it could be read at all.
'   probe   = "readable" | "unreadable" | "none" (no project / no components)
'   errs    = [{name,errorNumber,errorDescription}] for every component whose flag raised
'   unknown = True when ANY component flag was unreadable (the list is then released as Null,
'             never as an empty array pretending 'nothing is dirty')
Private Function ComponentDirtyProbe(ByVal p As VBIDE.VBProject, ByRef probe As String, _
        ByRef errs As Object, ByRef unknown As Boolean, ByRef componentCount As Long) As Object
    Dim found As Object
    Set found = Nothing
    Set errs = New Collection
    probe = "none"
    unknown = False
    componentCount = 0
    If p Is Nothing Then Exit Function
    On Error Resume Next
    Dim cmps As Object
    Set cmps = Nothing
    Err.Clear
    Set cmps = p.VBComponents
    If Err.Number <> 0 Then
        Err.Clear
        probe = "unreadable"
        unknown = True
        On Error GoTo 0
        Exit Function
    End If
    On Error GoTo 0
    If cmps Is Nothing Then Exit Function
    Set found = New Collection
    Dim vc As VBIDE.VBComponent
    Dim isD As Boolean
    Dim readCount As Long
    Dim failCount As Long
    readCount = 0
    failCount = 0
    For Each vc In cmps
        componentCount = componentCount + 1
        isD = False
        On Error Resume Next
        Err.Clear
        isD = CBool(vc.IsDirty)
        If Err.Number <> 0 Then
            failCount = failCount + 1
            Dim erec As Object
            Set erec = CreateObject("Scripting.Dictionary")
            erec("name") = vc.Name
            erec("errorNumber") = Err.Number
            erec("errorDescription") = Err.Description
            errs.Add erec
            Err.Clear
        Else
            readCount = readCount + 1
            If isD Then
                Dim drec As Object
                Set drec = CreateObject("Scripting.Dictionary")
                drec("name") = vc.Name
                drec("isDirty") = True
                Dim ln As Long
                ln = 0
                Err.Clear
                ln = vc.CodeModule.CountOfLines
                If Err.Number <> 0 Then ln = 0 : Err.Clear
                If ln > 0 Then drec("lines") = ln
                found.Add drec
            End If
        End If
        Err.Clear
        On Error GoTo 0
    Next vc
    If failCount > 0 Or readCount = 0 Then
        If failCount > 0 Then
            unknown = True
            probe = "unreadable"
        End If
    Else
        probe = "readable"
    End If
    If unknown Then
        Set found = Nothing
        probe = "unreadable"
    End If
    Set ComponentDirtyProbe = found
End Function

' Compare two HostDirSnapshot() results by NAME + size + mtime - the three facts the snapshot
' carries. True means the directory looked identical between the two scans.
Private Function HostScansEqual(ByVal a As Object, ByVal b As Object) As Boolean
    HostScansEqual = False
    On Error Resume Next
    If a Is Nothing Or b Is Nothing Then Exit Function
    If a.Count <> b.Count Then Exit Function
    Dim k As Variant
    Dim ea As Object
    Dim eb As Object
    For Each k In a.Keys
        If Not b.Exists(k) Then Exit Function
        Set ea = a(k)
        Set eb = b(k)
        If CStr(ea("size")) <> CStr(eb("size")) Then Exit Function
        If CStr(ea("mtime")) <> CStr(eb("mtime")) Then Exit Function
    Next k
    HostScansEqual = True
    Err.Clear
End Function

' Structured refusal for the dirty+untitled close path. cwdCandidateFiles lists the files
' that ALREADY sit in the IDE current directory (depth 1, the same coverage as hostWrites);
' they are the same-named files a host write could overwrite.
' 33b.1 S1: dirtyComponents is NULL when the component-level flags could not be read, and
' dirtyUnknown:true + componentProbe:"unreadable" + componentSavedReadErrors[] say exactly
' that. The refusal itself depends ONLY on the project-level evidence
' (VBProject.Saved=False AND untitled), never on the component list.
' 33b.1 S3: zeroWriteBasis publishes how the zero-write claim was checked (the IDE current
' directory is scanned again after the receipt is assembled).
Private Function DirtyUntitledRefusal(ByVal toolName As String, ByVal p As VBIDE.VBProject, _
        ByVal dirtyNames As Object, ByVal componentProbe As String, ByVal componentErrors As Object, _
        ByVal componentsUnknown As Boolean, ByVal dirtySource As String, _
        ByVal evidenceSource As String, ByVal requestedPath As String) As String
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = "dirty_untitled_would_write"
    d("tool") = toolName
    Dim nm As String
    nm = ""
    On Error Resume Next
    If Not p Is Nothing Then nm = p.Name
    If Err.Number <> 0 Then Err.Clear
    On Error GoTo 0
    d("projectName") = nm
    d("fileName") = ""
    d("untitled") = True
    If Len(requestedPath) > 0 Then d("requestedPath") = requestedPath
    d("dirtySource") = dirtySource
    d("evidenceSource") = evidenceSource
    d("dirtyUnknown") = componentsUnknown
    d("componentProbe") = componentProbe
    If componentsUnknown Or dirtyNames Is Nothing Then
        d("dirtyComponents") = Null
    Else
        Set d("dirtyComponents") = dirtyNames
    End If
    If componentErrors Is Nothing Then
        Set d("componentSavedReadErrors") = New Collection
    Else
        Set d("componentSavedReadErrors") = componentErrors
    End If
    Dim scanned As Long
    Dim truncated As Boolean
    Dim failed As Boolean
    Dim why As String
    Dim snap As Object
    Set snap = HostDirSnapshot(CurDir$, scanned, truncated, failed, why)
    Dim cand As Object
    Set cand = New Collection
    Dim k As Variant
    If Not failed Then
        Dim nm2 As String
        For Each k In snap.Keys
            nm2 = CStr(k)
            If Len(nm2) > 0 Then cand.Add nm2
        Next k
    End If
    Set d("cwdCandidateFiles") = cand
    d("cwdCandidateFilesScanned") = scanned
    d("cwdCandidateFilesTruncated") = truncated
    d("cwdCandidateFilesScanFailed") = failed
    If failed Then d("cwdCandidateFilesScanWhy") = why
    ' 33b.1 S3: re-scan AFTER assembling the receipt, so the zero-write claim is self-verifying.
    Dim snapPost As Object
    Dim scannedPost As Long
    Dim truncatedPost As Boolean
    Dim failedPost As Boolean
    Dim whyPost As String
    Set snapPost = HostDirSnapshot(CurDir$, scannedPost, truncatedPost, failedPost, whyPost)
    d("zeroWriteScanPre") = scanned
    d("zeroWriteScanPost") = scannedPost
    If failed Or failedPost Then
        If Len(why) > 0 Then
            d("zeroWriteBasis") = "cwd_scan_failed:" & why
        Else
            d("zeroWriteBasis") = "cwd_scan_failed:" & whyPost
        End If
    ElseIf HostScansEqual(snap, snapPost) Then
        d("zeroWriteBasis") = "pre_cwd_scan_equals_post_cwd_scan"
    Else
        d("zeroWriteBasis") = "cwd_changed_between_scans"
    End If
    d("why") = "the project is DIRTY and UNTITLED: closing it makes VB6 write the unsaved project into the IDE current directory (measured 33a: 工程1.vbp + 工程1.vbw + component files, and same-named Form1.frm overwritten). VBProject.Saved is read-only in VBIDE, so the add-in cannot suppress that write."
    d("howToProceed") = "call save_project first (the project then has a real file and is no longer untitled), or pass allowHostWrite=true to accept the host write - the receipt then reports hostWrites and sideEffects.filesWritten"
    d("note") = "nothing was closed, saved or written: the IDE project group and the IDE current directory are unchanged"
    DirtyUntitledRefusal = JsonStringify(d)
End Function

Private Function HostCwdInfo() As String
    On Error Resume Next
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Dim s As String
    s = "cwd=" & CurDir$
    If Err.Number = 0 Then s = s & " fsoCwd=" & fso.GetAbsolutePathName(".")
    If Err.Number <> 0 Then Err.Clear
    HostCwdInfo = s
End Function

Private Function HostWritesBasisFor(ByVal failed As Boolean, ByVal failWhy As String, ByVal coverage As String) As String
    HostWritesBasisFor = "best-effort diff of " & coverage & ", taken around the host Remove/close call; files outside those directories and rewrites that keep BOTH size and mtime are not distinguishable"
    If failed Then HostWritesBasisFor = HostWritesBasisFor & "; snapshot_failed: " & failWhy
End Function

Private Function HostDirSnapshot(ByVal folderPath As String, ByRef scanned As Long, ByRef truncated As Boolean, _
                                 ByRef failed As Boolean, ByRef failWhy As String) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    scanned = 0
    truncated = False
    failed = False
    failWhy = ""
    If Len(folderPath) = 0 Then
        Set HostDirSnapshot = d
        Exit Function
    End If
    On Error Resume Next
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Err.Number <> 0 Then
        failed = True
        failWhy = "fso_create " & CStr(Err.Number)
        Err.Clear
        On Error GoTo 0
        Set HostDirSnapshot = d
        Exit Function
    End If
    Dim folder As Object
    Set folder = fso.GetFolder(folderPath)
    If Err.Number <> 0 Then
        failed = True
        failWhy = "getfolder " & CStr(Err.Number)
        Err.Clear
        On Error GoTo 0
        Set HostDirSnapshot = d
        Exit Function
    End If
    Dim f As Object
    Dim nm As String
    Dim sz As Double
    Dim mtv As Date
    Dim mtText As String
    Dim e As Object
    For Each f In folder.Files
        scanned = scanned + 1
        ' scan cap: 2000 files (hostWritesTruncated = True when the cap is hit)
        If scanned > 2000 Then
            scanned = 2000
            truncated = True
            Exit For
        End If
        nm = ""
        sz = 0
        mtText = ""
        Err.Clear
        nm = f.Name
        If Err.Number = 0 Then
            Err.Clear
            sz = f.Size
            Err.Clear
            mtv = 0
            mtv = f.DateLastModified
            If Err.Number <> 0 Then
                Err.Clear
            Else
                mtText = Format$(mtv, "yyyy-mm-dd hh:nn:ss")
            End If
            Set e = CreateObject("Scripting.Dictionary")
            e("size") = sz
            e("mtime") = mtText
            e("path") = fso.BuildPath(folderPath, nm)
            Set d(nm) = e
        End If
        Err.Clear
    Next
    Err.Clear
    On Error GoTo 0
    Set HostDirSnapshot = d
End Function

Private Sub HostScanLog(ByVal tag As String, ByVal folderPath As String, ByVal scanned As Long, _
                        ByVal truncated As Boolean, ByVal failed As Boolean, ByVal why As String, ByVal snap As Object)
    On Error Resume Next
    Dim first As String
    Dim k As Variant
    Dim n As Long
    first = ""
    n = 0
    If Not snap Is Nothing Then
        For Each k In snap.Keys
            n = n + 1
            If n <= 5 Then
                If Len(first) > 0 Then first = first & ","
                first = first & CStr(k)
            End If
        Next
    End If
    OpLog "hostscan " & tag & " " & HostCwdInfo() & " dir=" & folderPath & " n=" & CStr(scanned) & " trunc=" & CStr(truncated) & " failed=" & CStr(failed) & " why=" & why & " first=" & first
    Err.Clear
End Sub

Private Function HostWritesFromSnapshots(ByVal before As Object, ByVal after As Object) As Object
    Dim out As Object
    Set out = New Collection
    On Error Resume Next
    If before Is Nothing Then
        Set HostWritesFromSnapshots = out
        Err.Clear
        Exit Function
    End If
    If after Is Nothing Then
        Set HostWritesFromSnapshots = out
        Err.Clear
        Exit Function
    End If
    Dim k As Variant
    Dim a As Object
    Dim b As Object
    Dim existedBefore As Boolean
    Dim overwritten As Boolean
    Dim sizeBefore As Double
    Dim sizeAfter As Double
    Dim mtBefore As String
    Dim mtAfter As String
    Dim rec As Object
    For Each k In after.Keys
        Set a = after(CStr(k))
        Set b = Nothing
        If before.Exists(CStr(k)) Then Set b = before(CStr(k))
        existedBefore = False
        sizeBefore = 0
        mtBefore = ""
        sizeAfter = 0
        mtAfter = ""
        If Not b Is Nothing Then
            existedBefore = True
            sizeBefore = CDbl(b("size"))
            mtBefore = CStr(b("mtime"))
        End If
        If Not a Is Nothing Then
            sizeAfter = CDbl(a("size"))
            mtAfter = CStr(a("mtime"))
        End If
        overwritten = False
        If existedBefore = True Then
            If sizeAfter <> sizeBefore Then
                overwritten = True
            ElseIf StrComp(mtAfter, mtBefore, vbBinaryCompare) <> 0 Then
                overwritten = True
            End If
        End If
        If existedBefore = False Or overwritten = True Then
            Set rec = CreateObject("Scripting.Dictionary")
            If Not a Is Nothing Then
                rec("path") = CStr(a("path"))
            Else
                rec("path") = ""
            End If
            rec("sizeBefore") = sizeBefore
            rec("sizeAfter") = sizeAfter
            rec("existedBefore") = existedBefore
            rec("overwritten") = overwritten
            out.Add rec
        End If
    Next
    Err.Clear
    On Error GoTo 0
    Set HostWritesFromSnapshots = out
End Function

' ONE bundle for the receipt: writes + basis + truncated + scanned. The diff covers the IDE
' current directory and (for a removed NAMED project) that project's own directory. Every
' written path is also noted into the side-effects block (filesWritten).
Private Function HostWriteBundleEx(ByVal beforeCwd As Object, ByVal beforeProj As Object, ByVal projDir As String, _
                                   ByRef truncated As Boolean, ByRef scanned As Long) As Object
    Dim s1 As Long
    Dim t1 As Boolean
    Dim f1 As Boolean
    Dim w1 As String
    Dim afterCwd As Object
    Set afterCwd = HostDirSnapshot(CurDir$, s1, t1, f1, w1)
    Call HostScanLog("after-cwd", CurDir$, s1, t1, f1, w1, afterCwd)
    Dim writes As Object
    Set writes = HostWritesFromSnapshots(beforeCwd, afterCwd)
    Dim coverage As String
    coverage = "the IDE current directory (CurDir$) depth 1"
    truncated = t1
    scanned = s1
    If Len(projDir) > 0 Then
        Dim sameFolder As Boolean
        sameFolder = True
        On Error Resume Next
        If LCase$(Trim$(projDir)) <> LCase$(Trim$(CurDir$)) Then sameFolder = False
        Err.Clear
        On Error GoTo 0
        If sameFolder = False Then
            Dim s2 As Long
            Dim t2 As Boolean
            Dim f2 As Boolean
            Dim w2 As String
            Dim afterProj As Object
            Set afterProj = HostDirSnapshot(projDir, s2, t2, f2, w2)
            Call HostScanLog("after-projdir", projDir, s2, t2, f2, w2, afterProj)
            Dim extra As Object
            Set extra = HostWritesFromSnapshots(beforeProj, afterProj)
            coverage = coverage & " + the removed project own directory (" & projDir & ") depth 1"
            truncated = (t1 Or t2)
            scanned = s1 + s2
            Dim j As Long
            Dim r2 As Object
            For j = 1 To extra.Count
                Set r2 = extra(j)
                If Not r2 Is Nothing Then writes.Add r2
            Next
        End If
    End If
    Dim bundle As Object
    Set bundle = CreateObject("Scripting.Dictionary")
    Set bundle("writes") = writes
    bundle("basis") = HostWritesBasisFor(f1, w1, coverage)
    bundle("truncated") = truncated
    bundle("scanned") = scanned
    Dim i As Long
    Dim rec As Object
    For i = 1 To writes.Count
        Set rec = writes(i)
        If Not rec Is Nothing Then SeNoteFile CStr(rec("path"))
    Next
    Set HostWriteBundleEx = bundle
End Function

Private Function HostWriteBundle(ByVal beforeCwd As Object, ByRef truncated As Boolean, ByRef scanned As Long) As Object
    Set HostWriteBundle = HostWriteBundleEx(beforeCwd, Nothing, "", truncated, scanned)
End Function

' 3a (B1): the receipt value for savedBeforeClose is the preSave RESULT, not the attempt.
' The preSave receipt itself only survives in the OpLog, so the decidable source is the
' Saved flag of every project that is about to be closed, read back AFTER the preSave.
' An untitled project cannot be flushed by ToolSaveProject("") -> its flag stays False.
Private Function PreCloseSaveInfoFor(ByVal needSave As Boolean, ByVal full As String) As Object
    Dim info As Object
    Set info = CreateObject("Scripting.Dictionary")
    Dim allSaved As Boolean
    Dim unreadable As Boolean
    Dim nChecked As Long
    Dim pj As VBIDE.VBProject
    Dim sv As Boolean
    Dim i As Long
    allSaved = True
    unreadable = False
    nChecked = 0
    On Error Resume Next
    For i = m_vbe.VBProjects.Count To 1 Step -1
        Set pj = m_vbe.VBProjects.Item(i)
        If Not pj Is Nothing Then
            If LCase$(pj.FileName) <> LCase$(full) Then
                nChecked = nChecked + 1
                sv = True
                Err.Clear
                sv = pj.Saved
                If Err.Number <> 0 Then
                    unreadable = True
                    Err.Clear
                ElseIf sv = False Then
                    allSaved = False
                End If
            End If
        End If
    Next
    Err.Clear
    On Error GoTo 0
    If unreadable Then allSaved = False
    info("attempted") = needSave
    info("result") = "not_attempted"
    If needSave = True Then
        If unreadable = True Then
            info("result") = "saved_flag_unreadable"
        ElseIf allSaved = True And nChecked > 0 Then
            info("result") = "all_saved"
        Else
            info("result") = "still_unsaved"
        End If
    End If
    info("saved") = (needSave And allSaved And nChecked > 0)
    info("projectSavedAfter") = (allSaved And nChecked > 0)
    info("basis") = "Saved flag read back after preSave (VB6 Saved is a dirty flag, not a disk digest; see FIX-21)"
    Set PreCloseSaveInfoFor = info
End Function
Private Function ToolOpenProject(ByVal path As String, ByVal exclusive As Boolean, _
                                  Optional ByVal allowHostWrite As Boolean = False) As String
    Dim hostGuard As String
    hostGuard = McpProjTools.ProjectHostGuard(Me, "open_project")
    If Len(hostGuard) > 0 Then
        ToolOpenProject = hostGuard
        Exit Function
    End If
    ' D5 hardening. open_project used to report "type mismatch" (13) and then
    ' leave the MCP endpoint unreachable. Two properties are now measured:
    '   * every step is written and closed on disk BEFORE the risky statement
    '     runs, so a wedged IDE still leaves a log of how far the call got;
    '   * success is decided by the IDE's own project list, never by the call's
    '     return value - the API has been observed to raise AFTER it added.
    ' The 2-argument AddFromFile(PathName, Exclusive) documented in
    ' 内部 VBIDE 对象模型笔记 is tried first, then the 1-argument form.
    Dim steps As Object
    Set steps = New Collection
    OpLog "==== open_project path=" & path & " exclusive=" & CStr(exclusive) & " env(before)=" & OpEnv()
    Dim full As String
    full = ResolvePath(path)
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FileExists(full) Then Err.Raise vbObjectError + 44, "CodeTools", "Project file not found: " & full
    OpLog "resolved=" & full
    Dim closed As Long
    Dim skippedUnsaved As Long
    Dim apiErr As Long
    Dim apiDesc As String
    closed = 0
    skippedUnsaved = 0
    apiErr = 0
    apiDesc = ""
    Dim alreadyOpen As Boolean
    Dim savedBeforeClose As Boolean
    Dim missingInVbp As String
    ' (R16-1): reloaded/keptInMemory + the disk-vs-memory comparison + the
    ' in-memory project echo. A real reload happens only when nothing unsaved would be
    ' lost; otherwise the request is REFUSED structurally (never silently ignored).
    Dim reloaded As Boolean
    Dim keptInMemory As Boolean
    Dim reloadRefusal As String
    Dim reloadNote As String
    Dim reloadClosed As Boolean
    Dim diskCmp As Object
    Dim diskCmpAfter As Object
    Dim memBefore As Object
    Dim unsavedInfo As Object
    Dim projSaved As Boolean
    Dim savedReadable As Boolean
    Dim mustRefuse As Boolean
    Dim reloadNotAttempted As Boolean
    alreadyOpen = False
    savedBeforeClose = False
    missingInVbp = MissingVbpFiles(full)
    reloaded = False
    keptInMemory = False
    reloadRefusal = ""
    reloadNote = ""
    reloadClosed = False
    reloadNotAttempted = False
    ' 3a: host-write accounting defaults. hostWrites / hostWritePrevented are ALWAYS present
    ' in the receipt; only the exclusive close path can actually scan the IDE current dir.
    Dim hostBundle As Object
    Set hostBundle = CreateObject("Scripting.Dictionary")
    Set hostBundle("writes") = New Collection
    hostBundle("basis") = "not_applicable: no project was closed in this call"
    hostBundle("truncated") = False
    Dim preCloseSaveInfo As Object
    Set preCloseSaveInfo = Nothing
    Set diskCmp = Nothing
    Set diskCmpAfter = Nothing
    Set memBefore = Nothing
    Dim p As VBIDE.VBProject
    Set p = McpFindTools.FindOpenProject(Me, full)
    If Not p Is Nothing Then
        alreadyOpen = True
        OpLog "already open as " & p.Name
        ' The project on disk is compared with the project the IDE HOLDS. "alreadyOpen"
        ' alone used to be the whole answer, which read as "the file you named was
        ' loaded" - it was not.
        ' Read the dirty flag EXACTLY ONCE and reuse it everywhere (echo + gate).
        projSaved = False
        savedReadable = True
        On Error Resume Next
        Err.Clear
        projSaved = p.Saved
        If Err.Number <> 0 Then
            savedReadable = False
            projSaved = False
            Err.Clear
        End If
        On Error GoTo 0
        OpLog "open_project already-open: VBProject.Saved=" & CStr(projSaved) & " readable=" & CStr(savedReadable)
        Set memBefore = InMemoryProjectProps(p)
        memBefore("saved") = projSaved
        memBefore("savedReadable") = savedReadable
        Set diskCmp = McpProjTools.VbpDiskVsMemory(Me, full, p)
        Set unsavedInfo = CreateObject("Scripting.Dictionary")
        keptInMemory = True
        OpLog "diskVsMemory matches=" & CStr(diskCmp("matches"))
        If Not CBool(diskCmp("matches")) Then
            mustRefuse = McpProjTools.ProjectHasUnsavedWork(Me, projSaved, savedReadable, p, unsavedInfo)
            OpLog "gate: projSaved=" & CStr(projSaved) & " readable=" & CStr(savedReadable) & " mustRefuse=" & CStr(mustRefuse)
            ' NO RELOAD IS ATTEMPTED. MEASURED 2026-10-13 on this build: the close+re-add
            ' route (VBProjects.Remove, then VBProjects.AddFromFile) DID remove the project and
            ' then raised 59999 "Method '~' of object '~' failed", leaving the workspace with
            ' ZERO projects; the immediately following AddFromFile failed the same way, so the
            ' IDE could not recover inside that call. A tool must not destroy the workspace in
            ' order to refresh it, so a divergence is answered with a STRUCTURED REFUSAL and
            ' nothing is closed. See reloadNotAttemptedNote.
            reloadNotAttempted = True
            If savedReadable = False Then
                reloadRefusal = "project_saved_flag_unreadable"
                reloadNote = "the .vbp on disk does not describe the project the IDE holds, and VBProject.Saved could not be read on this build, so the tool cannot prove that the in-memory copy has nothing unsaved. No reload is attempted (see reloadNotAttemptedNote); the in-memory copy is still the one in use. See unsavedWorkBasis."
            ElseIf mustRefuse = True Then
                reloadRefusal = "unsaved_changes_would_be_lost"
                reloadNote = "the .vbp on disk does not describe the project the IDE holds, and the in-memory project has UNSAVED changes (VBProject.Saved = False, read once and reported in unsavedWorkBasis); no reload is attempted (see reloadNotAttemptedNote). Two ways forward: (a) call save_project and then open_project again - but be aware save_project REWRITES the .vbp, so it will overwrite the disk edits you were trying to pick up; or (b) call remove_project and then open_project to abandon the in-memory copy and load the disk copy."
            Else
                reloadRefusal = "disk_vs_memory_mismatch"
                reloadNote = "the .vbp on disk does not describe the project the IDE holds, and the in-memory copy reports no unsaved changes - but the reload is NOT attempted (see reloadNotAttemptedNote). The in-memory copy is still the one in use and the disk edits were NOT applied. To take the disk copy, call remove_project and then open_project."
            End If
            OpLog "reload refused: reason=" & reloadRefusal
        End If
    Else
        If exclusive Then
            ' VB6 holds one project (or project group) at a time, so an
            ' "exclusive" open has to close the others. A project with unsaved
            ' work cannot be closed without VB6 raising a modal save prompt, and
            ' that prompt blocks the IDE message pump, so flush everything to
            ' disk first (best effort, logged) and only then close.
            Dim i As Long
            Dim pj As VBIDE.VBProject
            Dim needSave As Boolean
            ' 33b S1: scan for DIRTY + UNTITLED projects BEFORE the pre-close save or any close.
            Dim gateProj As VBIDE.VBProject
            Dim gateFound As VBIDE.VBProject
            Dim gateSaved As Boolean
            Dim gateUntitled As Boolean
            Dim gateKnown As Boolean
            Dim gateHit As Boolean
            Dim gateDirty As Object
            Dim gateProbe As String
            Dim gateErrs As Object
            Dim gateUnknown As Boolean
            gateHit = False
            Set gateFound = Nothing
            For i = m_vbe.VBProjects.Count To 1 Step -1
                Set gateProj = m_vbe.VBProjects.Item(i)
                If Not gateProj Is Nothing Then
                    If LCase$(gateProj.FileName) <> LCase$(full) Then
                        gateSaved = True
                        On Error Resume Next
                        Err.Clear
                        gateSaved = CBool(gateProj.Saved)
                        If Err.Number <> 0 Then
                            gateSaved = True
                            Err.Clear
                        End If
                        On Error GoTo 0
                        gateUntitled = ProjectIsUntitled(gateProj, gateKnown)
                        If (Not gateSaved) And gateKnown And gateUntitled Then
                            gateHit = True
                            If gateFound Is Nothing Then Set gateFound = gateProj
                        End If
                    End If
                End If
            Next
            If gateHit And Not allowHostWrite Then
                ' 33b.1 S1: ONE shared probe - the same helper remove_project uses.
                Dim gateCompCount As Long
                Set gateDirty = ComponentDirtyProbe(gateFound, gateProbe, gateErrs, gateUnknown, gateCompCount)
                ToolOpenProject = DirtyUntitledRefusal("open_project", gateFound, gateDirty, gateProbe, gateErrs, gateUnknown, "project", "project_saved_false", full)
                Exit Function
            End If
            needSave = False
            For i = m_vbe.VBProjects.Count To 1 Step -1
                Set pj = m_vbe.VBProjects.Item(i)
                If Not pj Is Nothing Then
                    If LCase$(pj.FileName) <> LCase$(full) Then
                        If Not pj.Saved Then needSave = True
                    End If
                End If
            Next
            If needSave Then
                OpLog "unsaved project present; flushing before close"
                Dim preSave As String
                preSave = ""
                On Error Resume Next
                preSave = ToolSaveProject("")
                If Err.Number <> 0 Then
                    Err.Clear
                    preSave = "<save raised>"
                End If
                On Error GoTo 0
                OpLog "pre-close save: " & Left$(preSave, 220)
            End If
            ' 3a (B1): savedBeforeClose = the preSave RESULT (flag read back after it),
            ' not the attempt.
            Set preCloseSaveInfo = PreCloseSaveInfoFor(needSave, full)
            savedBeforeClose = CBool(preCloseSaveInfo("saved"))
            ' 3a: snapshot the IDE current directory around the CLOSE LOOP only - the preSave
            ' above is the add-in writing (its own receipt), so it must not be reported as a host
            ' write. Best effort and fail-open; files outside CurDir$ are invisible to it.
            Dim hwBefore As Object
            Dim hwScanned As Long
            Dim hwTrunc As Boolean
            Dim hwFail As Boolean
            Dim hwWhy As String
            Set hwBefore = HostDirSnapshot(CurDir$, hwScanned, hwTrunc, hwFail, hwWhy)
            Call HostScanLog("before-close-cwd", CurDir$, hwScanned, hwTrunc, hwFail, hwWhy, hwBefore)
            For i = m_vbe.VBProjects.Count To 1 Step -1
                Set pj = m_vbe.VBProjects.Item(i)
                If Not pj Is Nothing Then
                    If LCase$(pj.FileName) <> LCase$(full) Then
                        OpLog "closing project " & pj.Name & " file=" & pj.FileName & " saved=" & CStr(pj.Saved)
                        If CloseProject(pj) Then
                            closed = closed + 1
                        Else
                            skippedUnsaved = skippedUnsaved + 1
                            OpLog "close failed (left open)"
                        End If
                    End If
                End If
            Next
            ' 3a: what did the host write into the IDE current directory (preSave + close)?
            Dim hostTruncAfter As Boolean
            Dim hostScannedAfter As Long
            Set hostBundle = HostWriteBundle(hwBefore, hostTruncAfter, hostScannedAfter)
        End If
        AuditAdd "open_project", "begin", full
        Dim nBefore As Long
        nBefore = m_vbe.VBProjects.Count
        ' The 1-argument call is tried first: the 2-argument form is the one
        ' documented in 内部 VBIDE 对象模型笔记 but was measured to raise 13
        ' (type mismatch) while still adding the project, so prefer the quieter
        ' call and only fall back to the documented one when it did nothing.
        OpLog "AddFromFile(1-arg) projects=" & CStr(nBefore)
        On Error Resume Next
        Set p = m_vbe.VBProjects.AddFromFile(full)
        apiErr = Err.Number
        apiDesc = Err.Description
        Err.Clear
        On Error GoTo 0
        OpLog "AddFromFile(1-arg) err=" & CStr(apiErr) & " desc=" & apiDesc & " env=" & OpEnv()
        steps.Add "AddFromFile(path): err=" & CStr(apiErr) & " " & apiDesc
        Set p = McpFindTools.FindOpenProject(Me, full)
        If p Is Nothing Then
            Dim eB As Long
            Dim dB As String
            OpLog "AddFromFile(2-arg) retry"
            On Error Resume Next
            Set p = m_vbe.VBProjects.AddFromFile(full, exclusive)
            eB = Err.Number
            dB = Err.Description
            Err.Clear
            On Error GoTo 0
            OpLog "AddFromFile(2-arg) err=" & CStr(eB) & " desc=" & dB & " env=" & OpEnv()
            steps.Add "AddFromFile(path,exclusive): err=" & CStr(eB) & " " & dB
            Set p = McpFindTools.FindOpenProject(Me, full)
        End If
        Dim nAfter As Long
        nAfter = m_vbe.VBProjects.Count
        OpLog "after projects=" & CStr(nAfter) & " found=" & OpenProjectName(p)
        If p Is Nothing Then
            Dim detail As String
            Dim k As Long
            detail = ""
            For k = 1 To steps.Count
                detail = detail & " | " & CStr(steps(k))
            Next
            If Len(missingInVbp) > 0 Then detail = detail & " | dangling .vbp references: " & missingInVbp
            Err.Raise vbObjectError + 44, "CodeTools", "open_project failed: " & full & " (projects " & CStr(nBefore) & "->" & CStr(nAfter) & ")" & detail & " [log: " & OpLogPath() & "]"
        End If
    End If
    Dim root As Object
    Set root = CreateObject("Scripting.Dictionary")
    ' 33b S2: a SUCCESSFUL open always carries ok:true; IDE API errors that did not stop the
    ' open are reported in apiWarnings[] (never in apiError).
    root("ok") = True
    If p Is Nothing Then
        root("opened") = "<none>"
        root("fileName") = ""
    Else
        root("opened") = p.Name
        root("fileName") = p.FileName
    End If
    root("exclusive") = exclusive
    root("alreadyOpen") = alreadyOpen
    ' (R16-1): the receipt distinguishes the three states explicitly, echoes
    ' what the IDE holds, and reports whether the .vbp on disk describes it.
    root("reloaded") = reloaded
    root("keptInMemory") = keptInMemory
    If alreadyOpen Then
        If Not memBefore Is Nothing Then Set root("inMemory") = memBefore
        If Not diskCmp Is Nothing Then
            Set root("diskVsMemory") = diskCmp
            If reloaded Then
                If Not diskCmpAfter Is Nothing Then
                    root("diskVsMemoryAfterReloadMatches") = diskCmpAfter("matches")
                    Set root("diskVsMemoryAfterReload") = diskCmpAfter
                End If
            End If
        End If
        root("openProjectSemantics") = "alreadyOpen:true means the IDE already had this .vbp open. reloaded tells you whether it was re-read from disk; keptInMemory tells you whether the in-memory copy is still the one in use. diskVsMemory compares the .vbp on disk with the project the IDE holds."
        If Not unsavedInfo Is Nothing Then Set root("unsavedWorkBasis") = unsavedInfo
        root("reloadNotAttempted") = reloadNotAttempted
        If reloadNotAttempted Then
            root("reloadNotAttemptedNote") = "MEASURED 2026-10-13: closing the already-open project and re-adding it from disk (VBProjects.Remove then AddFromFile) raised 59999 and left the workspace with ZERO projects, so open_project never destroys the open project in order to refresh it. A disk-vs-memory divergence is answered with a structured refusal (ok:false + reason) instead."
        End If
        If Len(reloadRefusal) > 0 Then
            root("ok") = False
            root("reason") = reloadRefusal
            root("reloadRefused") = True
            root("reloadNote") = reloadNote
            root("error") = reloadNote
            root("sideEffects") = "none: nothing was closed, reloaded or written"
            root("suggestedAction") = "save_project (or check the .vbp edits on disk), then call open_project again"
        End If
    End If
    If exclusive Then
        root("closedProjects") = closed
        root("skippedUnsavedProjects") = skippedUnsaved
        root("savedBeforeClose") = savedBeforeClose
        ' preCloseSave is an OBJECT (dictionary): needs Set, and it is only produced by the
        ' close path - on the already-open path nothing was closed, so the key is absent.
        If Not preCloseSaveInfo Is Nothing Then Set root("preCloseSave") = preCloseSaveInfo
    End If
    ' 3a: hostWrites / hostWritePrevented are ALWAYS present (empty + a basis when no
    ' project was closed), so a consumer sees one shape.
    Set root("hostWrites") = hostBundle("writes")
    root("hostWritesBasis") = CStr(hostBundle("basis"))
    root("hostWritesTruncated") = CBool(hostBundle("truncated"))
    root("hostWritePrevented") = False
    root("hostWritePreventedWhy") = HostWritePreventedWhy()
    If Len(missingInVbp) > 0 Then
        root("missingComponentFiles") = missingInVbp
        root("missingNote") = "The .vbp references component files that do not exist on disk; VB6 crashes when such a project is saved, so save_project will refuse until they are restored or the components are removed."
    End If
    If apiErr <> 0 Then
        ' 33b S2: "behaviour succeeded but the underlying API returned an error" is a WARNING,
        ' not a failure, and it must not occupy the apiError slot (33a FINDINGS 1: 3/3 sessions).
        Dim apiWarnings As Object
        Set apiWarnings = New Collection
        Dim aw As Object
        Set aw = CreateObject("Scripting.Dictionary")
        aw("code") = "0x" & Hex$(apiErr)
        aw("message") = apiDesc
        aw("raw") = "AddFromFile raised " & CStr(apiErr) & ": " & apiDesc
        aw("phase") = "AddFromFile"
        aw("spurious") = True
        apiWarnings.Add aw
        Set root("apiWarnings") = apiWarnings
        root("note") = "AddFromFile returned an API warning but the IDE project list shows the project open, so the open SUCCEEDED (ok=true). The warning is reported in apiWarnings[], not in apiError. Log: " & OpLogPath()
    End If
    ' FIX-22 (3): a project open/switch re-checks persisted NATIVE records against the current
    ' panes and marks stale ones (cross-session contamination guard). Never fatal for the open.
    On Error Resume Next
    Call BpMarkStaleNativeAfterOpen
    On Error GoTo 0
    ToolOpenProject = JsonStringify(root)
End Function

' ---- open_project diagnostics -------------------------------------------
' The call here can wedge the IDE's message pump, so the log must be flushed
' to disk BEFORE each risky statement: after a wedge there is no response and
' the log is the only evidence of how far it got.

Private Function OpLogPath() As String
    OpLogPath = Environ$("TEMP") & Chr$(92) & "vb6mcp_openproject.log"
End Function

Private Sub OpLog(ByVal msg As String)
    On Error Resume Next
    Dim fnum As Integer
    fnum = FreeFile
    Open OpLogPath() For Append As #fnum
    Print #fnum, Format$(Now, "hh:nn:ss") & " " & msg
    Close #fnum
    On Error GoTo 0
End Sub

' Top-window / dialog census: tells "the API refused" apart from "the IDE is
' blocked by a modal dialog".
Private Function OpEnv() As String
    Dim pid As Long
    Dim s As String
    s = "win=? dlg=?"
    On Error Resume Next
    pid = WinProbe.CurrentProcessId()
    s = "win=" & CStr(WinProbe.CountTopWindows(pid)) & " dlg=" & CStr(WinProbe.CountDialogs(pid))
    If Err.Number <> 0 Then
        Err.Clear
        s = "win=? dlg=?"
    End If
    On Error GoTo 0
    OpEnv = s
End Function


Public Function SameProjectFile(ByVal a As String, ByVal b As String) As Boolean
    ' Build 2: ONE project, several spellings. True only when the two paths PROVABLY
    ' name the same file: plain text (slashes/case/space-insensitive) -> absolute paths ->
    ' canonical paths (GetFinalPathNameByHandleW via Util.UtilRealPathTiers). Unprovable stays False.
    SameProjectFile = False
    Dim sa As String, sb As String
    sa = LCase$(Replace$(Trim$(a), "/", Chr$(92)))
    sb = LCase$(Replace$(Trim$(b), "/", Chr$(92)))
    If Len(sa) = 0 Or Len(sb) = 0 Then Exit Function
    If StrComp(sa, sb, vbBinaryCompare) = 0 Then
        SameProjectFile = True
        Exit Function
    End If
    On Error Resume Next
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Dim aa As String, ab As String
    aa = fso.GetAbsolutePathName(a)
    ab = fso.GetAbsolutePathName(b)
    If Err.Number = 0 Then
        If Len(aa) > 0 And StrComp(LCase$(Replace$(aa, "/", Chr$(92))), LCase$(Replace$(ab, "/", Chr$(92))), vbBinaryCompare) = 0 Then
            SameProjectFile = True
            Err.Clear
            On Error GoTo 0
            Exit Function
        End If
    End If
    Err.Clear
    Dim tier As Long, errText As String
    Dim ra As String, rb As String
    ra = Util.UtilRealPathTiers(a, tier, errText)
    rb = Util.UtilRealPathTiers(b, tier, errText)
    If Len(ra) > 0 And Len(rb) > 0 Then
        If StrComp(LCase$(Replace$(ra, "/", Chr$(92))), LCase$(Replace$(rb, "/", Chr$(92))), vbBinaryCompare) = 0 Then SameProjectFile = True
    End If
    Err.Clear
    On Error GoTo 0
End Function

' Text-level companion to MissingComponentFiles: reads the .vbp before it is
' opened and reports component lines whose file is not on disk.
Private Function MissingVbpFiles(ByVal vbpPath As String) As String
    Dim lines() As String
    Dim i As Long
    Dim t As String
    Dim eq As Long
    Dim val As String
    Dim bad As String
    Dim dir As String
    Dim fso As Object
    Dim key As String
    Dim sp As Long
    Set fso = CreateObject("Scripting.FileSystemObject")
    bad = ""
    If Not ReadLinesCp(vbpPath, lines) Then
        MissingVbpFiles = ""
        Exit Function
    End If
    dir = fso.GetParentFolderName(vbpPath)
    For i = 0 To UBound(lines)
        t = lines(i)
        eq = InStr(t, "=")
        If eq > 0 Then
            key = LCase$(Trim$(Left$(t, eq - 1)))
            If key = "form" Or key = "module" Or key = "class" Or key = "usercontrol" Or key = "propertypage" Or key = "userdocument" Or key = "relateddoc" Then
                val = Trim$(Mid$(t, eq + 1))
                ' VB6 writes "Module=name; file.bas" / "Class=name; file.cls"
                ' (only Form= carries the bare file name), so the file is what
                ' follows the last semicolon.
                sp = InStrRev(val, ";")
                If sp > 0 Then val = Trim$(Mid$(val, sp + 1))
                If Len(val) > 0 And Len(dir) > 0 Then
                    If Not fso.FileExists(CtlJoinPath(dir, val)) Then bad = bad & val & "; "
                End If
            End If
        End If
    Next
    MissingVbpFiles = bad
End Function

' =============================================================
' (R16): what the IDE HOLDS vs what the .vbp SAYS
' =============================================================

' =============================================================
' (R16): what the IDE HOLDS vs what the .vbp SAYS
' =============================================================

' A .vbp line key that declares a COMPONENT (as opposed to a reference, an object or
' a project option). Same set MissingVbpFiles uses.

' Both sides of the type comparison are normalised through this table, because the .vbp
' spells the project type as a WORD while the object model hands back a NUMBER.
Public Function NormalizeProjectTypeToken(ByVal s As String) As String
    Dim t As String
    t = LCase$(Trim$(s))
    Select Case t
        Case "0", "exe", "standardexe"
            NormalizeProjectTypeToken = "standardexe"
        Case "1", "oleexe", "activexexe"
            NormalizeProjectTypeToken = "activexexe"
        Case "2", "oledll", "activexdll"
            NormalizeProjectTypeToken = "activexdll"
        Case "3", "olectl", "activexcontrol", "control"
            NormalizeProjectTypeToken = "activexcontrol"
        Case Else
            NormalizeProjectTypeToken = t
    End Select
End Function

' Can closing the in-memory project destroy work?
' The gate uses the VBProject.Saved value that the CALLER read ONCE - never a second read
' inside this helper. MEASURED 2026-10-13: within ONE open_project call the first read of
' VBProject.Saved reported True (it was echoed as inMemory.saved) while the gate path still
' concluded "unsaved", so every divergence refused with "unsaved work" for a project that
' save_project had just written (a misdiagnosis, discipline 39). One read, one value, used
' for BOTH the echo and the decision - no ambiguity left.
' VBComponent.Saved is only REPORTED (on this build it raises, so it is reported as
' unreadable); it is never decisive.

' The properties the VBIDE object model exposes for the OPEN project.
Private Function InMemoryProjectProps(ByVal p As VBIDE.VBProject) As Object
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    Set InMemoryProjectProps = d
    On Error Resume Next
    If p Is Nothing Then Exit Function
    d("name") = p.Name
    d("fileName") = p.FileName
    d("saved") = p.Saved
    d("description") = p.Description
    d("helpFile") = p.HelpFile
    d("helpContextID") = p.HelpContextID
    d("buildFileName") = p.BuildFileName
    d("readOnly") = p.ReadOnly
    d("componentCount") = p.VBComponents.Count
    Dim names As Object
    Set names = New Collection
    Dim i As Long
    For i = 1 To p.VBComponents.Count
        Dim c As VBIDE.VBComponent
        Set c = p.VBComponents.Item(i)
        If Not c Is Nothing Then names.Add c.Name
        Err.Clear
    Next
    Set d("componentNames") = names
    Dim so As String
    so = ""
    so = p.StartUpObject
    If Err.Number <> 0 Then
        Err.Clear
        d("startupObjectUnreadable") = True
    Else
        d("startupObject") = so
    End If
    Err.Clear
End Function

' Compare the .vbp on disk with the project the IDE holds. matches=False is what turns
' "alreadyOpen" into a real reload or a structured refusal.

' One scalar pair. An EMPTY side means "not reported here" and is skipped, so an unset
' BuildFileName can never by itself trigger a reload.
Public Sub AddScalarDiff(ByVal d As Object, ByVal pair As String, ByVal diskV As String, ByVal memV As String)
    Dim dv As String, mv As String
    dv = Trim$(diskV)
    mv = Trim$(memV)
    If Len(dv) = 0 Or Len(mv) = 0 Then Exit Sub
    If StrComp(BaseNameOf(dv), BaseNameOf(mv), vbTextCompare) = 0 Then Exit Sub
    Dim e As Object
    Set e = CreateObject("Scripting.Dictionary")
    e("pair") = pair
    e("disk") = dv
    e("memory") = mv
    e("decisive") = True
    d("scalarDiffs").Add e
    d("decisiveScalarDiffs") = d("decisiveScalarDiffs") + 1
End Sub

' (R7-4): the /d-related receipt block, used on BOTH the cache-hit path and
' the real build path so a caller can always see exactly what was passed.
Private Sub CcArgsInto(ByVal root As Object, ByVal cmdArgs As String, ByVal ccExtra As String, _
                       ByVal ccArgs As Object, ByVal defines As String, ByVal useIde As Boolean)
    root("commandLine") = cmdArgs
    root("commandLineApplies") = (Not useIde)
    If useIde Then
        root("commandLineNote") = "this receipt came from the IN-IDE Make route, which starts NO compiler subprocess; the command line shown is the one the isolated /make route would have used (and did NOT run here)."
    Else
        root("commandLineNote") = "the exact command line handed to VB6.EXE (/make ...), including the /d arguments exactly as they were written."
    End If
    root("conditionalCompileArgsRaw") = defines
    root("conditionalCompileArgsExtra") = ccExtra
    root("conditionalCompileArgsCount") = ccArgs.Count
    Set root("conditionalCompileArgs") = ccArgs
    root("conditionalCompileQuoteRule") = "a /d value is quoted ONLY when it contains a space; an unconditional quote folds the quoted text into the macro NAME on this compiler, so the macro silently never applies while the build still reports success."
End Sub


' =====================================================================
' (R17, narrowed): split "the statement raised" from "the forward/channel
' died", and carry the VB error as a STRUCTURED field instead of prose.
'   * exec_error - the add-in DID answer: either the call into the probe raised, or
'                  EbExecuteLine reported a VB error. The number was ALREADY captured
'                  (Vba6Probe.bas vbaError/vbaErrorDesc); it is re-labelled, not re-derived.
'   * forward_timeout / forward_failed - produced by the HUB (bridge/vb6mcp_hub.mjs), not
'                  by the add-in: they mean the add-in never answered at all, so no
'                  add-in receipt - and therefore no exec_error - can exist for them.
' =====================================================================
' an earlier fix (defect #10): the exec probe is the SECOND path measured to hang.
' A raising statement (x = CDbl("abc")) makes VB6 put up its OWN run-time error box; the
' add-in is single-threaded and suspended inside that modal loop, so no code after the
' failing call can dismiss it. The wrapper below arms the bounded modal guard (Cancel-
' first) and the gate backstop around ONLY the exec_probe branch, then merges the guard
' receipt into the reply. The probe body itself is UNCHANGED, so a clean probe still
' returns byte-identically and no existing successful caller can change behaviour.
' R14: the probe line may come from a file instead of inline text.
Private Function ToolVba6ExecProbe(ByVal args As Object) As String
    Dim fIn As String, fBytes As Long, fTxt As String, fErr As String
    Dim encName As String
    If Not ResolveTextInput("vba6_probe", "exec_line", JsonGetStr(args, "exec_line"), JsonGetStr(args, "exec_line_file"), fTxt, fErr, fIn, fBytes, encName) Then
        ToolVba6ExecProbe = fErr
        Exit Function
    End If
    If Len(fIn) > 0 Then args("exec_line") = fTxt
    Dim res As String
    res = ToolVba6ExecProbeCore(args)
    If Len(fIn) > 0 Then res = AppendInputFileEcho(res, fIn, fBytes, encName)
    ToolVba6ExecProbe = res
End Function

Private Function ToolVba6ExecProbeCore(ByVal args As Object) As String
    Dim res As String
    On Error Resume Next
    ' Only the exec_probe branch hands a line to EbExecuteLine; the other probe branches
    ' cannot open that box and are NOT armed - their reply is returned verbatim.
    If Not JsonGetBool(args, "exec_probe", False) Then
        Err.Clear
        On Error GoTo 0
        ToolVba6ExecProbeCore = ToolVba6ExecProbeBody(args)
        Exit Function
    End If
    On Error GoTo 0
    Dim mgWait As Long
    mgWait = MODAL_GUARD_WAIT_MS
    WinOps.WoModalGuardSiteArm "vba6_probe{exec_probe}", mgWait
    ArmGateRelease "vba6_probe", mgWait + 5000
    res = ToolVba6ExecProbeBody(args)
    Call ModalGuardSettle(mgWait)
    WinOps.WoModalGuardSiteDisarm
    DisarmGateRelease
    Dim frag As String
    frag = ModalGuardFragment()
    If Len(frag) = 0 Then
        ToolVba6ExecProbeCore = res
        Exit Function
    End If
    Dim merged As String
    merged = JsonPrependMembers(res, frag)
    If merged <> res Then
        ToolVba6ExecProbeCore = merged
        Exit Function
    End If
    ' The guard fields could NOT be merged because the probe's answer was not a plain
    ' non-empty JSON object. Say so, and carry BOTH the verbatim answer and the guard
    ' receipt, instead of silently dropping the guard's evidence.
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")
    d("ok") = False
    d("reason") = "modal_guard_fields_not_merged"
    d("tool") = "vba6_probe"
    d("probe") = "exec_probe"
    d("raw") = res
    d("note") = "the exec probe's answer was not a plain non-empty JSON object, so the modal-guard fields could not be merged into it in place. The probe's own answer is carried verbatim in raw, and the guard receipt is in the modal* fields."
    Call MergeModalGuard(d)
    ToolVba6ExecProbeCore = JsonStringify(d)
End Function

Private Function ToolVba6ExecProbeBody(ByVal args As Object) As String
    Dim raw As String
    Dim raised As Boolean
    Dim rNum As Long
    Dim rDesc As String
    raw = ""
    raised = False
    rNum = 0
    rDesc = ""
    On Error Resume Next
    Err.Clear
    raw = Vba6Probe.ExecLineJson(JsonGetStr(args, "exec_line"), JsonGetLong(args, "exec_a2"), JsonGetLong(args, "exec_a3"), JsonGetLong(args, "exec_a4"), JsonGetBool(args, "exec_scope", False), JsonGetBool(args, "exec_dump_ctx", False), JsonGetBool(args, "exec_set_frame", False))
    If Err.Number <> 0 Then
        raised = True
        rNum = Err.Number
        rDesc = Err.Description
        Err.Clear
    End If
    On Error GoTo 0
    Dim transportNote As String
    transportNote = "exec_error means the add-in DID answer: either the call into the probe raised, or EbExecuteLine reported a VB error. It is a DIFFERENT failure from forward_timeout / forward_failed, which the HUB reports when the add-in cannot answer at all (the channel is hung, or the call outlived the forward budget) - for those there is no add-in receipt, and therefore no exec_error."
    If raised Or Len(raw) = 0 Then
        Dim d As Object
        Set d = CreateObject("Scripting.Dictionary")
        d("ok") = False
        d("reason") = "exec_error"
        d("failureKind") = "channel_error"
        d("tool") = "vba6_probe"
        d("probe") = "exec_probe"
        Dim e As Object
        Set e = CreateObject("Scripting.Dictionary")
        e("vbaErrNumber") = rNum
        e("description") = rDesc
        e("raisedIn") = "the add-in, while calling Vba6Probe.ExecLineJson"
        If Len(raw) = 0 Then e("emptyReceipt") = True
        Set d("exec_error") = e
        d("raw") = Left$(raw, 400)
        d("transportReasonSpace") = transportNote
        ToolVba6ExecProbeBody = JsonStringify(d)
        Exit Function
    End If
    ' The probe answered. When it captured a VB error while executing the line, re-label the
    ' SAME numbers as a structured exec_error. A clean probe is returned BYTE-IDENTICAL to
    ' before, so no existing successful caller can change behaviour.
    Dim n As Long
    Dim dr As String
    n = 0
    dr = ""
    Dim f1 As String
    f1 = JsonFieldRaw(raw, "vbaError")
    If Len(f1) > 0 Then n = CLng(Val(f1))
    If n = 0 Then
        ToolVba6ExecProbeBody = raw
        Exit Function
    End If
    dr = JsonFieldRaw(raw, "vbaErrorDesc")
    Dim addd As Object
    Set addd = CreateObject("Scripting.Dictionary")
    addd("ok") = False
    addd("reason") = "exec_error"
    addd("failureKind") = "statement_raised"
    addd("transportReasonSpace") = transportNote
    Dim e2 As Object
    Set e2 = CreateObject("Scripting.Dictionary")
    e2("vbaErrNumber") = n
    e2("description") = dr
    e2("raisedIn") = "Vba6Probe.ExecLineJson (the probe answered with vbaError/vbaErrorDesc)"
    Set addd("exec_error") = e2
    Dim whole As String
    whole = JsonStringify(addd)
    Dim frag As String
    frag = Mid$(whole, 2, Len(whole) - 2)
    Dim inj As String
    inj = JsonPrependMembers(raw, frag)
    If inj = raw Then
        ' The shape was not a plain non-empty JSON object. Say so instead of pretending.
        Dim d3 As Object
        Set d3 = CreateObject("Scripting.Dictionary")
        d3("ok") = False
        d3("reason") = "exec_error"
    d3("failureKind") = "statement_raised"
        d3("tool") = "vba6_probe"
        d3("probe") = "exec_probe"
        Dim e3 As Object
        Set e3 = CreateObject("Scripting.Dictionary")
        e3("vbaErrNumber") = n
        e3("description") = dr
        e3("raisedIn") = "Vba6Probe.ExecLineJson (the probe answered with vbaError)"
        Set d3("exec_error") = e3
        d3("raw") = raw
        d3("relabelFailed") = "the probe's answer was not a plain non-empty JSON object, so it could not be re-labelled in place"
        d3("transportReasonSpace") = transportNote
        ToolVba6ExecProbeBody = JsonStringify(d3)
        Exit Function
    End If
    ToolVba6ExecProbeBody = inj
End Function

' =====================================================================
' (B): immediate_eval / immediate_run - run a line in the IDE's own
' immediate context and CARRY THE RESULT BACK MACHINE-READABLY.
'   The caller must NOT have to write Open/Print/Close itself, and the VBA6 metadata has
'   NO channel that returns EbExecuteLine's value. The sink below was measured on a LIVE
'   instance BEFORE this code existed (raw receipts: docs/evidence//):
'     * Open "<p>" For Output As #511: Print #511, 1+1: Close #511   -> ret=0, sink " 2 "
'     * v511 = 3/4: Print #511, TypeName(v511) & "|" & v511: Close #511 -> "Double|0.75"
'     * MEASURED 2026-10-22 (live, DLL ed6bf406 AND v1.13.0 96944c2c): a LEADING Close #511
'       is NOT harmless - VB6 raises AT that statement (the file number is not open yet) and
'       EbExecuteLine returns non-zero for the WHOLE line, which used to be reported as
'       engine_refused_line. The earlier 'harmless/idempotent' note was a HISTORICAL MISRECORD:
'       the ret=0 measurements above were taken from lines that OPENED first (no leading Close).
'     * an embedded CRLF makes EbExecuteLine REFUSE the line with ret=40036
'     * On Error Resume Next (ALONE or colon-joined) is REFUSED with ret=40036, so a line
'       that RAISES cannot be made error-tolerant from here. That is the exact mechanism
'       behind defect #10: the IDE's own modal run-time-error box keeps the call alive.
'   Stated instead of hidden:
'     * a raising expression still blocks the IDE (same family as #10). The armed release
'       and ide_state{release_inflight:true} are the RECOVERY, not a hard timeout;
'     * the add-in cannot preempt a statement, so timeout_ms is a GATE-AGE threshold
'       (timeoutMsEnforcedBy says exactly that, hardTimeoutEnforced is false);
'     * the sink is a FILE, so the value is captured only when the statement completes.
'   NOTE: IM_SINK_MAX_BYTES / IM_FILE_NUM are declared in the DECLARATIONS SECTION at the
'   top of this module - VB6 rejects a module-level Const that appears after the first
'   procedure (measured this round: the compiler then reported the unrelated call site of
'   ToolFaultInject as "Sub or Function not defined").
' =====================================================================


' The immediate context accepts ONE physical line: a line carrying CR or LF is refused
' with ret=40036 (measured). Multi-statement input is therefore joined with ": " - the
' same thing a human would type.

' Redirect the caller's own Debug.Print into the sink. Only a STATEMENT-BOUNDARY
' Debug.Print is rewritten (start of the line or right after a colon) so ordinary text is
' left alone; the number of rewrites is reported rather than assumed.






' =====================================================================
' R14: file-fed inputs. A caller that cannot safely embed a long or
' quote-heavy string may name a FILE instead; the file text becomes the
' inline value. Inline and file are mutually exclusive, and every rejection
' is structured - never a silent fallback.
' =====================================================================
Private Function ReadInputFileText(ByVal p As String, ByRef content As String, ByRef nBytes As Long, ByRef encName As String, ByRef errReason As String, ByRef errDetail As String) As Boolean
    ReadInputFileText = False
    content = ""
    nBytes = 0
    encName = ""
    errReason = ""
    errDetail = ""
    Dim b() As Byte
    On Error Resume Next
    Err.Clear
    If Len(Dir$(p)) = 0 Then
        errReason = "input_file_not_found"
        errDetail = p
        Exit Function
    End If
    nBytes = FileLen(p)
    If Err.Number <> 0 Then
        Err.Clear
        errReason = "input_file_unreadable"
        errDetail = p
        Exit Function
    End If
    If nBytes > INPUT_FILE_MAX_BYTES Then
        errReason = "input_file_too_large"
        errDetail = "size=" & CStr(nBytes) & " cap=" & CStr(INPUT_FILE_MAX_BYTES)
        Exit Function
    End If
    Encoding.ReadAllBytesTo p, b
    If Err.Number <> 0 Then
        Err.Clear
        errReason = "input_file_unreadable"
        errDetail = p
        Exit Function
    End If
    If Encoding.ByteCount(b) > 0 Then
        encName = Encoding.DetectEncoding(b)
        Encoding.DecodeBytes b, encName, content
        If Err.Number <> 0 Then
            Err.Clear
            errReason = "input_file_decode_failed"
            errDetail = encName
            Exit Function
        End If
    End If
    On Error GoTo 0
    ReadInputFileText = True
End Function

Private Function ResolveTextInput(ByVal toolName As String, ByVal paramName As String, ByVal inlineVal As String, ByVal fileVal As String, ByRef outText As String, ByRef errJson As String, ByRef inputFile As String, ByRef inputBytes As Long, ByRef inputEncoding As String) As Boolean
    ResolveTextInput = False
    outText = ""
    errJson = ""
    inputFile = ""
    inputBytes = 0
    inputEncoding = ""
    Dim d As Object
    If Len(fileVal) > 0 And Len(inlineVal) > 0 Then
        Set d = CreateObject("Scripting.Dictionary")
        d("ok") = False
        d("tool") = toolName
        d("reason") = "both_inline_and_file"
        d(paramName) = inlineVal
        d(paramName & "_file") = fileVal
        d("note") = "pass EITHER " & paramName & " OR " & paramName & "_file, not both; nothing was executed"
        errJson = JsonStringify(d)
        Exit Function
    End If
    If Len(fileVal) > 0 Then
        Dim reason As String, detail As String, enc As String, content As String, n As Long
        If Not ReadInputFileText(fileVal, content, n, enc, reason, detail) Then
            Set d = CreateObject("Scripting.Dictionary")
            d("ok") = False
            d("tool") = toolName
            d("reason") = reason
            d("path") = fileVal
            If Len(detail) > 0 Then d("detail") = detail
            d("note") = "nothing was executed"
            errJson = JsonStringify(d)
            Exit Function
        End If
        outText = content
        inputFile = fileVal
        inputBytes = n
        inputEncoding = enc
        ResolveTextInput = True
        Exit Function
    End If
    outText = inlineVal
    ResolveTextInput = True
End Function

' Merge the file-input echo into an ALREADY-BUILT JSON object. When the answer is
' not a plain object the answer is returned unchanged: the probe evidence outranks
' the echo, and a missing echo is never disguised as success.
Private Function AppendInputFileEcho(ByVal jsonText As String, ByVal inputFile As String, ByVal inputBytes As Long, ByVal inputEncoding As String) As String
    AppendInputFileEcho = jsonText
    If Len(inputFile) = 0 Then Exit Function
    If Len(jsonText) = 0 Then Exit Function
    If Left$(Trim$(jsonText), 1) <> "{" Then Exit Function
    Dim d As Object
    Dim frag As String
    Set d = CreateObject("Scripting.Dictionary")
    d("inputFile") = inputFile
    d("inputBytes") = inputBytes
    d("inputEncoding") = inputEncoding
    frag = JsonStringify(d)
    If Len(frag) < 3 Then Exit Function
    frag = Mid$(frag, 2, Len(frag) - 2)
    AppendInputFileEcho = JsonPrependMembers(jsonText, frag)
End Function

Public Function ToolImmediateEval(ByVal expression As String, ByVal expressionFile As String, ByVal timeoutMs As Long) As String
    Dim txt As String
    Dim errJson As String
    Dim fIn As String
    Dim fBytes As Long
    Dim fEnc As String
    If Not ResolveTextInput("immediate_eval", "expression", expression, expressionFile, txt, errJson, fIn, fBytes, fEnc) Then
        ToolImmediateEval = errJson
        Exit Function
    End If
    Dim o As Object
    Set o = McpImTools.ImExecuteImmediate(Me, "eval", txt, timeoutMs)
    o("expression") = txt
    If Len(fIn) > 0 Then
        o("inputFile") = fIn
        o("inputBytes") = fBytes
        o("inputEncoding") = fEnc
    End If
    ToolImmediateEval = JsonStringify(o)
End Function

Private Function ToolImmediateRun(ByVal code As String, ByVal codeFile As String, ByVal timeoutMs As Long) As String
    Dim txt As String
    Dim errJson As String
    Dim fIn As String
    Dim fBytes As Long
    Dim fEnc As String
    If Not ResolveTextInput("immediate_run", "code", code, codeFile, txt, errJson, fIn, fBytes, fEnc) Then
        ToolImmediateRun = errJson
