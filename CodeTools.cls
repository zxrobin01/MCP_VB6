Private Function RunDiskGuardBegin(ByVal toolName As String, ByVal modeName As String, ByVal st0 As String, _
        ByVal isStartCmd As Boolean, ByVal willFlush As Boolean, ByVal allowDiskMutation As Boolean, _
        ByVal deferredRestart As Boolean) As Object
    Dim g As Object
    Dim auto As Object
    Dim p As VBIDE.VBProject
    Dim dirty As Boolean
    Dim unknown As Boolean
    Dim dsum As Object
    Dim mode As String
    Dim r As Object
    Dim files As Object
    Dim shaPaths As Object
    Dim comps As Object
    Dim ci As Long
    Dim ce As Object
    Dim meta As Object
    Set g = CreateObject("Scripting.Dictionary")
    g("refused") = False
    g("startCmd") = isStartCmd
    g("willFlush") = willFlush
    g("allowDiskMutation") = allowDiskMutation
    g("mode") = modeName
    g("tool") = toolName
    g("t0") = GetTickCount()
    g("flushRan") = False
    g("waitMs") = 0
    g("promptExpected") = False
    g("dirty") = False
    g("dirtyUnknown") = False
    g("noProject") = False
    g("noVbp") = False
    g("notStartPath") = False
    g("deferredRestart") = deferredRestart
    g("st0") = st0
    Set auto = RunDiskAutoSaveBlock()
    Set g("auto") = auto
    g("ideMode") = CStr(auto("ideAutoSaveMode"))
    mode = CStr(auto("ideAutoSaveMode"))
    Set p = GetProject()
    If p Is Nothing Then
        g("noProject") = True
        Set m_runDiskPendingCtx = g
        Set RunDiskGuardBegin = g
        Exit Function
    End If
    Set dsum = RunDiskDirtySummary(p, dirty, unknown)
    Set g("dirtySummary") = dsum
    g("dirty") = dirty
    g("dirtyUnknown") = unknown
    If isStartCmd And st0 = "design" And dirty And Not allowDiskMutation Then
        Set r = RunDiskRefusal(toolName, modeName, dsum, auto)
        g("refused") = True
        Set g("payload") = r
        Set RunDiskGuardBegin = g
        Exit Function
    End If
    If isStartCmd And st0 = "design" And dirty Then
        If mode = "prompt" Or mode = "unknown" Then
            g("promptExpected") = True
            Set m_runPromptPending = RunDiskPromptPendingTag(modeName)
        End If
    End If
    If Len(CStr(p.FileName)) > 0 Then
        Set files = Build.DiskProjectFilesEx(CStr(p.FileName), RunDiskIdeFiles(p))
        Set shaPaths = CreateObject("Scripting.Dictionary")
        Set comps = dsum("dirtyComponents")
        For ci = 1 To comps.Count
            Set ce = comps.Item(ci)
            If Len(CStr(ce("file"))) > 0 Then shaPaths(LCase$(CStr(ce("file")))) = True
        Next
        Set meta = CreateObject("Scripting.Dictionary")
        Set g("before") = Build.DiskSnapTake(files, shaPaths, meta)
        g("vbpPath") = CStr(p.FileName)
        Set g("files") = files
        Set g("snapMetaBefore") = meta
    Else
        g("noVbp") = True
    End If
    Set m_runDiskPendingCtx = g
    Set RunDiskGuardBegin = g
End Function

Private Function RunDiskDialogBlock(ByVal title As String) As Object
    Dim d As Object
    Dim rj As String
    Dim v As Variant
    Dim dlg As Variant
    Dim first As Object
    Set RunDiskDialogBlock = Nothing
    On Error Resume Next
    Set d = McpBpCore.H3DialogBlock(Me, title)
    Set first = Nothing
    rj = WinOps.ReadActiveDialogsJson("#32770", False, 2)
    If JsonParse(rj, v) Then
        If Not IsEmpty(v) Then
            If Not IsNull(v) Then
                If IsObject(v) Then
                    If v.Exists("dialogs") Then
                        For Each dlg In v("dialogs")
                            If IsObject(dlg) Then
                                Set first = dlg
                                Exit For
                            End If
                        Next
                    End If
                End If
            End If
        End If
    End If
    If Not first Is Nothing Then
        d("hwnd") = JsonGetLong(first, "hwnd", 0)
        If first.Exists("ownerDisabled") Then d("ownerDisabled") = JsonGetBool(first, "ownerDisabled", False)
    End If
    Err.Clear
    Set RunDiskDialogBlock = d
End Function

