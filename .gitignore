# Public .gitignore - generic build products and scratch files only.
# Maintainer-internal working directories are deliberately NOT listed here:
# they live in the local .git/info/exclude, which never ships with the repository.

# Build products
VB6MCP.dll
VB6MCP.exp
VB6MCP.lib
*.exe
*.ocx
*.oca
*.vbw
*.log
build.status

# Generic backups / scratch
*.bak
*.tmp
*.before*
*.after*
*.post*

# Python
__pycache__/
*.pyc

# Editor / OS noise
*.scc
*.vssscc
*.vspscc
Thumbs.db
Desktop.ini
VB6MCP.pdb
VB6MCP.dll.prev
bridge/hub_remotes.json

# Local evidence workspace (never shipped, never tracked)
# fix/ holds each lane's raw verification evidence + one-off probe scripts.  It is a LOCAL working
# area on purpose: what ships is a CURATED summary copied to docs/evidence/<task-id>/ (REPORT.md +
# at most 3 raw files it cites, each <=512 KB).  Ignoring the whole tree keeps git status readable
# and stops raw evidence from drifting into a release by accident.
fix/

# Runtime state / editor snapshots (never shipped)
# .vb6mcp/  = add-in runtime configuration + its logs (written next to the project while the add-in runs)
# _undo/    = pre-edit pane snapshots written by undo_edit/replace_code/apply_edits
# bridge/hub_face_cache.json = the hub's OWN runtime face cache (timestamps/fingerprints/instance
# records). Every hub run rewrites it, so tracking it keeps the worktree permanently dirty and
# pollutes any "matches HEAD" expectation; it is a live artifact (RELEASING.md section 5) that is
# regenerated on demand. It must stay on disk untracked, never be committed.
.vb6mcp/
_undo/
bridge/hub_face_cache.json

# Local build intermediates / artifact records (never shipped)
build/
dist/*.sha256.*
dist/*.sha256
# dist/ is BUILD STAGING (assembled export tree + per-build srcstamp records). It is rebuilt from
# source on every release build and must never be committed: its contents are outputs, and its
# srcstamp/ directory grows one pair of files per build (the file is kept on disk as evidence; it
# is just not part of the tree). Tracked files that already live under dist/ stay tracked - this
# rule only stops NEW build output from showing up as untracked noise.
dist/

# Stray MSVC object files from local native/RE driver compiles, AT THE REPO ROOT ONLY.
# There is no tracked .obj anywhere (`git ls-files '*.obj'` is empty) and no build step here
# produces one, so this hides only leftovers from throwaway driver spikes.  Root-scoped on
# purpose: a blanket *.obj could mask a real artifact inside a subdirectory.
/*.obj
